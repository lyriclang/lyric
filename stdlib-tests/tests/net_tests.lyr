import std.test { Test, assertEq, assertTrue };
import std.io.net as net;
import std.io.error { IoError, IoErrorKind };
import std.string as strings;
import std.task { Wait, spawn, run };

class NetLog {
    port: int,
    notes: strings.StringBuilder,
}

let netLog = NetLog { port = 0, notes = strings.StringBuilder.new() };

fn echoServer(): Coroutine<Wait> {
    let l = net.listen("127.0.0.1", 0)!;
    netLog.port = net.localPort(l);
    let conn = net.accept(l)!;
    let got = net.readSome(conn, 64)!;
    let ok = net.write(conn, got);
    assertTrue(ok, "the echo write must reach the peer");
    net.close(conn);
    net.closeListener(l);
}

fn echoClient(): Coroutine<Wait> {
    while (netLog.port == 0) {
        yield Wait.Now;
    }
    let conn = net.connect("127.0.0.1", netLog.port)!;
    let ok = net.write(conn, "ping".utf8Encode());
    assertTrue(ok, "the request write must reach the server");
    let back = net.readSome(conn, 64)!;
    netLog.notes.append(strings.utf8Decode(back)!);
    let eof = net.readSome(conn, 64)!;
    assertEq(eof.length, 0);
    net.close(conn);
}

@Test
pub fn an_echo_roundtrip_crosses_the_scheduler(): void {
    netLog.port = 0;
    spawn(echoServer());
    spawn(echoClient());
    run();
    assertEq(netLog.notes.build(), "ping");
}

fn refusedClient(): Coroutine<Wait> {
    // A port nothing listens on: the OS said no, and the kind says WHY. Port 1 is safely
    // unserved on a test box; the refusal arrives through the connect wait.
    var kindIsRefused = false;
    try {
        let conn = net.connectOrThrow("127.0.0.1", 1);
        net.close(conn);
    } catch (e: IoError) {
        kindIsRefused = match (e.kind) {
            IoErrorKind.ConnectionRefused => true,
            _ => false,
        };
    }
    assertTrue(kindIsRefused, "nothing listens on port 1 — the kind must say refused");
}

@Test
pub fn a_refused_connect_names_its_kind(): void {
    spawn(refusedClient());
    run();
}

@Test
pub fn a_taken_address_names_its_kind(): void {
    let first = net.listen("127.0.0.1", 0)!;
    let port = net.localPort(first);
    var kindIsTaken = false;
    try {
        let second = net.listenOrThrow("127.0.0.1", port);
        net.closeListener(second);
    } catch (e: IoError) {
        kindIsTaken = match (e.kind) {
            IoErrorKind.AddressInUse => true,
            _ => false,
        };
    }
    net.closeListener(first);
    assertTrue(kindIsTaken, "the second listener must be told the address is taken");
}

// ------------------------------------------------------------------------------------- UDP

fn udpPong(): Coroutine<Wait> {
    let sock = net.bind("127.0.0.1", 0)!;
    netLog.port = net.localPort(sock);
    let packet = net.receiveFrom(sock, 64)!;
    netLog.notes.append(strings.utf8Decode(packet.bytes)!);
    let ok = net.sendTo(sock, packet.host, packet.port, "pong".utf8Encode());
    assertTrue(ok, "the answer datagram must go");
    net.close(sock);
}

fn udpPing(): Coroutine<Wait> {
    while (netLog.port == 0) {
        yield Wait.Now;
    }
    let sock = net.bind("127.0.0.1", 0)!;
    let ok = net.sendTo(sock, "127.0.0.1", netLog.port, "ping".utf8Encode());
    assertTrue(ok, "the request datagram must go");
    let back = net.receiveFrom(sock, 64)!;
    netLog.notes.append(strings.utf8Decode(back.bytes)!);
    net.close(sock);
}

@Test
pub fn a_datagram_roundtrip_answers_to_the_packets_sender(): void {
    netLog.port = 0;
    spawn(udpPong());
    spawn(udpPing());
    run();
    assertEq(netLog.notes.build(), "pingpong");
}

fn emptyPacketPair(): Coroutine<Wait> {
    let receiver = net.bind("127.0.0.1", 0)!;
    let sender = net.bind("127.0.0.1", 0)!;
    let zero: uint8 = 0;
    let nothing = [zero] * 0;
    let ok = net.sendTo(sender, "127.0.0.1", net.localPort(receiver), nothing);
    assertTrue(ok, "an empty datagram is sendable");
    let packet = net.receiveFrom(receiver, 64)!;
    assertEq(packet.bytes.length, 0);
    assertEq(packet.port, net.localPort(sender));
    net.close(receiver);
    net.close(sender);
}

@Test
pub fn an_empty_datagram_is_a_packet_and_not_an_end(): void {
    // The one place this module's bytes mean something different than readSome's: UDP has
    // no EOF, so empty is a real packet — with a real sender.
    spawn(emptyPacketPair());
    run();
}

@Test
pub fn a_taken_port_names_address_in_use_for_udp_too(): void {
    seenTaken.value = false;
    spawn(udpDoubleBind());
    run();
    assertTrue(seenTaken.value, "the twin names AddressInUse");
}

class Flag {
    value: bool,
}

let seenTaken = Flag { value = false };

fn udpDoubleBind(): Coroutine<Wait> {
    let first = net.bind("127.0.0.1", 0)!;
    try {
        net.bindOrThrow("127.0.0.1", net.localPort(first));
    } catch (e: IoError) {
        seenTaken.value = match (e.kind) {
            IoErrorKind.AddressInUse => true,
            _ => false,
        };
    }
    net.close(first);
}
