// std.math — floating-point mathematics.
//
// No capability required: arithmetic reaches nothing.
//
// The native functions work on `float` (64-bit IEEE 754); the integer family below carries the
// type in its name (`absInt`, `minInt`) — names chosen before the language had overloading
// (3.0), and kept because every program calls them.
//
// Special values follow IEEE 754: `sqrt(-1.0)` is NaN, not a panic.

module std.math;

/// The circle constant π.
pub let pi: float = 3.141592653589793;

/// Euler's number, the base of the natural logarithm.
pub let e: float = 2.718281828459045;

/// The square root. A negative value yields NaN (IEEE 754), not a panic.
pub fn sqrt(value: float): float;
/// The absolute value.
pub fn abs(value: float): float;

// Rounding: `floor` down, `ceil` up, `round` to even on .5 (IEEE 754 round-half-to-even, which
// avoids the systematic bias of always rounding up).
/// Rounds down, towards negative infinity.
pub fn floor(value: float): float;
/// Rounds up, towards positive infinity.
pub fn ceil(value: float): float;
/// Rounds to the nearest whole number; a .5 goes to the EVEN neighbour (IEEE 754), which
/// avoids the bias of always rounding up.
pub fn round(value: float): float;

/// The smaller of the two.
pub fn min(a: float, b: float): float;
/// The larger of the two.
pub fn max(a: float, b: float): float;
/// `base` raised to `exponent`.
pub fn pow(base: float, exponent: float): float;

/// The sine of an angle in radians.
pub fn sin(radians: float): float;
/// The cosine of an angle in radians.
pub fn cos(radians: float): float;
/// The tangent of an angle in radians.
pub fn tan(radians: float): float;

// Natural logarithm. For other bases: `log(x) / log(base)`.
/// The natural logarithm; `logBase` covers every other base.
pub fn log(value: float): float;

// The inverse trigonometric functions. These four are the only new native edges in this module;
// everything below is derivable from `sqrt`, `pow` and `log`, and what is derivable stays on this
// side of the host boundary.
//
// A series expansion in Lyric would be imprecise at the edges, and precision is the point of these
// functions.
/// The inverse sine, in radians. Outside `[-1, 1]` the result is NaN.
pub fn asin(value: float): float;
/// The inverse cosine, in radians. Outside `[-1, 1]` the result is NaN.
pub fn acos(value: float): float;
/// The inverse tangent, in radians.
pub fn atan(value: float): float;
/// The angle of the point `(x, y)` in radians — the quadrant-aware inverse tangent.
pub fn atan2(y: float, x: float): float;

// ================================================================== written in Lyric

/// The full turn: 2π.
pub let tau: float = 6.283185307179586;

// ------------------------------------------------------------------------------ integers
//
// The type in the name: `absInt` beside `abs`, from before overloading existed.

/// The largest `int`, 2^63 - 1.
pub let intMax: int = 9223372036854775807;

/// The smallest `int`, -2^63. It has no positive twin: `absInt(intMin)` is `intMin` again, and
/// `0 - intMin` too — arithmetic wraps.
pub let intMin: int = 0 - 9223372036854775807 - 1;

/// The absolute value. The most negative `int` has no positive twin and comes back
/// unchanged — arithmetic wraps; `checkedAbs` answers `null` there instead.
pub fn absInt(value: int): int {
    return if (value < 0) 0 - value else value;
}

// ------------------------------------------------------------------ checked arithmetic
//
// `+`, `-` and `*` wrap, by the language's decision (§6): a program that wants to KNOW asks
// here. Each answers `null` where the wrapped operator would have answered a wrong number, and
// each detects the overflow without committing it, which is why the tests look at the signs
// rather than at the result.

/// `a + b`, or `null` when the sum does not fit `int`.
pub fn checkedAdd(a: int, b: int): ?int {
    let sum = a + b;
    // Overflow flips the sign against both operands: two positives cannot sum to a negative.
    if (a >= 0 == b >= 0 && sum >= 0 != a >= 0) {
        return null;
    }
    return sum;
}

/// `a - b`, or `null` when the difference does not fit `int`.
pub fn checkedSub(a: int, b: int): ?int {
    let difference = a - b;
    // Operands of different sign, and the result on the wrong side of `a`.
    if (a >= 0 != b >= 0 && difference >= 0 != a >= 0) {
        return null;
    }
    return difference;
}

/// `a * b`, or `null` when the product does not fit `int`.
pub fn checkedMul(a: int, b: int): ?int {
    if (a == 0 || b == 0) {
        return 0;
    }
    let product = a * b;
    // Undoing the multiplication must give the operand back; the one case division cannot
    // check is `intMin * -1`, which wraps to `intMin` and divides back to `intMin` too.
    if (product / b != a || a == intMin && b == -1 || b == intMin && a == -1) {
        return null;
    }
    return product;
}

/// The absolute value, or `null` for `intMin`, the one value without one.
pub fn checkedAbs(value: int): ?int {
    if (value == intMin) {
        return null;
    }
    return absInt(value);
}

/// `a + b`, held at `intMax` or `intMin` instead of wrapping.
pub fn saturatingAdd(a: int, b: int): int {
    let sum = checkedAdd(a, b);
    if (sum != null) {
        return sum;
    }
    return if (a < 0) intMin else intMax;
}

/// `a - b`, held at the bounds instead of wrapping.
pub fn saturatingSub(a: int, b: int): int {
    let difference = checkedSub(a, b);
    if (difference != null) {
        return difference;
    }
    return if (a < 0) intMin else intMax;
}

/// `a * b`, held at the bounds instead of wrapping.
pub fn saturatingMul(a: int, b: int): int {
    let product = checkedMul(a, b);
    if (product != null) {
        return product;
    }
    return if (a < 0 != b < 0) intMin else intMax;
}

/// The smaller of the two.
pub fn minInt(a: int, b: int): int {
    return if (a < b) a else b;
}

/// The larger of the two.
pub fn maxInt(a: int, b: int): int {
    return if (a > b) a else b;
}

/// Clamps to `[lo, hi]`. A `lo > hi` yields `lo`; the bounds are the caller's business.
pub fn clampInt(value: int, lo: int, hi: int): int {
    if (value < lo) {
        return lo;
    }
    return if (value > hi) hi else value;
}

/// `-1`, `0` or `1`, matching the sign.
pub fn signInt(value: int): int {
    if (value > 0) {
        return 1;
    }
    return if (value < 0) 0 - 1 else 0;
}

/// Greatest common divisor, Euclidean. Always non-negative.
pub fn gcd(a: int, b: int): int {
    var x = absInt(a);
    var y = absInt(b);
    while (y != 0) {
        let rest = x % y;
        x = y;
        y = rest;
    }
    return x;
}

/// Least common multiple. `lcm(0, n)` is 0.
pub fn lcm(a: int, b: int): int {
    if (a == 0 || b == 0) {
        return 0;
    }
    // Divide first, then multiply: the other order overflows for large values even when the
    // result fits.
    return absInt(a / gcd(a, b) * b);
}

/// Integer power by repeated squaring.
///
/// `null` for a negative exponent — the result would be a fraction — and since 4.5 for a result
/// beyond `int`, which used to wrap silently: `powInt(2, 64)` answered 0.
pub fn powInt(base: int, exponent: int): ?int {
    if (exponent < 0) {
        return null;
    }

    var result = 1;
    var b = base;
    var e = exponent;
    while (e > 0) {
        if (e % 2 == 1) {
            let next = checkedMul(result, b);
            if (next == null) {
                return null;
            }
            result = next;
        }
        e = e / 2;
        if (e > 0) {
            // The square is needed only while a factor is still to come; squaring past the
            // last bit would overflow for a result that fits.
            let square = checkedMul(b, b);
            if (square == null) {
                return null;
            }
            b = square;
        }
    }
    return result;
}

/// Division rounding towards negative infinity rather than towards zero.
///
/// `/` and `%` follow the sign of the dividend, so `-7 / 2` is -3.
/// Computing on a grid (tiles, time windows) needs -4. Both forms stand side by side so the
/// choice is visible.
pub fn divFloor(a: int, b: int): int {
    let q = a / b;
    // Remainder non-zero AND signs differing: the division rounded up.
    if (a % b != 0 && a < 0 != b < 0) {
        return q - 1;
    }
    return q;
}

/// The remainder matching `divFloor`, always carrying the sign of `b`.
pub fn modFloor(a: int, b: int): int {
    let rest = a % b;
    if (rest != 0 && rest < 0 != b < 0) {
        return rest + b;
    }
    return rest;
}

// ------------------------------------------------------------------ floating point

/// Clamps to `[lo, hi]`. A `lo > hi` yields `lo`; the bounds are the caller's business.
pub fn clamp(value: float, lo: float, hi: float): float {
    if (value < lo) {
        return lo;
    }
    return if (value > hi) hi else value;
}

/// `-1.0`, `0.0` or `1.0`, matching the sign. NaN yields `0.0`.
pub fn sign(value: float): float {
    if (value > 0.0) {
        return 1.0;
    }
    return if (value < 0.0) 0.0 - 1.0 else 0.0;
}

/// Truncates towards zero: `trunc(-2.7)` is `-2.0`, while `floor(-2.7)` would be `-3.0`.
pub fn trunc(value: float): float {
    return if (value < 0.0) ceil(value) else floor(value);
}

/// `NaN` is the only value unequal to itself (IEEE 754), so this needs no native edge and no bit
/// access.
pub fn isNaN(value: float): bool {
    return value != value;
}

/// Whether the value is positive or negative infinity. NaN is neither.
pub fn isInfinite(value: float): bool {
    if (isNaN(value)) {
        return false;
    }
    // Infinity is the only non-zero value unchanged by doubling.
    return value != 0.0 && value * 2.0 == value;
}

/// Whether the value is neither NaN nor infinite.
pub fn isFinite(value: float): bool {
    return !isNaN(value) && !isInfinite(value);
}

/// `e` raised to `value`.
pub fn exp(value: float): float {
    return pow(e, value);
}

// Native although `log(x) / log(base)` expresses them: the derived form gave 2.9999999999999996
// for `log10(1000.0)`, which `as int` turns into 2.
/// The base-2 logarithm.
pub fn log2(value: float): float;
/// The base-10 logarithm.
pub fn log10(value: float): float;

/// The logarithm to an arbitrary base.
pub fn logBase(value: float, base: float): float {
    return log(value) / log(base);
}

/// The cube root, negative values included.
///
/// `pow(x, 1/3)` alone yields NaN for negative `x`: a fractional power is undefined there. The
/// cube root is not, and the sign simply moves out.
pub fn cbrt(value: float): float {
    if (value < 0.0) {
        return 0.0 - pow(0.0 - value, 1.0 / 3.0);
    }
    return pow(value, 1.0 / 3.0);
}

/// The length of the hypotenuse.
pub fn hypot(a: float, b: float): float {
    return sqrt(a * a + b * b);
}

/// The hyperbolic sine.
pub fn sinh(value: float): float {
    return (exp(value) - exp(0.0 - value)) / 2.0;
}

/// The hyperbolic cosine.
pub fn cosh(value: float): float {
    return (exp(value) + exp(0.0 - value)) / 2.0;
}

/// The hyperbolic tangent.
pub fn tanh(value: float): float {
    return sinh(value) / cosh(value);
}

/// Degrees to radians.
pub fn toRadians(degrees: float): float {
    return degrees * pi / 180.0;
}

/// Radians to degrees.
pub fn toDegrees(radians: float): float {
    return radians * 180.0 / pi;
}

// Randomness lives in `std.random` (since v1.14): randomness is not arithmetic. The migration
// twin that bridged one release went with 2.0.
