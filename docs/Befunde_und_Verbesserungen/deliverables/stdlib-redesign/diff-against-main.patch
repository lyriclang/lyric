+    // beginning; `trimStart`, `trimEnd` and `isBlank` agree since 4.5.
+    let padded = "\u{00A0}\u{2003} x \u{00A0}";
+    assertEq(padded.trim(), "x");
+    assertEq(padded.trimStart().trimEnd(), padded.trim());
