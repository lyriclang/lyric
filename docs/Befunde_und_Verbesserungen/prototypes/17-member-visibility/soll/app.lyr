import bank { open, Account };

fn main(): int {
    let a = open("ada");
    a.deposit(50);
    println(f"read {a.read()} owner {a.owner}");        // pub-Member: ok

    // a.balance = -999;        // error: member 'balance' of 'Account' is not public (declared in 'bank')
