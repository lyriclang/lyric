// SOLL (4.5): Konformanz ohne Body — der Compiler synthetisiert equals/hash/compare/show.
// Diese Datei kompiliert auf 4.4.1 NICHT; das Ist-Gegenstueck steht unten.
import std.io.console { println };
import std.core { Equatable, Hashable, Ordered, Display };
import std.collections { Map };

struct Coord :: [Hashable<Coord>, Ordered<Coord>, Display] {
    x: int,
    y: int,
    name: string,
}                                   // 4 Methoden, 0 Zeilen Koerper

enum Shape :: [Equatable<Shape>, Display] {
    Dot,
    Rect { w: int, h: int },
    Circle(int),
}

struct Pair<T :: [Equatable<T>]> :: [Equatable<Pair<T>>] {   // Constraint GESCHRIEBEN, nichts implizit
    left: T,
    right: T,
}

fn main(): int {
    let a = Coord { x = 1, y = 2, name = "a" };
    let b = Coord { x = 1, y = 2, name = "a" };
    println(f"{a == b} {a < b} {a}");          // true false Coord { x = 1, y = 2, name = "a" }

    var seen = Map<Coord, int>.empty();        // hash passt zu equals — strukturell, nicht per Kommentar
    seen.set(a, 1);
    println(f"{seen.get(b) ?? 0}");            // 1

    println(f"{Shape.Rect { w = 2, h = 3 }}"); // Shape.Rect { w = 2, h = 3 }
    println(f"{Shape.Dot == Shape.Dot}");      // true
    return 0;
}

