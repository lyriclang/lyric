import std.io.console { println };
import std.os as os;
import std.task { Wait, spawn, run };

fn deepNoYield(n: int): void {
    if (n == 0) {
        return;
    }
    deepNoYield(n - 1);
}

fn worker(): Coroutine<Wait> {
    var r = 0;
    while (r < 20) {
        deepNoYield(40);
        yield Wait.Now;
        r += 1;
    }
}

fn main(): int {
    var i = 0;
    while (i < 10000) {
        spawn(worker());
        i += 1;
    }
    let t0 = os.nowMillis();
    run();
    println(f"calls40+yield0: {os.nowMillis() - t0} ms");
    return 0;
}
