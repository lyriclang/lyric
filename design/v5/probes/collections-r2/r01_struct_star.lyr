import std.io.console { println };
import std.collections { arrayOf, arrayFilled };

struct Vec2 { x: float, y: float }

fn main(): int {
    let seed = Vec2{x=1.0, y=2.0};

    var c = [seed] * 2;
    c[0].x = 7.0;
    println(f"star:    {c[0].x} {c[1].x}");

    var d = [seed, seed];
    d[0].x = 8.0;
    println(f"literal: {d[0].x} {d[1].x}");

    var e = arrayOf(2, (i: int) => Vec2{x=1.0, y=2.0});
    e[0].x = 8.0;
    println(f"arrayOf: {e[0].x} {e[1].x}");

    var f = seed;
    f.x = 6.0;
    println(f"assign:  {f.x} {seed.x}");

    var g = [seed] + [seed];
    g[0].x = 5.0;
    println(f"concat:  {g[0].x} {g[1].x}");

    var h = arrayFilled(2, seed);
    h[0].x = 9.0;
    println(f"filled:  {h[0].x} {h[1].x}");

    return 0;
}
