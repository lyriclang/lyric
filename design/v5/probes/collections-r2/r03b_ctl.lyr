import std.io.console { println };
interface Shape { fn area(): float; }
class Circle :: [Shape] {
    r: float,
    pub fn area(): float { return 3.14 * this.r * this.r; }
}
fn showAll(xs: Shape[]): void {
    for (s in xs) { println(f"{s.area()}"); }
}
fn showAllG<T :: [Shape]>(xs: T[]): void {
    for (s in xs) { println(f"g {s.area()}"); }
}
fn main(): int {
    let ss: Shape[] = [Circle{r=1.0}, Circle{r=2.0}];
    showAll(ss);
    let cs: Circle[] = [Circle{r=1.0}];
    showAllG(cs);
    return 0;
}
