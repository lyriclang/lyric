import std.io.console { println };
import std.iter { over, enumerate };
struct P { x: int, y: int, }
fn main(): int {
    // Kontrolle: Tupel-Destrukturierung im Kopf geht
    let xs = [10, 20];
    for ((i, v) in enumerate(over(xs))) { println(f"{i}:{v}"); }
    // Die Frage: Struct-Pattern im Kopf
    let ps = [P{x=1,y=2}, P{x=3,y=4}];
    for (P { x, y } in ps) { println(f"{x},{y}"); }
    return 0;
}
