import std.io.console { println };
import std.iter { Iterator };
pub class Counter :: [Iterator<int>] {
    n: int = 0,
    pub mut fn next(): ?int {
        if (this.n >= 3) { return null; }
        this.n += 1;
        return this.n;
    }
}
fn main(): int {
    let c = Counter{};
    var total = 0;
    var v = c.next();
    while (v != null) { total += v; v = c.next(); }
    println(f"{total}");
    return 0;
}
