import std.core { Hashable, Equatable };
import std.io.console { println };
import std.string { fromInt };
struct P :: [Equatable<P>, Hashable<P>] {
    x: int,
    y: int,
    fn equals(other: P): bool { return this.x == other.x && this.y == other.y; }
}
fn main(): int {
    let p = P { x = 7, y = 9 };
    println(fromInt(p.hash()));
    return 0;
}
