module api;

pub class Box {
    v: int,
    pub fn get(): int { return this.v; }
    pub fn bump(): int { this.v = this.v + 1; return this.v; }
}

pub struct Pt { x: int, }

pub extend Pt { pub fn dist(): int { return this.x; } }

fn helper(): int { return 4; }

pub fn newBox(): Box { return Box { v = helper() }; }
