module main;

import std.io.console { println };
import lib;

extend lib.Secret { fn grafted(): int { return this.v * 10; } }

struct S :: [lib.Hidden] { n: int, fn id(): int { return this.n; } }

fn useIt<T :: [lib.Hidden]>(x: T): int { return x.id(); }

fn main(): int {
    let m = lib.modeOf(true);
    let name = match (m) { lib.Mode.Fast => "fast", lib.Mode.Slow => "slow" };
    println(name);
    println(lib.makeSecret().grafted());
    println(useIt(S { n = 4 }));
    return 0;
}
