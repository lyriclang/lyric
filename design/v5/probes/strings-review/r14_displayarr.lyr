import std.io.console { println };
import std.core { Display };

struct P { x: int, }

extend P :: [Display] {
    fn show(): string {
        return "P";
    }
}

fn main(): int {
    let p = P { x = 1 };
    let d: Display = p;
    println(d);
    let xs: Display[] = [p, p];
    println(xs[0]);
    println(f"spec {p:8}");
    return 0;
}
