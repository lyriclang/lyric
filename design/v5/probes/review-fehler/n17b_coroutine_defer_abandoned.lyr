// ERWARTUNG: der defer einer nie zu Ende gezogenen Koroutine laeuft NIE.
import std.io.console { println };
fn gen(): Coroutine<int> {
    defer println("coroutine cleanup");
    yield 1;
    yield 2;
}
fn main(): int {
    let c = gen();
    println(f"first {resume c}");
    println("dropping the coroutine now");
    return 0;
}
