// ERWARTUNG (PLAN.md C: "catch auf einem Interface — erledigt, PR #169"): kompiliert und faengt.
import std.io.console { println };

interface AppError :: [Throwable] {
    fn code(): int;
}

class NotFound :: [AppError] {
    what: string,
    fn message(): string { return this.what; }
    fn code(): int { return 404; }
}

fn f(): int throws NotFound { throw NotFound { what = "gone" }; }

fn main(): int {
    try {
        return f();
    } catch (e: AppError) {
        println(f"caught {e.code()} {e.message()}");
        return 0;
    }
}
