import std.io.console { println };
struct S { v: ?int }
fn g(x: ?int): int { return x ?? -1; }
fn r(): ?int { return 5; }
fn main(): int {
    let a: ?int = null;
    let y: int = a ?? 5;
    let s = S { v = 5 };
    let xs: (?int)[] = [1, null];
    println(f"{g(5)} {r() ?? -1} {y} {s.v ?? -1} {xs.length}");
    return 0;
}
