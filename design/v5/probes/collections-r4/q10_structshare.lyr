import std.io.console { println };
import std.collections { slice };
struct Vec2 { x: float, y: float }
fn main(): int {
    let seed = Vec2{x=1.0, y=2.0};
    let a = [seed, seed];
    let b = a + [seed];
    b[0].x = 5.0;
    println(f"concat a[0].x={a[0].x} b[0].x={b[0].x}");
    let xs = [Vec2{x=1.0,y=0.0}, Vec2{x=2.0,y=0.0}, Vec2{x=3.0,y=0.0}];
    let s = slice(xs, 1, 3);
    s[0].x = 9.0;
    println(f"slice xs[1].x={xs[1].x} s[0].x={s[0].x}");
    var c = [seed, seed];
    var v = seed;
    c[1] = v;
    v.x = 3.0;
    println(f"assign c[1].x={c[1].x} v.x={v.x}");
    let ys = [1, 2, 3];
    let t = slice(ys, 1, 3);
    t[0] = 99;
    println(f"int-ctl ys[1]={ys[1]} t[0]={t[0]}");
    return 0;
}
