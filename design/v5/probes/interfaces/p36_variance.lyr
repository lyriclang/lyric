import std.io.console { println };

interface Shape { fn area(): int; }
class Circle :: [Shape] { r: int, fn area(): int { return this.r; } }

fn total(xs: Shape[]): int {
    var t = 0;
    for (x in xs) { t = t + x.area(); }
    return t;
}

fn main(): int {
    let cs: Circle[] = [Circle { r = 1 }, Circle { r = 2 }];
    println(f"{total(cs)}");
    return 0;
}
