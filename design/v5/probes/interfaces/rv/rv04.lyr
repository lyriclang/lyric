import std.io.console { println };
interface Named { fn name(): string; }
interface Labeled :: [Named] { fn label(): string { return "[" + this.name() + "]"; } }
class Tag :: [Labeled] { fn name(): string { return "tag"; } }
fn describe<T :: [Named]>(x: T): string { return x.name(); }
fn main(): int {
    let t = Tag { };
    println(describe(t));
    let l: Labeled = t;
    println(l.name());
    println(describe(l));
    return 0;
}
