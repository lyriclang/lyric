import std.io.console { println };

pub class Box<T> {
    value: T,

    pub static fn of(v: T): Box<T> {
        return Box<T> { value = v };
    }

    pub fn map<U>(f: fn(T) -> U): Box<U> {
        return Box<U> { value = f(this.value) };
    }
}

fn main(): int {
    let b = Box<int>.of(3);
    let s = b.map((n: int) => n * 2);
    println(s.value);
    return 0;
}
