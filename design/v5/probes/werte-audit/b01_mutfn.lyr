import std.io.console { println };
struct V {
    x: int,
    mut fn shift(d: int): void { this.x = this.x + d; }
}
fn make(): V { return V { x = 1 }; }
fn main(): int {
    let v = V { x = 1 };
    v.shift(9);
    println(f"b01 let-binding v.x={v.x}");
    make().shift(9);
    println(f"b01 temporary compiled");
    var xs = [V { x = 1 }];
    xs[0].shift(9);
    println(f"b01 array elem xs0.x={xs[0].x}");
    return 0;
}
