import std.io.console { println };
struct V { x: int, mut fn shift(d: int): void { this.x = this.x + d; } }
fn detour(v: V): int { var w = v; w.x = 9; return w.x; }
fn shadowparam(n: int): int { let n = 99; return n; }
fn main(): int {
    let x = 1;
    { let x = 2; println(f"f04 inner={x}"); }
    println(f"f04 outer={x}");
    println(f"f04 detour={detour(V { x = 1 })} shadowparam={shadowparam(3)}");
    return 0;
}
