import std.io.console;

struct Point {
    x: int,
    y: int,
}

fn distance(a: Point, b: Point): int {
    let dx = a.x - b.x;
    let dy = a.y - b.y;
    return dx * dx + dy * dy;
}

fn classify(n: int): string {
    if (n < 0) {
        return "negative";
    }
    return "non-negative";
}

fn main(): int {
    let p = Point { x = 1, y = 2 };
    let q = Point { x = 4, y = 6 };
    let count = distance(p, q);
    
    console.println(classify(count));
    return 0;
}
