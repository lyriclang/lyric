import std.io.console { println };
import std.string { fromInt };
import std.iter { over, sum };
fn main(): int {
    let xs: int[] = [1, 2, 3, 4];
    let a = over(xs).map { it * 2 }.filter { it > 4 };
    println(fromInt(sum(a)));
    let b = over(xs).map((n) => n * 2);
    println(fromInt(sum(b)));
    return 0;
}
