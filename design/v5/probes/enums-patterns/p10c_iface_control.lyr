import std.io.console { println };

interface Draw { fn area(): int; }

struct Sq :: [Draw] {
    s: int;
    fn area(): int { return this.s * this.s; }
}

fn show(d: Draw): int {
    return match (d) {
        x => x.area(),
    };
}

fn main(): int {
    println(f"{show(Sq { s = 4 })}");
    return 0;
}
