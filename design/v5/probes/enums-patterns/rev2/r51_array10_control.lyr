import std.io.console { println };
fn f(xs: int[]): int {
    return match (xs) {
        [] => 0,
        [_] => 1,
        [_, _] => 2,
        [_, _, _] => 3,
        [_, _, _, _] => 4,
        [_, _, _, _, _] => 5,
        [_, _, _, _, _, _] => 6,
        [_, _, _, _, _, _, _] => 7,
        [_, _, _, _, _, _, _, _] => 8,
        [_, _, _, _, _, _, _, _, _] => 9,
        [_, _, _, _, _, _, _, _, _, _] => 10,
    };
}
fn main(): int { println(f"{f([1,2])}"); return 0; }
