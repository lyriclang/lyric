import std.io.console { println };
struct S { v: int, }
fn main(): int {
    var s = S { v = 1 };
    var xs = [s];
    xs[0].v = 9;
    println(f"q03 literal s.v={s.v} xs0={xs[0].v}");
    var ys = [S { v = 1 }] * 3;
    ys[0].v = 9;
    println(f"q03 repeat ys0={ys[0].v} ys1={ys[1].v} ys2={ys[2].v}");
    var z = S { v = 1 };
    var zs = [z] * 2;
    zs[0].v = 9;
    println(f"q03 repeat-var z.v={z.v} zs1={zs[1].v}");
    return 0;
}
