import std.io.console { println };
import std.core { Display };

struct P :: [Display] {
    x: int,
    fn show(): string {
        return "P(" + "…" + ")";
    }
}

fn main(): int {
    let p = P { x = 1 };
    println(f"ok {p}");
    let o: ?int = 3;
    println(f"opt {o}");
    let xs = [1, 2];
    println(f"arr {xs}");
    let t = (1, 2);
    println(f"tup {t}");
    println(f"spec {p:N2}");
    let d: Display = p;
    println(d);
    return 0;
}
