import std.io.console { println };

fn cmpOnce(a: string, b: string): bool {
    return a < b;
}

fn run(n: int): int {
    let base = "x" * n;
    let a = base + "a";
    let b = base + "b";
    var hits = 0;
    var i = 0;
    while (i < 10) {
        if (cmpOnce(a, b)) {
            hits = hits + 1;
        }
        i = i + 1;
    }
    return hits;
}

fn main(): int {
    return run(NSIZE);
}
