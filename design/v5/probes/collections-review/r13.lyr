import std.io.console { println };
fn poke(params xs: int[]): void {
    if (xs.length > 0) { xs[0] = 99; }
}
fn main(): int {
    var a = [1, 2, 3];
    poke(a);
    println(f"whole-array pass: a[0]={a[0]}");
    var b = [1, 2, 3];
    poke(b[0], b[1], b[2]);
    println(f"spread pass: b[0]={b[0]}");
    return 0;
}
