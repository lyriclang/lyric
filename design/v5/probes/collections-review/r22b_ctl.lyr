import std.io.console { println };
struct Vec2 { x: float, y: float, }
fn main(): int {
    var a = [Vec2 { x = 1.0, y = 2.0 }, Vec2 { x = 1.0, y = 2.0 }];
    a[0].x = 9.0;
    println(f"separate-literal: {a[0].x} {a[1].x}");
    let seed = Vec2 { x = 1.0, y = 2.0 };
    var b = [seed, seed];
    b[0].x = 8.0;
    println(f"same-seed-twice:  {b[0].x} {b[1].x}");
    var c = [seed] * 2;
    c[0].x = 7.0;
    println(f"star-repeat:      {c[0].x} {c[1].x}");
    var d = seed;
    d.x = 6.0;
    println(f"plain-copy:       {d.x} {seed.x}");
    return 0;
}
