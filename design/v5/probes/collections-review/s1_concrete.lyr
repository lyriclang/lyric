import std.io.console { println };
import std.iter { Iterator };
class Counter :: [Iterator<int>] {
    n: int,
    mut fn next(): ?int {
        if (this.n >= 3) { return null; }
        this.n = this.n + 1;
        return this.n;
    }
}
fn main(): int {
    let c = Counter { n = 0 };
    var s = 0;
    for (v in c) { s = s + v; }
    println(f"{s}");
    return 0;
}
