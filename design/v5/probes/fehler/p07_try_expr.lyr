// ERWARTUNG: Parsefehler — 'try' ist nur ein Statement.
import std.io.console { println };
class Boom :: [Throwable] { what: string, fn message(): string { return this.what; } }
fn f(): int throws Boom { throw Boom { what = "x" }; }
fn main(): int {
    let n = try f() catch (e: Boom) 0;
    println(f"{n}");
    return 0;
}
