import std.io.console { println };
struct S { v: int, }
fn main(): int {
    var xs = [S { v = 1 }];
    var ys = xs;
    ys[0].v = 9;
    println(f"array of structs is a reference: xs[0].v = {xs[0].v}");
    let t = (S { v = 1 }, 2);
    let (u, n) = t;
    println(f"tuple destructure: u.v = {u.v}, n = {n}");
    return 0;
}
