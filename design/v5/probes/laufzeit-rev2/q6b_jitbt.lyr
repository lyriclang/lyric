// Q6b — KONTROLLE zu q6: die Panik faellt in eine Funktion, die selbst heiss ist.
// ERWARTUNG: ohne --jit drei Frames mit Position; mit --jit weniger Frames,
// und wenn der Einstieg kompiliert ist, EINE Zeile ohne Position.
import std.io.console { println };

fn zugriff(xs: int[], i: int): int {
    return xs[i];   // i == xs.length -> LYR-VM0001
}

fn mittel(xs: int[], n: int): int {
    var s = 0;
    var i = 0;
    while (i <= n) { s = s + zugriff(xs, i); i += 1; }
    return s;
}

fn main(): int {
    println("start");
    let xs = [1] * 100000;
    return mittel(xs, 100000);
}
