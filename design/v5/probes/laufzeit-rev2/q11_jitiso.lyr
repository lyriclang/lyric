// Q11 — KONTROLLE: was genau laesst der JIT-Emitter an einem Struct fallen?
// Die Arraykonstruktion ist aus der heissen Schleife heraus; beide Schleifen sehen nur
// noch ldelem/ldfield bzw. structcopy.
// ERWARTUNG VOR DEM LAUF:
//   ohne (kein structcopy) -> mit --jit deutlich schneller
//   mit  (structcopy)      -> mit --jit KEIN Gewinn, weil JitCompiler.cs:679-680 die ganze
//                             Funktion ablehnt, sobald ein Opcode nicht im Satz aus
//                             JitCompiler.cs:32-36 steht
import std.io.console { println };

struct S8 { a: int, b: int, c: int, d: int, e: int, f: int, g: int, h: int, }

fn bauen(): S8[] { return [S8 { a=0,b=1,c=2,d=3,e=4,f=5,g=6,h=7 }] * 4; }

fn ohne(xs: S8[], n: int): int {
    var s = 0;
    var i = 0;
    while (i < n) { s = s + xs[i % 4].a + i; i += 1; }
    return s;
}

fn mit(xs: S8[], n: int): int {
    var s = 0;
    var i = 0;
    while (i < n) { let v = xs[i % 4]; s = s + v.a + i; i += 1; }
    return s;
}

fn klasse(n: int): int {
    var s = 0;
    var i = 0;
    while (i < n) { s = s + (i % 4) + i; i += 1; }
    return s;
}

fn main(args: string[]): int {
    let n = 4000000;
    let xs = bauen();
    if (args.length == 0) { println(f"ohne   = {ohne(xs, n)}"); }
    else if (args[0] == "m") { println(f"mit    = {mit(xs, n)}"); }
    else { println(f"klasse = {klasse(n)}"); }
    return 0;
}
