import std.io.console { println };
import std.io.error { IoError };
pub opaque type H = int;
pub interface Reader { fn read(into: uint8[]): int throws IoError; }
extend H :: [Reader] { fn read(into: uint8[]): int throws IoError { return 1; } }
fn readAll(r: Reader): int throws IoError { let buf: uint8[] = [0, 0]; return r.read(buf); }
fn main(): int { let h = 5 as H; try { let n = readAll(h); println(n); } catch (e: IoError) { return 2; } return 0; }
