import std.io.console { println };
import std.string as strings;

fn main(): int {
    let emoji = "\u{1F600}";
    let plain = "ab";
    let cjk = "\u{4E16}\u{754C}";
    let comb = "e\u{301}";
    println(f"[{emoji:6}]");
    println(f"[{plain:6}]");
    println(f"[{cjk:6}]");
    println(f"[{comb:6}]");
    println(f"len emoji={emoji.length()} cjk={cjk.length()} comb={comb.length()}");
    return 0;
}
