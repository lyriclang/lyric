import std.core { Add };
struct V :: [Add<V, V>] {
    n: int,
    fn add(other: V): V { return V { n = this.n + other.n }; }
}
fn main(): int {
    let a = V { n = 1 };
    let b = V { n = 2 };
    let c = -a;
    let d = a % b;
    let e = a & b;
    let f = ~a;
    let g = a << 1;
    let h = !a;
    let i = a / b;
    return 0;
}
