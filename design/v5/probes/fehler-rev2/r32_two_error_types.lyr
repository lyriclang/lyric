// ERWARTUNG (p25 nachgefahren): eine Funktion mit ZWEI Fehlertypen muss 'throws' bar schreiben,
// und dann deckt kein typisierter catch mehr -> LYR-SEM0034 trotz umgebendem try/catch.
import std.io.console { println };
class A :: [Throwable] { fn message(): string { return "A"; } }
class B :: [Throwable] { fn message(): string { return "B"; } }
fn f(n: int): int throws {
    if (n == 0) { throw A { }; }
    throw B { };
}
fn main(): int {
    try { return f(1); }
    catch (_: A) { println("A"); return 0; }
    catch (_: B) { println("B"); return 0; }
}
