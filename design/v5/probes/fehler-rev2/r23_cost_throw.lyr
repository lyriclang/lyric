// 2 Mio Iterationen, davon 1 Mio Wuerfe.
import std.io.console { println };
class Boom :: [Throwable] { fn message(): string { return "b"; } }
fn maybeThrow(i: int): int throws Boom {
    if (i % 2 == 0) { throw Boom { }; }
    return i;
}
fn main(): int {
    var sum = 0;
    var i = 0;
    while (i < 2000000) {
        try { sum = sum + maybeThrow(i); } catch (_: Boom) { sum = sum + 1; }
        i = i + 1;
    }
    println(f"{sum}");
    return 0;
}
