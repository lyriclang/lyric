// ERWARTUNG: kompiliert (ExceptionAnalyzer vergleicht gi.Definition, nicht die Instanz),
// stirbt zur Laufzeit mit LYR-VM0010 uncaught exception of type Box<int>.
import std.io.console { println };
class Box<T> :: [Throwable] {
    tag: T,
    fn message(): string { return "boxed"; }
}
fn thrower(): int throws Box<int> { throw Box<int> { tag = 7 }; }
fn main(): int {
    try {
        return thrower();
    } catch (e: Box<string>) {
        println("caught string box");
        return 0;
    }
}
