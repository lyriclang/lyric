// ERWARTUNG: warning[LYR-SEM0110] am Wurf im defer-Koerper (PR #172 ist in HEAD).
import std.io.console { println };
class Boom :: [Throwable] { what: string, fn message(): string { return this.what; } }
fn boom(): void throws Boom { throw Boom { what = "x" }; }
fn work(): int throws Boom {
    defer boom();
    return 1;
}
fn main(): int {
    try { return work(); } catch (e: Boom) { println("caught"); return 0; }
}
