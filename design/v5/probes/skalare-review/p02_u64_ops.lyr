import std.io.console { println };
fn main(): int {
  let z: uint = 0 as uint;
  let one: uint = 1 as uint;
  let two: uint = 2 as uint;
  let ten: uint = 10 as uint;
  let big: uint = z - one;
  println(f"{big / two}");
  println(f"{big % ten}");
  println(f"{big < one}");
