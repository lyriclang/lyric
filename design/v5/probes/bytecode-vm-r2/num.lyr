import std.io.console { println };

fn main(): int {
    let zero = 0.0;
    let nan = zero / zero;
    let inf = 1.0 / zero;
    let negzero = 0.0 * -1.0;
    println(nan);
    println(inf);
    println(negzero);
    println(nan as int);
    println(inf as int);
    println((0.0 - inf) as int);
    println(1.0e300 as int);



    println(nan == nan);
    return 0;
}
