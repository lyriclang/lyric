import std.io.console { println };
import std.string;
extern "dotnet" fn toChar(v: int32): char = "System.Convert::ToChar";
extern "dotnet" fn charToString(c: char): string = "System.Char::ToString";
fn main(): int {
    let lone = charToString(toChar(55296));
    println(f"len={lone.length()}");
    let c0 = lone.charAt(0);
    println(f"c0={c0 as int}");
    return 0;
}
