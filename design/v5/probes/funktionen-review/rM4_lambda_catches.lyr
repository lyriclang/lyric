import std.core { Exception };
import std.io.console { println };
import std.string { fromInt };
fn risky(n: int): int throws Exception { throw Exception { text = "x" }; }
fn run(f: fn(int) -> int): int { return f(1); }
fn main(): int {
    let r = run((n: int) => { try { return risky(n); } catch (e: Exception) { return -1; } });
    println(fromInt(r));
    return 0;
}
