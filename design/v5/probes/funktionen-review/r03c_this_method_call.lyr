import std.io.console { println };
import std.string { fromInt };
struct Box {
    v: int,
    fn raw(): int { return this.v; }
    fn scaled(k: int): int {
        let f = (n: int) => n * this.raw();
        return f(k);
    }
}
fn main(): int {
    let b = Box { v = 6 };
    println(fromInt(b.scaled(7)));
    return 0;
}
