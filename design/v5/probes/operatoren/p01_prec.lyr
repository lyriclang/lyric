import std.io.console { println };
import std.string { fromInt, fromFloat };

fn main(): int {
    let n = 7;
    // as is level 3, tighter than * (4):  (7 as float) * 2.0 = 14
    println(fromFloat(n as float * 2.0));
    // + (5) is tighter than << (6):  1 << (2+3) = 32
    println(fromInt(1 << 2 + 3));
    // & (8) is tighter than == (12):  (1 & 3) == 1 -> true
    if (1 & 3 == 1) {
        println("bit-tighter-than-eq");
    } else {
        println("C-like");
    }
    // | (10) tighter than < (11)
    if (1 | 2 == 3) {
        println("or-tighter-than-eq");
    } else {
        println("or-looser");
    }
    return 0;
}
