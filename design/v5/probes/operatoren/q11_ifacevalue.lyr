import std.core { Add };
import std.io.console { println };
import std.string { fromInt };

struct V :: [Add<V, V>] {
    x: int,
    fn add(other: V): V { return V { x = this.x + other.x }; }
}

fn viaValue(a: Add<V, V>, b: V): V {
    return a.add(b);
}

fn main(): int {
    let a = V { x = 1 };
    println(fromInt(viaValue(a, V { x = 2 }).x));   // 3
    return 0;
}
