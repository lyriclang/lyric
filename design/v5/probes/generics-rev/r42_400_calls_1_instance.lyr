fn work<T>(x: T, k: int): int {
  var s = 0;
  var i = 0;
  while (i < k) { s = s + i * 3; i = i + 1; }
  var j = 0;
  while (j < k) { s = s - j; j = j + 1; }
  if (s > 100) { s = s / 2; }
  if (s < 0) { s = 0 - s; }
  var m = 0;
  while (m < 4) { s = s + m * m; m = m + 1; }
  return s;
}
