import std.io.console { println };
import std.math { checkedAdd, saturatingAdd, intMax };

fn main(): int {
    var a: float32 = 0.1f32;
    var b: float32 = 0.2f32;
    println(f"f32 0.1+0.2 = {a + b}");
    var c: float = 0.1;
    var d: float = 0.2;
    println(f"f64 0.1+0.2 = {c + d}");
    var one: float32 = 1.0f32;
    var three: float32 = 3.0f32;
    println(f"f32 1/3 = {one / three}");
    var zf: float32 = 0.0f32;
    println(f"f32 1/0 = {one / zf}");
    println(f"checkedAdd(intMax,1) = {checkedAdd(intMax, 1) ?? -1}");
    println(f"saturatingAdd(intMax,1) = {saturatingAdd(intMax, 1)}");
    let ct = comptime (intMax + 1);
    println(f"comptime intMax+1 = {ct}");
    return 0;
}
