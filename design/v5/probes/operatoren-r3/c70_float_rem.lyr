import std.io.console { println };
import std.string { fromFloat };
fn main(): int {
    var a = 0.0 - 7.5;
    var two = 2.0;
    println(fromFloat(a % two));
    var one = 1.0;
    var zero = 0.0;
    println("before div");
    println(fromFloat(one / zero));
    println(fromFloat(zero / zero));
    println(fromFloat(one % zero));
    return 0;
}
