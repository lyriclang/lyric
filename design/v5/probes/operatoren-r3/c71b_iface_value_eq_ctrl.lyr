import std.core { Equatable };
import std.io.console { println };
struct V :: [Equatable<V>] {
    x: int,
    fn equals(other: V): bool { return this.x == other.x; }
}
fn viaCall(a: Equatable<V>, b: V): bool { return a.equals(b); }
fn main(): int {
    if (viaCall(V { x = 1 }, V { x = 1 })) { println("eq"); }
    return 0;
}
