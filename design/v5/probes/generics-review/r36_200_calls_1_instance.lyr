fn work<T>(a: T, b: T, c: T): int {
    let xs: T[] = [a, b, c, a, b, c, a, b, c, a, b, c];
    var total = 0;
    for (i in 0..xs.length) { total = total + i * 3 - 1; }
    for (i in 0..xs.length) { total = total + i * 7 - 2; }
    return total;
}

