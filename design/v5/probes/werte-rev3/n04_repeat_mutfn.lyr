import std.io.console { println };
struct S { v: int, mut fn bump(): void { this.v = this.v + 1; } }
fn main(): int {
    var ys = [S { v = 1 }] * 3;
    ys[0].bump();
    println(f"n04 repeat+mutfn ys1={ys[1].v} ys2={ys[2].v} (2 = alias)");
    var ns = [1] * 3;
    ns[0] = 9;
    println(f"n04 repeat int ns1={ns[1]} (control, 1)");
    var t = S { v = 1 };
    var zs = [t] * 2;
    zs[0].bump();
    println(f"n04 repeat-var t.v={t.v} zs1={zs[1].v}");
    return 0;
}
