import std.io.console { println };
import std.string { fromInt };
struct Box {
    v: int,
    fn scaled(k: int): int {
        let mine = this.v;
        let f = (n: int) => n * mine;
        return f(k);
    }
}
fn main(): int {
    let b = Box { v = 6 };
    println(fromInt(b.scaled(7)));
    return 0;
}
