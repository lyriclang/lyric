import std.io.console { println };
import std.string { fromInt };

fn apply(f: fn(int) -> int, v: int): int { return f(v); }
fn run(f: fn() -> int): int { return f(); }

fn main(): int {
    let a = (n: int) => n * 2;
    let b = (n: int): int => { return n + 1; };
    println(fromInt(apply(a, 4)));
    println(fromInt(apply(b, 4)));
    println(fromInt(apply(x => x * 3, 4)));
    println(fromInt(run { 7 }));
    println(fromInt(apply({ it + 100 }, 4)));
    return 0;
}
