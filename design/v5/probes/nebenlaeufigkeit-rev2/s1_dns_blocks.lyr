import std.io.console { println };
import std.io.net as net;
import std.os as os;
import std.task { Wait, spawn, run };

let t0 = os.nowMillis();

fn connector(): Coroutine<Wait> {
    yield Wait.Sleep(20);
    println(f"connector enters connect() at +{os.nowMillis() - t0}ms");
    let s = net.connect("no-such-host.invalid.example", 80);
    println(f"connector leaves connect() at +{os.nowMillis() - t0}ms");
}

fn ticker(): Coroutine<Wait> {
    var i = 0;
    while (i < 6) {
        println(f"tick {i} at +{os.nowMillis() - t0}ms");
        yield Wait.Sleep(30);
        i += 1;
    }
}

fn main(): int {
    spawn(connector());
    spawn(ticker());
    run();
    return 0;
}
