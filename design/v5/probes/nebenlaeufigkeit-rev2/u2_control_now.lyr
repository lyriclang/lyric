import std.io.console { println };
import std.os as os;
import std.task { Wait, spawn, run };

// KONTROLLE zu u1: dieselbe Zahl Tasks, derselbe eine Suspendierungspunkt,
// aber die Ready-Spalte statt der Sleeper-Spalte.
fn ticker(): Coroutine<Wait> { yield Wait.Now; }

fn main(): int {
    let n = 4000;
    var i = 0;
    while (i < n) { spawn(ticker()); i += 1; }
    let t0 = os.nowMillis();
    run();
    println(f"{n} Wait.Now tasks: run took {os.nowMillis() - t0}ms");
    return 0;
}
