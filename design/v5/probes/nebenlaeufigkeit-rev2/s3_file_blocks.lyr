import std.io.console { println };
import std.io.file as file;
import std.os as os;
import std.task { Wait, spawn, run };

let t0 = os.nowMillis();

fn reader(): Coroutine<Wait> {
    yield Wait.Sleep(20);
    println(f"reader enters file.bytes at +{os.nowMillis() - t0}ms");
    var total = 0;
    var i = 0;
    while (i < 10) {
        let b = file.bytes(os.args()[0]);
        if (b != null) { total += b.length; }
        i += 1;
    }
    println(f"reader leaves file.bytes at +{os.nowMillis() - t0}ms, bytes {total}");
}

fn ticker(): Coroutine<Wait> {
    var i = 0;
    while (i < 8) {
        println(f"tick {i} at +{os.nowMillis() - t0}ms");
        yield Wait.Sleep(20);
        i += 1;
    }
}

fn main(): int {
    spawn(reader());
    spawn(ticker());
    run();
    return 0;
}
