// P5b — KONTROLLE: kostet ein uint8[] weniger als ein int[]?
// Erwartung VOR dem Lauf: nein, dasselbe (ein Slot ist ein LyrValue, 16 Byte, unabhaengig vom Tag).
import std.io.console { println };

fn main(args: string[]): int {
    var n = 1;
    if (args.length > 0) { n = 20000000; }
    let one: uint8 = 1;
    let xs: uint8[] = [one] * n;
    var runden = 0;
    var sum = 0;
    while (runden < 3) {
        var i = 0;
        while (i < xs.length) { sum += xs[i] as int; i += 1; }
        runden += 1;
    }
    println(f"n={xs.length} sum={sum}");
    return 0;
}
