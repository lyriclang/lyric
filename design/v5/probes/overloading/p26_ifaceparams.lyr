import std.io.console { println };
interface A { fn a(): int; }
interface B { fn b(): int; }
struct C :: [A, B] {
    v: int,
    fn a(): int { return 1; }
    fn b(): int { return 2; }
}
fn f(x: A): string { return "A"; }
fn f(x: B): string { return "B"; }
fn main(): int {
    println(f(C { v = 1 }));
    return 0;
}
