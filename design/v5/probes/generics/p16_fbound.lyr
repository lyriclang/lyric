import std.io.console { println };
import std.core { Equatable };

struct Key :: [Equatable<Key>] {
    id: int,
    fn equals(other: Key): bool { return this.id == other.id; }
}

fn same<K :: [Equatable<K>]>(a: K, b: K): bool { return a.equals(b); }

fn main(): int {
    println(f"{same(Key { id = 1 }, Key { id = 1 })}");
    return 0;
}
