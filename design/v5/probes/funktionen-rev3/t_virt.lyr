import std.io.console { println };
import std.string { fromInt };
interface Inc { fn inc(n: int): int; }
struct I :: [Inc] { v: int, fn inc(n: int): int { return n + 1; } }
fn main(): int {
    let d: Inc = I { v = 0 };
    var acc = 0;
    var i = 0;
    while (i < 3000000) { acc = d.inc(acc); i = i + 1; }
    println(fromInt(acc));
    return 0;
}
