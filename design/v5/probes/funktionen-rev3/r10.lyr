import std.io.console { println };
interface Speaker { fn speak(): int; }
struct S :: [Speaker] { v: int, fn speak(): int { return this.v; } }
fn mk(): S { return S { v = 1 }; }
fn take(s: Speaker): int { return s.speak(); }
fn main(): int {
    let f: fn() -> Speaker = mk;
    let g: fn(S) -> int = take;
    println("x");
    return 0;
}
