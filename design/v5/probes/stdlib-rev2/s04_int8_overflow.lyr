import std.string { fromInt };
import std.io.console { println };

fn main(): int {
    let a: int8 = 127;
    let b: int8 = a + 1;
    println(fromInt(b as int));
    let u: uint8 = 255;
    let v: uint8 = u + 1;
    println(fromInt(v as int));
    let big = 300;
    let n: uint8 = big as uint8;
    println(fromInt(n as int));
    return 0;
}
