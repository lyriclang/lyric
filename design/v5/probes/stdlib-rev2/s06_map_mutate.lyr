import std.io.console { println };
import std.collections { Map };
import std.string { fromInt };

fn main(): int {
    var m = Map<int, int>.empty();
    m.set(1, 1);
    m.set(2, 2);
    m.set(3, 3);
    let it = m.entries();
    var seen = 0;
    var e = it.next();
    while (e != null) {
        seen = seen + 1;
        if (seen == 1) {
            m.set(100, 100);
            m.set(101, 101);
            m.set(102, 102);
            m.set(103, 103);
            m.set(104, 104);
        }
        e = it.next();
    }
    println("seen=" + fromInt(seen) + " size=" + fromInt(m.length()));
    return 0;
}
