// Negative: a marked call to a throws function without a catch and without an own throws
// declaration gives LYR-SEM0034 (unmarked it would be LYR-SEM0138 first).

class Boom :: [Error] {
    fn message(): string { return "boom"; }
}

fn risky(): int throws Boom {
    throw Boom { };
}

fn main(): int {
    return try risky();
}
