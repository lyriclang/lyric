fn main.count.<body> -> string {
  params: 1
  locals:
    l0 n: i64
    l1 i: i64
  bb0:
    t0: i64 = const 0
    store l1, t0
    br bb1
  bb1:
    t1: i64 = load l1
    t2: i64 = load l0
    t3: bool = lt t1, t2
    condbr t3 -> bb2, bb3
  bb2:
    t4: i64 = load l1
    yield i64 t4
    t5: i64 = load l1
    t6: i64 = const 1
    t7: i64 = add t5, t6
    store l1, t7
    br bb1
  bb3:
    t8: string = const "done"
    ret t8
}

