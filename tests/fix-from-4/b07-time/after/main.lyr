import std.io { println };
import std.time { Duration, Instant };

fn work(): Instant throws {
    return try Instant.parse("1970-01-01T00:00:00.000Z");
}

fn main(): int {
    let d = ((Duration.ofSecs(2) + Duration.ofMinutes(1)) - Duration.ofMillis(5));
    let a = Instant.now();
    let b = (a + d);
    let t = b.since(a).millis() + d.secs();
    println(a.show());
    let p = (try? Instant.parse("1970-01-01T00:00:00.000Z"));
    return if (t > 0 && p != null) 0 else 1;
}
