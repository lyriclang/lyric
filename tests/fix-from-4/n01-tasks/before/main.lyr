import std.io.console { println };
import std.task { Wait, spawn, run };

fn breathe(): void {
    yield Wait.Now;
}

fn worker(name: string, ms: int): Coroutine<Wait> {
    println(name + " starts");
    breathe();
    yield Wait.Sleep(ms);
    println(name + " finishes");
}

fn main(): int {
    spawn(worker("a", 20));
    spawn(worker("b", 1));
    run();
    return 0;
}
