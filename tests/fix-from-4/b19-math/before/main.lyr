import std.io.console { println };
import std.math { isFinite, isInfinite, isNaN, log, logBase, toDegrees, toRadians };

fn main(): int {
    let x = 2.5;
    println(isNaN(x) || isInfinite(x) || !isFinite(x));
    println(log(x) + logBase(8.0, 2.0));
    println(toRadians(180.0) + toDegrees(1.0));
    return 0;
}
