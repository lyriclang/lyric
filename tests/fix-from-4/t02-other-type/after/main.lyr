
struct Tag :: [Equatable, Equatable<int>] {
    id: int,
    fn equals(other: Tag): bool {
        return this.id == other.id;
    }
    fn equals(other: int): bool {
        return this.id == other;
    }
}

fn main(): int {
    let t = Tag { id = 3 };
    return if (t.equals(3) && t == Tag { id = 3 }) 0 else 1;
}
