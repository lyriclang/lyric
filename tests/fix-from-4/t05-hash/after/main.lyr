import std.core { Hasher };
import std.io { println };

struct Key :: [Hashable] {
    x: int,
    y: int,
    fn equals(other: Key): bool {
        return this.x == other.x && this.y == other.y;
    }
    fn hash<H :: [Hasher]>(&h: H): void {
        this.x.hash(&h);
        this.y.hash(&h);
    }
}

struct Id :: [Hashable] {
    n: int,
    fn equals(other: Id): bool {
        return this.n == other.n;
    }
    fn hash<H :: [Hasher]>(&h: H): void {
        if (this.n < 0) {
            h.writeInt(0);
            return;
        }
        h.writeInt(this.n * 31);
    }
}

fn main(): int {
    let a = Key { x = 1, y = 2 };
    println(f"{a == Key { x = 1, y = 2 }} {Id { n = 4 } == Id { n = 4 }}");
    return 0;
}
