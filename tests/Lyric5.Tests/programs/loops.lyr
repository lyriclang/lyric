// 'loop' with 'break value' (design/v5/spec/05 E11, 08 S3/S4): a search that gives what it found,
// a labeled loop left from a nested one with a value, a loop that gives none, and one that never
// ends — the function around it needs no return.
import std.io { println };

fn firstEven(xs: int[]): int {
    var i = 0;
    let found = loop {
        if (i == xs.length()) { break -1; }
        if (xs[i] % 2 == 0) { break xs[i]; }
        i = i + 1;
    };
    return found;
}

fn pairSum(target: int): int {
    var a = 0;
    let pair = outer: loop {
        var b = 0;
        loop {
            if (a + b == target) { break outer a * 10 + b; }
            if (b == 9) { break; }
            b = b + 1;
        }
        a = a + 1;
    };
    return pair;
}

fn countdown(n: int): void {
    var k = n;
    loop {
        if (k == 0) { break; }
        println(f"{k}");
        k = k - 1;
    }
}

fn spin(): int {
    loop { }
}

fn main(): void {
    println(f"{firstEven([3, 5, 8, 9])}");
    println(f"{firstEven([1, 3])}");
    println(f"{pairSum(12)}");
    countdown(3);
    // 'spin' never ends: it is compiled, and called behind a condition that does not hold.
    if (firstEven([1]) == 0) { println(f"{spin()}"); }
}
