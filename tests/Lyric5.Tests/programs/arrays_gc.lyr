// An array keeps its elements alive (01 V4, V10): an array of objects holds a million dropped
// objects' survivors, and an array of structs whose fields are references keeps those strings
// — the descriptor of the array says which words of an element are references; both arrays
// are grown by concatenation, since '[x] * n' clones and a class has no 'Clone' before M4. Run under the
// test's heap limit, as objects_gc. Expected stdout: "kept 499500 item-999999 tag-999999 500"
// (0 + … + 999 = 499500; the last kept item is number 999999; 500 tagged slots). Exit 0.
import std.io { println };

class Item { id: int, label: string }
struct Tagged { id: int, tag: string }

fn main(): int {
    var items: Item[] = [];
    var k = 0;
    while (k < 1000) { items = items + [Item { id = 0, label = "none" }]; k += 1; }
    var tags: Tagged[] = [];
    while (k < 1500) { tags = tags + [Tagged { id = 0, tag = "none" }]; k += 1; }
    var sum = 0;
    var i = 0;
    while (i < 1000000) {
        let item = Item { id = i, label = f"item-{i}" };
        if (i % 1000 == 999) {
            items[i / 1000] = item;
            sum += item.id / 1000;
            if (i / 1000 % 2 == 1) { tags[i / 2000] = Tagged { id = i, tag = f"tag-{i}" }; }
        }
        i += 1;
    }
    var tagged = 0;
    var j = 0;
    while (j < 500) {
        if (tags[j].id != 0) { tagged += 1; }
        j += 1;
    }
    println(f"kept {sum} {items[999].label} {tags[499].tag} {tagged}");
    return if (items[999].id == 999999) 0 else 1;
}
