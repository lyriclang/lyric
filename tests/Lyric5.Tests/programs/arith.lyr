// The number tower (design/v5/spec/03 T1, T2; 08 Y4), natively. Expected stdout, in order:
//   alias 42            int64 is int: a value of one flows into the other without 'as'
//   widen 300           int8 → int16 → int, uint8 → int16, at an argument and a return
//   wrap -128 255 0     'as' wraps: 128 as int8, -1 as uint8, 256 as uint8
//   sat 127 -128 0 255  float → int saturates, NaN → 0, and past the top of uint8
//   trunc -3 3          toward zero, both signs
//   char 65 A ok        char ↔ uint32 both ways; 'b' > 'a'
//   shl 8 -1 255        1 << 3, -8 >> 3 (arithmetic), uint8 255 >> 0
//   wrapop 0 255 1      uint8: 255 +% 1, 0 -% 1, 129 *% 129 (16641 mod 256 = 1)
//   swrap -128 127      int8: 127 +% 1, -128 -% 1
//   float 1.5 2.0 0.09999999999999998 0.5   1 + 0.5, 4 / 2, 0.3 - 0.2 (not 0.1: IEEE, no rounding of the text), 3 % 2.5
//   fdiv inf -inf nan   1/0, -1/0, 0/0 — no panic (IEEE)
//   f32 0.10000000149011612 0.30000001192092896   float32 has 24 bits; widened to float for the text, the value shows
//   cmp true false      1.5 < 2.5; -0.0 == 0.0 is true, printed as its negation false
//   big 9007199254740993 1e+21
import std.io { println };
import std.string { fromInt, fromUint, fromFloat, fromBool };

fn widen16(x: int16): int { return x; }
fn takeUint8(x: uint8): int16 { return x; }
fn shl(a: int, b: int): int { return a << b; }
fn shr(a: int, b: int): int { return a >> b; }
fn shrU8(a: uint8, b: uint8): uint8 { return a >> b; }
fn addWrapU8(a: uint8, b: uint8): uint8 { return a +% b; }
fn subWrapU8(a: uint8, b: uint8): uint8 { return a -% b; }
fn mulWrapU8(a: uint8, b: uint8): uint8 { return a *% b; }
fn addWrapI8(a: int8, b: int8): int8 { return a +% b; }
fn subWrapI8(a: int8, b: int8): int8 { return a -% b; }
fn fadd(a: float, b: float): float { return a + b; }
fn fsub(a: float, b: float): float { return a - b; }
fn fdiv(a: float, b: float): float { return a / b; }
fn frem(a: float, b: float): float { return a % b; }
fn f32add(a: float32, b: float32): float32 { return a + b; }
fn toI8(x: float): int8 { return x as int8; }
fn toU8(x: float): uint8 { return x as uint8; }
fn toInt(x: float): int { return x as int; }

fn main(): int {
    let a: int64 = 42;
    let b: int = a;
    println("alias " + fromInt(b));

    let small: int8 = 100;
    let bigger: int16 = small;
    let u: uint8 = 200;
    println("widen " + fromInt(widen16(bigger) + widen16(takeUint8(u))));

    let w1 = 128 as int8;
    let w2 = -1 as uint8;
    let w3 = 256 as uint8;
    println("wrap " + fromInt(w1) + " " + fromUint(w2) + " " + fromUint(w3));

    let nan = fdiv(0.0, 0.0);
    println("sat " + fromInt(toI8(1000.0)) + " " + fromInt(toI8(-1000.0)) + " " + fromInt(toInt(nan)) + " " + fromUint(toU8(300.0)));
    println("trunc " + fromInt(toInt(-3.9)) + " " + fromInt(toInt(3.9)));

    let c = 'A';
    let code = c as uint32;
    let back = 65 as uint32 as char;
    let ordered = 'b' > 'a' && back == c;
    println("char " + fromUint(code) + " " + f"{back}" + " " + (if (ordered) "ok" else "no"));

    println("shl " + fromInt(shl(1, 3)) + " " + fromInt(shr(-8, 3)) + " " + fromUint(shrU8(255, 0)));
    println("wrapop " + fromUint(addWrapU8(255, 1)) + " " + fromUint(subWrapU8(0, 1)) + " " + fromUint(mulWrapU8(129, 129)));
    println("swrap " + fromInt(addWrapI8(127, 1)) + " " + fromInt(subWrapI8(-128, 1)));

    println("float " + fromFloat(fadd(1.0, 0.5)) + " " + fromFloat(fdiv(4.0, 2.0)) + " " + fromFloat(fsub(0.3, 0.2)) + " " + fromFloat(frem(3.0, 2.5)));
    println("fdiv " + fromFloat(fdiv(1.0, 0.0)) + " " + fromFloat(fdiv(-1.0, 0.0)) + " " + fromFloat(nan));
    let tenth: float32 = 0.1;
    let sum32: float = f32add(tenth, 0.2);
    println("f32 " + fromFloat(tenth) + " " + fromFloat(sum32));
    let lt = 1.5 < 2.5;
    let negZero = fsub(0.0, 0.0) == -0.0;
    println("cmp " + fromBool(lt) + " " + fromBool(!negZero));
    println("big " + fromInt(9007199254740993) + " " + fromFloat(1e21));
    return 0;
}
