// fizzbuzz.lyr — the 4.x example in Lyric 5 form: `println` comes from std.io (10 U5).
// Shows: for-in over an inclusive range, if/else-if chains, modulo and string interpolation.

import std.io { println };

fn main(): int {
    for (n in 1..=15) {
        if (n % 15 == 0) {
            println("FizzBuzz");
        } else if (n % 3 == 0) {
            println("Fizz");
        } else if (n % 5 == 0) {
            println("Buzz");
        } else {
            println(f"{n}");
        }
    }
    return 0;
}
