// Structs are values (02 V2): a copy is a copy, a field write reaches the storage it names, a
// struct inside a struct copies along. Exit code: 11 + 2 + 5 = 18.
struct Point { x: int, y: int }
struct Segment { a: Point, b: Point }

fn shift(p: Point, dx: int): Point {
    var q = p;
    q.x = q.x + dx;
    return q;
}

fn main(): int {
    var p = Point { x = 1, y = 2 };
    let s = Segment { a = p, b = shift(p, 10) };
    p.y = 5;
    if (s.a.y != 2) { return 1; }
    return s.b.x + s.a.y + p.y;
}
