// Optional equality (design/v5/spec/03 O6): both absent, or both present and equal through the
// value's own equality, a value coercing up; and '[x] * n' over an element that is or holds an
// object (03 §5.1, 10 C7): every slot a clone, never one object shared.
import std.io { println };

struct P :: [Equatable] { x: int, y: int }
class Cell :: [Clone] { var v: int }
struct Holder :: [Clone] { items: int[], n: int }

fn main(): int {
    let a: ?int = 5;
    let b: ?int = 5;
    let c: ?int = 6;
    let none: ?int = null;
    println(f"opt {a == b} {a == c} {none == null} {a == none} {a != c} {a != b}");
    println(f"mixed {a == 5} {a == 6} {5 == a}");
    let p: ?P = P { x = 1, y = 2 };
    let q: ?P = P { x = 1, y = 2 };
    let r: ?P = null;
    println(f"struct {p == q} {p == r}");
    let cells = [Cell { v = 1 }] * 3;
    cells[0].v = 0;
    println(f"repeat {cells.length()} {cells[1].v} {cells[0].v} {cells[2].v - 1} {same(cells[1], cells[1])}");
    let hs = [Holder { items = [1, 2], n = 5 }] * 2;
    hs[0].items[0] = 0;
    println(f"nested {hs.length()} {hs[1].n} {hs[0].items[0] + (hs[1].items[0] - 1)}");
    return 0;
}
