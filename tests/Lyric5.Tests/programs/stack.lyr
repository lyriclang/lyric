// stack — an M8a program (design/v5/spec/13, M8a; after examples/stack.lyr): a generic class and a
// generic interface, conformance through '::', mut methods, an optional answer, composition over
// the prelude's List, and a while loop.
import std.io { println };

pub interface Container<T> {
    mut fn add(item: T);
    fn count(): int;
}

// A stack is a list with fewer possibilities. It inherits nothing — the language has no
// inheritance — but OWNS a list and shows only what a stack may do: push, pop, peek.
pub class Stack<T> :: [Container<T>] {
    items: List<T>,

    pub mut fn add(item: T) {
        this.items.push(item);
    }

    mut fn pop(): ?T {
        return this.items.pop();
    }

    fn peek(): ?T {
        if (this.items.length() == 0) {
            return null;
        }
        return this.items.get(this.items.length() - 1);
    }

    pub fn count(): int {
        return this.items.length();
    }
}

fn newStack<T>(): Stack<T> {
    return Stack<T> { items = List<T>.new() };
}

fn main(): int {
    var stack = newStack<int>();
    stack.add(1);
    stack.add(2);
    stack.add(3);

    println(f"Groesse: {stack.count()}");
    println(f"Spitze:  {stack.peek() ?? 0}");

    while (stack.count() > 0) {
        let top = stack.pop() ?? 0;
        println(f"pop -> {top}");
    }
    return 0;
}
