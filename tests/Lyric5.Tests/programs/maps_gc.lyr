// A map keeps its keys and values alive (01 V4, V10): its slots are optional structs of a key
// and a value side by side (B14), here two strings — the descriptor of the slots' array must say
// its elements hold references. A million strings are made and dropped while the map grows to
// 2000 entries and loses 500 again (a removed entry leaves the walk too); run under the test's
// heap limit, as arrays_gc. Expected stdout: "kept 1500 2000 value-999999 1500" (keys 0..1999,
// every fourth removed; each looked up as it should be; the last value is number 999999; 1500
// values walked). Exit 0.
import std.collections { Map };
import std.io { println };

fn main(): int {
    let m = Map<string, string>.new();
    var dropped = 0;
    var i = 0;
    while (i < 1000000) {
        let junk = f"junk-{i}";
        dropped += junk.length() % 2;
        if (i % 500 == 499) {
            let n = i / 500;
            m.insert(f"key-{n}", f"value-{i}");
            if (n % 4 == 1) { m.remove(f"key-{n - 1}"); }
        }
        i += 1;
    }
    var good = 0;
    var n = 0;
    while (n < 2000) {
        if (let v = m.get(f"key-{n}")) {
            if (n % 4 != 0 && v == f"value-{n * 500 + 499}") { good += 1; }
        } else if (n % 4 == 0) {
            good += 1;
        }
        n += 1;
    }
    var walked = 0;
    for (v in m.values()) {
        if (v.length() > 6) { walked += 1; }
    }
    let last = m.get("key-1999") ?? "none";
    println(f"kept {m.length()} {good} {last} {walked}");
    return if (dropped > 0) 0 else 1;
}
