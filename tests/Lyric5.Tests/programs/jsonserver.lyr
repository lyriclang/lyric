// A JSON server and its client (M10's artifact, design/v5/spec/13 S8): the server answers
// /items with a list and /items/<id> with one, takes a POST of a new one, and the client of the
// same program fetches them — std.http on both sides, std.json between them.
//
//     lyric5 run
//
// The server binds a loopback port of the system's choice and serves on a task; main is the
// client. With an argument, the server stays up on that port until SIGINT (Ctrl-C) or SIGTERM,
// for a browser or curl to talk to.
import std.codec { Codable };
import std.collections { List };
import std.http { Client, Request, Response, Server, Method };
import std.io { eprintln, println };
import std.net { IpAddr, SocketAddr };
import std.os { args, signals, Signal };
import std.task { spawn };
import std.uri { Uri };

struct Item :: [Codable, Equatable] {
    id: int,
    name: string,
    price: float,
}

struct NewItem :: [Codable] {
    name: string,
    price: float,
}

struct Problem :: [Codable] {
    error: string,
}

let items: List<Item> = List<Item>.new();

fn handle(req: Request): Response throws Error {
    let path = req.uri.path;
    if (path == "/items" && req.method == Method.Get) {
        return try Response.withJson(items.toArray());
    }
    if (path == "/items" && req.method == Method.Post) {
        let fresh = try req.json<NewItem>();
        let item = Item { id = items.length() + 1, name = fresh.name, price = fresh.price };
        items.push(item);
        var r = try Response.withJson(item, 201);
        r.headers.set("Location", f"/items/{item.id}");
        return r;
    }
    if (path.startsWith("/items/")) {
        let id = try int.parse(path.splitOnce("/items/")!.1);
        for (item in items) {
            if (item.id == id) {
                return try Response.withJson(item);
            }
        }
        return try Response.withJson(Problem { error = f"no item {id}" }, 404);
    }
    return try Response.withJson(Problem { error = f"no {path}" }, 404);
}

fn main(): int throws Error {
    items.push(Item { id = 1, name = "Brot", price = 2.5 });
    items.push(Item { id = 2, name = "Käse", price = 7.0 });
    let given = args();
    if (given.length() > 1) {
        let port = try int.parse(given[1]);
        var server = try Server.bind(SocketAddr { ip = IpAddr.V4(127, 0, 0, 1), port = port as uint16 });
        eprintln(f"jsonserver: http://127.0.0.1:{(try server.localAddr()).port}/items");
        let serving = spawn(() => { try server.serve(handle); });
        let stop = signals(Signal.Interrupt, Signal.Terminate);
        let _ = try stop.recv();
        server.shutdown();
        try serving.await();
        return 0;
    }
    var server = try Server.bind(SocketAddr { ip = IpAddr.V4(127, 0, 0, 1), port = 0 });
    let base = f"http://127.0.0.1:{(try server.localAddr()).port}";
    let serving = spawn(() => { try server.serve(handle); });

    var client = Client.new();
    let all = try (try client.get(try Uri.parse(base + "/items"))).json<Item[]>();
    for (item in all) {
        println(f"{item.id} {item.name} {item.price}");
    }
    var post = Request.get(try Uri.parse(base + "/items"));
    post.method = Method.Post;
    post.setText("{\"name\": \"Milch\", \"price\": 1.2}", "application/json");
    let made = try client.send(post);
    println(f"{made.status.show()} {made.headers.get("Location") ?? "-"} {(try made.json<Item>()).name}");
    let one = try client.get(try Uri.parse(base + "/items/3"));
    println(f"{one.status.code} {try one.text()}");
    let none = try client.get(try Uri.parse(base + "/items/9"));
    println(f"{none.status.code} {try none.text()}");
    client.close();
    server.shutdown();
    try serving.await();
    return 0;
}
