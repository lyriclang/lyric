// A task whose body never returns (M8b S10c: the echo server's acceptor found it): spawn's T is
// `never`, and launchOn's store of the body's result diverges at that instance — the lowering read
// the generic `T` and took the call for one that gives a value (an ICE until then). The task is
// cancelled; its await throws Cancelled, and nothing comes after it in the try.
import std.io { println };
import std.task { Cancelled, sleep, spawn };
import std.time { Duration };

fn main(): void throws Error {
    var turns = 0;
    let forever = spawn(() => {
        loop {
            try sleep(Duration.ofMillis(5));
            turns += 1;
        }
    });
    // 200 ms for turns of 5 ms: what the test shows is that the body ran and was cancelled, so one
    // turn is enough - Windows' timer ticks about every 16 ms, a loaded runner gave two turns
    // (2026-10-12), macOS under the sanitizers two as well (2026-10-13).
    try sleep(Duration.ofMillis(200));
    forever.cancel();
    try {
        forever.await();
    } catch (_: Cancelled) {
        println(if (turns >= 1) "cancelled after a turn or more" else "cancelled before a turn");
    }
}
