// The file tool (design/v5/spec/13: M8b's artifact, S14) — std.fs, std.path and std.os at work:
//   filetool stats <dir>        the files, directories and bytes under <dir>; its three largest files
//   filetool copy <from> <to>   the tree <from> again as <to>
//   filetool find <dir> <ext>   the files under <dir> with the extension <ext> (`.txt`), in order
// Paths below <dir> are written relative to it, with '/' between their parts on every system. A
// failure says what and where on the standard error, and the program ends with 1; a command it
// does not know, with 2.
import std.collections { List };
import std.fs;
import std.io { IoError, eprintln, println };
import std.os;
import std.path;

struct Sized {
    path: string,
    size: int,
}

/// `p` below `base`, its parts joined by '/'.
fn below(base: string, p: string): string {
    let rel = path.relative(base, p) ?? p;
    return path.components(rel).join("/");
}

fn stats(dir: string): void throws IoError {
    var files = 0;
    var dirs = 0;
    var bytes = 0;
    let sized = List<Sized>.new();
    for (e in try fs.walk(dir)) {
        if (e.isDir) {
            dirs += 1;
        } else if (e.isFile) {
            let size = (try e.metadata()).size;
            files += 1;
            bytes += size;
            sized.push(Sized { path = below(dir, e.path), size = size });
        }
    }
    // the largest first; equal ones in the walk's order, which is by name
    sized.asSlice().sortByKey((s: Sized) => -s.size);
    println(f"{files} files, {dirs} directories, {bytes} bytes");
    var k = 0;
    while (k < 3 && k < sized.length()) {
        let s = sized[k];
        println(f"  {s.size} {s.path}");
        k += 1;
    }
}

fn copyTree(from: string, to: string): void throws IoError {
    try fs.createDirAll(to);
    var files = 0;
    var bytes = 0;
    for (e in try fs.walk(from)) {
        let target = path.join(to, path.relative(from, e.path) ?? e.name);
        if (e.isDir) {
            try fs.createDirAll(target);
        } else if (e.isFile) {
            bytes += try fs.copy(e.path, target);
            files += 1;
        }
    }
    println(f"copied {files} files, {bytes} bytes");
}

fn find(dir: string, ext: string): void throws IoError {
    let found = List<string>.new();
    for (e in try fs.walk(dir)) {
        if (e.isFile && path.extension(e.path) == ext) {
            found.push(below(dir, e.path));
        }
    }
    found.asSlice().sort();
    for (p in found) {
        println(p);
    }
}

fn main(): int {
    let args = os.args();
    let command = if (args.length() > 1) args[1] else "";
    try {
        if (command == "stats" && args.length() == 3) {
            stats(args[2]);
        } else if (command == "copy" && args.length() == 4) {
            copyTree(args[2], args[3]);
        } else if (command == "find" && args.length() == 4) {
            find(args[2], args[3]);
        } else {
            eprintln("usage: filetool stats <dir> | copy <from> <to> | find <dir> <ext>");
            return 2;
        }
    } catch (e: IoError) {
        eprintln(f"filetool: {e.message()}");
        return 1;
    }
    return 0;
}
