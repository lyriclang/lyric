// A close on one thread ends a wait on another (13 M8b S10c, the M8b open point 1t): a task on a
// thread of its own waits to read a stream that the main thread then closes — its wait on the
// other thread's poller ends, and it throws Closed. Expected stdout: "closed (read)".
import std.io { IoError, println };
import std.net { IpAddr, SocketAddr, TcpListener, TcpStream };
import std.task { sleep };
import std.thread { Thread };
import std.time { Duration };

fn main(): void throws Error {
    let listener = try TcpListener.bind(SocketAddr { ip = IpAddr.V4(127, 0, 0, 1), port = 0 });
    var client = try TcpStream.connect(listener.localAddr());
    let conn = try listener.accept();
    let reader = Thread.spawn(() => {
        let buf: uint8[] = [0u8] * 8;
        try {
            let _ = client.read(buf[..]);
            return "read";
        } catch (e: IoError) {
            return e.message();
        }
    });
    // the reader waits by then, on its own thread's poller
    try sleep(Duration.ofMillis(100));
    try client.close();
    println(try reader.await());
    try conn.close();
    try listener.close();
}
