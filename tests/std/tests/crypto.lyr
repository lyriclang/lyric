// std.crypto (design/v5/spec/10 Q4; M8b S4b): FIPS 180-4's and RFC 1321's examples, the padding at
// every block edge, RFC 2202's and RFC 4231's HMAC cases. The expected values come from Python's
// hashlib and hmac, an implementation of its own.
import std.crypto { Digest, Hmac, Md5, Sha1, Sha256, Sha512, constantTimeEq, randomBytes, randomUint64, sha256 };
import std.encoding { Hex };
import std.io { ByteBuffer };
import std.test { assertEq, assertFalse, assertTrue };

fn utf8(s: string): uint8[] {
    let b = ByteBuffer.new();
    try! b.writeString(s);
    return b.toArray();
}

fn hex<D :: [Digest]>(s: string): string {
    var d = D.new();
    d.update(utf8(s)[..]);
    return Hex.encode(d.finish()[..]);
}

fn mac<D :: [Digest]>(key: uint8[], message: uint8[]): string {
    let m = Hmac<D>.new(key[..]);
    m.update(message[..]);
    return Hex.encode(m.finish()[..]);
}

@Test
fn theStandardsExamples(): void {
    assertEq(hex<Sha256>(""), "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855");
    assertEq(hex<Sha512>(""), "cf83e1357eefb8bdf1542850d66d8007d620e4050b5715dc83f4a921d36ce9ce47d0d13c5d85f2b0ff8318d2877eec2f63b931bd47417a81a538327af927da3e");
    assertEq(hex<Sha1>(""), "da39a3ee5e6b4b0d3255bfef95601890afd80709");
    assertEq(hex<Md5>(""), "d41d8cd98f00b204e9800998ecf8427e");
    assertEq(hex<Sha256>("abc"), "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad");
    assertEq(hex<Sha512>("abc"), "ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f");
    assertEq(hex<Sha1>("abc"), "a9993e364706816aba3e25717850c26c9cd0d89d");
    assertEq(hex<Md5>("abc"), "900150983cd24fb0d6963f7d28e17f72");
    assertEq(hex<Sha256>("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq"), "248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1");
    assertEq(hex<Sha512>("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq"), "204a8fc6dda82f0a0ced7beb8e08a41657c16ef468b228a8279be331a703c33596fd15c13b1b07f9aa1d3bea57789ca031ad85c7a71dd70354ec631238ca3445");
    assertEq(hex<Sha1>("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq"), "84983e441c3bd26ebaae4aa1f95129e5e54670f1");
    assertEq(hex<Md5>("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq"), "8215ef0796a20bcaaae116d3876c664a");
}

@Test
fn thePaddingAtEveryBlockEdge(): void {
    assertEq(hex<Sha256>("a" * 55), "9f4390f8d30c2dd92ec9f095b65e2b9ae9b0a925a5258e241c9f1e910f734318");
    assertEq(hex<Sha512>("a" * 55), "b0220c772cbf6c1822e2cb38a437d0e1d58772417a4bbb21c961364f8b6143e05aa6316dca8d1d7b19e16448419076395f6086cb55101fbd6d5497b148e1745f");
    assertEq(hex<Sha1>("a" * 55), "c1c8bbdc22796e28c0e15163d20899b65621d65a");
    assertEq(hex<Md5>("a" * 55), "ef1772b6dff9a122358552954ad0df65");
    assertEq(hex<Sha256>("a" * 56), "b35439a4ac6f0948b6d6f9e3c6af0f5f590ce20f1bde7090ef7970686ec6738a");
    assertEq(hex<Sha512>("a" * 56), "962b64aae357d2a4fee3ded8b539bdc9d325081822b0bfc55583133aab44f18bafe11d72a7ae16c79ce2ba620ae2242d5144809161945f1367f41b3972e26e04");
    assertEq(hex<Sha1>("a" * 56), "c2db330f6083854c99d4b5bfb6e8f29f201be699");
    assertEq(hex<Md5>("a" * 56), "3b0c8ac703f828b04c6c197006d17218");
    assertEq(hex<Sha256>("a" * 63), "7d3e74a05d7db15bce4ad9ec0658ea98e3f06eeecf16b4c6fff2da457ddc2f34");
    assertEq(hex<Sha512>("a" * 63), "c1b0f5c6d3b03dfe4a2602e67242f54e344090b66e01100a469b129f583f016c7e27dddeaa438393dcc7ec54b0b57c9ba7af007f9b56db5f6fb677d972a31362");
    assertEq(hex<Sha1>("a" * 63), "03f09f5b158a7a8cdad920bddc29b81c18a551f5");
    assertEq(hex<Md5>("a" * 63), "b06521f39153d618550606be297466d5");
    assertEq(hex<Sha256>("a" * 64), "ffe054fe7ae0cb6dc65c3af9b61d5209f439851db43d0ba5997337df154668eb");
    assertEq(hex<Sha512>("a" * 64), "01d35c10c6c38c2dcf48f7eebb3235fb5ad74a65ec4cd016e2354c637a8fb49b695ef3c1d6f7ae4cd74d78cc9c9bcac9d4f23a73019998a7f73038a5c9b2dbde");
    assertEq(hex<Sha1>("a" * 64), "0098ba824b5c16427bd7a1122a5a442a25ec644d");
    assertEq(hex<Md5>("a" * 64), "014842d480b571495a4a0363793f7367");
    assertEq(hex<Sha256>("a" * 65), "635361c48bb9eab14198e76ea8ab7f1a41685d6ad62aa9146d301d4f17eb0ae0");
    assertEq(hex<Sha512>("a" * 65), "b83086cd8494e55708ad7ecd82dfb4bca1bda61ecbb7caf0c68967902e709345e5d8305eb7ac0d588afc6cbb75161aa9c8c7e0ea986bd833dafe5e1ccd37345a");
    assertEq(hex<Sha1>("a" * 65), "11655326c708d70319be2610e8a57d9a5b959d3b");
    assertEq(hex<Md5>("a" * 65), "c743a45e0d2e6a95cb859adae0248435");
    assertEq(hex<Sha256>("a" * 111), "6374f73208854473827f6f6a3f43b1f53eaa3b82c21c1a6d69a2110b2a79baad");
    assertEq(hex<Sha512>("a" * 111), "fa9121c7b32b9e01733d034cfc78cbf67f926c7ed83e82200ef86818196921760b4beff48404df811b953828274461673c68d04e297b0eb7b2b4d60fc6b566a2");
    assertEq(hex<Sha1>("a" * 111), "ac877859d427d9192054eea8feb3b8a403ef83a5");
    assertEq(hex<Md5>("a" * 111), "089f243d1e831c5879aa375ee364a06e");
    assertEq(hex<Sha256>("a" * 112), "f54353008a2553262ecdc4a34749563ba0950e8b0fc8652780b0a614b99683c1");
    assertEq(hex<Sha512>("a" * 112), "c01d080efd492776a1c43bd23dd99d0a2e626d481e16782e75d54c2503b5dc32bd05f0f1ba33e568b88fd2d970929b719ecbb152f58f130a407c8830604b70ca");
    assertEq(hex<Sha1>("a" * 112), "689993727ba37386bb032495e9dbdfb4dd1ba744");
    assertEq(hex<Md5>("a" * 112), "9146ef3527c7cfcc66dc615c3986e391");
    assertEq(hex<Sha256>("a" * 127), "c57e9278af78fa3cab38667bef4ce29d783787a2f731d4e12200270f0c32320a");
    assertEq(hex<Sha512>("a" * 127), "828613968b501dc00a97e08c73b118aa8876c26b8aac93df128502ab360f91bab50a51e088769a5c1eff4782ace147dce3642554199876374291f5d921629502");
    assertEq(hex<Sha1>("a" * 127), "89d95fa32ed44a7c610b7ee38517ddf57e0bb975");
    assertEq(hex<Md5>("a" * 127), "020406e1d05cdc2aa287641f7ae2cc39");
    assertEq(hex<Sha256>("a" * 128), "6836cf13bac400e9105071cd6af47084dfacad4e5e302c94bfed24e013afb73e");
    assertEq(hex<Sha512>("a" * 128), "b73d1929aa615934e61a871596b3f3b33359f42b8175602e89f7e06e5f658a243667807ed300314b95cacdd579f3e33abdfbe351909519a846d465c59582f321");
    assertEq(hex<Sha1>("a" * 128), "ad5b3fdbcb526778c2839d2f151ea753995e26a0");
    assertEq(hex<Md5>("a" * 128), "e510683b3f5ffe4093d021808bc6ff70");
    assertEq(hex<Sha256>("a" * 129), "c12cb024a2e5551cca0e08fce8f1c5e314555cc3fef6329ee994a3db752166ae");
    assertEq(hex<Sha512>("a" * 129), "4f681e0bd53cda4b5a2041cc8a06f2eabde44fb16c951fbd5b87702f07aeab611565b19c47fde30587177ebb852e3971bbd8d3fd30da18d71037dfbd98420429");
    assertEq(hex<Sha1>("a" * 129), "d96debf1bdcbc896e6c134ea76e8141f40d78536");
    assertEq(hex<Md5>("a" * 129), "b325dc1c6f5e7a2b7cf465b9feab7948");
}

@Test
fn aDigestFedInPiecesIsTheDigestOfTheWhole(): void {
    let text = utf8("a" * 300);
    let d = Sha512.new();
    d.update(text[..1]);
    d.update(text[1..129]);
    d.update(text[129..129]);
    d.update(text[129..]);
    assertEq(Hex.encode(d.finish()[..]), hex<Sha512>("a" * 300));
    // finishing leaves it as it was
    assertEq(Hex.encode(d.finish()[..]), hex<Sha512>("a" * 300));
    d.update(text[..1]);
    assertEq(Hex.encode(d.finish()[..]), hex<Sha512>("a" * 301));
}

@Test
fn theSizesAreTheDigests(): void {
    assertEq(Sha256.new().finish().length(), Sha256.size);
    assertEq(Sha512.new().finish().length(), Sha512.size);
    assertEq(Sha1.new().finish().length(), Sha1.size);
    assertEq(Md5.new().finish().length(), Md5.size);
    assertEq(Sha256.blockSize, 64);
    assertEq(Sha512.blockSize, 128);
}

@Test
fn theOneLinerIsSha256(): void {
    assertEq(Hex.encode(sha256(utf8("abc")[..]).toArray()[..]), "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad");
}

@Test
fn hmacKeepsRfc2202AndRfc4231(): void {
    assertEq(mac<Sha256>(utf8("Jefe"), utf8("what do ya want for nothing?")), "5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843");
    assertEq(mac<Sha512>(utf8("Jefe"), utf8("what do ya want for nothing?")), "164b7a7bfcf819e2e395fbe73b56e0a387bd64222e831fd610270cd7ea2505549758bf75c05a994a6d034f65f8f0e6fdcaeab1a34d4a6b4b636e070a38bce737");
    assertEq(mac<Sha1>(utf8("Jefe"), utf8("what do ya want for nothing?")), "effcdf6ae5eb2fa2d27416d5f184df9c259a7c79");
    assertEq(mac<Md5>(utf8("Jefe"), utf8("what do ya want for nothing?")), "750c783e6ab0b503eaa86e310a5db738");
    assertEq(mac<Sha256>([0xaau8] * 131, utf8("Test Using Larger Than Block-Size Key - Hash Key First")), "60e431591ee0b67f0d8a26aacbf5b77f8e0bc6213728c5140546040f0ee37f54");
    assertEq(mac<Sha512>([0xaau8] * 131, utf8("Test Using Larger Than Block-Size Key - Hash Key First")), "80b24263c7c1a3ebb71493c1dd7be8b49b46d1f41b4aeec1121b013783f8f3526b56d037e05f2598bd0fd2215d6a1e5295e64f73f63f0aec8b915a985d786598");
}

@Test
fn randomBytesAreAsManyAsAsked(): void {
    assertEq(randomBytes(0).length(), 0);
    assertEq(randomBytes(13).length(), 13);
    // 64 bits twice alike: once in 2^64
    assertTrue(randomUint64() != randomUint64());
    assertFalse(constantTimeEq(randomBytes(32)[..], randomBytes(32)[..]));
}

@Test
fn constantTimeEqComparesBytes(): void {
    assertTrue(constantTimeEq(utf8("abc")[..], utf8("abc")[..]));
    assertFalse(constantTimeEq(utf8("abc")[..], utf8("abd")[..]));
    assertFalse(constantTimeEq(utf8("ab")[..], utf8("abc")[..]));
    assertTrue(constantTimeEq(utf8("")[..], utf8("")[..]));
}
