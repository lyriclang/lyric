// Ranges after M8c S3a (03 S15b, 12 §Iteration): a range of characters walks the scalar values,
// the surrogates passed over, to the ends of the type from either side; an integer range walks
// through the same `Step` as before. And a literal at a view's site (03 S3).
import std.test { assertEq, assertFalse, assertNull, assertTrue };

fn sum(s: Slice<uint8>): int {
    var total = 0;
    for (b in s) {
        total += b as int;
    }
    return total;
}

@Test
fn aRangeOfCharactersWalksBothWays(): void {
    let forward = 'a'..='e';
    assertEq(forward.toArray(), ['a', 'b', 'c', 'd', 'e']);
    var backward = 'a'..'d';
    assertEq(backward.nextBack()!, 'c');
    assertEq(backward.next()!, 'a');
    assertEq(backward.nextBack()!, 'b');
    assertNull(backward.next());
    var none = 'a'..'a';
    assertNull(none.next());
}

@Test
fn theSurrogatesArePassedOver(): void {
    let gap = '\u{D7FF}'..='\u{E000}';
    assertEq(gap.toArray(), ['\u{D7FF}', '\u{E000}']);
    var back = '\u{D7FF}'..='\u{E000}';
    assertEq(back.nextBack()!, '\u{E000}');
    assertEq(back.nextBack()!, '\u{D7FF}');
    assertNull(back.nextBack());
}

@Test
fn theEndsOfTheTypeAreReached(): void {
    let top = '\u{10FFFE}'..='\u{10FFFF}';
    assertEq(top.toArray(), ['\u{10FFFE}', '\u{10FFFF}']);
    var bottom = '\0'..='\u{1}';
    assertEq(bottom.nextBack()!, '\u{1}');
    assertEq(bottom.nextBack()!, '\0');
    assertNull(bottom.nextBack());
    let bytes = 250u8..=255u8;
    assertEq(bytes.toArray().length(), 6);
    let least = int8.min;
    var low = least..=(least + 1);
    assertEq(low.nextBack()!, least + 1);
    assertEq(low.nextBack()!, least);
    assertNull(low.nextBack());
}

@Test
fn membershipIsBetweenTheBounds(): void {
    let letters = 'a'..='z';
    let m = 'm';
    let upper = 'A';
    let z = 'z';
    assertTrue(m in letters);
    assertFalse(upper in letters);
    assertTrue(z in letters);
    let open = 'a'..'z';
    assertFalse(z in open);
}

@Test
fn integerRangesStillWalk(): void {
    let three = 1..=3;
    assertEq(three.toArray(), [1, 2, 3]);
    var down = 0..3;
    assertEq(down.nextBack()!, 2);
}

@Test
fn aLiteralTakesTheViewsElementType(): void {
    assertEq(sum([1, 2, 250]), 253);
    assertEq(sum([]), 0);
}
