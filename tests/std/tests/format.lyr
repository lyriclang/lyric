// The format language (design/v5/spec/08 Y7, 10 S7; spec 12 §2): a hole's spec, checked where it
// is written, applied by std.core — numbers, text, Debug, a Display type, a type's own formats.
import std.core { Format, fstringStart, fstringFormatted, fstringEnd };
import std.string { StringBuilder };
import std.test { assertEq };

@Test
fn widthAlignmentAndFill(): void {
    assertEq(f"[{42:5}] [{42:<5}] [{42:^6}] [{42:^5}] [{42:*>5}]", "[   42] [42   ] [  42  ] [ 42  ] [***42]");
    assertEq(f"[{"ab":4}] [{"ab":>4}] [{'x':^3}] [{true:>5}] [{false:6}]", "[ab  ] [  ab] [ x ] [ true] [false ]");
    // counted in characters, not bytes; a fill beyond ASCII
    assertEq(f"[{"héllo":>7}] [{7:é>3}] [{"ab":1}]", "[  héllo] [éé7] [ab]");
}

@Test
fn integersInARadix(): void {
    assertEq(f"{255:x} {255:X} {255:#x} {255:#X} {5:b} {5:#b} {8:o} {8:#o}", "ff FF 0xff 0XFF 101 0b101 10 0o10");
    assertEq(f"{0xdeadbeef:_x} {255:#06x} {-255:x}", "dead_beef 0x00ff -ff");
}

@Test
fn integersSignedZeroedAndGrouped(): void {
    assertEq(f"{42:+} {-42:+} {0:+} {7:05} {-7:05} {-7:+05}", "+42 -42 +0 00007 -0007 -0007");
    assertEq(f"{1234567:,} {1234567:_} {-1234:,} {999:,} {1000:,}", "1,234,567 1_234_567 -1,234 999 1,000");
    assertEq(f"{1234:x<8,}", "1,234xxx");
}

@Test
fn theExtremesOfEveryWidth(): void {
    let least = int.min;
    assertEq(f"{least} {least:x} {least:,}", "-9223372036854775808 -8000000000000000 -9,223,372,036,854,775,808");
    let most: uint = 18446744073709551615;
    assertEq(f"{most:x} {most:,}", "ffffffffffffffff 18,446,744,073,709,551,615");
    let b: int8 = -128;
    let w: uint8 = 255;
    let s: int16 = -2;
    let u: uint32 = 4096;
    assertEq(f"{b:x} {w:08b} {w:#010b} {s:+} {u:_b}", "-80 11111111 0b11111111 -2 1_0000_0000_0000");
}

@Test
fn floatsFixedAndWithAnExponent(): void {
    assertEq(f"{3.14159:.2f} {3.14159:.2} {2.6:.0f} {2.675:.2f} {1.0:f}", "3.14 3.14 3 2.67 1.000000");
    assertEq(f"{1234.5:e} {1234.5:.2E} {0.00012:.1e}", "1.234500e+03 1.23E+03 1.2e-04");
    assertEq(f"{0.25:%} {0.256:.1%} {1.5:.0%}", "25.000000% 25.6% 150%");
    let h: float32 = 0.1;
    assertEq(f"{h:.3f} {h} {h as float}", "0.100 0.1 0.10000000149011612");
}

@Test
fn aHalfRoundsAwayFromZero(): void {
    // on the exact binary digits: 0.125 and 2.5 are halves, 2.675 and 9.995 lie below theirs
    assertEq(f"{0.125:.2f} {-0.125:.2f} {2.5:.0f} {-2.5:.0f} {0.5:.0f} {1.5:.0f}", "0.13 -0.13 3 -3 1 2");
    assertEq(f"{2.675:.2f} {9.995:.2f} {1.005:.2f} {9.99:.1f}", "2.67 9.99 1.00 10.0");
    assertEq(f"{1.25:.1e} {9.96:.1e} {0.125:.0E} {0.125:.0%} {0.005:.0%}", "1.3e+00 1.0e+01 1E-01 13% 1%");
    // the percentage moves the point on the exact digits: 0.0015 is 0.0015000000000000000312...,
    // a hundredfold 0.15000000000000000312... — above the half; multiplied first it would be 0.1
    assertEq(f"{0.0015:.1%}", "0.2%");
}

@Test
fn zerosAreGroupedWithTheDigits(): void {
    assertEq(f"{1234:010,} {-1234:010,} {1234:08_}", "00,001,234 -0,001,234 0_001_234");
    assertEq(f"{1234.5:010,.1f} {-1234.5:010,.1f} {255:#010_x}", "0,001,234.5 -001,234.5 0x000_00ff");
}

@Test
fn floatsSignedZeroedAndGrouped(): void {
    assertEq(f"{1234567.891:,.2f} {-1234.5:_.1f} {123.4:,}", "1,234,567.89 -1_234.5 123.4");
    assertEq(f"{-1.5:+.1f} {1.5:+.1f} {-0.0:.1f} {3.5:08.2f} {-3.5:08.2f}", "-1.5 +1.5 -0.0 00003.50 -0003.50");
    assertEq(f"[{1.5:>8}] [{1.5:<6}] [{0.1:^7}]", "[     1.5] [1.5   ] [  0.1  ]");
}

@Test
fn floatsThatAreNoNumber(): void {
    let nan = float.nan;
    let inf = float.infinity;
    assertEq(f"{nan:.2f} {nan:E} {inf:e} {-inf:+.1f} {inf:+} {inf:>5}", "nan NAN inf -inf +inf   inf");
}

@Test
fn stringsTakeAPrecision(): void {
    assertEq(f"[{"hello":.3}] [{"hello":>6.2}] [{"héllo":.2}] [{"ab":.5}]", "[hel] [    he] [hé] [ab]");
}

struct Point {
    x: int,
    y: int,
}

class Badge :: [Display] {
    name: string,

    fn show(): string {
        return f"<{this.name}>";
    }
}

/// Formats of its own (10 S7): 'C' and 'F' name the scale.
struct Celsius :: [Format] {
    degrees: float,

    fn format(spec: StringView, &out: StringBuilder): void {
        if (spec == "F") {
            out.appendStr(f"{this.degrees * 1.8 + 32.0}°F");
        } else {
            out.appendStr(f"{this.degrees}°C");
        }
    }
}

@Test
fn debugDisplayAndOwnFormats(): void {
    let p = Point { x = 1, y = -2 };
    assertEq(f"{p:?} {"a":?} {'b':?} [{7:>4?}]", "Point { x = 1, y = -2 } \"a\" 'b' [   7]");
    let badge = Badge { name = "ok" };
    assertEq(f"[{badge:>6}] [{badge:-<6}] [{badge}]", "[  <ok>] [<ok>--] [<ok>]");
    let warm = Celsius { degrees = 25.0 };
    assertEq(f"{warm:F} {warm:C}", "77.0°F 25.0°C");
}

@Test
fn theHelpersAreStdCores(): void {
    var out = fstringStart(4);
    fstringFormatted(&out, 255, "#x");
    assertEq(fstringEnd(out), "0xff");
}

@Test
fn showToWritesEachScalarsText(): void {
    // each scalar's own writer, the string's and the view's (10 S6; M8a S13), at the extremes
    let least = int.min;
    let most: uint = 18446744073709551615;
    let small: int8 = -128;
    let zero = 0;
    let tenth: float32 = 0.1;
    let half = -2.5;
    let o = 'ö';
    let no = false;
    var b = StringBuilder.new();
    least.showTo(&b);
    b.appendChar(' ');
    most.showTo(&b);
    b.appendChar(' ');
    small.showTo(&b);
    b.appendChar(' ');
    zero.showTo(&b);
    b.appendChar(' ');
    tenth.showTo(&b);
    b.appendChar(' ');
    half.showTo(&b);
    b.appendChar(' ');
    o.showTo(&b);
    b.appendChar(' ');
    no.showTo(&b);
    b.appendChar(' ');
    "text".showTo(&b);
    b.appendChar(' ');
    "a view"[2..].showTo(&b);
    assertEq(b.toString(), "-9223372036854775808 18446744073709551615 -128 0 0.1 -2.5 ö false text view");
}

@Test
fn aBuilderAppendsThroughShowTo(): void {
    let b = StringBuilder.new();
    b.append(-5);
    b.append('|');
    b.append(1.5);
    assertEq(b.toString(), "-5|1.5");
}
