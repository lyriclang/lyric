// collect() and FromIterator (design/v5/spec/10 B6, I4; spec 12 §Iteration): the expected type
// built from an iterator's values, in their order, throwing what the iterator throws.
import std.collections { Deque, Heap, List, Map, Set };
import std.test { assertEq, assertTrue };

class Fail :: [Error] {
    fn message(): string { return "fail"; }
}

/// Gives 1, 2, then throws.
struct FailingAtThree :: [Iterator] {
    type Item = int;
    type Error = Fail;
    var i: int,

    mut fn next(): ?int throws Fail {
        this.i = this.i + 1;
        if (this.i == 3) {
            throw Fail {};
        }
        return this.i;
    }
}

fn arrayOfCount(n: int): int[] {
    let out: int[] = (0..n).collect();
    return out;
}

@Test
fn anArrayAtTheEdgesOfItsBuffer(): void {
    for (n in [0, 1, 7, 8, 9, 16, 17, 1000]) {
        let xs = arrayOfCount(n);
        assertEq(xs.length(), n);
        if (n > 0) {
            assertEq(xs[0], 0);
            assertEq(xs[n - 1], n - 1);
        }
    }
    assertEq((0..10).filter((i: int) => i % 3 == 0).toArray().length(), 4);
}

@Test
fn eachContainerInItsOrder(): void {
    let xs: List<string> = ["b", "a", "b"].iter().collect();
    assertEq(f"{xs}", "[\"b\", \"a\", \"b\"]");
    let d: Deque<int> = (1..4).collect();
    assertEq(d.popFront() ?? -1, 1);
    assertEq(d.popBack() ?? -1, 3);
    let s: Set<string> = ["b", "a", "b"].iter().collect();
    assertEq(s.length(), 2);
    assertTrue(s.contains("a"));
    let m: Map<int, string> = [(1, "x"), (2, "y"), (1, "z")].iter().collect();
    assertEq(m.length(), 2);
    assertEq(m.get(1) ?? "", "z");
    let h: Heap<int> = [4, 1, 3, 1].iter().collect();
    assertEq(h.pop() ?? -1, 1);
    assertEq(h.pop() ?? -1, 1);
    assertEq(h.pop() ?? -1, 3);
    assertEq([3, 3, 2].iter().toSet().length(), 2);
}

@Test
fn collectThrowsWhatTheIteratorThrows(): void {
    var caught = "";
    try {
        let xs: List<int> = FailingAtThree { i = 0 }.collect();
        caught = f"{xs.length()}";
    } catch (e: Fail) {
        caught = e.message();
    }
    assertEq(caught, "fail");
}
