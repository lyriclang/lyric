// Result (05 E1; M8c S7): the two bridges — Result.of catches a call's error into a value, get()
// throws it out again — the variants matched, a result built by hand, the join of two errors.
import std.test { assertEq, assertFalse, assertTrue };

class Odd :: [Error] {
    n: int,

    fn message(): string {
        return f"{this.n} is odd";
    }
}

fn half(n: int): int throws Odd {
    if (n % 2 != 0) {
        throw Odd { n = n };
    }
    return n / 2;
}

fn isOk(r: Result<int, Odd>): bool {
    return match (r) {
        .Ok(_) => true,
        .Err(_) => false,
    };
}

@Test
fn ofKeepsTheValueOrTheError(): void {
    let good = Result.of { try half(8) };
    let bad = Result.of { try half(3) };
    assertTrue(isOk(good));
    assertFalse(isOk(bad));
    let message = match (bad) {
        .Ok(_) => "",
        .Err(e) => e.message(),
    };
    assertEq(message, "3 is odd");
}

@Test
fn getThrowsTheErrorAgain(): void throws Odd {
    let good = Result.of { try half(8) };
    assertEq(try good.get(), 4);
    let bad = Result.of { try half(3) };
    let caught = try? bad.get();
    assertTrue(caught == null);
}

@Test
fn resultsAreValuesToCollect(): void {
    let all = [2, 5, 6].iter().map((n: int) => Result.of { try half(n) }).toArray();
    assertEq(all.iter().filter(isOk).count(), 2);
}

@Test
fn aResultIsBuiltByHandToo(): void {
    let r: Result<int, Odd> = .Err(Odd { n = 1 });
    assertFalse(isOk(r));
    let s = Result<string, Odd>.Ok("x");
    assertEq(try! s.get(), "x");
}

@Test
fn twoErrorsJoinToTheRoot(): void {
    let text = "x";
    let r = Result.of { try half(int.parse(text)) };
    let message = match (r) {
        .Ok(_) => "",
        .Err(e) => e.message(),
    };
    assertFalse(message.isEmpty());
}
