// std.core: what the language binds without an import, and through what it binds the helpers
// synthesized members call — they are std.core's own, so a conformance or an operator reaches them.
import std.test { assertEq, assertTrue, assertFalse };
import std.core { arrayOf };
import std.hash { FixedHasher };

struct Row :: [Equatable, Debug, Clone] {
    cells: int[],
    note: ?int,
}

struct Note :: [Equatable, Hashable] {
    value: ?int,
}

struct Tag :: [Clone] {
    name: string,
}

@Test
fn arrayOfMakesEachElementFromItsIndex(): void {
    let xs = arrayOf(4, (i: int) => i * i);
    assertEq(xs.length(), 4);
    assertEq(xs[0], 0);
    assertEq(xs[3], 9);
}

@Test
fn arrayOfZeroIsEmpty(): void {
    assertEq(arrayOf(0, (i: int) => i).length(), 0);
}

@Test
fn aSynthesizedEqualsComparesAnArrayElementByElement(): void {
    assertTrue(Row { cells = [1, 2, 3], note = null } == Row { cells = [1, 2, 3], note = null });
    assertFalse(Row { cells = [1, 2, 3], note = null } == Row { cells = [1, 2], note = null });
    assertFalse(Row { cells = [1, 2, 3], note = null } == Row { cells = [1, 2, 4], note = null });
}

@Test
fn aSynthesizedEqualsHoldsForBothOptionalsAbsent(): void {
    assertTrue(Row { cells = [], note = null } == Row { cells = [], note = null });
    assertFalse(Row { cells = [], note = null } == Row { cells = [], note = 5 });
    assertTrue(Row { cells = [], note = 5 } == Row { cells = [], note = 5 });
}

@Test
fn aSynthesizedDebugWritesTheArrayAndTheOptional(): void {
    assertEq(f"{Row { cells = [1, 2], note = null }:?}", "Row { cells = [1, 2], note = null }");
    let words = ["a", "b"];
    assertEq(f"{words:?}", "[\"a\", \"b\"]");
}

fn noteHash(value: ?int): uint64 {
    var h = FixedHasher.new();
    let note = Note { value = value };
    note.hash(&h);
    return h.finish();
}

@Test
fn aSynthesizedHashWritesAnOptionalsMarkAndValue(): void {
    assertEq(noteHash(3), noteHash(3));
    assertTrue(noteHash(3) != noteHash(null));
    assertTrue(noteHash(0) != noteHash(null));
}

@Test
fn orderingIsEquatableHashableAndDebug(): void {
    assertTrue(Ordering.Less == Ordering.Less);
    assertFalse(Ordering.Less == Ordering.Greater);
    assertTrue(Ordering.Equal != Ordering.Greater);
    assertEq(
        f"{Ordering.Less:?} {Ordering.Equal:?} {Ordering.Greater:?}",
        "Ordering.Less Ordering.Equal Ordering.Greater"
    );
    assertEq(hashOfOrdering(Ordering.Less), hashOfOrdering(Ordering.Less));
    assertTrue(hashOfOrdering(Ordering.Less) != hashOfOrdering(Ordering.Greater));
    let one = 1;
    assertEq(one.totalCompare(2), Ordering.Less);
}

fn hashOfOrdering(o: Ordering): uint64 {
    var h = FixedHasher.new();
    o.hash(&h);
    return h.finish();
}

@Test
fn aRepeatedArrayOfObjectsClonesEachSlot(): void {
    let xs = [Tag { name = "a" }, Tag { name = "b" }] * 2;
    assertEq(xs.length(), 4);
    assertEq(xs[2].name, "a");
    let row = Row { cells = [1, 2], note = null };
    assertEq(row.clone().cells.length(), 2);
}
