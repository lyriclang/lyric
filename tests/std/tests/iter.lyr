// std.core's iteration protocol (design/v5/spec/10 B6): ranges from both ends, the size hint, an
// iterator iterable as itself.
import std.test { assertEq, assertNull };

struct Countdown :: [Iterator] {
    type Item = int;
    var n: int,

    mut fn next(): ?int {
        if (this.n == 0) { return null; }
        this.n = this.n - 1;
        return this.n + 1;
    }
}

fn first<I :: [Iterable]>(i: I): ?I.Iter.Item throws I.Iter.Error {
    var it = i.iter();
    return try it.next();
}

@Test
fn aRangeWalksFromBothEnds(): void {
    var r = 0..4;
    assertEq(r.next() ?? -1, 0);
    assertEq(r.nextBack() ?? -1, 3);
    assertEq(r.next() ?? -1, 1);
    assertEq(r.nextBack() ?? -1, 2);
    assertNull(r.next());
    assertNull(r.nextBack());
    let small: uint8 = 250;
    let top: uint8 = 255;
    var tail = small..top;
    assertEq(tail.nextBack() ?? 0, 254);
}

@Test
fn anInclusiveRangeReachesTheTypesEnds(): void {
    let lo: uint8 = 253;
    let hi: uint8 = 255;
    let r = lo..=hi;
    var seen = "";
    for (v in r) { seen = seen + f"{v} "; }
    assertEq(seen, "253 254 255 ");
    var up = lo..=hi;
    assertEq(up.next() ?? 0, 253);
    assertEq(up.nextBack() ?? 0, 255);
    assertEq(up.next() ?? 0, 254);
    assertNull(up.next());
    assertNull(up.nextBack());
    let bottom: int8 = -128;
    var one = bottom..=bottom;
    assertEq(one.nextBack() ?? 0, -128);
    assertNull(one.nextBack());
    assertNull(one.next());
    var top = hi..=hi;
    assertEq(top.next() ?? 0, 255);
    assertNull(top.next());
    assertNull(top.nextBack());
}

@Test
fn aRangeStaysEmptyOnceDone(): void {
    var r = 5..5;
    assertNull(r.next());
    var back = 3..1;
    assertNull(back.next());
    assertNull(back.nextBack());
}

@Test
fn theSizeHintDefaultsToUnknown(): void {
    let c = Countdown { n = 2 };
    let (low, high) = c.sizeHint();
    assertEq(low, 0);
    assertNull(high);
}

@Test
fn anIteratorIsIterableAsItself(): void {
    assertEq(first(Countdown { n = 3 }) ?? -1, 3);
    assertEq(first(7..9) ?? -1, 7);
    assertNull(first(Countdown { n = 0 }));
}

@Test
fn anArrayIsWalkedFromBothEnds(): void {
    let xs = [1, 2, 3];
    var it = xs.iter();
    let (all, most) = it.sizeHint();
    assertEq(all, 3);
    assertEq(most ?? -1, 3);
    assertEq(it.nextBack() ?? -1, 3);
    assertEq(it.next() ?? -1, 1);
    let (left, _) = it.sizeHint();
    assertEq(left, 1);
    assertEq(it.next() ?? -1, 2);
    assertNull(it.next());
    assertNull(it.nextBack());
    let (none, _) = it.sizeHint();
    assertEq(none, 0);
}

@Test
fn anArrayAndAViewAreIterable(): void {
    let xs = [5, 6, 7, 8];
    assertEq(first(xs) ?? -1, 5);
    assertEq(first(xs[2..]) ?? -1, 7);
    let empty: int[] = [];
    assertNull(first(empty));
    var it = xs[1..3].iter();
    assertEq(it.nextBack() ?? -1, 7);
    assertEq(it.nextBack() ?? -1, 6);
    assertNull(it.nextBack());
}

class Counting :: [Iterator] {
    type Item = int;
    var n: int,
    var pulls: int,

    mut fn next(): ?int {
        this.pulls = this.pulls + 1;
        this.n = this.n + 1;
        return this.n;
    }
}

@Test
fn mapAndFilterChain(): void {
    var seen = "";
    for (x in (1..7).filter((v) => v % 2 == 0).map((v) => v * 10)) { seen = seen + f"{x} "; }
    assertEq(seen, "20 40 60 ");
    var words = "";
    for (w in [1, 2].iter().map((v) => f"<{v}>")) { words = words + w; }
    assertEq(words, "<1><2>");
}

@Test
fn adaptersPullLazily(): void {
    let c = Counting { n = 0, pulls = 0 };
    var m = c.map((v) => v * 2).filter((v) => v > 2);
    assertEq(m.next() ?? -1, 4);
    assertEq(c.pulls, 2);
    assertEq(m.next() ?? -1, 6);
    assertEq(c.pulls, 3);
}

@Test
fn forWalksARangeAndAnIterator(): void {
    var seen = "";
    for (i in 2..5) { seen = seen + f"{i}"; }
    let r = 0..3;
    for (i in r) { seen = seen + f"{i}"; }
    for (i in Countdown { n = 3 }) { seen = seen + f"{i}"; }
    assertEq(seen, "234012321");
}
