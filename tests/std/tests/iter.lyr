// std.core's iteration protocol (design/v5/spec/10 B6): ranges from both ends, the size hint, an
// iterator iterable as itself.
import std.test { assertEq, assertNull, assertTrue };

struct Countdown :: [Iterator] {
    type Item = int;
    var n: int,

    mut fn next(): ?int {
        if (this.n == 0) { return null; }
        this.n = this.n - 1;
        return this.n + 1;
    }
}

fn first<I :: [Iterable]>(i: I): ?I.Iter.Item throws I.Iter.Error {
    var it = i.iter();
    return try it.next();
}

@Test
fn aRangeWalksFromBothEnds(): void {
    var r = 0..4;
    assertEq(r.next() ?? -1, 0);
    assertEq(r.nextBack() ?? -1, 3);
    assertEq(r.next() ?? -1, 1);
    assertEq(r.nextBack() ?? -1, 2);
    assertNull(r.next());
    assertNull(r.nextBack());
    let small: uint8 = 250;
    let top: uint8 = 255;
    var tail = small..top;
    assertEq(tail.nextBack() ?? 0, 254);
}

@Test
fn anInclusiveRangeReachesTheTypesEnds(): void {
    let lo: uint8 = 253;
    let hi: uint8 = 255;
    let r = lo..=hi;
    var seen = "";
    for (v in r) { seen = seen + f"{v} "; }
    assertEq(seen, "253 254 255 ");
    var up = lo..=hi;
    assertEq(up.next() ?? 0, 253);
    assertEq(up.nextBack() ?? 0, 255);
    assertEq(up.next() ?? 0, 254);
    assertNull(up.next());
    assertNull(up.nextBack());
    let bottom: int8 = -128;
    var one = bottom..=bottom;
    assertEq(one.nextBack() ?? 0, -128);
    assertNull(one.nextBack());
    assertNull(one.next());
    var top = hi..=hi;
    assertEq(top.next() ?? 0, 255);
    assertNull(top.next());
    assertNull(top.nextBack());
}

@Test
fn aRangeStaysEmptyOnceDone(): void {
    var r = 5..5;
    assertNull(r.next());
    var back = 3..1;
    assertNull(back.next());
    assertNull(back.nextBack());
}

@Test
fn theSizeHintDefaultsToUnknown(): void {
    let c = Countdown { n = 2 };
    let (low, high) = c.sizeHint();
    assertEq(low, 0);
    assertNull(high);
}

@Test
fn anIteratorIsIterableAsItself(): void {
    assertEq(first(Countdown { n = 3 }) ?? -1, 3);
    assertEq(first(7..9) ?? -1, 7);
    assertNull(first(Countdown { n = 0 }));
}

@Test
fn anArrayIsWalkedFromBothEnds(): void {
    let xs = [1, 2, 3];
    var it = xs.iter();
    let (all, most) = it.sizeHint();
    assertEq(all, 3);
    assertEq(most ?? -1, 3);
    assertEq(it.nextBack() ?? -1, 3);
    assertEq(it.next() ?? -1, 1);
    let (left, _) = it.sizeHint();
    assertEq(left, 1);
    assertEq(it.next() ?? -1, 2);
    assertNull(it.next());
    assertNull(it.nextBack());
    let (none, _) = it.sizeHint();
    assertEq(none, 0);
}

@Test
fn anArrayAndAViewAreIterable(): void {
    let xs = [5, 6, 7, 8];
    assertEq(first(xs) ?? -1, 5);
    assertEq(first(xs[2..]) ?? -1, 7);
    let empty: int[] = [];
    assertNull(first(empty));
    var it = xs[1..3].iter();
    assertEq(it.nextBack() ?? -1, 7);
    assertEq(it.nextBack() ?? -1, 6);
    assertNull(it.nextBack());
}

class Counting :: [Iterator] {
    type Item = int;
    var n: int,
    var pulls: int,

    mut fn next(): ?int {
        this.pulls = this.pulls + 1;
        this.n = this.n + 1;
        return this.n;
    }
}

@Test
fn mapAndFilterChain(): void {
    var seen = "";
    for (x in (1..7).filter((v) => v % 2 == 0).map((v) => v * 10)) { seen = seen + f"{x} "; }
    assertEq(seen, "20 40 60 ");
    var words = "";
    for (w in [1, 2].iter().map((v) => f"<{v}>")) { words = words + w; }
    assertEq(words, "<1><2>");
}

@Test
fn adaptersPullLazily(): void {
    let c = Counting { n = 0, pulls = 0 };
    var m = c.map((v) => v * 2).filter((v) => v > 2);
    assertEq(m.next() ?? -1, 4);
    assertEq(c.pulls, 2);
    assertEq(m.next() ?? -1, 6);
    assertEq(c.pulls, 3);
}

fn text<I :: [Iterator<Item = int, Error = never>]>(it: I): string {
    var out = "";
    for (x in it) { out = out + f"{x}"; }
    return out;
}

@Test
fn takeAndSkip(): void {
    assertEq(text((0..10).take(3)), "012");
    assertEq(text((0..2).take(5)), "01");
    assertEq(text((0..5).skip(3)), "34");
    assertEq(text((0..2).skip(5)), "");
    assertEq(text((0..10).skip(2).take(3)), "234");
}

@Test
fn whileAdaptersStopAndStart(): void {
    assertEq(text([1, 2, 5, 1].iter().takeWhile((v) => v < 3)), "12");
    assertEq(text([1, 2, 5, 1].iter().skipWhile((v) => v < 3)), "51");
    var t = [1, 5, 1].iter().takeWhile((v) => v < 3);
    assertEq(t.next() ?? -1, 1);
    assertNull(t.next());
    assertNull(t.next());
}

@Test
fn stepByTakesEveryNth(): void {
    assertEq(text((0..10).stepBy(3)), "0369");
    assertEq(text((0..3).stepBy(1)), "012");
}

@Test
fn enumerateAndInspect(): void {
    var seen = "";
    for ((i, w) in ["a", "b"].iter().enumerate()) { seen = seen + f"{i}{w}"; }
    assertEq(seen, "0a1b");
    let c = Counting { n = 0, pulls = 0 };
    let total = text((0..3).inspect((v) => { c.pulls = c.pulls + v; }));
    assertEq(total, "012");
    assertEq(c.pulls, 3);
}

@Test
fn zipStopsAtTheShorter(): void {
    var seen = "";
    for ((n, w) in (1..9).zip(["a", "b", "c"])) { seen = seen + f"{n}{w}"; }
    assertEq(seen, "1a2b3c");
    var z = [1, 2].iter().zip(10..11);
    let first = z.next();
    assertEq(first!.1, 10);
    assertEq(z.next() == null, true);
}

@Test
fn chainWalksOneThenTheOther(): void {
    assertEq(text((0..2).chain(5..7)), "0156");
    assertEq(text((0..0).chain(3..4)), "3");
    assertEq(text([1, 2].iter().chain([3].iter())), "123");
}

@Test
fn countFoldReduce(): void {
    assertEq((0..5).count(), 5);
    assertEq((0..0).count(), 0);
    assertEq((1..5).fold(0, (acc, v) => acc + v), 10);
    assertEq((1..4).map((v) => f"{v}").fold("", (acc, s) => acc + s), "123");
    assertEq((1..5).reduce((a, b) => a * b) ?? -1, 24);
    assertNull((0..0).reduce((a, b) => a + b));
}

@Test
fn firstLastNth(): void {
    assertEq((3..9).first() ?? -1, 3);
    assertEq((3..9).last() ?? -1, 8);
    assertEq((3..9).nth(2) ?? -1, 5);
    assertNull((3..9).nth(6));
    assertNull((3..9).nth(-1));
    assertNull((0..0).first());
    assertNull((0..0).last());
}

@Test
fn predicatesStopEarly(): void {
    let c = Counting { n = 0, pulls = 0 };
    assertTrue(c.any((v) => v == 3));
    assertEq(c.pulls, 3);
    assertTrue((1..5).all((v) => v > 0));
    assertTrue((0..0).all((v) => v > 99));
    assertTrue((1..5).none((v) => v > 9));
    assertEq((1..9).find((v) => v * v > 10) ?? -1, 4);
    assertEq((1..9).position((v) => v == 4) ?? -1, 3);
    assertNull((1..9).position((v) => v == 40));
}

@Test
fn forEachAndToArray(): void {
    let c = Counting { n = 0, pulls = 0 };
    (0..4).forEach((v) => { c.pulls = c.pulls + v; });
    assertEq(c.pulls, 6);
    let xs = (2..5).toArray();
    assertEq(xs.length(), 3);
    assertEq(xs[2], 4);
}

@Test
fn sumAndProduct(): void {
    assertEq((1..5).sum(), 10);
    assertEq((1..5).product(), 24);
    assertEq((0..0).sum(), 0);
    assertEq((0..0).product(), 1);
    assertEq([0.5, 0.25].iter().sum(), 0.75);
    let small: uint8 = 3;
    let top: uint8 = 6;
    assertEq((small..top).sum(), 12);
}

@Test
fn minAndMax(): void {
    assertEq([3, 1, 2].iter().min() ?? -1, 1);
    assertEq([3, 1, 2].iter().max() ?? -1, 3);
    assertNull((0..0).min());
    assertEq([2.5, -1.5, 0.5].iter().min() ?? 0.0, -1.5);
    assertEq((1..4).map((v) => -v).max() ?? 0, -1);
}

@Test
fn joinShowsWithASeparator(): void {
    assertEq((1..4).join(", "), "1, 2, 3");
    assertEq((0..0).join(", "), "");
    assertEq(["x"].iter().join("-"), "x");
}

@Test
fn forWalksARangeAndAnIterator(): void {
    var seen = "";
    for (i in 2..5) { seen = seen + f"{i}"; }
    let r = 0..3;
    for (i in r) { seen = seen + f"{i}"; }
    for (i in Countdown { n = 3 }) { seen = seen + f"{i}"; }
    assertEq(seen, "234012321");
}
