// std.syntax: the syntax tree as values at compile time - read
// from text, built by hand, walked, written back as the formatter writes it.
import std.test { assertEq, assertTrue };
import std.syntax { parseExpr, parseStmts, parseDecls, Expr, Ident, Literal, BinaryOp, Span, Node, Block };

fn sumOfOneAndX(): string {
    let one = Expr.Literal(Literal.Int(1, null), Span.none());
    let x = Expr.Name(Ident.of("x"));
    let sum = Expr.Binary(Box<Expr> { value = one }, BinaryOp.Add, Box<Expr> { value = x }, Span.none());
    return sum.toSource();
}

fn nodeCount(text: string): int {
    var n = 0;
    Node.Expr(Box<Expr> { value = parseExpr(text) }).walk(node => { n = n + 1; });
    return n;
}

fn boundNames(text: string): string {
    var out = "";
    for (s in parseStmts(text)) {
        match (s) {
            .Let(_, name, _, _, _, _) => { out = out + name.name + ";"; },
            _ => { out = out + "?;"; },
        }
    }
    return out;
}

fn declNames(text: string): string {
    var out = "";
    for (d in parseDecls(text)) {
        match (d) {
            .Fn(f) => { out = out + "fn " + f.name.name + ";"; },
            .Struct(t) => { out = out + "struct " + t.name.name + ";"; },
            .Enum(e) => { out = out + "enum " + e.name.name + ";"; },
            _ => { out = out + "?;"; },
        }
    }
    return out;
}

fn whereIs(): string {
    return match (parseExpr("  foo")) {
        .Name(id) => f"{id.span.line}:{id.span.column}",
        _ => "?",
    };
}

@Test
fn aTextIsReadAndWrittenBack(): void {
    assertEq(comptime parseExpr("1 + 2 * x").toSource(), "1 + 2 * x");
    assertEq(comptime parseExpr("xs.map(x => x + 1)[0]?.name ?? \"none\"").toSource(), "xs.map(x => x + 1)[0]?.name ?? \"none\"");
    assertEq(comptime parseStmts("let x = 1;\nwhile (x < 3) { x++; }")[1].toSource(), "while (x < 3) {\n    x++;\n}");
    assertEq(comptime parseDecls("pub fn f(a: int): int { return a; }")[0].toSource(), "pub fn f(a: int): int {\n    return a;\n}");
}

@Test
fn aTreeIsBuiltByHand(): void {
    assertEq(comptime sumOfOneAndX(), "1 + x");
    assertEq(comptime Block { stmts = parseStmts("let q = 2; q"), span = Span.none() }.toSource(), "let q = 2;\nq");
}

@Test
fn aTreeIsWalked(): void {
    // Call, its callee, the sum with its two sides, the array with its two elements
    assertEq(comptime nodeCount("f(a + 1, [2, 3])"), 8);
    assertEq(comptime boundNames("let a = 1; var b = a + 2;"), "a;b;");
    assertEq(comptime declNames("fn f(): void { }\nstruct P { x: int }\nenum E { A, B }"), "fn f;struct P;enum E;");
}

@Test
fn aNodeKnowsWhereItStands(): void {
    assertEq(comptime whereIs(), "1:3");
    assertEq(comptime Ident.of("y").span.line, 0);
}

@Test
fn freshNamesDiffer(): void {
    // 'comptime' binds tighter than '!=': the parentheses make the comparison the site
    assertTrue(comptime (Ident.fresh("tmp").name != Ident.fresh("tmp").name));
    assertTrue(comptime Ident.fresh("tmp").name.startsWith("tmp"));
}

@Test
fn aLiteralIsWrittenFromItsValue(): void {
    assertEq(comptime parseExpr("-1.5e3 + 'c' + \"q\\\"t\\n\" + b\"ab\" + 0x10u8").toSource(), "-1500.0 + 'c' + \"q\\\"t\\n\" + b\"ab\" + 16u8");
}
