// The standard library's benchmarks (10 X4; M8c S12b): `lyric5 bench -C tests/std` runs them, in
// the release profile. Each is small — a thousand of a thing, or a page of bytes —, so a run is
// measured often in a tenth of a second; blackBox keeps what the body computes.
import std.core { blackBox };
import std.crypto { sha256 };
import std.hash { crc32 };

fn page(): uint8[] {
    var bytes: uint8[] = [0u8] * 4096;
    for (i in 0..4096) {
        bytes[i] = (i * 31 % 251) as uint8;
    }
    return bytes;
}

@Bench
fn mapInsertAndFind(&b: Bench): void {
    b.iter {
        let m = Map<int, int>.new();
        for (i in 0..1000) {
            m[i] = i * 2;
        }
        var found = 0;
        for (i in 0..2000) {
            if (m.get(i) != null) {
                found += 1;
            }
        }
        let _ = blackBox(found);
    }
}

@Bench
fn listPushAndWalk(&b: Bench): void {
    b.iter {
        let xs = List<int>.new();
        for (i in 0..1000) {
            xs.push(i);
        }
        var sum = 0;
        for (x in xs) {
            sum += x;
        }
        let _ = blackBox(sum);
    }
}

@Bench
fn sortAThousand(&b: Bench): void {
    let base = arrayOfSeed(1000, 7);
    b.iter {
        let xs = base.clone();
        xs.sort();
        let _ = blackBox(xs[0]);
    }
}

fn arrayOfSeed(n: int, seed: int): int[] {
    var x = seed;
    var out: int[] = [0] * n;
    for (i in 0..n) {
        x = (x * 1103515245 + 12345) % 2147483648;
        out[i] = x;
    }
    return out;
}

@Bench
fn formatALine(&b: Bench): void {
    let name = "lyric";
    b.iter {
        let line = f"{name} {42} {3.5:.2f} {true}";
        let _ = blackBox(line.length());
    }
}

@Bench
fn parseNumbers(&b: Bench): void {
    let texts = ["0", "7", "42", "-13", "65535", "1000000", "-2147483648", "9223372036854775807"];
    b.iter {
        var sum = 0;
        for (t in texts) {
            sum = sum +% (try! int.parse(t));
        }
        let _ = blackBox(sum);
    }
}

@Bench
fn crc32OfAPage(&b: Bench): void {
    let bytes = page();
    b.bytes(4096);
    b.iter {
        let _ = blackBox(crc32(bytes));
    }
}

@Bench
fn sha256OfAPage(&b: Bench): void {
    let bytes = page();
    b.bytes(4096);
    b.iter {
        let _ = blackBox(sha256(bytes));
    }
}

@Bench
fn charsOfAText(&b: Bench): void {
    let text = "Grüße aus Zürich — 東京 und São Paulo, ünd zurück. " * 20;
    b.bytes(text.toBytes().length());
    b.iter {
        var n = 0;
        for (_ in text.chars()) {
            n += 1;
        }
        let _ = blackBox(n);
    }
}
