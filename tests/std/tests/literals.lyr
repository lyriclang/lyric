// An array literal where a FromArrayLiteral is expected (10 K4; M8c S6b): the collections, the empty
// literal, an argument and a return, a literal inside a literal, a type of the program's own.
import std.collections { Deque, Heap, List, Map, Set };
import std.core { FromArrayLiteral };
import std.test { assertEq, assertFalse, assertTrue };

struct Total :: [FromArrayLiteral<int>] {
    sum: int,

    static fn fromLiteral(items: int[]): Total {
        var sum = 0;
        for (x in items) {
            sum += x;
        }
        return Total { sum = sum };
    }
}

struct Count<T> :: [FromArrayLiteral<T>] {
    n: int,

    static fn fromLiteral(items: T[]): Count<T> {
        return Count<T> { n = items.length() };
    }
}

fn names(): Set<string> {
    return ["ann", "bob", "ann"];
}

fn length(xs: List<int>): int {
    return xs.length();
}

@Test
fn theCollectionsTakeALiteral(): void {
    let s: Set<int> = [3, 1, 3];
    assertEq(s.length(), 2);
    let m: Map<string, int> = [("a", 1), ("b", 2), ("a", 3)];
    assertEq(m.get("a")!, 3);
    let l: List<int> = [1, 2, 3];
    assertEq(l.toArray(), [1, 2, 3]);
    let d: Deque<int> = [5, 6];
    assertEq(d.popFront()!, 5);
    let h: Heap<int> = [4, 2, 9];
    assertEq(h.pop()!, 2);
}

@Test
fn theEmptyLiteralTakesTheTypesElement(): void {
    let s: Set<string> = [];
    assertTrue(s.isEmpty());
    let m: Map<int, int> = [];
    assertEq(m.length(), 0);
}

@Test
fn theLiteralCoercesThroughAnOptional(): void {
    let maybe: ?Set<int> = [1, 2, 2];
    assertEq(maybe!.length(), 2);
}

@Test
fn anArgumentAndAReturnAreExpectedTypes(): void {
    assertEq(length([1, 2]), 2);
    assertEq(names().length(), 2);
    let ann = "ann";
    assertTrue(names().contains(ann));
}

@Test
fn aLiteralInsideALiteral(): void {
    let m: Map<string, List<int>> = [("a", [1, 2]), ("b", [])];
    assertEq(m.get("a")!.toArray(), [1, 2]);
    assertTrue(m.get("b")!.isEmpty());
    let sets: List<Set<int>> = [[1, 1], [2]];
    assertEq(sets[0].length(), 1);
}

@Test
fn aTypeOfTheProgramsOwn(): void {
    let t: Total = [1, 2, 3];
    assertEq(t.sum, 6);
    let none: Total = [];
    assertEq(none.sum, 0);
    let c: Count<string> = ["a", "b"];
    assertEq(c.n, 2);
}

@Test
fn anArrayStaysAnArray(): void {
    let xs: int[] = [1, 2];
    assertEq(xs.length(), 2);
    let plain = [1, 2];
    assertFalse(plain.isEmpty());
}
