// std.string's operations counted in characters, the search from a byte, the white space, case
// without case, and a search whose pattern's first byte stands everywhere.
import std.test { assertEq, assertFalse, assertNull, assertPanics, assertTrue };

@Test
fn substringAndCharAtCountCharacters(): void {
    let s = "héllo";
    assertEq(s.substring(1, 3), "él");
    assertEq(s.substring(0, 5), "héllo");
    assertEq(s.substring(5, 5), "");
    assertEq(s.charAt(1), 'é');
    assertEq(s.charAt(4), 'o');
    assertEq("añ€😀".substring(2, 4), "€😀");
}

@Test
fn substringAndCharAtPanicOutsideTheCharacters(): void {
    let _ = assertPanics(
        () => {
            let _ = "abc".substring(2, 4);
        }
    );
    let _ = assertPanics(
        () => {
            let _ = "abc".substring(2, 1);
        }
    );
    let _ = assertPanics(
        () => {
            let _ = "abc".charAt(3);
        }
    );
    let _ = assertPanics(
        () => {
            let _ = "abc".charAt(-1);
        }
    );
}

@Test
fn charIndexAndBoundariesConvertBytesToCharacters(): void {
    let s = "héllo";
    assertEq(s.charIndex(0), 0);
    assertEq(s.charIndex(3), 2);
    assertEq(s.charIndex(6), 5);
    assertTrue(s.isCharBoundary(1));
    assertFalse(s.isCharBoundary(2));
    assertTrue(s.isCharBoundary(6));
    assertFalse(s.isCharBoundary(7));
    assertFalse(s.isCharBoundary(-1));
    let _ = assertPanics(
        () => {
            let _ = "héllo".charIndex(2);
        }
    );
}

@Test
fn findFromSearchesFromAByte(): void {
    let s = "héllo";
    assertEq(s.findFrom("l", 0), 3);
    assertEq(s.findFrom("l", 4), 4);
    assertNull(s.findFrom("l", 5));
    assertEq(s.findFrom("", 6), 6);
    let _ = assertPanics(
        () => {
            let _ = "héllo".findFrom("l", 2);
        }
    );
}

@Test
fn firstOfFindsAnyOfTheCharacters(): void {
    assertEq("héllo".firstOf("lo"), 3);
    assertEq("héllo".firstOf("é"), 1);
    assertNull("héllo".firstOf("xyz"));
    assertNull("héllo".firstOf(""));
}

@Test
fn splitWhitespaceGivesNoEmptyPart(): void {
    let words = "  a  bc\td\n".splitWhitespace().toArray();
    assertEq(words.length(), 3);
    assertEq(words[0], "a");
    assertEq(words[1], "bc");
    assertEq(words[2], "d");
    assertEq("   ".splitWhitespace().toArray().length(), 0);
}

@Test
fn rsplitOnceSplitsAtTheLast(): void {
    let (left, right) = "a=b=c".rsplitOnce("=")!;
    assertEq(left, "a=b");
    assertEq(right, "c");
    assertNull("abc".rsplitOnce("="));
}

@Test
fn repeatAndIsAscii(): void {
    assertEq("ab".repeat(3), "ababab");
    assertEq("ab".repeat(0), "");
    assertTrue("abc".isAscii());
    assertTrue("".isAscii());
    assertFalse("héllo".isAscii());
}

@Test
fn caseIsComparedBySimpleLowercase(): void {
    assertTrue("HeLLo".equalsIgnoreCase("hello"));
    assertFalse("Straße".equalsIgnoreCase("STRASSE"));
    assertEq("abc".compareIgnoreCase("ABD"), Ordering.Less);
    assertEq("ABC".compareIgnoreCase("ab"), Ordering.Greater);
    assertEq("Équipe".compareIgnoreCase("équipe"), Ordering.Equal);
}

/// A pattern whose first byte stands everywhere in the text: a place times the pattern's length
/// for a search that compares at each place, linear for this one.
@Test
fn aPatternWhoseFirstByteStandsEverywhereIsFound(): void {
    let hay = "a".repeat(200000) + "b";
    let needle = "a".repeat(5000) + "b";
    assertEq(hay.find(needle), 200000 - 5000);
    assertNull(hay.find("a".repeat(5000) + "c"));
    assertEq(hay.count("a".repeat(5000)), 40);
}
