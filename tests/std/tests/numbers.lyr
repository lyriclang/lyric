// std.core's numbers (design/v5/spec/10 B5): the tower, its static members, the defaults on it.
import std.test { assertEq, assertTrue, assertFalse, assertNull, assertNotNull };
import std.core { Num, Signed, Integer };

fn total<T :: [Num]>(xs: T[]): T {
    var sum = T.zero;
    for (i in 0..xs.length()) {
        sum = sum + xs[i];
    }
    return sum;
}

fn magnitude<T :: [Signed]>(x: T): T {
    return x.abs();
}

fn span<T :: [Integer]>(sample: T): string {
    return f"{T.min}..{T.max} in {T.bitWidth} bits, signed {T.isSigned}";
}

@Test
fn aGenericSumStaysInTheType(): void {
    assertEq(total([1, 2, 3]), 6);
    assertEq(total([1.5, 2.25]), 3.75);
    let none: int[] = [];
    assertEq(total(none), 0);
}

@Test
fn theIntegersKnowTheirRange(): void {
    let small: int8 = 0;
    let byte: uint8 = 0;
    assertEq(span(small), "-128..127 in 8 bits, signed true");
    assertEq(span(byte), "0..255 in 8 bits, signed false");
    assertEq(span(0), "-9223372036854775808..9223372036854775807 in 64 bits, signed true");
    assertEq(uint.max, 18446744073709551615);
    assertEq(int32.min, -2147483648);
}

@Test
fn absAndSignumAreDefaults(): void {
    assertEq((-5).abs(), 5);
    assertEq(magnitude(-7), 7);
    assertEq(magnitude(-2.5), 2.5);
    assertEq((-3).signum(), -1);
    assertEq(0.signum(), 0);
    assertEq(4.signum(), 1);
    let x: int8 = -9;
    assertEq(x.abs(), 9);
}

@Test
fn checkedArithmeticSaysWhereItLeavesTheType(): void {
    let top: int8 = 127;
    let bottom: int8 = -128;
    let one: int8 = 1;
    assertNull(top.checkedAdd(one));
    assertNull(bottom.checkedSub(one));
    assertNull(top.checkedMul(2));
    assertNull(bottom.checkedDiv(-1));
    assertNull(top.checkedDiv(0));
    assertEq(assertNotNull(bottom.checkedRem(-1)), 0);
    assertEq(assertNotNull(bottom.checkedDiv(top)), -1);
    assertEq(assertNotNull(top.checkedRem(top)), 0);
    assertEq(assertNotNull((100 as int8).checkedAdd(27)), 127);
    let max: uint = 18446744073709551615;
    assertNull(max.checkedAdd(1));
    assertEq(assertNotNull(0.checkedSub(1)), -1);
    let zero: uint8 = 0;
    assertNull(zero.checkedSub(1));
}

@Test
fn saturatingArithmeticHoldsAtTheBounds(): void {
    let top: int8 = 127;
    let bottom: int8 = -128;
    assertEq(top.saturatingAdd(1), 127);
    assertEq(bottom.saturatingAdd(-1), -128);
    assertEq(bottom.saturatingSub(1), -128);
    assertEq(top.saturatingSub(-1), 127);
    assertEq(top.saturatingMul(2), 127);
    assertEq(top.saturatingMul(-2), -128);
    let byte: uint8 = 250;
    assertEq(byte.saturatingAdd(10), 255);
    assertEq(byte.saturatingSub(255), 0);
}

@Test
fn wrappingArithmeticWrapsAtTheWidth(): void {
    let top: int8 = 127;
    let bottom: int8 = -128;
    assertEq(top.wrappingAdd(1), -128);
    assertEq(bottom.wrappingSub(1), 127);
    assertEq(top.wrappingMul(2), -2);
    assertEq(bottom.wrappingDiv(-1), -128);
    assertEq(bottom.wrappingRem(-1), 0);
    assertEq(bottom.wrappingDiv(top), -1);
    assertEq(top.wrappingRem(top), 0);
    let byte: uint8 = 255;
    assertEq(byte.wrappingAdd(1), 0);
}

@Test
fn powSquares(): void {
    assertEq(2.pow(10), 1024);
    assertEq(3.pow(0), 1);
    assertEq((-2).pow(3), -8);
    let byte: uint8 = 2;
    assertEq(byte.pow(7), 128);
}

@Test
fn theBitsCountAtTheTypesWidth(): void {
    let eight: uint8 = 8;
    assertEq(eight.leadingZeros(), 4);
    assertEq(eight.trailingZeros(), 3);
    assertEq(eight.popCount(), 1);
    let zero: uint16 = 0;
    assertEq(zero.leadingZeros(), 16);
    assertEq(zero.trailingZeros(), 16);
    let minus: int8 = -1;
    assertEq(minus.popCount(), 8);
    assertEq(minus.leadingZeros(), 0);
    assertEq(1.leadingZeros(), 63);
}

@Test
fn rotationsGoRoundTheWidth(): void {
    let high: uint8 = 128;
    assertEq(high.rotateLeft(1), 1);
    assertEq(high.rotateRight(7), 1);
    let one: uint8 = 1;
    assertEq(one.rotateLeft(9), 2);
    assertEq(one.rotateLeft(-1), 128);
    assertEq(one.rotateRight(-1), 2);
    assertEq(high.rotateRight(15), 1);
    assertEq(one.rotateRight(int.min), 1);
    let minus: int8 = -128;
    assertEq(minus.rotateLeft(1), 1);
}

@Test
fn zeroIsZero(): void {
    assertTrue(0.isZero());
    assertFalse(1.isZero());
    assertTrue(0.0.isZero());
    let z: uint16 = 0;
    assertTrue(z.isZero());
}
