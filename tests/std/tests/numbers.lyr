// std.core's numbers: the tower, its static members, the defaults on it.
import std.math {
    abs,
    checkedAdd,
    checkedDiv,
    checkedMul,
    checkedRem,
    checkedSub,
    leadingZeros,
    popCount,
    rotateLeft,
    rotateRight,
    saturatingAdd,
    saturatingMul,
    saturatingSub,
    signum,
    trailingZeros,
    wrappingAdd,
    wrappingDiv,
    wrappingMul,
    wrappingRem,
    wrappingSub,
};
import std.test { assertEq, assertTrue, assertFalse, assertNull, assertNotNull };
import std.core { Signed };

fn total<T :: [Num]>(xs: T[]): T {
    var sum = T.zero;
    for (i in 0..xs.length()) {
        sum = sum + xs[i];
    }
    return sum;
}

fn magnitude<T :: [Signed]>(x: T): T {
    return abs(x);
}

fn span<T :: [Integer]>(_sample: T): string {
    return f"{T.min}..{T.max} in {T.bitWidth} bits, signed {T.isSigned}";
}

@Test
fn aGenericSumStaysInTheType(): void {
    assertEq(total([1, 2, 3]), 6);
    assertEq(total([1.5, 2.25]), 3.75);
    let none: int[] = [];
    assertEq(total(none), 0);
}

@Test
fn theIntegersKnowTheirRange(): void {
    let small: int8 = 0;
    let byte: uint8 = 0;
    assertEq(span(small), "-128..127 in 8 bits, signed true");
    assertEq(span(byte), "0..255 in 8 bits, signed false");
    assertEq(span(0), "-9223372036854775808..9223372036854775807 in 64 bits, signed true");
    assertEq(uint.max, 18446744073709551615);
    assertEq(int32.min, -2147483648);
}

@Test
fn absAndSignumAreMathsOverSigned(): void {
    assertEq(abs(-5), 5);
    assertEq(magnitude(-7), 7);
    assertEq(magnitude(-2.5), 2.5);
    assertEq(signum(-3), -1);
    assertEq(signum(0), 0);
    assertEq(signum(4), 1);
    let x: int8 = -9;
    assertEq(abs(x), 9);
}

@Test
fn checkedArithmeticSaysWhereItLeavesTheType(): void {
    let top: int8 = 127;
    let bottom: int8 = -128;
    let one: int8 = 1;
    assertNull(checkedAdd(top, one));
    assertNull(checkedSub(bottom, one));
    assertNull(checkedMul(top, 2));
    assertNull(checkedDiv(bottom, -1));
    assertNull(checkedDiv(top, 0));
    assertEq(assertNotNull(checkedRem(bottom, -1)), 0);
    assertEq(assertNotNull(checkedDiv(bottom, top)), -1);
    assertEq(assertNotNull(checkedRem(top, top)), 0);
    assertEq(assertNotNull(checkedAdd((100 as int8), 27)), 127);
    let max: uint = 18446744073709551615;
    assertNull(checkedAdd(max, 1));
    assertEq(assertNotNull(checkedSub(0, 1)), -1);
    let zero: uint8 = 0;
    assertNull(checkedSub(zero, 1));
}

@Test
fn saturatingArithmeticHoldsAtTheBounds(): void {
    let top: int8 = 127;
    let bottom: int8 = -128;
    assertEq(saturatingAdd(top, 1), 127);
    assertEq(saturatingAdd(bottom, -1), -128);
    assertEq(saturatingSub(bottom, 1), -128);
    assertEq(saturatingSub(top, -1), 127);
    assertEq(saturatingMul(top, 2), 127);
    assertEq(saturatingMul(top, -2), -128);
    let byte: uint8 = 250;
    assertEq(saturatingAdd(byte, 10), 255);
    assertEq(saturatingSub(byte, 255), 0);
}

@Test
fn wrappingArithmeticWrapsAtTheWidth(): void {
    let top: int8 = 127;
    let bottom: int8 = -128;
    assertEq(wrappingAdd(top, 1), -128);
    assertEq(wrappingSub(bottom, 1), 127);
    assertEq(wrappingMul(top, 2), -2);
    assertEq(wrappingDiv(bottom, -1), -128);
    assertEq(wrappingRem(bottom, -1), 0);
    assertEq(wrappingDiv(bottom, top), -1);
    assertEq(wrappingRem(top, top), 0);
    let byte: uint8 = 255;
    assertEq(wrappingAdd(byte, 1), 0);
}

@Test
fn powSquares(): void {
    assertEq(2.pow(10), 1024);
    assertEq(3.pow(0), 1);
    assertEq((-2).pow(3), -8);
    let byte: uint8 = 2;
    assertEq(byte.pow(7), 128);
}

@Test
fn theBitsCountAtTheTypesWidth(): void {
    let eight: uint8 = 8;
    assertEq(leadingZeros(eight), 4);
    assertEq(trailingZeros(eight), 3);
    assertEq(popCount(eight), 1);
    let zero: uint16 = 0;
    assertEq(leadingZeros(zero), 16);
    assertEq(trailingZeros(zero), 16);
    let minus: int8 = -1;
    assertEq(popCount(minus), 8);
    assertEq(leadingZeros(minus), 0);
    assertEq(leadingZeros(1), 63);
}

@Test
fn rotationsGoRoundTheWidth(): void {
    let high: uint8 = 128;
    assertEq(rotateLeft(high, 1), 1);
    assertEq(rotateRight(high, 7), 1);
    let one: uint8 = 1;
    assertEq(rotateLeft(one, 9), 2);
    assertEq(rotateLeft(one, -1), 128);
    assertEq(rotateRight(one, -1), 2);
    assertEq(rotateRight(high, 15), 1);
    assertEq(rotateRight(one, int.min), 1);
    let minus: int8 = -128;
    assertEq(rotateLeft(minus, 1), 1);
}

@Test
fn zeroIsZero(): void {
    assertTrue(0.isZero());
    assertFalse(1.isZero());
    assertTrue(0.0.isZero());
    let z: uint16 = 0;
    assertTrue(z.isZero());
}
