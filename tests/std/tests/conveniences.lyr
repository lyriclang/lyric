// std.fs's conveniences: a file read and written whole, appended
// to, its lines one by one — the lines' iterator closed at its end, at an error, and by a loop that
// leaves early —; and every kind a file can give, each with its path.
// Each test that writes works in a directory of its own from fs.tempDir() and removes it: a run
// leaves nothing in its working directory.
import std.fs;
import std.fs { File, OpenOptions };
import std.io { IoError, IoErrorKind };
import std.path;
import std.task { Cancelled };
import std.test { assertEq, assertNull, assertTrue, fail };

fn posix(): bool {
    return path.separator == "/";
}

/// What `f` throws, or `null`. A default called on a `File` declares `Cancelled`, as it does for any
/// reader; nothing here cancels, so one would be the test's failure.
fn thrown(f: fn() -> void throws [IoError, Cancelled]): ?IoError {
    try {
        f();
        return null;
    } catch (e: IoError) {
        return e;
    } catch (_: Cancelled) {
        fail("cancelled, where nothing cancels");
    }
}

/// The kind and the message of what `f` throws.
fn said(f: fn() -> void throws [IoError, Cancelled]): string {
    if (let e = thrown(f)) {
        return e.message();
    }
    return "nothing thrown";
}

@Test
fn aFileIsReadAndWrittenWhole(): void throws IoError {
    let w = try fs.tempDir();
    let a = path.join(w, "conv-a.txt");
    let b = path.join(w, "conv-b.bin");
    try fs.writeText(a, "héllo, file\nsecond line\n");
    assertEq(try fs.readText(a), "héllo, file\nsecond line\n");
    assertEq((try fs.readBytes(a)).length(), 25);
    let bytes: uint8[] = [0u8, 255u8, 10u8, 13u8];
    try fs.writeBytes(b, bytes[..]);
    let back = try fs.readBytes(b);
    assertEq(back.length(), 4);
    assertEq(back[1], 255u8);
    // a write cuts what was there
    try fs.writeText(a, "x");
    assertEq(try fs.readText(a), "x");
    try fs.writeText(path.join(w, "conv-empty.txt"), "");
    assertEq(try fs.readText(path.join(w, "conv-empty.txt")), "");
    try fs.removeAll(w);
}

@Test
fn appendTextWritesAtTheEndAndMakesTheFile(): void throws IoError {
    let w = try fs.tempDir();
    let log = path.join(w, "conv-log.txt");
    try fs.writeText(log, "one");
    try fs.appendText(log, " two");
    try fs.appendText(log, " three");
    assertEq(try fs.readText(log), "one two three");
    // where it is not there, the first append makes it
    let made = path.join(w, "conv-made.txt");
    try fs.appendText(made, "made");
    assertEq(try fs.readText(made), "made");
    try fs.removeAll(w);
}

@Test
fn aByteOrderMarkIsText(): void throws IoError {
    let w = try fs.tempDir();
    let marked: uint8[] = [0xEFu8, 0xBBu8, 0xBFu8, 0x61u8];
    try fs.writeBytes(path.join(w, "conv-bom.txt"), marked[..]);
    let text = try fs.readText(path.join(w, "conv-bom.txt"));
    assertEq(text.length(), 4);
    assertEq(text.charCount(), 2);
    try fs.removeAll(w);
}

@Test
fn linesGivesTheLinesWithoutTheirEnds(): void throws IoError {
    let w = try fs.tempDir();
    let lines = path.join(w, "conv-lines.txt");
    try fs.writeText(lines, "a\nb\r\n\nc");
    var seen = "";
    for (line in try fs.lines(lines)) {
        seen = seen + "[" + line + "]";
    }
    assertEq(seen, "[a][b][][c]");
    let all = try fs.lines(lines).toList();
    assertEq(all.length(), 4);
    try fs.writeText(path.join(w, "conv-none.txt"), "");
    assertEq((try fs.lines(path.join(w, "conv-none.txt")).toList()).length(), 0);
    try fs.removeAll(w);
}

@Test
fn theLinesCloseTheirFile(): void throws IoError {
    let w = try fs.tempDir();
    let lines = path.join(w, "conv-lines.txt");
    try fs.writeText(lines, "a\nb\nc\n");
    // a loop that leaves early closes it: what the reader read ahead is not given
    let early = try fs.lines(lines);
    for (line in try early) {
        assertEq(line, "a");
        break;
    }
    let e = thrown(() => { try early.next(); });
    assertTrue(e != null);
    assertTrue(e!.kind == IoErrorKind.Closed);
    // at its end it closes itself and gives no more, and a close after it does nothing
    let whole = try fs.lines(lines);
    var n = 0;
    loop {
        if (try whole.next() == null) {
            break;
        }
        n = n + 1;
    }
    assertEq(n, 3);
    assertNull(try whole.next());
    try whole.close();
    // closed by hand before the end
    let manual = try fs.lines(lines);
    assertEq(try manual.next() ?? "", "a");
    try manual.close();
    assertTrue(thrown(() => { try manual.next(); })!.kind == IoErrorKind.Closed);
    try fs.removeAll(w);
}

@Test
fn bytesThatAreNoUtf8AreSaidWithThePath(): void throws IoError {
    let w = try fs.tempDir();
    let badFile = path.join(w, "conv-bad.txt");
    let bad: uint8[] = [0x61u8, 0x0Au8, 0xFFu8, 0x0Au8];
    try fs.writeBytes(badFile, bad[..]);
    assertEq(said(() => { try fs.readText(badFile); }), f"invalid data: {badFile} (the bytes are no UTF-8)");
    let it = try fs.lines(badFile);
    assertEq(try it.next() ?? "", "a");
    let e = thrown(() => { try it.next(); });
    assertTrue(e!.kind == IoErrorKind.InvalidData);
    assertEq(e!.path ?? "", badFile);
    // after its error it gives no more, and its file is closed already
    assertNull(try it.next());
    try it.close();
    try fs.removeAll(w);
}

/// Each kind a file can give, with its path and what was done.
/// `AlreadyExists` needs a file opened to be new, which std.fs does not have, `PermissionDenied`
/// rights, a door, or a system's own refusal — Windows's for a directory.
@Test
fn everyKindAFileCanGive(): void throws IoError {
    let w = try fs.tempDir();
    let kinds = path.join(w, "conv-kinds.txt");
    try fs.writeText(kinds, "abc");
    assertEq(said(() => { try fs.readText("conv-no-such.txt"); }), "not found: conv-no-such.txt (opened to read)");
    if (posix()) {
        // POSIX opens a directory; its read says what it is
        assertEq(said(() => { try fs.readText("."); }), "is a directory: . (read)");
        assertEq(said(() => { try fs.readText(kinds + "/x"); }), f"not a directory: {kinds}/x (opened to read)");
        assertEq(said(() => { try fs.writeText(".", "x"); }), "is a directory: . (opened to write)");
    } else {
        assertEq(said(() => { try fs.readText("."); }), "permission denied: . (opened to read)");
        assertEq(said(() => { try fs.readText(kinds + "/x"); }), f"not found: {kinds}/x (opened to read)");
    }
    assertEq(said(() => { using let f = try File.openWith(kinds, OpenOptions { }); }), f"invalid input: {kinds} (opened neither to read nor to write)");
    assertEq(said(() => {
        using let f = try File.open(kinds);
        let four: uint8[] = [0u8] * 4;
        try f.readExact(four[..]);
    }), "unexpected end of input (3 of 4 bytes)");
    let closed = try File.open(kinds);
    try closed.close();
    assertEq(said(() => { try closed.readToString(); }), f"closed: {kinds} (read)");
    try fs.removeAll(w);
}
