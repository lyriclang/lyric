// std.io's core (design/v5/spec/10 O1–O3; M8b S2): the readers' and the writers' defaults, copy,
// and the two streams over memory — the end only at 0, an empty slice at once, a partial write.
import std.io { ByteBuffer, ByteReader, IoError, IoErrorKind, Reader, Writer, copy };
import std.task { Cancelled };
import std.test { assertEq, assertFalse, assertTrue, fail };

/// A writer that takes at most `most` bytes a call: the partial write O1 allows.
class Trickle :: [Writer] {
    most: int,
    var taken: int = 0,
    var calls: int = 0,

    mut fn write(from: Slice<uint8>): int throws IoError {
        let n = if (from.length() < this.most) from.length() else this.most;
        this.taken = this.taken + n;
        this.calls = this.calls + 1;
        return n;
    }
}

/// A reader that hands out one byte a call, from a count down.
class Drip :: [Reader] {
    var left: int,

    mut fn read(into: Slice<uint8>): int throws IoError {
        if (this.left == 0 || into.isEmpty()) {
            return 0;
        }
        into[0] = this.left as uint8;
        this.left = this.left - 1;
        return 1;
    }
}

@Test
fn aReaderEndsOnlyAtZero(): void throws [IoError, Cancelled] {
    let data: uint8[] = [1u8, 2u8, 3u8];
    let r = ByteReader.new(data[..]);
    let one: uint8[] = [0u8];
    assertEq(try r.read(one[..]), 1);
    let none: uint8[] = [];
    assertEq(try r.read(none[..]), 0);
    assertEq(r.position(), 1);
    let rest = try r.readToEnd();
    assertEq(rest.length(), 2);
    assertEq(try r.read(one[..]), 0);
}

@Test
fn readExactFillsOrThrowsUnexpectedEof(): void throws [IoError, Cancelled] {
    let d = Drip { left = 3 };
    let three: uint8[] = [0u8] * 3;
    try d.readExact(three[..]);
    assertEq(three[0], 3u8);
    assertEq(three[2], 1u8);
    let more: uint8[] = [0u8] * 2;
    try {
        d.readExact(more[..]);
        fail("a reader at its end filled two bytes");
    } catch (e: IoError) {
        assertTrue(e.kind == .UnexpectedEof);
    }
}

@Test
fn writeAllTakesTheRestOfAPartialWrite(): void throws [IoError, Cancelled] {
    let data: uint8[] = [1u8, 2u8, 3u8, 4u8, 5u8, 6u8, 7u8];
    let t = Trickle { most = 3 };
    try t.writeAll(data[..]);
    assertEq(t.taken, 7);
    assertEq(t.calls, 3);
}

@Test
fn aWriterThatTakesNothingThrows(): void throws Cancelled {
    let data: uint8[] = [1u8];
    let t = Trickle { most = 0 };
    try {
        t.writeAll(data[..]);
        fail("a writer that took nothing was asked forever, or not at all");
    } catch (e: IoError) {
        assertTrue(e.kind == .Other { code = 0 });
    }
}

@Test
fn copyMovesEverything(): void throws [IoError, Cancelled] {
    let d = Drip { left = 5 };
    let into = ByteBuffer.new();
    assertEq(try copy(d, into), 5);
    assertEq(into.length(), 5);
    assertEq(d.left, 0);
}

@Test
fn aByteBufferReadsWhatWasWritten(): void throws [IoError, Cancelled] {
    let b = ByteBuffer.new();
    try b.writeString("abc");
    let two: uint8[] = [0u8] * 2;
    assertEq(try b.read(two[..]), 2);
    assertEq(two[1], 98u8);
    for (_ in 0..100) {
        try b.writeString("xyz");
    }
    assertEq(b.length(), 301);
    let all = b.toArray();
    assertEq(all[0], 99u8);
    assertEq(try b.readToString(), "c" + "xyz" * 100);
    assertEq(b.length(), 0);
}

@Test
fn aByteReaderSeeksFromEitherEnd(): void throws [IoError, Cancelled] {
    let data: uint8[] = [10u8, 20u8, 30u8, 40u8];
    let r = ByteReader.new(data[..]);
    assertEq(try r.seek(.End(-1)), 3);
    assertEq(try r.seek(.Current(-2)), 1);
    let one: uint8[] = [0u8];
    try r.readExact(one[..]);
    assertEq(one[0], 20u8);
    assertEq(try r.seek(.Start(9)), 9);
    assertEq(try r.read(one[..]), 0);
}

@Test
fn textThatIsNoUtf8IsInvalidData(): void throws Cancelled {
    let bad: uint8[] = [0x66u8, 0xFFu8];
    try {
        let s = ByteReader.new(bad[..]).readToString();
        fail(f"no UTF-8 read as '{s}'");
    } catch (e: IoError) {
        assertTrue(e.kind == .InvalidData);
        assertTrue(e.cause() != null);
        assertFalse(e.message().isEmpty());
    }
}

@Test
fn anErrorSaysItsKindPathAndDetail(): void {
    let e = IoError { kind = .NotFound, path = "data.txt", detail = "opened to read" };
    assertEq(e.message(), "not found: data.txt (opened to read)");
    let bare = IoError { kind = .Closed };
    assertEq(bare.message(), "closed");
    assertTrue(bare.kind != IoErrorKind.NotFound);
}
