// std.time's zones and patterns (design/v5/spec/10 Q1; 13 M10 S11): a POSIX rule zone across the
// changes of the clocks, the gap and the overlap resolved, a day across a change, a TZif file
// from its bytes, the system's database where there is one, UTS #35 format and parse.
import std.time { Zone, ZoneInfo, Instant, DateTime, Date, Time, Duration, TimeError, TimeErrorKind };
import std.encoding { Hex };
import std.core { ParseError };
import std.test { assertEq, assertTrue, assertNull, fail };

/// A minimal TZif (version 2): the two transitions of 2026 for CET/CEST, and the rule beyond.
let tzifHex = "";

fn cet(): Zone throws TimeError {
    return try Zone.fromPosix("CET", "CET-1CEST,M3.5.0,M10.5.0/3");
}

fn at(zone: Zone, text: string): DateTime throws ParseError {
    return (try Instant.parse(text)).toDateTime(zone);
}

fn local(zone: Zone, y: int, mo: int, d: int, h: int, mi: int): DateTime throws TimeError {
    return DateTime.of(try Date.of(y, mo, d), try Time.of(h, mi, 0), zone);
}

@Test
fn aRuleZoneSwitchesItsClocks(): void throws Error {
    let zone = try cet();
    assertTrue(!zone.isFixed());
    assertEq(zone.name(), "CET");
    // the spring forward at 02:00 CET
    let before = try at(zone, "2026-03-29T00:59:59Z");
    assertEq(before.show(), "2026-03-29T01:59:59+01:00");
    assertEq(before.zoneInfo(), ZoneInfo { offset = Duration.ofHours(1), isDst = false, abbreviation = "CET" });
    let after = try at(zone, "2026-03-29T01:00:00Z");
    assertEq(after.show(), "2026-03-29T03:00:00+02:00");
    assertEq(after.zoneInfo(), ZoneInfo { offset = Duration.ofHours(2), isDst = true, abbreviation = "CEST" });
    // the fall back at 03:00 CEST
    assertEq((try at(zone, "2026-10-25T00:59:59Z")).show(), "2026-10-25T02:59:59+02:00");
    assertEq((try at(zone, "2026-10-25T01:00:00Z")).show(), "2026-10-25T02:00:00+01:00");
    // a local time in the gap moves forward; one in the overlap takes the earlier moment
    assertEq((try local(zone, 2026, 3, 29, 2, 30)).show(), "2026-03-29T03:30:00+02:00");
    assertEq((try local(zone, 2026, 10, 25, 2, 30)).show(), "2026-10-25T02:30:00+02:00");
    assertEq((try local(zone, 2026, 10, 25, 3, 30)).show(), "2026-10-25T03:30:00+01:00");
    assertEq((try local(zone, 2026, 7, 1, 12, 0)).show(), "2026-07-01T12:00:00+02:00");
    assertEq((try local(zone, 2026, 1, 1, 12, 0)).show(), "2026-01-01T12:00:00+01:00");
    // a day across the change is 23 hours, the local time kept
    let friday = try local(zone, 2026, 3, 28, 12, 0);
    let saturday = friday.plusDays(1);
    assertEq(saturday.show(), "2026-03-29T12:00:00+02:00");
    assertEq(saturday.toInstant().since(friday.toInstant()), Duration.ofHours(23));
    assertEq(saturday.withZone(Zone.utc).show(), "2026-03-29T10:00:00Z");
    // the same moment is equal at both offsets as an Instant, not as a DateTime
    assertTrue(saturday.toInstant() == saturday.withZone(Zone.utc).toInstant());
    assertTrue(saturday != saturday.withZone(Zone.utc));
    // New York by the US rule, far ahead
    let ny = try Zone.fromPosix("America/New_York", "EST5EDT,M3.2.0,M11.1.0");
    assertEq((try at(ny, "2040-03-11T06:59:59Z")).show(), "2040-03-11T01:59:59-05:00");
    assertEq((try at(ny, "2040-03-11T07:00:00Z")).show(), "2040-03-11T03:00:00-04:00");
    assertEq((try at(ny, "2040-11-04T05:59:59Z")).show(), "2040-11-04T01:59:59-04:00");
    assertEq((try at(ny, "2040-11-04T06:00:00Z")).show(), "2040-11-04T01:00:00-05:00");
    // a southern rule, a zone without daylight time, the other spellings
    let sydney = try Zone.fromPosix("Sydney", "AEST-10AEDT,M10.1.0,M4.1.0/3");
    assertEq((try at(sydney, "2026-01-15T00:00:00Z")).show(), "2026-01-15T11:00:00+11:00");
    assertEq((try at(sydney, "2026-07-15T00:00:00Z")).show(), "2026-07-15T10:00:00+10:00");
    let tehran = try Zone.fromPosix("Tehran", "<+0330>-3:30");
    assertEq((try at(tehran, "2026-07-15T00:00:00Z")).show(), "2026-07-15T03:30:00+03:30");
    assertEq((try at(tehran, "2026-07-15T00:00:00Z")).zoneInfo().abbreviation, "+0330");
    let julian = try Zone.fromPosix("J", "XST2XDT1,J60,J300/1");
    assertEq((try at(julian, "2026-03-01T04:00:00Z")).show(), "2026-03-01T03:00:00-01:00");
    // what is no rule
    for (bad in ["", "C", "CET-1CEST,M3.5.0", "CET-1CEST,M13.1.0,M10.5.0", "CET-x", "<+03"]) {
        try {
            let _ = try Zone.fromPosix("bad", bad);
            fail(f"took '{bad}'");
        } catch (e: TimeError) {
            assertTrue(e.message().startsWith("no POSIX TZ string: "), e.message());
        }
    }
}

@Test
fn aTzifFileIsAZone(): void throws Error {
    let bytes = try Hex.decode(tzifHex);
    let zone = try Zone.fromTzif("Europe/Berlin", bytes[..]);
    assertEq(zone.name(), "Europe/Berlin");
    // the transitions of the file
    assertEq((try at(zone, "2026-03-29T00:59:59Z")).show(), "2026-03-29T01:59:59+01:00");
    assertEq((try at(zone, "2026-03-29T01:00:00Z")).show(), "2026-03-29T03:00:00+02:00");
    assertEq((try at(zone, "2026-10-25T00:59:59Z")).show(), "2026-10-25T02:59:59+02:00");
    // before the first transition: the first standard type; beyond the last: the footer's rule
    assertEq((try at(zone, "2000-01-01T00:00:00Z")).show(), "2000-01-01T01:00:00+01:00");
    assertEq((try at(zone, "2030-07-01T00:00:00Z")).show(), "2030-07-01T02:00:00+02:00");
    assertEq((try at(zone, "2030-07-01T00:00:00Z")).zoneInfo().abbreviation, "CEST");
    assertEq((try local(zone, 2026, 3, 29, 2, 30)).show(), "2026-03-29T03:30:00+02:00");
    // two zones are equal by name and kind
    assertTrue(zone == try Zone.fromTzif("Europe/Berlin", bytes[..]));
    assertTrue(zone != try cet());
    assertTrue(Zone.utc == try Zone.fixed(Duration.ofSecs(0)));
    assertEq((try Zone.fixed(Duration.ofMinutes(90))).name(), "+01:30");
    // what is no TZif
    for ((bad, said) in [("hello", "the magic bytes are missing"), (tzifHex[0..40].toString(), "the magic bytes are missing")]) {
        try {
            let _ = Zone.fromTzif("bad", (Hex.decode(if (bad == "hello") "68656c6c6f" else bad))[..]);
            fail("took bytes that are no TZif");
        } catch (e: TimeError) {
            assertEq(e.message(), f"not TZif: {said}");
        }
    }
    try {
        let _ = Zone.fromTzif("short", bytes[0..100]);
        fail("took a cut file");
    } catch (e: TimeError) {
        assertTrue(e.message().startsWith("not TZif: "), e.message());
    }
}

@Test
fn theSystemsDatabaseWhereThereIsOne(): void throws Error {
    var berlin: ?Zone = null;
    try {
        berlin = Zone.load("Europe/Berlin");
    } catch (e: TimeError) {
        // Windows has no database: the error says so, and the rest of the test does not apply
        assertTrue(e.kind == TimeErrorKind.NoZoneData, e.message());
        assertTrue(e.message().startsWith("no zone database at "), e.message());
        assertEq(Zone.local(), Zone.utc);
        return;
    }
    let zone = berlin!;
    assertEq(zone.name(), "Europe/Berlin");
    assertEq((try at(zone, "2026-03-29T00:59:59Z")).show(), "2026-03-29T01:59:59+01:00");
    assertEq((try at(zone, "2026-03-29T01:00:00Z")).show(), "2026-03-29T03:00:00+02:00");
    assertEq((try at(zone, "2026-10-25T01:00:00Z")).show(), "2026-10-25T02:00:00+01:00");
    assertEq((try at(zone, "2040-07-01T12:00:00Z")).show(), "2040-07-01T14:00:00+02:00");
    assertEq((try at(zone, "1990-01-01T00:00:00Z")).show(), "1990-01-01T01:00:00+01:00");
    assertEq((try local(zone, 2026, 3, 29, 2, 30)).show(), "2026-03-29T03:30:00+02:00");
    assertEq((try at(zone, "2026-07-01T00:00:00Z")).zoneInfo().abbreviation, "CEST");
    assertEq(try Zone.load("UTC"), Zone.utc);
    try {
        let _ = Zone.load("No/Such");
        fail("found No/Such");
    } catch (e: TimeError) {
        assertTrue(e.kind == TimeErrorKind.NoSuchZone);
        assertEq(e.message(), "the zone database has no 'No/Such'");
    }
    for (bad in ["", "../etc/passwd", "/etc/localtime", ".hidden"]) {
        try {
            let _ = Zone.load(bad);
            fail(f"loaded '{bad}'");
        } catch (e: TimeError) {
            assertTrue(e.kind == TimeErrorKind.NoSuchZone);
        }
    }
    // the system's own zone is some zone
    let _ = Zone.local().name();
}

@Test
fn aPatternFormatsAndParses(): void throws Error {
    let zone = try cet();
    let dt = try local(zone, 2026, 3, 29, 3, 30);
    assertEq(try dt.format("yyyy-MM-dd HH:mm:ss"), "2026-03-29 03:30:00");
    assertEq(try dt.format("EEE, d MMM yyyy h:mm a"), "Sun, 29 Mar 2026 3:30 AM");
    assertEq(try dt.format("EEEE MMMM d, yy"), "Sunday March 29, 26");
    assertEq(try dt.format("HH:mm:ss.SSS Z"), "03:30:00.000 +0200");
    assertEq(try dt.format("X XX XXX x xx xxx"), "+02 +0200 +02:00 +02 +0200 +02:00");
    assertEq(try dt.withZone(Zone.utc).format("X XX XXX x xx xxx"), "Z Z Z +00 +0000 +00:00");
    assertEq(try dt.withZone(Zone.utc).format("ZZZZZ ZZZZ"), "Z GMT");
    assertEq(try dt.format("ZZZZZ ZZZZ"), "+02:00 GMT+02:00");
    assertEq(try dt.format("'at' HH'h' ''"), "at 03h '");
    assertEq(try dt.format("y M d H h m s S a E"), "2026 3 29 3 3 30 0 0 AM Sun");
    assertEq(try dt.format("yyyyyy MMMMM EEEEE SSSSSSSSS"), "002026 M S 000000000");
    let evening = DateTime.of(try Date.of(1999, 12, 31), try Time.of(23, 59, 59, 123456789), Zone.utc);
    assertEq(try evening.format("hh:mm:ss.SS a E, dd.MM.yy"), "11:59:59.12 PM Fri, 31.12.99");
    assertEq(try DateTime.of(Date.of(2026, 1, 1), Time.of(12, 0, 0), Zone.utc).format("h a"), "12 PM");
    assertEq(try DateTime.of(Date.of(2026, 1, 1), Time.of(0, 5, 0), Zone.utc).format("h:mm a"), "12:05 AM");
    for (bad in ["Q", "yyyy 'open", "GGGG"]) {
        try {
            let _ = dt.format(bad);
            fail(f"formatted '{bad}'");
        } catch (_: TimeError) { }
    }
    // parse
    assertEq((try DateTime.parseWith("yyyy-MM-dd HH:mm Z", "2026-03-29 03:30 +0200")).show(), "2026-03-29T03:30:00+02:00");
    assertEq((try DateTime.parseWith("yyyy-MM-dd HH:mm", "2026-03-29 02:30", zone)).show(), "2026-03-29T03:30:00+02:00");
    assertEq((try DateTime.parseWith("d MMM yyyy", "5 mar 2026")).show(), "2026-03-05T00:00:00Z");
    assertEq((try DateTime.parseWith("d MMMM yyyy", "5 March 2026")).show(), "2026-03-05T00:00:00Z");
    assertEq((try DateTime.parseWith("h:mm a", "11:05 pm")).show(), "1970-01-01T23:05:00Z");
    assertEq((try DateTime.parseWith("h:mm a", "12:05 AM")).show(), "1970-01-01T00:05:00Z");
    assertEq((try DateTime.parseWith("yy", "26")).show(), "2026-01-01T00:00:00Z");
    assertEq((try DateTime.parseWith("yy", "99")).show(), "1999-01-01T00:00:00Z");
    assertEq((try DateTime.parseWith("HH:mm:ss.SSS", "01:02:03.5")).show(), "1970-01-01T01:02:03.5Z");
    assertEq((try DateTime.parseWith("yyyy-MM-dd'T'HH:mm:ssXXX", "2026-03-29T03:30:00Z")).show(), "2026-03-29T03:30:00Z");
    assertEq((try DateTime.parseWith("EEE d.M.yyyy", "wed 1.4.2026")).show(), "2026-04-01T00:00:00Z");
    for ((pattern, text) in [("yyyy-MM-dd", "2026/03/29"), ("yyyy-MM-dd", "2026-13-01"), ("HH:mm", "24:00"), ("d MMM yyyy", "5 mxr 2026"), ("h:mm a", "13:05 pm"), ("yyyy-MM-dd", "2026-03-29 extra"), ("yyyy-MM-dd Z", "2026-03-29 +99:00")]) {
        try {
            let _ = DateTime.parseWith(pattern, text);
            fail(f"parsed '{text}' by '{pattern}'");
        } catch (_: ParseError) { }
    }
    // round trips
    for (p in ["yyyy-MM-dd HH:mm:ss Z", "EEE, d MMM yyyy h:mm:ss a XXX", "yyyy-MM-dd'T'HH:mm:ss.SSSxxx", "d MMMM yyyy HH:mm ZZZZZ", "yy/M/d H:m:s x"]) {
        let text = try dt.format(p);
        assertEq(try DateTime.parseWith(p, text), dt, p);
    }
}
