// std.http, the client (design/v5/spec/10 Q6; 13 M10 S7): a request written, the head and the
// body read in each framing, the connection kept for the next request, redirects, a body sent
// with its length or in chunks, a timeout, what is refused. Against a server of this file on a
// loopback port: it answers by path and marks each connection with X-Conn.
import std.io { IoError, IoErrorKind, ByteBuffer };
import std.net { IpAddr, SocketAddr, TcpListener, TcpStream };
import std.task { spawn, sleep, Cancelled, TimedOut };
import std.time { Duration };
import std.http { Client, ClientOptions, Request, Response, Method, Headers, Status, HttpError, HttpErrorKind };
import std.uri { Uri };
import std.codec { Codable };
import std.test { assertEq, assertTrue, assertNull, fail };

struct Info :: [Codable, Equatable, Debug] {
    name: string,
    n: int,
}

/// The head of a request and its body (Content-Length or chunked), read from the connection;
/// `null` once the peer has closed.
fn readRequest(conn: TcpStream): ?(string, string) throws Error {
    let buf = ByteBuffer.new();
    let piece: uint8[] = [0u8] * 1024;
    var headEnd = -1;
    while (headEnd < 0) {
        let n = try conn.read(piece[..]);
        if (n == 0) {
            return null;
        }
        try buf.write(piece[0..n]);
        let all = buf.toArray();
        var i = 3;
        while (i < all.length()) {
            if (all[i - 3] == 13u8 && all[i - 2] == 10u8 && all[i - 1] == 13u8 && all[i] == 10u8) {
                headEnd = i + 1;
                break;
            }
            i = i + 1;
        }
    }
    var all = buf.toArray();
    let head = string.fromUtf8Lossy(all[0..headEnd]);
    var body = "";
    let lower = head.toLower();
    if (let (_, rest) = lower.splitOnce("content-length: ")) {
        let (num, _) = rest.splitOnce("\r\n")!;
        let want = try int.parse(num);
        while (all.length() - headEnd < want) {
            let n = try conn.read(piece[..]);
            if (n == 0) { break; }
            try buf.write(piece[0..n]);
            all = buf.toArray();
        }
        body = string.fromUtf8Lossy(all[headEnd..headEnd + want]);
    } else if (lower.contains("transfer-encoding: chunked")) {
        while (!string.fromUtf8Lossy(all[headEnd..all.length()]).contains("0\r\n\r\n")) {
            let n = try conn.read(piece[..]);
            if (n == 0) { break; }
            try buf.write(piece[0..n]);
            all = buf.toArray();
        }
        body = decodeChunks(all[headEnd..all.length()]);
    }
    return (head, body);
}

/// The chunks of a chunked body joined: hex size, CRLF, data, CRLF, up to the size 0.
fn decodeChunks(raw: Slice<uint8>): string {
    let out = ByteBuffer.new();
    var i = 0;
    while (i < raw.length()) {
        var size = 0;
        while (i < raw.length() && raw[i] != 13u8) {
            let c = (raw[i] as uint32) as char;
            size = size * 16 + (c.toDigit(16) ?? 0);
            i = i + 1;
        }
        i = i + 2;
        if (size == 0) { break; }
        try! out.write(raw[i..i + size]);
        i = i + size + 2;
    }
    return string.fromUtf8Lossy(out.toArray()[..]);
}

/// The server: one task per connection, each request answered by its path; it ends with the
/// listener's close.
fn serve(listener: TcpListener): void throws Error {
    var conns = 0;
    loop {
        var accepted: ?TcpStream = null;
        try {
            accepted = listener.accept();
        } catch (_: IoError) {
            return;
        }
        var conn = accepted!;
        conns += 1;
        let id = conns;
        let _ = spawn(() => {
            while (let (head, body) = try readRequest(conn)) {
                let line = head.splitOnce("\r\n")!.0.toString();
                let parts = line.splitN(' ', 3).toArray();
                let method = parts[0].toString();
                let path = parts[1].toString();
                var out = "";
                if (path == "/hello" && method == "HEAD") {
                    out = f"HTTP/1.1 200 OK\r\nContent-Type: text/plain\r\nContent-Length: 12\r\nX-Conn: {id}\r\n\r\n";
                } else if (path == "/hello") {
                    out = f"HTTP/1.1 200 OK\r\nContent-Type: text/plain\r\nContent-Length: 12\r\nX-Conn: {id}\r\n\r\nhello, world";
                } else if (path == "/chunked") {
                    out = f"HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\nX-Conn: {id}\r\n\r\na;ext=1\r\nchunk one,\r\nA\r\n chunk two\r\n0\r\nX-Trailer: t\r\n\r\n";
                } else if (path == "/redirect") {
                    out = f"HTTP/1.1 302 Found\r\nLocation: /hello\r\nContent-Length: 0\r\nX-Conn: {id}\r\n\r\n";
                } else if (path == "/see-other") {
                    out = f"HTTP/1.1 303 See Other\r\nLocation: /echo\r\nContent-Length: 0\r\nX-Conn: {id}\r\n\r\n";
                } else if (path == "/loop") {
                    out = f"HTTP/1.1 301 Moved Permanently\r\nLocation: /loop\r\nContent-Length: 0\r\nX-Conn: {id}\r\n\r\n";
                } else if (path == "/echo" || path == "/post") {
                    let text = f"{method} got {body.length()} bytes: {body}";
                    out = f"HTTP/1.1 200 OK\r\nContent-Length: {text.length()}\r\nX-Conn: {id}\r\n\r\n{text}";
                } else if (path == "/headers") {
                    let ua = head.toLower().contains("user-agent: lyric5");
                    let host = head.contains(f"Host: 127.0.0.1:");
                    out = f"HTTP/1.1 200 OK\r\nContent-Length: 11\r\nX-Conn: {id}\r\nX-Ua: {ua}\r\nX-Host: {host}\r\n\r\nheaders ok.";
                } else if (path == "/close") {
                    out = f"HTTP/1.1 200 OK\r\nConnection: close\r\nX-Conn: {id}\r\n\r\nbye";
                } else if (path == "/old") {
                    out = f"HTTP/1.0 200 OK\r\nX-Conn: {id}\r\n\r\nold style";
                } else if (path == "/continue") {
                    out = f"HTTP/1.1 100 Continue\r\n\r\nHTTP/1.1 200 OK\r\nContent-Length: 7\r\nX-Conn: {id}\r\n\r\nwent on";
                } else if (path == "/nocontent") {
                    out = f"HTTP/1.1 204 No Content\r\nX-Conn: {id}\r\n\r\n";
                } else if (path == "/slow") {
                    try sleep(Duration.ofMillis(500));
                    out = f"HTTP/1.1 200 OK\r\nContent-Length: 4\r\nX-Conn: {id}\r\n\r\nslow";
                } else if (path == "/json") {
                    out = f"HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nContent-Length: 22\r\nX-Conn: {id}\r\n\r\n{{\"name\":\"lyric\",\"n\":5}}";
                } else if (path == "/short") {
                    out = f"HTTP/1.1 200 OK\r\nContent-Length: 50\r\nX-Conn: {id}\r\n\r\nonly this";
                } else if (path == "/badchunk") {
                    out = f"HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\nX-Conn: {id}\r\n\r\nzz\r\n";
                } else if (path == "/garbage") {
                    out = "HTTP/9 x\r\n\r\n";
                } else if (path == "/badlength") {
                    out = f"HTTP/1.1 200 OK\r\nContent-Length: many\r\n\r\n";
                } else {
                    out = f"HTTP/1.1 404 Not Found\r\nContent-Length: 0\r\nX-Conn: {id}\r\n\r\n";
                }
                try conn.writeAll(out.toBytes()[..]);
                if (path == "/close" || path == "/old" || path == "/garbage" || path == "/short" || path == "/badchunk" || path == "/badlength") {
                    break;
                }
            }
            try conn.close();
        });
    }
}

/// A server on a loopback port: the listener and the base URI; the server's task ends when the
/// listener is closed.
fn start(): (TcpListener, string) throws Error {
    let listener = try TcpListener.bind(SocketAddr { ip = IpAddr.V4(127, 0, 0, 1), port = 0 });
    let at = try listener.localAddr();
    let _ = spawn(() => { try serve(listener); });
    return (listener, f"http://127.0.0.1:{at.port}");
}

fn stop(listener: TcpListener): void throws Error {
    try listener.close();
}

fn uri(base: string, path: string): Uri {
    return try! Uri.parse(base + path);
}

/// The connection the response came on - its body read first: an unread body keeps the connection
/// from the next request.
fn conn(r: Response): string throws Error {
    let _ = try r.text();
    return r.headers.get("X-Conn") ?? "-";
}

@Test
fn aClientGetsAndKeepsTheConnection(): void throws Error {
    let (listener, base) = try start();
    var client = Client.new();
    let r1 = try client.get(uri(base, "/hello"));
    assertEq(r1.status, Status { code = 200, reason = "OK" });
    assertTrue(r1.status.isSuccess());
    assertEq(r1.headers.get("content-type"), "text/plain");
    assertEq(r1.headers.get("Content-Length"), "12");
    assertTrue(!r1.body.isDone());
    assertEq(try r1.text(), "hello, world");
    assertTrue(r1.body.isDone());
    assertEq(try conn(r1), "1");
    // the same connection carries the next request; a second client opens its own
    let r2 = try client.get(uri(base, "/hello"));
    assertEq(try r2.text(), "hello, world");
    assertEq(try conn(r2), "1");
    var once = Client.new(ClientOptions { keepAlive = false });
    assertEq(try conn(once.get(uri(base, "/hello"))), "2");
    assertEq(try conn(once.get(uri(base, "/hello"))), "3");
    // chunked, with an extension and a trailer; the connection stays
    let r3 = try client.get(uri(base, "/chunked"));
    assertEq(try r3.text(), "chunk one, chunk two");
    assertEq(try conn(r3), "1");
    // HEAD: no body, the connection stays
    let h = try client.send(Request { method = Method.Head, uri = uri(base, "/hello") });
    assertEq(h.headers.get("Content-Length"), "12");
    assertEq(try h.bytes(), []);
    assertEq(try conn(client.get(uri(base, "/hello"))), "1");
    // 204 and an interim 100 are handled
    let none = try client.get(uri(base, "/nocontent"));
    assertEq(none.status.code, 204);
    assertEq(try none.text(), "");
    assertEq(try (try client.get(uri(base, "/continue"))).text(), "went on");
    // a body up to the close (HTTP/1.0, no length): the next request takes a new connection
    let old = try client.get(uri(base, "/old"));
    assertEq(try old.text(), "old style");
    assertEq(try conn(old), "1");
    assertEq(try conn(client.get(uri(base, "/hello"))), "4");
    // Connection: close from the server
    let bye = try client.get(uri(base, "/close"));
    assertEq(try bye.text(), "bye");
    assertEq(try conn(client.get(uri(base, "/hello"))), "5");
    // a response whose body is not read gives its connection up: the next request opens one
    let unread = try client.get(uri(base, "/hello"));
    assertTrue(!unread.body.isDone());
    assertEq(try conn(client.get(uri(base, "/hello"))), "6");
    // the headers the client writes
    let hs = try client.get(uri(base, "/headers"));
    assertEq(hs.headers.get("X-Ua"), "true");
    assertEq(hs.headers.get("X-Host"), "true");
    // JSON into a struct
    assertEq(try (try client.get(uri(base, "/json"))).json<Info>(), Info { name = "lyric", n = 5 });
    client.close();
    try stop(listener);
}

@Test
fn aClientPostsAndFollowsRedirects(): void throws Error {
    let (listener, base) = try start();
    var client = Client.new();
    // a body with its length
    let posted = try client.send(Request.post(uri(base, "/post"), "payload".toBytes()[..], "text/plain"));
    assertEq(try posted.text(), "POST got 7 bytes: payload");
    // a body without: chunked
    var streamed = Request { method = Method.Put, uri = uri(base, "/echo") };
    let src = ByteBuffer.new();
    try src.write("streamed body".toBytes()[..]);
    streamed.body = src;
    assertEq(try (try client.send(streamed)).text(), "PUT got 13 bytes: streamed body");
    // text as the body
    var t = Request.get(uri(base, "/echo"));
    t.method = Method.Post;
    t.setText("ein Text");
    assertEq(try (try client.send(t)).text(), "POST got 8 bytes: ein Text");
    // redirects: not followed unless asked
    let r = try client.get(uri(base, "/redirect"));
    assertEq(r.status.code, 302);
    assertTrue(r.status.isRedirect());
    assertEq(r.headers.get("Location"), "/hello");
    var following = Client.new(ClientOptions { followRedirects = true });
    let f = try following.get(uri(base, "/redirect"));
    assertEq(f.status.code, 200);
    assertEq(try f.text(), "hello, world");
    // 303 after a POST becomes a GET without the body
    let seen = try following.send(Request.post(uri(base, "/see-other"), "x".toBytes()[..]));
    assertEq(try seen.text(), "GET got 0 bytes: ");
    // too many
    var few = Client.new(ClientOptions { followRedirects = true, maxRedirects = 3 });
    try {
        let _ = try few.get(uri(base, "/loop"));
        fail("the loop ended");
    } catch (e: HttpError) {
        assertEq(e.kind, HttpErrorKind.Redirects);
        assertEq(e.message(), "redirect: more than 3 redirects");
    }
    client.close();
    following.close();
    few.close();
    try stop(listener);
}

@Test
fn whatIsNotHttpIsRefused(): void throws Error {
    let (listener, base) = try start();
    var client = Client.new();
    // a timeout spans the exchange
    var hasty = Client.new(ClientOptions { timeout = Duration.ofMillis(100) });
    try {
        let _ = try hasty.get(uri(base, "/slow"));
        fail("no timeout");
    } catch (_: TimedOut) { }
    assertEq(try (try client.get(uri(base, "/slow"))).text(), "slow");
    // nothing listens
    try {
        let _ = try client.get(try Uri.parse("http://127.0.0.1:1/"));
        fail("connected to nothing");
    } catch (e: IoError) {
        assertTrue(e.kind == IoErrorKind.ConnectionRefused);
    }
    // schemes
    for ((u, said) in [("ftp://x/", "unsupported: the scheme 'ftp'"), ("https://x/", "unsupported: https needs a transport"),
                       ("/relative", "unsupported: the scheme ''"), ("http:///p", "unsupported: the URI names no host")]) {
        try {
            let _ = try client.get(try Uri.parse(u));
            fail(f"sent {u}");
        } catch (e: HttpError) {
            assertEq(e.kind, HttpErrorKind.Unsupported);
            assertEq(e.message(), said);
        }
    }
    // a peer that does not speak HTTP
    try {
        let _ = try client.get(uri(base, "/garbage"));
        fail("read garbage");
    } catch (e: HttpError) {
        assertEq(e.message(), "not HTTP: the status line is 'HTTP/9 x'");
    }
    try {
        let _ = try client.get(uri(base, "/badlength"));
        fail("read a bad length");
    } catch (e: HttpError) {
        assertEq(e.message(), "not HTTP: 'many' is no Content-Length");
    }
    // a body that ends early, a chunk that is none
    try {
        let _ = try (try client.get(uri(base, "/short"))).text();
        fail("read a short body");
    } catch (e: IoError) {
        assertTrue(e.kind == IoErrorKind.UnexpectedEof);
    }
    try {
        let _ = try (try client.get(uri(base, "/badchunk"))).text();
        fail("read a bad chunk");
    } catch (e: IoError) {
        assertTrue(e.kind == IoErrorKind.InvalidData);
    }
    // the client goes on after each
    assertEq(try (try client.get(uri(base, "/hello"))).text(), "hello, world");
    client.close();
    try stop(listener);
}

@Test
fn theMessageTypes(): void {
    assertEq(Method.of("GET"), Method.Get);
    assertEq(Method.of("PURGE"), Method.Other("PURGE"));
    assertEq(Method.Patch.show(), "PATCH");
    assertEq(Status.of(404).show(), "404 Not Found");
    assertEq(Status.of(599).show(), "599");
    assertTrue(Status.of(500).isServerError() && Status.of(400).isClientError() && Status.of(100).isInformational());
    let h = Headers.new();
    h.add("Content-Type", "text/plain");
    h.add("Set-Cookie", "a=1");
    h.add("set-cookie", "b=2");
    assertEq(h.get("content-type"), "text/plain");
    assertEq(h.all("SET-COOKIE"), ["a=1", "b=2"]);
    assertTrue(h.has("Content-Type") && !h.has("Accept"));
    h.set("Set-Cookie", "c=3");
    assertEq(h.all("Set-Cookie"), ["c=3"]);
    h.remove("CONTENT-TYPE");
    assertNull(h.get("Content-Type"));
    assertEq(h.length(), 1);
}
