// std.core's floats (design/v5/spec/10 B5 Z1, Z2): the type's constants, IEEE's total order, the
// bits - and std.math's elementary functions over them.
import std.math { abs, acos, pow, asin, atan, atan2, cbrt, ceil, cos, cosh, exp, floor, hypot, ln, log10, log2, round, sin, sinh, sqrt, tan, tanh, trunc };
import std.test { assertEq, assertTrue, assertFalse, assertClose };

fn less(o: Ordering): bool {
    return match (o) { .Less => true, _ => false };
}

fn tied(o: Ordering): bool {
    return match (o) { .Equal => true, _ => false };
}

fn third<T :: [Float]>(x: T): T {
    return cbrt(x);
}

@Test
fn theConstantsDescribeTheType(): void {
    assertEq((1.0 + float.epsilon) - 1.0, float.epsilon);
    assertEq(1.0 + float.epsilon / 2.0, 1.0);
    assertTrue(float.infinity > float.max);
    assertEq(float.min, -float.max);
    assertEq(float.max, 1.7976931348623157e308);
    assertTrue(float.leastPositive > 0.0);
    assertEq(float.leastPositive / 2.0, 0.0);
    assertTrue(float.nan != float.nan);
    let top: float32 = 3.4028234663852886e38;
    assertEq(float32.max, top);
    assertEq(float32.leastPositive / 2.0, float32.zero);
    assertTrue(float32.infinity > float32.max);
}

@Test
fn nanAndTheInfinitiesAreTold(): void {
    assertTrue(float.nan.isNan());
    assertFalse(float.nan.isFinite());
    assertTrue(float.infinity.isInfinite());
    assertTrue((-float.infinity).isInfinite());
    assertFalse(float.infinity.isNan());
    assertTrue(1.5.isFinite());
    assertFalse(1.5.isInfinite());
    assertTrue(float32.nan.isNan());
    assertTrue(float32.max.isFinite());
}

@Test
fn roundingGoesWhereItSays(): void {
    assertEq(floor(2.5), 2.0);
    assertEq(ceil(2.5), 3.0);
    assertEq(round(2.5), 3.0);
    assertEq(trunc(2.5), 2.0);
    assertEq(floor(-2.5), -3.0);
    assertEq(ceil(-2.5), -2.0);
    assertEq(round(-2.5), -3.0);
    assertEq(trunc(-2.5), -2.0);
    assertEq(round(2.4), 2.0);
    let x: float32 = -1.5;
    let y: float32 = -2.0;
    assertEq(floor(x), y);
}

@Test
fn theElementaryFunctions(): void {
    assertEq(sqrt(2.0), 1.4142135623730951);
    assertTrue(sqrt(-1.0).isNan());
    assertClose(cbrt(27.0), 3.0, 1e-15);
    assertClose(third(8.0), 2.0, 1e-15);
    assertEq(exp(0.0), 1.0);
    assertEq(ln(1.0), 0.0);
    assertEq(ln(0.0), -float.infinity);
    assertEq(log2(8.0), 3.0);
    assertClose(log10(1000.0), 3.0, 1e-15);
    assertEq(sin(0.0), 0.0);
    assertEq(cos(0.0), 1.0);
    assertClose(atan(1.0) * 4.0, 3.141592653589793, 1e-15);
    assertClose(sin(asin(0.5)), 0.5, 1e-15);
    assertClose(cos(acos(0.5)), 0.5, 1e-15);
    assertClose(tan(1.0), 1.5574077246549023, 1e-15);
    assertClose(sinh(1.0), 1.1752011936438014, 1e-15);
    assertClose(cosh(1.0), 1.5430806348152437, 1e-15);
    assertClose(tanh(1.0), 0.7615941559557649, 1e-15);
    assertEq(hypot(3.0, 4.0), 5.0);
    assertEq(pow(2.0, 10.0), 1024.0);
    let two: float32 = 2.0;
    let root: float32 = 1.4142135;
    assertEq(sqrt(two), root);
    assertEq(third(two * 4.0), two);
}

@Test
fn atan2TakesThePoint(): void {
    let quarter = atan(1.0);
    assertClose(atan2(1.0, 1.0), quarter, 1e-15);
    assertClose(atan2(0.0, (-1.0)), quarter * 4.0, 1e-15);
    assertClose(atan2(1.0, 0.0), quarter * 2.0, 1e-15);
    assertClose(atan2(-1.0, 0.0), -quarter * 2.0, 1e-15);
}

@Test
fn totalCompareOrdersEveryValue(): void {
    let order = [-float.nan, -float.infinity, -1.0, -float.leastPositive, -0.0, 0.0,
                 float.leastPositive, 1.0, float.infinity, float.nan];
    for (i in 1..order.length()) {
        assertTrue(less(order[i - 1].totalCompare(order[i])), f"{order[i - 1]} before {order[i]}");
        assertFalse(less(order[i].totalCompare(order[i - 1])), f"{order[i]} not before {order[i - 1]}");
    }
    assertTrue(tied(float.nan.totalCompare(float.nan)));
    let a: float32 = -0.0;
    let b: float32 = 0.0;
    assertTrue(less(a.totalCompare(b)));
    assertTrue(less(float32.max.totalCompare(float32.infinity)));
}

@Test
fn theBitsRoundTrip(): void {
    assertEq(1.0.toBits(), 0x3FF0000000000000);
    assertEq((-0.0).toBits(), 0x8000000000000000);
    assertEq(float.fromBits(0x4000000000000000), 2.0);
    assertTrue(float.fromBits(float.nan.toBits()).isNan());
    let one: float32 = 1.0;
    assertEq(one.toBits(), 0x3F800000);
    assertEq(float32.fromBits(0x40000000), one + one);
    assertEq(float32.fromBits(0xFFFFFFFF00000000), float32.zero);
}

@Test
fn absClearsTheSign(): void {
    assertEq(abs(-0.0).toBits(), 0);
    assertEq(abs(-2.5), 2.5);
    assertTrue(abs(float.nan).isNan());
    assertEq(abs(-float.infinity), float.infinity);
    assertEq(abs(-3), 3);
    assertEq(abs(0), 0);
}
