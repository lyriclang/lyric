<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>lyrcore</AssemblyName>
    <RootNamespace>Lyric.Core</RootNamespace>
    <Description>Diagnostics, source management, the shared tool basics.</Description>
  </PropertyGroup>

  <!--
    What the compiler and every tool on it share: diagnostics, the SourceManager, exit codes, CLI
