<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>lyrfe</AssemblyName>
    <RootNamespace>Lyric</RootNamespace>
    <Description>From source to the IR: lexer, parser, resolver, sema, lowering.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- One edge: the shared basics. The front end executes nothing. -->
    <ProjectReference Include="..\Lyric.Core\Lyric.Core.csproj" />
  </ItemGroup>

  <!--
    Eight areas in one assembly: Lexing, AST, Parsing, Resolver, Sema, Ir, Emit, Compiler.

    What that costs: the fine edges INSIDE the frontend are convention rather than a compiler error.
    The parser could call the sema, the sema the IR. What remains enforced is the large edge: a
    runtime sees none of this, and a compiler gets no interpreter. That one is an assembly boundary
    and is checked mechanically.
  -->

</Project>
