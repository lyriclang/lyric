<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The seed of the Lyric 5 command line: one NativeAOT binary (design/v5/spec/11 C1). It starts
    with the self-report of C10 and grows the verbs milestone by milestone; until it can build a
    program, the 4.x line's driver lives on in lyric-script.
  -->
  <!--
    Its own version: the rest of the tree is still the 4.x toolchain and says 4.6.0 (its
    deprecation clocks aimed at 5.0 would turn into errors under a 5.0.0 claim). Dev builds stamp
    the informational version 5.0.0-dev.<date>+<sha> at packaging time.
  -->
  <PropertyGroup>
    <Version>5.0.0</Version>
    <OutputType>Exe</OutputType>
    <AssemblyName>lyric5</AssemblyName>
    <RootNamespace>Lyric5</RootNamespace>
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Lyric5.Toolchain\Lyric5.Toolchain.csproj" />
    <!-- The build: front end behind the subset gate, C emitter, cache, runtime archive, C toolchain (13, M2). -->
    <ProjectReference Include="..\Lyric5.Build\Lyric5.Build.csproj" />
    <!-- The language server: the front end answering an editor over JSON-RPC. -->
    <ProjectReference Include="..\Lyric.Lsp\Lyric.Lsp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The seed of the Lyric 5 standard library, beside the binary (the 4.x stdlib/ that the front
         end's project copies is not what lyric5 compiles against). -->
    <Content Include="..\..\stdlib5\**\*.lyr" Link="stdlib5\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    The runtime's C source, beside the published binary: lyric5 builds liblyr.a from it on the user's
    machine (RuntimeLayout.FindRoot looks for runtime/include/lyr above the binary). A build in the tree
    finds the checkout's own runtime, so only a publish carries a copy. Its tests and the Unicode data
    the table generator reads stay out; the notices of the third-party code go along.
  -->
  <ItemGroup>
    <Content Include="..\..\runtime\include\**\*" Link="runtime\include\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="Never" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\runtime\src\**\*" Link="runtime\src\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="Never" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\runtime\third_party\**\*" Exclude="..\..\runtime\third_party\ucd\**\*"
             Link="runtime\third_party\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="Never" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\runtime\THIRD_PARTY.md" Link="runtime\THIRD_PARTY.md"
             CopyToOutputDirectory="Never" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    The front end's project carries the 4.x standard library (stdlib/) to every output that references
    it; lyric5 compiles against stdlib5/ alone, so a publish leaves the other one out.
  -->
  <Target Name="LeaveOutTheScriptStdlib" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                             Condition="$([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').Replace('\', '/').StartsWith('stdlib/'))" />
    </ItemGroup>
  </Target>

</Project>
