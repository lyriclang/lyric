<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Lyric.Lsp</RootNamespace>
    <Description>The language server: the front end answering an editor over JSON-RPC.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!--
      The same two edges 'lyrc' has, and for the same reason: a language server compiles and
      executes nothing. It answers questions about source, so it needs everything up to the sema
      and no interpreter.
    -->
    <ProjectReference Include="..\Lyric.Core\Lyric.Core.csproj" />
    <ProjectReference Include="..\Lyric.Frontend\Lyric.Frontend.csproj" />
    <!-- A package as lyric test reads it: the manifest, the graph, the modules of src/ and tests/. -->
    <ProjectReference Include="..\Lyric5.Build\Lyric5.Build.csproj" />
  </ItemGroup>

</Project>
