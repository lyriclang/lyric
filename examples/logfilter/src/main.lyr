// A log filter (M10's artifact, design/v5/spec/13 S6, S10): the lines of a file that a regular
// expression matches, as grep prints them - the matches in color where the output is a terminal.
//
//     lyric5 run -- [-v] [-c] [-n] [--color | --no-color] <pattern> <file>
//
// -v prints the lines that do not match, -c the count alone, -n each line with its number. The
// pattern is RE2's syntax (std.regex); one it refuses is reported with its offset. Each match is
// bold red and the line numbers green where styles are on (std.term: a terminal, NO_COLOR,
// FORCE_COLOR); --color says always, --no-color never. The exit is 0 where a line was selected, 1
// where none was, 2 for a usage error.
import std.fs { readText };
import std.io { eprintln, println };
import std.os { args };
import std.regex { Regex, RegexError };
import std.term { Style, Color, colorsEnabled };

fn usage(): int {
    eprintln("usage: logfilter [-v] [-c] [-n] [--color | --no-color] <pattern> <file>");
    return 2;
}

/// The line with each match of the pattern in the style.
fn highlighted(re: Regex, line: string, style: Style): string {
    var out = "";
    var last = 0;
    var it = re.findAll(line);
    let bytes = line.toBytes();
    while (let m = it.next()) {
        out = out + string.fromUtf8Lossy(bytes[last..m.start]) + style.force(m.value);
        last = m.end;
    }
    return out + string.fromUtf8Lossy(bytes[last..bytes.length()]);
}

fn main(): int throws Error {
    let given = args();
    var invert = false;
    var countOnly = false;
    var numbered = false;
    var color: ?bool = null;
    var rest: List<string> = List.new();
    var i = 1;
    while (i < given.length()) {
        let a = given[i];
        if (a == "-v") {
            invert = true;
        } else if (a == "-c") {
            countOnly = true;
        } else if (a == "-n") {
            numbered = true;
        } else if (a == "--color") {
            color = true;
        } else if (a == "--no-color") {
            color = false;
        } else if (a.startsWith("-") && a.length() > 1) {
            return usage();
        } else {
            rest.push(a);
        }
        i += 1;
    }
    if (rest.length() != 2) {
        return usage();
    }
    var pattern: ?Regex = null;
    try {
        pattern = Regex.new(rest[0]);
    } catch (e: RegexError) {
        eprintln(f"logfilter: {e.message()}");
        return 2;
    }
    let re = pattern!;
    let text = try readText(rest[1]);
    let styled = color ?? colorsEnabled();
    let matchStyle = Style { fg = Color.Red, bold = true };
    let numberStyle = Style { fg = Color.Green };

    var selected = 0;
    var lineNo = 0;
    for (line in text.lines()) {
        lineNo += 1;
        if (re.isMatch(line) == invert) {
            continue;
        }
        selected += 1;
        if (countOnly) {
            continue;
        }
        let shown = if (styled && !invert) highlighted(re, line.toString(), matchStyle)
            else line.toString();
        if (numbered) {
            let number = if (styled) numberStyle.force(f"{lineNo}") else f"{lineNo}";
            println(f"{number}:{shown}");
        } else {
            println(shown);
        }
    }
    if (countOnly) {
        println(selected);
    }
    return if (selected > 0) 0 else 1;
}
