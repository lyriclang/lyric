// Nested variant patterns: an expression simplifier in one match.
//
// An enum is a value, so a recursive one reaches itself through a class: 'Unary' and 'Binary' end
// the cycle. A pattern names a class's fields as it names a variant's payload, which keeps
// '.Neg(Unary { x = .Neg(Unary { x }) })' one pattern however deep it goes. Or-patterns bind too:
// the two alternatives of an addition with a zero name the surviving side, and store it into ONE
// local.
import std.io { println };

class Unary {
    x: Expr,
}

class Binary {
    l: Expr,
    r: Expr,
}

enum Expr {
    Lit(int),
    Neg(Unary),
    Add(Binary),
    Mul(Binary),
}

fn neg(x: Expr): Expr {
    return Expr.Neg(Unary { x = x });
}

fn add(l: Expr, r: Expr): Expr {
    return Expr.Add(Binary { l = l, r = r });
}

fn mul(l: Expr, r: Expr): Expr {
    return Expr.Mul(Binary { l = l, r = r });
}

fn simplify(e: Expr): Expr {
    return match (e) {
        .Neg(Unary { x = .Neg(Unary { x }) }) => simplify(x),
        .Neg(Unary { x = .Lit(0) }) => Expr.Lit(0),
        .Add(Binary { l = .Lit(0), r }) | .Add(Binary { l = r, r = .Lit(0) }) => simplify(r),
        .Mul(Binary { l = .Lit(1), r }) | .Mul(Binary { l = r, r = .Lit(1) }) => simplify(r),
        .Mul(Binary { l = .Lit(0), r = _ }) | .Mul(Binary { l = _, r = .Lit(0) }) => Expr.Lit(0),
        .Add(Binary { l = .Lit(a), r = .Lit(b) }) => Expr.Lit(a + b),
        .Add(Binary { l, r }) => add(simplify(l), simplify(r)),
        .Mul(Binary { l, r }) => mul(simplify(l), simplify(r)),
        .Neg(Unary { x }) => neg(simplify(x)),
        .Lit(n) => Expr.Lit(n),
    };
}

fn show(e: Expr): string {
    return match (e) {
        .Lit(n) => f"{n}",
        .Neg(Unary { x }) => "-" + show(x),
        .Add(Binary { l, r }) => "(" + show(l) + " + " + show(r) + ")",
        .Mul(Binary { l, r }) => "(" + show(l) + " * " + show(r) + ")",
    };
}

fn main(): int {
    let zero = Expr.Lit(0);
    let one = Expr.Lit(1);
    let x = neg(neg(Expr.Lit(7)));
    println(show(simplify(x))); // 7
    println(show(simplify(add(zero, mul(one, Expr.Lit(5)))))); // 5
    println(show(simplify(mul(add(Expr.Lit(2), Expr.Lit(3)), zero)))); // 0
    println(show(simplify(add(Expr.Lit(2), neg(Expr.Lit(3)))))); // (2 + -3)
    return 0;
}
