// std.json — reading and writing JSON (RFC 8259).
//
// One value type carries a whole document: `JsonValue`, an enum over the six JSON shapes, with
// arrays as `List<JsonValue>` and objects as `Map<string, JsonValue>` — the collections everyone
// already has, not a second container API. `parse` answers `?JsonValue` in the standard library's
// absence convention: `null` means the text is not JSON, the way `parseInt` and `utf8Decode`
// answer. A parse error carries no position yet for the same reason a file error carries no
// reason — that is the open error-type question, and this module does not answer it on the side.
//
// Numbers keep the distinction the text had. JSON itself has one number type, but a document
// full of 64-bit ids must round-trip exactly, so a number without fraction or exponent becomes
// `Int` and everything else `Float`; an integer the `int` range cannot hold falls back to
// `Float`, keeping magnitude over exactness. `asFloat` answers for both variants.
//
// Object member order follows the map: UNSPECIFIED, as `Map` documents. A serialized object
// lists its members in the map's iteration order, not the order the document had.
//
// No capability required: nothing here reaches beyond the values passed in.

module std.json;

import std.collections { List, Map, keys };
import std.string { StringBuilder, fromInt, fromFloat, parseInt, parseFloat };
import std.math { isNaN, isInfinite };

/// One JSON value — the tree `parse` answers and `serialize` writes.
pub enum JsonValue {
    /// The literal `null`.
    Null,
    /// `true` or `false`.
    Bool(bool),
    /// A number the text wrote without fraction or exponent, exact in the `int` range.
    Int(int),
    /// A number with a fraction or an exponent — or an integer too large for `Int`.
    Float(float),
    /// A string.
    Str(string),
    /// An array.
    Arr(List<JsonValue>),
    /// An object. Member order is the map's: unspecified.
    Obj(Map<string, JsonValue>);

    /// Whether this is the JSON `null` — the value, not an absent optional.
    pub fn isNull(): bool {
        return match (this) {
            Null => true,
            _ => false,
        };
    }

    /// The boolean, or `null` when this is not one.
    pub fn asBool(): ?bool {
        return match (this) {
            Bool(b) => b,
            _ => null,
        };
    }

    /// The integer, or `null` when this is not `Int`. A `Float` with an integral value stays
    /// `null`: which of the two a number is was decided by the text it came from.
    pub fn asInt(): ?int {
        return match (this) {
            Int(v) => v,
            _ => null,
        };
    }

    /// The number as a float — `Float` directly, `Int` widened — or `null` when this is not a
    /// number. JSON has one number type; two variants is this module keeping precision, not two
    /// kinds of JSON value.
    pub fn asFloat(): ?float {
        return match (this) {
            Float(v) => v,
            Int(v) => v as float,
            _ => null,
        };
    }

    /// The string, or `null` when this is not one.
    pub fn asString(): ?string {
        return match (this) {
            Str(s) => s,
            _ => null,
        };
    }

    /// The elements, or `null` when this is not an array. The list is the value's own — changing
    /// it changes the value.
    pub fn asArray(): ?List<JsonValue> {
        return match (this) {
            Arr(items) => items,
            _ => null,
        };
    }

    /// The members, or `null` when this is not an object. The map is the value's own — changing
    /// it changes the value.
    pub fn asObject(): ?Map<string, JsonValue> {
        return match (this) {
            Obj(members) => members,
            _ => null,
        };
    }

    /// The element at `index`, or `null` when this is not an array or the index is outside it.
    pub fn at(index: int): ?JsonValue {
        return match (this) {
            Arr(items) => if (index >= 0 && index < items.length()) items.get(index) else null,
            _ => null,
        };
    }

    /// The member named `name`, or `null` when this is not an object or has no such member.
    pub fn field(name: string): ?JsonValue {
        return match (this) {
            Obj(members) => members.get(name),
            _ => null,
        };
    }
}

/// The value as compact JSON: no whitespace anywhere.
pub fn serialize(value: JsonValue): string {
    let sb = StringBuilder.new();
    writeValue(sb, value, -1, 0);
    return sb.build();
}

/// The value as JSON with a newline per element and `indent` spaces per nesting level, the shape
/// a person reads. An `indent` below zero is treated as zero.
pub fn serializePretty(value: JsonValue, indent: int): string {
    let sb = StringBuilder.new();
    writeValue(sb, value, if (indent < 0) 0 else indent, 0);
    return sb.build();
}

// The one writer behind both entry points; `indent < 0` means compact.
fn writeValue(sb: StringBuilder, value: JsonValue, indent: int, depth: int): void {
    match (value) {
        Null => {
            sb.append("null");
        }
        Bool(b) => {
            sb.append(if (b) "true" else "false");
        }
        Int(v) => {
            sb.append(fromInt(v));
        }
        Float(v) => {
            sb.append(renderFloat(v));
        }
        Str(s) => {
            writeString(sb, s);
        }
        Arr(items) => {
            writeArray(sb, items, indent, depth);
        }
        Obj(members) => {
            writeObject(sb, members, indent, depth);
        }
    }
}

// A float as a JSON number. `fromFloat` is shortest-roundtrip and already JSON-shaped, except in
// two corners: an integral value renders bare (`3`), which would come back as `Int`, so it gains
// `.0` — and NaN and the infinities have no JSON spelling at all and become `null`, the answer
// JavaScript's JSON.stringify gave long ago.
fn renderFloat(value: float): string {
    if (isNaN(value) || isInfinite(value)) {
        return "null";
    }
    let text = fromFloat(value);
    if (!text.contains(".") && !text.contains("e") && !text.contains("E")) {
        return text + ".0";
    }
    return text;
}

fn writeString(sb: StringBuilder, text: string): void {
    sb.appendChar('"');
    let chars = text.toChars();
    var i = 0;
    while (i < chars.length) {
        writeEscaped(sb, chars[i]);
        i = i + 1;
    }
    sb.appendChar('"');
}

// One character into a JSON string: the two that must be escaped, the named controls, `\u00xx`
// for the remaining controls, everything else as itself — non-ASCII included, the output is text.
fn writeEscaped(sb: StringBuilder, c: char): void {
    if (c == '"') {
        sb.append("\\\"");
        return;
    }
    if (c == '\\') {
        sb.append("\\\\");
        return;
    }
    let code = c as int;
    if (code >= 0x20) {
        sb.appendChar(c);
        return;
    }
    if (c == '\n') {
        sb.append("\\n");
        return;
    }
    if (c == '\r') {
        sb.append("\\r");
        return;
    }
    if (c == '\t') {
        sb.append("\\t");
        return;
    }
    if (code == 8) {
        sb.append("\\b");
        return;
    }
    if (code == 12) {
        sb.append("\\f");
        return;
    }
    sb.append("\\u00");
    sb.appendChar(hexDigit(code >> 4));
    sb.appendChar(hexDigit(code & 15));
}

// The character for one hexadecimal digit value in `0..15`, lowercase.
fn hexDigit(value: int): char {
    if (value < 10) {
        return ('0' as int + value) as char;
    }
    return ('a' as int + value - 10) as char;
}

fn writeArray(sb: StringBuilder, items: List<JsonValue>, indent: int, depth: int): void {
    if (items.isEmpty()) {
        sb.append("[]");
        return;
    }
    sb.appendChar('[');
    var i = 0;
    while (i < items.length()) {
        if (i > 0) {
            sb.appendChar(',');
        }
        newlineIndent(sb, indent, depth + 1);
        writeValue(sb, items.get(i), indent, depth + 1);
        i = i + 1;
    }
    newlineIndent(sb, indent, depth);
    sb.appendChar(']');
}

fn writeObject(sb: StringBuilder, members: Map<string, JsonValue>, indent: int, depth: int): void {
    if (members.isEmpty()) {
        sb.append("{}");
        return;
    }
    sb.appendChar('{');
    let names = keys<string, JsonValue>(members);
    var first = true;
    while (true) {
        let name = names.next();
        if (name == null) {
            break;
        }
        if (!first) {
            sb.appendChar(',');
        }
        first = false;
        newlineIndent(sb, indent, depth + 1);
        writeString(sb, name);
        sb.appendChar(':');
        if (indent >= 0) {
            sb.appendChar(' ');
        }
        writeValue(sb, members.get(name) ?? JsonValue.Null, indent, depth + 1);
    }
    newlineIndent(sb, indent, depth);
    sb.appendChar('}');
}

// Pretty printing's line structure; compact mode (`indent < 0`) writes nothing here.
fn newlineIndent(sb: StringBuilder, indent: int, depth: int): void {
    if (indent < 0) {
        return;
    }
    sb.appendChar('\n');
    var i = 0;
    while (i < indent * depth) {
        sb.appendChar(' ');
        i = i + 1;
    }
}

/// The value a JSON document spells, or `null` when the text spells none: a syntax error
/// anywhere, anything after the value, a lone surrogate escape, a raw control character in a
/// string, or containers nested more than 128 deep. Strict RFC 8259 — no comments, no trailing
/// commas, no `NaN`, no single quotes. The whole document is one value; leading and trailing
/// whitespace around it is fine.
///
/// Duplicate object keys follow `Map.set`: the last one wins, as in JavaScript.
///
/// The depth bound is the module's own, not the runtime's: input is data, and data that is not
/// JSON must come back as `null` rather than as a panic about call depth.
pub fn parse(text: string): ?JsonValue {
    var p = JsonParser { chars = text.toChars(), pos = 0 };
    p.skipWhitespace();
    let value = p.parseValue(0);
    if (value == null) {
        return null;
    }
    p.skipWhitespace();
    if (p.pos != p.chars.length) {
        return null;
    }
    return value;
}

// Containers refuse to open beyond this nesting level, so hostile input answers `null` while the
// VM's own call-depth guard stays far away.
let maxDepth = 128;

// One pass over the characters, no token stream; `pos` is the next unread character. Every
// method answers its failure as `null` or `false` and the callers hand it up — the reason a
// document is refused is not part of the contract (see the module header).
class JsonParser {
    chars: char[],
    pos: int,

    mut fn skipWhitespace(): void {
        while (this.pos < this.chars.length) {
            let c = this.chars[this.pos];
            if (c != ' ' && c != '\t' && c != '\n' && c != '\r') {
                return;
            }
            this.pos = this.pos + 1;
        }
    }

    fn peekIs(c: char): bool {
        return this.pos < this.chars.length && this.chars[this.pos] == c;
    }

    fn peekDigit(): bool {
        if (this.pos >= this.chars.length) {
            return false;
        }
        let c = this.chars[this.pos];
        return c >= '0' && c <= '9';
    }

    // The characters from `start` to `end`, exclusive — the number texts handed to the parsers.
    fn slice(start: int, end: int): string {
        let sb = StringBuilder.new();
        var i = start;
        while (i < end) {
            sb.appendChar(this.chars[i]);
            i = i + 1;
        }
        return sb.build();
    }

    mut fn expectWord(word: string): bool {
        let expected = word.toChars();
        if (this.pos + expected.length > this.chars.length) {
            return false;
        }
        var i = 0;
        while (i < expected.length) {
            if (this.chars[this.pos + i] != expected[i]) {
                return false;
            }
            i = i + 1;
        }
        this.pos = this.pos + expected.length;
        return true;
    }

    // Dispatch on the first character; the caller has skipped whitespace.
    mut fn parseValue(depth: int): ?JsonValue {
        if (this.pos >= this.chars.length) {
            return null;
        }
        let c = this.chars[this.pos];
        if (c == '{') {
            return this.parseObject(depth);
        }
        if (c == '[') {
            return this.parseArray(depth);
        }
        if (c == '"') {
            let s = this.parseString();
            if (s == null) {
                return null;
            }
            return JsonValue.Str(s);
        }
        if (c == 't') {
            return if (this.expectWord("true")) JsonValue.Bool(true) else null;
        }
        if (c == 'f') {
            return if (this.expectWord("false")) JsonValue.Bool(false) else null;
        }
        if (c == 'n') {
            return if (this.expectWord("null")) JsonValue.Null else null;
        }
        if (c == '-' || c >= '0' && c <= '9') {
            return this.parseNumber();
        }
        return null;
    }

    mut fn parseObject(depth: int): ?JsonValue {
        if (depth >= maxDepth) {
            return null;
        }
        this.pos = this.pos + 1;
        let members = Map<string, JsonValue>.empty();
        this.skipWhitespace();
        if (this.peekIs('}')) {
            this.pos = this.pos + 1;
            return JsonValue.Obj(members);
        }
        while (true) {
            this.skipWhitespace();
            if (!this.peekIs('"')) {
                return null;
            }
            let key = this.parseString();
            if (key == null) {
                return null;
            }
            this.skipWhitespace();
            if (!this.peekIs(':')) {
                return null;
            }
            this.pos = this.pos + 1;
            this.skipWhitespace();
            let value = this.parseValue(depth + 1);
            if (value == null) {
                return null;
            }
            members.set(key, value);
            this.skipWhitespace();
            if (this.peekIs(',')) {
                this.pos = this.pos + 1;
            } else if (this.peekIs('}')) {
                this.pos = this.pos + 1;
                return JsonValue.Obj(members);
            } else {
                return null;
            }
        }
    }

    mut fn parseArray(depth: int): ?JsonValue {
        if (depth >= maxDepth) {
            return null;
        }
        this.pos = this.pos + 1;
        let items = List<JsonValue>.empty();
        this.skipWhitespace();
        if (this.peekIs(']')) {
            this.pos = this.pos + 1;
            return JsonValue.Arr(items);
        }
        while (true) {
            this.skipWhitespace();
            let value = this.parseValue(depth + 1);
            if (value == null) {
                return null;
            }
            items.push(value);
            this.skipWhitespace();
            if (this.peekIs(',')) {
                this.pos = this.pos + 1;
            } else if (this.peekIs(']')) {
                this.pos = this.pos + 1;
                return JsonValue.Arr(items);
            } else {
                return null;
            }
        }
    }

    // The caller has seen the opening quote.
    mut fn parseString(): ?string {
        this.pos = this.pos + 1;
        let sb = StringBuilder.new();
        while (true) {
            if (this.pos >= this.chars.length) {
                return null;
            }
            let c = this.chars[this.pos];
            if (c == '"') {
                this.pos = this.pos + 1;
                return sb.build();
            }
            if (c == '\\') {
                this.pos = this.pos + 1;
                if (!this.appendEscape(sb)) {
                    return null;
                }
            } else {
                // Raw control characters must be escaped, says §7. The intermediate name
                // sidesteps `as int <`, which would read as a type argument list.
                let code = c as int;
                if (code < 0x20) {
                    return null;
                }
                sb.appendChar(c);
                this.pos = this.pos + 1;
            }
        }
    }

    // The character after the backslash decides; `\uXXXX` may need a second escape to pair.
    mut fn appendEscape(sb: StringBuilder): bool {
        if (this.pos >= this.chars.length) {
            return false;
        }
        let c = this.chars[this.pos];
        this.pos = this.pos + 1;
        if (c == '"') {
            sb.appendChar('"');
            return true;
        }
        if (c == '\\') {
            sb.appendChar('\\');
            return true;
        }
        if (c == '/') {
            sb.appendChar('/');
            return true;
        }
        if (c == 'n') {
            sb.appendChar('\n');
            return true;
        }
        if (c == 't') {
            sb.appendChar('\t');
            return true;
        }
        if (c == 'r') {
            sb.appendChar('\r');
            return true;
        }
        if (c == 'b') {
            sb.appendChar(8 as char);
            return true;
        }
        if (c == 'f') {
            sb.appendChar(12 as char);
            return true;
        }
        if (c == 'u') {
            return this.appendUnicodeEscape(sb);
        }
        return false;
    }

    // `\uXXXX`, with the surrogate rule: a high surrogate must be followed by `\uXXXX` with a
    // low one, the pair combines to one character, and either half alone is refused — a char is
    // a Unicode scalar and a lone surrogate is not one. The strictness `utf8Decode` has.
    mut fn appendUnicodeEscape(sb: StringBuilder): bool {
        let first = this.readHex4();
        if (first < 0) {
            return false;
        }
        if (first >= 0xDC00 && first <= 0xDFFF) {
            return false;
        }
        if (first >= 0xD800 && first <= 0xDBFF) {
            if (this.pos + 1 >= this.chars.length) {
                return false;
            }
            if (this.chars[this.pos] != '\\' || this.chars[this.pos + 1] != 'u') {
                return false;
            }
            this.pos = this.pos + 2;
            let second = this.readHex4();
            if (second < 0xDC00 || second > 0xDFFF) {
                return false;
            }
            let scalar = 0x10000 + (first - 0xD800 << 10) + (second - 0xDC00);
            sb.appendChar(scalar as char);
            return true;
        }
        sb.appendChar(first as char);
        return true;
    }

    // Four hex digits as their value, or -1 — the one shape `\u` accepts.
    mut fn readHex4(): int {
        if (this.pos + 4 > this.chars.length) {
            return -1;
        }
        var value = 0;
        var i = 0;
        while (i < 4) {
            let d = hexDigitValue(this.chars[this.pos + i]);
            if (d < 0) {
                return -1;
            }
            value = value << 4 | d;
            i = i + 1;
        }
        this.pos = this.pos + 4;
        return value;
    }

    // §6's grammar, validated character by character; the value conversion is then handed to
    // `std.string`. Leading zeros fall out for free: after a leading `0` the number is over, and
    // the digit behind it trips the caller's delimiter check.
    mut fn parseNumber(): ?JsonValue {
        let start = this.pos;
        if (this.peekIs('-')) {
            this.pos = this.pos + 1;
        }
        if (this.peekIs('0')) {
            this.pos = this.pos + 1;
        } else if (this.peekDigit()) {
            while (this.peekDigit()) {
                this.pos = this.pos + 1;
            }
        } else {
            return null;
        }
        var isFloat = false;
        if (this.peekIs('.')) {
            isFloat = true;
            this.pos = this.pos + 1;
            if (!this.peekDigit()) {
                return null;
            }
            while (this.peekDigit()) {
                this.pos = this.pos + 1;
            }
        }
        if (this.peekIs('e') || this.peekIs('E')) {
            isFloat = true;
            this.pos = this.pos + 1;
            if (this.peekIs('+') || this.peekIs('-')) {
                this.pos = this.pos + 1;
            }
            if (!this.peekDigit()) {
                return null;
            }
            while (this.peekDigit()) {
                this.pos = this.pos + 1;
            }
        }
        let text = this.slice(start, this.pos);
        if (!isFloat && intFits(text)) {
            let exact = parseInt(text);
            if (exact == null) {
                return null;
            }
            return JsonValue.Int(exact);
        }
        // A fraction, an exponent, or an integer beyond int64: magnitude over exactness.
        let approximate = parseFloat(text);
        if (approximate == null) {
            return null;
        }
        return JsonValue.Float(approximate);
    }
}

// Whether the validated integer text fits `int`, decided on the digits rather than by parsing:
// `parseInt` wraps on overflow (documented there), and a wrapped id would be a silently wrong
// value. The digit count is exact because the JSON grammar forbids leading zeros.
fn intFits(text: string): bool {
    let chars = text.toChars();
    var start = 0;
    var limit = "9223372036854775807";
    if (chars.length > 0 && chars[0] == '-') {
        start = 1;
        limit = "9223372036854775808";
    }
    let digits = chars.length - start;
    if (digits < 19) {
        return true;
    }
    if (digits > 19) {
        return false;
    }
    let limitChars = limit.toChars();
    var i = 0;
    while (i < 19) {
        if (chars[start + i] < limitChars[i]) {
            return true;
        }
        if (chars[start + i] > limitChars[i]) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

// The value of one hexadecimal digit character, or -1 when the character is none.
fn hexDigitValue(c: char): int {
    if (c >= '0' && c <= '9') {
        return c as int - '0' as int;
    }
    if (c >= 'a' && c <= 'f') {
        return c as int - 'a' as int + 10;
    }
    if (c >= 'A' && c <= 'F') {
        return c as int - 'A' as int + 10;
    }
    return -1;
}
