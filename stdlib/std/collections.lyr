// std.collections — growing containers.
//
// A `T[]` is a real array with a fixed length. What grows lives here.

module std.collections;

import std.iter { Iterator, Iterable };
import std.core { Hashable, Equatable, Ordered };

/// What can be read and written with `[i]`.
///
/// The same model as `Iterator<T>` for `for-in`: the compiler knows one built-in form — the array —
/// and binds everything else to an interface from the standard library, so there is no special case
/// per container type.
///
/// `get` and `set` are O(1). That is a requirement, not a description: an implementation with O(n)
/// access must not satisfy this interface, or an index loop would be quadratic without showing it.
/// `string` has no index operator for the same reason.
pub interface Indexable<T> {
    /// The value at `index`.
    fn get(index: int): T;
    /// Replaces the value at `index`.
    mut fn set(index: int, value: T): void;
}

/// A growing list; a `T[]` has a fixed length, this does not.
///
/// Growing doubles and shrinking halves at a quarter, so `push` is amortized O(1) and a list
/// oscillating around a boundary does not copy on every step.
// Written in Lyric rather than native. Natives are registered monomorphically, so a generic one
// would need a marshalling layer of its own.
//
// The backing is `(?T)[]` rather than `T[]`, because a slot must be emptiable: `pop` releases its
// value instead of merely hiding it behind `count`, which would keep every inserted object alive.
// It also solves creation: a `T[]` of length n needs n values of type T, and there is no
// `default(T)`; for `?T` there is one.
//
// Growing doubles, shrinking halves at a quarter. Doubling makes `push` amortized O(1); exact
// growth would be O(n) per call. The shrink threshold is a quarter rather than a half so a list
// oscillating around the boundary does not copy on every `push`/`pop`.
pub class List<T> :: [Indexable<T>, Iterable<T>] {
    /// The backing slots; optional so a popped slot can actually release its value.
    data: (?T)[],
    /// How many slots are filled.
    count: int,

    /// How many values are in it.
    pub fn length(): int {
        return this.count;
    }

    /// An empty list.
    pub static fn empty(): List<T> {
        let hole: ?T = null;
        return List<T> { data = [hole] * 0, count = 0 };
    }

    /// A fresh cursor on every call, so two loops over the same list do not disturb each other.
    pub fn iter(): Iterator<T> {
        return ListIterator<T> { source = this, index = 0 };
    }

    /// A list holding the elements of an array, in order: `List<int>.of([3, 1, 2])`. The
    /// array is copied; the list owns its slots.
    pub static fn of(items: T[]): List<T> {
        let result = List<T>.empty();
        result.pushAll(items);
        return result;
    }

    /// Appends every element of the array, in order.
    pub mut fn pushAll(items: T[]): void {
        var i = 0;
        while (i < items.length) {
            this.push(items[i]);
            i = i + 1;
        }
    }

    /// Appends every element of another list, in order. The other list is unchanged.
    pub mut fn pushAllFrom(other: List<T>): void {
        var i = 0;
        let n = other.length();
        while (i < n) {
            this.push(other.get(i));
            i = i + 1;
        }
    }

    /// The elements from `from` up to but not including `to`, as a NEW list. The bounds must
    /// satisfy `0 <= from <= to <= length()`; anything else is a panic, as an index out of
    /// range is — a slice with crossed bounds is a programming error, not an empty answer.
    pub fn slice(from: int, to: int): List<T> {
        if (from < 0 || to > this.count || from > to) {
            panic("list slice out of range");
        }
        let result = List<T>.empty();
        var i = from;
        while (i < to) {
            result.push(this.get(i));
            i = i + 1;
        }
        return result;
    }

    /// A new list of the elements `keep` accepts, in order, eagerly.
    pub fn filter(keep: fn(T) -> bool): List<T> {
        let result = List<T>.empty();
        var i = 0;
        while (i < this.count) {
            let value = this.get(i);
            if (keep(value)) {
                result.push(value);
            }
            i = i + 1;
        }
        return result;
    }

    /// Calls `f` on every element, in order.
    pub fn forEach(f: fn(T) -> void): void {
        var i = 0;
        while (i < this.count) {
            f(this.get(i));
            i = i + 1;
        }
    }

    /// Removes every element `drop` accepts, keeping the order of the rest; answers how many
    /// went. One pass, so removing many is O(n) rather than O(n) per removal.
    pub mut fn removeWhere(drop: fn(T) -> bool): int {
        var kept = 0;
        var i = 0;
        while (i < this.count) {
            let value = this.get(i);
            if (!drop(value)) {
                this.data[kept] = value;
                kept = kept + 1;
            }
            i = i + 1;
        }
        let removed = this.count - kept;
        var j = kept;
        while (j < this.count) {
            this.data[j] = null;
            j = j + 1;
        }
        this.count = kept;
        return removed;
    }

    /// A reversed COPY; `reverse` is the in-place form.
    pub fn toReversed(): List<T> {
        let result = List<T>.empty();
        var i = this.count - 1;
        while (i >= 0) {
            result.push(this.get(i));
            i = i - 1;
        }
        return result;
    }

    /// Whether nothing is in it.
    pub fn isEmpty(): bool {
        return this.count == 0;
    }

    /// How many slots are allocated, empty ones included. For tests and for anyone measuring what
    /// the list costs; `length` is the truth for everything else.
    pub fn capacity(): int {
        return this.data.length;
    }

    mut fn resize(target: int): void {
        let hole: ?T = null;
        let moved = [hole] * target;

        var i = 0;
        while (i < this.count) {
            moved[i] = this.data[i];
            i = i + 1;
        }
        this.data = moved;
    }

    /// Appends at the end; amortized O(1).
    pub mut fn push(value: T): void {
        if (this.count >= this.data.length) {
            if (this.data.length == 0) {
                this.resize(4);
            } else {
                this.resize(this.data.length * 2);
            }
        }
        this.data[this.count] = value;
        this.count = this.count + 1;
    }

    /// Removes and returns the last value, or `null` for an empty list — an ordinary state,
    /// unlike an index out of range.
    // The slot is cleared rather than skipped, or the list would keep the object alive and a
    // `get` there would read it back.
    pub mut fn pop(): ?T {
        if (this.count == 0) {
            return null;
        }

        this.count = this.count - 1;
        let value = this.data[this.count];
        this.data[this.count] = null;

        // Below a quarter: halve. Four slots always remain; below that the copying does not pay.
        if (this.data.length > 4 && this.count * 4 < this.data.length) {
            this.resize(this.data.length / 2);
        }
        return value;
    }

    /// The value at `index`. Out of range is a panic, as for an array: a programming error
    /// rather than a state.
    pub fn get(index: int): T {
        if (index < 0 || index >= this.count) {
            panic("list index out of range");
        }
        // Cannot fail: within `count` there is always a value, proven by the check above.
        return this.data[index]!;
    }

    /// Replaces the value at `index`. Out of range is a panic, as in `get`.
    pub mut fn set(index: int, value: T): void {
        if (index < 0 || index >= this.count) {
            panic("list index out of range");
        }
        this.data[index] = value;
    }

    /// Empties the list. Every slot is released — nothing inserted stays alive — but the
    /// backing array is KEPT: a buffer emptied once per frame must not reallocate on every
    /// refill.
    pub mut fn clear(): void {
        var i = 0;
        while (i < this.count) {
            this.data[i] = null;
            i = i + 1;
        }
        this.count = 0;
    }

    /// The first value, or `null` for an empty list.
    pub fn first(): ?T {
        if (this.count == 0) {
            return null;
        }
        return this.data[0];
    }

    /// The last value, or `null` for an empty list.
    pub fn last(): ?T {
        if (this.count == 0) {
            return null;
        }
        return this.data[this.count - 1];
    }

    /// Inserts at `index`, shifting everything from there one to the right. `index == length()`
    /// appends. Out of range is a panic, as in `get`.
    pub mut fn insert(index: int, value: T): void {
        if (index < 0 || index > this.count) {
            panic("list index out of range");
        }
        // Through `push` for the growth, then shift the tail right over the appended slot.
        this.push(value);
        var i = this.count - 1;
        while (i > index) {
            this.data[i] = this.data[i - 1];
            i = i - 1;
        }
        this.data[index] = value;
    }

    /// Removes and returns the value at `index`, shifting the rest left. Out of range is a
    /// panic, as in `get`.
    pub mut fn removeAt(index: int): T {
        if (index < 0 || index >= this.count) {
            panic("list index out of range");
        }
        // Cannot fail: within `count` there is always a value, as in `get`.
        let removed = this.data[index]!;

        var i = index;
        while (i + 1 < this.count) {
            this.data[i] = this.data[i + 1];
            i = i + 1;
        }
        // Release through `pop`'s own path, which also owns the shrink rule.
        this.count = this.count - 1;
        this.data[this.count] = null;
        if (this.data.length > 4 && this.count * 4 < this.data.length) {
            this.resize(this.data.length / 2);
        }
        return removed;
    }

    /// Reverses in place.
    pub mut fn reverse(): void {
        var left = 0;
        var right = this.count - 1;
        while (left < right) {
            let held = this.data[left];
            this.data[left] = this.data[right];
            this.data[right] = held;
            left = left + 1;
            right = right - 1;
        }
    }

    /// Exchanges two positions. Out of range is a panic, as in `get`.
    pub mut fn swap(a: int, b: int): void {
        if (a < 0 || a >= this.count || b < 0 || b >= this.count) {
            panic("list index out of range");
        }
        let held = this.data[a];
        this.data[a] = this.data[b];
        this.data[b] = held;
    }

    /// A copy as a real array.
    // The return type is `T[]` rather than `?T[]`: within `count` every slot is filled.
    //
    // Built as a `T[]` from the start. There is no reinterpretation of a `?T[]`: `!` unwraps a
    // single value, not an array elementwise, and `?T[]` is an array of optionals. The initial fill
    // therefore needs a real `T`, which the first element provides; the empty list has none and is
    // caught before.
    pub fn toArray(): T[] {
        if (this.count == 0) {
            return [];
        }

        // Cannot fail: `count > 0` means slot 0 is filled, the same assurance as in `get`.
        let first = this.data[0]!;
        let result = [first] * this.count;

        var i = 1;
        while (i < this.count) {
            result[i] = this.data[i]!;
            i = i + 1;
        }
        return result;
    }
}

/// Walks a list; each loop holds its own cursor.
pub class ListIterator<T> :: [Iterator<T>] {
    /// The list being walked.
    source: List<T>,
    /// The next slot to look at.
    index: int,

    /// The next value, or `null` at the end.
    pub mut fn next(): ?T {
        if (this.index >= this.source.length()) {
            return null;
        }
        let value = this.source.get(this.index);
        this.index = this.index + 1;
        return value;
    }
}

/// Collects an iterator into a `List<T>`.
///
/// Here rather than in `std.iter`, because the dependency runs this way: `std.collections` imports
/// `std.iter`, not the reverse. `std.iter.collectArray` is the variant without that dependency,
/// and it is quadratic because a `T[]` copies on every append. This one doubles and is linear.
pub fn collect<T>(source: Iterator<T>): List<T> {
    var result = List<T>.empty();
    var value = source.next();
    while (value != null) {
        result.push(value);
        value = source.next();
    }
    return result;
}

// ============================================================== Map<K, V>
//
// Open addressing with linear probing: one flat array per column rather than a bucket per slot, and
// a collision moves to the next index. A chain per bucket would need an object and a pointer per
// entry.
// ------------------------------------------------------- Deque
//
// A ring over one array: `head` is the front, indices wrap modulo the capacity, and growing
// unrolls the ring into a fresh array with the front back at 0. Both ends are O(1), which is
// what a scheduler's run queue needs and a List cannot give — its removeAt(0) moves everything.

/// A double-ended queue: push and pop are O(1) at BOTH ends.
///
/// Deliberately without iteration for now: a run queue is drained, not walked, and `popFront`
/// in a loop IS its walk. `null` from a pop or peek means "empty" — an ordinary state, like a
/// `List` pop, and the whole truth, so there is no throwing twin.
pub class Deque<T> {
    /// The backing ring; optional so a popped slot releases its value.
    data: (?T)[],
    /// The index of the front value, meaningful while `count > 0`.
    head: int,
    /// How many slots are filled.
    count: int,

    /// An empty deque.
    pub static fn empty(): Deque<T> {
        let hole: ?T = null;
        return Deque<T> { data = [hole] * 0, head = 0, count = 0 };
    }

    /// How many values are in it.
    pub fn length(): int {
        return this.count;
    }

    /// Whether nothing is in it.
    pub fn isEmpty(): bool {
        return this.count == 0;
    }

    /// The elements front to back as an array — a look at the queue without draining it.
    pub fn toArray(): T[] {
        let result = List<T>.empty();
        var i = 0;
        while (i < this.count) {
            result.push(this.data[(this.head + i) % this.data.length]!);
            i = i + 1;
        }
        return result.toArray();
    }

    /// How many slots are allocated, empty ones included. For tests and for anyone measuring
    /// what the deque costs; `length` is the truth for everything else.
    pub fn capacity(): int {
        return this.data.length;
    }

    // Unrolls the ring into a fresh array, front at 0. Also the growth step, which is why the
    // ring math below never has to handle a full ring: a push grows FIRST.
    mut fn unroll(target: int): void {
        let hole: ?T = null;
        let moved = [hole] * target;

        var i = 0;
        while (i < this.count) {
            moved[i] = this.data[(this.head + i) % this.data.length];
            i = i + 1;
        }
        this.data = moved;
        this.head = 0;
    }

    mut fn growIfFull(): void {
        if (this.count >= this.data.length) {
            if (this.data.length == 0) {
                this.unroll(4);
            } else {
                this.unroll(this.data.length * 2);
            }
        }
    }

    /// Appends at the back; amortized O(1).
    pub mut fn pushBack(value: T): void {
        this.growIfFull();
        this.data[(this.head + this.count) % this.data.length] = value;
        this.count = this.count + 1;
    }

    /// Prepends at the front; amortized O(1) — the ring is the reason no slot moves.
    pub mut fn pushFront(value: T): void {
        this.growIfFull();
        this.head = (this.head + this.data.length - 1) % this.data.length;
        this.data[this.head] = value;
        this.count = this.count + 1;
    }

    /// Removes and returns the front value, or `null` when empty.
    // The slot is cleared rather than skipped, or the ring would keep the object alive and a
    // "released" value would not be one.
    pub mut fn popFront(): ?T {
        if (this.count == 0) {
            return null;
        }
        let value = this.data[this.head];
        this.data[this.head] = null;
        this.head = (this.head + 1) % this.data.length;
        this.count = this.count - 1;
        return value;
    }

    /// Removes and returns the back value, or `null` when empty.
    pub mut fn popBack(): ?T {
        if (this.count == 0) {
            return null;
        }
        let at = (this.head + this.count - 1) % this.data.length;
        let value = this.data[at];
        this.data[at] = null;
        this.count = this.count - 1;
        return value;
    }

    /// The front value without removing it, or `null` when empty.
    pub fn peekFront(): ?T {
        if (this.count == 0) {
            return null;
        }
        return this.data[this.head];
    }

    /// The back value without removing it, or `null` when empty.
    pub fn peekBack(): ?T {
        if (this.count == 0) {
            return null;
        }
        return this.data[(this.head + this.count - 1) % this.data.length];
    }

    /// Empties the deque; the backing stays allocated, as `List.clear` keeps its.
    pub mut fn clear(): void {
        var i = 0;
        while (i < this.count) {
            this.data[(this.head + i) % this.data.length] = null;
            i = i + 1;
        }
        this.head = 0;
        this.count = 0;
    }
}

//
// Three states per slot (`states`): 0 empty, 1 occupied, 2 deleted. The third is needed because a
// deleted slot must not break the probe chain, or a `get` would stop finding a key behind the gap.
// A tombstone does not end a read but is reusable on a write.
//
// **Load factor 3/4**, measured over occupied AND deleted slots: tombstones cost search time like
// occupied slots, so they have to count. They disappear on a grow.

/// A hash map: open addressing, linear probing, load factor 3/4. The key type says how to
/// hash and how to compare — `[Hashable<K>]` — and the iteration order is
/// UNSPECIFIED.
pub class Map<K :: [Hashable<K>], V> {
    /// The key column; `states` says which slots are real.
    keyColumn: (?K)[],
    /// The value column, parallel to `keyColumn`.
    valueColumn: (?V)[],
    /// Per slot: 0 empty, 1 occupied, 2 tombstone.
    states: int[],
    /// The occupied slots alone.
    count: int,
    /// Occupied plus tombstones — what the load factor is measured over.
    used: int,

    /// How many values are in it.
    pub fn length(): int {
        return this.count;
    }

    /// Whether nothing is in it.
    pub fn isEmpty(): bool {
        return this.count == 0;
    }

    // The starting index for a key. A hash may be negative, and `%` follows the sign of the
    // dividend.
    fn slotOf(key: K): int {
        let h = key.hash();
        let positive = if (h < 0) 0 - h else h;
        return positive % this.keyColumn.length;
    }

    // Finds the slot of a key, or -1. The loop terminates: the load factor keeps at least a
    // quarter of the slots empty, and an empty slot ends the search.
    fn findSlot(key: K): int {
        var i = this.slotOf(key);
        let n = this.keyColumn.length;
        var steps = 0;

        while (steps < n) {
            if (this.states[i] == 0) {
                return -1; // empty: this is where it would have been
            }
            if (this.states[i] == 1) {
                let present = this.keyColumn[i];
                if (present != null && present.equals(key)) {
                    return i;
                }
            }
            // Tombstone (2): keep going, the chain has not ended.
            i = (i + 1) % n;
            steps = steps + 1;
        }
        return -1;
    }

    /// An empty map, with room for the first insertions before a growth.
    pub static fn empty(): Map<K, V> {
        let keyHole: ?K = null;
        let valueHole: ?V = null;
        return Map<K, V> {
            keyColumn = [keyHole] * 8,
            valueColumn = [valueHole] * 8,
            states = [0] * 8,
            count = 0,
            used = 0,
        };
    }

    /// Whether the key is in the map.
    pub fn containsKey(key: K): bool {
        return this.findSlot(key) >= 0;
    }

    /// The value for the key, or `null` when the key is absent.
    pub fn get(key: K): ?V {
        let i = this.findSlot(key);
        if (i < 0) {
            return null;
        }
        return this.valueColumn[i];
    }

    /// Inserts, or overwrites the existing entry for an equal key.
    // The load factor counts tombstones, so a table that churns — set, remove, set, remove —
    // fills with them without ever holding more entries. Reaching the threshold therefore asks
    // WHICH kind of full this is: when the live entries would fit at half the load, the table is
    // rehashed at its OWN size, which discards the tombstones; only real growth doubles.
    pub mut fn set(key: K, value: V): void {
        if ((this.used + 1) * 4 > this.keyColumn.length * 3) {
            let live = this.count + 1;
            if (live * 8 <= this.keyColumn.length * 3) {
                this.resize(this.keyColumn.length);
            } else {
                this.resize(this.keyColumn.length * 2);
            }
        }

        var i = this.slotOf(key);
        let n = this.keyColumn.length;
        var tombstone = -1;

        while (true) {
            if (this.states[i] == 0) {
                // First free slot. A tombstone seen earlier is preferable: it shortens future
                // searches and does not raise `used`.
                let target = if (tombstone >= 0) tombstone else i;
                this.keyColumn[target] = key;
                this.valueColumn[target] = value;
                this.states[target] = 1;
                this.count = this.count + 1;
                if (tombstone < 0) {
                    this.used = this.used + 1;
                }
                return;
            }
            if (this.states[i] == 2) {
                if (tombstone < 0) {
                    tombstone = i;
                }
            } else {
                let present = this.keyColumn[i];
                if (present != null && present.equals(key)) {
                    this.valueColumn[i] = value; // overwrite, not a new entry
                    return;
                }
            }
            i = (i + 1) % n;
        }
    }

    /// The value for the key, or `fallback` when the key is absent — one probe instead of a
    /// `containsKey` before every `get`.
    pub fn getOr(key: K, fallback: V): V {
        let found = this.get(key);
        return found ?? fallback;
    }

    /// The value for the key, inserting what `make` produces first when the key is absent —
    /// `groups.getOrInsert(k, () => List<string>.empty()).push(v)` is the whole of a group-by.
    /// `make` runs only on a miss.
    pub mut fn getOrInsert(key: K, make: fn() -> V): V {
        let found = this.get(key);
        if (found != null) {
            return found;
        }
        let made = make();
        this.set(key, made);
        return made;
    }

    /// Replaces the value for the key with what `f` makes of the current one — `null` when the
    /// key is absent — and stores the answer: `counts.update(word, (n) => (n ?? 0) + 1)`.
    pub mut fn update(key: K, f: fn(?V) -> V): void {
        this.set(key, f(this.get(key)));
    }

    /// A fresh cursor over the keys; the order follows the hashes and is UNSPECIFIED.
    pub fn keys(): Iterator<K> {
        return MapKeyIterator<K, V> { source = this, index = 0 };
    }

    /// A fresh cursor over the values, in the same unspecified order as `keys`.
    pub fn values(): Iterator<V> {
        return MapValueIterator<K, V> { source = this, index = 0 };
    }

    /// A fresh cursor over `(key, value)` pairs: `for (entry in m.entries()) { let (k, v) = entry; … }`.
    pub fn entries(): Iterator<(K, V)> {
        return MapEntryIterator<K, V> { source = this, index = 0 };
    }

    /// A map from `(key, value)` pairs; a later pair with an equal key overwrites, as `set`.
    pub static fn fromEntries(pairs: (K, V)[]): Map<K, V> {
        let result = Map<K, V>.empty();
        var i = 0;
        while (i < pairs.length) {
            let (k, v) = pairs[i];
            result.set(k, v);
            i = i + 1;
        }
        return result;
    }

    /// How many slots the table holds, empty ones included — what the map costs; `length` is
    /// the truth for everything else.
    pub fn capacity(): int {
        return this.keyColumn.length;
    }

    /// Empties the map. The backing arrays are KEPT, as in `List.clear`; the tombstones vanish
    /// with everything else.
    pub mut fn clear(): void {
        var i = 0;
        while (i < this.states.length) {
            this.keyColumn[i] = null;
            this.valueColumn[i] = null;
            this.states[i] = 0;
            i = i + 1;
        }
        this.count = 0;
        this.used = 0;
    }

    /// Removes and returns the old value, or `null` when the key was absent.
    // The slot becomes a tombstone rather than empty, which would break the probe chain and
    // hide a key behind it.
    pub mut fn remove(key: K): ?V {
        let i = this.findSlot(key);
        if (i < 0) {
            return null;
        }
        let old = this.valueColumn[i];
        this.keyColumn[i] = null;
        this.valueColumn[i] = null;
        this.states[i] = 2;
        this.count = this.count - 1;
        return old;
    }

    mut fn resize(capacity: int): void {
        let oldKeys = this.keyColumn;
        let oldValues = this.valueColumn;
        let oldStates = this.states;

        let keyHole: ?K = null;
        let valueHole: ?V = null;
        this.keyColumn = [keyHole] * capacity;
        this.valueColumn = [valueHole] * capacity;
        this.states = [0] * capacity;
        this.count = 0;
        this.used = 0;

        // Reinsert rather than copy: the slots depend on the capacity, and tombstones disappear
        // in the process.
        var i = 0;
        while (i < oldStates.length) {
            if (oldStates[i] == 1) {
                let k = oldKeys[i];
                let v = oldValues[i];
                if (k != null && v != null) {
                    this.set(k, v);
                }
            }
            i = i + 1;
        }
    }
}

// ================================================================ sorting
//
// **Bottom-up Merge Sort**, in Lyric.
//
// Merge sort rather than quicksort: it is STABLE — equal elements keep their order — and O(n log n)
// in the worst case too. Quicksort is unstable and quadratic on already sorted input.
//
// Bottom-up rather than recursive: the loop structure is visible — width 1, 2, 4, … — and adjacent
// runs are merged in each round. There is no call stack whose depth follows the input size.
//
// The cost is a buffer the size of the list.
//
// Two names rather than one, because there is no overloading: `sortList` by the natural order,
// `sortListBy` with a comparison of your own.

/// Sorts in place by the natural order of the type.
pub fn sortList<T :: [Ordered<T>]>(xs: List<T>): void {
    sortListBy<T>(xs, (a: T, b: T) => a.compare(b) < 0);
}

/// Sorts in place with a comparison of your own.
///
/// `less(a, b)` must return `true` when `a` comes STRICTLY before `b`. A `less` returning `true`
/// for equal elements destroys stability; a contradictory `less` makes the output arbitrary but
/// crashes nothing, because the algorithm only compares.
pub fn sortListBy<T>(xs: List<T>, less: fn(T, T) -> bool): void {
    let n = xs.length();
    if (n < 2) {
        return;
    }

    let hole: ?T = null;
    var buffer = [hole] * n;

    var width = 1;
    while (width < n) {
        var start = 0;
        while (start < n) {
            // Two adjacent, already sorted runs: [start, middle) and [middle, end).
            let middle = min(start + width, n);
            let end = min(start + width * 2, n);
            mergeRuns<T>(xs, buffer, start, middle, end, less);
            start = start + width * 2;
        }

        // Written back after every round. Swapping the roles of source and buffer would save
        // half the copies but requires knowing at the end which of the two holds the result.
        var i = 0;
        while (i < n) {
            let v = buffer[i];
            if (v != null) {
                xs.set(i, v);
            }
            i = i + 1;
        }

        width = width * 2;
    }
}

// Merges [start, middle) and [middle, end) from `xs` into `buffer`.
fn mergeRuns<T>(
    xs: List<T>,
    buffer: (?T)[],
    start: int,
    middle: int,
    end: int,
    less: fn(T, T) -> bool
): void {
    var left = start;
    var right = middle;
    var target = start;

    while (left < middle && right < end) {
        let a = xs.get(left);
        let b = xs.get(right);

        // `less(b, a)` rather than `less(a, b)`: on a tie the result is `false`, so the LEFT
        // side wins, and the left side is what came earlier. Stability hangs on this.
        let p = less;
        if (p(b, a)) {
            buffer[target] = b;
            right = right + 1;
        } else {
            buffer[target] = a;
            left = left + 1;
        }
        target = target + 1;
    }

    while (left < middle) {
        buffer[target] = xs.get(left);
        left = left + 1;
        target = target + 1;
    }

    while (right < end) {
        buffer[target] = xs.get(right);
        right = right + 1;
        target = target + 1;
    }
}

fn min(a: int, b: int): int {
    return if (a < b) a else b;
}

// ================================================================== Set<T>
//
// The same probing as `Map`, only without the value column.
//
// Not built as a `Map<T, bool>`, which would waste an array and make `add(x)` read as
// `set(x, true)`. The duplicated probing logic is the more honest price.

/// A hash set: the same probing as `Map`, without the value column. Iteration order is
/// UNSPECIFIED. `Iterable`, so `for (v in set)` walks it directly.
pub class Set<T :: [Hashable<T>]> :: [Iterable<T>] {
    /// The element column; `states` says which slots are real.
    items: (?T)[],
    /// Per slot: 0 empty, 1 occupied, 2 tombstone.
    states: int[],
    /// The occupied slots alone.
    count: int,
    /// Occupied plus tombstones — what the load factor is measured over.
    used: int,

    /// How many values are in it.
    pub fn length(): int {
        return this.count;
    }

    /// Whether nothing is in it.
    pub fn isEmpty(): bool {
        return this.count == 0;
    }

    /// A set holding the elements of an array: `Set<int>.of([3, 1, 3])` has two elements.
    pub static fn of(items: T[]): Set<T> {
        let result = Set<T>.empty();
        result.addAll(items);
        return result;
    }

    /// Adds every element of the array; answers how many were new.
    pub mut fn addAll(items: T[]): int {
        var added = 0;
        var i = 0;
        while (i < items.length) {
            if (this.add(items[i])) {
                added = added + 1;
            }
            i = i + 1;
        }
        return added;
    }

    /// The elements as an array, in the unspecified order of the walk.
    pub fn toArray(): T[] {
        return collect<T>(this.iter()).toArray();
    }

    /// The elements as a list, in the unspecified order of the walk.
    pub fn toList(): List<T> {
        return collect<T>(this.iter());
    }

    fn slotOf(value: T): int {
        let h = value.hash();
        let positive = if (h < 0) 0 - h else h;
        return positive % this.items.length;
    }

    fn findSlot(value: T): int {
        var i = this.slotOf(value);
        let n = this.items.length;
        var steps = 0;

        while (steps < n) {
            if (this.states[i] == 0) {
                return -1;
            }
            if (this.states[i] == 1) {
                let present = this.items[i];
                if (present != null && present.equals(value)) {
                    return i;
                }
            }
            i = (i + 1) % n;
            steps = steps + 1;
        }
        return -1;
    }

    /// An empty set.
    pub static fn empty(): Set<T> {
        let hole: ?T = null;
        return Set<T> { items = [hole] * 8, states = [0] * 8, count = 0, used = 0 };
    }

    /// Whether the value is in the set.
    pub fn contains(value: T): bool {
        return this.findSlot(value) >= 0;
    }

    /// Adds and returns `true` when the value was NEW.
    ///
    /// The return value saves a preceding `contains`, which would probe twice.
    pub mut fn add(value: T): bool {
        if ((this.used + 1) * 4 > this.items.length * 3) {
            // As in `Map.set`: a churned table rehashes at its own size, a full one doubles.
            let live = this.count + 1;
            if (live * 8 <= this.items.length * 3) {
                this.resize(this.items.length);
            } else {
                this.resize(this.items.length * 2);
            }
        }

        var i = this.slotOf(value);
        let n = this.items.length;
        var tombstone = -1;

        while (true) {
            if (this.states[i] == 0) {
                let target = if (tombstone >= 0) tombstone else i;
                this.items[target] = value;
                this.states[target] = 1;
                this.count = this.count + 1;
                if (tombstone < 0) {
                    this.used = this.used + 1;
                }
                return true;
            }
            if (this.states[i] == 2) {
                if (tombstone < 0) {
                    tombstone = i;
                }
            } else {
                let present = this.items[i];
                if (present != null && present.equals(value)) {
                    return false; // already present
                }
            }
            i = (i + 1) % n;
        }
    }

    /// Removes and returns `true` when the value was present.
    pub mut fn remove(value: T): bool {
        let i = this.findSlot(value);
        if (i < 0) {
            return false;
        }
        this.items[i] = null;
        this.states[i] = 2;
        this.count = this.count - 1;
        return true;
    }

    /// Empties the set. The backing arrays are KEPT, as in `List.clear`; the tombstones vanish
    /// with everything else.
    pub mut fn clear(): void {
        var i = 0;
        while (i < this.states.length) {
            this.items[i] = null;
            this.states[i] = 0;
            i = i + 1;
        }
        this.count = 0;
        this.used = 0;
    }

    /// A fresh cursor on every call.
    pub fn iter(): Iterator<T> {
        return SetIterator<T> { source = this, index = 0 };
    }

    mut fn resize(capacity: int): void {
        let oldItems = this.items;
        let oldStates = this.states;

        let hole: ?T = null;
        this.items = [hole] * capacity;
        this.states = [0] * capacity;
        this.count = 0;
        this.used = 0;

        var i = 0;
        while (i < oldStates.length) {
            if (oldStates[i] == 1) {
                let v = oldItems[i];
                if (v != null) {
                    this.add(v);
                }
            }
            i = i + 1;
        }
    }
}

/// Walks the occupied slots. The order follows the hashes and is therefore UNSPECIFIED; a
/// caller that needs one sorts.
pub class SetIterator<T :: [Hashable<T>]> :: [Iterator<T>] {
    /// The set being walked.
    source: Set<T>,
    /// The next slot to look at.
    index: int,

    /// The next value, or `null` at the end.
    pub mut fn next(): ?T {
        while (this.index < this.source.states.length) {
            let i = this.index;
            this.index = this.index + 1;
            if (this.source.states[i] == 1) {
                return this.source.items[i];
            }
        }
        return null;
    }
}

// --- Set operations. All return a NEW set; none changes its arguments. ---

/// Everything in either set, as a NEW set; neither argument changes.
pub fn union<T :: [Hashable<T>]>(a: Set<T>, b: Set<T>): Set<T> {
    let result = Set<T>.empty();
    for (v in a.iter()) {
        result.add(v);
    }
    for (v in b.iter()) {
        result.add(v);
    }
    return result;
}

/// Everything in both sets, as a NEW set; neither argument changes.
pub fn intersect<T :: [Hashable<T>]>(a: Set<T>, b: Set<T>): Set<T> {
    let result = Set<T>.empty();
    // Walk the SMALLER one: the number of probes depends on it.
    let small = if (a.length() <= b.length()) a else b;
    let large = if (a.length() <= b.length()) b else a;
    for (v in small.iter()) {
        if (large.contains(v)) {
            result.add(v);
        }
    }
    return result;
}

/// Everything in `a` that is not in `b`, as a NEW set; neither argument changes.
pub fn difference<T :: [Hashable<T>]>(a: Set<T>, b: Set<T>): Set<T> {
    let result = Set<T>.empty();
    for (v in a.iter()) {
        if (!b.contains(v)) {
            result.add(v);
        }
    }
    return result;
}

/// Whether every element of `a` is in `b`.
pub fn isSubset<T :: [Hashable<T>]>(a: Set<T>, b: Set<T>): bool {
    if (a.length() > b.length()) {
        return false;
    }
    for (v in a.iter()) {
        if (!b.contains(v)) {
            return false;
        }
    }
    return true;
}

// ------------------------------------------------- walking a Map
//
// The cursors behind `Map.keys()`, `values()` and `entries()` (methods since 4.5; the free
// functions below forward to them and go with 5.0). They read the map's columns directly, which
// is the one place in the library where a class reads another class's fields — a module-level
// visibility, or the cursors as nested types, is what would close it.
//
// The order follows the hashes and is therefore UNSPECIFIED. A caller that needs one collects and
// sorts.

/// Walks the keys; the order follows the hashes and is UNSPECIFIED.
pub class MapKeyIterator<K :: [Hashable<K>], V> :: [Iterator<K>] {
    /// The map being walked.
    source: Map<K, V>,
    /// The next slot to look at.
    index: int,

    /// The next key, or `null` at the end.
    pub mut fn next(): ?K {
        while (this.index < this.source.states.length) {
            let i = this.index;
            this.index = this.index + 1;
            if (this.source.states[i] == 1) {
                return this.source.keyColumn[i];
            }
        }
        return null;
    }
}

/// Walks the values; the order follows the hashes and is UNSPECIFIED.
pub class MapValueIterator<K :: [Hashable<K>], V> :: [Iterator<V>] {
    /// The map being walked.
    source: Map<K, V>,
    /// The next slot to look at.
    index: int,

    /// The next value, or `null` at the end.
    pub mut fn next(): ?V {
        while (this.index < this.source.states.length) {
            let i = this.index;
            this.index = this.index + 1;
            if (this.source.states[i] == 1) {
                return this.source.valueColumn[i];
            }
        }
        return null;
    }
}

/// Walks key and value TOGETHER; the order follows the hashes and is UNSPECIFIED.
///
/// Without this, walking both meant iterating `keys` and paying a second probe per key
/// through `get`.
pub class MapEntryIterator<K :: [Hashable<K>], V> :: [Iterator<(K, V)>] {
    /// The map being walked.
    source: Map<K, V>,
    /// The next slot to look at.
    index: int,

    /// The next `(key, value)` pair, or `null` at the end.
    pub mut fn next(): ?(K, V) {
        while (this.index < this.source.states.length) {
            let i = this.index;
            this.index = this.index + 1;
            if (this.source.states[i] == 1) {
                let k = this.source.keyColumn[i];
                let v = this.source.valueColumn[i];
                if (k != null && v != null) {
                    return (k, v);
                }
            }
        }
        return null;
    }
}

/// A fresh cursor over the keys.
pub fn keys<K :: [Hashable<K>], V>(m: Map<K, V>): Iterator<K> {
    return m.keys();
}

/// A fresh cursor over the values.
pub fn values<K :: [Hashable<K>], V>(m: Map<K, V>): Iterator<V> {
    return m.values();
}

/// A fresh cursor over `(key, value)` pairs:
///
///     for (entry in entries(m)) { let (k, v) = entry; … }
pub fn entries<K :: [Hashable<K>], V>(m: Map<K, V>): Iterator<(K, V)> {
    return m.entries();
}

// ------------------------------------------------------- 4.5: mapping a List
//
// A free function rather than `xs.map(f)`: a method of a generic type cannot introduce a type
// parameter of its own today, and `map` needs `U`. `filter` and `forEach` keep `T` and ARE
// methods. The day the compiler allows it, this becomes `List.map` and the free name forwards.

/// A new list of `f` applied to every element, EAGERLY: the work happens here, once.
/// `xs.iter().map(f)` is the lazy form for a chain that goes on.
pub fn mapList<T, U>(xs: List<T>, f: fn(T) -> U): List<U> {
    let result = List<U>.empty();
    var i = 0;
    let n = xs.length();
    while (i < n) {
        result.push(f(xs.get(i)));
        i = i + 1;
    }
    return result;
}

// ------------------------------------------------------- 4.5: sorting by key, arrays

/// Sorts in place by a key of each element: `sortListByKey(people, (p) => p.age)`. Stable, as
/// every sort here; the key is computed on every comparison, so a costly key wants a `map` to a
/// tuple first.
pub fn sortListByKey<T, K :: [Ordered<K>]>(xs: List<T>, key: fn(T) -> K): void {
    sortListBy<T>(xs, (a: T, b: T) => key(a).compare(key(b)) < 0);
}

/// Sorts an array in place by the natural order of the type — through a list, because the
/// merge sort lives there; the array's own slots receive the result.
pub fn sortArray<T :: [Ordered<T>]>(xs: T[]): void {
    let sorted = List<T>.of(xs);
    sortList<T>(sorted);
    var i = 0;
    while (i < xs.length) {
        xs[i] = sorted.get(i);
        i = i + 1;
    }
}

/// The element with the largest key, or `null` for an empty list; the FIRST one on a tie.
pub fn maxBy<T, K :: [Ordered<K>]>(xs: List<T>, key: fn(T) -> K): ?T {
    if (xs.isEmpty()) {
        return null;
    }
    var best = xs.get(0);
    var bestKey = key(best);
    var i = 1;
    while (i < xs.length()) {
        let candidate = xs.get(i);
        let k = key(candidate);
        if (k.compare(bestKey) > 0) {
            best = candidate;
            bestKey = k;
        }
        i = i + 1;
    }
    return best;
}

/// The element with the smallest key, or `null` for an empty list; the FIRST one on a tie.
pub fn minBy<T, K :: [Ordered<K>]>(xs: List<T>, key: fn(T) -> K): ?T {
    if (xs.isEmpty()) {
        return null;
    }
    var best = xs.get(0);
    var bestKey = key(best);
    var i = 1;
    while (i < xs.length()) {
        let candidate = xs.get(i);
        let k = key(candidate);
        if (k.compare(bestKey) < 0) {
            best = candidate;
            bestKey = k;
        }
        i = i + 1;
    }
    return best;
}

/// The elements from `from` up to but not including `to`, as a NEW array — `List.slice`'s
/// edges: `0 <= from <= to <= length`, anything else a panic.
pub fn slice<T>(xs: T[], from: int, to: int): T[] {
    if (from < 0 || to > xs.length || from > to) {
        panic("slice out of range");
    }
    if (from == to) {
        return [];
    }
    let result = [xs[from]] * (to - from);
    var i = from + 1;
    while (i < to) {
        result[i - from] = xs[i];
        i = i + 1;
    }
    return result;
}

/// Removes the FIRST occurrence of `value`, by `equals`; whether one was there.
pub fn listRemove<T :: [Equatable<T>]>(xs: List<T>, value: T): bool {
    let at = listIndexOf<T>(xs, value);
    if (at == null) {
        return false;
    }
    xs.removeAt(at);
    return true;
}

/// The elements grouped by a key, in first-seen order within each group. Every step of the
/// idiom in one place: `groupBy(words, (w) => w.length())`.
pub fn groupBy<T, K :: [Hashable<K>]>(xs: List<T>, key: fn(T) -> K): Map<K, List<T>> {
    let groups = Map<K, List<T>>.empty();
    var i = 0;
    while (i < xs.length()) {
        let value = xs.get(i);
        groups.getOrInsert(key(value), () => List<T>.empty()).push(value);
        i = i + 1;
    }
    return groups;
}

// ------------------------------------------------------- searching a List
//
// Free functions rather than methods: they need `Equatable<T>`, and putting that constraint on
// the CLASS would make `List<T>` unusable for every type without equality. A constraint belongs
// where it is needed.

/// Whether the value occurs, by `equals`; O(n).
pub fn listContains<T :: [Equatable<T>]>(xs: List<T>, value: T): bool {
    var i = 0;
    while (i < xs.length()) {
        if (xs.get(i).equals(value)) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

/// The position of the first occurrence, or `null` when there is none.
pub fn listIndexOf<T :: [Equatable<T>]>(xs: List<T>, value: T): ?int {
    var i = 0;
    while (i < xs.length()) {
        if (xs.get(i).equals(value)) {
            return i;
        }
        i = i + 1;
    }
    return null;
}
