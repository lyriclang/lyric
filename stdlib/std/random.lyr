// std.random — deterministic pseudo-randomness.
//
// Moved out of `std.math` in v1.14: randomness is not arithmetic, and the module wants imports —
// `List<T>` for shuffling and drawing — that a math module has no business carrying. The class
// there remains one release as a deprecated twin.
//
// No capability required: the generator is deterministic and reaches nothing.
//
// **The seed comes from the caller**: there is no `Random.new()` without an argument. A default
// seed would make a run irreproducible, and silently so. A caller wanting per-run randomness
// takes the time from `std.os` and says so.

module std.random;

import std.collections { List };
import std.math { sqrt, log, cos, tau };

/// `count` bytes from the operating system's cryptographic source — the ONE thing in this
/// module that is not deterministic, and deliberately so marked: keys, tokens and session ids
/// need entropy no seed can replay, which is exactly what makes it useless for a simulation
/// that wants to be reproduced. A negative `count` panics; zero answers the empty array.
///
/// Capability-free like the rest of the module: the source reaches no file, no clock and no
/// network — an embedded host loses nothing by a guest that can draw good dice.
pub fn secureRandom(count: int): uint8[];

/// One xorshift64 round: three shifts and three exclusive ors over the state.
///
/// Native, and this one is worth a word because the rest of this module is not. Written in Lyric
/// the round is 53 instructions, and an instruction costs the same as a crossing into the host —
/// so a draw spent most of its time dispatching shifts. The STATE stays here; what crosses is one
/// integer, and what comes back is the next one.
fn xorshift(state: int): int;

/// A deterministic pseudo-random generator (xorshift64*): one `int` of state, seeded by the
/// caller. Not cryptographic — keys need a source from the operating system, which is what
/// `secureRandom` is.
pub class Random {
    /// The generator state; every draw replaces it.
    state: int,

    /// A generator with an explicit seed. A seed of 0 is a fixed point for xorshift — the
    /// sequence would stay 0 forever — so it is replaced silently rather than panicking on a
    /// plausible input.
    pub static fn seeded(seed: int): Random {
        return Random { state = if (seed == 0) 0x2545F4914F6CDD1D else seed };
    }

    /// A generator seeded from the operating system's entropy — for a game or a shuffle that
    /// should differ per run, and that nobody needs to replay. `seeded` is the reproducible
    /// form; this one says in its name that the run cannot be repeated.
    pub static fn fresh(): Random {
        let bytes = secureRandom(8);
        var seed = 0;
        var i = 0;
        while (i < 8) {
            seed = seed << 8 | bytes[i] as int;
            i = i + 1;
        }
        return Random.seeded(seed);
    }

    /// The next raw value. It may have either sign.
    pub mut fn nextInt(): int {
        let x = xorshift(this.state);
        this.state = x;
        return x;
    }

    // The raw value with the sign bit cleared: 63 uniform bits. Not `absInt`, whose one
    // failure — `intMin` stays negative — landed a draw below `lo` once in 2^63.
    mut fn nextBits(): int {
        return this.nextInt() & 0x7FFFFFFFFFFFFFFF;
    }

    /// Uniformly distributed in `[lo, hi)`. An empty range yields `lo`.
    // Rejection rather than a bare modulo: `bits % n` favours the low residues whenever 2^63 is
    // no multiple of `n`, by up to one part in 2^63 / n — invisible for small ranges, real for
    // large ones. A draw at or above the largest multiple of `n` below 2^63 is thrown away; the
    // expected number of redraws is below one.
    pub mut fn nextIntRange(lo: int, hi: int): int {
        if (hi <= lo) {
            return lo;
        }
        let span = hi - lo;
        if (span < 0) {
            // The range covers more than half of int: every raw value is a valid offset from
            // `lo` and nothing can be rejected, so the raw draw is the answer.
            return lo + this.nextInt();
        }
        let limit = 9223372036854775807 - 9223372036854775807 % span;
        var draw = this.nextBits();
        while (draw >= limit) {
            draw = this.nextBits();
        }
        return lo + draw % span;
    }

    /// Uniformly distributed in `[0, 1)`.
    pub mut fn nextFloat(): float {
        // The top 53 bits of the draw: exactly a float64 mantissa, so every value is
        // representable and the low bits, the weakest of a xorshift, are not used.
        let bits = this.nextBits() >> 10;
        return bits as float / 9007199254740992.0;
    }

    /// True or false, from the next draw's parity.
    pub mut fn nextBool(): bool {
        return this.nextInt() % 2 == 0;
    }

    /// Normally distributed, mean 0 and deviation 1 (Box–Muller).
    pub mut fn nextGaussian(): float {
        // log(0) is -infinity; the draw is nudged off the one value of [0, 1) that breaks it.
        var u1 = this.nextFloat();
        if (u1 == 0.0) {
            u1 = 0.0000000001;
        }
        let u2 = this.nextFloat();
        return sqrt(0.0 - 2.0 * log(u1)) * cos(tau * u2);
    }
}

// Free functions rather than methods, for the same reason `sortList` is one: they want
// `List<T>`, and a constraintless generic helper does not belong on the class.

/// Shuffles in place, Fisher–Yates: every permutation equally likely, one draw per element.
pub fn shuffle<T>(random: Random, xs: List<T>): void {
    var i = xs.length() - 1;
    while (i > 0) {
        let j = random.nextIntRange(0, i + 1);
        xs.swap(i, j);
        i = i - 1;
    }
}

/// One element drawn uniformly, or `null` from an empty list.
pub fn choice<T>(random: Random, xs: List<T>): ?T {
    if (xs.isEmpty()) {
        return null;
    }
    return xs.get(random.nextIntRange(0, xs.length()));
}
