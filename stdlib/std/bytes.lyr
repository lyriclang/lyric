// std.bytes — the byte tooling wire protocols stand on.
//
// Three deliberate absences. CONCAT needs no function: `a + b` joins arrays, bytes included —
// a `concat` here would be a second name for the operator. A subsequence search waits for the
// protocol that needs one (a line ends in ONE byte). And nothing here is native: slicing and
// searching are loops over an array, which is something the language does.

/// Slicing and searching over `uint8[]` — what a wire protocol does between reads.
///
/// The edges mirror `string.substring` exactly: a negative `start` or `count` panics, a
/// `start` past the end panics, and a `count` past the end clamps to it. `indexOf` answers
/// `-1` when nothing is found — ready for `slice`, as `string.indexOf` is for `substring`.
module std.bytes;

/// `count` bytes from `start`, clamped at the end like `string.substring`.
pub fn slice(bytes: uint8[], start: int, count: int): uint8[] {
    if (start < 0 || count < 0) {
        panic("std.bytes.slice: negative start or count");
    }
    if (start > bytes.length) {
        panic("std.bytes.slice: start is past the end");
    }

    var end = start + count;
    if (end > bytes.length) {
        end = bytes.length;
    }

    let zero: uint8 = 0;
    let taken = [zero] * (end - start);
    var i = start;
    while (i < end) {
        taken[i - start] = bytes[i];
        i = i + 1;
    }
    return taken;
}

/// The first position of `value`, or `-1` — ready for `slice`.
pub fn indexOf(bytes: uint8[], value: uint8): int {
    return indexOfFrom(bytes, value, 0);
}

/// Searches from a position. `-1` when nothing is found, as in `indexOf`; a negative `start`
/// searches from the front, one past the end finds nothing.
pub fn indexOfFrom(bytes: uint8[], value: uint8, start: int): int {
    var i = if (start < 0) 0 else start;
    while (i < bytes.length) {
        if (bytes[i] == value) {
            return i;
        }
        i = i + 1;
    }
    return 0 - 1;
}
