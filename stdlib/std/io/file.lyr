// std.io.file — reading and writing files.
//
// Capability-gated: an import requires `fileAccess`. A script embedded in a host must not reach
// the disk, while the same language standalone may be a CLI tool.
//
// Failures are return values, not exceptions. A file that does not exist is an ordinary state of
// the world, so a read answers `?T` rather than `T` with `throws`. A panic stays reserved for
// what the programmer got wrong.
//
// TWO conventions since 2.14, and each one says what it is for:
//
//   * a READ answers `?T` — `null` is "could not", and an empty result is an empty file;
//   * an OPERATION answers `bool` — whether it happened. It carries no value, so nothing is
//     lost by saying only that.
//
// A predicate (`exists`, `isFile`, `isDirectory`) also answers `bool`, and there `false` is an
// ANSWER rather than a failure.
//
// Before 2.14 there were three, and the third one lied: `readBytes` and `readLines` answered an
// empty array to both "the file is empty" and "there is no file". No caller could tell those
// apart, and the documentation told them to ask `exists` first — which is a race, not an answer.
//
// Since 3.7 the REASON has a form too (§9.0): every silent form has an `*OrThrow` twin that
// throws an `IoError` — kind, path, and what the platform said — where the silent one answers
// `null` or `false`. Both come from ONE implementation: the twin calls the silent form and
// turns its refusal into the reason the runtime recorded. Which form a caller uses states what
// they will do with a failure: fall back, or handle the why.

module std.io.file;

import std.io.error { IoError, IoErrorKind };

// For the string METHODS the path helpers below use; the alias avoids shadowing the
// builtin type name.
import std.string as strings;

// For the deprecation promises on the three names this module used before 2.14.
import std.core { Deprecated };

// For the path helpers below. 'std.string' imports nothing, so there is no cycle.

/// The whole content as text, decoded as UTF-8 — bytes that are not valid UTF-8 become
/// U+FFFD. For binary data use `bytes`. `null` when the file does not exist or is not readable.
pub fn text(path: string): ?string;

/// The raw bytes, undecoded — what `text` cannot give: its UTF-8 decoding turns invalid bytes
/// into U+FFFD. `null` when the file is not readable; an EMPTY array is an empty file.
pub fn bytes(path: string): ?uint8[];

/// The lines of a file, terminators removed, so whether the file used CRLF or LF is no longer
/// visible. `null` when the file is not readable; an EMPTY array is an empty file.
pub fn lines(path: string): ?string[];

/// Writes text (UTF-8), replacing an existing file. `true` on success.
pub fn writeText(path: string, content: string): bool;

/// Appends to an existing file or creates it. `true` on success.
pub fn appendText(path: string, content: string): bool;

/// Whether something — file or directory — exists at the path.
pub fn exists(path: string): bool;

/// `true` when the file is gone afterwards, including when it never existed.
pub fn remove(path: string): bool;

/// Writes raw bytes, replacing an existing file. `true` on success — the `writeText`
/// convention. (v1.14: the first native whose parameter is an array.)
pub fn writeBytes(path: string, data: uint8[]): bool;

/// Appends raw bytes to an existing file or creates it. `true` on success.
pub fn appendBytes(path: string, data: uint8[]): bool;

// ------------------------------------------------------------------------ the reasons (3.7)
//
// The runtime classifies the last failed operation of this module; the OrThrow forms read the
// classification immediately after a silent form refused. The VM is single-threaded, so nothing
// runs between the failure and the read. The codes are a contract with the runtime:
// 1 NotFound, 2 PermissionDenied, 3 InvalidPath, 0 Other.

fn lastErrorKind(): int;
fn lastErrorDetail(): string;

fn lastIoError(path: string): IoError {
    let kind = match (lastErrorKind()) {
        1 => IoErrorKind.NotFound,
        2 => IoErrorKind.PermissionDenied,
        3 => IoErrorKind.InvalidPath,
        _ => IoErrorKind.Other,
    };
    return IoError { kind = kind, path = path, detail = lastErrorDetail() };
}

/// `text`, with the reason when it cannot: the content, or an `IoError` saying why not.
pub fn textOrThrow(path: string): string throws IoError {
    let content = text(path);
    if (content == null) {
        throw lastIoError(path);
    }
    return content;
}

/// `bytes`, with the reason when it cannot.
pub fn bytesOrThrow(path: string): uint8[] throws IoError {
    let content = bytes(path);
    if (content == null) {
        throw lastIoError(path);
    }
    return content;
}

/// `lines`, with the reason when it cannot.
pub fn linesOrThrow(path: string): string[] throws IoError {
    let content = lines(path);
    if (content == null) {
        throw lastIoError(path);
    }
    return content;
}

/// `size`, with the reason when it cannot.
pub fn sizeOrThrow(path: string): int throws IoError {
    let result = size(path);
    if (result == null) {
        throw lastIoError(path);
    }
    return result;
}

/// `entries`, with the reason when it cannot.
pub fn entriesOrThrow(path: string): string[] throws IoError {
    let names = entries(path);
    if (names == null) {
        throw lastIoError(path);
    }
    return names;
}

// The operations' twins: `void` where the silent form answers `bool`, and the reason where it
// answers `false`. For the two-path operations the error's `path` carries the SOURCE; the
// platform's detail names the half that actually failed.

/// `writeText`, with the reason when it cannot.
pub fn writeTextOrThrow(path: string, content: string): void throws IoError {
    if (!writeText(path, content)) {
        throw lastIoError(path);
    }
}

/// `appendText`, with the reason when it cannot.
pub fn appendTextOrThrow(path: string, content: string): void throws IoError {
    if (!appendText(path, content)) {
        throw lastIoError(path);
    }
}

/// `writeBytes`, with the reason when it cannot.
pub fn writeBytesOrThrow(path: string, data: uint8[]): void throws IoError {
    if (!writeBytes(path, data)) {
        throw lastIoError(path);
    }
}

/// `appendBytes`, with the reason when it cannot.
pub fn appendBytesOrThrow(path: string, data: uint8[]): void throws IoError {
    if (!appendBytes(path, data)) {
        throw lastIoError(path);
    }
}

/// `remove`, with the reason when it cannot. A file that never existed is still success, as in
/// `remove` — the twin throws exactly where the silent form answers `false`.
pub fn removeOrThrow(path: string): void throws IoError {
    if (!remove(path)) {
        throw lastIoError(path);
    }
}

/// `copy`, with the reason when it cannot.
pub fn copyOrThrow(from: string, to: string): void throws IoError {
    if (!copy(from, to)) {
        throw lastIoError(from);
    }
}

/// `move`, with the reason when it cannot.
pub fn moveOrThrow(from: string, to: string): void throws IoError {
    if (!move(from, to)) {
        throw lastIoError(from);
    }
}

/// `createDir`, with the reason when it cannot.
pub fn createDirOrThrow(path: string): void throws IoError {
    if (!createDir(path)) {
        throw lastIoError(path);
    }
}

/// `createDirAll`, with the reason when it cannot.
pub fn createDirAllOrThrow(path: string): void throws IoError {
    if (!createDirAll(path)) {
        throw lastIoError(path);
    }
}

/// `removeDir`, with the reason when it cannot.
pub fn removeDirOrThrow(path: string): void throws IoError {
    if (!removeDir(path)) {
        throw lastIoError(path);
    }
}

// ------------------------------------------------------------------------------------------
//
// The capability hangs off the module name, so no individual function has to state it.

/// The size in bytes, or `null` when the file does not exist.
pub fn size(path: string): ?int;
/// Whether the path names an existing FILE.
pub fn isFile(path: string): bool;
/// Whether the path names an existing DIRECTORY.
pub fn isDirectory(path: string): bool;

/// Copies. `false` when the source is missing or the target is not writable.
pub fn copy(from: string, to: string): bool;

/// Moves or renames; the same operation on every file system.
pub fn move(from: string, to: string): bool;

/// Creates one directory; the parent must exist. `createDirAll` creates the chain.
pub fn createDir(path: string): bool;

/// Creates missing parent directories too. An existing directory counts as success.
pub fn createDirAll(path: string): bool;

/// Deletes an EMPTY directory. There is no recursive delete; a caller that needs one writes
/// the loop visibly.
pub fn removeDir(path: string): bool;

/// The entries of a directory: names rather than paths, sorted alphabetically. `null` when the
/// directory cannot be read; an EMPTY array is an empty directory — the 2.14 convention, which
/// `listDir` predates.
pub fn entries(path: string): ?string[];

/// The entries of a directory — names, sorted — before 3.7. It answers an empty array to both
/// "empty" and "unreadable", which no caller can tell apart; `entries` says `null`, and
/// `entriesOrThrow` says why.
@Deprecated { message = "use entries — it can say null — or entriesOrThrow", until = "4.0" }
pub fn listDir(path: string): string[];

/// A path in the system's temporary directory. Does NOT create the file.
pub fn tempDir(): string;

// ------------------------------------------------------------------------ paths, in Lyric
//
// Nothing below is native: a path is a string, and finding separators is something the language
// does. A host would bring its own platform convention into a platform-neutral bytecode.

/// Both separators count. Windows understands `/`, and a script running on both systems should
/// not have to guess which one applies.
fn isSeparator(c: char): bool {
    return c == '/' || c == '\\';
}

/// Joins two path parts, with neither a doubled nor a missing separator.
pub fn joinPath(left: string, right: string): string {
    if (left.length() == 0) {
        return right;
    }
    if (right.length() == 0) {
        return left;
    }

    let endsWithSeparator = isSeparator(left.charAt(left.length() - 1));
    let startsWithSeparator = isSeparator(right.charAt(0));

    if (endsWithSeparator && startsWithSeparator) {
        return left + right.substring(1, right.length() - 1);
    }
    if (endsWithSeparator || startsWithSeparator) {
        return left + right;
    }
    return left + "/" + right;
}

// The index after the last separator, or 0 when there is none.
fn afterLastSeparator(path: string): int {
    var i = path.length() - 1;
    while (i >= 0) {
        if (isSeparator(path.charAt(i))) {
            return i + 1;
        }
        i = i - 1;
    }
    return 0;
}

/// The last component. `"a/b/c.txt"` becomes `"c.txt"`.
pub fn fileName(path: string): string {
    let start = afterLastSeparator(path);
    return path.substring(start, path.length() - start);
}

/// Everything before the last separator, or `""` when there is none.
pub fn parentDir(path: string): string {
    let start = afterLastSeparator(path);
    if (start == 0) {
        return "";
    }
    // The separator itself is dropped, except for "/x", where the parent is the root.
    if (start == 1) {
        return path.substring(0, 1);
    }
    return path.substring(0, start - 1);
}

/// The extension WITHOUT the dot. `""` when there is none.
///
/// A leading dot does not count: `".gitignore"` has no extension, that is its name. This rule
/// differs between languages, so it is stated here.
pub fn extension(path: string): string {
    let name = fileName(path);
    var i = name.length() - 1;
    while (i > 0) {
        if (name.charAt(i) == '.') {
            return name.substring(i + 1, name.length() - i - 1);
        }
        if (isSeparator(name.charAt(i))) {
            return "";
        }
        i = i - 1;
    }
    return "";
}

/// The name without its extension. `"a/b/c.txt"` becomes `"c"`.
pub fn stem(path: string): string {
    let name = fileName(path);
    let ext = extension(name);
    if (ext.length() == 0) {
        return name;
    }
    return name.substring(0, name.length() - ext.length() - 1);
}

/// Replaces the extension. An empty extension removes it.
pub fn withExtension(path: string, ext: string): string {
    let directory = parentDir(path);
    let base = stem(path);
    let renamed = if (ext.length() == 0) base else base + "." + ext;
    return if (directory.length() == 0) renamed else joinPath(directory, renamed);
}

/// Does the path start at the root? Recognises `/x` and `C:\x`.
pub fn isAbsolute(path: string): bool {
    if (path.length() == 0) {
        return false;
    }
    if (isSeparator(path.charAt(0))) {
        return true;
    }
    // A drive letter: 'C:' at the start.
    return path.length() >= 2 && path.charAt(1) == ':';
}
