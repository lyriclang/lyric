//! Tests and benchmarks: the assertions a test fails by ([assertEq], [assertTrue], [assertThrows],
//! [assertPanics] and the others, [fail]), [subtest], and the runners that `lyric test` ([run],
//! [TestCase]) and `lyric bench` ([runBenches], [BenchCase]) hand a package's tests and benchmarks
//! to. A test is a function marked `@Test` — no parameters, `void`, possibly throwing — in a
//! module of the package or under its `tests/`.
//!
//! An assertion that does not hold panics with what it got against what was expected, each as
//! `Debug` writes it, and names the expression it got it from: `xs.length() = 2, expected 3`. The
//! actual value comes first. Two values too long to compare by eye get their first difference
//! named below: a text's first line that differs, else the first character.

import std.core { Contains, StringBuilder, filled };
import std.fs { readText, writeText };
import std.io { flush, println };
import std.os { cpuCount, env };
import std.task { spawn, sleep, PanicInfo, TaskStatus, Cancelled, monotonicNanos };
import std.thread { Pool, Thread };
import std.sync { Atomic };
import std.time { Duration };

/// One test as `lyric test` hands it to [run]: its name — the module's path and the function's —,
/// its body, why it is skipped, if it is, how many seconds it may take, and whether it runs beside
/// the others that say so (`@Test { skip = "…", timeout = 10, parallel = true }`).
pub struct TestCase {
    pub name: string,
    pub body: fn() -> void throws Error,
    pub skip: string = "",
    pub timeout: int = 60,
    pub parallel: bool = false,
}

/// Ends the process at once — no handler runs, and nothing flushes what the console holds, so the
/// watchdog flushes first. The watchdog's way out of a test that does not stop.
extern "C" fn _exit(status: int32): void;

/// The running test, for the watchdog on a thread of its own: which — `together` while the
/// parallel ones run —, until when it may run — 0 while none does —, and how many seconds that is.
class Watch {
    current: Atomic<int> = Atomic<int>.new(-1),
    deadline: Atomic<int> = Atomic<int>.new(0),
    seconds: Atomic<int> = Atomic<int>.new(0),
}

/// What `Watch.current` holds while the parallel tests run.
let together = -2;

/// What the running test's subtests left: the name they are reported under, and how many
/// failed; `apart` is 1 while the parallel tests run, which have none.
class Subtests {
    var parent: string = "",
    var failed: int = 0,
    apart: Atomic<int> = Atomic<int>.new(0),
}

let watch = Watch { };

let subtests = Subtests { };

/// Whether `lyric test --json` asked for the JSON form: a line for each test,
/// `{"type":"test",…}`, and one for the count, `{"type":"tests",…}`, in place of the text.
let asJson = (env("LYRIC_TEST_FORMAT") ?? "") == "json";

/// Reports a test that held.
fn sayPassed(name: string): void {
    if (asJson) {
        event(name, "passed", "", "");
    } else {
        println(f"ok    {name}");
    }
}

/// Reports a skipped test, and why it was skipped.
fn saySkipped(name: string, why: string): void {
    if (asJson) {
        event(name, "skipped", why, "");
    } else {
        println(f"skip  {name}: {why}");
    }
}

/// Reports a test that did not hold: what ended it — a message's further lines under its first —,
/// the panic's code where a panic did, and its backtrace below.
fn sayFailed(name: string, detail: string, panic: string = "", trace: string = ""): void {
    if (asJson) {
        event(name, "failed", if (trace != "") detail + "\n" + trace else detail, panic);
    } else {
        println(f"FAIL  {name}");
        println(f"      {indented(detail)}");
        if (trace != "") {
            println(trace);
        }
    }
}

/// Writes one test's line of the JSON form.
fn event(name: string, outcome: string, message: string, panic: string): void {
    let line = StringBuilder.new();
    line.appendStr("{\"type\":\"test\",\"version\":1,\"name\":");
    quoted(line, name);
    line.appendStr(",\"outcome\":\"");
    line.appendStr(outcome);
    line.appendChar('"');
    if (message != "") {
        line.appendStr(",\"message\":");
        quoted(line, message);
    }
    if (panic != "") {
        line.appendStr(",\"panic\":");
        quoted(line, panic);
    }
    line.appendChar('}');
    println(line.toString());
}

/// Appends `s` to `out` as a JSON string — std.json's escaping, written here because importing
/// std.json would bring its codec into every test program the toolchain builds.
fn quoted(out: StringBuilder, s: string): void {
    out.appendChar('"');
    for (c in s.chars()) {
        if (c == '"') {
            out.appendStr("\\\"");
        } else if (c == '\\') {
            out.appendStr("\\\\");
        } else if (c == '\n') {
            out.appendStr("\\n");
        } else if (c == '\r') {
            out.appendStr("\\r");
        } else if (c == '\t') {
            out.appendStr("\\t");
        } else if ((c as uint32) < 0x20) {
            let code = (c as uint32) as int;
            let digit = code % 16;
            out.appendStr(if (code < 16) "\\u000" else "\\u001");
            out.appendChar(
                if (digit < 10) ((('0' as uint32) + (digit as uint32)) as char)
                    else ((('a' as uint32) + ((digit - 10) as uint32)) as char)
            );
        } else {
            out.appendChar(c);
        }
    }
    out.appendChar('"');
}

/// Runs the tests one after another, each in a task of its own: a panic or an error that leaves a
/// test fails it, and the run goes on. Those marked `parallel` run after the others, all at once.
/// It writes a line for each test once it has ended — what the test printed comes before —, then
/// the count. A test that outlives its time ends the run as a failure. Returns the program's exit
/// code: 0 when no test failed, 1 when one did.
pub fn run(cases: TestCase[]): int {
    let _ = Thread.spawn(() => try guard(cases));
    var passed = 0;
    var failed = 0;
    var skipped = 0;
    let apart = List<int>.new();
    for (i in 0..cases.length()) {
        let c = cases[i];
        if (c.skip != "") {
            saySkipped(c.name, c.skip);
            skipped += 1;
            continue;
        }
        if (c.parallel) {
            apart.push(i);
            continue;
        }
        subtests.parent = c.name;
        subtests.failed = 0;
        watch.current.store(i);
        watch.seconds.store(c.timeout);
        watch.deadline.store(deadlineAfter(c.timeout));
        let held = outcome(c.name, c.body);
        watch.deadline.store(0);
        if (held && subtests.failed == 0) {
            sayPassed(c.name);
            passed += 1;
        } else {
            if (held) {
                let noun = if (subtests.failed == 1) "subtest" else "subtests";
                sayFailed(c.name, f"{subtests.failed} {noun} failed");
            }
            failed += 1;
        }
    }
    if (!apart.isEmpty()) {
        let wrong = runApart(cases, apart);
        passed += apart.length() - wrong;
        failed += wrong;
    }
    let count = passed + failed + skipped;
    let noun = if (count == 1) "test" else "tests";
    if (asJson) {
        println(
            "{\"type\":\"tests\",\"version\":1,\"passed\":"
                + f"{passed}"
                + ",\"failed\":"
                + f"{failed}"
                + ",\"skipped\":"
                + f"{skipped}"
                + "}"
        );
    } else {
        println(f"\n{count} {noun}: {passed} passed, {failed} failed, {skipped} skipped");
    }
    return if (failed > 0) 1 else 0;
}

/// Runs the tests marked `parallel`, after the others: each a task on a pool of a thread for each
/// processor, all at once; their lines in their order, each once it has ended. One deadline covers
/// them all — the longest of their timeouts, from their start; none where one of them has none.
/// Returns the number that failed.
fn runApart(cases: TestCase[], chosen: List<int>): int {
    var longest = 0;
    var unbounded = false;
    for (i in chosen) {
        let t = cases[i].timeout;
        if (t <= 0) {
            unbounded = true;
        }
        if (t > longest) {
            longest = t;
        }
    }
    subtests.apart.store(1);
    watch.current.store(together);
    watch.seconds.store(longest);
    watch.deadline.store(if (unbounded) 0 else deadlineAfter(longest));
    let pool = Pool.new(cpuCount());
    let head = pool.spawn(cases[chosen[0]].body);
    let tasks = filled(chosen.length(), head);
    for (k in 1..chosen.length()) {
        tasks[k] = pool.spawn(cases[chosen[k]].body);
    }
    var failed = 0;
    for (k in 0..chosen.length()) {
        let name = cases[chosen[k]].name;
        var task = tasks[k];
        task.join();
        if (reported(name, task.status())) {
            sayPassed(name);
        } else {
            failed += 1;
        }
    }
    watch.deadline.store(0);
    subtests.apart.store(0);
    try? pool.close();
    return failed;
}

/// Returns the monotonic time `seconds` from now, when a test given them has outlived them; 0 for
/// no limit.
fn deadlineAfter(seconds: int): int {
    return if (seconds > 0) monotonicNanos() + seconds * 1000000000 else 0;
}

/// Runs `body` in a task of its own; where it does not hold, writes `FAIL` with the panic or the
/// error below it. Returns whether it held.
fn outcome(name: string, body: fn() -> void throws Error): bool {
    var task = spawn(body);
    task.join();
    return reported(name, task.status());
}

/// Reports how a test's task ended: `FAIL` with the panic or the error below it where it did not
/// hold — a message's further lines under its first. Returns whether it held.
fn reported(name: string, status: TaskStatus<void>): bool {
    var held = false;
    match (status) {
        TaskStatus.Done(_) => {
            held = true;
        }
        TaskStatus.Failed(e) => {
            sayFailed(name, f"error: {e.message()}");
        }
        TaskStatus.Panicked(p) => {
            sayFailed(name, f"panic [{p.code}]: {p.message}", p.code, p.trace);
        }
        TaskStatus.Cancelled => {
            sayFailed(name, "cancelled");
        }
        TaskStatus.Running => unreachable("a joined task has ended"),
    }
    return held;
}

/// Returns `message` with its lines after the first indented under it.
fn indented(message: string): string {
    return message.replace("\n", "\n      ");
}

/// Runs the watchdog: on a thread of its own, it checks every tenth of a second whether the
/// running test has outlived its time. One that has ends the run — it cannot be stopped from
/// outside, since a task gives way only where it waits.
fn guard(cases: TestCase[]): void throws Cancelled {
    while (true) {
        try sleep(Duration.ofMillis(100));
        let deadline = watch.deadline.load();
        if (deadline > 0 && monotonicNanos() > deadline) {
            let at = watch.current.load();
            let name = if (at >= 0) cases[at].name else "the parallel tests";
            sayFailed(name, f"timed out after {watch.seconds.load()} s — the run ends here");
            flush();
            _exit(1);
        }
    }
}

/// Runs a part of the running test, reported under its own name — `parent/name` — and run in a
/// task of its own, so the test goes on after one fails: a table-driven test, a row each. A failed
/// subtest fails the test.
///
/// # Panics
/// Fails the test when called from a parallel test, which has no subtests: it runs beside others,
/// and a subtest is reported under the one test that runs.
pub fn subtest(name: string, body: fn() -> void throws Error): void {
    if (subtests.apart.load() == 1) {
        fail(
            "a subtest is reported under its test, and a parallel test runs beside others: it has no subtests"
        );
    }
    let full = subtests.parent + "/" + name;
    if (outcome(full, body)) {
        sayPassed(full);
    } else {
        subtests.failed += 1;
    }
}

/// Fails the test unless `f` throws, and returns what it threw — of the type `f` says it throws —,
/// for the test to look at.
pub fn assertThrows<E :: [Error]>(f: fn() -> void throws E, message: string = ""): E {
    try {
        f();
    } catch (e: E) {
        return e;
    }
    fail(because("threw nothing, expected an error", message));
}

/// Fails the test unless `f`, run in a task of its own, panics; returns what the panic left.
pub fn assertPanics(f: fn() -> void throws Error, message: string = ""): PanicInfo {
    var task = spawn(f);
    task.join();
    return match (task.status()) {
        TaskStatus.Panicked(p) => p,
        TaskStatus.Failed(e) => fail(
            because("threw " + e.message() + ", expected a panic", message)
        ),
        _ => fail(because("ended, expected a panic", message)),
    };
}

/// Fails the test unless `actual` equals `expected`: `xs.length() = 2, expected 3` — the
/// expression the call wrote for `actual`, where it is not the value itself —, then `message`,
/// then, for values too long to compare by eye, their first difference.
pub fn assertEq<T :: [Equatable, Debug]>(
    actual: T,
    expected: T,
    message: string = "",
    @callerExpr(actual) written: string = ""
): void {
    if (!(actual == expected)) {
        let shown = actual.debug();
        let wanted = expected.debug();
        fail(
            because(got(written, shown) + ", expected " + wanted, message)
                + difference(shown, wanted)
        );
    }
}

/// Fails the test where `actual` equals `unexpected` — the assertion for "it changed", where
/// `assertEq` says "it is".
pub fn assertNotEq<T :: [Equatable, Debug]>(
    actual: T,
    unexpected: T,
    message: string = "",
    @callerExpr(actual) written: string = ""
): void {
    if (actual == unexpected) {
        fail(because(got(written, actual.debug()) + ", expected anything else", message));
    }
}

/// Fails the test unless `condition` holds.
pub fn assertTrue(
    condition: bool,
    message: string = "",
    @callerExpr(condition) written: string = ""
): void {
    if (!condition) {
        fail(because(got(written, "false") + ", expected true", message));
    }
}

/// Fails the test where `condition` holds.
pub fn assertFalse(
    condition: bool,
    message: string = "",
    @callerExpr(condition) written: string = ""
): void {
    if (condition) {
        fail(because(got(written, "true") + ", expected false", message));
    }
}

/// Fails the test where `value` is present.
pub fn assertNull<T :: [Debug]>(
    value: ?T,
    message: string = "",
    @callerExpr(value) written: string = ""
): void {
    if (let v = value) {
        fail(because(got(written, v.debug()) + ", expected null", message));
    }
}

/// Fails the test where `value` is absent; returns the value otherwise, for the test to go on with.
pub fn assertNotNull<T>(
    value: ?T,
    message: string = "",
    @callerExpr(value) written: string = ""
): T {
    return value ?? fail(because(got(written, "null") + ", expected a value", message));
}

/// Fails the test unless `actual` lies within `tolerance` of `expected` — the comparison
/// `assertEq` cannot make for floating point, where `0.1 + 0.2` is not `0.3`. NaN on either side
/// fails: it is close to nothing.
pub fn assertClose(
    actual: float,
    expected: float,
    tolerance: float,
    message: string = "",
    @callerExpr(actual) written: string = ""
): void {
    let gap = if (actual > expected) actual - expected else expected - actual;
    if (!(gap <= tolerance)) {
        fail(
            because(
                got(written, f"{actual}") + f", expected {expected} within {tolerance}",
                message
            )
        );
    }
}

/// Fails the test unless `actual` is less than `bound`.
pub fn assertLess<T :: [Ordered, Debug]>(
    actual: T,
    bound: T,
    message: string = "",
    @callerExpr(actual) written: string = ""
): void {
    if (!(actual < bound)) {
        fail(
            because(got(written, actual.debug()) + ", expected less than " + bound.debug(), message)
        );
    }
}

/// Fails the test unless `actual` is greater than `bound`.
pub fn assertGreater<T :: [Ordered, Debug]>(
    actual: T,
    bound: T,
    message: string = "",
    @callerExpr(actual) written: string = ""
): void {
    if (!(actual > bound)) {
        fail(
            because(
                got(written, actual.debug()) + ", expected greater than " + bound.debug(),
                message
            )
        );
    }
}

/// Fails the test unless `container` holds `x` — what `x in container` asks (`Contains`):
/// `assertContains("abc", 'b')`, `assertContains(xs, 3)`.
pub fn assertContains<T :: [Debug], C :: [Contains<T>, Debug]>(
    container: C,
    x: T,
    message: string = "",
    @callerExpr(container) written: string = ""
): void {
    if (!container.contains(x)) {
        fail(
            because(got(written, container.debug()) + ", expected to contain " + x.debug(), message)
        );
    }
}

/// Fails the test unless `c` holds nothing: its iterator gives no value — a list, a map, a set, an
/// array, a slice.
///
/// # Errors
/// Throws what the iterator of `c` throws — nothing, for the collections above.
pub fn assertEmpty<C :: [Iterable, Debug]>(
    c: C,
    message: string = "",
    @callerExpr(c) written: string = ""
): void throws C.Iter.Error {
    var walk = c.iter();
    if (try walk.next() != null) {
        fail(because(got(written, c.debug()) + ", expected nothing", message));
    }
}

/// Fails the test outright, with `message` — for a branch a test must not reach.
pub fn fail(message: string): never {
    panic(message);
}

/// Returns what an assertion got: `xs.length() = 2` where the call wrote an expression, `got 2`
/// where it wrote the value itself, or where no call's text reached it.
fn got(written: string, value: string): string {
    return if (written == "" || written == value) "got " + value else written + " = " + value;
}

/// Returns what an assertion found, followed by the test's own message where it gave one.
fn because(found: string, message: string): string {
    return if (message == "") found else found + ": " + message;
}

// ---------------------------------------------------------------------------------------------
// The first difference: over what `Debug` shows of the two values, since a value is compared as
// it is shown — a text's lines are its own, between the quotes, a break written `\n`.
// ---------------------------------------------------------------------------------------------

/// Returns where `actual` and `expected` — two values as `Debug` shows them — differ, for a
/// failure's message: for texts that break lines, the first line that differs, both as `Debug`
/// shows them; else, where the two are longer than 40 characters together, the first character
/// that differs, the two around it and a mark under it. The empty string for short ones, which
/// the message shows whole.
fn difference(actual: string, expected: string): string {
    let a = linesOfText(actual);
    let e = linesOfText(expected);
    if (a.length() > 1 || e.length() > 1) {
        var i = 0;
        while (i < a.length() && i < e.length() && a[i] == e[i]) {
            i += 1;
        }
        return f"\nline {i + 1}: {lineOf(a, i)}, expected {lineOf(e, i)}";
    }
    let ac = actual.chars().toArray();
    let ec = expected.chars().toArray();
    if (ac.length() + ec.length() <= 40) {
        return "";
    }
    var at = 0;
    while (at < ac.length() && at < ec.length() && ac[at] == ec[at]) {
        at += 1;
    }
    let from = if (at > 20) at - 20 else 0;
    let out = StringBuilder.new();
    out.appendStr(f"\nfirst difference at character {at + 1}:\n  ");
    windowTo(out, ac, from);
    out.appendStr("\n  ");
    windowTo(out, ec, from);
    out.appendStr("\n  ");
    // the ellipsis before a cut window takes a column of its own
    var pad = at - from + (if (from > 0) 1 else 0);
    while (pad > 0) {
        out.appendChar(' ');
        pad -= 1;
    }
    out.appendChar('^');
    return out.toString();
}

/// Appends up to 40 characters of `cs` from `from` on, with an ellipsis where they are cut.
fn windowTo(out: StringBuilder, cs: char[], from: int): void {
    if (from > 0) {
        out.appendChar('…');
    }
    let to = if (cs.length() - from > 40) from + 40 else cs.length();
    for (i in from..to) {
        out.appendChar(cs[i]);
    }
    if (to < cs.length()) {
        out.appendChar('…');
    }
}

/// Returns line `i` of `lines` in quotes, or `no line` past their end.
fn lineOf(lines: List<string>, i: int): string {
    return if (i < lines.length()) "\"" + lines[i] + "\"" else "no line";
}

/// Returns the lines of a text as `Debug` shows it — between quotes, a break written `\n` —, each
/// as shown; anything else is one line, the whole.
fn linesOfText(shown: string): List<string> {
    let lines = List<string>.new();
    let cs = shown.chars().toArray();
    let n = cs.length();
    if (n < 2 || cs[0] != '"' || cs[n - 1] != '"') {
        lines.push(shown);
        return lines;
    }
    var line = StringBuilder.new();
    var i = 1;
    while (i < n - 1) {
        let c = cs[i];
        if (c == '\\' && i + 2 < n) {
            if (cs[i + 1] == 'n') {
                lines.push(line.toString());
                line = StringBuilder.new();
            } else {
                line.appendChar(c);
                line.appendChar(cs[i + 1]);
            }
            i += 2;
        } else {
            line.appendChar(c);
            i += 1;
        }
    }
    lines.push(line.toString());
    return lines;
}

// ---------------------------------------------------------------------------------------------
// Benchmarks: what `lyric bench` hands a package's `@Bench` functions to.
// ---------------------------------------------------------------------------------------------

/// One benchmark as `lyric bench` hands it to [runBenches]: its name — the module's path and the
/// function's — and its body, handed a bench to measure through.
pub struct BenchCase {
    pub name: string,
    pub body: fn(&Bench) -> void,
}

/// Runs the benchmarks one after another on this thread, each with a bench of its own, and writes
/// a line for each: the nanoseconds per run, its allocations and their bytes, the megabytes per
/// second where the bench said how many bytes a run handles, and the runs measured. Where `compare`
/// names a file an earlier run saved, each line also says how the time per run changed against
/// it; where `save` names one, this run writes it — a line per benchmark: its name, then the
/// nanoseconds, the allocations and the bytes per run, separated by tabs. Returns the program's
/// exit code: 0, or 1 where such a file could not be read or written.
pub fn runBenches(cases: BenchCase[], save: string = "", compare: string = ""): int {
    let before = Map<string, float>.new();
    if (compare != "") {
        let text = try readText(compare) catch (e) {
            println(f"error: {e.message()}");
            return 1;
        };
        for (line in text.lines()) {
            let parts = line.split('\t').toArray();
            if (parts.length() >= 2) {
                before[parts[0].toString()] = try float.parse(parts[1]) catch (_) 0.0;
            }
        }
    }
    let saved = StringBuilder.new();
    for (c in cases) {
        var b = Bench { };
        let body = c.body;
        body(&b);
        let ns = b.nanosPerRun();
        let allocations = if (b.runs > 0) b.allocations / b.runs else 0;
        let bytes = if (b.runs > 0) b.allocatedBytes / b.runs else 0;
        let out = StringBuilder.new();
        out.appendStr(f"bench {c.name}: {ns:.1f} ns/op, {allocations} allocs/op, {bytes} B/op");
        if (b.bytesPerRun > 0 && ns > 0.0) {
            out.appendStr(f", {(b.bytesPerRun as float) * 1000.0 / ns:.1f} MB/s");
        }
        out.appendStr(f" ({b.runs} runs)");
        if (let was = before.get(c.name)) {
            if (was > 0.0) {
                out.appendStr(f", was {was:.1f} ns/op: {(ns - was) * 100.0 / was:+.1f}%");
            }
        }
        println(out.toString());
        saved.appendStr(f"{c.name}\t{ns:.3f}\t{allocations}\t{bytes}\n");
    }
    if (save != "") {
        try {
            writeText(save, saved.toString());
        } catch (e) {
            println(f"error: {e.message()}");
            return 1;
        }
    }
    return 0;
}
