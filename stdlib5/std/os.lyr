/// The program and the operating system it runs on: the arguments ([args]), the environment
/// ([env], [envs], [setEnv]), the working directory ([cwd], [setCwd]), ending the program
/// ([exit]), facts about the machine ([platform], [arch], [hostname], [cpuCount], [pid],
/// [homeDir], [tempDir]), and the system's signals ([Signal], [signals]). A signal's watcher is a
/// thread of its own, whose one task hands each caught signal on.
import std.collections { List, Map };
import std.io { IoError, failure };
import std.task { Channel, here, Scheduler, SpinLock };
import std.thread { Thread, processorCount };

/// The system and machine kinds, defined in std.core beside the build's `target`.
pub import std.core { Platform, Arch };

// ---------------------------------------------------------------------------------------------
// The program and its system. A text comes from the runtime through a buffer (lyr/os.h); one that
// is not UTF-8 — a POSIX system's bytes may be anything — is taken with U+FFFD for its bad bytes,
// as `string.fromUtf8Lossy` takes it, so a program does not die of its environment.
// ---------------------------------------------------------------------------------------------

/// Returns the program's arguments, its own name first; a new array each call. On Windows they are
/// read from the command line as UTF-16, so a name that is not ASCII comes as it was typed.
pub fn args(): string[] {
    let count = osArgCount();
    var all: List<string> = List.new();
    for (i in 0..count) {
        all.push(textOf((into) => osArg(i, into)) ?? "");
    }
    return all.toArray();
}

/// Returns the value of the environment variable `name`, or `null` where it is not set.
pub fn env(name: StringView): ?string {
    let key = name.toString();
    return textOf((into) => osEnv(key, into));
}

/// Returns a snapshot of the whole environment, mapping names to values.
pub fn envs(): Map<string, string> {
    let all: Map<string, string> = Map.new();
    let (bytes, length) = viewOf((into) => osEnvs(into));
    let block = bytes[..length];
    var at = 0;
    while (at < block.length()) {
        let end = at + (block[at..].indexOf(0u8) ?? (block.length() - at));
        let entry = block[at..end];
        // the name ends at the first '=' after its first byte (Windows' own entries begin with one)
        if (let eq = entry[1..].indexOf(61u8)) {
            let _ = all.insert(
                string.fromUtf8Lossy(entry[..(eq + 1)]),
                string.fromUtf8Lossy(entry[(eq + 2)..])
            );
        }
        at = end + 1;
    }
    return all;
}

/// Sets the environment variable `name` to `value`, for this process and the processes it starts.
/// Another thread reading the environment through C at the same time is a race the system does not
/// guard against: set variables before the threads start.
///
/// # Panics
/// Panics when `name` is empty or holds `=` or a NUL, when `value` holds a NUL, and when the
/// system refuses the change.
pub fn setEnv(name: StringView, value: StringView): void {
    let key = name.toString();
    if (key.isEmpty() || key.contains('=') || key.contains('\0') || value.contains('\0')) {
        panic(
            f"os.setEnv: '{key}' cannot be an environment variable's name, or its value holds a NUL"
        );
    }
    let answer = osSetEnv(key, value.toString());
    if (answer < 0) {
        panic(f"os.setEnv: {failure(answer, null, f"{key} set").message()}");
    }
}

/// Returns the working directory.
///
/// # Errors
/// Throws [IoError] when the system cannot report it.
pub fn cwd(): string throws IoError {
    return try textFrom("the working directory looked up", (into) => osCwd(into));
}

/// Makes `path` the working directory.
///
/// # Errors
/// Throws [IoError] when the system refuses, for example for a path that does not exist.
pub fn setCwd(path: StringView): void throws IoError {
    let dir = path.toString();
    let answer = osSetCwd(dir);
    if (answer < 0) {
        throw failure(answer, dir, "made the working directory");
    }
}

/// Ends the program at once with exit code `code`: what the console holds is written, but no
/// `defer` or `using` runs and no other task is waited for.
pub fn exit(code: int): never {
    osExit(code);
}

/// Returns the system the program runs on.
pub fn platform(): Platform {
    return match (osPlatform()) {
        1 => .Linux,
        2 => .MacOS,
        3 => .Windows,
        _ => .Other,
    };
}

/// Returns the machine architecture the program runs on.
pub fn arch(): Arch {
    return match (osArch()) {
        1 => .X86_64,
        2 => .Aarch64,
        _ => .Other,
    };
}

/// Returns the user's home directory — `HOME`, on Windows `USERPROFILE` —, or `null` where it is
/// not set or empty.
pub fn homeDir(): ?string {
    if (let home = env(if (osPlatform() == 3) "USERPROFILE" else "HOME")) {
        if (!home.isEmpty()) {
            return home;
        }
    }
    return null;
}

/// Returns the system's directory for temporary files: `TMPDIR` where it is set and not empty,
/// else `/tmp`; on Windows the one `GetTempPathW` reports. `fs.tempDir()` makes a new directory
/// in it.
///
/// # Panics
/// Panics when the runtime cannot report the directory.
pub fn tempDir(): string {
    try {
        return textFrom("the directory for temporary files looked up", (into) => osTempRoot(into));
    } catch (e: IoError) {
        panic(f"os.tempDir: {e.message()}");
    }
}

/// Returns the machine's name.
///
/// # Errors
/// Throws [IoError] when the system cannot report it.
pub fn hostname(): string throws IoError {
    return try textFrom("the machine's name looked up", (into) => osHostname(into));
}

/// Returns the number of processors online for the program, at least one.
pub fn cpuCount(): int {
    return processorCount();
}

/// Returns the process's id.
pub fn pid(): int {
    return osPid();
}

/// Returns the text the runtime writes into a buffer (lyr/os.h), and throws its failure.
fn textFrom(doing: string, call: fn(Slice<uint8>) -> int): string throws IoError {
    let (bytes, length) = try bytesFrom(doing, call);
    return string.fromUtf8Lossy(bytes[..length]);
}

/// Returns the text the runtime writes into a buffer, or `null` for any failure — a variable not
/// set, an argument that is not there.
fn textOf(call: fn(Slice<uint8>) -> int): ?string {
    try {
        return textFrom("read", call);
    } catch (_: IoError) {
        return null;
    }
}

/// Returns the bytes the runtime writes into a buffer and how many, none for a failure.
fn viewOf(call: fn(Slice<uint8>) -> int): (uint8[], int) {
    try {
        return bytesFrom("read", call);
    } catch (_: IoError) {
        let none: uint8[] = [];
        return (none, 0);
    }
}

/// Returns the bytes the runtime writes into a buffer, and how many. Where the buffer is too small
/// the runtime answers the room it needs, and the call is repeated with that much.
fn bytesFrom(doing: string, call: fn(Slice<uint8>) -> int): (uint8[], int) throws IoError {
    var room = 512;
    loop {
        let buffer: uint8[] = [0u8] * room;
        let answer = call(buffer[..]);
        if (answer < 0) {
            throw failure(answer, null, doing);
        }
        if (answer <= room) {
            return (buffer, answer);
        }
        room = answer;
    }
}

fn osPlatform(): int;
fn osArch(): int;
fn osPid(): int;
fn osArgCount(): int;
fn osArg(i: int, into: Slice<uint8>): int;
fn osEnv(name: string, into: Slice<uint8>): int;
fn osEnvs(into: Slice<uint8>): int;
fn osSetEnv(name: string, value: string): int;
fn osCwd(into: Slice<uint8>): int;
fn osSetCwd(path: string): int;
fn osHostname(into: Slice<uint8>): int;
fn osExit(code: int): never;
fn osTempRoot(into: Slice<uint8>): int;

// ---------------------------------------------------------------------------------------------
// The signals.
// ---------------------------------------------------------------------------------------------

/// A signal of the system, by an abstract name: Windows knows only `Interrupt` (Ctrl+C,
/// Ctrl+Break) and `Terminate` (its console closes). `Other(n)` is the system's number `n`.
pub enum Signal {
    Interrupt,
    Terminate,
    Hangup,
    Quit,
    User1,
    User2,
    WindowChange,
    Other(int),
}

/// Returns a channel the given signals arrive on: from now on they no longer do what the system
/// does with them — mostly end the program — but arrive here. Each comes to every channel that
/// asked for it. Signals are not counted: two that come before the first was delivered may arrive
/// as one, and one that finds the channel's buffer of sixteen full is lost for that channel.
/// Closing the channel ends the subscription at once: a signal no channel asks for any more gets
/// the system's handling again from then on. KILL, STOP and the faults never arrive.
pub fn signals(wanted: Signal...): Channel<Signal> {
    let channel = Channel<Signal>.new(16);
    var mask = 0;
    for (i in 0..wanted.length()) {
        let n = numberOf(wanted[i]);
        if (n >= 1 && n <= 63) {
            mask = mask | (1 << (n - 1));
        }
    }
    if (mask != 0) {
        signalHub.subscribe(channel, mask);
        // Closed, the channel ends its subscription at once: a signal that comes after the close
        // gets the system's handling again, not swallowed by a watcher that finds the channel
        // closed.
        channel.closer = () => {
            signalHub.unsubscribe(channel);
        };
    }
    return channel;
}

/// A channel's subscription to signals: the bits of their numbers.
class Subscription {
    channel: Channel<Signal>,
    mask: int,
    var next: ?Subscription = null,
}

/// The subscriptions to signals and their watcher: a thread whose one task hands each caught signal
/// to the channels that asked for it — the runtime's handler never runs Lyric code (lyr/signal.h).
class SignalHub {
    guard: SpinLock = SpinLock { },
    var first: ?Subscription = null,
    var caught: int = 0,
    var watching: bool = false,

    /// Subscribes `channel` to the signals of `mask`; the first subscription starts the watcher.
    mut fn subscribe(channel: Channel<Signal>, mask: int): void {
        this.guard.acquire();
        this.first = Subscription { channel = channel, mask = mask, next = this.first };
        let added = mask & ~this.caught;
        this.caught = this.caught | mask;
        let start = !this.watching;
        this.watching = true;
        this.guard.release();
        catchAll(added, true);
        if (start) {
            let _ = Thread.spawn(
                () => {
                    signalHub.watch();
                }
            );
        }
    }

    /// Ends the subscription of `channel`, which was closed; a signal no channel asks for any more
    /// gets the system's handling again.
    mut fn unsubscribe(channel: Channel<Signal>): void {
        this.guard.acquire();
        var before: ?Subscription = null;
        var at = this.first;
        var still = 0;
        while (let sub = at) {
            at = sub.next;
            if (same(sub.channel, channel)) {
                if (let b = before) {
                    b.next = sub.next;
                } else {
                    this.first = sub.next;
                }
            } else {
                still = still | sub.mask;
                before = sub;
            }
        }
        let dropped = this.caught & ~still;
        this.caught = still;
        this.guard.release();
        catchAll(dropped, false);
    }

    /// Runs the watcher's loop: delivers what was caught, then waits for more.
    mut fn watch(): void {
        attachSignals();
        let s = here();
        while (true) {
            let caught = takeSignals();
            if (caught == 0) {
                s.awaitPoller();
            } else {
                this.deliver(s, caught);
            }
        }
    }

    /// Delivers each signal of `caught` to every channel that asked for it, where it has room; a
    /// closed channel's subscription ends, and a signal no channel asks for any more gets the
    /// system's handling again.
    mut fn deliver(s: Scheduler, caught: int): void {
        this.guard.acquire();
        var before: ?Subscription = null;
        var at = this.first;
        var still = 0;
        while (let sub = at) {
            at = sub.next;
            var open = true;
            var bits = caught & sub.mask;
            var n = 1;
            while (bits != 0 && open) {
                if ((bits & 1) != 0) {
                    open = sub.channel.offer(s, signalOf(n)) >= 0;
                }
                bits = bits >> 1;
                n += 1;
            }
            if (open) {
                still = still | sub.mask;
                before = sub;
            } else if (let b = before) {
                b.next = sub.next;
            } else {
                this.first = sub.next;
            }
        }
        let dropped = this.caught & ~still;
        this.caught = still;
        this.guard.release();
        catchAll(dropped, false);
    }
}

let signalHub = SignalHub { };

/// Turns the runtime's handler on, or off, for each signal of `mask`.
fn catchAll(mask: int, on: bool): void {
    var bits = mask;
    var n = 1;
    while (bits != 0) {
        if ((bits & 1) != 0) {
            catchSignal(n, on);
        }
        bits = bits >> 1;
        n += 1;
    }
}

/// Returns the system's number of a signal; -1 where it has none.
fn numberOf(signal: Signal): int {
    return match (signal) {
        Signal.Interrupt => signalNumber(0),
        Signal.Terminate => signalNumber(1),
        Signal.Hangup => signalNumber(2),
        Signal.Quit => signalNumber(3),
        Signal.User1 => signalNumber(4),
        Signal.User2 => signalNumber(5),
        Signal.WindowChange => signalNumber(6),
        Signal.Other(n) => n,
    };
}

/// Returns the signal with the system's number `number`.
fn signalOf(number: int): Signal {
    return match (signalKind(number)) {
        0 => Signal.Interrupt,
        1 => Signal.Terminate,
        2 => Signal.Hangup,
        3 => Signal.Quit,
        4 => Signal.User1,
        5 => Signal.User2,
        6 => Signal.WindowChange,
        _ => Signal.Other(number),
    };
}

/// Signals (lyr/signal.h): the system's number of an abstract signal and back — -1 where it has
/// none —; the handler on or off — false where the runtime may not catch it —; this thread as the
/// watcher, whose poller a caught signal wakes; the caught ones as a mask, taken.
fn signalNumber(kind: int): int;
fn signalKind(number: int): int;
fn catchSignal(number: int, on: bool): bool;
fn attachSignals(): void;
fn takeSignals(): int;
