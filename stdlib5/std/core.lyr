    }
}

extend uint16 :: [Num, Integer] {
    static let zero: uint16 = 0;
    static let one: uint16 = 1;
    static let min: uint16 = 0;
    static let max: uint16 = 65535;
    static let bitWidth: int = 16;
    static let isSigned: bool = false;

    /// The decimal integer a text names (`Parse`).
    static fn parse(s: StringView): uint16 throws ParseError {
        return try parseInteger(s, 10);
    }

    /// The integer a text names in `radix`, 2…36.
    static fn parse(s: StringView, radix: int): uint16 throws ParseError {
        return try parseInteger(s, radix);
    }

    /// `v` as an `uint16` where it fits, `null` where it does not (10 B5 Z4).
    static fn exact<T :: [Integer]>(v: T): ?uint16 {
        return exactly(v);
    }

    /// `v` as an `uint16`, held at `min` or `max` where it does not fit.
    static fn clamping<T :: [Integer]>(v: T): uint16 {
        return clamped(v);
    }
}

extend uint32 :: [Num, Integer] {
    static let zero: uint32 = 0;
    static let one: uint32 = 1;
    static let min: uint32 = 0;
    static let max: uint32 = 4294967295;
    static let bitWidth: int = 32;
    static let isSigned: bool = false;

    /// The decimal integer a text names (`Parse`).
    static fn parse(s: StringView): uint32 throws ParseError {
        return try parseInteger(s, 10);
    }

    /// The integer a text names in `radix`, 2…36.
    static fn parse(s: StringView, radix: int): uint32 throws ParseError {
        return try parseInteger(s, radix);
    }

    /// `v` as an `uint32` where it fits, `null` where it does not (10 B5 Z4).
    static fn exact<T :: [Integer]>(v: T): ?uint32 {
        return exactly(v);
    }

    /// `v` as an `uint32`, held at `min` or `max` where it does not fit.
    static fn clamping<T :: [Integer]>(v: T): uint32 {
        return clamped(v);
    }
}

extend float :: [Num, Signed, Float] {
    static let zero: float = 0.0;
    static let one: float = 1.0;
    static let epsilon: float = 2.220446049250313e-16;
    static let infinity: float = float.fromBits(0x7FF0000000000000);
    static let nan: float = float.fromBits(0x7FF8000000000000);
    static let min: float = -1.7976931348623157e308;
    static let max: float = 1.7976931348623157e308;
    static let leastPositive: float = 5e-324;

    static fn fromBits(b: uint64): float {
        return floatFromBits(b, float.zero);
    }

    /// The float a text names, the nearest one (`Parse`).
    static fn parse(s: StringView): float throws ParseError {
        try checkFloatText(s);
        return floatOfText(s.toString());
    }
}

extend float32 :: [Num, Signed, Float] {
    static let zero: float32 = 0.0;
    static let one: float32 = 1.0;
    static let epsilon: float32 = 1.1920928955078125e-7;
    static let infinity: float32 = float32.fromBits(0x7F800000);
    static let nan: float32 = float32.fromBits(0x7FC00000);
    static let min: float32 = -3.4028234663852886e38;
    static let max: float32 = 3.4028234663852886e38;
    static let leastPositive: float32 = 1.401298464324817e-45;

    static fn fromBits(b: uint64): float32 {
        return floatFromBits(b, float32.zero);
    }

    /// The float a text names, the nearest one (`Parse`).
    static fn parse(s: StringView): float32 throws ParseError {
        try checkFloatText(s);
        return float32OfText(s.toString());
    }
}

// ---------------------------------------------------------------------------------------------
// Parsing (design/v5/spec/10 B3, B4, B5 Z6): a value read from a text, and what is wrong with the
// text thrown — the text is the data's, so it never panics. An integer is read here in Lyric over
// the string's bytes; a float's form is checked here and its value read by C, correctly rounded.
// ---------------------------------------------------------------------------------------------

/// Why a text is not a value of the type.
pub enum ParseErrorKind :: [Equatable, Debug] { Empty, Invalid, Overflow }

/// What `parse` throws (10 B3): the text was empty, was not of the type's form, or named a number
/// beyond the type's range.
pub struct ParseError :: [Error] {
    /// Why.
    pub kind: ParseErrorKind,
    /// What the parser can say beyond the kind — what it expected where it stopped —; empty where
    /// it says nothing (the number parsers), filled by `Uri.parse`, the address parsers and the
    /// time parsers (design 10 B3; the review of M10, M14).
    pub detail: string = "",
    /// The byte offset in the text the refusal points at, where the parser knows one.
    pub offset: ?int = null,

    pub fn message(): string {
        var text = match (this.kind) {
            .Empty => "cannot parse a value from an empty text",
            .Invalid => "the text is not a value of the type",
            .Overflow => "the number is beyond the type's range",
        };
        if (!this.detail.isEmpty()) {
            text = f"{text}: {this.detail}";
        }
        if (let at = this.offset) {
            text = f"{text} (at byte {at})";
        }
        return text;
    }
}

/// A type read from a text: `T.parse(s)`, throwing `ParseError` with the reason. The number types
/// conform through `Num`, and `bool`.
pub interface Parse {
    static fn parse(s: StringView): Self throws ParseError;
}

extend bool :: [Parse] {
    /// `true` or `false`, exactly.
    static fn parse(s: StringView): bool throws ParseError {
        if (s == "true") {
            return true;
        }
        if (s == "false") {
            return false;
        }
        throw ParseError { kind = if (s == "") ParseErrorKind.Empty else ParseErrorKind.Invalid };
    }
}

/// The integer a text names in `radix` (10 B5 Z6): an optional `+` or `-`, ASCII digits, `_`
/// between two of them, nothing else. A radix outside 2…36 is the program's error and panics (B3).
/// A byte outside the form is `Invalid` however many digits run before it — only a well-formed
/// number is an `Overflow`. Negative numbers accumulate downward, so `min` is reached.
fn parseInteger<T :: [Integer]>(s: StringView, radix: int): T throws ParseError {
    if (radix < 2 || radix > 36) {
        panic(f"radix {radix} is outside 2..36");
    }
    let n = byteCount(s);
    if (n == 0) {
        throw ParseError { kind = ParseErrorKind.Empty };
    }
    let negative = byteAt(s, 0) == 45;
    var i = if (negative || byteAt(s, 0) == 43) 1 else 0;
    if (i == n || (negative && !T.isSigned)) {
        throw ParseError { kind = ParseErrorKind.Invalid };
    }
    let base = asTypeOf(radix, T.zero);
    var value = T.zero;
    var overflowed = false;
    var afterDigit = false;
    while (i < n) {
        let b = byteAt(s, i);
        i = i + 1;
        if (b == 95) {
            if (!afterDigit || i == n) {
                throw ParseError { kind = ParseErrorKind.Invalid };
            }
            afterDigit = false;
            continue;
        }
        let d = digitValue(b);
        if (d >= radix) {
            throw ParseError { kind = ParseErrorKind.Invalid };
        }
        afterDigit = true;
        if (!overflowed) {
            let digit = asTypeOf(d, T.zero);
            let scaled = value.checkedMul(base);
            if (scaled == null) {
                overflowed = true;
            } else {
                let next = if (negative) scaled.checkedSub(digit) else scaled.checkedAdd(digit);
                if (next == null) {
                    overflowed = true;
                } else {
                    value = next;
                }
            }
        }
    }
    if (overflowed) {
        throw ParseError { kind = ParseErrorKind.Overflow };
    }
    return value;
}

/// `v` in `U` where it fits, `null` where it does not (10 B5 Z4): converted as `as` wraps, it
/// fits exactly when it comes back the same and keeps its sign.
fn exactly<T :: [Integer], U :: [Integer]>(v: T): ?U {
    let w = asTypeOf(v, U.zero);
    if (asTypeOf(w, v) != v || (v < T.zero) != (w < U.zero)) {
        return null;
    }
    return w;
}

/// `v` in `U`, held at `U.min` or `U.max` where it does not fit.
fn clamped<T :: [Integer], U :: [Integer]>(v: T): U {
    let w: ?U = exactly(v);
    return w ?? (if (v < T.zero) U.min else U.max);
}

/// A byte's value as a digit — `0`…`9`, then `a`…`z` or `A`…`Z` for 10…35 — and 36 for any other.
fn digitValue(b: int): int {
    if (b >= 48 && b <= 57) {
        return b - 48;
    }
    if (b >= 97 && b <= 122) {
        return b - 87;
    }
    if (b >= 65 && b <= 90) {
        return b - 55;
    }
    return 36;
}

/// Whether a byte is an ASCII digit.
fn isDigit(b: int): bool {
    return b >= 48 && b <= 57;
}

/// A float's form (10 B5 Z6), thrown where the text is not of it: an optional sign, then `inf`,
/// `nan`, or digits with an optional `.` and fraction — one digit at least — and an optional
/// exponent, `e` or `E` with its own sign and digits; `_` between two digits, nothing else.
fn checkFloatText(s: StringView): void throws ParseError {
    let n = byteCount(s);
    if (n == 0) {
        throw ParseError { kind = ParseErrorKind.Empty };
    }
    var i = if (byteAt(s, 0) == 43 || byteAt(s, 0) == 45) 1 else 0;
    if (n - i == 3 && (isWord(s, i, 105, 110, 102) || isWord(s, i, 110, 97, 110))) {
        return;
    }
    var digits = 0;
    var point = false;
    var afterDigit = false;
    while (i < n) {
        let b = byteAt(s, i);
        if (isDigit(b)) {
            digits = digits + 1;
            afterDigit = true;
        } else if (b == 95 && afterDigit && i + 1 < n && isDigit(byteAt(s, i + 1))) {
            afterDigit = false;
        } else if (b == 46 && !point) {
            point = true;
            afterDigit = false;
        } else {
            break;
        }
        i = i + 1;
    }
    if (digits == 0) {
        throw ParseError { kind = ParseErrorKind.Invalid };
    }
    if (i == n) {
        return;
    }
    if (byteAt(s, i) != 101 && byteAt(s, i) != 69) {
        throw ParseError { kind = ParseErrorKind.Invalid };
    }
    i = i + 1;
    if (i < n && (byteAt(s, i) == 43 || byteAt(s, i) == 45)) {
        i = i + 1;
    }
    var exponent = 0;
    afterDigit = false;
    while (i < n) {
        let b = byteAt(s, i);
        if (isDigit(b)) {
            exponent = exponent + 1;
            afterDigit = true;
        } else if (b == 95 && afterDigit && i + 1 < n && isDigit(byteAt(s, i + 1))) {
            afterDigit = false;
        } else {
            throw ParseError { kind = ParseErrorKind.Invalid };
        }
        i = i + 1;
    }
    if (exponent == 0) {
        throw ParseError { kind = ParseErrorKind.Invalid };
    }
}

/// Whether the three bytes at `i` are `a`, `b`, `c`.
fn isWord(s: StringView, i: int, a: int, b: int, c: int): bool {
    return byteAt(s, i) == a && byteAt(s, i + 1) == b && byteAt(s, i + 2) == c;
}

// The natives the text stands on: a view's length and bytes (10 S1), which a string gives at the
// argument; a number converted as `as` converts it (03 T1d) to the type of `like` where that is a
// parameter's; a float's text read by C (`strtod`, `strtof`) once its form is checked.
fn byteCount(s: StringView): int;
fn byteAt(s: StringView, i: int): int;
/// Whether `p`'s bytes stand in `s` from byte `at` on — memcmp; false where they would run past it.
fn viewMatchesAt(s: StringView, p: StringView, at: int): bool;
/// Byte by byte, as `memcmp` and then the length: -1, 0 or 1.
fn compareBytes(a: string, b: string): int;
/// The bytes from..to as a string; out of bounds or off a character's boundary, a panic.
fn byteSlice(s: string, from: int, to: int): string;
/// A string of the array's first `count` bytes.
fn stringOfBytes(bytes: uint8[], count: int): string;
// --- strings (10 B9 S1–S3) ----------------------------------------------------------------------
// UTF-8, immutable, the length in bytes. The members stand once on `StringView` (S1), which a
// string reaches through a view of all of itself (M8a S12): what cuts gives a view, no copy; what
// builds gives a string. The search takes a `Pattern` (S2): a view or a string, a character, a
// test of characters.

extend string :: [Ordered, TotalOrder] {
    /// Byte by byte (S1), which is the order of the code points.
    fn compare(o: string): ?Ordering {
        return this.totalCompare(o);
    }

    fn totalCompare(o: string): Ordering {
        let c = compareBytes(this, o);
        if (c < 0) {
            return Ordering.Less;
        }
        if (c > 0) {
            return Ordering.Greater;
        }
        return Ordering.Equal;
    }
}

extend string {
    /// The length in bytes, `O(1)` (S1); `charCount()` counts the characters.
    pub fn length(): int {
        return byteCount(this);
    }

    /// Whether it has no byte.
    pub fn isEmpty(): bool {
        return byteCount(this) == 0;
    }
}

/// What a text is searched for (10 S2): a view or a string, a character, a test of characters.
/// One signature per operation takes any of them (D4: no overloading by type) — `contains(p)`,
/// `split(p)`, `stripPrefix(p)` … Two primitives, over byte indices of `text`: a match that begins
/// at `at`, its end; a match that ends at `end`, its start — `null` where there is none. `at` and
/// `end` are a character's first byte or the text's length. A third, `nextIn`, finds where the next
/// match begins; its default walks the first bytes with `matchAt`, and a pattern that can find
/// faster — a view, a string — says so.
pub interface Pattern {
    fn matchAt(text: StringView, at: int): ?int;
    fn matchBefore(text: StringView, end: int): ?int;

    /// The first byte at or after `from` — a character's first byte or the length — where a
    /// match begins, or `null`.
    fn nextIn(text: StringView, from: int): ?int {
        let n = byteCount(text);
        var at = from;
        while (at <= n) {
            if (this.matchAt(text, at) != null) {
                return at;
            }
            at = nextChar(text, at);
        }
        return null;
    }
}

/// A view's bytes, where they stand.
extend StringView :: [Pattern] {
    fn matchAt(text: StringView, at: int): ?int {
        if (viewMatchesAt(text, this, at)) {
            return at + byteCount(this);
        }
        return null;
    }

    fn matchBefore(text: StringView, end: int): ?int {
        let start = end - byteCount(this);
        if (viewMatchesAt(text, this, start)) {
            return start;
        }
        return null;
    }

    fn nextIn(text: StringView, from: int): ?int {
        let last = byteCount(text) - byteCount(this);
        var at = from;
        while (at <= last) {
            if (viewMatchesAt(text, this, at)) {
                return at;
            }
            at = at + 1;
        }
        return null;
    }
}

/// A string's bytes, as its view's (a constraint is no coercion site: the string conforms itself).
extend string :: [Pattern] {
    fn matchAt(text: StringView, at: int): ?int {
        if (viewMatchesAt(text, this, at)) {
            return at + byteCount(this);
        }
        return null;
    }

    fn matchBefore(text: StringView, end: int): ?int {
        let start = end - byteCount(this);
        if (viewMatchesAt(text, this, start)) {
            return start;
        }
        return null;
    }

    fn nextIn(text: StringView, from: int): ?int {
        let last = byteCount(text) - byteCount(this);
        var at = from;
        while (at <= last) {
            if (viewMatchesAt(text, this, at)) {
                return at;
            }
            at = at + 1;
        }
        return null;
    }
}

/// A test of characters: the character where it holds (05 §13 rule 6: a function type's block).
extend fn(char) -> bool :: [Pattern] {
    fn matchAt(text: StringView, at: int): ?int {
        if (at >= byteCount(text)) {
            return null;
        }
        let c = charOfView(text, at);
        if (!this(c)) {
            return null;
        }
        return at + utf8Width(c);
    }

    fn matchBefore(text: StringView, end: int): ?int {
        if (end <= 0) {
            return null;
        }
        let start = previousChar(text, end);
        if (!this(charOfView(text, start))) {
            return null;
        }
        return start;
    }
}

/// The character, where it stands.
extend char :: [Pattern] {
    fn matchAt(text: StringView, at: int): ?int {
        if (at >= byteCount(text) || charOfView(text, at) != this) {
            return null;
        }
        return at + utf8Width(this);
    }

    fn matchBefore(text: StringView, end: int): ?int {
        if (end <= 0) {
            return null;
        }
        let start = previousChar(text, end);
        if (charOfView(text, start) != this) {
            return null;
        }
        return start;
    }
}

/// The first byte of the character after the one at `at` — or one past the length, where `at`
/// is the length: a walk over the characters' first bytes ends there.
fn nextChar(text: StringView, at: int): int {
    let n = byteCount(text);
    var i = at + 1;
    while (i < n && (byteAt(text, i) & 192) == 128) {
        i = i + 1;
    }
    return i;
}

/// The first byte of the character that ends at `end` — -1 at the start.
fn previousChar(text: StringView, end: int): int {
    var i = end - 1;
    while (i > 0 && (byteAt(text, i) & 192) == 128) {
        i = i - 1;
    }
    return i;
}

/// How many bytes UTF-8 gives `c`.
fn utf8Width(c: char): int {
    let code = c as uint32;
    if (code < 128) {
        return 1;
    }
    if (code < 2048) {
        return 2;
    }
    if (code < 65536) {
        return 3;
    }
    return 4;
}

/// Whether `p` matches the empty text — a separator or a pattern to replace that would stand
/// everywhere.
fn matchesNothing<P :: [Pattern]>(p: P): bool {
    return p.matchAt("", 0) != null;
}

extend StringView {
    /// The characters, decoded from the bytes — from either end.
    pub fn chars(): CharsIter {
        return CharsIter { s = this, at = 0, end = byteCount(this) };
    }

    /// The characters, each with the byte index it begins at.
    pub fn charIndices(): CharIndicesIter {
        return CharIndicesIter { s = this, at = 0 };
    }

    /// How many characters it holds, `O(n)`.
    pub fn charCount(): int {
        let n = byteCount(this);
        var count = 0;
        var i = 0;
        while (i < n) {
            if ((byteAt(this, i) & 192) != 128) {
                count = count + 1;
            }
            i = i + 1;
        }
        return count;
    }

    /// Whether `p` stands in it.
    pub fn contains<P :: [Pattern]>(p: P): bool {
        return this.find(p) != null;
    }

    /// Whether it begins with `p`.
    pub fn startsWith<P :: [Pattern]>(p: P): bool {
        return p.matchAt(this, 0) != null;
    }

    /// Whether it ends with `p`.
    pub fn endsWith<P :: [Pattern]>(p: P): bool {
        return p.matchBefore(this, byteCount(this)) != null;
    }

    /// The byte index of the first `p`, or `null`; an empty `p` stands at 0.
    pub fn find<P :: [Pattern]>(p: P): ?int {
        return p.nextIn(this, 0);
    }

    /// The byte index of the last `p`, or `null`; an empty `p` stands at the length.
    pub fn rfind<P :: [Pattern]>(p: P): ?int {
        var end = byteCount(this);
        while (end >= 0) {
            if (let start = p.matchBefore(this, end)) {
                return start;
            }
            end = previousChar(this, end);
        }
        return null;
    }

    /// How many times `p` stands in it, none overlapping another; an empty `p` stands between
    /// every two characters and at both ends.
    pub fn count<P :: [Pattern]>(p: P): int {
        let n = byteCount(this);
        var count = 0;
        var from = 0;
        while (from <= n) {
            if (let at = p.nextIn(this, from)) {
                let end = p.matchAt(this, at)!;
                count = count + 1;
                from = if (end > at) end else nextChar(this, at);
            } else {
                return count;
            }
        }
        return count;
    }

    /// The parts between the separators, in order: `"a,b,,c".split(",")` gives `a`, `b`, ``, `c` —
    /// views, no copies. A separator that matches the empty text panics.
    pub fn split<P :: [Pattern]>(sep: P): SplitIter<P> {
        if (matchesNothing(sep)) {
            panic("split: a separator that matches the empty text");
        }
        return SplitIter<P> { s = this, sep = sep, at = 0, left = -1 };
    }

    /// At most `n` parts: the first `n - 1` separators split, the rest is the last part. `n` of 0
    /// gives none.
    pub fn splitN<P :: [Pattern]>(sep: P, n: int): SplitIter<P> {
        if (matchesNothing(sep)) {
            panic("splitN: a separator that matches the empty text");
        }
        if (n < 0) {
            panic(f"splitN: {n} parts");
        }
        return SplitIter<P> { s = this, sep = sep, at = if (n == 0) -1 else 0, left = n };
    }

    /// The part before the first `sep` and the part after it, or `null` where there is none.
    pub fn splitOnce<P :: [Pattern]>(sep: P): ?(StringView, StringView) {
        if (let at = sep.nextIn(this, 0)) {
            let parts: (StringView, StringView) = (this[..at], this[sep.matchAt(this, at)!..]);
            return parts;
        }
        return null;
    }

    /// The matches of `p`, in order, none overlapping another — views.
    pub fn matches<P :: [Pattern]>(p: P): MatchesIter<P> {
        return MatchesIter<P> { s = this, p = p, at = 0 };
    }

    /// The lines: split at `\n`, a `\r` before it taken off, no empty line after a last `\n`.
    pub fn lines(): LinesIter {
        return LinesIter { s = this, at = 0 };
    }

    /// Without the white space at both ends — the characters with the property White_Space (10
    /// S4): the ideographic space and the no-break space as well as the tab. A pattern of one's own
    /// is `trimMatches` (S12c).
    pub fn trim(): StringView {
        return this.trimStart().trimEnd();
    }

    /// Without the white space at the start.
    pub fn trimStart(): StringView {
        let n = byteCount(this);
        var i = 0;
        while (i < n && charAtByte(this, i).isWhitespace()) {
            i = nextChar(this, i);
        }
        return this[i..];
    }

    /// Without the white space at the end.
    pub fn trimEnd(): StringView {
        var n = byteCount(this);
        while (n > 0) {
            let before = previousChar(this, n);
            if (!charAtByte(this, before).isWhitespace()) {
                break;
            }
            n = before;
        }
        return this[..n];
    }

    /// Without the matches of `p` at both ends, again and again: `"xxaxx".trimMatches('x')` is `a`
    /// (10 S12c, Rust's `trim_matches`). A match of the empty text takes nothing.
    pub fn trimMatches<P :: [Pattern]>(p: P): StringView {
        return this.trimStartMatches(p).trimEndMatches(p);
    }

    /// Without the matches of `p` at the start, again and again.
    pub fn trimStartMatches<P :: [Pattern]>(p: P): StringView {
        let n = byteCount(this);
        var i = 0;
        while (i < n) {
            let end = p.matchAt(this, i) ?? i;
            if (end == i) {
                break;
            }
            i = end;
        }
        return this[i..];
    }

    /// Without the matches of `p` at the end, again and again.
    pub fn trimEndMatches<P :: [Pattern]>(p: P): StringView {
        var n = byteCount(this);
        while (n > 0) {
            let start = p.matchBefore(this, n) ?? n;
            if (start == n) {
                break;
            }
            n = start;
        }
        return this[..n];
    }

    /// Whether it holds nothing but white space — the empty text too.
    pub fn isBlank(): bool {
        return this.trimStart().isEmpty();
    }

    /// Every character by its simple uppercase mapping (10 S4): one character for one and no
    /// locale, so `"straße".toUpper()` is `STRAßE`.
    pub fn toUpper(): string {
        let out = StringBuilder.new();
        for (c in this.chars()) {
            out.appendChar(c.toUpper());
        }
        return out.toString();
    }

    /// Every character by its simple lowercase mapping: one character for one, no locale.
    pub fn toLower(): string {
        let out = StringBuilder.new();
        for (c in this.chars()) {
            out.appendChar(c.toLower());
        }
        return out.toString();
    }

    /// Its bytes, a copy (10 S12d): a `Slice<uint8>` of a string would write into a text that may
    /// not change.
    pub fn toBytes(): uint8[] {
        let bytes: uint8[] = [0u8] * byteCount(this);
        viewBytes(this).copyInto(bytes[..]);
        return bytes;
    }

    /// `T.parse(this)`, the type from where it goes (10 S3): `let n: int = try s.parse();`.
    pub fn parse<T :: [Parse]>(): T throws ParseError {
        return try T.parse(this);
    }

    /// The rest after `p` where it begins with `p`, or `null` (10 S2: absence is information).
    pub fn stripPrefix<P :: [Pattern]>(p: P): ?StringView {
        if (let end = p.matchAt(this, 0)) {
            return this[end..];
        }
        return null;
    }

    /// The rest before `p` where it ends with `p`, or `null`.
    pub fn stripSuffix<P :: [Pattern]>(p: P): ?StringView {
        if (let start = p.matchBefore(this, byteCount(this))) {
            return this[..start];
        }
        return null;
    }

    /// Every `p` replaced by `with`, none overlapping another; a `p` that matches the empty text
    /// panics.
    pub fn replace<P :: [Pattern]>(p: P, with: StringView): string {
        return this.replaceN(p, with, -1);
    }

    /// The first `n` of `p` replaced by `with` — all of them where `n` is negative.
    pub fn replaceN<P :: [Pattern]>(p: P, with: StringView, n: int): string {
        if (matchesNothing(p)) {
            panic("replace: a pattern that matches the empty text");
        }
        let out = StringBuilder.new();
        let length = byteCount(this);
        var left = n;
        var from = 0;
        while (from < length && left != 0) {
            if (let at = p.nextIn(this, from)) {
                let end = p.matchAt(this, at)!;
                out.appendStr(this[from..at]);
                out.appendStr(with);
                from = end;
                left = left - 1;
            } else {
                left = 0;
            }
        }
        out.appendStr(this[from..]);
        return out.toString();
    }

    /// `fill` before it until it is `width` characters long; a longer one as it is.
    pub fn padStart(width: int, fill: char = ' '): string {
        let missing = width - this.charCount();
        if (missing <= 0) {
            return this.toString();
        }
        let out = StringBuilder.new();
        var i = 0;
        while (i < missing) {
            out.appendChar(fill);
            i = i + 1;
        }
        out.appendStr(this);
        return out.toString();
    }

    /// `fill` after it until it is `width` characters long; a longer one as it is.
    pub fn padEnd(width: int, fill: char = ' '): string {
        let missing = width - this.charCount();
        if (missing <= 0) {
            return this.toString();
        }
        let out = StringBuilder.new();
        out.appendStr(this);
        var i = 0;
        while (i < missing) {
            out.appendChar(fill);
            i = i + 1;
        }
        return out.toString();
    }
}

fn isAsciiSpace(b: int): bool {
    return b == 32 || (b >= 9 && b <= 13);
}

/// A text's parts between a pattern's matches: views of it. `at` is where the next part begins,
/// -1 once the last was given; `left` how many parts `splitN` still gives, -1 without a bound.
pub struct SplitIter<P :: [Pattern]> :: [Iterator] {
    type Item = StringView;
    s: StringView,
    sep: P,
    var at: int,
    var left: int,

    pub mut fn next(): ?StringView {
        if (this.at < 0) {
            return null;
        }
        let n = byteCount(this.s);
        if (this.left != 1) {
            if (let i = this.sep.nextIn(this.s, this.at)) {
                let part = this.s[this.at..i];
                this.at = this.sep.matchAt(this.s, i)!;
                if (this.left > 0) {
                    this.left = this.left - 1;
                }
                return part;
            }
        }
        let rest = this.s[this.at..n];
        this.at = -1;
        return rest;
    }
}

/// A pattern's matches in a text, none overlapping another: views of it.
pub struct MatchesIter<P :: [Pattern]> :: [Iterator] {
    type Item = StringView;
    s: StringView,
    p: P,
    var at: int,

    pub mut fn next(): ?StringView {
        if (this.at > byteCount(this.s)) {
            return null;
        }
        if (let begin = this.p.nextIn(this.s, this.at)) {
            let end = this.p.matchAt(this.s, begin)!;
            this.at = if (end > begin) end else nextChar(this.s, begin);
            return this.s[begin..end];
        }
        this.at = byteCount(this.s) + 1;
        return null;
    }
}

/// A text's lines: views of it.
pub struct LinesIter :: [Iterator] {
    type Item = StringView;
    s: StringView,
    var at: int,

    pub mut fn next(): ?StringView {
        let n = byteCount(this.s);
        if (this.at >= n) {
            return null;
        }
        var i = this.at;
        while (i < n && byteAt(this.s, i) != 10) {
            i = i + 1;
        }
        var end = i;
        if (end > this.at && byteAt(this.s, end - 1) == 13) {
            end = end - 1;
        }
        let line = this.s[this.at..end];
        this.at = i + 1;
        return line;
    }
}

/// A string built a part at a time (10 S3), in a buffer that doubles: no quadratic chain of
/// concatenations. `std.string` passes it on.
pub class StringBuilder {
    var bytes: uint8[],
    var count: int,

    pub static fn new(): StringBuilder {
        return StringBuilder { bytes = [], count = 0 };
    }

    /// How many bytes it holds.
    pub fn length(): int {
        return this.count;
    }

    /// `s` at the end — a string, or a view of one.
    pub mut fn appendStr(s: StringView): void {
        let n = byteCount(s);
        this.reserve(n);
        putBytes(this.bytes, this.count, s);
        this.count = this.count + n;
    }

    /// `v`'s decimal digits at the end, written in place — an f-string's integer (10 S6).
    mut fn putInt(v: int): void {
        this.reserve(20);
        this.count = this.count + putIntDigits(this.bytes, this.count, v);
    }

    /// `v`'s decimal digits at the end, written in place.
    mut fn putUint(v: uint): void {
        this.reserve(20);
        this.count = this.count + putUintDigits(this.bytes, this.count, v);
    }

    /// An empty builder with room for `room` bytes — an f-string's, sized for its text.
    static fn sized(room: int): StringBuilder {
        let zero: uint8 = 0;
        return StringBuilder { bytes = [zero] * room, count = 0 };
    }

    /// `c` at the end, as its UTF-8 bytes.
    pub mut fn appendChar(c: char): void {
        let code = (c as uint32) as int;
        this.reserve(4);
        if (code < 128) {
            this.put(code);
        } else if (code < 2048) {
            this.put(192 | (code >> 6));
            this.put(128 | (code & 63));
        } else if (code < 65536) {
            this.put(224 | (code >> 12));
            this.put(128 | ((code >> 6) & 63));
            this.put(128 | (code & 63));
        } else {
            this.put(240 | (code >> 18));
            this.put(128 | ((code >> 12) & 63));
            this.put(128 | ((code >> 6) & 63));
            this.put(128 | (code & 63));
        }
    }

    /// `v`'s text at the end.
    pub mut fn append<T :: [Display]>(v: T): void {
        v.showTo(this);
    }

    /// Every byte taken out; the room stays.
    pub mut fn clear(): void {
        this.count = 0;
    }

    /// What it holds, as a string.
    pub fn toString(): string {
        return stringOfBytes(this.bytes, this.count);
    }

    mut fn put(b: int): void {
        this.bytes[this.count] = b as uint8;
        this.count = this.count + 1;
    }

    /// Room for `n` bytes more. Only the check: small enough for the IR inliner to put into every
    /// append, so a builder with room calls nothing; the growth is `grow`'s, out of line (01 S13,
    /// Rust's `reserve` beside its cold `do_reserve_and_handle`).
    mut fn reserve(n: int): void {
        if (this.count + n > this.bytes.length()) {
            this.grow(this.count + n);
        }
    }

    /// The buffer doubled until `need` bytes fit, the bytes so far copied over. Above the inliner's
    /// budget by its loop and copy, so it stays one function every growth calls.
    mut fn grow(need: int): void {
        var room = if (this.bytes.length() == 0) 16 else this.bytes.length() * 2;
        while (room < need) {
            room = room * 2;
        }
        let zero: uint8 = 0;
        let grown = [zero] * room;
        copyBytes(grown, this.bytes, this.count);
        this.bytes = grown;
    }
}

/// `s`'s bytes into `bytes` from `at` on, and the first `count` bytes of `from` into `into` — C's
/// memcpy (measurement point 3), the ranges checked as an index is.
fn putBytes(bytes: uint8[], at: int, s: StringView): void;
fn copyBytes(into: uint8[], from: uint8[], count: int): void;

/// The copy primitive (10 C2; the review's B16): the first `count` elements of `from` into `into`,
/// two views of one element type that may overlap either way — C's memmove. The counts are the
/// caller's to check; `Slice.copyInto` does, and the collections call this where they have.
fn moveElements<T>(into: Slice<T>, from: Slice<T>, count: int): void;
/// The panic of a range `low..high` outside `length` (LYR-RT0003), as `xs[a..b]` raises it.
fn panicRange(low: int, high: int, length: int): never;

// --- StringView (10 S1, 03 A2; M8a S12): the view of a string's bytes --------------------------
// A pointer into a string's bytes and a length, read and never written. `s[a..b]` takes one on
// character boundaries, a string stands where one is expected, and `s[i]` is the character that
// begins at a byte. The string's search and split members stand on it (the strings, above).

/// `a == b` between a string and a view, or two views: the same bytes. The checker's for the
/// operator; a program writes `==`.
pub fn equalViews(a: StringView, b: StringView): bool {
    return viewsHoldTheSameBytes(a, b);
}

/// `<`, `<=`, `>`, `>=` between a string and a view, or two views: byte by byte, which is the
/// order of the code points. The checker's for the operators.
pub fn compareViews(a: StringView, b: StringView): ?Ordering {
    return a.totalCompare(b);
}

/// `s[i]`: the character that begins at byte `i`; outside the bytes, or at a byte that continues
/// a character, a panic (LYR-RT0003). The checker's for the index.
pub fn charAtByte(v: StringView, i: int): char {
    return charOfView(v, i);
}

fn viewsHoldTheSameBytes(a: StringView, b: StringView): bool;
/// Byte by byte, as `memcmp` and then the length: -1, 0 or 1.
fn compareViewBytes(a: StringView, b: StringView): int;
fn viewToString(v: StringView): string;
fn charOfView(v: StringView, i: int): char;
/// The view's bytes as the `Slice<uint8>` it is below the checker — read here, never written.
fn viewBytes(v: StringView): Slice<uint8>;

extend StringView {
    /// Whether it holds no byte.
    pub fn isEmpty(): bool {
        return this.length() == 0;
    }

    /// Its bytes in a string of their own.
    pub fn toString(): string {
        return viewToString(this);
    }
}

/// A view compares, hashes and orders by its bytes, as a string does: equal to the string it
/// shows, hashing as it does (10 C8); it shows its text and debugs quoted.
extend StringView :: [Equatable, Hashable, Ordered, TotalOrder, Display, Debug, Index<int>] {
    type Output = char;

    fn equals(o: StringView): bool {
        return viewsHoldTheSameBytes(this, o);
    }

    fn hash<H :: [Hasher]>(&h: H): void {
        h.write(viewBytes(this));
        h.writeByte(255);
    }

    fn compare(o: StringView): ?Ordering {
        return this.totalCompare(o);
    }

    fn totalCompare(o: StringView): Ordering {
        let c = compareViewBytes(this, o);
        if (c < 0) {
            return Ordering.Less;
        }
        if (c > 0) {
            return Ordering.Greater;
        }
        return Ordering.Equal;
    }

    fn show(): string {
        return viewToString(this);
    }

    fn showTo(out: StringBuilder): void {
        out.appendStr(this);
    }

    fn debug(): string {
        return viewToString(this).debug();
    }

    fn index(k: int): char {
        return charOfView(this, k);
    }
}

/// `s[i]` through `Index<int>` where a type parameter asks for it (04 D6): the character that
/// begins at byte `i`.
extend string :: [Index<int>] {
    type Output = char;

    fn index(k: int): char {
        return charOfView(this, k);
    }
}

// --- bytes to text (10 S3; M8a S12) -----------------------------------------------------------

/// What `string.fromUtf8` throws (10 S3, B3: the bytes are the data's, so it throws): they are no
/// well-formed UTF-8 from `offset` on — an overlong form, a surrogate, beyond U+10FFFF, a byte
/// that begins nothing, a sequence cut short.
pub struct Utf8Error :: [Error] {
    /// The first byte that is no well-formed UTF-8.
    pub offset: int,

    pub fn message(): string {
        return f"the bytes are no UTF-8 from byte {this.offset} on";
    }
}

extend string {
    /// The text the bytes are, copied; `Utf8Error` where they are no well-formed UTF-8.
    pub static fn fromUtf8(bytes: Slice<uint8>): string throws Utf8Error {
        let bad = utf8Invalid(bytes);
        if (bad >= 0) {
            throw Utf8Error { offset = bad };
        }
        return stringOfSlice(bytes);
    }

    /// The text the bytes are, each maximal part of a sequence that is not well-formed replaced by
    /// U+FFFD — the Unicode Standard's recommended practice (3.9), WHATWG's decoding.
    pub static fn fromUtf8Lossy(bytes: Slice<uint8>): string {
        return stringOfUtf8Lossy(bytes);
    }
}

/// -1 where the bytes are well-formed UTF-8, else the offset of the first that is not.
fn utf8Invalid(bytes: Slice<uint8>): int;
fn stringOfSlice(bytes: Slice<uint8>): string;
fn stringOfUtf8Lossy(bytes: Slice<uint8>): string;

// --- f-strings into one builder (10 S6; M8a S13) -----------------------------------------------
// What an f-string compiles to (12 §2 rule 4): a builder sized for its text, each piece appended in
// order, the text taken — one buffer, no string per piece. The checker writes these calls.

pub fn fstringStart(room: int): StringBuilder {
    return StringBuilder.sized(room);
}

pub fn fstringEnd(out: StringBuilder): string {
    return out.toString();
}

pub fn fstringText(out: StringBuilder, text: StringView): void {
    out.appendStr(text);
}

pub fn fstringInt(out: StringBuilder, value: int): void {
    out.putInt(value);
}

pub fn fstringUint(out: StringBuilder, value: uint): void {
    out.putUint(value);
}

pub fn fstringFloat(out: StringBuilder, value: float): void {
    out.appendStr(textOfFloat(value));
}

pub fn fstringFloat32(out: StringBuilder, value: float32): void {
    out.appendStr(textOfFloat32(value));
}

pub fn fstringBool(out: StringBuilder, value: bool): void {
    out.appendStr(if (value) "true" else "false");
}

pub fn fstringChar(out: StringBuilder, value: char): void {
    out.appendChar(value);
}

/// A `Display` type's hole: through `showTo`.
pub fn fstringShown<T :: [Display]>(out: StringBuilder, value: T): void {
    value.showTo(out);
}

/// A `Format` type's hole with a spec: the type reads the spec (10 S7).
pub fn fstringFormatted<T :: [Format]>(out: StringBuilder, value: T, spec: StringView): void {
    value.format(spec, out);
}

/// Another `Display` type's hole with a spec: what `showTo` writes, in its width, alignment and
/// fill — without a width straight into `out`.
pub fn fstringPadded<T :: [Display]>(out: StringBuilder, value: T, spec: StringView): void {
    let s = paddingOnly(spec, "a Display type's text");
    if (s.width == 0) {
        value.showTo(out);
        return;
    }
    let text = StringBuilder.sized(s.width);
    value.showTo(text);
    pad(text.toString(), s, '<', out);
}

/// A hole under `?`: what `debugTo` writes, in the width, alignment and fill before it.
pub fn fstringDebugged<T :: [Debug]>(out: StringBuilder, value: T, spec: StringView): void {
    let s = readSpec(spec);
    if (!padsOnly(s, '?')) {
        refuseSpec(spec, "a Debug text");
    }
    if (s.width == 0) {
        value.debugTo(out);
        return;
    }
    let text = StringBuilder.sized(s.width);
    value.debugTo(text);
    pad(text.toString(), s, '<', out);
}

/// A float's shortest text (12 §1), as `std.string.fromFloat` gives it.
fn textOfFloat(value: float): string;
fn textOfFloat32(value: float32): string;
/// An integer's decimal digits into `bytes` from `at` on: how many; the room is the caller's.
fn putIntDigits(bytes: uint8[], at: int, value: int): int;
fn putUintDigits(bytes: uint8[], at: int, value: uint): int;

// --- the format language (08 Y7, 10 S7; spec 12 §2) ---------------------------------------------

/// A type with formats of its own (10 S7): `{x:spec}` hands it the spec as written. The scalars
/// conform with the format language, which the compiler checks where a spec is written; the spec
/// is a view (10 A3), and a string stands for one.
pub interface Format {
    fn format(spec: StringView, out: StringBuilder): void;
}

/// A spec read (12 §2 rule 1): `[[fill]align][sign][#][0][width][grouping][.precision][type]`.
/// `align` is `<`, `>`, `^`, `=` for the zeros of `0` after the sign, or `'\0'` for the value's
/// own; `grouping` and `kind` are `'\0'` where none is written, `precision` -1.
struct FormatSpec {
    fill: char,
    align: char,
    plus: bool,
    alternate: bool,
    width: int,
    grouping: char,
    precision: int,
    kind: char,
}

/// The spec in `text`. The compiler checked a spec an f-string writes; what is no spec panics.
fn readSpec(text: StringView): FormatSpec {
    let cs = text.chars().toArray();
    let n = cs.length();
    var i = 0;
    var fill = ' ';
    var fillWritten = false;
    var align = '\0';
    if (n >= 2 && isAlignment(cs[1])) {
        fill = cs[0];
        fillWritten = true;
        align = cs[1];
        i = 2;
    } else if (n >= 1 && isAlignment(cs[0])) {
        align = cs[0];
        i = 1;
    }
    var plus = false;
    if (i < n && (cs[i] == '+' || cs[i] == '-')) {
        plus = cs[i] == '+';
        i = i + 1;
    }
    var alternate = false;
    if (i < n && cs[i] == '#') {
        alternate = true;
        i = i + 1;
    }
    if (i < n && cs[i] == '0') {
        if (!fillWritten) {
            fill = '0';
        }
        if (align == '\0') {
            align = '=';
        }
        i = i + 1;
    }
    var width = 0;
    while (i < n && isDecimal(cs[i])) {
        width = width * 10 + decimalOf(cs[i]);
        i = i + 1;
    }
    var grouping = '\0';
    if (i < n && (cs[i] == ',' || cs[i] == '_')) {
        grouping = cs[i];
        i = i + 1;
    }
    var precision = -1;
    if (i < n && cs[i] == '.') {
        i = i + 1;
        precision = 0;
        while (i < n && isDecimal(cs[i])) {
            precision = precision * 10 + decimalOf(cs[i]);
            i = i + 1;
        }
    }
    var kind = '\0';
    if (i < n) {
        kind = cs[i];
        i = i + 1;
    }
    if (i != n) {
        panic(f"'{text}' is no format spec");
    }
    return FormatSpec { fill = fill, align = align, plus = plus, alternate = alternate, width = width,
        grouping = grouping, precision = precision, kind = kind };
}

fn isAlignment(c: char): bool {
    return c == '<' || c == '>' || c == '^';
}

fn isDecimal(c: char): bool {
    return c >= '0' && c <= '9';
}

fn decimalOf(c: char): int {
    return ((c as uint32) as int) - 48;
}

/// A part of a spec the value's type does not take (12 §2 rule 2) panics when it is read: an
/// f-string's was refused where it was written (LYR-SEM0164), a template's — `fmt.format`, read
/// at run time — panics as a broken one does (10 B3; M8c S8c).
fn refuseSpec(spec: StringView, what: string): never {
    panic(f"'{spec}' does not apply to {what}");
}

/// The spec of a value that takes fill, alignment and width alone — a `char`, a `bool`, another
/// `Display` type's text —, the rest refused.
fn paddingOnly(spec: StringView, what: string): FormatSpec {
    let s = readSpec(spec);
    if (!padsOnly(s, '\0')) {
        refuseSpec(spec, what);
    }
    return s;
}

/// Whether the spec says no more than fill, alignment and width, besides the type `kind`.
fn padsOnly(s: FormatSpec, kind: char): bool {
    return !s.plus && !s.alternate && s.align != '=' && s.grouping == '\0' && s.precision < 0 && s.kind == kind;
}

/// `text` in the spec's width, counted in characters: the fill before it, after it, or around it
/// (the odd one after), as the spec aligns it or else as `natural` does.
fn pad(text: string, s: FormatSpec, natural: char, out: StringBuilder): void {
    let room = s.width - text.charCount();
    if (room <= 0) {
        out.appendStr(text);
        return;
    }
    let align = if (s.align == '\0') natural else s.align;
    let before = if (align == '>') room else if (align == '^') room / 2 else 0;
    fillOut(s.fill, before, out);
    out.appendStr(text);
    fillOut(s.fill, room - before, out);
}

/// `count` times `c`.
fn fillOut(c: char, count: int, out: StringBuilder): void {
    var i = 0;
    while (i < count) {
        out.appendChar(c);
        i = i + 1;
    }
}

/// A number's parts in the spec's width: under `0` the zeros between the sign and the prefix and
/// the digits; otherwise the whole padded, right-aligned unless the spec aligns it.
fn finishNumber(sign: string, prefix: string, digits: string, s: FormatSpec, out: StringBuilder): void {
    if (s.align == '=') {
        out.appendStr(sign);
        out.appendStr(prefix);
        fillOut(s.fill, s.width - byteCount(sign) - byteCount(prefix) - digits.charCount(), out);
        out.appendStr(digits);
        return;
    }
    pad(sign + prefix + digits, s, '>', out);
}

/// An integer by its sign and magnitude (12 §2 rule 3): the radix `b`, `o`, `x` or `X` names, the
/// prefix under `#`, the digits grouped by three (decimal) or four (another radix).
fn formatInteger(negative: bool, magnitude: uint, spec: StringView, out: StringBuilder): void {
    let s = readSpec(spec);
    if (s.precision >= 0 || !(s.kind == '\0' || s.kind == 'b' || s.kind == 'o' || s.kind == 'x' || s.kind == 'X')) {
        refuseSpec(spec, "an integer");
    }
    let radix = if (s.kind == 'b') 2 else if (s.kind == 'o') 8 else if (s.kind == 'x' || s.kind == 'X') 16 else 10;
    var prefix = "";
    if (s.alternate) {
        prefix = if (s.kind == 'b') "0b" else if (s.kind == 'o') "0o" else if (s.kind == 'X') "0X" else "0x";
    }
    let sign = if (negative) "-" else if (s.plus) "+" else "";
    let size = if (radix == 10) 3 else 4;
    // under `0` with a grouping, the zeros are grouped with the digits and the width counts the
    // separators (12 §2 rule 1; the review's A4): as many digits as fill the width, at least
    let least = if (zeroGrouped(s)) digitsFor(s.width - byteCount(sign) - byteCount(prefix), size) else 0;
    let digits = digitsOf(magnitude, radix as uint, s.kind == 'X', s.grouping, size, least);
    finishNumber(sign, prefix, digits, s, out);
}

/// Whether the spec fills with zeros after the sign and groups: the zeros then count as digits.
fn zeroGrouped(s: FormatSpec): bool {
    return s.fill == '0' && s.align == '=' && s.grouping != '\0';
}

/// The fewest digits that, grouped by `size`, fill `width` characters — a minimum: where no count
/// fits exactly, the next one; no separator leads.
fn digitsFor(width: int, size: int): int {
    var n = 1;
    while (n + (n - 1) / size < width) {
        n = n + 1;
    }
    return n;
}

/// A signed integer: its magnitude in `uint`, where `int`'s least value has one.
fn formatSigned(v: int, spec: StringView, out: StringBuilder): void {
    let magnitude = if (v < 0) (-(v + 1)) as uint + 1 else v as uint;
    formatInteger(v < 0, magnitude, spec, out);
}

/// The digits of `magnitude` in `radix`, most significant first, `grouping` between each `size`
/// of them from the right; `least` digits at least, zeros before the first.
fn digitsOf(magnitude: uint, radix: uint, upper: bool, grouping: char, size: int, least: int): string {
    var count = 1;
    var rest = magnitude / radix;
    while (rest != 0) {
        count = count + 1;
        rest = rest / radix;
    }
    if (count < least) {
        count = least;
    }
    let separators = if (grouping == '\0') 0 else (count - 1) / size;
    let total = count + separators;
    let zero: uint8 = 0;
    let bytes = [zero] * total;
    var at = total - 1;
    var value = magnitude;
    var placed = 0;
    while (placed < count) {
        let d = (value % radix) as int;
        bytes[at] = (if (d < 10) 48 + d else if (upper) 55 + d else 87 + d) as uint8;
        at = at - 1;
        placed = placed + 1;
        value = value / radix;
        if (placed < count && grouping != '\0' && placed % size == 0) {
            bytes[at] = (grouping as uint32) as uint8;
            at = at - 1;
        }
    }
    return stringOfBytes(bytes, total);
}

/// A float (12 §2 rule 3): its shortest text without a precision or a type (03 §1.7) — a
/// `float32`'s own where `narrow` says so; fixed with a precision; `e`/`E` with an exponent; `%` a
/// hundredfold and fixed, the point moved on the exact digits — six digits where those three name
/// none. Its sign, the integer part grouped (the zeros of `0` with it), padded.
fn formatFloat(v: float, narrow: bool, spec: StringView, out: StringBuilder): void {
    let s = readSpec(spec);
    if (s.alternate || !(s.kind == '\0' || s.kind == 'e' || s.kind == 'E' || s.kind == 'f' || s.kind == '%')) {
        refuseSpec(spec, "a float");
    }
    let digits = if (s.precision < 0) 6 else s.precision;
    var text = "";
    if (s.kind == 'e') {
        text = floatText(v, digits, 1);
    } else if (s.kind == 'E') {
        text = floatText(v, digits, 2);
    } else if (s.kind == '%') {
        text = floatText(v, digits, 3) + "%";
    } else if (s.kind == 'f' || s.precision >= 0) {
        text = floatText(v, digits, 0);
    } else if (narrow) {
        text = shortestFloat32(v as float32);
    } else {
        text = f"{v}";
    }
    let negative = text.startsWith("-");
    let body = if (negative) byteSlice(text, 1, byteCount(text)) else text;
    let sign = if (negative) "-" else if (s.plus) "+" else "";
    var least = 0;
    if (zeroGrouped(s) && integerDigits(body) > 0) {
        // the width less the sign and what follows the integer part: that many characters of
        // digits and separators, at least (nothing for `nan` and `inf`, which have no digits)
        least = digitsFor(s.width - byteCount(sign) - (byteCount(body) - integerDigits(body)), 3);
    }
    finishNumber(sign, "", grouped(body, s.grouping, least), s, out);
}

/// How many digits lead `body`: a float's integer part.
fn integerDigits(body: string): int {
    let n = byteCount(body);
    var end = 0;
    while (end < n && byteAt(body, end) >= 48 && byteAt(body, end) <= 57) {
        end = end + 1;
    }
    return end;
}

/// `body`'s leading digits, a float's integer part, `least` of them at least (zeros before the
/// first), with `grouping` between each three.
fn grouped(body: string, grouping: char, least: int): string {
    let n = byteCount(body);
    let end = integerDigits(body);
    let count = if (end < least) least else end;
    if (grouping == '\0' && count == end) {
        return body;
    }
    let out = StringBuilder.new();
    var i = 0;
    while (i < count) {
        if (i > 0 && grouping != '\0' && (count - i) % 3 == 0) {
            out.appendChar(grouping);
        }
        let from = i - (count - end);
        if (from < 0) {
            out.appendChar('0');
        } else {
            out.appendStr(byteSlice(body, from, from + 1));
        }
        i = i + 1;
    }
    out.appendStr(byteSlice(body, end, n));
    return out.toString();
}

/// The first `count` characters of `text`, or all of them: cut where the next one starts, at a
/// byte that is no continuation byte (`10xxxxxx`).
fn firstChars(text: string, count: int): string {
    let n = byteCount(text);
    var at = 0;
    var taken = 0;
    while (at < n) {
        if ((byteAt(text, at) & 192) != 128) {
            if (taken == count) {
                return byteSlice(text, 0, at);
            }
            taken = taken + 1;
        }
        at = at + 1;
    }
    return text;
}

/// A float with a precision (12 §2 rule 3), rounded half away from zero on its exact binary digits
/// by the runtime: `form` 0 fixed, 1 with an exponent, 2 the same upper case, 3 fixed a hundredfold.
fn floatText(value: float, precision: int, form: int): string;
/// A `float32`'s own shortest text (03 §1.7).
fn shortestFloat32(value: float32): string;

extend int :: [Format] {
    fn format(spec: StringView, out: StringBuilder): void { formatSigned(this, spec, out); }
}

extend int8 :: [Format] {
    fn format(spec: StringView, out: StringBuilder): void { formatSigned(this as int, spec, out); }
}

extend int16 :: [Format] {
    fn format(spec: StringView, out: StringBuilder): void { formatSigned(this as int, spec, out); }
}

extend int32 :: [Format] {
    fn format(spec: StringView, out: StringBuilder): void { formatSigned(this as int, spec, out); }
}

extend uint :: [Format] {
    fn format(spec: StringView, out: StringBuilder): void { formatInteger(false, this, spec, out); }
}

extend uint8 :: [Format] {
    fn format(spec: StringView, out: StringBuilder): void { formatInteger(false, this as uint, spec, out); }
}

extend uint16 :: [Format] {
    fn format(spec: StringView, out: StringBuilder): void { formatInteger(false, this as uint, spec, out); }
}

extend uint32 :: [Format] {
    fn format(spec: StringView, out: StringBuilder): void { formatInteger(false, this as uint, spec, out); }
}

extend float :: [Format] {
    fn format(spec: StringView, out: StringBuilder): void { formatFloat(this, false, spec, out); }
}

/// A `float32` is formatted as the `float` it widens to — the same value exactly —, its shortest
/// text its own (03 §1.7; the review's M8a-9).
extend float32 :: [Format] {
    fn format(spec: StringView, out: StringBuilder): void { formatFloat(this as float, true, spec, out); }
}

/// A string: fill, alignment, width, and the precision as the most characters it keeps.
extend string :: [Format] {
    fn format(spec: StringView, out: StringBuilder): void {
        let s = readSpec(spec);
        if (s.plus || s.alternate || s.align == '=' || s.grouping != '\0' || s.kind != '\0') {
            refuseSpec(spec, "a string");
        }
        pad(if (s.precision >= 0) firstChars(this, s.precision) else this, s, '<', out);
    }
}

extend char :: [Format] {
    fn format(spec: StringView, out: StringBuilder): void { pad(f"{this}", paddingOnly(spec, "a char"), '<', out); }
}

extend bool :: [Format] {
    fn format(spec: StringView, out: StringBuilder): void { pad(f"{this}", paddingOnly(spec, "a bool"), '<', out); }
}


/// A string's characters, decoded from its UTF-8 bytes — from the front by `next`, from the back
/// by `nextBack` (10 S1: `chars()` is `DoubleEnded`), the two meeting in the middle.
pub struct CharsIter :: [Iterator, DoubleEnded] {
    type Item = char;
    s: StringView,
    var at: int,
    var end: int,

    pub mut fn next(): ?char {
        if (this.at >= this.end) {
            return null;
        }
        let first = byteAt(this.s, this.at);
        var code = first;
        var size = 1;
        if (first >= 240) {
            code = first & 7;
            size = 4;
        } else if (first >= 224) {
            code = first & 15;
            size = 3;
        } else if (first >= 192) {
            code = first & 31;
            size = 2;
        }
        var k = 1;
        while (k < size) {
            code = (code << 6) | (byteAt(this.s, this.at + k) & 63);
            k = k + 1;
        }
        this.at = this.at + size;
        return (code as uint32) as char;
    }

    pub mut fn nextBack(): ?char {
        if (this.end <= this.at) {
            return null;
        }
        this.end = previousChar(this.s, this.end);
        return charAtByte(this.s, this.end);
    }
}

/// A text's characters with the byte index each begins at (10 S1): the indices `s[i]` and
/// `s[a..b]` take.
pub struct CharIndicesIter :: [Iterator] {
    type Item = (int, char);
    s: StringView,
    var at: int,

    pub mut fn next(): ?(int, char) {
        if (this.at >= byteCount(this.s)) {
            return null;
        }
        let item: (int, char) = (this.at, charAtByte(this.s, this.at));
        this.at = nextChar(this.s, this.at);
        return item;
    }
}

fn asTypeOf<T, U>(v: T, like: U): U;
fn floatOfText(s: string): float;
fn float32OfText(s: string): float32;


// ---------------------------------------------------------------------------------------------
// Iteration (design/v5/spec/10 B6): a source of values, one at a time, and what `for` walks.
// ---------------------------------------------------------------------------------------------

/// A source of values, one at a time (10 B6 I1): `next()` gives the next, and `null` at the end —
/// for good, once given. A struct iterator changes as it goes, so `next` writes it. A walk that
/// can fail — a file's lines — answers its `Error`, and `next()` throws it (I5): the loop over it
/// is marked, `for (line in try lines)`.
pub interface Iterator {
    type Item;

    /// What a walk may throw: nothing, unless a conformer answers otherwise.
    type Error :: [Error] = never;

    mut fn next(): ?Self.Item throws Self.Error;

    /// How many values are left: at least the first, at most the second where that is known — for
    /// a collector that sizes its storage once.
    fn sizeHint(): (int, ?int) {
        let unknown: ?int = null;
        return (0, unknown);
    }
}

/// What `for` walks (I2): `iter()` gives an iterator over it, at every loop anew. Every iterator
/// is iterable as itself: a struct iterator as a copy, a class iterator as the object — two loops
/// over one go on from each other.
pub interface Iterable {
    type Iter :: [Iterator];

    fn iter(): Self.Iter;
}

/// An iterator from both ends (I10): `nextBack()` gives the last value not yet given.
pub interface DoubleEnded :: [Iterator] {
    mut fn nextBack(): ?Self.Item;
}

extend<I :: [Iterator]> I :: [Iterable<Iter = I>] {
    fn iter(): I {
        return this;
    }
}

// A range is an iterator of its own values, from both ends (I10): the value changes as it is
// walked — a 'let' range is walked through a copy, as `for` takes one.
extend<T :: [Step]> Range<T> :: [Iterator, DoubleEnded] {
    type Item = T;

    mut fn next(): ?T {
        if (this.start >= this.end) {
            return null;
        }
        let value = this.start;
        this.start = value.after();
        return value;
    }

    mut fn nextBack(): ?T {
        if (this.start >= this.end) {
            return null;
        }
        this.end = this.end.before();
        return this.end;
    }
}

/// What a range walks by (03 S15b; M8c S3 — Rust's `Step`): the value after and the value before,
/// and the type's first and last — an integer's `± 1`, `min` and `max`; a character's scalar values
/// past the surrogates. Within std.core. One block per type: a blanket over `Integer` beside
/// `char`'s would conform some type twice, and there is no specialization (04).
interface Step :: [TotalOrder] {
    static fn first(): Self;
    static fn last(): Self;

    fn after(): Self;
    fn before(): Self;
}

extend int :: [Step] {
    static fn first(): int { return int.min; }
    static fn last(): int { return int.max; }
    fn after(): int { return this + 1; }
    fn before(): int { return this - 1; }
}

extend int8 :: [Step] {
    static fn first(): int8 { return int8.min; }
    static fn last(): int8 { return int8.max; }
    fn after(): int8 { return this + 1; }
    fn before(): int8 { return this - 1; }
}

extend int16 :: [Step] {
    static fn first(): int16 { return int16.min; }
    static fn last(): int16 { return int16.max; }
    fn after(): int16 { return this + 1; }
    fn before(): int16 { return this - 1; }
}

extend int32 :: [Step] {
    static fn first(): int32 { return int32.min; }
    static fn last(): int32 { return int32.max; }
    fn after(): int32 { return this + 1; }
    fn before(): int32 { return this - 1; }
}

extend uint :: [Step] {
    static fn first(): uint { return uint.min; }
    static fn last(): uint { return uint.max; }
    fn after(): uint { return this + 1; }
    fn before(): uint { return this - 1; }
}

extend uint8 :: [Step] {
    static fn first(): uint8 { return uint8.min; }
    static fn last(): uint8 { return uint8.max; }
    fn after(): uint8 { return this + 1; }
    fn before(): uint8 { return this - 1; }
}

extend uint16 :: [Step] {
    static fn first(): uint16 { return uint16.min; }
    static fn last(): uint16 { return uint16.max; }
    fn after(): uint16 { return this + 1; }
    fn before(): uint16 { return this - 1; }
}

extend uint32 :: [Step] {
    static fn first(): uint32 { return uint32.min; }
    static fn last(): uint32 { return uint32.max; }
    fn after(): uint32 { return this + 1; }
    fn before(): uint32 { return this - 1; }
}

extend char :: [Step] {
    static fn first(): char { return '\0'; }
    static fn last(): char { return '\u{10FFFF}'; }
    fn after(): char { return charAfter(this); }
    fn before(): char { return charBefore(this); }
}

/// The iterator of an array or a view (10 B6 I10): its elements from the front and from the
/// back, through a view of them — nothing is copied, and a write to a later element is seen.
pub struct SliceIter<T> {
    items: Slice<T>,
    var front: int,
    var back: int,
}

extend<T> SliceIter<T> :: [Iterator, DoubleEnded] {
    type Item = T;

    mut fn next(): ?T {
        if (this.front >= this.back) {
            return null;
        }
        this.front = this.front + 1;
        return this.items[this.front - 1];
    }

    mut fn nextBack(): ?T {
        if (this.front >= this.back) {
            return null;
        }
        this.back = this.back - 1;
        return this.items[this.back];
    }

    /// Exactly the elements left.
    fn sizeHint(): (int, ?int) {
        let left = this.back - this.front;
        let most: ?int = left;
        return (left, most);
    }
}

extend<T> T[] :: [Iterable] {
    type Iter = SliceIter<T>;

    fn iter(): SliceIter<T> {
        return SliceIter<T> { items = this, front = 0, back = this.length() };
    }
}

extend<T> Slice<T> :: [Iterable] {
    type Iter = SliceIter<T>;

    fn iter(): SliceIter<T> {
        return SliceIter<T> { items = this, front = 0, back = this.length() };
    }
}

// --- collecting (10 B6, I4; M8a S15) -------------------------------------------------------------
// `collect()` builds what the expected type is, through its `FromIterator`: `let xs: List<int> =
// it.collect();`. An array is one; the containers of std.collections are the others.

/// What an array literal becomes where a value of the type is expected (10 K4): the elements check
/// against `T`, and the literal is `Self.fromLiteral([…])` — `let s: Set<int> = [1, 2, 3];`,
/// `let m: Map<string, int> = [("a", 1)];` (a map is no literal of its own). A copy, as `of` would
/// make one.
pub interface FromArrayLiteral<T> {
    static fn fromLiteral(items: T[]): Self;
}

/// A type built from an iterator's values (10 B6): `collect()` calls `fromIter`, the type's own.
pub interface FromIterator<T> {
    static fn fromIter<I :: [Iterator<Item = T>]>(it: I): Self throws I.Error;
}

extend<T> T[] :: [FromIterator<T>] {
    /// The values in an array, in order: a buffer that doubles, its first value for the slots
    /// not yet written, then one copy of the length — one pass. The buffer starts at the
    /// iterator's own guess of its length (`sizeHint`, 10 I4), and where that was exact — an
    /// array's walk, a view's — the buffer is the array, with no copy at the end.
    static fn fromIter<I :: [Iterator<Item = T>]>(it: I): T[] throws I.Error {
        var walk = it;
        let least = walk.sizeHint().0;
        let first = try walk.next();
        if (first == null) {
            return [];
        }
        var buffer = filled(if (least > 8) least else 8, first);
        var count = 1;
        var x = try walk.next();
        while (x != null) {
            if (count == buffer.length()) {
                let grown = filled(count * 2, first);
                buffer[..count].copyInto(grown[..]);
                buffer = grown;
            }
            buffer[count] = x;
            count = count + 1;
            x = try walk.next();
        }
        if (count == buffer.length()) {
            return buffer;
        }
        let out = filled(count, first);
        buffer[..count].copyInto(out[..]);
        return out;
    }
}

extend<T :: [Ordered]> Range<T> :: [Contains<T>] {
    /// Whether `x` lies from `start` up to, not including, `end`.
    fn contains(x: T): bool {
        return this.start <= x && x < this.end;
    }
}

extend<T :: [Ordered]> RangeInclusive<T> :: [Contains<T>] {
    /// Whether `x` lies from `start` to `end`, both included.
    fn contains(x: T): bool {
        return this.start <= x && x <= this.end;
    }
}

/// `s * n` (10 C7): the text `s`, `n` times over — `""` for none. `n * s` is refused, the one order
/// of `[x] * n`, and a negative `n` panics as an array's repetition does (`LYR-RT0007`): the count
/// goes through it. The compiler desugars the operator to this call (N1a).
pub fn repeatText(s: string, n: int): string {
    if (n < 0) {
        let _ = [s] * n;
    }
    let out = StringBuilder.new();
    for (_ in 0..n) {
        out.appendStr(s);
    }
    return out.toString();
}

// --- the members of arrays and views (10 C2): written once on `Slice<T>`, and reached on an
// array - and a `T[N]` in the heap (03 §5.3 rule 6) - through a view of all of it. A write goes there.
extend<T> Slice<T> {
    /// Whether there is no element.
    pub fn isEmpty(): bool {
        return this.length() == 0;
    }

    /// The elements into `into`, which is at least as long: a shorter one panics (`LYR-RT0003`),
    /// a longer one keeps its rest. The two may overlap either way, `xs[0..4].copyInto(xs[2..6])`
    /// as well as the reverse (the review's B16b). One call to C's memmove.
    pub fn copyInto(into: Slice<T>): void {
        let n = this.length();
        if (into.length() < n) {
            panicRange(0, n, into.length());
        }
        moveElements(into, this, n);
    }

    /// The element at `i`, or `null` outside `0 ≤ i < length()`.
    pub fn get(i: int): ?T {
        if (i < 0 || i >= this.length()) {
            return null;
        }
        return this[i];
    }

    /// The first element, or `null` where there is none.
    pub fn first(): ?T {
        return this.get(0);
    }

    /// The last element, or `null` where there is none.
    pub fn last(): ?T {
        return this.get(this.length() - 1);
    }

    /// The elements at `i` and `j` exchanged; an index outside panics as `[i]` does.
    pub fn swap(i: int, j: int): void {
        let t = this[i];
        this[i] = this[j];
        this[j] = t;
    }

    /// The elements in place, the last first.
    pub fn reverse(): void {
        var i = 0;
        var j = this.length() - 1;
        while (i < j) {
            this.swap(i, j);
            i = i + 1;
            j = j - 1;
        }
    }

    /// A new array of the elements, the last first.
    pub fn reversed(): T[] {
        let n = this.length();
        return arrayOf(n, (i: int) => this[n - 1 - i]);
    }

    /// The first index whose element fails `p`, for elements that `p` partitions — every one it
    /// holds for before every one it does not: a binary search.
    pub fn partitionPoint<E :: [Error]>(p: fn(T) -> bool throws E): int throws E {
        var lo = 0;
        var hi = this.length();
        while (lo < hi) {
            let mid = lo + (hi - lo) / 2;
            if (try p(this[mid])) {
                lo = mid + 1;
            } else {
                hi = mid;
            }
        }
        return lo;
    }
}

/// `a + b` of two views (10 C7): a new array of the elements of both, as `xs + ys` of two arrays.
extend<T> Slice<T> :: [Add<Out = T[]>] {
    fn add(rhs: Slice<T>): T[] {
        let n = this.length();
        let m = rhs.length();
        if (n + m == 0) {
            return [];
        }
        let out = filled(n + m, if (n > 0) this[0] else rhs[0]);
        this.copyInto(out[..n]);
        rhs.copyInto(out[n..]);
        return out;
    }
}

/// `x in xs` (10 C12): an element equal to `x`.
extend<T :: [Equatable]> Slice<T> :: [Contains<T>] {
    fn contains(x: T): bool {
        return this.indexOf(x) != null;
    }
}

extend<T :: [Equatable]> T[] :: [Contains<T>] {
    fn contains(x: T): bool {
        return this[..].contains(x);
    }
}

/// `c in text` (10 C12; M8c S9b): a character of the text. The view's `contains<P :: [Pattern]>`
/// is the witness at `P = char` (13 S9), so the conformance writes nothing.
extend StringView :: [Contains<char>] { }

/// A string's: its view's, as a call on a string reaches the members written once on its view (10
/// S1) — a member of its own would hide the view's 'contains' of a text.
extend string :: [Contains<char>] { }

extend<T :: [Equatable]> Slice<T> {
    /// The index of the first element equal to `x`, or `null`.
    pub fn indexOf(x: T): ?int {
        var i = 0;
        while (i < this.length()) {
            if (this[i] == x) {
                return i;
            }
            i = i + 1;
        }
        return null;
    }
}

extend<T :: [Clone]> Slice<T> {
    /// Every element a clone of `v` — no object shared into several slots (10 C7).
    pub fn fill(v: T): void {
        var i = 0;
        while (i < this.length()) {
            this[i] = v.clone();
            i = i + 1;
        }
    }
}

extend<T :: [TotalOrder]> Slice<T> {
    /// The index of an element equal to `x` in sorted elements, or `null` (10 C10: a `NaN` would
    /// break the order the search relies on, so a total one is asked).
    pub fn binarySearch(x: T): ?int {
        let at = this.partitionPoint((e: T) => e < x);
        if (at < this.length() && this[at] == x) {
            return at;
        }
        return null;
    }
}

extend<T :: [Display]> Slice<T> {
    /// The elements' texts, `sep` between each two.
    pub fn join(sep: string): string {
        var out = "";
        var i = 0;
        while (i < this.length()) {
            if (i > 0) {
                out = out + sep;
            }
            out = out + f"{this[i]}";
            i = i + 1;
        }
        return out;
    }
}

// --- ordering (10 C10): `sort` and `sortBy` stable (K3), through a buffer of the length;
// `sortUnstable` in place.
extend<T> Slice<T> {
    /// The elements in the order `cmp` gives, equal ones keeping theirs: a merge sort — runs of
    /// 16 sorted by insertion, then merged pairwise through a buffer of the length.
    /// A comparison that throws ends the sort, and the call throws it: the elements are then in
    /// some order, every one still there — Rust's guarantee where its comparison panics.
    pub fn sortBy<E :: [Error]>(cmp: fn(T, T) -> Ordering throws E): void throws E {
        let n = this.length();
        var start = 0;
        while (start < n) {
            let end = if (start + 16 < n) start + 16 else n;
            try sortRunBy(this[start..end], cmp);
            start = end;
        }
        if (n <= 16) {
            return;
        }
        let buffer = sortBuffer(this);
        var width = 16;
        var inBuffer = false;
        // Where the buffer holds the elements — at the end, or when a comparison throws while a
        // pass writes them back — they go back whole.
        defer {
            if (inBuffer) {
                buffer[..].copyInto(this);
            }
        }
        while (width < n) {
            if (inBuffer) {
                try mergeRunsBy(buffer[..], this, width, cmp);
            } else {
                try mergeRunsBy(this, buffer[..], width, cmp);
            }
            inBuffer = !inBuffer;
            width = width * 2;
        }
    }

    /// The elements in the order of their keys, equal keys keeping theirs; a key that throws, as
    /// `sortBy`'s comparison.
    pub fn sortByKey<K :: [TotalOrder], E :: [Error]>(key: fn(T) -> K throws E): void throws E {
        try this.sortBy((a: T, b: T) => (try key(a)).totalCompare(try key(b)));
    }
}

extend<T :: [TotalOrder]> Slice<T> {
    /// The elements in ascending order, equal ones keeping theirs: `sortBy`'s merge sort with
    /// `totalCompare` called directly. A function value between kept C from inlining the
    /// comparison — 40 % of the time at measurement point 3.
    pub fn sort(): void {
        let n = this.length();
        var start = 0;
        while (start < n) {
            let end = if (start + 16 < n) start + 16 else n;
            sortRun(this[start..end]);
            start = end;
        }
        if (n <= 16) {
            return;
        }
        let buffer = sortBuffer(this);
        var width = 16;
        var inBuffer = false;
        while (width < n) {
            if (inBuffer) {
                mergeRuns(buffer[..], this, width);
            } else {
                mergeRuns(this, buffer[..], width);
            }
            inBuffer = !inBuffer;
            width = width * 2;
        }
        if (inBuffer) {
            buffer[..].copyInto(this);
        }
    }

    /// The elements in ascending order, equal ones in any: in place, without a buffer — a
    /// quicksort, a heap sort where it would go quadratic.
    pub fn sortUnstable(): void {
        var depth = 0;
        var n = this.length();
        while (n > 1) {
            depth = depth + 2;
            n = n / 2;
        }
        introSort(this, depth);
    }
}

fn isLess(o: Ordering): bool {
    return match (o) { .Less => true, _ => false };
}

fn isGreater(o: Ordering): bool {
    return match (o) { .Greater => true, _ => false };
}

/// `sortRunBy` under the type's own order.
fn sortRun<T :: [TotalOrder]>(xs: Slice<T>): void {
    var i = 1;
    while (i < xs.length()) {
        let x = xs[i];
        var j = i;
        while (j > 0 && isLess(x.totalCompare(xs[j - 1]))) {
            xs[j] = xs[j - 1];
            j = j - 1;
        }
        xs[j] = x;
        i = i + 1;
    }
}

/// `mergeRunsBy` under the type's own order.
/// A copy of `xs` as the merges' second buffer: the slots made of its first element, then one
/// copy — not an element at a time through a closure (B16).
fn sortBuffer<T>(xs: Slice<T>): T[] {
    let first = xs[0];
    let buffer = arrayOf(xs.length(), (i: int) => first);
    xs.copyInto(buffer[..]);
    return buffer;
}

fn mergeRuns<T :: [TotalOrder]>(src: Slice<T>, dst: Slice<T>, width: int): void {
    let n = src.length();
    var lo = 0;
    while (lo < n) {
        let mid = if (lo + width < n) lo + width else n;
        let hi = if (mid + width < n) mid + width else n;
        var i = lo;
        var j = mid;
        var k = lo;
        while (i < mid && j < hi) {
            if (isLess(src[j].totalCompare(src[i]))) {
                dst[k] = src[j];
                j = j + 1;
            } else {
                dst[k] = src[i];
                i = i + 1;
            }
            k = k + 1;
        }
        // what one run has left goes over whole
        src[i..mid].copyInto(dst[k..k + (mid - i)]);
        k = k + (mid - i);
        src[j..hi].copyInto(dst[k..k + (hi - j)]);
        lo = hi;
    }
}

/// A run sorted by insertion: each element moved before the ones it is less than, so equal ones
/// keep their order.
fn sortRunBy<T, E :: [Error]>(xs: Slice<T>, cmp: fn(T, T) -> Ordering throws E): void throws E {
    // By swaps, not by a hole: a comparison that throws finds every element in a slot.
    var i = 1;
    while (i < xs.length()) {
        var j = i;
        while (j > 0 && isLess(try cmp(xs[j], xs[j - 1]))) {
            xs.swap(j, j - 1);
            j = j - 1;
        }
        i = i + 1;
    }
}

/// One pass of the merge sort: the runs of `width` in `src` merged pairwise into `dst`, the left
/// one's element first where two are equal.
fn mergeRunsBy<T, E :: [Error]>(src: Slice<T>, dst: Slice<T>, width: int, cmp: fn(T, T) -> Ordering throws E): void throws E {
    let n = src.length();
    var lo = 0;
    while (lo < n) {
        let mid = if (lo + width < n) lo + width else n;
        let hi = if (mid + width < n) mid + width else n;
        var i = lo;
        var j = mid;
        var k = lo;
        while (i < mid && j < hi) {
            if (isLess(try cmp(src[j], src[i]))) {
                dst[k] = src[j];
                j = j + 1;
            } else {
                dst[k] = src[i];
                i = i + 1;
            }
            k = k + 1;
        }
        src[i..mid].copyInto(dst[k..k + (mid - i)]);
        k = k + (mid - i);
        src[j..hi].copyInto(dst[k..k + (hi - j)]);
        lo = hi;
    }
}

/// The unstable sort: partitions around the median of three, the smaller side by recursion and
/// the larger by the loop, insertion below 17 elements, a heap sort once `depth` partitions are
/// spent.
fn introSort<T :: [TotalOrder]>(xs: Slice<T>, depth: int): void {
    var view = xs;
    var left = depth;
    while (view.length() > 16) {
        if (left == 0) {
            heapSort(view);
            return;
        }
        left = left - 1;
        let split = partitionHoare(view);
        if (split < view.length() - split) {
            introSort(view[..split], left);
            view = view[split..];
        } else {
            introSort(view[split..], left);
            view = view[..split];
        }
    }
    sortRunBy(view, (a: T, b: T) => a.totalCompare(b));
}

/// Hoare's partition around the median of the first, middle and last element: every element
/// before the answer is at most the pivot, every one from it at least, and both sides hold one.
/// A sorted part is left as it is; equal elements are split between the sides.
fn partitionHoare<T :: [TotalOrder]>(xs: Slice<T>): int {
    let n = xs.length();
    let pivot = medianOfThree(xs[0], xs[n / 2], xs[n - 1]);
    var i = 0;
    var j = n - 1;
    var split = -1;
    while (split < 0) {
        while (isLess(xs[i].totalCompare(pivot))) {
            i = i + 1;
        }
        while (isGreater(xs[j].totalCompare(pivot))) {
            j = j - 1;
        }
        if (i >= j) {
            split = j + 1;
        } else {
            xs.swap(i, j);
            i = i + 1;
            j = j - 1;
        }
    }
    return split;
}

fn medianOfThree<T :: [TotalOrder]>(a: T, b: T, c: T): T {
    if (isLess(a.totalCompare(b))) {
        if (isLess(b.totalCompare(c))) {
            return b;
        }
        if (isLess(a.totalCompare(c))) {
            return c;
        }
        return a;
    }
    if (isLess(a.totalCompare(c))) {
        return a;
    }
    if (isLess(b.totalCompare(c))) {
        return c;
    }
    return b;
}

/// A heap sort, `O(n log n)` whatever the order: a max-heap built in place, its top swapped to the
/// end one at a time.
fn heapSort<T :: [TotalOrder]>(xs: Slice<T>): void {
    let n = xs.length();
    var start = n / 2 - 1;
    while (start >= 0) {
        siftDown(xs, start, n);
        start = start - 1;
    }
    var end = n - 1;
    while (end > 0) {
        xs.swap(0, end);
        siftDown(xs, 0, end);
        end = end - 1;
    }
}

fn siftDown<T :: [TotalOrder]>(xs: Slice<T>, root: int, end: int): void {
    var r = root;
    while (true) {
        var child = 2 * r + 1;
        if (child >= end) {
            return;
        }
        if (child + 1 < end && isLess(xs[child].totalCompare(xs[child + 1]))) {
            child = child + 1;
        }
        if (!isLess(xs[r].totalCompare(xs[child]))) {
            return;
        }
        xs.swap(r, child);
        r = child;
    }
}

/// The join of two thrown types (design/v5/spec/05 E2 K7): what a walk over two sources throws.
/// The compiler reduces it once both are known — one type where they are one, the other where
/// one is `never`, the root `Error` where they differ; open, it covers each of its parts. No value
/// of it is made.
pub struct Join<A :: [Error], B :: [Error]> :: [Error] {
    pub fn message(): string {
        return "a joined error";
    }
}

/// `it.zip(other)`: each value beside the other's at its position, as long as both have one.
extend<T> SliceIter<T> :: [Clone] {
    fn clone(): SliceIter<T> {
        return this;
    }
}

extend<T :: [Step]> Range<T> :: [Clone] {
    fn clone(): Range<T> {
        return this;
    }
}

extend<T :: [Step]> RangeInclusive<T> :: [Clone] {
    fn clone(): RangeInclusive<T> {
        return this;
    }
}

extend CharsIter :: [Clone] {
    fn clone(): CharsIter {
        return this;
    }
}

// An inclusive range ends without a flag: its last value leaves `start` past `end` — or `end`
// before `start` where that value is the type's last (its first from the back), so neither bound
// leaves the type. A range of characters walks the scalar values, the surrogates passed over
// (03 S15b; `Step` above).
extend<T :: [Step]> RangeInclusive<T> :: [Iterator, DoubleEnded] {
    type Item = T;

    mut fn next(): ?T {
        if (this.start > this.end) {
            return null;
        }
        let value = this.start;
        if (value == this.end && value == T.last()) {
            this.end = value.before();
        } else {
            this.start = value.after();
        }
        return value;
    }

    mut fn nextBack(): ?T {
        if (this.start > this.end) {
            return null;
        }
        let value = this.end;
        if (value == this.start && value == T.first()) {
            this.start = value.after();
        } else {
            this.end = value.before();
        }
        return value;
    }
}

/// The scalar value after `c`, past the surrogates; `c` is below U+10FFFF.
fn charAfter(c: char): char {
    var n = (c as uint32) + 1;
    if (n == 0xD800) {
        n = 0xE000;
    }
    return n as char;
}

/// The scalar value before `c`, past the surrogates; `c` is above U+0000.
fn charBefore(c: char): char {
    var n = (c as uint32) - 1;
    if (n == 0xDFFF) {
        n = 0xD7FF;
    }
    return n as char;
}

/// The debug rendering of an array — what a synthesized `debug()` reaches for, the array's own
/// (10 C9).
pub fn debugArray<T :: [Debug]>(xs: T[]): string {
    return debugText(xs);
}

/// The same for a view.
pub fn debugSlice<T :: [Debug]>(xs: Slice<T>): string {
    return debugText(xs);
}

/// The same for an optional: `null`, or the value.
pub fn debugOptional<T :: [Debug]>(o: ?T): string {
    if (o == null) { return "null"; }
    return o.debug();
}

/// Equality of two arrays, element by element — what a synthesized `equals` reaches for, the
/// arrays' own (10 C9).
pub fn equalArrays<T :: [Equatable]>(a: T[], b: T[]): bool {
    return sameElements(a, b);
}

/// The same for two views.
pub fn equalSlices<T :: [Equatable]>(a: Slice<T>, b: Slice<T>): bool {
    return sameElements(a, b);
}

/// Equality of two optionals: both absent, or both present and equal (03 O6).
pub fn equalOptionals<T :: [Equatable]>(a: ?T, b: ?T): bool {
    if (a == null) { return b == null; }
    if (b == null) { return false; }
    return a == b;
}

/// An optional into a hasher: a 0 for `null`, a 1 and the value otherwise — a synthesized `hash`
/// reaches for it. An array and a view are no `Hashable` (10 C8): their slots can be written.
pub fn hashOptionalInto<T :: [Hashable], H :: [Hasher]>(o: ?T, &h: H): void {
    if (o == null) {
        h.writeByte(0);
        return;
    }
    h.writeByte(1);
    o.hash(&h);
}

/// An object's identity into a hasher: its address, what the `hash` of an `Identity` writes.
pub fn hashIdentityInto<T :: [Identity], H :: [Hasher]>(o: T, &h: H): void {
    h.writeInt(identityOf(o));
}

/// The address of an object, as a number.
fn identityOf<T>(o: T): int;

/// A copy of an array with every element cloned — the clone of a reference field (04 D13).
pub fn cloneArray<T :: [Clone]>(xs: T[]): T[] {
    return arrayOf(xs.length(), (i: int) => xs[i].clone());
}

/// The same for an optional.
pub fn cloneOptional<T :: [Clone]>(o: ?T): ?T {
    if (o == null) { return null; }
    return o.clone();
}

/// `sequence { yield 1; yield 2; }` (design/v5/spec/08 Y11, 10 I7): the shortest way to write a
/// generator inline. No syntax of its own: the trailing block is a generator lambda (08 F5), and
/// this calls it — the coroutine it makes runs nothing until it is pulled.
pub fn sequence<T>(body: fn() -> Coroutine<T>): Coroutine<T> {
    return body();
}

// --- equality and display of arrays and views (10 C9; M8a S14) ----------------------------------
// Element by element. The debug text is `[1, 2, 3]`, each element in its own debug text — a string
// quoted, `["a", "b"]`, where its bounds would be lost unquoted —, and the display text is the
// same, so an f-string prints a container (C9). Written into the caller's builder (10 S6).

extend<T :: [Equatable]> T[] :: [Equatable] {
    fn equals(o: T[]): bool {
        return sameElements(this, o);
    }
}

extend<T :: [Equatable]> Slice<T> :: [Equatable] {
    fn equals(o: Slice<T>): bool {
        return sameElements(this, o);
    }
}

extend<T :: [Debug]> T[] :: [Debug, Display] {
    fn debug(): string {
        return debugText(this);
    }

    fn debugTo(out: StringBuilder): void {
        debugElements(this, out);
    }

    fn show(): string {
        return debugText(this);
    }

    fn showTo(out: StringBuilder): void {
        debugElements(this, out);
    }
}

extend<T :: [Debug]> Slice<T> :: [Debug, Display] {
    fn debug(): string {
        return debugText(this);
    }

    fn debugTo(out: StringBuilder): void {
        debugElements(this, out);
    }

    fn show(): string {
        return debugText(this);
    }

    fn showTo(out: StringBuilder): void {
        debugElements(this, out);
    }
}

/// Whether two views hold equal elements in the same order.
fn sameElements<T :: [Equatable]>(a: Slice<T>, b: Slice<T>): bool {
    if (a.length() != b.length()) {
        return false;
    }
    for (i in 0..a.length()) {
        if (!(a[i] == b[i])) {
            return false;
        }
    }
    return true;
}

/// The elements' debug texts in brackets, `, ` between each two, into `out`.
fn debugElements<T :: [Debug]>(xs: Slice<T>, out: StringBuilder): void {
    out.appendChar('[');
    for (i in 0..xs.length()) {
        if (i > 0) {
            out.appendStr(", ");
        }
        xs[i].debugTo(out);
    }
    out.appendChar(']');
}

/// The same as a string of its own.
fn debugText<T :: [Debug]>(xs: Slice<T>): string {
    let out = StringBuilder.new();
    debugElements(xs, out);
    return out.toString();
}

// --- optionals and arrays (N2a) --------------------------------------------------------------

/// An optional is Equatable where its value's type is (03 O6): `null` equals `null` only — what
/// `==` on two optionals already did, now a conformance a constraint finds (`Set<?int>`).
extend<T :: [Equatable]> ?T :: [Equatable] {
    fn equals(o: ?T): bool {
        return equalOptionals(this, o);
    }
}

/// An optional is Hashable where its value's type is: `null` and a value hash apart.
extend<T :: [Hashable]> ?T :: [Hashable] {
    fn hash<H :: [Hasher]>(&h: H): void {
        hashOptionalInto(this, &h);
    }
}

/// An optional is Debug where its value's type is (10, "Review 2026-10-09" S1; M8c S16): `null`,
/// or the value's own debug text — no wrapper, as an optional has none (Kotlin's form, not Rust's
/// `Some(7)`) —, so `assertEq('7'.toDigit(10), 7)` names both sides. The text a synthesized
/// `debug()` gives an optional field already.
extend<T :: [Debug]> ?T :: [Debug] {
    fn debug(): string {
        return debugOptional(this);
    }
}

/// An array is Clone where its element is (10 K5): a new array of the elements' clones.
extend<T :: [Clone]> T[] :: [Clone] {
    fn clone(): T[] {
        return cloneArray(this);
    }
}

/// An optional clones its value (05 §14 rule 2: the synthesized `clone` takes a field as a whole).
extend<T :: [Clone]> ?T :: [Clone] {
    fn clone(): ?T {
        return cloneOptional(this);
    }
}

/// A tuple clones its elements.
extend<T0 :: [Clone], T1 :: [Clone]> (T0, T1) :: [Clone] {
    fn clone(): (T0, T1) {
        return (this.0.clone(), this.1.clone());
    }
}

extend<T0 :: [Clone], T1 :: [Clone], T2 :: [Clone]> (T0, T1, T2) :: [Clone] {
    fn clone(): (T0, T1, T2) {
        return (this.0.clone(), this.1.clone(), this.2.clone());
    }
}

// --- tuples (03 T16, 04 D7; N2a) --------------------------------------------------------------
//
// A tuple is Equatable, Hashable, Debug and Display where its elements are — the conditional
// synthesis D7 gives structs, written here for each arity from 2 to 8 (a generator wrote them;
// Rust's own impls stop at 12). Equality and hash take the elements in order; Debug writes
// `(1, "x")`, Display `(1, x)`.

extend<T0 :: [Equatable], T1 :: [Equatable]> (T0, T1) :: [Equatable] {
    fn equals(o: (T0, T1)): bool {
        return this.0 == o.0 && this.1 == o.1;
    }
}

extend<T0 :: [Hashable], T1 :: [Hashable]> (T0, T1) :: [Hashable] {
    fn hash<H :: [Hasher]>(&h: H): void {
        this.0.hash(&h);
        this.1.hash(&h);
    }
}

extend<T0 :: [Debug], T1 :: [Debug]> (T0, T1) :: [Debug] {
    fn debug(): string {
        let out = StringBuilder.new();
        this.debugTo(out);
        return out.toString();
    }

    fn debugTo(out: StringBuilder): void {
        out.appendChar('(');
        this.0.debugTo(out);
        out.appendStr(", ");
        this.1.debugTo(out);
        out.appendChar(')');
    }
}

extend<T0 :: [Display], T1 :: [Display]> (T0, T1) :: [Display] {
    fn show(): string {
        let out = StringBuilder.new();
        this.showTo(out);
        return out.toString();
    }

    fn showTo(out: StringBuilder): void {
        out.appendChar('(');
        this.0.showTo(out);
        out.appendStr(", ");
        this.1.showTo(out);
        out.appendChar(')');
    }
}

extend<T0 :: [Equatable], T1 :: [Equatable], T2 :: [Equatable]> (T0, T1, T2) :: [Equatable] {
    fn equals(o: (T0, T1, T2)): bool {
        return this.0 == o.0 && this.1 == o.1 && this.2 == o.2;
    }
}

extend<T0 :: [Hashable], T1 :: [Hashable], T2 :: [Hashable]> (T0, T1, T2) :: [Hashable] {
    fn hash<H :: [Hasher]>(&h: H): void {
        this.0.hash(&h);
        this.1.hash(&h);
        this.2.hash(&h);
    }
}

extend<T0 :: [Debug], T1 :: [Debug], T2 :: [Debug]> (T0, T1, T2) :: [Debug] {
    fn debug(): string {
        let out = StringBuilder.new();
        this.debugTo(out);
        return out.toString();
    }

    fn debugTo(out: StringBuilder): void {
        out.appendChar('(');
        this.0.debugTo(out);
        out.appendStr(", ");
        this.1.debugTo(out);
        out.appendStr(", ");
        this.2.debugTo(out);
        out.appendChar(')');
    }
}

extend<T0 :: [Display], T1 :: [Display], T2 :: [Display]> (T0, T1, T2) :: [Display] {
    fn show(): string {
        let out = StringBuilder.new();
        this.showTo(out);
        return out.toString();
    }

    fn showTo(out: StringBuilder): void {
        out.appendChar('(');
        this.0.showTo(out);
        out.appendStr(", ");
        this.1.showTo(out);
        out.appendStr(", ");
        this.2.showTo(out);
        out.appendChar(')');
    }
}

extend<T0 :: [Equatable], T1 :: [Equatable], T2 :: [Equatable], T3 :: [Equatable]> (T0, T1, T2, T3) :: [Equatable] {
    fn equals(o: (T0, T1, T2, T3)): bool {
        return this.0 == o.0 && this.1 == o.1 && this.2 == o.2 && this.3 == o.3;
    }
}

extend<T0 :: [Hashable], T1 :: [Hashable], T2 :: [Hashable], T3 :: [Hashable]> (T0, T1, T2, T3) :: [Hashable] {
    fn hash<H :: [Hasher]>(&h: H): void {
        this.0.hash(&h);
        this.1.hash(&h);
        this.2.hash(&h);
        this.3.hash(&h);
    }
}

extend<T0 :: [Debug], T1 :: [Debug], T2 :: [Debug], T3 :: [Debug]> (T0, T1, T2, T3) :: [Debug] {
    fn debug(): string {
        let out = StringBuilder.new();
        this.debugTo(out);
        return out.toString();
    }

    fn debugTo(out: StringBuilder): void {
        out.appendChar('(');
        this.0.debugTo(out);
        out.appendStr(", ");
        this.1.debugTo(out);
        out.appendStr(", ");
        this.2.debugTo(out);
        out.appendStr(", ");
        this.3.debugTo(out);
        out.appendChar(')');
    }
}

extend<T0 :: [Display], T1 :: [Display], T2 :: [Display], T3 :: [Display]> (T0, T1, T2, T3) :: [Display] {
    fn show(): string {
        let out = StringBuilder.new();
        this.showTo(out);
        return out.toString();
    }

    fn showTo(out: StringBuilder): void {
        out.appendChar('(');
        this.0.showTo(out);
        out.appendStr(", ");
        this.1.showTo(out);
        out.appendStr(", ");
        this.2.showTo(out);
        out.appendStr(", ");
        this.3.showTo(out);
        out.appendChar(')');
    }
}

