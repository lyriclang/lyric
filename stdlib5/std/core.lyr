        return exactly(v);
    }

    /// `v` as an `uint32`, held at `min` or `max` where it does not fit.
    static fn clamping<T :: [Integer]>(v: T): uint32 {
        return clamped(v);
    }
}

extend float :: [Num, Signed, Float] {
    static let zero: float = 0.0;
    static let one: float = 1.0;
    static let epsilon: float = 2.220446049250313e-16;
    static let infinity: float = float.fromBits(0x7FF0000000000000);
    static let nan: float = float.fromBits(0x7FF8000000000000);
    static let min: float = -1.7976931348623157e308;
    static let max: float = 1.7976931348623157e308;
    static let leastPositive: float = 5e-324;

    static fn fromBits(b: uint64): float {
        return floatFromBits(b, float.zero);
    }

    /// The float a text names, the nearest one (`Parse`).
    static fn parse(s: string): float throws ParseError {
        try checkFloatText(s);
        return floatOfText(s);
    }
}

extend float32 :: [Num, Signed, Float] {
    static let zero: float32 = 0.0;
    static let one: float32 = 1.0;
    static let epsilon: float32 = 1.1920928955078125e-7;
    static let infinity: float32 = float32.fromBits(0x7F800000);
    static let nan: float32 = float32.fromBits(0x7FC00000);
    static let min: float32 = -3.4028234663852886e38;
    static let max: float32 = 3.4028234663852886e38;
    static let leastPositive: float32 = 1.401298464324817e-45;

    static fn fromBits(b: uint64): float32 {
        return floatFromBits(b, float32.zero);
    }

    /// The float a text names, the nearest one (`Parse`).
    static fn parse(s: string): float32 throws ParseError {
        try checkFloatText(s);
        return float32OfText(s);
    }
}

// ---------------------------------------------------------------------------------------------
// Parsing (design/v5/spec/10 B3, B4, B5 Z6): a value read from a text, and what is wrong with the
// text thrown — the text is the data's, so it never panics. An integer is read here in Lyric over
// the string's bytes; a float's form is checked here and its value read by C, correctly rounded.
// ---------------------------------------------------------------------------------------------

/// Why a text is not a value of the type.
pub enum ParseErrorKind :: [Equatable, Debug] { Empty, Invalid, Overflow }

/// What `parse` throws (10 B3): the text was empty, was not of the type's form, or named a number
/// beyond the type's range.
pub struct ParseError :: [Error] {
    /// Why.
    pub kind: ParseErrorKind,

    pub fn message(): string {
        return match (this.kind) {
            .Empty => "cannot parse a value from an empty text",
            .Invalid => "the text is not a value of the type",
            .Overflow => "the number is beyond the type's range",
        };
    }
}

/// A type read from a text: `T.parse(s)`, throwing `ParseError` with the reason. The number types
/// conform through `Num`, and `bool`.
pub interface Parse {
    static fn parse(s: string): Self throws ParseError;
}

extend bool :: [Parse] {
    /// `true` or `false`, exactly.
    static fn parse(s: string): bool throws ParseError {
        if (s == "true") {
            return true;
        }
        if (s == "false") {
            return false;
        }
        throw ParseError { kind = if (s == "") ParseErrorKind.Empty else ParseErrorKind.Invalid };
    }
}

/// The integer a text names in `radix` (10 B5 Z6): an optional `+` or `-`, ASCII digits, `_`
/// between two of them, nothing else. A radix outside 2…36 is the program's error and panics (B3).
/// A byte outside the form is `Invalid` however many digits run before it — only a well-formed
/// number is an `Overflow`. Negative numbers accumulate downward, so `min` is reached.
fn parseInteger<T :: [Integer]>(s: string, radix: int): T throws ParseError {
    if (radix < 2 || radix > 36) {
        panic(f"radix {radix} is outside 2..36");
    }
    let n = byteCount(s);
    if (n == 0) {
        throw ParseError { kind = ParseErrorKind.Empty };
    }
    let negative = byteAt(s, 0) == 45;
    var i = if (negative || byteAt(s, 0) == 43) 1 else 0;
    if (i == n || (negative && !T.isSigned)) {
        throw ParseError { kind = ParseErrorKind.Invalid };
    }
    let base = asTypeOf(radix, T.zero);
    var value = T.zero;
    var overflowed = false;
    var afterDigit = false;
    while (i < n) {
        let b = byteAt(s, i);
        i = i + 1;
        if (b == 95) {
            if (!afterDigit || i == n) {
                throw ParseError { kind = ParseErrorKind.Invalid };
            }
            afterDigit = false;
            continue;
        }
        let d = digitValue(b);
        if (d >= radix) {
            throw ParseError { kind = ParseErrorKind.Invalid };
        }
        afterDigit = true;
        if (!overflowed) {
            let digit = asTypeOf(d, T.zero);
            let scaled = value.checkedMul(base);
            if (scaled == null) {
                overflowed = true;
            } else {
                let next = if (negative) scaled.checkedSub(digit) else scaled.checkedAdd(digit);
                if (next == null) {
                    overflowed = true;
                } else {
                    value = next;
                }
            }
        }
    }
    if (overflowed) {
        throw ParseError { kind = ParseErrorKind.Overflow };
    }
    return value;
}

/// `v` in `U` where it fits, `null` where it does not (10 B5 Z4): converted as `as` wraps, it
/// fits exactly when it comes back the same and keeps its sign.
fn exactly<T :: [Integer], U :: [Integer]>(v: T): ?U {
    let w = asTypeOf(v, U.zero);
    if (asTypeOf(w, v) != v || (v < T.zero) != (w < U.zero)) {
        return null;
    }
    return w;
}

/// `v` in `U`, held at `U.min` or `U.max` where it does not fit.
fn clamped<T :: [Integer], U :: [Integer]>(v: T): U {
    let w: ?U = exactly(v);
    return w ?? (if (v < T.zero) U.min else U.max);
}

/// A byte's value as a digit — `0`…`9`, then `a`…`z` or `A`…`Z` for 10…35 — and 36 for any other.
fn digitValue(b: int): int {
    if (b >= 48 && b <= 57) {
        return b - 48;
    }
    if (b >= 97 && b <= 122) {
        return b - 87;
    }
    if (b >= 65 && b <= 90) {
        return b - 55;
    }
    return 36;
}

/// Whether a byte is an ASCII digit.
fn isDigit(b: int): bool {
    return b >= 48 && b <= 57;
}

/// A float's form (10 B5 Z6), thrown where the text is not of it: an optional sign, then `inf`,
/// `nan`, or digits with an optional `.` and fraction — one digit at least — and an optional
/// exponent, `e` or `E` with its own sign and digits; `_` between two digits, nothing else.
fn checkFloatText(s: string): void throws ParseError {
    let n = byteCount(s);
    if (n == 0) {
        throw ParseError { kind = ParseErrorKind.Empty };
    }
    var i = if (byteAt(s, 0) == 43 || byteAt(s, 0) == 45) 1 else 0;
    if (n - i == 3 && (isWord(s, i, 105, 110, 102) || isWord(s, i, 110, 97, 110))) {
        return;
    }
    var digits = 0;
    var point = false;
    var afterDigit = false;
    while (i < n) {
        let b = byteAt(s, i);
        if (isDigit(b)) {
            digits = digits + 1;
            afterDigit = true;
        } else if (b == 95 && afterDigit && i + 1 < n && isDigit(byteAt(s, i + 1))) {
            afterDigit = false;
        } else if (b == 46 && !point) {
            point = true;
            afterDigit = false;
        } else {
            break;
        }
        i = i + 1;
    }
    if (digits == 0) {
        throw ParseError { kind = ParseErrorKind.Invalid };
    }
    if (i == n) {
        return;
    }
    if (byteAt(s, i) != 101 && byteAt(s, i) != 69) {
        throw ParseError { kind = ParseErrorKind.Invalid };
    }
    i = i + 1;
    if (i < n && (byteAt(s, i) == 43 || byteAt(s, i) == 45)) {
        i = i + 1;
    }
    var exponent = 0;
    afterDigit = false;
    while (i < n) {
        let b = byteAt(s, i);
        if (isDigit(b)) {
            exponent = exponent + 1;
            afterDigit = true;
        } else if (b == 95 && afterDigit && i + 1 < n && isDigit(byteAt(s, i + 1))) {
            afterDigit = false;
        } else {
            throw ParseError { kind = ParseErrorKind.Invalid };
        }
        i = i + 1;
    }
    if (exponent == 0) {
        throw ParseError { kind = ParseErrorKind.Invalid };
    }
}

/// Whether the three bytes at `i` are `a`, `b`, `c`.
fn isWord(s: string, i: int, a: int, b: int, c: int): bool {
    return byteAt(s, i) == a && byteAt(s, i + 1) == b && byteAt(s, i + 2) == c;
}

// The natives parsing stands on: a string's length and bytes until `StringView` gives the library
// its bytes (M8a S8), a number converted as `as` converts it (03 T1d) to the type of `like` where
// that is a parameter's, a float's text read by C (`strtod`, `strtof`) once its form is checked.
fn byteCount(s: string): int;
fn byteAt(s: string, i: int): int;
fn asTypeOf<T, U>(v: T, like: U): U;
fn floatOfText(s: string): float;
fn float32OfText(s: string): float32;


// ---------------------------------------------------------------------------------------------
// Iteration (design/v5/spec/10 B6): a source of values, one at a time, and what `for` walks.
// ---------------------------------------------------------------------------------------------

/// A source of values, one at a time (10 B6 I1): `next()` gives the next, and `null` at the end —
/// for good, once given. A struct iterator changes as it goes, so `next` writes it. A walk that
/// can fail — a file's lines — answers its `Error`, and `next()` throws it (I5): the loop over it
/// is marked, `for (line in try lines)`.
pub interface Iterator {
    type Item;

    /// What a walk may throw: nothing, unless a conformer answers otherwise.
    type Error :: [Error] = never;

    mut fn next(): ?Self.Item throws Self.Error;

    /// How many values are left: at least the first, at most the second where that is known — for
    /// a collector that sizes its storage once.
    fn sizeHint(): (int, ?int) {
        let unknown: ?int = null;
        return (0, unknown);
    }
}

/// What `for` walks (I2): `iter()` gives an iterator over it, at every loop anew. Every iterator
/// is iterable as itself: a struct iterator as a copy, a class iterator as the object — two loops
/// over one go on from each other.
pub interface Iterable {
    type Iter :: [Iterator];

    fn iter(): Self.Iter;
}

/// An iterator from both ends (I10): `nextBack()` gives the last value not yet given.
pub interface DoubleEnded :: [Iterator] {
    mut fn nextBack(): ?Self.Item;
}

extend<I :: [Iterator]> I :: [Iterable<Iter = I>] {
    fn iter(): I {
        return this;
    }
}

// A range is an iterator of its own values, from both ends (I10): the value changes as it is
// walked — a 'let' range is walked through a copy, as `for` takes one.
extend<T :: [Integer]> Range<T> :: [Iterator, DoubleEnded] {
    type Item = T;

    mut fn next(): ?T {
        if (this.start >= this.end) {
            return null;
        }
        let value = this.start;
        this.start = this.start + T.one;
        return value;
    }

    mut fn nextBack(): ?T {
        if (this.start >= this.end) {
            return null;
        }
        this.end = this.end - T.one;
        return this.end;
    }
}

/// The iterator of an array or a view (10 B6 I10): its elements from the front and from the
/// back, through a view of them — nothing is copied, and a write to a later element is seen.
pub struct SliceIter<T> {
    items: Slice<T>,
    var front: int,
    var back: int,
}

extend<T> SliceIter<T> :: [Iterator, DoubleEnded] {
    type Item = T;

    mut fn next(): ?T {
        if (this.front >= this.back) {
            return null;
        }
        this.front = this.front + 1;
        return this.items[this.front - 1];
    }

    mut fn nextBack(): ?T {
        if (this.front >= this.back) {
            return null;
        }
        this.back = this.back - 1;
        return this.items[this.back];
    }

    /// Exactly the elements left.
    fn sizeHint(): (int, ?int) {
        let left = this.back - this.front;
        let most: ?int = left;
        return (left, most);
    }
}

extend<T> T[] :: [Iterable] {
    type Iter = SliceIter<T>;

    fn iter(): SliceIter<T> {
        return SliceIter<T> { items = this, front = 0, back = this.length() };
    }
}

extend<T> Slice<T> :: [Iterable] {
    type Iter = SliceIter<T>;

    fn iter(): SliceIter<T> {
        return SliceIter<T> { items = this, front = 0, back = this.length() };
    }
}

// --- the members of arrays and views (10 C2): written once on `Slice<T>`, and reached on an
// array through a view of the whole of it (03 §5.2 rule 4). A write goes to the array.
extend<T> Slice<T> {
    /// Whether there is no element.
    pub fn isEmpty(): bool {
        return this.length() == 0;
    }

    /// The element at `i`, or `null` outside `0 ≤ i < length()`.
    pub fn get(i: int): ?T {
        if (i < 0 || i >= this.length()) {
            return null;
        }
        return this[i];
    }

    /// The first element, or `null` where there is none.
    pub fn first(): ?T {
        return this.get(0);
    }

    /// The last element, or `null` where there is none.
    pub fn last(): ?T {
        return this.get(this.length() - 1);
    }

    /// The elements at `i` and `j` exchanged; an index outside panics as `[i]` does.
    pub fn swap(i: int, j: int): void {
        let t = this[i];
        this[i] = this[j];
        this[j] = t;
    }

    /// The elements in place, the last first.
    pub fn reverse(): void {
        var i = 0;
        var j = this.length() - 1;
        while (i < j) {
            this.swap(i, j);
            i = i + 1;
            j = j - 1;
        }
    }

    /// A new array of the elements, the last first.
    pub fn reversed(): T[] {
        let n = this.length();
        return arrayOf(n, (i: int) => this[n - 1 - i]);
    }

    /// The first index whose element fails `p`, for elements that `p` partitions — every one it
    /// holds for before every one it does not: a binary search.
    pub fn partitionPoint(p: fn(T) -> bool): int {
        var lo = 0;
        var hi = this.length();
        while (lo < hi) {
            let mid = lo + (hi - lo) / 2;
            if (p(this[mid])) {
                lo = mid + 1;
            } else {
                hi = mid;
            }
        }
        return lo;
    }
}

/// `x in xs` (10 C12): an element equal to `x`.
extend<T :: [Equatable]> Slice<T> :: [Contains<T>] {
    fn contains(x: T): bool {
        return this.indexOf(x) != null;
    }
}

extend<T :: [Equatable]> T[] :: [Contains<T>] {
    fn contains(x: T): bool {
        return this[..].contains(x);
    }
}

extend<T :: [Equatable]> Slice<T> {
    /// The index of the first element equal to `x`, or `null`.
    pub fn indexOf(x: T): ?int {
        var i = 0;
        while (i < this.length()) {
            if (this[i] == x) {
                return i;
            }
            i = i + 1;
        }
        return null;
    }
}

extend<T :: [Clone]> Slice<T> {
    /// Every element a clone of `v` — no object shared into several slots (10 C7).
    pub fn fill(v: T): void {
        var i = 0;
        while (i < this.length()) {
            this[i] = v.clone();
            i = i + 1;
        }
    }
}

extend<T :: [TotalOrder]> Slice<T> {
    /// The index of an element equal to `x` in sorted elements, or `null` (10 C10: a `NaN` would
    /// break the order the search relies on, so a total one is asked).
    pub fn binarySearch(x: T): ?int {
        let at = this.partitionPoint((e: T) => e < x);
        if (at < this.length() && this[at] == x) {
            return at;
        }
        return null;
    }
}

extend<T :: [Display]> Slice<T> {
    /// The elements' texts, `sep` between each two.
    pub fn join(sep: string): string {
        var out = "";
        var i = 0;
        while (i < this.length()) {
            if (i > 0) {
                out = out + sep;
            }
            out = out + f"{this[i]}";
            i = i + 1;
        }
        return out;
    }
}

/// `it.map(f)` (10 B6 I3, I4): the values of `it`, each through `f` — lazily, a pull at a time.
/// Named for what it gives: `Map` is the collection's (C4).
pub struct Mapped<I :: [Iterator], U> :: [Iterator] {
    type Item = U;
    type Error = I.Error;
    var inner: I,
    f: fn(I.Item) -> U,

    pub mut fn next(): ?U throws I.Error {
        let x = try this.inner.next();
        if (x == null) {
            return null;
        }
        return this.f(x);
    }
}

/// `it.filter(p)`: the values of `it` that `p` holds for.
pub struct Filter<I :: [Iterator]> :: [Iterator] {
    type Item = I.Item;
    type Error = I.Error;
    var inner: I,
    p: fn(I.Item) -> bool,

    pub mut fn next(): ?I.Item throws I.Error {
        var x = try this.inner.next();
        while (x != null && !this.p(x)) {
            x = try this.inner.next();
        }
        return x;
    }
}

/// `it.take(n)`: the first `n` values of `it`, or all where it has fewer.
pub struct Take<I :: [Iterator]> :: [Iterator] {
    type Item = I.Item;
    type Error = I.Error;
    var inner: I,
    var left: int,

    pub mut fn next(): ?I.Item throws I.Error {
        if (this.left <= 0) {
            return null;
        }
        this.left = this.left - 1;
        return try this.inner.next();
    }
}

/// `it.skip(n)`: the values of `it` after its first `n`.
pub struct Skip<I :: [Iterator]> :: [Iterator] {
    type Item = I.Item;
    type Error = I.Error;
    var inner: I,
    var n: int,

    pub mut fn next(): ?I.Item throws I.Error {
        while (this.n > 0) {
            this.n = this.n - 1;
            if (try this.inner.next() == null) {
                return null;
            }
        }
        return try this.inner.next();
    }
}

/// `it.takeWhile(p)`: the values of `it` up to the first `p` does not hold for.
pub struct TakeWhile<I :: [Iterator]> :: [Iterator] {
    type Item = I.Item;
    type Error = I.Error;
    var inner: I,
    p: fn(I.Item) -> bool,
    var done: bool,

    pub mut fn next(): ?I.Item throws I.Error {
        if (this.done) {
            return null;
        }
        let x = try this.inner.next();
        if (x == null) {
            this.done = true;
            return null;
        }
        if (!this.p(x)) {
            this.done = true;
            return null;
        }
        return x;
    }
}

/// `it.skipWhile(p)`: the values of `it` from the first `p` does not hold for.
pub struct SkipWhile<I :: [Iterator]> :: [Iterator] {
    type Item = I.Item;
    type Error = I.Error;
    var inner: I,
    p: fn(I.Item) -> bool,
    var started: bool,

    pub mut fn next(): ?I.Item throws I.Error {
        if (this.started) {
            return try this.inner.next();
        }
        this.started = true;
        var x = try this.inner.next();
        while (x != null && this.p(x)) {
            x = try this.inner.next();
        }
        return x;
    }
}

/// `it.stepBy(n)`: the first value of `it`, then every `n`th.
pub struct StepBy<I :: [Iterator]> :: [Iterator] {
    type Item = I.Item;
    type Error = I.Error;
    var inner: I,
    step: int,
    var first: bool,

    pub mut fn next(): ?I.Item throws I.Error {
        if (this.first) {
            this.first = false;
            return try this.inner.next();
        }
        var gap = this.step - 1;
        while (gap > 0) {
            gap = gap - 1;
            if (try this.inner.next() == null) {
                return null;
            }
        }
        return try this.inner.next();
    }
}

/// `it.enumerate()`: each value of `it` with its position, from 0.
pub struct Enumerate<I :: [Iterator]> :: [Iterator] {
    type Item = (int, I.Item);
    type Error = I.Error;
    var inner: I,
    var i: int,

    pub mut fn next(): ?(int, I.Item) throws I.Error {
        let x = try this.inner.next();
        if (x == null) {
            return null;
        }
        this.i = this.i + 1;
        return (this.i - 1, x);
    }
}

/// `it.inspect(f)`: the values of `it`, each shown to `f` on its way through.
pub struct Inspect<I :: [Iterator]> :: [Iterator] {
    type Item = I.Item;
    type Error = I.Error;
    var inner: I,
    f: fn(I.Item) -> void,

    pub mut fn next(): ?I.Item throws I.Error {
        let x = try this.inner.next();
        if (x != null) {
            this.f(x);
        }
        return x;
    }
}

/// The join of two thrown types (design/v5/spec/05 E2 K7): what a walk over two sources throws.
/// The compiler reduces it once both are known — one type where they are one, the other where
/// one is `never`, the root `Error` where they differ; open, it covers each of its parts. No value
/// of it is made.
pub struct Join<A :: [Error], B :: [Error]> :: [Error] {
    pub fn message(): string {
        return "a joined error";
    }
}

/// `it.zip(other)`: each value beside the other's at its position, as long as both have one.
pub struct Zip<A :: [Iterator], B :: [Iterator]> :: [Iterator] {
    type Item = (A.Item, B.Item);
    type Error = Join<A.Error, B.Error>;
    var a: A,
    var b: B,

    pub mut fn next(): ?(A.Item, B.Item) throws Join<A.Error, B.Error> {
        let x = try this.a.next();
        if (x == null) {
            return null;
        }
        let y = try this.b.next();
        if (y == null) {
            return null;
        }
        return (x, y);
    }
}

/// `it.chain(other)`: the values of `it`, then the other's.
pub struct Chain<A :: [Iterator], B :: [Iterator<Item = A.Item>]> :: [Iterator] {
    type Item = A.Item;
    type Error = Join<A.Error, B.Error>;
    var a: A,
    var b: B,
    var second: bool,

    pub mut fn next(): ?A.Item throws Join<A.Error, B.Error> {
        if (!this.second) {
            let x = try this.a.next();
            if (x != null) {
                return x;
            }
            this.second = true;
        }
        return try this.b.next();
    }
}

// The adapters (I3): members of every iterator, each a struct of its own — monomorphized, no
// allocation, no interface value.
extend<I :: [Iterator]> I {
    /// The values, each through `f`.
    pub fn map<U>(f: fn(I.Item) -> U): Mapped<I, U> {
        return Mapped<I, U> { inner = this, f = f };
    }

    /// The values `p` holds for.
    pub fn filter(p: fn(I.Item) -> bool): Filter<I> {
        return Filter<I> { inner = this, p = p };
    }

    /// The first `n` values, or all where there are fewer.
    pub fn take(n: int): Take<I> {
        return Take<I> { inner = this, left = n };
    }

    /// The values after the first `n`.
    pub fn skip(n: int): Skip<I> {
        return Skip<I> { inner = this, n = n };
    }

    /// The values up to the first `p` does not hold for.
    pub fn takeWhile(p: fn(I.Item) -> bool): TakeWhile<I> {
        return TakeWhile<I> { inner = this, p = p, done = false };
    }

    /// The values from the first `p` does not hold for.
    pub fn skipWhile(p: fn(I.Item) -> bool): SkipWhile<I> {
        return SkipWhile<I> { inner = this, p = p, started = false };
    }

    /// The first value, then every `n`th; `n` below 1 panics.
    pub fn stepBy(n: int): StepBy<I> {
        if (n < 1) {
            panic("stepBy needs a step of at least 1");
        }
        return StepBy<I> { inner = this, step = n, first = true };
    }

    /// Each value with its position, from 0.
    pub fn enumerate(): Enumerate<I> {
        return Enumerate<I> { inner = this, i = 0 };
    }

    /// The values, each shown to `f` on its way through.
    pub fn inspect(f: fn(I.Item) -> void): Inspect<I> {
        return Inspect<I> { inner = this, f = f };
    }

    /// Each value beside the other's at its position, as long as both have one.
    pub fn zip<B :: [Iterable]>(other: B): Zip<I, B.Iter> {
        return Zip<I, B.Iter> { a = this, b = other.iter() };
    }

    /// The values, then the other's — an iterator of the same items.
    pub fn chain<B :: [Iterator<Item = I.Item>]>(other: B): Chain<I, B> {
        return Chain<I, B> { a = this, b = other, second = false };
    }

    /// How many values there are, walking them all.
    pub fn count(): int throws I.Error {
        var it = this;
        var n = 0;
        while (try it.next() != null) {
            n = n + 1;
        }
        return n;
    }

    /// `f` over the values from `init`, the last result the answer.
    pub fn fold<A>(init: A, f: fn(A, I.Item) -> A): A throws I.Error {
        var it = this;
        var acc = init;
        var x = try it.next();
        while (x != null) {
            acc = f(acc, x);
            x = try it.next();
        }
        return acc;
    }

    /// `f` over the values from the first; `null` where there is none.
    pub fn reduce(f: fn(I.Item, I.Item) -> I.Item): ?I.Item throws I.Error {
        var it = this;
        let first = try it.next();
        if (first == null) {
            return null;
        }
        var acc = first;
        var x = try it.next();
        while (x != null) {
            acc = f(acc, x);
            x = try it.next();
        }
        return acc;
    }

    /// The first value, or `null`.
    pub fn first(): ?I.Item throws I.Error {
        var it = this;
        return try it.next();
    }

    /// The last value, or `null` — walking them all.
    pub fn last(): ?I.Item throws I.Error {
        var it = this;
        var last = try it.next();
        if (last == null) {
            return null;
        }
        var x = try it.next();
        while (x != null) {
            last = x;
            x = try it.next();
        }
        return last;
    }

    /// The value at position `n` from 0, or `null` — a negative `n` included.
    pub fn nth(n: int): ?I.Item throws I.Error {
        if (n < 0) {
            return null;
        }
        var it = this;
        var left = n;
        while (left > 0) {
            if (try it.next() == null) {
                return null;
            }
            left = left - 1;
        }
        return try it.next();
    }

    /// Whether `p` holds for some value; stops at the first.
    pub fn any(p: fn(I.Item) -> bool): bool throws I.Error {
        return try this.find(p) != null;
    }

    /// Whether `p` holds for every value; stops at the first it does not — `true` for none.
    pub fn all(p: fn(I.Item) -> bool): bool throws I.Error {
        return try this.find((v) => !p(v)) == null;
    }

    /// Whether `p` holds for no value.
    pub fn none(p: fn(I.Item) -> bool): bool throws I.Error {
        return try this.find(p) == null;
    }

    /// The first value `p` holds for, or `null`.
    pub fn find(p: fn(I.Item) -> bool): ?I.Item throws I.Error {
        var it = this;
        var x = try it.next();
        while (x != null && !p(x)) {
            x = try it.next();
        }
        return x;
    }

    /// The position of the first value `p` holds for, from 0, or `null`.
    pub fn position(p: fn(I.Item) -> bool): ?int throws I.Error {
        var it = this;
        var i = 0;
        var x = try it.next();
        while (x != null) {
            if (p(x)) {
                return i;
            }
            i = i + 1;
            x = try it.next();
        }
        return null;
    }

    /// `f` for every value, in order.
    pub fn forEach(f: fn(I.Item) -> void): void throws I.Error {
        var it = this;
        var x = try it.next();
        while (x != null) {
            f(x);
            x = try it.next();
        }
    }

    /// The values in an array, in order.
    pub fn toArray(): I.Item[] throws I.Error {
        var it = this;
        var out: I.Item[] = [];
        var x = try it.next();
        while (x != null) {
            out = out + [x];
            x = try it.next();
        }
        return out;
    }
}

// The terminators of an element kind (10 B6 I4): blocks whose `T` the iterator's `Item` binds
// (05 §13 rule 2), reaching the iterators of numbers, of ordered values, of shown ones.
extend<I :: [Iterator<Item = T>], T :: [Num]> I {
    /// The sum of the values; zero where there is none.
    pub fn sum(): T throws I.Error {
        var it = this;
        var s = T.zero;
        var x = try it.next();
        while (x != null) {
            s = s + x;
            x = try it.next();
        }
        return s;
    }

    /// The product of the values; one where there is none.
    pub fn product(): T throws I.Error {
        var it = this;
        var p = T.one;
        var x = try it.next();
        while (x != null) {
            p = p * x;
            x = try it.next();
        }
        return p;
    }
}

extend<I :: [Iterator<Item = T>], T :: [Ordered]> I {
    /// The least value, or `null`; the first of equal ones.
    pub fn min(): ?T throws I.Error {
        var it = this;
        let first = try it.next();
        if (first == null) {
            return null;
        }
        var least = first;
        var x = try it.next();
        while (x != null) {
            if (x < least) {
                least = x;
            }
            x = try it.next();
        }
        return least;
    }

    /// The greatest value, or `null`; the first of equal ones.
    pub fn max(): ?T throws I.Error {
        var it = this;
        let first = try it.next();
        if (first == null) {
            return null;
        }
        var most = first;
        var x = try it.next();
        while (x != null) {
            if (x > most) {
                most = x;
            }
            x = try it.next();
        }
        return most;
    }
}

extend<I :: [Iterator<Item = T>], T :: [Display]> I {
    /// The values' texts, `sep` between each two.
    pub fn join(sep: string): string throws I.Error {
        var it = this;
        var out = "";
        var x = try it.next();
        var first = true;
        while (x != null) {
            if (!first) {
                out = out + sep;
            }
            first = false;
            out = out + f"{x}";
            x = try it.next();
        }
        return out;
    }
}

// An inclusive range ends without a flag: its last value leaves `start` past `end` — or `end`
// before `start` where that value is the type's `max` (`min` from the back), so neither bound
// leaves the type.
extend<T :: [Integer]> RangeInclusive<T> :: [Iterator, DoubleEnded] {
    type Item = T;

    mut fn next(): ?T {
        if (this.start > this.end) {
            return null;
        }
        let value = this.start;
        if (value == this.end && value == T.max) {
            this.end = value - T.one;
        } else {
            this.start = value + T.one;
        }
        return value;
    }

    mut fn nextBack(): ?T {
        if (this.start > this.end) {
            return null;
        }
        let value = this.end;
        if (value == this.start && value == T.min) {
            this.start = value + T.one;
        } else {
            this.end = value - T.one;
        }
        return value;
    }
}

/// The debug rendering of an array, element by element — the shape has no conformance of its
/// own yet (05 §13.6), so a synthesized `debug()` reaches for this.
pub fn debugArray<T :: [Debug]>(xs: T[]): string {
    var out = "[";
    for (i in 0..xs.length()) {
        if (i > 0) { out = out + ", "; }
        out = out + xs[i].debug();
    }
    return out + "]";
}

/// The same for a view.
pub fn debugSlice<T :: [Debug]>(xs: Slice<T>): string {
    var out = "[";
    for (i in 0..xs.length()) {
        if (i > 0) { out = out + ", "; }
        out = out + xs[i].debug();
    }
    return out + "]";
}

/// The same for an optional: `null`, or the value.
pub fn debugOptional<T :: [Debug]>(o: ?T): string {
    if (o == null) { return "null"; }
    return o.debug();
}

/// Equality of two arrays, element by element — a synthesized `equals` reaches for it.
pub fn equalArrays<T :: [Equatable]>(a: T[], b: T[]): bool {
    if (a.length() != b.length()) { return false; }
    for (i in 0..a.length()) {
        if (!(a[i] == b[i])) { return false; }
    }
    return true;
}

/// The same for two views.
pub fn equalSlices<T :: [Equatable]>(a: Slice<T>, b: Slice<T>): bool {
    if (a.length() != b.length()) { return false; }
    for (i in 0..a.length()) {
        if (!(a[i] == b[i])) { return false; }
    }
    return true;
}

/// Equality of two optionals: both absent, or both present and equal (03 O6).
pub fn equalOptionals<T :: [Equatable]>(a: ?T, b: ?T): bool {
    if (a == null) { return b == null; }
    if (b == null) { return false; }
    return a == b;
}

/// The hash of an array, element by element.
pub fn hashArray<T :: [Hashable]>(xs: T[]): int {
    var h = 19;
    for (i in 0..xs.length()) { h = h *% 31 +% xs[i].hash(); }
    return h;
}

/// The same for a view.
pub fn hashSlice<T :: [Hashable]>(xs: Slice<T>): int {
    var h = 19;
    for (i in 0..xs.length()) { h = h *% 31 +% xs[i].hash(); }
    return h;
}

/// The hash of an optional: a constant for `null`, the value's otherwise.
pub fn hashOptional<T :: [Hashable]>(o: ?T): int {
    if (o == null) { return 23; }
    return o.hash();
}

/// A copy of an array with every element cloned — the clone of a reference field (04 D13).
pub fn cloneArray<T :: [Clone]>(xs: T[]): T[] {
    return arrayOf(xs.length(), (i: int) => xs[i].clone());
}

/// The same for an optional.
pub fn cloneOptional<T :: [Clone]>(o: ?T): ?T {
    if (o == null) { return null; }
    return o.clone();
}

/// `sequence { yield 1; yield 2; }` (design/v5/spec/08 Y11, 10 I7): the shortest way to write a
/// generator inline. No syntax of its own: the trailing block is a generator lambda (08 F5), and
/// this calls it — the coroutine it makes runs nothing until it is pulled.
pub fn sequence<T>(body: fn() -> Coroutine<T>): Coroutine<T> {
    return body();
}
