    fn compare(o: float32): ?Ordering {
        if (this < o) { return Ordering.Less; }
        if (this > o) { return Ordering.Greater; }
        if (this == o) { return Ordering.Equal; }
        return null;
    }
    fn show(): string { return f"{this}"; }
    fn add(rhs: float32): float32 { return this + rhs; }
    fn sub(rhs: float32): float32 { return this - rhs; }
    fn mul(rhs: float32): float32 { return this * rhs; }
    fn div(rhs: float32): float32 { return this / rhs; }
    fn rem(rhs: float32): float32 { return this % rhs; }
    fn neg(): float32 { return -this; }
}

extend bool :: [Equatable, Hashable, Display] {
    fn equals(o: bool): bool { return this == o; }
    fn hash(): int { return if (this) 1 else 0; }
    fn show(): string { return f"{this}"; }
}

extend char :: [Equatable, Ordered, TotalOrder, Hashable, Display] {
    fn equals(o: char): bool { return this == o; }
    fn compare(o: char): ?Ordering {
        if (this < o) { return Ordering.Less; }
        if (this > o) { return Ordering.Greater; }
        return Ordering.Equal;
    }
    fn totalCompare(o: char): Ordering {
        if (this < o) { return Ordering.Less; }
        if (this > o) { return Ordering.Greater; }
        return Ordering.Equal;
    }
    fn hash(): int { return (this as uint32) as int; }
    fn show(): string { return f"{this}"; }
}

extend string :: [Equatable, Display, Add] {
    fn equals(o: string): bool { return this == o; }
    fn show(): string { return this; }
    fn add(rhs: string): string { return this + rhs; }
}

// ---------------------------------------------------------------------------------------------
// The synthesized conformances (design/v5/spec/04 D7): a conformance written without a body is
// implemented from the fields — 'Debug' for every type that writes none. The scalars conform
// below; the shapes a field may have render through the helpers at the end.
// ---------------------------------------------------------------------------------------------

/// The debug rendering of a value: `P { x = 1, y = "a" }`, `E.B(3)`. Every struct, class and enum
/// has one, written or synthesized (04 D7); a string renders quoted.
pub interface Debug {
    fn debug(): string;
}

/// A copy of the value: value fields copied, reference fields cloned (04 D13). Synthesized for a
/// conformance without a body.
pub interface Clone {
    fn clone(): Self;
}

/// The value a type starts from: `0`, `""`, `[]`, `null`, a field default. Synthesized field-wise.
pub interface Default {
    static fn default(): Self;
}

extend int :: [Debug, Clone, Default] {
    fn debug(): string { return f"{this}"; }
    fn clone(): int { return this; }
    static fn default(): int { return 0; }
}

extend int8 :: [Debug, Clone, Default] {
    fn debug(): string { return f"{this}"; }
    fn clone(): int8 { return this; }
    static fn default(): int8 { return 0; }
}

extend int16 :: [Debug, Clone, Default] {
    fn debug(): string { return f"{this}"; }
    fn clone(): int16 { return this; }
    static fn default(): int16 { return 0; }
}

extend int32 :: [Debug, Clone, Default] {
    fn debug(): string { return f"{this}"; }
    fn clone(): int32 { return this; }
    static fn default(): int32 { return 0; }
}

extend uint :: [Debug, Clone, Default] {
    fn debug(): string { return f"{this}"; }
    fn clone(): uint { return this; }
    static fn default(): uint { return 0; }
}

extend uint8 :: [Debug, Clone, Default] {
    fn debug(): string { return f"{this}"; }
    fn clone(): uint8 { return this; }
    static fn default(): uint8 { return 0; }
}

extend uint16 :: [Debug, Clone, Default] {
    fn debug(): string { return f"{this}"; }
    fn clone(): uint16 { return this; }
    static fn default(): uint16 { return 0; }
}

extend uint32 :: [Debug, Clone, Default] {
    fn debug(): string { return f"{this}"; }
    fn clone(): uint32 { return this; }
    static fn default(): uint32 { return 0; }
}

extend float :: [Debug, Clone, Default] {
    fn debug(): string { return f"{this}"; }
    fn clone(): float { return this; }
    static fn default(): float { return 0.0; }
}

extend float32 :: [Debug, Clone, Default] {
    fn debug(): string { return f"{this}"; }
    fn clone(): float32 { return this; }
    static fn default(): float32 { return 0.0; }
}

extend bool :: [Debug, Clone, Default] {
    fn debug(): string { return f"{this}"; }
    fn clone(): bool { return this; }
    static fn default(): bool { return false; }
}

extend char :: [Debug, Clone] {
    fn debug(): string { return f"'{this}'"; }
    fn clone(): char { return this; }
}

// A char's code point both ways (10 B5 Z8): outside the tower, and the way in answers `null`
// where `as char` would panic — a number from data is no programmer's error (B3).
extend char {
    /// The Unicode scalar value, 0…0x10FFFF.
    pub fn toUint32(): uint32 {
        return this as uint32;
    }

    /// The character of a scalar value; `null` for a surrogate, 0xD800…0xDFFF, or beyond
    /// 0x10FFFF.
    pub static fn fromUint32(n: uint32): ?char {
        if (n > 0x10FFFF || (n >= 0xD800 && n <= 0xDFFF)) {
            return null;
        }
        return n as char;
    }
}

extend string :: [Debug, Clone, Default] {
    fn debug(): string { return "\"" + this + "\""; }
    fn clone(): string { return this; }
    static fn default(): string { return ""; }
}

// ---------------------------------------------------------------------------------------------
// The numbers (design/v5/spec/10 B5): ten types, one tower of interfaces with static members.
// Arithmetic stays in the type — the parent lists fix 'Out' (05 §8 rule 7) — and the defaults are
// each type's own (04 D9): 'int8.min.abs()' is a direct call, no value of an interface made.
// ---------------------------------------------------------------------------------------------

/// Every number type (10 B5 Z1): its zero and its one, arithmetic that stays in the type.
pub interface Num :: [Equatable, Ordered, Add<Out = Self>, Sub<Out = Self>, Mul<Out = Self>,
    Div<Out = Self>, Rem<Out = Self>, Display, Debug, Parse, Default] {
    static let zero: Self;
    static let one: Self;

    /// Whether this is the type's zero.
    fn isZero(): bool {
        return this == Self.zero;
    }
}

/// A number with a sign: the signed integers and the floats. `uint` has no `abs`.
pub interface Signed :: [Num, Neg<Out = Self>] {
    /// The value without its sign: `0.0` for `-0.0`, which `<` does not tell from `0.0`.
    fn abs(): Self {
        if (this < Self.zero) {
            return -this;
        }
        return if (this == Self.zero) Self.zero else this;
    }

    /// `-1`, `0` or `1` as a value of the type; a float's NaN stays NaN.
    fn signum(): Self {
        if (!(this == this)) {
            return this;
        }
        if (this < Self.zero) {
            return -Self.one;
        }
        if (this > Self.zero) {
            return Self.one;
        }
        return Self.zero;
    }
}

/// The eight integer types: their range, a total order, a hash, the bit operators.
pub interface Integer :: [Num, TotalOrder, Hashable, BitAnd<Out = Self>, BitOr<Out = Self>,
    BitXor<Out = Self>, BitNot<Out = Self>, Shl<Out = Self>, Shr<Out = Self>] {
    static let min: Self;
    static let max: Self;
    static let bitWidth: int;
    static let isSigned: bool;

    /// The sum, or `null` where it does not fit the type.
    fn checkedAdd(o: Self): ?Self {
        return if (addOverflows(this, o)) null else addWrapping(this, o);
    }

    /// The difference, or `null` where it does not fit.
    fn checkedSub(o: Self): ?Self {
        return if (subOverflows(this, o)) null else subWrapping(this, o);
    }

    /// The product, or `null` where it does not fit.
    fn checkedMul(o: Self): ?Self {
        return if (mulOverflows(this, o)) null else mulWrapping(this, o);
    }

    /// The quotient, or `null` for a zero divisor and for `min / -1`, which does not fit.
    fn checkedDiv(o: Self): ?Self {
        if (o == Self.zero || (Self.isSigned && this == Self.min && o == Self.zero - Self.one)) {
            return null;
        }
        return this / o;
    }

    /// The remainder, or `null` for a zero divisor; a remainder by `-1` is `0`.
    fn checkedRem(o: Self): ?Self {
        if (o == Self.zero) {
            return null;
        }
        if (Self.isSigned && o == Self.zero - Self.one) {
            return Self.zero;
        }
        return this % o;
    }

    /// The sum, held at `min` or `max` where it does not fit.
    fn saturatingAdd(o: Self): Self {
        return this.checkedAdd(o) ?? (if (o < Self.zero) Self.min else Self.max);
    }

    /// The difference, held at `min` or `max` where it does not fit.
    fn saturatingSub(o: Self): Self {
        return this.checkedSub(o) ?? (if (o < Self.zero) Self.max else Self.min);
    }

    /// The product, held at `min` or `max` by the sign it would have.
    fn saturatingMul(o: Self): Self {
        return this.checkedMul(o) ?? (if ((this < Self.zero) != (o < Self.zero)) Self.min else Self.max);
    }

    /// The sum modulo 2^bitWidth, as `+%` on the type (08 Y4).
    fn wrappingAdd(o: Self): Self {
        return addWrapping(this, o);
    }

    /// The difference modulo 2^bitWidth, as `-%`.
    fn wrappingSub(o: Self): Self {
        return subWrapping(this, o);
    }

    /// The product modulo 2^bitWidth, as `*%`.
    fn wrappingMul(o: Self): Self {
        return mulWrapping(this, o);
    }

    /// The quotient, where `min / -1` wraps to `min`; a zero divisor panics as `/` does.
    fn wrappingDiv(o: Self): Self {
        if (Self.isSigned && this == Self.min && o == Self.zero - Self.one) {
            return Self.min;
        }
        return this / o;
    }

    /// The remainder, where a remainder by `-1` is `0`; a zero divisor panics as `%` does.
    fn wrappingRem(o: Self): Self {
        if (Self.isSigned && o == Self.zero - Self.one) {
            return Self.zero;
        }
        return this % o;
    }

    /// `this` to the `n`th power, by squaring; an overflow is one of `*` (03 T2).
    fn pow(n: uint): Self {
        var result = Self.one;
        var base = this;
        var k = n;
        while (k > 0) {
            if (k % 2 == 1) {
                result = result * base;
            }
            k = k / 2;
            if (k > 0) {
                base = base * base;
            }
        }
        return result;
    }

    /// The zero bits above the highest one bit; `bitWidth` for zero.
    fn leadingZeros(): int {
        return countLeadingZeros(this);
    }

    /// The zero bits below the lowest one bit; `bitWidth` for zero.
    fn trailingZeros(): int {
        return countTrailingZeros(this);
    }

    /// The one bits.
    fn popCount(): int {
        return countOnes(this);
    }

    /// The bits rotated left by `n`, modulo `bitWidth`; a negative `n` rotates right.
    fn rotateLeft(n: int): Self {
        return rotateBitsLeft(this, n);
    }

    /// The bits rotated right by `n`, modulo `bitWidth`; a negative `n` rotates left.
    fn rotateRight(n: int): Self {
        return rotateBitsLeft(this, -(n % Self.bitWidth));
    }
}

// The natives the defaults stand on (10 B5): one each, generic, a C builtin serving every
// integer width — whether + - * leave the type and the result wrapped to it (what `+%` gives a
// builtin, 08 Y4), the bit counts, the rotation.
fn addOverflows<T>(a: T, b: T): bool;
fn subOverflows<T>(a: T, b: T): bool;
fn mulOverflows<T>(a: T, b: T): bool;
fn addWrapping<T>(a: T, b: T): T;
fn subWrapping<T>(a: T, b: T): T;
fn mulWrapping<T>(a: T, b: T): T;
fn countLeadingZeros<T>(x: T): int;
fn countTrailingZeros<T>(x: T): int;
fn countOnes<T>(x: T): int;
fn rotateBitsLeft<T>(x: T, n: int): T;

/// The two float types (10 B5 Z1, Z2): what describes the type is a static member, the elementary
/// functions are methods — defaults written once over `Self`, computed in `float` by C's libm, so a
/// `float32` is rounded once, at the end.
pub interface Float :: [Signed] {
    /// The distance from `1.0` to the next value above it.
    static let epsilon: Self;
    static let infinity: Self;
    /// The quiet NaN with its sign clear — what `0.0 / 0.0` gives has the sign the hardware sets.
    static let nan: Self;
    /// The most negative finite value.
    static let min: Self;
    /// The greatest finite value.
    static let max: Self;
    /// The least positive value, a subnormal.
    static let leastPositive: Self;

    /// The value a bit pattern names: a `float` its 64 bits, a `float32` the low 32.
    static fn fromBits(b: uint64): Self;

    /// Whether this is NaN, the one value unequal to itself.
    fn isNan(): bool {
        return this != this;
    }

    /// Whether this is an infinity, of either sign.
    fn isInfinite(): bool {
        return this == Self.infinity || this == -Self.infinity;
    }

    /// Whether this is neither NaN nor an infinity.
    fn isFinite(): bool {
        return !this.isNan() && !this.isInfinite();
    }

    /// The greatest integral value not above this.
    fn floor(): Self {
        return this.narrowed(libmFloor(this.widened()));
    }

    /// The least integral value not below this.
    fn ceil(): Self {
        return this.narrowed(libmCeil(this.widened()));
    }

    /// The nearest integral value, a half away from zero.
    fn round(): Self {
        return this.narrowed(libmRound(this.widened()));
    }

    /// The integral part, toward zero.
    fn trunc(): Self {
        return this.narrowed(libmTrunc(this.widened()));
    }

    /// The square root; NaN below zero.
    fn sqrt(): Self {
        return this.narrowed(libmSqrt(this.widened()));
    }

    /// The cube root.
    fn cbrt(): Self {
        return this.narrowed(libmCbrt(this.widened()));
    }

    /// *e* to this power.
    fn exp(): Self {
        return this.narrowed(libmExp(this.widened()));
    }

    /// The natural logarithm; NaN below zero, `-infinity` at zero.
    fn ln(): Self {
        return this.narrowed(libmLn(this.widened()));
    }

    /// The logarithm to base 2.
    fn log2(): Self {
        return this.narrowed(libmLog2(this.widened()));
    }

    /// The logarithm to base 10.
    fn log10(): Self {
        return this.narrowed(libmLog10(this.widened()));
    }

    /// The sine, this in radians.
    fn sin(): Self {
        return this.narrowed(libmSin(this.widened()));
    }

    /// The cosine.
    fn cos(): Self {
        return this.narrowed(libmCos(this.widened()));
    }

    /// The tangent.
    fn tan(): Self {
        return this.narrowed(libmTan(this.widened()));
    }

    /// The arcsine, in radians.
    fn asin(): Self {
        return this.narrowed(libmAsin(this.widened()));
    }

    /// The arccosine.
    fn acos(): Self {
        return this.narrowed(libmAcos(this.widened()));
    }

    /// The arctangent.
    fn atan(): Self {
        return this.narrowed(libmAtan(this.widened()));
    }

    /// The hyperbolic sine.
    fn sinh(): Self {
        return this.narrowed(libmSinh(this.widened()));
    }

    /// The hyperbolic cosine.
    fn cosh(): Self {
        return this.narrowed(libmCosh(this.widened()));
    }

    /// The hyperbolic tangent.
    fn tanh(): Self {
        return this.narrowed(libmTanh(this.widened()));
    }

    /// The angle of the point (this, y) from the positive x axis, in radians, -π to π.
    fn atan2(y: Self): Self {
        return this.narrowed(libmAtan2(y.widened(), this.widened()));
    }

    /// The length of the hypotenuse, without the overflow of `sqrt(this * this + o * o)`.
    fn hypot(o: Self): Self {
        return this.narrowed(libmHypot(this.widened(), o.widened()));
    }

    /// This to the power `e`.
    fn pow(e: Self): Self {
        return this.narrowed(libmPow(this.widened(), e.widened()));
    }

    /// IEEE 754's total order, for sorting: -NaN, -infinity, the negatives, -0.0, 0.0, the
    /// positives, infinity, NaN — every value in its one place.
    fn totalCompare(o: Self): Ordering {
        let a = totalOrderKey(this);
        let b = totalOrderKey(o);
        if (a < b) {
            return Ordering.Less;
        }
        if (a > b) {
            return Ordering.Greater;
        }
        return Ordering.Equal;
    }

    /// The bit pattern: a `float` its 64 bits, a `float32` its 32 in the low ones.
    fn toBits(): uint64 {
        return floatBits(this);
    }

    /// This as a `float`, exactly.
    private fn widened(): float {
        return asTypeOf(this, 0.0);
    }

    /// A `float` as this type: rounded to the nearest for a `float32`.
    private fn narrowed(x: float): Self {
        return asTypeOf(x, this);
    }
}

// The C functions the defaults stand on, libm's in double (11 W4), and the bits as macros.
extern "C" fn libmFloor(x: float): float = "floor";
extern "C" fn libmCeil(x: float): float = "ceil";
extern "C" fn libmRound(x: float): float = "round";
extern "C" fn libmTrunc(x: float): float = "trunc";
extern "C" fn libmSqrt(x: float): float = "sqrt";
extern "C" fn libmCbrt(x: float): float = "cbrt";
extern "C" fn libmExp(x: float): float = "exp";
extern "C" fn libmLn(x: float): float = "log";
extern "C" fn libmLog2(x: float): float = "log2";
extern "C" fn libmLog10(x: float): float = "log10";
extern "C" fn libmSin(x: float): float = "sin";
extern "C" fn libmCos(x: float): float = "cos";
extern "C" fn libmTan(x: float): float = "tan";
extern "C" fn libmAsin(x: float): float = "asin";
extern "C" fn libmAcos(x: float): float = "acos";
extern "C" fn libmAtan(x: float): float = "atan";
extern "C" fn libmSinh(x: float): float = "sinh";
extern "C" fn libmCosh(x: float): float = "cosh";
extern "C" fn libmTanh(x: float): float = "tanh";
extern "C" fn libmAtan2(y: float, x: float): float = "atan2";
extern "C" fn libmHypot(x: float, y: float): float = "hypot";
extern "C" fn libmPow(x: float, e: float): float = "pow";
fn floatBits<T>(x: T): uint64;
fn floatFromBits<T>(b: uint64, like: T): T;
fn totalOrderKey<T>(x: T): uint64;

extend int :: [Num, Signed, Integer] {
    static let zero: int = 0;
    static let one: int = 1;
    static let min: int = -9223372036854775808;
    static let max: int = 9223372036854775807;
    static let bitWidth: int = 64;
    static let isSigned: bool = true;

    /// The decimal integer a text names (`Parse`).
    static fn parse(s: string): int throws ParseError {
        return try parseInteger(s, 10);
    }

    /// The integer a text names in `radix`, 2…36.
    static fn parse(s: string, radix: int): int throws ParseError {
        return try parseInteger(s, radix);
    }

    /// `v` as an `int` where it fits, `null` where it does not (10 B5 Z4).
    static fn exact<T :: [Integer]>(v: T): ?int {
        return exactly(v);
    }

    /// `v` as an `int`, held at `min` or `max` where it does not fit.
    static fn clamping<T :: [Integer]>(v: T): int {
        return clamped(v);
    }
}

