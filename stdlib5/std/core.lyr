extend uint :: [Num, Integer] {
    static let zero: uint = 0;
    static let one: uint = 1;
    static let min: uint = 0;
    static let max: uint = 18446744073709551615;
    static let bitWidth: int = 64;
    static let isSigned: bool = false;

    /// The decimal integer a text names (`Parse`).
    static fn parse(s: string): uint throws ParseError {
        return try parseInteger(s, 10);
    }

    /// The integer a text names in `radix`, 2…36.
    static fn parse(s: string, radix: int): uint throws ParseError {
        return try parseInteger(s, radix);
    }

    /// `v` as an `uint` where it fits, `null` where it does not (10 B5 Z4).
    static fn exact<T :: [Integer]>(v: T): ?uint {
        return exactly(v);
    }

    /// `v` as an `uint`, held at `min` or `max` where it does not fit.
    static fn clamping<T :: [Integer]>(v: T): uint {
        return clamped(v);
    }
}

extend uint8 :: [Num, Integer] {
    static let zero: uint8 = 0;
    static let one: uint8 = 1;
    static let min: uint8 = 0;
    static let max: uint8 = 255;
    static let bitWidth: int = 8;
    static let isSigned: bool = false;

    /// The decimal integer a text names (`Parse`).
    static fn parse(s: string): uint8 throws ParseError {
        return try parseInteger(s, 10);
    }

    /// The integer a text names in `radix`, 2…36.
    static fn parse(s: string, radix: int): uint8 throws ParseError {
        return try parseInteger(s, radix);
    }

    /// `v` as an `uint8` where it fits, `null` where it does not (10 B5 Z4).
    static fn exact<T :: [Integer]>(v: T): ?uint8 {
        return exactly(v);
    }

    /// `v` as an `uint8`, held at `min` or `max` where it does not fit.
    static fn clamping<T :: [Integer]>(v: T): uint8 {
        return clamped(v);
    }
}

extend uint16 :: [Num, Integer] {
    static let zero: uint16 = 0;
    static let one: uint16 = 1;
    static let min: uint16 = 0;
    static let max: uint16 = 65535;
    static let bitWidth: int = 16;
    static let isSigned: bool = false;

    /// The decimal integer a text names (`Parse`).
    static fn parse(s: string): uint16 throws ParseError {
        return try parseInteger(s, 10);
    }

    /// The integer a text names in `radix`, 2…36.
    static fn parse(s: string, radix: int): uint16 throws ParseError {
        return try parseInteger(s, radix);
    }

    /// `v` as an `uint16` where it fits, `null` where it does not (10 B5 Z4).
    static fn exact<T :: [Integer]>(v: T): ?uint16 {
        return exactly(v);
    }

    /// `v` as an `uint16`, held at `min` or `max` where it does not fit.
    static fn clamping<T :: [Integer]>(v: T): uint16 {
        return clamped(v);
    }
}

extend uint32 :: [Num, Integer] {
    static let zero: uint32 = 0;
    static let one: uint32 = 1;
    static let min: uint32 = 0;
    static let max: uint32 = 4294967295;
    static let bitWidth: int = 32;
    static let isSigned: bool = false;

    /// The decimal integer a text names (`Parse`).
    static fn parse(s: string): uint32 throws ParseError {
        return try parseInteger(s, 10);
    }

    /// The integer a text names in `radix`, 2…36.
    static fn parse(s: string, radix: int): uint32 throws ParseError {
        return try parseInteger(s, radix);
    }

    /// `v` as an `uint32` where it fits, `null` where it does not (10 B5 Z4).
    static fn exact<T :: [Integer]>(v: T): ?uint32 {
        return exactly(v);
    }

    /// `v` as an `uint32`, held at `min` or `max` where it does not fit.
    static fn clamping<T :: [Integer]>(v: T): uint32 {
        return clamped(v);
    }
}

extend float :: [Num, Signed, Float] {
    static let zero: float = 0.0;
    static let one: float = 1.0;
    static let epsilon: float = 2.220446049250313e-16;
    static let infinity: float = float.fromBits(0x7FF0000000000000);
    static let nan: float = float.fromBits(0x7FF8000000000000);
    static let min: float = -1.7976931348623157e308;
    static let max: float = 1.7976931348623157e308;
    static let leastPositive: float = 5e-324;

    static fn fromBits(b: uint64): float {
        return floatFromBits(b, float.zero);
    }

    /// The float a text names, the nearest one (`Parse`).
    static fn parse(s: string): float throws ParseError {
        try checkFloatText(s);
        return floatOfText(s);
    }
}

extend float32 :: [Num, Signed, Float] {
    static let zero: float32 = 0.0;
    static let one: float32 = 1.0;
    static let epsilon: float32 = 1.1920928955078125e-7;
    static let infinity: float32 = float32.fromBits(0x7F800000);
    static let nan: float32 = float32.fromBits(0x7FC00000);
    static let min: float32 = -3.4028234663852886e38;
    static let max: float32 = 3.4028234663852886e38;
    static let leastPositive: float32 = 1.401298464324817e-45;

    static fn fromBits(b: uint64): float32 {
        return floatFromBits(b, float32.zero);
    }

    /// The float a text names, the nearest one (`Parse`).
    static fn parse(s: string): float32 throws ParseError {
        try checkFloatText(s);
        return float32OfText(s);
    }
}

// ---------------------------------------------------------------------------------------------
// Parsing (design/v5/spec/10 B3, B4, B5 Z6): a value read from a text, and what is wrong with the
// text thrown — the text is the data's, so it never panics. An integer is read here in Lyric over
// the string's bytes; a float's form is checked here and its value read by C, correctly rounded.
// ---------------------------------------------------------------------------------------------

/// Why a text is not a value of the type.
pub enum ParseErrorKind :: [Equatable, Debug] { Empty, Invalid, Overflow }

/// What `parse` throws (10 B3): the text was empty, was not of the type's form, or named a number
/// beyond the type's range.
pub struct ParseError :: [Error] {
    /// Why.
    pub kind: ParseErrorKind,

    pub fn message(): string {
        return match (this.kind) {
            .Empty => "cannot parse a value from an empty text",
            .Invalid => "the text is not a value of the type",
            .Overflow => "the number is beyond the type's range",
        };
    }
}

/// A type read from a text: `T.parse(s)`, throwing `ParseError` with the reason. The number types
/// conform through `Num`, and `bool`.
pub interface Parse {
    static fn parse(s: string): Self throws ParseError;
}

extend bool :: [Parse] {
    /// `true` or `false`, exactly.
    static fn parse(s: string): bool throws ParseError {
        if (s == "true") {
            return true;
        }
        if (s == "false") {
            return false;
        }
        throw ParseError { kind = if (s == "") ParseErrorKind.Empty else ParseErrorKind.Invalid };
    }
}

/// The integer a text names in `radix` (10 B5 Z6): an optional `+` or `-`, ASCII digits, `_`
/// between two of them, nothing else. A radix outside 2…36 is the program's error and panics (B3).
/// A byte outside the form is `Invalid` however many digits run before it — only a well-formed
/// number is an `Overflow`. Negative numbers accumulate downward, so `min` is reached.
fn parseInteger<T :: [Integer]>(s: string, radix: int): T throws ParseError {
    if (radix < 2 || radix > 36) {
        panic(f"radix {radix} is outside 2..36");
    }
    let n = byteCount(s);
    if (n == 0) {
        throw ParseError { kind = ParseErrorKind.Empty };
    }
    let negative = byteAt(s, 0) == 45;
    var i = if (negative || byteAt(s, 0) == 43) 1 else 0;
    if (i == n || (negative && !T.isSigned)) {
        throw ParseError { kind = ParseErrorKind.Invalid };
    }
    let base = asTypeOf(radix, T.zero);
    var value = T.zero;
    var overflowed = false;
    var afterDigit = false;
    while (i < n) {
        let b = byteAt(s, i);
        i = i + 1;
        if (b == 95) {
            if (!afterDigit || i == n) {
                throw ParseError { kind = ParseErrorKind.Invalid };
            }
            afterDigit = false;
            continue;
        }
        let d = digitValue(b);
        if (d >= radix) {
            throw ParseError { kind = ParseErrorKind.Invalid };
        }
        afterDigit = true;
        if (!overflowed) {
            let digit = asTypeOf(d, T.zero);
            let scaled = value.checkedMul(base);
            if (scaled == null) {
                overflowed = true;
            } else {
                let next = if (negative) scaled.checkedSub(digit) else scaled.checkedAdd(digit);
                if (next == null) {
                    overflowed = true;
                } else {
                    value = next;
                }
            }
        }
    }
    if (overflowed) {
        throw ParseError { kind = ParseErrorKind.Overflow };
    }
    return value;
}

/// `v` in `U` where it fits, `null` where it does not (10 B5 Z4): converted as `as` wraps, it
/// fits exactly when it comes back the same and keeps its sign.
fn exactly<T :: [Integer], U :: [Integer]>(v: T): ?U {
    let w = asTypeOf(v, U.zero);
    if (asTypeOf(w, v) != v || (v < T.zero) != (w < U.zero)) {
        return null;
    }
    return w;
}

/// `v` in `U`, held at `U.min` or `U.max` where it does not fit.
fn clamped<T :: [Integer], U :: [Integer]>(v: T): U {
    let w: ?U = exactly(v);
    return w ?? (if (v < T.zero) U.min else U.max);
}

/// A byte's value as a digit — `0`…`9`, then `a`…`z` or `A`…`Z` for 10…35 — and 36 for any other.
fn digitValue(b: int): int {
    if (b >= 48 && b <= 57) {
        return b - 48;
    }
    if (b >= 97 && b <= 122) {
        return b - 87;
    }
    if (b >= 65 && b <= 90) {
        return b - 55;
    }
    return 36;
}

/// Whether a byte is an ASCII digit.
fn isDigit(b: int): bool {
    return b >= 48 && b <= 57;
}

/// A float's form (10 B5 Z6), thrown where the text is not of it: an optional sign, then `inf`,
/// `nan`, or digits with an optional `.` and fraction — one digit at least — and an optional
/// exponent, `e` or `E` with its own sign and digits; `_` between two digits, nothing else.
fn checkFloatText(s: string): void throws ParseError {
    let n = byteCount(s);
    if (n == 0) {
        throw ParseError { kind = ParseErrorKind.Empty };
    }
    var i = if (byteAt(s, 0) == 43 || byteAt(s, 0) == 45) 1 else 0;
    if (n - i == 3 && (isWord(s, i, 105, 110, 102) || isWord(s, i, 110, 97, 110))) {
        return;
    }
    var digits = 0;
    var point = false;
    var afterDigit = false;
    while (i < n) {
        let b = byteAt(s, i);
        if (isDigit(b)) {
            digits = digits + 1;
            afterDigit = true;
        } else if (b == 95 && afterDigit && i + 1 < n && isDigit(byteAt(s, i + 1))) {
            afterDigit = false;
        } else if (b == 46 && !point) {
            point = true;
            afterDigit = false;
        } else {
            break;
        }
        i = i + 1;
    }
    if (digits == 0) {
        throw ParseError { kind = ParseErrorKind.Invalid };
    }
    if (i == n) {
        return;
    }
    if (byteAt(s, i) != 101 && byteAt(s, i) != 69) {
        throw ParseError { kind = ParseErrorKind.Invalid };
    }
    i = i + 1;
    if (i < n && (byteAt(s, i) == 43 || byteAt(s, i) == 45)) {
        i = i + 1;
    }
    var exponent = 0;
    afterDigit = false;
    while (i < n) {
        let b = byteAt(s, i);
        if (isDigit(b)) {
            exponent = exponent + 1;
            afterDigit = true;
        } else if (b == 95 && afterDigit && i + 1 < n && isDigit(byteAt(s, i + 1))) {
            afterDigit = false;
        } else {
            throw ParseError { kind = ParseErrorKind.Invalid };
        }
        i = i + 1;
    }
    if (exponent == 0) {
        throw ParseError { kind = ParseErrorKind.Invalid };
    }
}

/// Whether the three bytes at `i` are `a`, `b`, `c`.
fn isWord(s: string, i: int, a: int, b: int, c: int): bool {
    return byteAt(s, i) == a && byteAt(s, i + 1) == b && byteAt(s, i + 2) == c;
}

// The natives parsing stands on: a string's length and bytes until `StringView` gives the library
// its bytes (M8a S8), a number converted as `as` converts it (03 T1d) to the type of `like` where
// that is a parameter's, a float's text read by C (`strtod`, `strtof`) once its form is checked.
fn byteCount(s: string): int;
fn byteAt(s: string, i: int): int;
/// Byte by byte, as `memcmp` and then the length: -1, 0 or 1.
fn compareBytes(a: string, b: string): int;
/// The bytes from..to as a string; out of bounds or off a character's boundary, a panic.
fn byteSlice(s: string, from: int, to: int): string;
/// A string of the array's first `count` bytes.
fn stringOfBytes(bytes: uint8[], count: int): string;
// --- strings (10 B9 S1–S3) ----------------------------------------------------------------------
// UTF-8, immutable, the length in bytes. Written over the string's bytes until `StringView` gives
// the library its views (M8a S8): the search takes a string for its pattern — `Pattern` (S2) comes
// with the views.

extend string :: [Ordered, TotalOrder] {
    /// Byte by byte (S1), which is the order of the code points.
    fn compare(o: string): ?Ordering {
        return this.totalCompare(o);
    }

    fn totalCompare(o: string): Ordering {
        let c = compareBytes(this, o);
        if (c < 0) {
            return Ordering.Less;
        }
        if (c > 0) {
            return Ordering.Greater;
        }
        return Ordering.Equal;
    }
}

extend string {
    /// The length in bytes, `O(1)` (S1); `charCount()` counts the characters.
    pub fn length(): int {
        return byteCount(this);
    }

    /// Whether it has no byte.
    pub fn isEmpty(): bool {
        return byteCount(this) == 0;
    }

    /// The characters, decoded from the bytes.
    pub fn chars(): CharsIter {
        return CharsIter { s = this, at = 0 };
    }

    /// How many characters it holds, `O(n)`.
    pub fn charCount(): int {
        let n = byteCount(this);
        var count = 0;
        var i = 0;
        while (i < n) {
            if ((byteAt(this, i) & 192) != 128) {
                count = count + 1;
            }
            i = i + 1;
        }
        return count;
    }

    /// Whether `p` stands in it.
    pub fn contains(p: string): bool {
        return this.find(p) != null;
    }

    /// Whether it begins with `p`.
    pub fn startsWith(p: string): bool {
        return matchesAt(this, p, 0);
    }

    /// Whether it ends with `p`.
    pub fn endsWith(p: string): bool {
        let at = byteCount(this) - byteCount(p);
        return at >= 0 && matchesAt(this, p, at);
    }

    /// The byte index of the first `p`, or `null`; an empty `p` stands at 0.
    pub fn find(p: string): ?int {
        let last = byteCount(this) - byteCount(p);
        var at = 0;
        while (at <= last) {
            if (matchesAt(this, p, at)) {
                return at;
            }
            at = at + 1;
        }
        return null;
    }

    /// The byte index of the last `p`, or `null`; an empty `p` stands at the length.
    pub fn rfind(p: string): ?int {
        var at = byteCount(this) - byteCount(p);
        while (at >= 0) {
            if (matchesAt(this, p, at)) {
                return at;
            }
            at = at - 1;
        }
        return null;
    }

    /// How many times `p` stands in it, none overlapping another; an empty `p` stands between
    /// every two characters and at both ends.
    pub fn count(p: string): int {
        let step = byteCount(p);
        if (step == 0) {
            return this.charCount() + 1;
        }
        let last = byteCount(this) - step;
        var n = 0;
        var at = 0;
        while (at <= last) {
            if (matchesAt(this, p, at)) {
                n = n + 1;
                at = at + step;
            } else {
                at = at + 1;
            }
        }
        return n;
    }
}

extend string {
    /// The parts between the separators, in order: `"a,b,,c".split(",")` gives `a`, `b`, ``, `c`.
    /// An empty separator panics.
    pub fn split(sep: string): SplitIter {
        if (byteCount(sep) == 0) {
            panic("split: an empty separator");
        }
        return SplitIter { s = this, sep = sep, at = 0, done = false };
    }

    /// The part before the first `sep` and the part after it, or `null` where there is none.
    pub fn splitOnce(sep: string): ?(string, string) {
        let at = this.find(sep);
        if (at == null) {
            return null;
        }
        let parts: (string, string) = (byteSlice(this, 0, at), byteSlice(this, at + byteCount(sep), byteCount(this)));
        return parts;
    }

    /// The lines: split at `\n`, a `\r` before it taken off, no empty line after a last `\n`.
    pub fn lines(): LinesIter {
        return LinesIter { s = this, at = 0 };
    }

    /// Without the white space at both ends (ASCII's for now: space, tab, the line breaks, vertical
    /// tab and form feed).
    pub fn trim(): string {
        return this.trimStart().trimEnd();
    }

    /// Without the white space at the start.
    pub fn trimStart(): string {
        let n = byteCount(this);
        var i = 0;
        while (i < n && isAsciiSpace(byteAt(this, i))) {
            i = i + 1;
        }
        return byteSlice(this, i, n);
    }

    /// Without the white space at the end.
    pub fn trimEnd(): string {
        var n = byteCount(this);
        while (n > 0 && isAsciiSpace(byteAt(this, n - 1))) {
            n = n - 1;
        }
        return byteSlice(this, 0, n);
    }

    /// The rest after `p` where it begins with `p`, or `null` (10 S2: absence is information).
    pub fn stripPrefix(p: string): ?string {
        if (!this.startsWith(p)) {
            return null;
        }
        return byteSlice(this, byteCount(p), byteCount(this));
    }

    /// The rest before `p` where it ends with `p`, or `null`.
    pub fn stripSuffix(p: string): ?string {
        if (!this.endsWith(p)) {
            return null;
        }
        return byteSlice(this, 0, byteCount(this) - byteCount(p));
    }

    /// Every `p` replaced by `with`, none overlapping another; an empty `p` panics.
    pub fn replace(p: string, with: string): string {
        let step = byteCount(p);
        if (step == 0) {
            panic("replace: an empty pattern");
        }
        let out = StringBuilder.new();
        let n = byteCount(this);
        var from = 0;
        var at = 0;
        while (at + step <= n) {
            if (matchesAt(this, p, at)) {
                out.appendStr(byteSlice(this, from, at));
                out.appendStr(with);
                at = at + step;
                from = at;
            } else {
                at = at + 1;
            }
        }
        out.appendStr(byteSlice(this, from, n));
        return out.toString();
    }

    /// `fill` before it until it is `width` characters long; a longer one as it is.
    pub fn padStart(width: int, fill: char = ' '): string {
        let missing = width - this.charCount();
        if (missing <= 0) {
            return this;
        }
        let out = StringBuilder.new();
        var i = 0;
        while (i < missing) {
            out.appendChar(fill);
            i = i + 1;
        }
        out.appendStr(this);
        return out.toString();
    }

    /// `fill` after it until it is `width` characters long; a longer one as it is.
    pub fn padEnd(width: int, fill: char = ' '): string {
        let missing = width - this.charCount();
        if (missing <= 0) {
            return this;
        }
        let out = StringBuilder.new();
        out.appendStr(this);
        var i = 0;
        while (i < missing) {
            out.appendChar(fill);
            i = i + 1;
        }
        return out.toString();
    }
}

fn isAsciiSpace(b: int): bool {
    return b == 32 || (b >= 9 && b <= 13);
}

/// A string's parts between a separator's occurrences.
pub struct SplitIter :: [Iterator] {
    type Item = string;
    s: string,
    sep: string,
    var at: int,
    var done: bool,

    pub mut fn next(): ?string {
        if (this.done) {
            return null;
        }
        let n = byteCount(this.s);
        let step = byteCount(this.sep);
        var i = this.at;
        while (i + step <= n) {
            if (matchesAt(this.s, this.sep, i)) {
                let part = byteSlice(this.s, this.at, i);
                this.at = i + step;
                return part;
            }
            i = i + 1;
        }
        this.done = true;
        return byteSlice(this.s, this.at, n);
    }
}

/// A string's lines.
pub struct LinesIter :: [Iterator] {
    type Item = string;
    s: string,
    var at: int,

    pub mut fn next(): ?string {
        let n = byteCount(this.s);
        if (this.at >= n) {
            return null;
        }
        var i = this.at;
        while (i < n && byteAt(this.s, i) != 10) {
            i = i + 1;
        }
        var end = i;
        if (end > this.at && byteAt(this.s, end - 1) == 13) {
            end = end - 1;
        }
        let line = byteSlice(this.s, this.at, end);
        this.at = i + 1;
        return line;
    }
}

/// A string built a part at a time (10 S3), in a buffer that doubles: no quadratic chain of
/// concatenations. `std.string` passes it on.
pub class StringBuilder {
    var bytes: uint8[],
    var count: int,

    pub static fn new(): StringBuilder {
        return StringBuilder { bytes = [], count = 0 };
    }

    /// How many bytes it holds.
    pub fn length(): int {
        return this.count;
    }

    /// `s` at the end.
    pub mut fn appendStr(s: string): void {
        let n = byteCount(s);
        this.reserve(n);
        putBytes(this.bytes, this.count, s);
        this.count = this.count + n;
    }

    /// `c` at the end, as its UTF-8 bytes.
    pub mut fn appendChar(c: char): void {
        let code = (c as uint32) as int;
        this.reserve(4);
        if (code < 128) {
            this.put(code);
        } else if (code < 2048) {
            this.put(192 | (code >> 6));
            this.put(128 | (code & 63));
        } else if (code < 65536) {
            this.put(224 | (code >> 12));
            this.put(128 | ((code >> 6) & 63));
            this.put(128 | (code & 63));
        } else {
            this.put(240 | (code >> 18));
            this.put(128 | ((code >> 12) & 63));
            this.put(128 | ((code >> 6) & 63));
            this.put(128 | (code & 63));
        }
    }

    /// `v`'s text at the end.
    pub mut fn append<T :: [Display]>(v: T): void {
        this.appendStr(f"{v}");
    }

    /// Every byte taken out; the room stays.
    pub mut fn clear(): void {
        this.count = 0;
    }

    /// What it holds, as a string.
    pub fn toString(): string {
        return stringOfBytes(this.bytes, this.count);
    }

    mut fn put(b: int): void {
        this.bytes[this.count] = b as uint8;
        this.count = this.count + 1;
    }

    /// Room for `n` bytes more.
    mut fn reserve(n: int): void {
        let need = this.count + n;
        if (need <= this.bytes.length()) {
            return;
        }
        var room = if (this.bytes.length() == 0) 16 else this.bytes.length() * 2;
        while (room < need) {
            room = room * 2;
        }
        let zero: uint8 = 0;
        let grown = [zero] * room;
        copyBytes(grown, this.bytes, this.count);
        this.bytes = grown;
    }
}

/// `s`'s bytes into `bytes` from `at` on, and the first `count` bytes of `from` into `into` — C's
/// memcpy (measurement point 3), the ranges checked as an index is.
fn putBytes(bytes: uint8[], at: int, s: string): void;
fn copyBytes(into: uint8[], from: uint8[], count: int): void;

// --- the format language (08 Y7, 10 S7; spec 12 §2) ---------------------------------------------

/// A type with formats of its own (10 S7): `{x:spec}` hands it the spec as written. The scalars
/// conform with the format language, which the compiler checks where a spec is written; `string`
/// stands where `StringView` will.
pub interface Format {
    fn format(spec: string, &out: StringBuilder): void;
}

/// What `{x:spec}` compiles to for a `Format` type (12 §2 rule 4): `x` in the spec's format.
pub fn formatted<T :: [Format]>(value: T, spec: string): string {
    var out = StringBuilder.new();
    value.format(spec, &out);
    return out.toString();
}

/// What `{x:spec}` compiles to for another `Display` type (12 §2 rule 4): `show()` in the spec's
/// width, alignment and fill.
pub fn padded<T :: [Display]>(value: T, spec: string): string {
    var out = StringBuilder.new();
    pad(value.show(), readSpec(spec), '<', &out);
    return out.toString();
}

/// What `{x:?}` compiles to (12 §2 rule 4): `debug()` in the width, alignment and fill before the
/// `?`.
pub fn debugged<T :: [Debug]>(value: T, spec: string): string {
    var out = StringBuilder.new();
    pad(value.debug(), readSpec(spec), '<', &out);
    return out.toString();
}

/// A spec read (12 §2 rule 1): `[[fill]align][sign][#][0][width][grouping][.precision][type]`.
/// `align` is `<`, `>`, `^`, `=` for the zeros of `0` after the sign, or `'\0'` for the value's
/// own; `grouping` and `kind` are `'\0'` where none is written, `precision` -1.
struct FormatSpec {
    fill: char,
    align: char,
    plus: bool,
    alternate: bool,
    width: int,
    grouping: char,
    precision: int,
    kind: char,
}

/// The spec in `text`. The compiler checked a spec an f-string writes; what is no spec panics.
fn readSpec(text: string): FormatSpec {
    let cs = text.chars().toArray();
    let n = cs.length();
    var i = 0;
    var fill = ' ';
    var fillWritten = false;
    var align = '\0';
    if (n >= 2 && isAlignment(cs[1])) {
        fill = cs[0];
        fillWritten = true;
        align = cs[1];
        i = 2;
    } else if (n >= 1 && isAlignment(cs[0])) {
        align = cs[0];
        i = 1;
    }
    var plus = false;
    if (i < n && (cs[i] == '+' || cs[i] == '-')) {
        plus = cs[i] == '+';
        i = i + 1;
    }
    var alternate = false;
    if (i < n && cs[i] == '#') {
        alternate = true;
        i = i + 1;
    }
    if (i < n && cs[i] == '0') {
        if (!fillWritten) {
            fill = '0';
        }
        if (align == '\0') {
            align = '=';
        }
        i = i + 1;
    }
    var width = 0;
    while (i < n && isDecimal(cs[i])) {
        width = width * 10 + decimalOf(cs[i]);
        i = i + 1;
    }
    var grouping = '\0';
    if (i < n && (cs[i] == ',' || cs[i] == '_')) {
        grouping = cs[i];
        i = i + 1;
    }
    var precision = -1;
    if (i < n && cs[i] == '.') {
        i = i + 1;
        precision = 0;
        while (i < n && isDecimal(cs[i])) {
            precision = precision * 10 + decimalOf(cs[i]);
            i = i + 1;
        }
    }
    var kind = '\0';
    if (i < n) {
        kind = cs[i];
        i = i + 1;
    }
    if (i != n) {
        panic(f"'{text}' is no format spec");
    }
    return FormatSpec { fill = fill, align = align, plus = plus, alternate = alternate, width = width,
        grouping = grouping, precision = precision, kind = kind };
}

fn isAlignment(c: char): bool {
    return c == '<' || c == '>' || c == '^';
}

fn isDecimal(c: char): bool {
    return c >= '0' && c <= '9';
}

fn decimalOf(c: char): int {
    return ((c as uint32) as int) - 48;
}

/// `text` in the spec's width, counted in characters: the fill before it, after it, or around it
/// (the odd one after), as the spec aligns it or else as `natural` does.
fn pad(text: string, s: FormatSpec, natural: char, &out: StringBuilder): void {
    let room = s.width - text.charCount();
    if (room <= 0) {
        out.appendStr(text);
        return;
    }
    let align = if (s.align == '\0') natural else s.align;
    let before = if (align == '>') room else if (align == '^') room / 2 else 0;
    fillOut(s.fill, before, &out);
    out.appendStr(text);
    fillOut(s.fill, room - before, &out);
}

/// `count` times `c`.
fn fillOut(c: char, count: int, &out: StringBuilder): void {
    var i = 0;
    while (i < count) {
        out.appendChar(c);
        i = i + 1;
    }
}

/// A number's parts in the spec's width: under `0` the zeros between the sign and the prefix and
/// the digits; otherwise the whole padded, right-aligned unless the spec aligns it.
fn finishNumber(sign: string, prefix: string, digits: string, s: FormatSpec, &out: StringBuilder): void {
    if (s.align == '=') {
        out.appendStr(sign);
        out.appendStr(prefix);
        fillOut(s.fill, s.width - byteCount(sign) - byteCount(prefix) - digits.charCount(), &out);
        out.appendStr(digits);
        return;
    }
    pad(sign + prefix + digits, s, '>', &out);
}

/// An integer by its sign and magnitude (12 §2 rule 3): the radix `b`, `o`, `x` or `X` names, the
/// prefix under `#`, the digits grouped by three (decimal) or four (another radix).
fn formatInteger(negative: bool, magnitude: uint, spec: string, &out: StringBuilder): void {
    let s = readSpec(spec);
    let radix = if (s.kind == 'b') 2 else if (s.kind == 'o') 8 else if (s.kind == 'x' || s.kind == 'X') 16 else 10;
    var prefix = "";
    if (s.alternate) {
        prefix = if (s.kind == 'b') "0b" else if (s.kind == 'o') "0o" else if (s.kind == 'X') "0X" else "0x";
    }
    let sign = if (negative) "-" else if (s.plus) "+" else "";
    let digits = digitsOf(magnitude, radix as uint, s.kind == 'X', s.grouping, if (radix == 10) 3 else 4);
    finishNumber(sign, prefix, digits, s, &out);
}

/// A signed integer: its magnitude in `uint`, where `int`'s least value has one.
fn formatSigned(v: int, spec: string, &out: StringBuilder): void {
    let magnitude = if (v < 0) (-(v + 1)) as uint + 1 else v as uint;
    formatInteger(v < 0, magnitude, spec, &out);
}

/// The digits of `magnitude` in `radix`, most significant first, `grouping` between each `size`
/// of them from the right.
fn digitsOf(magnitude: uint, radix: uint, upper: bool, grouping: char, size: int): string {
    var count = 1;
    var rest = magnitude / radix;
    while (rest != 0) {
        count = count + 1;
        rest = rest / radix;
    }
    let separators = if (grouping == '\0') 0 else (count - 1) / size;
    let total = count + separators;
    let zero: uint8 = 0;
    let bytes = [zero] * total;
    var at = total - 1;
    var value = magnitude;
    var placed = 0;
    while (true) {
        let d = (value % radix) as int;
        bytes[at] = (if (d < 10) 48 + d else if (upper) 55 + d else 87 + d) as uint8;
        at = at - 1;
        placed = placed + 1;
        value = value / radix;
        if (value == 0) {
            break;
        }
        if (grouping != '\0' && placed % size == 0) {
            bytes[at] = (grouping as uint32) as uint8;
            at = at - 1;
        }
    }
    return stringOfBytes(bytes, total);
}

/// A float (12 §2 rule 3): its shortest text without a precision or a type (03 §1.7); fixed with a
/// precision; `e`/`E` with an exponent; `%` a hundredfold and fixed — six digits where those three
/// name none. Its sign, the integer part grouped, padded.
fn formatFloat(v: float, spec: string, &out: StringBuilder): void {
    let s = readSpec(spec);
    let digits = if (s.precision < 0) 6 else s.precision;
    var text = "";
    if (s.kind == 'e') {
        text = floatText(v, digits, 1);
    } else if (s.kind == 'E') {
        text = floatText(v, digits, 2);
    } else if (s.kind == '%') {
        text = floatText(v * 100.0, digits, 0) + "%";
    } else if (s.kind == 'f' || s.precision >= 0) {
        text = floatText(v, digits, 0);
    } else {
        text = f"{v}";
    }
    let negative = text.startsWith("-");
    let body = if (negative) byteSlice(text, 1, byteCount(text)) else text;
    finishNumber(if (negative) "-" else if (s.plus) "+" else "", "", grouped(body, s.grouping), s, &out);
}

/// `body`'s leading digits, a float's integer part, with `grouping` between each three.
fn grouped(body: string, grouping: char): string {
    let n = byteCount(body);
    var end = 0;
    while (end < n && byteAt(body, end) >= 48 && byteAt(body, end) <= 57) {
        end = end + 1;
    }
    if (grouping == '\0' || end <= 3) {
        return body;
    }
    let out = StringBuilder.new();
    var i = 0;
    while (i < end) {
        if (i > 0 && (end - i) % 3 == 0) {
            out.appendChar(grouping);
        }
        out.appendStr(byteSlice(body, i, i + 1));
        i = i + 1;
    }
    out.appendStr(byteSlice(body, end, n));
    return out.toString();
}

/// The first `count` characters of `text`, or all of them: cut where the next one starts, at a
/// byte that is no continuation byte (`10xxxxxx`).
fn firstChars(text: string, count: int): string {
    let n = byteCount(text);
    var at = 0;
    var taken = 0;
    while (at < n) {
        if ((byteAt(text, at) & 192) != 128) {
            if (taken == count) {
                return byteSlice(text, 0, at);
            }
            taken = taken + 1;
        }
        at = at + 1;
    }
    return text;
}

/// A float with a precision, rounded by C (12 §2 rule 3): `form` 0 fixed, 1 with an exponent, 2 the
/// same upper case.
fn floatText(value: float, precision: int, form: int): string;

extend int :: [Format] {
    fn format(spec: string, &out: StringBuilder): void { formatSigned(this, spec, &out); }
}

extend int8 :: [Format] {
    fn format(spec: string, &out: StringBuilder): void { formatSigned(this as int, spec, &out); }
}

extend int16 :: [Format] {
    fn format(spec: string, &out: StringBuilder): void { formatSigned(this as int, spec, &out); }
}

extend int32 :: [Format] {
    fn format(spec: string, &out: StringBuilder): void { formatSigned(this as int, spec, &out); }
}

extend uint :: [Format] {
    fn format(spec: string, &out: StringBuilder): void { formatInteger(false, this, spec, &out); }
}

extend uint8 :: [Format] {
    fn format(spec: string, &out: StringBuilder): void { formatInteger(false, this as uint, spec, &out); }
}

extend uint16 :: [Format] {
    fn format(spec: string, &out: StringBuilder): void { formatInteger(false, this as uint, spec, &out); }
}

extend uint32 :: [Format] {
    fn format(spec: string, &out: StringBuilder): void { formatInteger(false, this as uint, spec, &out); }
}

extend float :: [Format] {
    fn format(spec: string, &out: StringBuilder): void { formatFloat(this, spec, &out); }
}

/// A `float32` is written as the `float` it widens to (03 §1.7).
extend float32 :: [Format] {
    fn format(spec: string, &out: StringBuilder): void { formatFloat(this as float, spec, &out); }
}

/// A string: fill, alignment, width, and the precision as the most characters it keeps.
extend string :: [Format] {
    fn format(spec: string, &out: StringBuilder): void {
        let s = readSpec(spec);
        pad(if (s.precision >= 0) firstChars(this, s.precision) else this, s, '<', &out);
    }
}

extend char :: [Format] {
    fn format(spec: string, &out: StringBuilder): void { pad(f"{this}", readSpec(spec), '<', &out); }
}

extend bool :: [Format] {
    fn format(spec: string, &out: StringBuilder): void { pad(f"{this}", readSpec(spec), '<', &out); }
}

/// Whether `p`'s bytes stand in `s` from byte `at` on.
fn matchesAt(s: string, p: string, at: int): bool {
    let n = byteCount(p);
    if (at < 0 || at + n > byteCount(s)) {
        return false;
    }
    var i = 0;
    while (i < n) {
        if (byteAt(s, at + i) != byteAt(p, i)) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

/// A string's characters, decoded from its UTF-8 bytes.
pub struct CharsIter :: [Iterator] {
    type Item = char;
    s: string,
    var at: int,

    pub mut fn next(): ?char {
        if (this.at >= byteCount(this.s)) {
            return null;
        }
        let first = byteAt(this.s, this.at);
        var code = first;
        var size = 1;
        if (first >= 240) {
            code = first & 7;
            size = 4;
        } else if (first >= 224) {
            code = first & 15;
            size = 3;
        } else if (first >= 192) {
            code = first & 31;
            size = 2;
        }
        var k = 1;
        while (k < size) {
            code = (code << 6) | (byteAt(this.s, this.at + k) & 63);
            k = k + 1;
        }
        this.at = this.at + size;
        return (code as uint32) as char;
    }
}

fn asTypeOf<T, U>(v: T, like: U): U;
fn floatOfText(s: string): float;
fn float32OfText(s: string): float32;


// ---------------------------------------------------------------------------------------------
// Iteration (design/v5/spec/10 B6): a source of values, one at a time, and what `for` walks.
// ---------------------------------------------------------------------------------------------

/// A source of values, one at a time (10 B6 I1): `next()` gives the next, and `null` at the end —
/// for good, once given. A struct iterator changes as it goes, so `next` writes it. A walk that
/// can fail — a file's lines — answers its `Error`, and `next()` throws it (I5): the loop over it
/// is marked, `for (line in try lines)`.
pub interface Iterator {
    type Item;

    /// What a walk may throw: nothing, unless a conformer answers otherwise.
    type Error :: [Error] = never;

    mut fn next(): ?Self.Item throws Self.Error;

    /// How many values are left: at least the first, at most the second where that is known — for
    /// a collector that sizes its storage once.
    fn sizeHint(): (int, ?int) {
        let unknown: ?int = null;
        return (0, unknown);
    }
}

/// What `for` walks (I2): `iter()` gives an iterator over it, at every loop anew. Every iterator
/// is iterable as itself: a struct iterator as a copy, a class iterator as the object — two loops
/// over one go on from each other.
pub interface Iterable {
    type Iter :: [Iterator];

    fn iter(): Self.Iter;
}

/// An iterator from both ends (I10): `nextBack()` gives the last value not yet given.
pub interface DoubleEnded :: [Iterator] {
    mut fn nextBack(): ?Self.Item;
}

extend<I :: [Iterator]> I :: [Iterable<Iter = I>] {
    fn iter(): I {
        return this;
    }
}

// A range is an iterator of its own values, from both ends (I10): the value changes as it is
// walked — a 'let' range is walked through a copy, as `for` takes one.
extend<T :: [Integer]> Range<T> :: [Iterator, DoubleEnded] {
    type Item = T;

    mut fn next(): ?T {
        if (this.start >= this.end) {
            return null;
        }
        let value = this.start;
        this.start = this.start + T.one;
        return value;
    }

    mut fn nextBack(): ?T {
        if (this.start >= this.end) {
            return null;
        }
        this.end = this.end - T.one;
        return this.end;
    }
}

/// The iterator of an array or a view (10 B6 I10): its elements from the front and from the
/// back, through a view of them — nothing is copied, and a write to a later element is seen.
pub struct SliceIter<T> {
    items: Slice<T>,
    var front: int,
    var back: int,
}

extend<T> SliceIter<T> :: [Iterator, DoubleEnded] {
    type Item = T;

    mut fn next(): ?T {
        if (this.front >= this.back) {
            return null;
        }
        this.front = this.front + 1;
        return this.items[this.front - 1];
    }

    mut fn nextBack(): ?T {
        if (this.front >= this.back) {
            return null;
        }
        this.back = this.back - 1;
        return this.items[this.back];
    }

    /// Exactly the elements left.
    fn sizeHint(): (int, ?int) {
        let left = this.back - this.front;
        let most: ?int = left;
        return (left, most);
    }
}

extend<T> T[] :: [Iterable] {
    type Iter = SliceIter<T>;

    fn iter(): SliceIter<T> {
        return SliceIter<T> { items = this, front = 0, back = this.length() };
    }
}

extend<T> Slice<T> :: [Iterable] {
    type Iter = SliceIter<T>;

    fn iter(): SliceIter<T> {
        return SliceIter<T> { items = this, front = 0, back = this.length() };
    }
}

// --- the members of arrays and views (10 C2): written once on `Slice<T>`, and reached on an
// array - and a `T[N]` in the heap (03 §5.3 rule 6) - through a view of all of it. A write goes there.
extend<T> Slice<T> {
    /// Whether there is no element.
    pub fn isEmpty(): bool {
        return this.length() == 0;
    }

    /// The element at `i`, or `null` outside `0 ≤ i < length()`.
    pub fn get(i: int): ?T {
        if (i < 0 || i >= this.length()) {
            return null;
        }
        return this[i];
    }

    /// The first element, or `null` where there is none.
    pub fn first(): ?T {
        return this.get(0);
    }

    /// The last element, or `null` where there is none.
    pub fn last(): ?T {
        return this.get(this.length() - 1);
    }

    /// The elements at `i` and `j` exchanged; an index outside panics as `[i]` does.
    pub fn swap(i: int, j: int): void {
        let t = this[i];
        this[i] = this[j];
        this[j] = t;
    }

    /// The elements in place, the last first.
    pub fn reverse(): void {
        var i = 0;
        var j = this.length() - 1;
        while (i < j) {
            this.swap(i, j);
            i = i + 1;
            j = j - 1;
        }
    }

    /// A new array of the elements, the last first.
    pub fn reversed(): T[] {
        let n = this.length();
        return arrayOf(n, (i: int) => this[n - 1 - i]);
    }

    /// The first index whose element fails `p`, for elements that `p` partitions — every one it
    /// holds for before every one it does not: a binary search.
    pub fn partitionPoint(p: fn(T) -> bool): int {
        var lo = 0;
        var hi = this.length();
        while (lo < hi) {
            let mid = lo + (hi - lo) / 2;
            if (p(this[mid])) {
                lo = mid + 1;
            } else {
                hi = mid;
            }
        }
        return lo;
    }
}

/// `x in xs` (10 C12): an element equal to `x`.
extend<T :: [Equatable]> Slice<T> :: [Contains<T>] {
    fn contains(x: T): bool {
        return this.indexOf(x) != null;
    }
}

extend<T :: [Equatable]> T[] :: [Contains<T>] {
    fn contains(x: T): bool {
        return this[..].contains(x);
    }
}

extend<T :: [Equatable]> Slice<T> {
    /// The index of the first element equal to `x`, or `null`.
    pub fn indexOf(x: T): ?int {
        var i = 0;
        while (i < this.length()) {
            if (this[i] == x) {
                return i;
            }
            i = i + 1;
        }
        return null;
    }
}

extend<T :: [Clone]> Slice<T> {
    /// Every element a clone of `v` — no object shared into several slots (10 C7).
    pub fn fill(v: T): void {
        var i = 0;
        while (i < this.length()) {
            this[i] = v.clone();
            i = i + 1;
        }
    }
}

extend<T :: [TotalOrder]> Slice<T> {
    /// The index of an element equal to `x` in sorted elements, or `null` (10 C10: a `NaN` would
    /// break the order the search relies on, so a total one is asked).
    pub fn binarySearch(x: T): ?int {
        let at = this.partitionPoint((e: T) => e < x);
        if (at < this.length() && this[at] == x) {
            return at;
        }
        return null;
    }
}

extend<T :: [Display]> Slice<T> {
    /// The elements' texts, `sep` between each two.
    pub fn join(sep: string): string {
        var out = "";
        var i = 0;
        while (i < this.length()) {
            if (i > 0) {
                out = out + sep;
            }
            out = out + f"{this[i]}";
            i = i + 1;
        }
        return out;
    }
}

// --- ordering (10 C10): `sort` and `sortBy` stable (K3), through a buffer of the length;
// `sortUnstable` in place.
extend<T> Slice<T> {
    /// The elements in the order `cmp` gives, equal ones keeping theirs: a merge sort — runs of
    /// 16 sorted by insertion, then merged pairwise through a buffer of the length.
    pub fn sortBy(cmp: fn(T, T) -> Ordering): void {
        let n = this.length();
        var start = 0;
        while (start < n) {
            let end = if (start + 16 < n) start + 16 else n;
            sortRunBy(this[start..end], cmp);
            start = end;
        }
        if (n <= 16) {
            return;
        }
        let buffer = arrayOf(n, (i: int) => this[i]);
        var width = 16;
        var inBuffer = false;
        while (width < n) {
            if (inBuffer) {
                mergeRunsBy(buffer[..], this, width, cmp);
            } else {
                mergeRunsBy(this, buffer[..], width, cmp);
            }
            inBuffer = !inBuffer;
            width = width * 2;
        }
        if (inBuffer) {
            var i = 0;
            while (i < n) {
                this[i] = buffer[i];
                i = i + 1;
            }
        }
    }

    /// The elements in the order of their keys, equal keys keeping theirs.
    pub fn sortByKey<K :: [TotalOrder]>(key: fn(T) -> K): void {
        this.sortBy((a: T, b: T) => key(a).totalCompare(key(b)));
    }
}

extend<T :: [TotalOrder]> Slice<T> {
    /// The elements in ascending order, equal ones keeping theirs: `sortBy`'s merge sort with
    /// `totalCompare` called directly. A function value between kept C from inlining the
    /// comparison — 40 % of the time at measurement point 3.
    pub fn sort(): void {
        let n = this.length();
        var start = 0;
        while (start < n) {
            let end = if (start + 16 < n) start + 16 else n;
            sortRun(this[start..end]);
            start = end;
        }
        if (n <= 16) {
            return;
        }
        let buffer = arrayOf(n, (i: int) => this[i]);
        var width = 16;
        var inBuffer = false;
        while (width < n) {
            if (inBuffer) {
                mergeRuns(buffer[..], this, width);
            } else {
                mergeRuns(this, buffer[..], width);
            }
            inBuffer = !inBuffer;
            width = width * 2;
        }
        if (inBuffer) {
            var i = 0;
            while (i < n) {
                this[i] = buffer[i];
                i = i + 1;
            }
        }
    }

    /// The elements in ascending order, equal ones in any: in place, without a buffer — a
    /// quicksort, a heap sort where it would go quadratic.
    pub fn sortUnstable(): void {
        var depth = 0;
        var n = this.length();
        while (n > 1) {
            depth = depth + 2;
            n = n / 2;
        }
        introSort(this, depth);
    }
}

fn isLess(o: Ordering): bool {
    return match (o) { .Less => true, _ => false };
}

fn isGreater(o: Ordering): bool {
    return match (o) { .Greater => true, _ => false };
}

/// `sortRunBy` under the type's own order.
fn sortRun<T :: [TotalOrder]>(xs: Slice<T>): void {
    var i = 1;
    while (i < xs.length()) {
        let x = xs[i];
        var j = i;
        while (j > 0 && isLess(x.totalCompare(xs[j - 1]))) {
            xs[j] = xs[j - 1];
            j = j - 1;
        }
        xs[j] = x;
        i = i + 1;
    }
}

/// `mergeRunsBy` under the type's own order.
fn mergeRuns<T :: [TotalOrder]>(src: Slice<T>, dst: Slice<T>, width: int): void {
    let n = src.length();
    var lo = 0;
    while (lo < n) {
        let mid = if (lo + width < n) lo + width else n;
        let hi = if (mid + width < n) mid + width else n;
        var i = lo;
        var j = mid;
        var k = lo;
        while (i < mid && j < hi) {
            if (isLess(src[j].totalCompare(src[i]))) {
                dst[k] = src[j];
                j = j + 1;
            } else {
                dst[k] = src[i];
                i = i + 1;
            }
            k = k + 1;
        }
        while (i < mid) {
            dst[k] = src[i];
            i = i + 1;
            k = k + 1;
        }
        while (j < hi) {
            dst[k] = src[j];
            j = j + 1;
            k = k + 1;
        }
        lo = hi;
    }
}

/// A run sorted by insertion: each element moved before the ones it is less than, so equal ones
/// keep their order.
fn sortRunBy<T>(xs: Slice<T>, cmp: fn(T, T) -> Ordering): void {
    var i = 1;
    while (i < xs.length()) {
        let x = xs[i];
        var j = i;
        while (j > 0 && isLess(cmp(x, xs[j - 1]))) {
            xs[j] = xs[j - 1];
            j = j - 1;
        }
        xs[j] = x;
        i = i + 1;
    }
}

/// One pass of the merge sort: the runs of `width` in `src` merged pairwise into `dst`, the left
/// one's element first where two are equal.
fn mergeRunsBy<T>(src: Slice<T>, dst: Slice<T>, width: int, cmp: fn(T, T) -> Ordering): void {
    let n = src.length();
    var lo = 0;
    while (lo < n) {
        let mid = if (lo + width < n) lo + width else n;
        let hi = if (mid + width < n) mid + width else n;
        var i = lo;
        var j = mid;
        var k = lo;
        while (i < mid && j < hi) {
            if (isLess(cmp(src[j], src[i]))) {
                dst[k] = src[j];
                j = j + 1;
            } else {
                dst[k] = src[i];
                i = i + 1;
            }
            k = k + 1;
        }
        while (i < mid) {
            dst[k] = src[i];
            i = i + 1;
            k = k + 1;
        }
        while (j < hi) {
            dst[k] = src[j];
            j = j + 1;
            k = k + 1;
        }
        lo = hi;
    }
}

/// The unstable sort: partitions around the median of three, the smaller side by recursion and
/// the larger by the loop, insertion below 17 elements, a heap sort once `depth` partitions are
/// spent.
fn introSort<T :: [TotalOrder]>(xs: Slice<T>, depth: int): void {
    var view = xs;
    var left = depth;
    while (view.length() > 16) {
        if (left == 0) {
            heapSort(view);
            return;
        }
        left = left - 1;
        let split = partitionHoare(view);
        if (split < view.length() - split) {
            introSort(view[..split], left);
            view = view[split..];
        } else {
            introSort(view[split..], left);
            view = view[..split];
        }
    }
    sortRunBy(view, (a: T, b: T) => a.totalCompare(b));
}

/// Hoare's partition around the median of the first, middle and last element: every element
/// before the answer is at most the pivot, every one from it at least, and both sides hold one.
/// A sorted part is left as it is; equal elements are split between the sides.
fn partitionHoare<T :: [TotalOrder]>(xs: Slice<T>): int {
    let n = xs.length();
    let pivot = medianOfThree(xs[0], xs[n / 2], xs[n - 1]);
    var i = 0;
    var j = n - 1;
    var split = -1;
    while (split < 0) {
        while (isLess(xs[i].totalCompare(pivot))) {
            i = i + 1;
        }
        while (isGreater(xs[j].totalCompare(pivot))) {
            j = j - 1;
        }
        if (i >= j) {
            split = j + 1;
        } else {
            xs.swap(i, j);
            i = i + 1;
            j = j - 1;
        }
    }
    return split;
}

fn medianOfThree<T :: [TotalOrder]>(a: T, b: T, c: T): T {
    if (isLess(a.totalCompare(b))) {
        if (isLess(b.totalCompare(c))) {
            return b;
        }
        if (isLess(a.totalCompare(c))) {
            return c;
        }
        return a;
    }
    if (isLess(a.totalCompare(c))) {
        return a;
    }
    if (isLess(b.totalCompare(c))) {
        return c;
    }
    return b;
}

/// A heap sort, `O(n log n)` whatever the order: a max-heap built in place, its top swapped to the
/// end one at a time.
fn heapSort<T :: [TotalOrder]>(xs: Slice<T>): void {
    let n = xs.length();
    var start = n / 2 - 1;
    while (start >= 0) {
        siftDown(xs, start, n);
        start = start - 1;
    }
    var end = n - 1;
    while (end > 0) {
        xs.swap(0, end);
        siftDown(xs, 0, end);
        end = end - 1;
    }
}

fn siftDown<T :: [TotalOrder]>(xs: Slice<T>, root: int, end: int): void {
    var r = root;
    while (true) {
        var child = 2 * r + 1;
        if (child >= end) {
            return;
        }
        if (child + 1 < end && isLess(xs[child].totalCompare(xs[child + 1]))) {
            child = child + 1;
        }
        if (!isLess(xs[r].totalCompare(xs[child]))) {
            return;
        }
        xs.swap(r, child);
        r = child;
    }
}

/// `it.map(f)` (10 B6 I3, I4): the values of `it`, each through `f` — lazily, a pull at a time.
/// Named for what it gives: `Map` is the collection's (C4).
pub struct MapIter<I :: [Iterator], U> :: [Iterator] {
    type Item = U;
    type Error = I.Error;
    var inner: I,
    f: fn(I.Item) -> U,

    pub mut fn next(): ?U throws I.Error {
        let x = try this.inner.next();
        if (x == null) {
            return null;
        }
        return this.f(x);
    }
}

/// `it.filter(p)`: the values of `it` that `p` holds for.
pub struct FilterIter<I :: [Iterator]> :: [Iterator] {
    type Item = I.Item;
    type Error = I.Error;
    var inner: I,
    p: fn(I.Item) -> bool,

    pub mut fn next(): ?I.Item throws I.Error {
        var x = try this.inner.next();
        while (x != null && !this.p(x)) {
            x = try this.inner.next();
        }
        return x;
    }
}

/// `it.take(n)`: the first `n` values of `it`, or all where it has fewer.
pub struct TakeIter<I :: [Iterator]> :: [Iterator] {
    type Item = I.Item;
    type Error = I.Error;
    var inner: I,
    var left: int,

    pub mut fn next(): ?I.Item throws I.Error {
        if (this.left <= 0) {
            return null;
        }
        this.left = this.left - 1;
        return try this.inner.next();
    }
}

/// `it.skip(n)`: the values of `it` after its first `n`.
pub struct SkipIter<I :: [Iterator]> :: [Iterator] {
    type Item = I.Item;
    type Error = I.Error;
    var inner: I,
    var n: int,

    pub mut fn next(): ?I.Item throws I.Error {
        while (this.n > 0) {
            this.n = this.n - 1;
            if (try this.inner.next() == null) {
                return null;
            }
        }
        return try this.inner.next();
    }
}

/// `it.takeWhile(p)`: the values of `it` up to the first `p` does not hold for.
pub struct TakeWhileIter<I :: [Iterator]> :: [Iterator] {
    type Item = I.Item;
    type Error = I.Error;
    var inner: I,
    p: fn(I.Item) -> bool,
    var done: bool,

    pub mut fn next(): ?I.Item throws I.Error {
        if (this.done) {
            return null;
        }
        let x = try this.inner.next();
        if (x == null) {
            this.done = true;
            return null;
        }
        if (!this.p(x)) {
            this.done = true;
            return null;
        }
        return x;
    }
}

/// `it.skipWhile(p)`: the values of `it` from the first `p` does not hold for.
pub struct SkipWhileIter<I :: [Iterator]> :: [Iterator] {
    type Item = I.Item;
    type Error = I.Error;
    var inner: I,
    p: fn(I.Item) -> bool,
    var started: bool,

    pub mut fn next(): ?I.Item throws I.Error {
        if (this.started) {
            return try this.inner.next();
        }
        this.started = true;
        var x = try this.inner.next();
        while (x != null && this.p(x)) {
            x = try this.inner.next();
        }
        return x;
    }
}

/// `it.stepBy(n)`: the first value of `it`, then every `n`th.
pub struct StepByIter<I :: [Iterator]> :: [Iterator] {
    type Item = I.Item;
    type Error = I.Error;
    var inner: I,
    step: int,
    var first: bool,

    pub mut fn next(): ?I.Item throws I.Error {
        if (this.first) {
            this.first = false;
            return try this.inner.next();
        }
        var gap = this.step - 1;
        while (gap > 0) {
            gap = gap - 1;
            if (try this.inner.next() == null) {
                return null;
            }
        }
        return try this.inner.next();
    }
}

/// `it.enumerate()`: each value of `it` with its position, from 0.
pub struct EnumerateIter<I :: [Iterator]> :: [Iterator] {
    type Item = (int, I.Item);
    type Error = I.Error;
    var inner: I,
    var i: int,

    pub mut fn next(): ?(int, I.Item) throws I.Error {
        let x = try this.inner.next();
        if (x == null) {
            return null;
        }
        this.i = this.i + 1;
        return (this.i - 1, x);
    }
}

/// `it.inspect(f)`: the values of `it`, each shown to `f` on its way through.
pub struct InspectIter<I :: [Iterator]> :: [Iterator] {
    type Item = I.Item;
    type Error = I.Error;
    var inner: I,
    f: fn(I.Item) -> void,

    pub mut fn next(): ?I.Item throws I.Error {
        let x = try this.inner.next();
        if (x != null) {
            this.f(x);
        }
        return x;
    }
}

/// The join of two thrown types (design/v5/spec/05 E2 K7): what a walk over two sources throws.
/// The compiler reduces it once both are known — one type where they are one, the other where
/// one is `never`, the root `Error` where they differ; open, it covers each of its parts. No value
/// of it is made.
pub struct Join<A :: [Error], B :: [Error]> :: [Error] {
    pub fn message(): string {
        return "a joined error";
    }
}

/// `it.zip(other)`: each value beside the other's at its position, as long as both have one.
pub struct ZipIter<A :: [Iterator], B :: [Iterator]> :: [Iterator] {
    type Item = (A.Item, B.Item);
    type Error = Join<A.Error, B.Error>;
    var a: A,
    var b: B,

    pub mut fn next(): ?(A.Item, B.Item) throws Join<A.Error, B.Error> {
        let x = try this.a.next();
        if (x == null) {
            return null;
        }
        let y = try this.b.next();
        if (y == null) {
            return null;
        }
        return (x, y);
    }
}

/// `it.chain(other)`: the values of `it`, then the other's.
pub struct ChainIter<A :: [Iterator], B :: [Iterator<Item = A.Item>]> :: [Iterator] {
    type Item = A.Item;
    type Error = Join<A.Error, B.Error>;
    var a: A,
    var b: B,
    var second: bool,

    pub mut fn next(): ?A.Item throws Join<A.Error, B.Error> {
        if (!this.second) {
            let x = try this.a.next();
            if (x != null) {
                return x;
            }
            this.second = true;
        }
        return try this.b.next();
    }
}

// Closing through an adapter (I6; the review's M8a-4): an adapter over a Closeable iterator is
// Closeable itself and passes `close()` on, so a loop that leaves early closes the generator
// behind `gen().map(f)`. Its `close()` throws what the inner one's may — the inner's Error, which
// is the adapter's own —, as the rule at the declaration asks of every Closeable iterator
// (LYR-SEM0174). The two over two iterators close both; where both throw, the first error wins
// and the second is suppressed into it (05 E7).

extend<I :: [Iterator, Closeable], U> MapIter<I, U> :: [Closeable] {
    fn close(): void throws I.Error {
        try this.inner.close();
    }
}

extend<I :: [Iterator, Closeable]> FilterIter<I> :: [Closeable] {
    fn close(): void throws I.Error {
        try this.inner.close();
    }
}

extend<I :: [Iterator, Closeable]> TakeIter<I> :: [Closeable] {
    fn close(): void throws I.Error {
        try this.inner.close();
    }
}

extend<I :: [Iterator, Closeable]> SkipIter<I> :: [Closeable] {
    fn close(): void throws I.Error {
        try this.inner.close();
    }
}

extend<I :: [Iterator, Closeable]> TakeWhileIter<I> :: [Closeable] {
    fn close(): void throws I.Error {
        try this.inner.close();
    }
}

extend<I :: [Iterator, Closeable]> SkipWhileIter<I> :: [Closeable] {
    fn close(): void throws I.Error {
        try this.inner.close();
    }
}

extend<I :: [Iterator, Closeable]> StepByIter<I> :: [Closeable] {
    fn close(): void throws I.Error {
        try this.inner.close();
    }
}

extend<I :: [Iterator, Closeable]> EnumerateIter<I> :: [Closeable] {
    fn close(): void throws I.Error {
        try this.inner.close();
    }
}

extend<I :: [Iterator, Closeable]> InspectIter<I> :: [Closeable] {
    fn close(): void throws I.Error {
        try this.inner.close();
    }
}

extend<A :: [Iterator, Closeable], B :: [Iterator, Closeable]> ZipIter<A, B> :: [Closeable] {
    fn close(): void throws Join<A.Error, B.Error> {
        defer try this.b.close();
        try this.a.close();
    }
}

extend<A :: [Iterator, Closeable], B :: [Iterator<Item = A.Item>, Closeable]> ChainIter<A, B> :: [Closeable] {
    fn close(): void throws Join<A.Error, B.Error> {
        defer try this.b.close();
        try this.a.close();
    }
}

// The adapters (I3): members of every iterator, each a struct of its own — monomorphized, no
// allocation, no interface value.
extend<I :: [Iterator]> I {
    /// The values, each through `f`.
    pub fn map<U>(f: fn(I.Item) -> U): MapIter<I, U> {
        return MapIter<I, U> { inner = this, f = f };
    }

    /// The values `p` holds for.
    pub fn filter(p: fn(I.Item) -> bool): FilterIter<I> {
        return FilterIter<I> { inner = this, p = p };
    }

    /// The first `n` values, or all where there are fewer.
    pub fn take(n: int): TakeIter<I> {
        return TakeIter<I> { inner = this, left = n };
    }

    /// The values after the first `n`.
    pub fn skip(n: int): SkipIter<I> {
        return SkipIter<I> { inner = this, n = n };
    }

    /// The values up to the first `p` does not hold for.
    pub fn takeWhile(p: fn(I.Item) -> bool): TakeWhileIter<I> {
        return TakeWhileIter<I> { inner = this, p = p, done = false };
    }

    /// The values from the first `p` does not hold for.
    pub fn skipWhile(p: fn(I.Item) -> bool): SkipWhileIter<I> {
        return SkipWhileIter<I> { inner = this, p = p, started = false };
    }

    /// The first value, then every `n`th; `n` below 1 panics.
    pub fn stepBy(n: int): StepByIter<I> {
        if (n < 1) {
            panic("stepBy needs a step of at least 1");
        }
        return StepByIter<I> { inner = this, step = n, first = true };
    }

    /// Each value with its position, from 0.
    pub fn enumerate(): EnumerateIter<I> {
        return EnumerateIter<I> { inner = this, i = 0 };
    }

    /// The values, each shown to `f` on its way through.
    pub fn inspect(f: fn(I.Item) -> void): InspectIter<I> {
        return InspectIter<I> { inner = this, f = f };
    }

    /// Each value beside the other's at its position, as long as both have one.
    pub fn zip<B :: [Iterable]>(other: B): ZipIter<I, B.Iter> {
        return ZipIter<I, B.Iter> { a = this, b = other.iter() };
    }

    /// The values, then the other's — an iterator of the same items.
    pub fn chain<B :: [Iterator<Item = I.Item>]>(other: B): ChainIter<I, B> {
        return ChainIter<I, B> { a = this, b = other, second = false };
    }

    /// How many values there are, walking them all.
    pub fn count(): int throws I.Error {
        var it = this;
        var n = 0;
        while (try it.next() != null) {
            n = n + 1;
        }
        return n;
    }

    /// `f` over the values from `init`, the last result the answer.
    pub fn fold<A>(init: A, f: fn(A, I.Item) -> A): A throws I.Error {
        var it = this;
        var acc = init;
        var x = try it.next();
        while (x != null) {
            acc = f(acc, x);
            x = try it.next();
        }
        return acc;
    }

    /// `f` over the values from the first; `null` where there is none.
    pub fn reduce(f: fn(I.Item, I.Item) -> I.Item): ?I.Item throws I.Error {
        var it = this;
        let first = try it.next();
        if (first == null) {
            return null;
        }
        var acc = first;
        var x = try it.next();
        while (x != null) {
            acc = f(acc, x);
            x = try it.next();
        }
        return acc;
    }

    /// The first value, or `null`.
    pub fn first(): ?I.Item throws I.Error {
        var it = this;
        return try it.next();
    }

    /// The last value, or `null` — walking them all.
    pub fn last(): ?I.Item throws I.Error {
        var it = this;
        var last = try it.next();
        if (last == null) {
            return null;
        }
        var x = try it.next();
        while (x != null) {
            last = x;
            x = try it.next();
        }
        return last;
    }

    /// The value at position `n` from 0, or `null` — a negative `n` included.
    pub fn nth(n: int): ?I.Item throws I.Error {
        if (n < 0) {
            return null;
        }
        var it = this;
        var left = n;
        while (left > 0) {
            if (try it.next() == null) {
                return null;
            }
            left = left - 1;
        }
        return try it.next();
    }

    /// Whether `p` holds for some value; stops at the first.
    pub fn any(p: fn(I.Item) -> bool): bool throws I.Error {
        return try this.find(p) != null;
    }

    /// Whether `p` holds for every value; stops at the first it does not — `true` for none.
    pub fn all(p: fn(I.Item) -> bool): bool throws I.Error {
        return try this.find((v) => !p(v)) == null;
    }

    /// Whether `p` holds for no value.
    pub fn none(p: fn(I.Item) -> bool): bool throws I.Error {
        return try this.find(p) == null;
    }

    /// The first value `p` holds for, or `null`.
    pub fn find(p: fn(I.Item) -> bool): ?I.Item throws I.Error {
        var it = this;
        var x = try it.next();
        while (x != null && !p(x)) {
            x = try it.next();
        }
        return x;
    }

    /// The position of the first value `p` holds for, from 0, or `null`.
    pub fn position(p: fn(I.Item) -> bool): ?int throws I.Error {
        var it = this;
        var i = 0;
        var x = try it.next();
        while (x != null) {
            if (p(x)) {
                return i;
            }
            i = i + 1;
            x = try it.next();
        }
        return null;
    }

    /// `f` for every value, in order.
    pub fn forEach(f: fn(I.Item) -> void): void throws I.Error {
        var it = this;
        var x = try it.next();
        while (x != null) {
            f(x);
            x = try it.next();
        }
    }

    /// The values in an array, in order.
    pub fn toArray(): I.Item[] throws I.Error {
        var it = this;
        var out: I.Item[] = [];
        var x = try it.next();
        while (x != null) {
            out = out + [x];
            x = try it.next();
        }
        return out;
    }
}

// The terminators of an element kind (10 B6 I4): blocks whose `T` the iterator's `Item` binds
// (05 §13 rule 2), reaching the iterators of numbers, of ordered values, of shown ones.
extend<I :: [Iterator<Item = T>], T :: [Num]> I {
    /// The sum of the values; zero where there is none.
    pub fn sum(): T throws I.Error {
        var it = this;
        var s = T.zero;
        var x = try it.next();
        while (x != null) {
            s = s + x;
            x = try it.next();
        }
        return s;
    }

    /// The product of the values; one where there is none.
    pub fn product(): T throws I.Error {
        var it = this;
        var p = T.one;
        var x = try it.next();
        while (x != null) {
            p = p * x;
            x = try it.next();
        }
        return p;
    }
}

extend<I :: [Iterator<Item = T>], T :: [Ordered]> I {
    /// The least value, or `null`; the first of equal ones.
    pub fn min(): ?T throws I.Error {
        var it = this;
        let first = try it.next();
        if (first == null) {
            return null;
        }
        var least = first;
        var x = try it.next();
        while (x != null) {
            if (x < least) {
                least = x;
            }
            x = try it.next();
        }
        return least;
    }

    /// The greatest value, or `null`; the first of equal ones.
    pub fn max(): ?T throws I.Error {
        var it = this;
        let first = try it.next();
        if (first == null) {
            return null;
        }
        var most = first;
        var x = try it.next();
        while (x != null) {
            if (x > most) {
                most = x;
            }
            x = try it.next();
        }
        return most;
    }
}

extend<I :: [Iterator<Item = T>], T :: [Display]> I {
    /// The values' texts, `sep` between each two.
    pub fn join(sep: string): string throws I.Error {
        var it = this;
        var out = "";
        var x = try it.next();
        var first = true;
        while (x != null) {
            if (!first) {
                out = out + sep;
            }
            first = false;
            out = out + f"{x}";
            x = try it.next();
        }
        return out;
    }
}

// An inclusive range ends without a flag: its last value leaves `start` past `end` — or `end`
// before `start` where that value is the type's `max` (`min` from the back), so neither bound
// leaves the type.
extend<T :: [Integer]> RangeInclusive<T> :: [Iterator, DoubleEnded] {
    type Item = T;

    mut fn next(): ?T {
        if (this.start > this.end) {
            return null;
        }
        let value = this.start;
        if (value == this.end && value == T.max) {
            this.end = value - T.one;
        } else {
            this.start = value + T.one;
        }
        return value;
    }

    mut fn nextBack(): ?T {
        if (this.start > this.end) {
            return null;
        }
        let value = this.end;
        if (value == this.start && value == T.min) {
            this.start = value + T.one;
        } else {
            this.end = value - T.one;
        }
        return value;
    }
}

/// The debug rendering of an array, element by element — the shape has no conformance of its
/// own yet (05 §13.6), so a synthesized `debug()` reaches for this.
pub fn debugArray<T :: [Debug]>(xs: T[]): string {
    var out = "[";
    for (i in 0..xs.length()) {
        if (i > 0) { out = out + ", "; }
        out = out + xs[i].debug();
    }
    return out + "]";
}

/// The same for a view.
pub fn debugSlice<T :: [Debug]>(xs: Slice<T>): string {
    var out = "[";
    for (i in 0..xs.length()) {
        if (i > 0) { out = out + ", "; }
        out = out + xs[i].debug();
    }
    return out + "]";
}

/// The same for an optional: `null`, or the value.
pub fn debugOptional<T :: [Debug]>(o: ?T): string {
    if (o == null) { return "null"; }
    return o.debug();
}

/// Equality of two arrays, element by element — a synthesized `equals` reaches for it.
pub fn equalArrays<T :: [Equatable]>(a: T[], b: T[]): bool {
    if (a.length() != b.length()) { return false; }
    for (i in 0..a.length()) {
        if (!(a[i] == b[i])) { return false; }
    }
    return true;
}

/// The same for two views.
pub fn equalSlices<T :: [Equatable]>(a: Slice<T>, b: Slice<T>): bool {
    if (a.length() != b.length()) { return false; }
    for (i in 0..a.length()) {
        if (!(a[i] == b[i])) { return false; }
    }
    return true;
}

/// Equality of two optionals: both absent, or both present and equal (03 O6).
pub fn equalOptionals<T :: [Equatable]>(a: ?T, b: ?T): bool {
    if (a == null) { return b == null; }
    if (b == null) { return false; }
    return a == b;
}

/// An optional into a hasher: a 0 for `null`, a 1 and the value otherwise — a synthesized `hash`
/// reaches for it. An array and a view are no `Hashable` (10 C8): their slots can be written.
pub fn hashOptionalInto<T :: [Hashable], H :: [Hasher]>(o: ?T, &h: H): void {
    if (o == null) {
        h.writeByte(0);
        return;
    }
    h.writeByte(1);
    o.hash(&h);
}

/// A copy of an array with every element cloned — the clone of a reference field (04 D13).
pub fn cloneArray<T :: [Clone]>(xs: T[]): T[] {
    return arrayOf(xs.length(), (i: int) => xs[i].clone());
}

/// The same for an optional.
pub fn cloneOptional<T :: [Clone]>(o: ?T): ?T {
    if (o == null) { return null; }
    return o.clone();
}

/// `sequence { yield 1; yield 2; }` (design/v5/spec/08 Y11, 10 I7): the shortest way to write a
/// generator inline. No syntax of its own: the trailing block is a generator lambda (08 F5), and
/// this calls it — the coroutine it makes runs nothing until it is pulled.
pub fn sequence<T>(body: fn() -> Coroutine<T>): Coroutine<T> {
    return body();
}
