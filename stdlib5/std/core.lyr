extend float :: [Equatable, Ordered, Display, Add, Sub, Mul, Div, Rem, Neg] {
    fn equals(o: float): bool { return this == o; }
    fn compare(o: float): ?Ordering {
        if (this < o) { return Ordering.Less; }
        if (this > o) { return Ordering.Greater; }
        if (this == o) { return Ordering.Equal; }
        return null;
    }
    fn show(): string { return f"{this}"; }
    fn add(rhs: float): float { return this + rhs; }
    fn sub(rhs: float): float { return this - rhs; }
    fn mul(rhs: float): float { return this * rhs; }
    fn div(rhs: float): float { return this / rhs; }
    fn rem(rhs: float): float { return this % rhs; }
    fn neg(): float { return -this; }
}

extend float32 :: [Equatable, Ordered, Display, Add, Sub, Mul, Div, Rem, Neg] {
    fn equals(o: float32): bool { return this == o; }
    fn compare(o: float32): ?Ordering {
        if (this < o) { return Ordering.Less; }
        if (this > o) { return Ordering.Greater; }
        if (this == o) { return Ordering.Equal; }
        return null;
    }
    fn show(): string { return f"{this}"; }
    fn add(rhs: float32): float32 { return this + rhs; }
    fn sub(rhs: float32): float32 { return this - rhs; }
    fn mul(rhs: float32): float32 { return this * rhs; }
    fn div(rhs: float32): float32 { return this / rhs; }
    fn rem(rhs: float32): float32 { return this % rhs; }
    fn neg(): float32 { return -this; }
}

extend bool :: [Equatable, Hashable, Display] {
    fn equals(o: bool): bool { return this == o; }
    fn hash(): int { return if (this) 1 else 0; }
    fn show(): string { return f"{this}"; }
}

extend char :: [Equatable, Ordered, TotalOrder, Hashable, Display] {
    fn equals(o: char): bool { return this == o; }
    fn compare(o: char): ?Ordering {
        if (this < o) { return Ordering.Less; }
        if (this > o) { return Ordering.Greater; }
        return Ordering.Equal;
    }
    fn totalCompare(o: char): Ordering {
        if (this < o) { return Ordering.Less; }
        if (this > o) { return Ordering.Greater; }
        return Ordering.Equal;
    }
    fn hash(): int { return (this as uint32) as int; }
    fn show(): string { return f"{this}"; }
}

extend string :: [Equatable, Display, Add] {
    fn equals(o: string): bool { return this == o; }
    fn show(): string { return this; }
    fn add(rhs: string): string { return this + rhs; }
}

