// ---------------------------------------------------------------------------------------------
// The synthesized conformances (design/v5/spec/04 D7): a conformance written without a body is
// implemented from the fields — 'Debug' for every type that writes none. The scalars conform
// below; the shapes a field may have render through the helpers at the end.
// ---------------------------------------------------------------------------------------------

/// The debug rendering of a value: `P { x = 1, y = "a" }`, `E.B(3)`. Every struct, class and enum
/// has one, written or synthesized (04 D7); a string renders quoted.
pub interface Debug {
    fn debug(): string;

    /// The debug text written into `out` (10 S6), as `showTo` is `show()`'s.
    fn debugTo(out: StringBuilder): void {
        out.appendStr(this.debug());
    }
}

/// A copy of the value: value fields copied, reference fields cloned (04 D13). Synthesized for a
/// conformance without a body.
pub interface Clone {
    /// Synthesized (05 §14): every field cloned — a `@Shared` field copied as it stands (04
    /// Clone; 09 A11) —; an enum its variant rebuilt from the payload cloned.
    fn clone(): Self {
        comptime if (isEnum<Self>()) {
            comptime for (v in variants<Self>()) {
                if (this is v) {
                    return Self.[v] { comptime for (p in v.payload) [p] = this.[v, p].clone() };
                }
            }
            return this;
        } else {
            return Self { comptime for (f in fields<Self>()) [f] = comptime if (attribute<Shared>(f) != null) this.[f] else this.[f].clone() };
        }
    }
}

/// The value a type starts from: `0`, `""`, `[]`, `null`, a field default. Synthesized field-wise.
pub interface Default {
    /// Synthesized field-wise by the compiler (05 §14): a static member of an interface declares
    /// only, so no default here builds `Self`.
    static fn default(): Self;
}

/// A conversion into the type (10 B4; 04 D6: `as` converts numbers only): `Centimeters.from(m)`.
/// A type writes `From`; `Into` follows from it.
pub interface From<T> {
    static fn from(v: T): Self;
}

/// A conversion out of the type (10 B4): `let cm: Centimeters = m.into();`, the expected type
/// choosing which. The blanket below gives it wherever a `From` is; a type's own `Into<X>` stands
/// only where no `X :: [From<…>]` of the type gives the same (04 D15: the blanket excludes it where
/// it reaches).
pub interface Into<T> {
    fn into(): T;
}

extend<T, U :: [From<T>]> T :: [Into<U>] {
    fn into(): U {
        return U.from(this);
    }
}

extend int :: [Debug, Clone, Default] {
    fn debug(): string { return f"{this}"; }
    fn clone(): int { return this; }
    static fn default(): int { return 0; }
}

