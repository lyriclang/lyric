    static fn default(): bool { return false; }
}

extend char :: [Debug, Clone] {
    /// Between `'`, escaped as a text's characters are (10 S14) — `'\''`, `'\n'`, `'\u{200b}'`.
    fn debug(): string {
        let out = StringBuilder.new();
        out.appendChar('\'');
        escapeTo(out, this, '\'');
        out.appendChar('\'');
        return out.toString();
    }
    fn clone(): char { return this; }
}

// The way into a char (10 B5 Z8): it answers `null` where `as char` would panic — a number from
// data is no programmer's error (B3). The way out is `c as uint32` (the review's A9e: a method
// that said the same went).
extend char {
    /// The character of a scalar value; `null` for a surrogate, 0xD800…0xDFFF, or beyond
    /// 0x10FFFF.
    pub static fn fromUint32(n: uint32): ?char {
        if (n > 0x10FFFF || (n >= 0xD800 && n <= 0xDFFF)) {
            return null;
        }
        return n as char;
    }
}

/// A character's general category (UAX #44), in the standard's order (10 B9 S5). No `char` is a
/// `Surrogate` — the halves of a UTF-16 pair are no scalar values —; the variant is there because
/// the standard lists it.
pub enum UnicodeCategory :: [Equatable, Hashable, Debug] {
    UppercaseLetter,
    LowercaseLetter,
    TitlecaseLetter,
    ModifierLetter,
    OtherLetter,
    NonspacingMark,
    SpacingMark,
    EnclosingMark,
    DecimalNumber,
    LetterNumber,
    OtherNumber,
    ConnectorPunctuation,
    DashPunctuation,
    OpenPunctuation,
    ClosePunctuation,
    InitialPunctuation,
    FinalPunctuation,
    OtherPunctuation,
    MathSymbol,
    CurrencySymbol,
    ModifierSymbol,
    OtherSymbol,
    SpaceSeparator,
    LineSeparator,
    ParagraphSeparator,
    Control,
    Format,
    Surrogate,
    PrivateUse,
    Unassigned,
}

// The Unicode Character Database's answers (lyr/unicode.h): the category as its index in
// UnicodeCategory's order, the simple case mappings, White_Space.
fn unicodeCategory(c: char): int;
fn unicodeUpper(c: char): char;
fn unicodeLower(c: char): char;
fn unicodeWhiteSpace(c: char): bool;

fn categoryOf(k: int): UnicodeCategory {
    return match (k) {
        0 => .UppercaseLetter,
        1 => .LowercaseLetter,
        2 => .TitlecaseLetter,
        3 => .ModifierLetter,
        4 => .OtherLetter,
        5 => .NonspacingMark,
        6 => .SpacingMark,
        7 => .EnclosingMark,
        8 => .DecimalNumber,
        9 => .LetterNumber,
        10 => .OtherNumber,
        11 => .ConnectorPunctuation,
        12 => .DashPunctuation,
        13 => .OpenPunctuation,
        14 => .ClosePunctuation,
        15 => .InitialPunctuation,
        16 => .FinalPunctuation,
        17 => .OtherPunctuation,
        18 => .MathSymbol,
        19 => .CurrencySymbol,
        20 => .ModifierSymbol,
        21 => .OtherSymbol,
        22 => .SpaceSeparator,
        23 => .LineSeparator,
        24 => .ParagraphSeparator,
        25 => .Control,
        26 => .Format,
        27 => .Surrogate,
        28 => .PrivateUse,
        _ => .Unassigned,
    };
}

// What a character is (10 B9 S5): `isX` asks Unicode — the general category, or for whitespace the
// property White_Space, from the Unicode Character Database std.string's `unicodeVersion` names —,
// `isAsciiX` asks ASCII alone. Case maps one character to one (the simple case mapping) and knows
// no locale: `ß` stays `ß` (S4).
extend char {
    /// The general category.
    pub fn category(): UnicodeCategory {
        return categoryOf(unicodeCategory(this));
    }

    /// A letter of any script: the categories Lu, Ll, Lt, Lm and Lo.
    pub fn isAlpha(): bool {
        return unicodeCategory(this) <= 4;
    }

    /// A decimal digit of any script: the category Nd — `'٣'` is one. `isAsciiDigit` asks for
    /// `0`–`9` alone, and `parse` reads those alone (Z6).
    pub fn isDigit(): bool {
        return unicodeCategory(this) == 8;
    }

    /// A letter or a decimal digit: `isAlpha` or `isDigit`.
    pub fn isAlphanumeric(): bool {
        let k = unicodeCategory(this);
        return k <= 4 || k == 8;
    }

    /// The property White_Space: the space, the tab, the line ends, the no-break spaces, the
    /// ideographic space and their kin.
    pub fn isWhitespace(): bool {
        return unicodeWhiteSpace(this);
    }

    /// An uppercase letter: the category Lu.
    pub fn isUpper(): bool {
        return unicodeCategory(this) == 0;
    }

    /// A lowercase letter: the category Ll.
    pub fn isLower(): bool {
        return unicodeCategory(this) == 1;
    }

    /// A control character: the category Cc.
    pub fn isControl(): bool {
        return unicodeCategory(this) == 25;
    }

    /// The uppercase character, by the simple mapping; the character itself where it has none.
    pub fn toUpper(): char {
        return unicodeUpper(this);
    }

    /// The lowercase character, by the simple mapping; the character itself where it has none.
    pub fn toLower(): char {
        return unicodeLower(this);
    }

    /// `0`–`9`.
    pub fn isAsciiDigit(): bool {
        return this >= '0' && this <= '9';
    }

    /// `a`–`z` and `A`–`Z`.
    pub fn isAsciiAlpha(): bool {
        return (this >= 'a' && this <= 'z') || (this >= 'A' && this <= 'Z');
    }

    /// `0`–`9`, `a`–`f` and `A`–`F`.
    pub fn isAsciiHexDigit(): bool {
        return this.isAsciiDigit() || (this >= 'a' && this <= 'f') || (this >= 'A' && this <= 'F');
    }

    /// ASCII's whitespace as WHATWG counts it, Rust too: the space, tab, line feed, form feed and
    /// carriage return — not the vertical tab.
    pub fn isAsciiWhitespace(): bool {
        let n = this as uint32;
        return n == 32 || n == 9 || n == 10 || n == 12 || n == 13;
    }

    /// The character's value as a digit in base `radix`, 2–36: `0`–`9`, then `a`–`z` or `A`–`Z` for
    /// 10–35 — ASCII alone, as `parse` reads. `null` where it is no digit of the base; a radix
    /// outside 2–36 is a programmer's error and panics.
    pub fn toDigit(radix: int): ?int {
        if (radix < 2 || radix > 36) {
            panic(f"radix {radix} is outside 2…36");
        }
        let n = this as uint32;
        var d = 36;
        if (n >= 48 && n <= 57) {
            d = (n - 48) as int;
        } else if (n >= 97 && n <= 122) {
            d = (n - 87) as int;
        } else if (n >= 65 && n <= 90) {
            d = (n - 55) as int;
        }
        if (d < radix) {
            return d;
        }
        return null;
    }

    /// The character of the digit `n` in base `radix`, 2–36, its letters lowercase: `fromDigit(11,
    /// 16)` is `b`. `null` where `n` is no digit of the base; a radix outside 2–36 panics.
    pub static fn fromDigit(n: int, radix: int): ?char {
        if (radix < 2 || radix > 36) {
            panic(f"radix {radix} is outside 2…36");
        }
        if (n < 0 || n >= radix) {
            return null;
        }
        let code = if (n < 10) 48 + n else 87 + n;
        return (code as uint32) as char;
    }
}

/// A string writes its bytes and then 255, which no UTF-8 text holds: ("ab", "c") and ("a", "bc")
/// write differently (10 C8).
extend string :: [Hashable] {
    fn hash<H :: [Hasher]>(&h: H): void {
        let n = byteCount(this);
        var i = 0;
        while (i < n) {
            h.writeByte(byteAt(this, i) as uint8);
            i = i + 1;
        }
        h.writeByte(255);
    }
}

extend string :: [Debug, Clone, Default] {
    /// Between `"`, as it would be written (10 S14, Rust's `escape_debug`): `["a\"b", "c"]` prints
    /// as it is written, and the quotes keep the boundaries C9 draws with them.
    fn debug(): string {
        let out = StringBuilder.new();
        debugText(out, this);
        return out.toString();
    }
    fn debugTo(out: StringBuilder): void { debugText(out, this); }
    fn clone(): string { return this; }
    static fn default(): string { return ""; }
}

fn debugText(out: StringBuilder, s: StringView): void {
    out.appendChar('"');
    for (c in s.chars()) {
        escapeTo(out, c, '"');
    }
    out.appendChar('"');
}

/// One character as `Debug` writes it between `mark`s (10 S14): `\\`, the mark, `\n`, `\r`,
/// `\t` and `\0` escaped; a character that does not print as itself as `\u{…}`, its scalar value
/// in hex.
fn escapeTo(out: StringBuilder, c: char, mark: char): void {
    let n = c as uint32;
    if (c == mark || c == '\\') {
        out.appendChar('\\');
        out.appendChar(c);
    } else if (c == '\n') {
        out.appendStr("\\n");
    } else if (c == '\r') {
        out.appendStr("\\r");
    } else if (c == '\t') {
        out.appendStr("\\t");
    } else if (n == 0) {
        out.appendStr("\\0");
    } else if (printsAsItself(c)) {
        out.appendChar(c);
    } else {
        // The hex digits by hand: a format spec here would pull the whole format language into
        // every program that shows a text.
        let digits = "0123456789abcdef";
        out.appendStr("\\u{");
        var k = 5;
        var started = false;
        while (k >= 0) {
            let d = ((n >> ((k * 4) as uint32)) & 15) as int;
            if (d != 0 || started || k == 0) {
                out.appendChar(digits[d]);
                started = true;
            }
            k -= 1;
        }
        out.appendChar('}');
    }
}

/// Whether a character prints as itself in a `Debug` text: every category but Cc, Cf, Cs, Co,
/// Cn, Zl and Zp, and of the space separators the space alone.
fn printsAsItself(c: char): bool {
    let n = c as uint32;
    if (n < 128) {
        return n >= 32 && n != 127;
    }
    return unicodeCategory(c) < 22;
}

extend string {
    /// The text of the characters in order (10 S3).
    pub static fn fromChars<I :: [Iterator<Item = char>]>(chars: I): string throws I.Error {
        var walk = chars;
        let out = StringBuilder.new();
        loop {
            if (let c = try walk.next()) {
                out.appendChar(c);
            } else {
                break;
            }
        }
        return out.toString();
    }
}

// ---------------------------------------------------------------------------------------------
// The numbers (design/v5/spec/10 B5): ten types, one tower of interfaces with static members.
// Arithmetic stays in the type — the parent lists fix 'Out' (05 §8 rule 7) — and the defaults are
// each type's own (04 D9): 'int8.min.abs()' is a direct call, no value of an interface made.
// ---------------------------------------------------------------------------------------------

/// Every number type (10 B5 Z1): its zero and its one, arithmetic that stays in the type.
pub interface Num :: [Equatable, Ordered, Add<Out = Self>, Sub<Out = Self>, Mul<Out = Self>,
    Div<Out = Self>, Rem<Out = Self>, Display, Debug, Parse, Default] {
    static let zero: Self;
    static let one: Self;

    /// Whether this is the type's zero.
    fn isZero(): bool {
        return this == Self.zero;
    }
}

/// A number with a sign: the signed integers and the floats — what `std.math`'s `abs` and
/// `signum` take; `uint` has neither.
pub interface Signed :: [Num, Neg<Out = Self>] {
}

/// The eight integer types: their range, a total order, a hash, the bit operators.
pub interface Integer :: [Num, TotalOrder, Hashable, BitAnd<Out = Self>, BitOr<Out = Self>,
    BitXor<Out = Self>, BitNot<Out = Self>, Shl<Out = Self>, Shr<Out = Self>] {
    static let min: Self;
    static let max: Self;
    static let bitWidth: int;
    static let isSigned: bool;

    /// `v` as this type where it fits, `null` where it does not (10 B5 Z4).
    static fn exact<T :: [Integer]>(v: T): ?Self;

    /// `v` as this type, held at `min` or `max` where it does not fit.
    static fn clamping<T :: [Integer]>(v: T): Self;

    /// The sum, or `null` where it does not fit the type.
    fn checkedAdd(o: Self): ?Self {
        return if (addOverflows(this, o)) null else addWrapping(this, o);
    }

    /// The difference, or `null` where it does not fit.
    fn checkedSub(o: Self): ?Self {
        return if (subOverflows(this, o)) null else subWrapping(this, o);
    }

    /// The product, or `null` where it does not fit.
    fn checkedMul(o: Self): ?Self {
        return if (mulOverflows(this, o)) null else mulWrapping(this, o);
    }

    /// The quotient, or `null` for a zero divisor and for `min / -1`, which does not fit.
    fn checkedDiv(o: Self): ?Self {
        if (o == Self.zero || (Self.isSigned && this == Self.min && o == Self.zero - Self.one)) {
            return null;
        }
        return this / o;
    }

    /// The remainder, or `null` for a zero divisor; a remainder by `-1` is `0`.
    fn checkedRem(o: Self): ?Self {
        if (o == Self.zero) {
            return null;
        }
        if (Self.isSigned && o == Self.zero - Self.one) {
            return Self.zero;
        }
        return this % o;
    }

    /// The sum, held at `min` or `max` where it does not fit.
    fn saturatingAdd(o: Self): Self {
        return this.checkedAdd(o) ?? (if (o < Self.zero) Self.min else Self.max);
    }

    /// The difference, held at `min` or `max` where it does not fit.
    fn saturatingSub(o: Self): Self {
        return this.checkedSub(o) ?? (if (o < Self.zero) Self.max else Self.min);
    }

    /// The product, held at `min` or `max` by the sign it would have.
    fn saturatingMul(o: Self): Self {
        return this.checkedMul(o) ?? (if ((this < Self.zero) != (o < Self.zero)) Self.min else Self.max);
    }

    /// The sum modulo 2^bitWidth, as `+%` on the type (08 Y4).
    fn wrappingAdd(o: Self): Self {
        return addWrapping(this, o);
    }

    /// The difference modulo 2^bitWidth, as `-%`.
    fn wrappingSub(o: Self): Self {
        return subWrapping(this, o);
    }

    /// The product modulo 2^bitWidth, as `*%`.
    fn wrappingMul(o: Self): Self {
        return mulWrapping(this, o);
    }

    /// The quotient, where `min / -1` wraps to `min`; a zero divisor panics as `/` does.
    fn wrappingDiv(o: Self): Self {
        if (Self.isSigned && this == Self.min && o == Self.zero - Self.one) {
            return Self.min;
        }
        return this / o;
    }

    /// The remainder, where a remainder by `-1` is `0`; a zero divisor panics as `%` does.
    fn wrappingRem(o: Self): Self {
        if (Self.isSigned && o == Self.zero - Self.one) {
            return Self.zero;
        }
        return this % o;
    }

    /// `this` to the `n`th power, by squaring; an overflow is one of `*` (03 T2).
    fn pow(n: uint): Self {
        var result = Self.one;
        var base = this;
        var k = n;
        while (k > 0) {
            if (k % 2 == 1) {
                result = result * base;
            }
            k = k / 2;
            if (k > 0) {
                base = base * base;
            }
        }
        return result;
    }

    /// The zero bits above the highest one bit; `bitWidth` for zero.
    fn leadingZeros(): int {
        return countLeadingZeros(this);
    }

    /// The zero bits below the lowest one bit; `bitWidth` for zero.
    fn trailingZeros(): int {
        return countTrailingZeros(this);
    }

    /// The one bits.
    fn popCount(): int {
        return countOnes(this);
    }

    /// The bits rotated left by `n`, modulo `bitWidth`; a negative `n` rotates right.
    fn rotateLeft(n: int): Self {
        return rotateBitsLeft(this, n);
    }

    /// The bits rotated right by `n`, modulo `bitWidth`; a negative `n` rotates left.
    fn rotateRight(n: int): Self {
        return rotateBitsLeft(this, -(n % Self.bitWidth));
    }
}

// The natives the defaults stand on (10 B5): one each, generic, a C builtin serving every
// integer width — whether + - * leave the type and the result wrapped to it (what `+%` gives a
// builtin, 08 Y4), the bit counts, the rotation.
fn addOverflows<T>(a: T, b: T): bool;
fn subOverflows<T>(a: T, b: T): bool;
fn mulOverflows<T>(a: T, b: T): bool;
fn addWrapping<T>(a: T, b: T): T;
fn subWrapping<T>(a: T, b: T): T;
fn mulWrapping<T>(a: T, b: T): T;
fn countLeadingZeros<T>(x: T): int;
fn countTrailingZeros<T>(x: T): int;
fn countOnes<T>(x: T): int;
fn rotateBitsLeft<T>(x: T, n: int): T;

/// The two float types (10 B5 Z1, Z2): what describes the type is a member — its constants, its
/// bits, its order, NaN and the infinities —; what one computes with a number is `std.math`'s.
pub interface Float :: [Signed] {
    /// The distance from `1.0` to the next value above it.
    static let epsilon: Self;
    static let infinity: Self;
    /// The quiet NaN with its sign clear — what `0.0 / 0.0` gives has the sign the hardware sets.
    static let nan: Self;
    /// The most negative finite value.
    static let min: Self;
    /// The greatest finite value.
    static let max: Self;
    /// The least positive value, a subnormal.
    static let leastPositive: Self;

    /// The value a bit pattern names: a `float` its 64 bits, a `float32` the low 32.
    static fn fromBits(b: uint64): Self;

    /// Whether this is NaN, the one value unequal to itself.
    fn isNan(): bool {
        return this != this;
    }

    /// Whether this is an infinity, of either sign.
    fn isInfinite(): bool {
        return this == Self.infinity || this == -Self.infinity;
    }

    /// Whether this is neither NaN nor an infinity.
    fn isFinite(): bool {
        return !this.isNan() && !this.isInfinite();
    }

    /// IEEE 754's total order, for sorting: -NaN, -infinity, the negatives, -0.0, 0.0, the
    /// positives, infinity, NaN — every value in its one place.
    fn totalCompare(o: Self): Ordering {
        let a = totalOrderKey(this);
        let b = totalOrderKey(o);
        if (a < b) {
            return Ordering.Less;
        }
        if (a > b) {
            return Ordering.Greater;
        }
        return Ordering.Equal;
    }

    /// The bit pattern: a `float` its 64 bits, a `float32` its 32 in the low ones.
    fn toBits(): uint64 {
        return floatBits(this);
    }
}

// The bits as macros (11 W4); libm's functions are std.math's.
fn floatBits<T>(x: T): uint64;
fn floatFromBits<T>(b: uint64, like: T): T;
fn totalOrderKey<T>(x: T): uint64;

extend int :: [Num, Signed, Integer] {
    static let zero: int = 0;
    static let one: int = 1;
    static let min: int = -9223372036854775808;
    static let max: int = 9223372036854775807;
    static let bitWidth: int = 64;
    static let isSigned: bool = true;

    /// The decimal integer a text names (`Parse`).
    static fn parse(s: StringView): int throws ParseError {
        return try parseInteger(s, 10);
    }

    /// The integer a text names in `radix`, 2…36.
    static fn parse(s: StringView, radix: int): int throws ParseError {
        return try parseInteger(s, radix);
    }

    /// `v` as an `int` where it fits, `null` where it does not (10 B5 Z4).
    static fn exact<T :: [Integer]>(v: T): ?int {
        return exactly(v);
    }

    /// `v` as an `int`, held at `min` or `max` where it does not fit.
    static fn clamping<T :: [Integer]>(v: T): int {
        return clamped(v);
    }
}

