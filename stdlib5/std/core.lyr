// ---------------------------------------------------------------------------------------------
// Parsing: a value read from a text, and what is wrong with the
// text thrown — the text is the data's, so it never panics. An integer is read here in Lyric over
// the string's bytes; a float's form is checked here and its value read by C, correctly rounded.
// ---------------------------------------------------------------------------------------------

/// Why a text is not a value of the type.
pub enum ParseErrorKind :: [Equatable, Debug] {
    Empty,
    Invalid,
    Overflow,
}

/// The error `parse` throws when a text is not a value of the type.
///
/// The text was empty, was not of the type's form, or named a number beyond the type's range.
pub struct ParseError :: [Error] {
    /// Why the text was refused.
    pub kind: ParseErrorKind,
    /// What the parser can say beyond the kind, such as what it expected where it stopped.
    ///
    /// Empty where it says nothing (the number parsers); filled by `Uri.parse`, the address
    /// parsers and the time parsers.
    pub detail: string = "",
    /// The byte offset in the text the refusal points at, where the parser knows one.
    pub offset: ?int = null,

    pub fn message(): string {
        var text = match (this.kind) {
            .Empty => "cannot parse a value from an empty text",
            .Invalid => "the text is not a value of the type",
            .Overflow => "the number is beyond the type's range",
        };
        if (!this.detail.isEmpty()) {
            text = f"{text}: {this.detail}";
        }
        if (let at = this.offset) {
            text = f"{text} (at byte {at})";
        }
        return text;
    }
}

/// A type read from a text: `T.parse(s)`, throwing [ParseError] with the reason.
///
/// The number types conform through [Num], and `bool` conforms too.
pub interface Parse {
    static fn parse(s: StringView): Self throws ParseError;
}

extend bool :: [Parse] {
    /// Parses `true` or `false`, exactly.
    ///
    /// # Errors
    /// A [ParseError] for any other text.
    static fn parse(s: StringView): bool throws ParseError {
        if (s == "true") {
            return true;
        }
        if (s == "false") {
            return false;
        }
        throw ParseError { kind = if (s == "") ParseErrorKind.Empty else ParseErrorKind.Invalid };
    }
}

/// Parses the integer a text names in base `radix`.
///
/// The form is an optional `+` or `-`, ASCII digits, `_` between two of them, nothing else. A
/// byte outside the form is `Invalid` however many digits run before it; only a well-formed
/// number is an `Overflow`. Negative numbers accumulate downward, so `min` is reached.
///
/// # Panics
/// When `radix` is outside 2…36.
///
/// # Errors
/// A [ParseError] of kind `Empty`, `Invalid` or `Overflow`.
fn parseInteger<T :: [Integer]>(s: StringView, radix: int): T throws ParseError {
    if (radix < 2 || radix > 36) {
        panic(f"radix {radix} is outside 2..36");
    }
    let n = byteCount(s);
    if (n == 0) {
        throw ParseError { kind = ParseErrorKind.Empty };
    }
    let negative = byteAt(s, 0) == 45;
    var i = if (negative || byteAt(s, 0) == 43) 1 else 0;
    if (i == n || (negative && !T.isSigned)) {
        throw ParseError { kind = ParseErrorKind.Invalid };
    }
    // The common case first: decimal, at most 18 digits, no '_' — summed in `int`, where 18 digits
    // cannot overflow, and fitted to `T` once. Any other byte goes to the general path below, which
    // reads the text again and reports what is wrong; the answer is the same either way.
    if (radix == 10 && n - i <= 18) {
        var acc = 0;
        var j = i;
        while (j < n) {
            let b = byteAt(s, j);
            if (b < 48 || b > 57) {
                break;
            }
            acc = acc * 10 + (b - 48);
            j = j + 1;
        }
        if (j == n) {
            let fitted: ?T = exactly(if (negative) -acc else acc);
            if (let v = fitted) {
                return v;
            }
            throw ParseError { kind = ParseErrorKind.Overflow };
        }
    }
    let base = asTypeOf(radix, T.zero);
    var value = T.zero;
    var overflowed = false;
    var afterDigit = false;
    while (i < n) {
        let b = byteAt(s, i);
        i = i + 1;
        if (b == 95) {
            if (!afterDigit || i == n) {
                throw ParseError { kind = ParseErrorKind.Invalid };
            }
            afterDigit = false;
            continue;
        }
        let d = digitValue(b);
        if (d >= radix) {
            throw ParseError { kind = ParseErrorKind.Invalid };
        }
        afterDigit = true;
        if (!overflowed) {
            let digit = asTypeOf(d, T.zero);
            let scaled = value.checkedMul(base);
            if (scaled == null) {
                overflowed = true;
            } else {
                let next = if (negative) scaled.checkedSub(digit) else scaled.checkedAdd(digit);
                if (next == null) {
                    overflowed = true;
                } else {
                    value = next;
                }
            }
        }
    }
    if (overflowed) {
        throw ParseError { kind = ParseErrorKind.Overflow };
    }
    return value;
}

/// Returns `v` in `U` where it fits, `null` where it does not.
///
/// Converted as `as` wraps, it fits exactly when it comes back the same and keeps its sign.
fn exactly<T :: [Integer], U :: [Integer]>(v: T): ?U {
    let w = asTypeOf(v, U.zero);
    if (asTypeOf(w, v) != v || (v < T.zero) != (w < U.zero)) {
        return null;
    }
    return w;
}

/// Returns `v` in `U`, held at `U.min` or `U.max` where it does not fit.
fn clamped<T :: [Integer], U :: [Integer]>(v: T): U {
    let w: ?U = exactly(v);
    return w ?? (if (v < T.zero) U.min else U.max);
}

/// Returns a byte's value as a digit: `0`…`9`, then `a`…`z` or `A`…`Z` for 10…35; 36 for any
/// other byte.
fn digitValue(b: int): int {
    if (b >= 48 && b <= 57) {
        return b - 48;
    }
    if (b >= 97 && b <= 122) {
        return b - 87;
    }
    if (b >= 65 && b <= 90) {
        return b - 55;
    }
    return 36;
}

/// Returns whether a byte is an ASCII digit.
fn isDigit(b: int): bool {
    return b >= 48 && b <= 57;
}

/// Checks that a text has a float's form.
///
/// The form is an optional sign, then `inf`, `nan`, or digits with an optional `.` and fraction
/// (one digit at least) and an optional exponent, `e` or `E` with its own sign and digits; `_`
/// between two digits, nothing else.
///
/// # Errors
/// A [ParseError] where the text is empty or not of the form.
fn checkFloatText(s: StringView): void throws ParseError {
    let n = byteCount(s);
    if (n == 0) {
        throw ParseError { kind = ParseErrorKind.Empty };
    }
    var i = if (byteAt(s, 0) == 43 || byteAt(s, 0) == 45) 1 else 0;
    if (n - i == 3 && (isWord(s, i, 105, 110, 102) || isWord(s, i, 110, 97, 110))) {
        return;
    }
    var digits = 0;
    var point = false;
    var afterDigit = false;
    while (i < n) {
        let b = byteAt(s, i);
        if (isDigit(b)) {
            digits = digits + 1;
            afterDigit = true;
        } else if (b == 95 && afterDigit && i + 1 < n && isDigit(byteAt(s, i + 1))) {
            afterDigit = false;
        } else if (b == 46 && !point) {
            point = true;
            afterDigit = false;
        } else {
            break;
        }
        i = i + 1;
    }
    if (digits == 0) {
        throw ParseError { kind = ParseErrorKind.Invalid };
    }
    if (i == n) {
        return;
    }
    if (byteAt(s, i) != 101 && byteAt(s, i) != 69) {
        throw ParseError { kind = ParseErrorKind.Invalid };
    }
    i = i + 1;
    if (i < n && (byteAt(s, i) == 43 || byteAt(s, i) == 45)) {
        i = i + 1;
    }
    var exponent = 0;
    afterDigit = false;
    while (i < n) {
        let b = byteAt(s, i);
        if (isDigit(b)) {
            exponent = exponent + 1;
            afterDigit = true;
        } else if (b == 95 && afterDigit && i + 1 < n && isDigit(byteAt(s, i + 1))) {
            afterDigit = false;
        } else {
            throw ParseError { kind = ParseErrorKind.Invalid };
        }
        i = i + 1;
    }
    if (exponent == 0) {
        throw ParseError { kind = ParseErrorKind.Invalid };
    }
}

/// Returns whether the three bytes at `i` are `a`, `b`, `c`.
fn isWord(s: StringView, i: int, a: int, b: int, c: int): bool {
    return byteAt(s, i) == a && byteAt(s, i + 1) == b && byteAt(s, i + 2) == c;
}

// The natives the text stands on: a view's length and bytes, which a string gives at the
// argument; a number converted as `as` converts it to the type of `like` where that is a
// parameter's; a float's text read by C (`strtod`, `strtof`) once its form is checked.
fn byteCount(s: StringView): int;
fn byteAt(s: StringView, i: int): int;
/// Returns whether `p`'s bytes stand in `s` from byte `at` on; false where they would run past
/// its end.
fn viewMatchesAt(s: StringView, p: StringView, at: int): bool;
/// Returns where `p`'s bytes first stand in `s` at or after byte `from`, or -1 where nowhere.
///
/// A negative `from` counts as 0.
fn viewFind(s: StringView, p: StringView, from: int): int;
/// Returns the eight bytes from byte `i` as a word, the lowest first, as `writeUint` writes them.
fn viewWordAt(s: StringView, i: int): uint64;
/// Compares byte by byte, then by length: -1, 0 or 1.
fn compareBytes(a: string, b: string): int;
/// Returns the bytes `from..to` as a string.
///
/// # Panics
/// When the range is out of bounds or off a character's boundary.
fn byteSlice(s: string, from: int, to: int): string;
/// Creates a string of the array's first `count` bytes.
fn stringOfBytes(bytes: uint8[], count: int): string;
// --- strings ----------------------------------------------------------------------------------
// UTF-8, immutable, the length in bytes. The members stand once on `StringView`, which a string
// reaches through a view of all of itself: what cuts gives a view, no copy; what builds gives a
// string. The search takes a `Pattern`: a view or a string, a character, a test of characters.

extend string :: [Ordered, TotalOrder] {
    /// Compares byte by byte, which is the order of the code points.
    fn compare(o: string): ?Ordering {
        return this.totalCompare(o);
    }

    fn totalCompare(o: string): Ordering {
        let c = compareBytes(this, o);
        if (c < 0) {
            return Ordering.Less;
        }
        if (c > 0) {
            return Ordering.Greater;
        }
        return Ordering.Equal;
    }
}

extend string {
    /// Returns the length in bytes, `O(1)`; `charCount()` counts the characters.
    pub fn length(): int {
        return byteCount(this);
    }

    /// Returns whether it has no byte.
    pub fn isEmpty(): bool {
        return byteCount(this) == 0;
    }
}

/// What a text is searched for: a view or a string, a character, a test of characters.
///
/// One signature per operation takes any of them: `contains(p)`, `split(p)`, `stripPrefix(p)` …
/// Two primitives work over byte indices of `text`: `matchAt` returns the end of a match that
/// begins at `at`, `matchBefore` the start of a match that ends at `end`, `null` where there is
/// none. `at` and `end` are a character's first byte or the text's length. A third, `nextIn`,
/// finds where the next match begins; its default walks the first bytes with `matchAt`, and a
/// pattern that can find faster (a view, a string) overrides it.
pub interface Pattern {
    fn matchAt(text: StringView, at: int): ?int;
    fn matchBefore(text: StringView, end: int): ?int;

    /// Returns the first byte at or after `from` where a match begins, or `null`.
    ///
    /// The byte is a character's first byte or the length.
    fn nextIn(text: StringView, from: int): ?int {
        let n = byteCount(text);
        var at = from;
        while (at <= n) {
            if (this.matchAt(text, at) != null) {
                return at;
            }
            at = nextChar(text, at);
        }
        return null;
    }
}

/// Matches a view's bytes, where they stand.
extend StringView :: [Pattern] {
    fn matchAt(text: StringView, at: int): ?int {
        if (viewMatchesAt(text, this, at)) {
            return at + byteCount(this);
        }
        return null;
    }

    fn matchBefore(text: StringView, end: int): ?int {
        let start = end - byteCount(this);
        if (viewMatchesAt(text, this, start)) {
            return start;
        }
        return null;
    }

    fn nextIn(text: StringView, from: int): ?int {
        let at = viewFind(text, this, from);
        if (at < 0) {
            return null;
        }
        return at;
    }
}

/// Matches a string's bytes, as its view does.
extend string :: [Pattern] {
    fn matchAt(text: StringView, at: int): ?int {
        if (viewMatchesAt(text, this, at)) {
            return at + byteCount(this);
        }
        return null;
    }

    fn matchBefore(text: StringView, end: int): ?int {
        let start = end - byteCount(this);
        if (viewMatchesAt(text, this, start)) {
            return start;
        }
        return null;
    }

    fn nextIn(text: StringView, from: int): ?int {
        let at = viewFind(text, this, from);
        if (at < 0) {
            return null;
        }
        return at;
    }
}

/// Matches a character for which the test holds.
extend fn(char) -> bool :: [Pattern] {
    fn matchAt(text: StringView, at: int): ?int {
        if (at >= byteCount(text)) {
            return null;
        }
        let c = charOfView(text, at);
        if (!this(c)) {
            return null;
        }
        return at + utf8Width(c);
    }

    fn matchBefore(text: StringView, end: int): ?int {
        if (end <= 0) {
            return null;
        }
        let start = previousChar(text, end);
        if (!this(charOfView(text, start))) {
            return null;
        }
        return start;
    }
}

/// Matches the character, where it stands.
extend char :: [Pattern] {
    fn matchAt(text: StringView, at: int): ?int {
        if (at >= byteCount(text) || charOfView(text, at) != this) {
            return null;
        }
        return at + utf8Width(this);
    }

    fn matchBefore(text: StringView, end: int): ?int {
        if (end <= 0) {
            return null;
        }
        let start = previousChar(text, end);
        if (charOfView(text, start) != this) {
            return null;
        }
        return start;
    }
}

/// Returns the first byte of the character after the one at `at`.
///
/// Where `at` is the length it returns one past the length, so a walk over the characters'
/// first bytes ends there.
fn nextChar(text: StringView, at: int): int {
    let n = byteCount(text);
    var i = at + 1;
    while (i < n && (byteAt(text, i) & 192) == 128) {
        i = i + 1;
    }
    return i;
}

/// Returns the first byte of the character that ends at `end`; -1 at the start.
fn previousChar(text: StringView, end: int): int {
    var i = end - 1;
    while (i > 0 && (byteAt(text, i) & 192) == 128) {
        i = i - 1;
    }
    return i;
}

/// Returns how many bytes UTF-8 gives `c`.
fn utf8Width(c: char): int {
    let code = c as uint32;
    if (code < 128) {
        return 1;
    }
    if (code < 2048) {
        return 2;
    }
    if (code < 65536) {
        return 3;
    }
    return 4;
}

/// Returns whether `p` matches the empty text, so that as a separator or a pattern to replace it
/// would stand everywhere.
fn matchesNothing<P :: [Pattern]>(p: P): bool {
    return p.matchAt("", 0) != null;
}

extend StringView {
    /// Returns an iterator over the characters, decoded from the bytes, from either end.
    pub fn chars(): CharsIter {
        return CharsIter { s = this, at = 0, end = byteCount(this) };
    }

    /// Returns an iterator over the characters, each with the byte index it begins at.
    pub fn charIndices(): CharIndicesIter {
        return CharIndicesIter { s = this, at = 0 };
    }

    /// Returns how many characters it holds, `O(n)`.
    pub fn charCount(): int {
        let n = byteCount(this);
        var count = 0;
        var i = 0;
        while (i < n) {
            if ((byteAt(this, i) & 192) != 128) {
                count = count + 1;
            }
            i = i + 1;
        }
        return count;
    }

    /// Returns whether `p` stands in it.
    pub fn contains<P :: [Pattern]>(p: P): bool {
        return this.find(p) != null;
    }

    /// Returns whether it begins with `p`.
    pub fn startsWith<P :: [Pattern]>(p: P): bool {
        return p.matchAt(this, 0) != null;
    }

    /// Returns whether it ends with `p`.
    pub fn endsWith<P :: [Pattern]>(p: P): bool {
        return p.matchBefore(this, byteCount(this)) != null;
    }

    /// Returns the byte index of the first `p`, or `null`; an empty `p` stands at 0.
    pub fn find<P :: [Pattern]>(p: P): ?int {
        return p.nextIn(this, 0);
    }

    /// Returns the byte index of the last `p`, or `null`; an empty `p` stands at the length.
    pub fn rfind<P :: [Pattern]>(p: P): ?int {
        var end = byteCount(this);
        while (end >= 0) {
            if (let start = p.matchBefore(this, end)) {
                return start;
            }
            end = previousChar(this, end);
        }
        return null;
    }

    /// Returns how many times `p` stands in it, none overlapping another.
    ///
    /// An empty `p` stands between every two characters and at both ends.
    pub fn count<P :: [Pattern]>(p: P): int {
        let n = byteCount(this);
        var count = 0;
        var from = 0;
        while (from <= n) {
            if (let at = p.nextIn(this, from)) {
                let end = p.matchAt(this, at)!;
                count = count + 1;
                from = if (end > at) end else nextChar(this, at);
            } else {
                return count;
            }
        }
        return count;
    }

    /// Returns an iterator over the parts between the separators, in order.
    ///
    /// `"a,b,,c".split(",")` gives `a`, `b`, ``, `c`, views with no copies.
    ///
    /// # Panics
    /// When `sep` matches the empty text.
    pub fn split<P :: [Pattern]>(sep: P): SplitIter<P> {
        if (matchesNothing(sep)) {
            panic("split: a separator that matches the empty text");
        }
        return SplitIter<P> { s = this, sep = sep, at = 0, left = -1 };
    }

    /// Returns an iterator over at most `n` parts between the separators.
    ///
    /// The first `n - 1` separators split, the rest is the last part. `n` of 0 gives none.
    ///
    /// # Panics
    /// When `sep` matches the empty text, or `n` is negative.
    pub fn splitN<P :: [Pattern]>(sep: P, n: int): SplitIter<P> {
        if (matchesNothing(sep)) {
            panic("splitN: a separator that matches the empty text");
        }
        if (n < 0) {
            panic(f"splitN: {n} parts");
        }
        return SplitIter<P> { s = this, sep = sep, at = if (n == 0) -1 else 0, left = n };
    }

    /// Returns the part before the first `sep` and the part after it, or `null` where there is
    /// none.
    pub fn splitOnce<P :: [Pattern]>(sep: P): ?(StringView, StringView) {
        if (let at = sep.nextIn(this, 0)) {
            let parts: (StringView, StringView) = (this[..at], this[sep.matchAt(this, at)!..]);
            return parts;
        }
        return null;
    }

    /// Returns an iterator over the matches of `p` as views, in order, none overlapping another.
    pub fn matches<P :: [Pattern]>(p: P): MatchesIter<P> {
        return MatchesIter<P> { s = this, p = p, at = 0 };
    }

    /// Returns an iterator over the lines.
    ///
    /// Split at `\n`, a `\r` before it taken off, no empty line after a last `\n`.
    pub fn lines(): LinesIter {
        return LinesIter { s = this, at = 0 };
    }

    /// Returns the text without the white space at both ends.
    ///
    /// White space is the characters with the property White_Space: the ideographic space and
    /// the no-break space as well as the tab. `trimMatches` trims a pattern of one's own.
    pub fn trim(): StringView {
        return this.trimStart().trimEnd();
    }

    /// Returns the text without the white space at the start.
    pub fn trimStart(): StringView {
        let n = byteCount(this);
        var i = 0;
        while (i < n && charAtByte(this, i).isWhitespace()) {
            i = nextChar(this, i);
        }
        return this[i..];
    }

    /// Returns the text without the white space at the end.
    pub fn trimEnd(): StringView {
        var n = byteCount(this);
        while (n > 0) {
            let before = previousChar(this, n);
            if (!charAtByte(this, before).isWhitespace()) {
                break;
            }
            n = before;
        }
        return this[..n];
    }

    /// Returns the text without the matches of `p` at both ends, removed again and again.
    ///
    /// `"xxaxx".trimMatches('x')` is `a`. A match of the empty text takes nothing.
    pub fn trimMatches<P :: [Pattern]>(p: P): StringView {
        return this.trimStartMatches(p).trimEndMatches(p);
    }

    /// Returns the text without the matches of `p` at the start, removed again and again.
    pub fn trimStartMatches<P :: [Pattern]>(p: P): StringView {
        let n = byteCount(this);
        var i = 0;
        while (i < n) {
            let end = p.matchAt(this, i) ?? i;
            if (end == i) {
                break;
            }
            i = end;
        }
        return this[i..];
    }

    /// Returns the text without the matches of `p` at the end, removed again and again.
    pub fn trimEndMatches<P :: [Pattern]>(p: P): StringView {
        var n = byteCount(this);
        while (n > 0) {
            let start = p.matchBefore(this, n) ?? n;
            if (start == n) {
                break;
            }
            n = start;
        }
        return this[..n];
    }

    /// Returns whether it holds nothing but white space; true for the empty text too.
    pub fn isBlank(): bool {
        return this.trimStart().isEmpty();
    }

    /// Returns the text with every character by its simple uppercase mapping.
    ///
    /// One character for one and no locale, so `"straße".toUpper()` is `STRAßE`.
    pub fn toUpper(): string {
        let out = StringBuilder.new();
        for (c in this.chars()) {
            out.appendChar(c.toUpper());
        }
        return out.toString();
    }

    /// Returns the text with every character by its simple lowercase mapping.
    ///
    /// One character for one, no locale.
    pub fn toLower(): string {
        let out = StringBuilder.new();
        for (c in this.chars()) {
            out.appendChar(c.toLower());
        }
        return out.toString();
    }

    /// Returns a copy of its bytes.
    ///
    /// A copy, since a text may not change through a `Slice<uint8>`.
    pub fn toBytes(): uint8[] {
        let bytes: uint8[] = [0u8] * byteCount(this);
        viewBytes(this).copyInto(bytes[..]);
        return bytes;
    }

    /// Parses the text as `T.parse(this)`, the type taken from the expected type.
    ///
    /// `let n: int = try s.parse();`.
    ///
    /// # Errors
    /// The [ParseError] `T.parse` throws.
    pub fn parse<T :: [Parse]>(): T throws ParseError {
        return try T.parse(this);
    }

    /// Returns the rest after `p` where it begins with `p`, or `null`.
    pub fn stripPrefix<P :: [Pattern]>(p: P): ?StringView {
        if (let end = p.matchAt(this, 0)) {
            return this[end..];
        }
        return null;
    }

    /// Returns the rest before `p` where it ends with `p`, or `null`.
    pub fn stripSuffix<P :: [Pattern]>(p: P): ?StringView {
        if (let start = p.matchBefore(this, byteCount(this))) {
            return this[..start];
        }
        return null;
    }

    /// Returns the text with every `p` replaced by `with`, none overlapping another.
    ///
    /// # Panics
    /// When `p` matches the empty text.
    pub fn replace<P :: [Pattern]>(p: P, with: StringView): string {
        return this.replaceN(p, with, -1);
    }

    /// Returns the text with the first `n` of `p` replaced by `with`; all of them where `n` is
    /// negative.
    ///
    /// # Panics
    /// When `p` matches the empty text.
    pub fn replaceN<P :: [Pattern]>(p: P, with: StringView, n: int): string {
        if (matchesNothing(p)) {
            panic("replace: a pattern that matches the empty text");
        }
        let out = StringBuilder.new();
        let length = byteCount(this);
        var left = n;
        var from = 0;
        while (from < length && left != 0) {
            if (let at = p.nextIn(this, from)) {
                let end = p.matchAt(this, at)!;
                out.appendStr(this[from..at]);
                out.appendStr(with);
                from = end;
                left = left - 1;
            } else {
                left = 0;
            }
        }
        out.appendStr(this[from..]);
        return out.toString();
    }

    /// Returns the text with `fill` before it until it is `width` characters long; a longer one
    /// as it is.
    pub fn padStart(width: int, fill: char = ' '): string {
        let missing = width - this.charCount();
        if (missing <= 0) {
            return this.toString();
        }
        let out = StringBuilder.new();
        var i = 0;
        while (i < missing) {
            out.appendChar(fill);
            i = i + 1;
        }
        out.appendStr(this);
        return out.toString();
    }

    /// Returns the text with `fill` after it until it is `width` characters long; a longer one
    /// as it is.
    pub fn padEnd(width: int, fill: char = ' '): string {
        let missing = width - this.charCount();
        if (missing <= 0) {
            return this.toString();
        }
        let out = StringBuilder.new();
        out.appendStr(this);
        var i = 0;
        while (i < missing) {
            out.appendChar(fill);
            i = i + 1;
        }
        return out.toString();
    }
}

fn isAsciiSpace(b: int): bool {
    return b == 32 || (b >= 9 && b <= 13);
}

/// Iterates over a text's parts between a pattern's matches, as views of it.
///
/// `at` is where the next part begins, -1 once the last was given; `left` is how many parts
/// `splitN` still gives, -1 without a bound.
pub struct SplitIter<P :: [Pattern]> :: [Iterator] {
    type Item = StringView;
    s: StringView,
    sep: P,
    var at: int,
    var left: int,

    pub mut fn next(): ?StringView {
        if (this.at < 0) {
            return null;
        }
        let n = byteCount(this.s);
        if (this.left != 1) {
            if (let i = this.sep.nextIn(this.s, this.at)) {
                let part = this.s[this.at..i];
                this.at = this.sep.matchAt(this.s, i)!;
                if (this.left > 0) {
                    this.left = this.left - 1;
                }
                return part;
            }
        }
        let rest = this.s[this.at..n];
        this.at = -1;
        return rest;
    }
}

/// Iterates over a pattern's matches in a text, none overlapping another, as views of it.
pub struct MatchesIter<P :: [Pattern]> :: [Iterator] {
    type Item = StringView;
    s: StringView,
    p: P,
    var at: int,

    pub mut fn next(): ?StringView {
        if (this.at > byteCount(this.s)) {
            return null;
        }
        if (let begin = this.p.nextIn(this.s, this.at)) {
            let end = this.p.matchAt(this.s, begin)!;
            this.at = if (end > begin) end else nextChar(this.s, begin);
            return this.s[begin..end];
        }
        this.at = byteCount(this.s) + 1;
        return null;
    }
}

/// Iterates over a text's lines, as views of it.
pub struct LinesIter :: [Iterator] {
    type Item = StringView;
    s: StringView,
    var at: int,

    pub mut fn next(): ?StringView {
        let n = byteCount(this.s);
        if (this.at >= n) {
            return null;
        }
        let found = viewFind(this.s, "\n", this.at);
        let i = if (found < 0) n else found;
        var end = i;
        if (end > this.at && byteAt(this.s, end - 1) == 13) {
            end = end - 1;
        }
        let line = this.s[this.at..end];
        this.at = i + 1;
        return line;
    }
}

/// Builds a string a part at a time, in a buffer that doubles.
///
/// It avoids a quadratic chain of concatenations. `std.string` re-exports it.
pub class StringBuilder {
    var bytes: uint8[],
    var count: int,

    pub static fn new(): StringBuilder {
        return StringBuilder { bytes = [], count = 0 };
    }

    /// Returns how many bytes it holds.
    pub fn length(): int {
        return this.count;
    }

    /// Appends `s`, a string or a view of one.
    pub mut fn appendStr(s: StringView): void {
        let n = byteCount(s);
        this.reserve(n);
        putBytes(this.bytes, this.count, s);
        this.count = this.count + n;
    }

    /// Appends `v`'s decimal digits, written in place; an f-string's integer hole uses it.
    mut fn putInt(v: int): void {
        this.reserve(20);
        this.count = this.count + putIntDigits(this.bytes, this.count, v);
    }

    /// Appends `v`'s decimal digits, written in place.
    mut fn putUint(v: uint): void {
        this.reserve(20);
        this.count = this.count + putUintDigits(this.bytes, this.count, v);
    }

    /// Creates an empty builder with room for `room` bytes; an f-string sizes it for its text.
    static fn sized(room: int): StringBuilder {
        let zero: uint8 = 0;
        return StringBuilder { bytes = [zero] * room, count = 0 };
    }

    /// Appends `c` as its UTF-8 bytes.
    pub mut fn appendChar(c: char): void {
        let code = (c as uint32) as int;
        this.reserve(4);
        if (code < 128) {
            this.put(code);
        } else if (code < 2048) {
            this.put(192 | (code >> 6));
            this.put(128 | (code & 63));
        } else if (code < 65536) {
            this.put(224 | (code >> 12));
            this.put(128 | ((code >> 6) & 63));
            this.put(128 | (code & 63));
        } else {
            this.put(240 | (code >> 18));
            this.put(128 | ((code >> 12) & 63));
            this.put(128 | ((code >> 6) & 63));
            this.put(128 | (code & 63));
        }
    }

    /// Appends `v`'s text, through its `showTo`.
    pub mut fn append<T :: [Display]>(v: T): void {
        v.showTo(this);
    }

    /// Removes every byte; the room stays.
    pub mut fn clear(): void {
        this.count = 0;
    }

    /// Returns what it holds, as a string.
    pub fn toString(): string {
        return stringOfBytes(this.bytes, this.count);
    }

    mut fn put(b: int): void {
        this.bytes[this.count] = b as uint8;
        this.count = this.count + 1;
    }

    /// Makes room for `n` more bytes.
    ///
    /// Only the check, small enough to be inlined into every append, so a builder with room
    /// calls nothing; the growth itself is `grow`'s, out of line.
    mut fn reserve(n: int): void {
        if (this.count + n > this.bytes.length()) {
            this.grow(this.count + n);
        }
    }

    /// Doubles the buffer until `need` bytes fit, copying the bytes so far over.
    mut fn grow(need: int): void {
        var room = if (this.bytes.length() == 0) 16 else this.bytes.length() * 2;
        while (room < need) {
            room = room * 2;
        }
        let zero: uint8 = 0;
        let grown = [zero] * room;
        copyBytes(grown, this.bytes, this.count);
        this.bytes = grown;
    }
}

/// Copies `s`'s bytes into `bytes` from `at` on, and the first `count` bytes of `from` into
/// `into`.
///
/// # Panics
/// When a range is out of bounds, as an index is.
fn putBytes(bytes: uint8[], at: int, s: StringView): void;
fn copyBytes(into: uint8[], from: uint8[], count: int): void;

/// Copies the first `count` elements of `from` into `into`.
///
/// The two views of one element type may overlap either way. The counts are the caller's to
/// check; [Slice.copyInto] does, and the collections call this where they have.
fn moveElements<T>(into: Slice<T>, from: Slice<T>, count: int): void;
/// Ends the process for a range `low..high` outside `length` (`LYR-RT0003`), as `xs[a..b]`
/// does.
fn panicRange(low: int, high: int, length: int): never;

// --- StringView: the view of a string's bytes -------------------------------------------------
// A pointer into a string's bytes and a length, read and never written. `s[a..b]` takes one on
// character boundaries, a string stands where one is expected, and `s[i]` is the character that
// begins at a byte. The string's search and split members stand on it (the strings, above).

/// Returns whether a string and a view, or two views, hold the same bytes.
///
/// The operator `==` between them calls it; a program writes `==`.
pub fn equalViews(a: StringView, b: StringView): bool {
    return viewsHoldTheSameBytes(a, b);
}

/// Compares a string and a view, or two views, byte by byte, which is the order of the code
/// points.
///
/// The operators `<`, `<=`, `>` and `>=` between them call it.
pub fn compareViews(a: StringView, b: StringView): ?Ordering {
    return a.totalCompare(b);
}

/// Returns the character that begins at byte `i`; the index `s[i]` calls it.
///
/// # Panics
/// When `i` is outside the bytes, or at a byte that continues a character (`LYR-RT0003`).
pub fn charAtByte(v: StringView, i: int): char {
    return charOfView(v, i);
}

fn viewsHoldTheSameBytes(a: StringView, b: StringView): bool;
/// Compares byte by byte, then by length: -1, 0 or 1.
fn compareViewBytes(a: StringView, b: StringView): int;
fn viewToString(v: StringView): string;
fn charOfView(v: StringView, i: int): char;
/// Returns the view's bytes as a `Slice<uint8>`, for reading only.
fn viewBytes(v: StringView): Slice<uint8>;

extend StringView {
    /// Returns whether it holds no byte.
    pub fn isEmpty(): bool {
        return this.length() == 0;
    }

    /// Returns its bytes in a string of their own.
    pub fn toString(): string {
        return viewToString(this);
    }
}

/// Compares, hashes and orders a view by its bytes, as a string does.
///
/// A view equals the string it shows and hashes as it does; it shows its text and debugs
/// quoted.
extend StringView :: [Equatable, Hashable, Ordered, TotalOrder, Display, Debug, Index<int>] {
    type Output = char;

    fn equals(o: StringView): bool {
        return viewsHoldTheSameBytes(this, o);
    }

    fn hash<H :: [Hasher]>(&h: H): void {
        hashText(this, &h);
    }

    fn compare(o: StringView): ?Ordering {
        return this.totalCompare(o);
    }

    fn totalCompare(o: StringView): Ordering {
        let c = compareViewBytes(this, o);
        if (c < 0) {
            return Ordering.Less;
        }
        if (c > 0) {
            return Ordering.Greater;
        }
        return Ordering.Equal;
    }

    fn show(): string {
        return viewToString(this);
    }

    fn showTo(out: StringBuilder): void {
        out.appendStr(this);
    }

    fn debug(): string {
        return viewToString(this).debug();
    }

    fn index(k: int): char {
        return charOfView(this, k);
    }
}

/// Indexes a string through `Index<int>` where a type parameter asks for it: `s[i]` is the
/// character that begins at byte `i`.
extend string :: [Index<int>] {
    type Output = char;

    fn index(k: int): char {
        return charOfView(this, k);
    }
}

// --- bytes to text ----------------------------------------------------------------------------

/// The error `string.fromUtf8` throws when the bytes are no well-formed UTF-8.
///
/// From `offset` on the bytes hold an overlong form, a surrogate, a value beyond U+10FFFF, a
/// byte that begins nothing, or a sequence cut short.
pub struct Utf8Error :: [Error] {
    /// The first byte that is no well-formed UTF-8.
    pub offset: int,

    pub fn message(): string {
        return f"the bytes are no UTF-8 from byte {this.offset} on";
    }
}

extend string {
    /// Creates the text the bytes are, copied.
    ///
    /// # Errors
    /// A [Utf8Error] where the bytes are no well-formed UTF-8.
    pub static fn fromUtf8(bytes: Slice<uint8>): string throws Utf8Error {
        let bad = utf8Invalid(bytes);
        if (bad >= 0) {
            throw Utf8Error { offset = bad };
        }
        return stringOfSlice(bytes);
    }

    /// Creates the text the bytes are, each maximal ill-formed part replaced by U+FFFD.
    ///
    /// This is the Unicode Standard's recommended practice (3.9) and WHATWG's decoding.
    pub static fn fromUtf8Lossy(bytes: Slice<uint8>): string {
        return stringOfUtf8Lossy(bytes);
    }
}

/// Returns -1 where the bytes are well-formed UTF-8, else the offset of the first that is not.
fn utf8Invalid(bytes: Slice<uint8>): int;
fn stringOfSlice(bytes: Slice<uint8>): string;
fn stringOfUtf8Lossy(bytes: Slice<uint8>): string;

// --- f-strings into one builder ---------------------------------------------------------------
// What an f-string compiles to: a builder sized for its text, each piece appended in
// order, the text taken — one buffer, no string per piece. The checker writes these calls.

pub fn fstringStart(room: int): StringBuilder {
    return StringBuilder.sized(room);
}

pub fn fstringEnd(out: StringBuilder): string {
    return out.toString();
}

pub fn fstringText(out: StringBuilder, text: StringView): void {
    out.appendStr(text);
}

pub fn fstringInt(out: StringBuilder, value: int): void {
    out.putInt(value);
}

pub fn fstringUint(out: StringBuilder, value: uint): void {
    out.putUint(value);
}

pub fn fstringFloat(out: StringBuilder, value: float): void {
    out.appendStr(textOfFloat(value));
}

pub fn fstringFloat32(out: StringBuilder, value: float32): void {
    out.appendStr(textOfFloat32(value));
}

pub fn fstringBool(out: StringBuilder, value: bool): void {
    out.appendStr(if (value) "true" else "false");
}

pub fn fstringChar(out: StringBuilder, value: char): void {
    out.appendChar(value);
}

/// Writes an f-string hole of a [Display] type into `out`, through `showTo`.
pub fn fstringShown<T :: [Display]>(out: StringBuilder, value: T): void {
    value.showTo(out);
}

/// Writes an f-string hole of a [Format] type with a spec into `out`; the type reads the spec.
pub fn fstringFormatted<T :: [Format]>(out: StringBuilder, value: T, spec: StringView): void {
    value.format(spec, out);
}

/// Writes an f-string hole of another [Display] type with a spec into `out`.
///
/// What `showTo` writes is set in the spec's width, alignment and fill; without a width it goes
/// straight into `out`.
///
/// # Panics
/// When the spec says more than fill, alignment and width.
pub fn fstringPadded<T :: [Display]>(out: StringBuilder, value: T, spec: StringView): void {
    let s = paddingOnly(spec, "a Display type's text");
    if (s.width == 0) {
        value.showTo(out);
        return;
    }
    let text = StringBuilder.sized(s.width);
    value.showTo(text);
    pad(text.toString(), s, '<', out);
}

/// Writes an f-string hole under `?` into `out`: what `debugTo` writes, in the spec's width,
/// alignment and fill.
pub fn fstringDebugged<T :: [Debug]>(out: StringBuilder, value: T, spec: StringView): void {
    let s = readSpec(spec);
    if (!padsOnly(s, '?')) {
        refuseSpec(spec, "a Debug text");
    }
    if (s.width == 0) {
        value.debugTo(out);
        return;
    }
    let text = StringBuilder.sized(s.width);
    value.debugTo(text);
    pad(text.toString(), s, '<', out);
}

/// Returns a float's shortest text that reads back as the same value, as
/// `std.string.fromFloat` gives it.
fn textOfFloat(value: float): string;
fn textOfFloat32(value: float32): string;
/// Writes an integer's decimal digits into `bytes` from `at` on and returns how many.
///
/// The caller makes sure there is room.
fn putIntDigits(bytes: uint8[], at: int, value: int): int;
fn putUintDigits(bytes: uint8[], at: int, value: uint): int;

// --- the format language ----------------------------------------------------------------------

/// A type with formats of its own: `{x:spec}` hands it the spec as written.
///
/// The scalars conform with the format language, which the compiler checks where a spec is
/// written. The spec is a view, and a string stands for one.
pub interface Format {
    fn format(spec: StringView, out: StringBuilder): void;
}

/// A format spec as read: `[[fill]align][sign][#][0][width][grouping][.precision][type]`.
///
/// `align` is `<`, `>`, `^`, `=` for the zeros of `0` after the sign, or `'\0'` for the value's
/// own; `grouping` and `kind` are `'\0'` where none is written, `precision` is -1.
struct FormatSpec {
    fill: char,
    align: char,
    plus: bool,
    alternate: bool,
    width: int,
    grouping: char,
    precision: int,
    kind: char,
}

/// Reads the format spec in `text`.
///
/// The compiler has already checked a spec an f-string writes.
///
/// # Panics
/// When `text` is no spec.
fn readSpec(text: StringView): FormatSpec {
    let cs = text.chars().toArray();
    let n = cs.length();
    var i = 0;
    var fill = ' ';
    var fillWritten = false;
    var align = '\0';
    if (n >= 2 && isAlignment(cs[1])) {
        fill = cs[0];
        fillWritten = true;
        align = cs[1];
        i = 2;
    } else if (n >= 1 && isAlignment(cs[0])) {
        align = cs[0];
        i = 1;
    }
    var plus = false;
    if (i < n && (cs[i] == '+' || cs[i] == '-')) {
        plus = cs[i] == '+';
        i = i + 1;
    }
    var alternate = false;
    if (i < n && cs[i] == '#') {
        alternate = true;
        i = i + 1;
    }
    if (i < n && cs[i] == '0') {
        if (!fillWritten) {
            fill = '0';
        }
        if (align == '\0') {
            align = '=';
        }
        i = i + 1;
    }
    var width = 0;
    while (i < n && isDecimal(cs[i])) {
        width = width * 10 + decimalOf(cs[i]);
        i = i + 1;
    }
    var grouping = '\0';
    if (i < n && (cs[i] == ',' || cs[i] == '_')) {
        grouping = cs[i];
        i = i + 1;
    }
    var precision = -1;
    if (i < n && cs[i] == '.') {
        i = i + 1;
        precision = 0;
        while (i < n && isDecimal(cs[i])) {
            precision = precision * 10 + decimalOf(cs[i]);
            i = i + 1;
        }
    }
    var kind = '\0';
    if (i < n) {
        kind = cs[i];
        i = i + 1;
    }
    if (i != n) {
        panic(f"'{text}' is no format spec");
    }
    return FormatSpec {
        fill = fill,
        align = align,
        plus = plus,
        alternate = alternate,
        width = width,
        grouping = grouping,
        precision = precision,
        kind = kind,
    };
}

fn isAlignment(c: char): bool {
    return c == '<' || c == '>' || c == '^';
}

fn isDecimal(c: char): bool {
    return c >= '0' && c <= '9';
}

fn decimalOf(c: char): int {
    return ((c as uint32) as int) - 48;
}

/// Ends the process for a part of a spec the value's type does not take.
///
/// An f-string's spec was already refused where it was written (`LYR-SEM0164`); a template's,
/// read at run time by `fmt.format`, panics here as a broken one does.
fn refuseSpec(spec: StringView, what: string): never {
    panic(f"'{spec}' does not apply to {what}");
}

/// Reads the spec of a value that takes fill, alignment and width alone: a `char`, a `bool`,
/// another `Display` type's text.
///
/// # Panics
/// When the spec says more.
fn paddingOnly(spec: StringView, what: string): FormatSpec {
    let s = readSpec(spec);
    if (!padsOnly(s, '\0')) {
        refuseSpec(spec, what);
    }
    return s;
}

/// Returns whether the spec says no more than fill, alignment and width, besides the type
/// `kind`.
fn padsOnly(s: FormatSpec, kind: char): bool {
    return !s.plus
        && !s.alternate
        && s.align != '='
        && s.grouping == '\0'
        && s.precision < 0
        && s.kind == kind;
}

/// Writes `text` into `out` in the spec's width, counted in characters.
///
/// The fill goes before it, after it, or around it (the odd one after), as the spec aligns it
/// or else as `natural` does.
fn pad(text: string, s: FormatSpec, natural: char, out: StringBuilder): void {
    let room = s.width - text.charCount();
    if (room <= 0) {
        out.appendStr(text);
        return;
    }
    let align = if (s.align == '\0') natural else s.align;
    let before = if (align == '>') room else if (align == '^') room / 2 else 0;
    fillOut(s.fill, before, out);
    out.appendStr(text);
    fillOut(s.fill, room - before, out);
}

/// Writes `c` into `out` `count` times.
fn fillOut(c: char, count: int, out: StringBuilder): void {
    var i = 0;
    while (i < count) {
        out.appendChar(c);
        i = i + 1;
    }
}

/// Writes a number's parts into `out` in the spec's width.
///
/// Under `0` the zeros go between the sign and the prefix and the digits; otherwise the whole
/// is padded, right-aligned unless the spec aligns it.
fn finishNumber(
    sign: string,
    prefix: string,
    digits: string,
    s: FormatSpec,
    out: StringBuilder
): void {
    if (s.align == '=') {
        out.appendStr(sign);
        out.appendStr(prefix);
        fillOut(s.fill, s.width - byteCount(sign) - byteCount(prefix) - digits.charCount(), out);
        out.appendStr(digits);
        return;
    }
    pad(sign + prefix + digits, s, '>', out);
}

/// Formats an integer, given by its sign and magnitude, into `out`.
///
/// The radix is the one `b`, `o`, `x` or `X` names, the prefix comes under `#`, the digits are
/// grouped by three (decimal) or four (another radix).
fn formatInteger(negative: bool, magnitude: uint, spec: StringView, out: StringBuilder): void {
    let s = readSpec(spec);
    if (s.precision >= 0
        || !(s.kind == '\0' || s.kind == 'b' || s.kind == 'o' || s.kind == 'x' || s.kind == 'X')) {
        refuseSpec(spec, "an integer");
    }
    let radix = if (s.kind == 'b') 2
        else if (s.kind == 'o') 8 else if (s.kind == 'x' || s.kind == 'X') 16 else 10;
    var prefix = "";
    if (s.alternate) {
        prefix = if (s.kind == 'b') "0b"
            else if (s.kind == 'o') "0o" else if (s.kind == 'X') "0X" else "0x";
    }
    let sign = if (negative) "-" else if (s.plus) "+" else "";
    let size = if (radix == 10) 3 else 4;
    // under `0` with a grouping, the zeros are grouped with the digits and the width counts the
    // separators: as many digits as fill the width, at least
    let least = if (zeroGrouped(s)) digitsFor(s.width - byteCount(sign) - byteCount(prefix), size)
        else 0;
    let digits = digitsOf(magnitude, radix as uint, s.kind == 'X', s.grouping, size, least);
    finishNumber(sign, prefix, digits, s, out);
}

/// Returns whether the spec fills with zeros after the sign and groups; the zeros then count
/// as digits.
fn zeroGrouped(s: FormatSpec): bool {
    return s.fill == '0' && s.align == '=' && s.grouping != '\0';
}

/// Returns the fewest digits that, grouped by `size`, fill `width` characters.
///
/// A minimum: where no count fits exactly, the next one; no separator leads.
fn digitsFor(width: int, size: int): int {
    var n = 1;
    while (n + (n - 1) / size < width) {
        n = n + 1;
    }
    return n;
}

/// Formats a signed integer into `out`, through its magnitude in `uint`, where `int`'s least
/// value has one.
fn formatSigned(v: int, spec: StringView, out: StringBuilder): void {
    let magnitude = if (v < 0) (-(v + 1)) as uint + 1 else v as uint;
    formatInteger(v < 0, magnitude, spec, out);
}

/// Returns the digits of `magnitude` in `radix`, most significant first.
///
/// `grouping` stands between each `size` of them from the right; there are `least` digits at
/// least, zeros before the first.
fn digitsOf(
    magnitude: uint,
    radix: uint,
    upper: bool,
    grouping: char,
    size: int,
    least: int
): string {
    var count = 1;
    var rest = magnitude / radix;
    while (rest != 0) {
        count = count + 1;
        rest = rest / radix;
    }
    if (count < least) {
        count = least;
    }
    let separators = if (grouping == '\0') 0 else (count - 1) / size;
    let total = count + separators;
    let zero: uint8 = 0;
    let bytes = [zero] * total;
    var at = total - 1;
    var value = magnitude;
    var placed = 0;
    while (placed < count) {
        let d = (value % radix) as int;
        bytes[at] = (if (d < 10) 48 + d else if (upper) 55 + d else 87 + d) as uint8;
        at = at - 1;
        placed = placed + 1;
        value = value / radix;
        if (placed < count && grouping != '\0' && placed % size == 0) {
            bytes[at] = (grouping as uint32) as uint8;
            at = at - 1;
        }
    }
    return stringOfBytes(bytes, total);
}

/// Formats a float into `out`.
///
/// Without a precision or a type it is the shortest text, a `float32`'s own where `narrow` says
/// so; fixed with a precision; `e`/`E` with an exponent; `%` a hundredfold and fixed, the point
/// moved on the exact digits; six digits where those three name no precision. Then the sign,
/// the integer part grouped (the zeros of `0` with it), padded.
fn formatFloat(v: float, narrow: bool, spec: StringView, out: StringBuilder): void {
    let s = readSpec(spec);
    if (s.alternate
        || !(s.kind == '\0' || s.kind == 'e' || s.kind == 'E' || s.kind == 'f' || s.kind == '%')) {
        refuseSpec(spec, "a float");
    }
    let digits = if (s.precision < 0) 6 else s.precision;
    var text = "";
    if (s.kind == 'e') {
        text = floatText(v, digits, 1);
    } else if (s.kind == 'E') {
        text = floatText(v, digits, 2);
    } else if (s.kind == '%') {
        text = floatText(v, digits, 3) + "%";
    } else if (s.kind == 'f' || s.precision >= 0) {
        text = floatText(v, digits, 0);
    } else if (narrow) {
        text = shortestFloat32(v as float32);
    } else {
        text = f"{v}";
    }
    let negative = text.startsWith("-");
    let body = if (negative) byteSlice(text, 1, byteCount(text)) else text;
    let sign = if (negative) "-" else if (s.plus) "+" else "";
    var least = 0;
    if (zeroGrouped(s) && integerDigits(body) > 0) {
        // the width less the sign and what follows the integer part: that many characters of
        // digits and separators, at least (nothing for `nan` and `inf`, which have no digits)
        least = digitsFor(s.width - byteCount(sign) - (byteCount(body) - integerDigits(body)), 3);
    }
    finishNumber(sign, "", grouped(body, s.grouping, least), s, out);
}

/// Returns how many digits lead `body`: a float's integer part.
fn integerDigits(body: string): int {
    let n = byteCount(body);
    var end = 0;
    while (end < n && byteAt(body, end) >= 48 && byteAt(body, end) <= 57) {
        end = end + 1;
    }
    return end;
}

/// Returns `body`'s leading digits, a float's integer part, with `grouping` between each three.
///
/// There are `least` of them at least, zeros before the first.
fn grouped(body: string, grouping: char, least: int): string {
    let n = byteCount(body);
    let end = integerDigits(body);
    let count = if (end < least) least else end;
    if (grouping == '\0' && count == end) {
        return body;
    }
    let out = StringBuilder.new();
    var i = 0;
    while (i < count) {
        if (i > 0 && grouping != '\0' && (count - i) % 3 == 0) {
            out.appendChar(grouping);
        }
        let from = i - (count - end);
        if (from < 0) {
            out.appendChar('0');
        } else {
            out.appendStr(byteSlice(body, from, from + 1));
        }
        i = i + 1;
    }
    out.appendStr(byteSlice(body, end, n));
    return out.toString();
}

/// Returns the first `count` characters of `text`, or all of them.
///
/// The cut is where the next one starts, at a byte that is no continuation byte (`10xxxxxx`).
fn firstChars(text: string, count: int): string {
    let n = byteCount(text);
    var at = 0;
    var taken = 0;
    while (at < n) {
        if ((byteAt(text, at) & 192) != 128) {
            if (taken == count) {
                return byteSlice(text, 0, at);
            }
            taken = taken + 1;
        }
        at = at + 1;
    }
    return text;
}

/// Returns a float's text with a precision, rounded half away from zero on its exact binary
/// digits.
///
/// `form` 0 is fixed, 1 with an exponent, 2 the same upper case, 3 fixed a hundredfold.
fn floatText(value: float, precision: int, form: int): string;
/// Returns a `float32`'s own shortest text.
fn shortestFloat32(value: float32): string;

extend int :: [Format] {
    fn format(spec: StringView, out: StringBuilder): void {
        formatSigned(this, spec, out);
    }
}

extend int8 :: [Format] {
    fn format(spec: StringView, out: StringBuilder): void {
        formatSigned(this as int, spec, out);
    }
}

extend int16 :: [Format] {
    fn format(spec: StringView, out: StringBuilder): void {
        formatSigned(this as int, spec, out);
    }
}

extend int32 :: [Format] {
    fn format(spec: StringView, out: StringBuilder): void {
        formatSigned(this as int, spec, out);
    }
}

extend uint :: [Format] {
    fn format(spec: StringView, out: StringBuilder): void {
        formatInteger(false, this, spec, out);
    }
}

extend uint8 :: [Format] {
    fn format(spec: StringView, out: StringBuilder): void {
        formatInteger(false, this as uint, spec, out);
    }
}

extend uint16 :: [Format] {
    fn format(spec: StringView, out: StringBuilder): void {
        formatInteger(false, this as uint, spec, out);
    }
}

extend uint32 :: [Format] {
    fn format(spec: StringView, out: StringBuilder): void {
        formatInteger(false, this as uint, spec, out);
    }
}

extend float :: [Format] {
    fn format(spec: StringView, out: StringBuilder): void {
        formatFloat(this, false, spec, out);
    }
}

/// Formats a `float32` as the `float` it widens to, the same value exactly; its shortest text is
/// its own.
extend float32 :: [Format] {
    fn format(spec: StringView, out: StringBuilder): void {
        formatFloat(this as float, true, spec, out);
    }
}

/// Formats a string: fill, alignment, width, and the precision as the most characters it keeps.
extend string :: [Format] {
    fn format(spec: StringView, out: StringBuilder): void {
        let s = readSpec(spec);
        if (s.plus || s.alternate || s.align == '=' || s.grouping != '\0' || s.kind != '\0') {
            refuseSpec(spec, "a string");
        }
        pad(if (s.precision >= 0) firstChars(this, s.precision) else this, s, '<', out);
    }
}

extend char :: [Format] {
    fn format(spec: StringView, out: StringBuilder): void {
        pad(f"{this}", paddingOnly(spec, "a char"), '<', out);
    }
}

extend bool :: [Format] {
    fn format(spec: StringView, out: StringBuilder): void {
        pad(f"{this}", paddingOnly(spec, "a bool"), '<', out);
    }
}

/// Iterates over a string's characters, decoded from its UTF-8 bytes.
///
/// From the front by `next`, from the back by `nextBack`, the two meeting in the middle.
pub struct CharsIter :: [Iterator, DoubleEnded] {
    type Item = char;
    s: StringView,
    var at: int,
    var end: int,

    pub mut fn next(): ?char {
        if (this.at >= this.end) {
            return null;
        }
        let first = byteAt(this.s, this.at);
        var code = first;
        var size = 1;
        if (first >= 240) {
            code = first & 7;
            size = 4;
        } else if (first >= 224) {
            code = first & 15;
            size = 3;
        } else if (first >= 192) {
            code = first & 31;
            size = 2;
        }
        var k = 1;
        while (k < size) {
            code = (code << 6) | (byteAt(this.s, this.at + k) & 63);
            k = k + 1;
        }
        this.at = this.at + size;
        return (code as uint32) as char;
    }

    pub mut fn nextBack(): ?char {
        if (this.end <= this.at) {
            return null;
        }
        this.end = previousChar(this.s, this.end);
        return charAtByte(this.s, this.end);
    }
}

/// Iterates over a text's characters with the byte index each begins at.
///
/// These are the indices `s[i]` and `s[a..b]` take.
pub struct CharIndicesIter :: [Iterator] {
    type Item = (int, char);
    s: StringView,
    var at: int,

    pub mut fn next(): ?(int, char) {
        if (this.at >= byteCount(this.s)) {
            return null;
        }
        let item: (int, char) = (this.at, charAtByte(this.s, this.at));
        this.at = nextChar(this.s, this.at);
        return item;
    }
}

fn asTypeOf<T, U>(v: T, like: U): U;
fn floatOfText(s: string): float;
fn float32OfText(s: string): float32;

// ---------------------------------------------------------------------------------------------
// Iteration: a source of values, one at a time, and what `for` walks.
// ---------------------------------------------------------------------------------------------

/// A source of values, one at a time.
///
/// `next()` gives the next value, and `null` at the end, for good once given. A struct
/// iterator changes as it goes, so `next` writes it. A walk that can fail, such as a file's
/// lines, names its `Error`, and `next()` throws it; the loop over it is marked,
/// `for (line in try lines)`.
pub interface Iterator {
    type Item;

    /// What a walk may throw: nothing, unless a conformer says otherwise.
    type Error :: [Error] = never;

    mut fn next(): ?Self.Item throws Self.Error;

    /// Returns how many values are left: at least the first, at most the second where that is
    /// known.
    ///
    /// A collector uses it to size its storage once.
    fn sizeHint(): (int, ?int) {
        let unknown: ?int = null;
        return (0, unknown);
    }
}

/// What `for` walks: `iter()` gives an iterator over it, anew at every loop.
///
/// Every iterator is iterable as itself: a struct iterator as a copy, a class iterator as the
/// object, so two loops over one go on from each other.
pub interface Iterable {
    type Iter :: [Iterator];

    fn iter(): Self.Iter;
}

/// An iterator from both ends: `nextBack()` gives the last value not yet given.
pub interface DoubleEnded :: [Iterator] {
    mut fn nextBack(): ?Self.Item;
}

extend<I :: [Iterator]> I :: [Iterable<Iter = I>] {
    fn iter(): I {
        return this;
    }
}

// A range is an iterator of its own values, from both ends: the value changes as it is
// walked — a 'let' range is walked through a copy, as `for` takes one.
extend<T :: [Step]> Range<T> :: [Iterator, DoubleEnded] {
    type Item = T;

    mut fn next(): ?T {
        if (this.start >= this.end) {
            return null;
        }
        let value = this.start;
        this.start = value.after();
        return value;
    }

    mut fn nextBack(): ?T {
        if (this.start >= this.end) {
            return null;
        }
        this.end = this.end.before();
        return this.end;
    }
}

/// What a range walks by: the value after and the value before, and the type's first and last.
///
/// For an integer, `± 1`, `min` and `max`; for a character, the scalar values past the
/// surrogates. Internal to std.core, with one conformance block per type.
interface Step :: [TotalOrder] {
    static fn first(): Self;
    static fn last(): Self;

    fn after(): Self;
    fn before(): Self;
}

extend int :: [Step] {
    static fn first(): int {
        return int.min;
    }

    static fn last(): int {
        return int.max;
    }

    fn after(): int {
        return this + 1;
    }

    fn before(): int {
        return this - 1;
    }
}

extend int8 :: [Step] {
    static fn first(): int8 {
        return int8.min;
    }

    static fn last(): int8 {
        return int8.max;
    }

    fn after(): int8 {
        return this + 1;
    }

    fn before(): int8 {
        return this - 1;
    }
}

extend int16 :: [Step] {
    static fn first(): int16 {
        return int16.min;
    }

    static fn last(): int16 {
        return int16.max;
    }

    fn after(): int16 {
        return this + 1;
    }

    fn before(): int16 {
        return this - 1;
    }
}

extend int32 :: [Step] {
    static fn first(): int32 {
        return int32.min;
    }

    static fn last(): int32 {
        return int32.max;
    }

    fn after(): int32 {
        return this + 1;
    }

    fn before(): int32 {
        return this - 1;
    }
}

extend uint :: [Step] {
    static fn first(): uint {
        return uint.min;
    }

    static fn last(): uint {
        return uint.max;
    }

    fn after(): uint {
        return this + 1;
    }

    fn before(): uint {
        return this - 1;
    }
}

extend uint8 :: [Step] {
    static fn first(): uint8 {
        return uint8.min;
    }

    static fn last(): uint8 {
        return uint8.max;
    }

    fn after(): uint8 {
        return this + 1;
    }

    fn before(): uint8 {
        return this - 1;
    }
}

extend uint16 :: [Step] {
    static fn first(): uint16 {
        return uint16.min;
    }

    static fn last(): uint16 {
        return uint16.max;
    }

    fn after(): uint16 {
        return this + 1;
    }

    fn before(): uint16 {
        return this - 1;
    }
}

extend uint32 :: [Step] {
    static fn first(): uint32 {
        return uint32.min;
    }

    static fn last(): uint32 {
        return uint32.max;
    }

    fn after(): uint32 {
        return this + 1;
    }

    fn before(): uint32 {
        return this - 1;
    }
}

extend char :: [Step] {
    static fn first(): char {
        return '\0';
    }

    static fn last(): char {
        return '\u{10FFFF}';
    }

    fn after(): char {
        return charAfter(this);
    }

    fn before(): char {
        return charBefore(this);
    }
}

/// Iterates over an array's or a view's elements, from the front and from the back.
///
/// It walks a view of them: nothing is copied, and a write to a later element is seen.
pub struct SliceIter<T> {
    items: Slice<T>,
    var front: int,
    var back: int,
}

extend<T> SliceIter<T> :: [Iterator, DoubleEnded] {
    type Item = T;

    mut fn next(): ?T {
        if (this.front >= this.back) {
            return null;
        }
        this.front = this.front + 1;
        return this.items[this.front - 1];
    }

    mut fn nextBack(): ?T {
        if (this.front >= this.back) {
            return null;
        }
        this.back = this.back - 1;
        return this.items[this.back];
    }

    /// Returns exactly the number of elements left.
    fn sizeHint(): (int, ?int) {
        let left = this.back - this.front;
        let most: ?int = left;
        return (left, most);
    }
}

extend<T> T[] :: [Iterable] {
    type Iter = SliceIter<T>;

    fn iter(): SliceIter<T> {
        return SliceIter<T> { items = this, front = 0, back = this.length() };
    }
}

extend<T> Slice<T> :: [Iterable] {
    type Iter = SliceIter<T>;

    fn iter(): SliceIter<T> {
        return SliceIter<T> { items = this, front = 0, back = this.length() };
    }
}

// --- collecting -------------------------------------------------------------------------------
// `collect()` builds what the expected type is, through its `FromIterator`: `let xs: List<int> =
// it.collect();`. An array is one; the containers of std.collections are the others.

/// Builds a value of the type from an array literal where one is expected.
///
/// The elements check against `T`, and the literal becomes `Self.fromLiteral([…])`:
/// `let s: Set<int> = [1, 2, 3];`, `let m: Map<string, int> = [("a", 1)];` (a map has no
/// literal of its own). The result is a copy, as `of` would make one.
pub interface FromArrayLiteral<T> {
    static fn fromLiteral(items: T[]): Self;
}

/// Builds a value of the type from an iterator's values; `collect()` calls the type's own
/// `fromIter`.
pub interface FromIterator<T> {
    static fn fromIter<I :: [Iterator<Item = T>]>(it: I): Self throws I.Error;
}

extend<T> T[] :: [FromIterator<T>] {
    /// Collects the values into an array, in order, in one pass.
    ///
    /// A buffer that doubles holds them, its first value in the slots not yet written, then one
    /// copy of the length is made. The buffer starts at the iterator's `sizeHint`, and where
    /// that was exact (an array's walk, a view's) the buffer is the array, with no copy at the
    /// end.
    ///
    /// # Errors
    /// What the iterator throws.
    static fn fromIter<I :: [Iterator<Item = T>]>(it: I): T[] throws I.Error {
        var walk = it;
        let least = walk.sizeHint().0;
        let first = try walk.next();
        if (first == null) {
            return [];
        }
        var buffer = filled(if (least > 8) least else 8, first);
        var count = 1;
        var x = try walk.next();
        while (x != null) {
            if (count == buffer.length()) {
                let grown = filled(count * 2, first);
                buffer[..count].copyInto(grown[..]);
                buffer = grown;
            }
            buffer[count] = x;
            count = count + 1;
            x = try walk.next();
        }
        if (count == buffer.length()) {
            return buffer;
        }
        let out = filled(count, first);
        buffer[..count].copyInto(out[..]);
        return out;
    }
}

extend<T :: [Ordered]> Range<T> :: [Contains<T>] {
    /// Returns whether `x` lies from `start` up to, not including, `end`.
    fn contains(x: T): bool {
        return this.start <= x && x < this.end;
    }
}

extend<T :: [Ordered]> RangeInclusive<T> :: [Contains<T>] {
    /// Returns whether `x` lies from `start` to `end`, both included.
    fn contains(x: T): bool {
        return this.start <= x && x <= this.end;
    }
}

/// Repeats the text `s` `n` times; `""` for none.
///
/// The operator `s * n` becomes this call; `n * s` is refused, as for `[x] * n`.
///
/// # Panics
/// When `n` is negative (`LYR-RT0007`), as an array's repetition does.
pub fn repeatText(s: string, n: int): string {
    if (n < 0) {
        let _ = [s] * n;
    }
    let out = StringBuilder.new();
    for (_ in 0..n) {
        out.appendStr(s);
    }
    return out.toString();
}

// --- the members of arrays and views: written once on `Slice<T>`, and reached on an array - and
// a `T[N]` in the heap - through a view of all of it. A write goes there.
extend<T> Slice<T> {
    /// Returns whether there is no element.
    pub fn isEmpty(): bool {
        return this.length() == 0;
    }

    /// Copies the elements into `into`, which is at least as long; a longer one keeps its rest.
    ///
    /// The two may overlap either way, `xs[0..4].copyInto(xs[2..6])` as well as the reverse.
    ///
    /// # Panics
    /// When `into` is shorter (`LYR-RT0003`).
    pub fn copyInto(into: Slice<T>): void {
        let n = this.length();
        if (into.length() < n) {
            panicRange(0, n, into.length());
        }
        moveElements(into, this, n);
    }

    /// Returns the element at `i`, or `null` outside `0 ≤ i < length()`.
    pub fn get(i: int): ?T {
        if (i < 0 || i >= this.length()) {
            return null;
        }
        return this[i];
    }

    /// Returns the first element, or `null` where there is none.
    pub fn first(): ?T {
        return this.get(0);
    }

    /// Returns the last element, or `null` where there is none.
    pub fn last(): ?T {
        return this.get(this.length() - 1);
    }

    /// Exchanges the elements at `i` and `j`.
    ///
    /// # Panics
    /// When an index is outside the elements, as `[i]` does.
    pub fn swap(i: int, j: int): void {
        let t = this[i];
        this[i] = this[j];
        this[j] = t;
    }

    /// Reverses the elements in place.
    pub fn reverse(): void {
        var i = 0;
        var j = this.length() - 1;
        while (i < j) {
            this.swap(i, j);
            i = i + 1;
            j = j - 1;
        }
    }

    /// Returns a new array of the elements, the last first.
    pub fn reversed(): T[] {
        let n = this.length();
        return arrayOf(n, (i: int) => this[n - 1 - i]);
    }

    /// Returns the first index whose element fails `p`, by binary search.
    ///
    /// The elements must be partitioned by `p`: every one it holds for before every one it does
    /// not.
    ///
    /// # Errors
    /// What `p` throws.
    pub fn partitionPoint<E :: [Error]>(p: fn(T) -> bool throws E): int throws E {
        var lo = 0;
        var hi = this.length();
        while (lo < hi) {
            let mid = lo + (hi - lo) / 2;
            if (try p(this[mid])) {
                lo = mid + 1;
            } else {
                hi = mid;
            }
        }
        return lo;
    }
}

/// Concatenates two views: `a + b` is a new array of the elements of both, as `xs + ys` of two
/// arrays.
extend<T> Slice<T> :: [Add<Out = T[]>] {
    fn add(rhs: Slice<T>): T[] {
        let n = this.length();
        let m = rhs.length();
        if (n + m == 0) {
            return [];
        }
        let out = filled(n + m, if (n > 0) this[0] else rhs[0]);
        this.copyInto(out[..n]);
        rhs.copyInto(out[n..]);
        return out;
    }
}

/// Makes `x in xs` true where an element equals `x`.
extend<T :: [Equatable]> Slice<T> :: [Contains<T>] {
    fn contains(x: T): bool {
        return this.indexOf(x) != null;
    }
}

extend<T :: [Equatable]> T[] :: [Contains<T>] {
    fn contains(x: T): bool {
        return this[..].contains(x);
    }
}

/// Makes `c in text` true where the character stands in the text.
///
/// The view's `contains<P :: [Pattern]>` serves at `P = char`, so the conformance writes
/// nothing.
extend StringView :: [Contains<char>] { }

/// Makes `c in s` true for a string through its view's `contains`, as a call on a string reaches
/// the members of its view.
extend string :: [Contains<char>] { }

extend<T :: [Equatable]> Slice<T> {
    /// Returns the index of the first element equal to `x`, or `null`.
    pub fn indexOf(x: T): ?int {
        var i = 0;
        while (i < this.length()) {
            if (this[i] == x) {
                return i;
            }
            i = i + 1;
        }
        return null;
    }
}

extend<T :: [Clone]> Slice<T> {
    /// Sets every element to a clone of `v`, so no object is shared into several slots.
    pub fn fill(v: T): void {
        var i = 0;
        while (i < this.length()) {
            this[i] = v.clone();
            i = i + 1;
        }
    }
}

extend<T :: [TotalOrder]> Slice<T> {
    /// Returns the index of an element equal to `x` in sorted elements, or `null`.
    ///
    /// The elements must be sorted in their total order.
    pub fn binarySearch(x: T): ?int {
        let at = this.partitionPoint((e: T) => e < x);
        if (at < this.length() && this[at] == x) {
            return at;
        }
        return null;
    }
}

extend<T :: [Display]> Slice<T> {
    /// Joins the elements' texts, `sep` between each two.
    pub fn join(sep: string): string {
        let out = StringBuilder.new();
        var i = 0;
        while (i < this.length()) {
            if (i > 0) {
                out.append(sep);
            }
            out.append(this[i]);
            i = i + 1;
        }
        return out.toString();
    }
}

// --- ordering: `sort` and `sortBy` stable, through a buffer of the length;
// `sortUnstable` in place.
extend<T> Slice<T> {
    /// Sorts the elements in the order `cmp` gives, equal ones keeping theirs.
    ///
    /// A merge sort: runs of 16 sorted by insertion, then merged pairwise through a buffer of the
    /// length.
    ///
    /// # Errors
    /// What `cmp` throws ends the sort, and the call throws it; the elements are then in some
    /// order, every one still there.
    pub fn sortBy<E :: [Error]>(cmp: fn(T, T) -> Ordering throws E): void throws E {
        let n = this.length();
        var start = 0;
        while (start < n) {
            let end = if (start + 16 < n) start + 16 else n;
            try sortRunBy(this[start..end], cmp);
            start = end;
        }
        if (n <= 16) {
            return;
        }
        let buffer = sortBuffer(this);
        var width = 16;
        var inBuffer = false;
        // Where the buffer holds the elements — at the end, or when a comparison throws while a
        // pass writes them back — they go back whole.
        defer {
            if (inBuffer) {
                buffer[..].copyInto(this);
            }
        }
        while (width < n) {
            if (inBuffer) {
                try mergeRunsBy(buffer[..], this, width, cmp);
            } else {
                try mergeRunsBy(this, buffer[..], width, cmp);
            }
            inBuffer = !inBuffer;
            width = width * 2;
        }
    }

    /// Sorts the elements in the order of their keys, equal keys keeping theirs.
    ///
    /// # Errors
    /// What `key` throws, as for `sortBy`'s comparison.
    pub fn sortByKey<K :: [TotalOrder], E :: [Error]>(key: fn(T) -> K throws E): void throws E {
        try this.sortBy((a: T, b: T) => (try key(a)).totalCompare(try key(b)));
    }
}

extend<T :: [TotalOrder]> Slice<T> {
    /// Sorts the elements in ascending order, equal ones keeping theirs.
    ///
    /// `sortBy`'s merge sort with `totalCompare` called directly.
    pub fn sort(): void {
        let n = this.length();
        var start = 0;
        while (start < n) {
            let end = if (start + 16 < n) start + 16 else n;
            sortRun(this[start..end]);
            start = end;
        }
        if (n <= 16) {
            return;
        }
        let buffer = sortBuffer(this);
        var width = 16;
        var inBuffer = false;
        while (width < n) {
            if (inBuffer) {
                mergeRuns(buffer[..], this, width);
            } else {
                mergeRuns(this, buffer[..], width);
            }
            inBuffer = !inBuffer;
            width = width * 2;
        }
        if (inBuffer) {
            buffer[..].copyInto(this);
        }
    }

    /// Sorts the elements in ascending order, equal ones in any order.
    ///
    /// In place, without a buffer: a quicksort, falling back to a heap sort where it would go
    /// quadratic.
    pub fn sortUnstable(): void {
        var depth = 0;
        var n = this.length();
        while (n > 1) {
            depth = depth + 2;
            n = n / 2;
        }
        introSort(this, depth);
    }
}

fn isLess(o: Ordering): bool {
    return match (o) {
        .Less => true,
        _ => false,
    };
}

fn isGreater(o: Ordering): bool {
    return match (o) {
        .Greater => true,
        _ => false,
    };
}

/// Sorts a run by insertion as `sortRunBy` does, under the type's own order.
fn sortRun<T :: [TotalOrder]>(xs: Slice<T>): void {
    var i = 1;
    while (i < xs.length()) {
        let x = xs[i];
        var j = i;
        while (j > 0 && isLess(x.totalCompare(xs[j - 1]))) {
            xs[j] = xs[j - 1];
            j = j - 1;
        }
        xs[j] = x;
        i = i + 1;
    }
}

/// Returns a copy of `xs` as the merges' second buffer.
///
/// The slots are made of its first element, then the elements are copied over at once.
fn sortBuffer<T>(xs: Slice<T>): T[] {
    let first = xs[0];
    let buffer = arrayOf(xs.length(), (i: int) => first);
    xs.copyInto(buffer[..]);
    return buffer;
}

/// Merges runs as `mergeRunsBy` does, under the type's own order.
fn mergeRuns<T :: [TotalOrder]>(src: Slice<T>, dst: Slice<T>, width: int): void {
    let n = src.length();
    var lo = 0;
    while (lo < n) {
        let mid = if (lo + width < n) lo + width else n;
        let hi = if (mid + width < n) mid + width else n;
        var i = lo;
        var j = mid;
        var k = lo;
        while (i < mid && j < hi) {
            if (isLess(src[j].totalCompare(src[i]))) {
                dst[k] = src[j];
                j = j + 1;
            } else {
                dst[k] = src[i];
                i = i + 1;
            }
            k = k + 1;
        }
        // what one run has left goes over whole
        src[i..mid].copyInto(dst[k..k + (mid - i)]);
        k = k + (mid - i);
        src[j..hi].copyInto(dst[k..k + (hi - j)]);
        lo = hi;
    }
}

/// Sorts a run by insertion: each element moves before the ones it is less than, so equal ones
/// keep their order.
///
/// # Errors
/// What `cmp` throws; every element is then still in a slot.
fn sortRunBy<T, E :: [Error]>(xs: Slice<T>, cmp: fn(T, T) -> Ordering throws E): void throws E {
    // By swaps, not by a hole: a comparison that throws finds every element in a slot.
    var i = 1;
    while (i < xs.length()) {
        var j = i;
        while (j > 0 && isLess(try cmp(xs[j], xs[j - 1]))) {
            xs.swap(j, j - 1);
            j = j - 1;
        }
        i = i + 1;
    }
}

/// Runs one pass of the merge sort: the runs of `width` in `src` merged pairwise into `dst`.
///
/// Where two elements are equal, the left run's comes first.
///
/// # Errors
/// What `cmp` throws.
fn mergeRunsBy<T, E :: [Error]>(
    src: Slice<T>,
    dst: Slice<T>,
    width: int,
    cmp: fn(T, T) -> Ordering throws E
): void throws E {
    let n = src.length();
    var lo = 0;
    while (lo < n) {
        let mid = if (lo + width < n) lo + width else n;
        let hi = if (mid + width < n) mid + width else n;
        var i = lo;
        var j = mid;
        var k = lo;
        while (i < mid && j < hi) {
            if (isLess(try cmp(src[j], src[i]))) {
                dst[k] = src[j];
                j = j + 1;
            } else {
                dst[k] = src[i];
                i = i + 1;
            }
            k = k + 1;
        }
        src[i..mid].copyInto(dst[k..k + (mid - i)]);
        k = k + (mid - i);
        src[j..hi].copyInto(dst[k..k + (hi - j)]);
        lo = hi;
    }
}

/// Sorts unstably by partitioning around the median of three.
///
/// The smaller side goes by recursion and the larger by the loop, insertion below 17 elements,
/// a heap sort once `depth` partitions are spent.
fn introSort<T :: [TotalOrder]>(xs: Slice<T>, depth: int): void {
    var view = xs;
    var left = depth;
    while (view.length() > 16) {
        if (left == 0) {
            heapSort(view);
            return;
        }
        left = left - 1;
        let split = partitionHoare(view);
        if (split < view.length() - split) {
            introSort(view[..split], left);
            view = view[split..];
        } else {
            introSort(view[split..], left);
            view = view[..split];
        }
    }
    sortRunBy(view, (a: T, b: T) => a.totalCompare(b));
}

/// Partitions by Hoare's scheme around the median of the first, middle and last element.
///
/// Every element before the returned index is at most the pivot, every one from it at least,
/// and both sides hold one. A sorted part is left as it is; equal elements are split between
/// the sides.
fn partitionHoare<T :: [TotalOrder]>(xs: Slice<T>): int {
    let n = xs.length();
    let pivot = medianOfThree(xs[0], xs[n / 2], xs[n - 1]);
    var i = 0;
    var j = n - 1;
    var split = -1;
    while (split < 0) {
        while (isLess(xs[i].totalCompare(pivot))) {
            i = i + 1;
        }
        while (isGreater(xs[j].totalCompare(pivot))) {
            j = j - 1;
        }
        if (i >= j) {
            split = j + 1;
        } else {
            xs.swap(i, j);
            i = i + 1;
            j = j - 1;
        }
    }
    return split;
}

fn medianOfThree<T :: [TotalOrder]>(a: T, b: T, c: T): T {
    if (isLess(a.totalCompare(b))) {
        if (isLess(b.totalCompare(c))) {
            return b;
        }
        if (isLess(a.totalCompare(c))) {
            return c;
        }
        return a;
    }
    if (isLess(a.totalCompare(c))) {
        return a;
    }
    if (isLess(b.totalCompare(c))) {
        return c;
    }
    return b;
}

/// Sorts by heap sort, `O(n log n)` whatever the order.
///
/// A max-heap is built in place, its top swapped to the end one at a time.
fn heapSort<T :: [TotalOrder]>(xs: Slice<T>): void {
    let n = xs.length();
    var start = n / 2 - 1;
    while (start >= 0) {
        siftDown(xs, start, n);
        start = start - 1;
    }
    var end = n - 1;
    while (end > 0) {
        xs.swap(0, end);
        siftDown(xs, 0, end);
        end = end - 1;
    }
}

fn siftDown<T :: [TotalOrder]>(xs: Slice<T>, root: int, end: int): void {
    var r = root;
    while (true) {
        var child = 2 * r + 1;
        if (child >= end) {
            return;
        }
        if (child + 1 < end && isLess(xs[child].totalCompare(xs[child + 1]))) {
            child = child + 1;
        }
        if (!isLess(xs[r].totalCompare(xs[child]))) {
            return;
        }
        xs.swap(r, child);
        r = child;
    }
}

/// The join of two thrown types: what a walk over two sources throws.
///
/// The compiler reduces it once both are known: to the one type where they are the same, to
/// the other where one is `never`, to the root [Error] where they differ; left open, it covers
/// each of its parts. No value of it is made.
pub struct Join<A :: [Error], B :: [Error]> :: [Error] {
    pub fn message(): string {
        return "a joined error";
    }
}

/// Clones an array's or a view's iterator: a copy of its position over the same view.
extend<T> SliceIter<T> :: [Clone] {
    fn clone(): SliceIter<T> {
        return this;
    }
}

extend<T :: [Step]> Range<T> :: [Clone] {
    fn clone(): Range<T> {
        return this;
    }
}

extend<T :: [Step]> RangeInclusive<T> :: [Clone] {
    fn clone(): RangeInclusive<T> {
        return this;
    }
}

extend CharsIter :: [Clone] {
    fn clone(): CharsIter {
        return this;
    }
}

// An inclusive range ends without a flag: its last value leaves `start` past `end` — or `end`
// before `start` where that value is the type's last (its first from the back), so neither bound
// leaves the type. A range of characters walks the scalar values, the surrogates passed over
// (`Step` above).
extend<T :: [Step]> RangeInclusive<T> :: [Iterator, DoubleEnded] {
    type Item = T;

    mut fn next(): ?T {
        if (this.start > this.end) {
            return null;
        }
        let value = this.start;
        if (value == this.end && value == T.last()) {
            this.end = value.before();
        } else {
            this.start = value.after();
        }
        return value;
    }

    mut fn nextBack(): ?T {
        if (this.start > this.end) {
            return null;
        }
        let value = this.end;
        if (value == this.start && value == T.first()) {
            this.start = value.after();
        } else {
            this.end = value.before();
        }
        return value;
    }
}

/// Returns the scalar value after `c`, past the surrogates; `c` must be below U+10FFFF.
fn charAfter(c: char): char {
    var n = (c as uint32) + 1;
    if (n == 0xD800) {
        n = 0xE000;
    }
    return n as char;
}

/// Returns the scalar value before `c`, past the surrogates; `c` must be above U+0000.
fn charBefore(c: char): char {
    var n = (c as uint32) - 1;
    if (n == 0xDFFF) {
        n = 0xD7FF;
    }
    return n as char;
}

/// Returns the debug text of an array; a synthesized `debug()` calls it for an array field.
pub fn debugArray<T :: [Debug]>(xs: T[]): string {
    return debugText(xs);
}

/// Returns the debug text of a view, as [debugArray] does for an array.
pub fn debugSlice<T :: [Debug]>(xs: Slice<T>): string {
    return debugText(xs);
}

/// Returns the debug text of an optional: `null`, or the value's.
pub fn debugOptional<T :: [Debug]>(o: ?T): string {
    if (o == null) {
        return "null";
    }
    return o.debug();
}

/// Returns whether two arrays are equal, element by element; a synthesized `equals` calls it
/// for an array field.
pub fn equalArrays<T :: [Equatable]>(a: T[], b: T[]): bool {
    return sameElements(a, b);
}

/// Returns whether two views are equal, element by element.
pub fn equalSlices<T :: [Equatable]>(a: Slice<T>, b: Slice<T>): bool {
    return sameElements(a, b);
}

/// Returns whether two optionals are equal: both absent, or both present and equal.
pub fn equalOptionals<T :: [Equatable]>(a: ?T, b: ?T): bool {
    if (a == null) {
        return b == null;
    }
    if (b == null) {
        return false;
    }
    return a == b;
}

/// Writes an optional into a hasher: a 0 for `null`, a 1 and the value otherwise.
///
/// A synthesized `hash` calls it. Arrays and views are not [Hashable], since their slots can
/// be written.
pub fn hashOptionalInto<T :: [Hashable], H :: [Hasher]>(o: ?T, &h: H): void {
    if (o == null) {
        h.writeByte(0);
        return;
    }
    h.writeByte(1);
    o.hash(&h);
}

/// Writes an object's identity into a hasher: its address, as the `hash` of an [Identity] does.
pub fn hashIdentityInto<T :: [Identity], H :: [Hasher]>(o: T, &h: H): void {
    h.writeInt(identityOf(o));
}

/// Returns the address of an object, as a number.
fn identityOf<T>(o: T): int;

/// Returns a copy of an array with every element cloned; a synthesized `clone` calls it for an
/// array field.
pub fn cloneArray<T :: [Clone]>(xs: T[]): T[] {
    return arrayOf(xs.length(), (i: int) => xs[i].clone());
}

/// Returns a clone of an optional's value, or `null`.
pub fn cloneOptional<T :: [Clone]>(o: ?T): ?T {
    if (o == null) {
        return null;
    }
    return o.clone();
}

/// Creates a generator inline: `sequence { yield 1; yield 2; }`.
///
/// The trailing block is a generator lambda, and this calls it; the coroutine it makes runs
/// nothing until it is pulled.
pub fn sequence<T>(body: fn() -> Coroutine<T>): Coroutine<T> {
    return body();
}

// --- equality and display of arrays and views -------------------------------------------------
// Element by element. The debug text is `[1, 2, 3]`, each element in its own debug text — a string
// quoted, `["a", "b"]`, where its bounds would be lost unquoted —, and the display text is the
// same, so an f-string prints a container. Written into the caller's builder.

extend<T :: [Equatable]> T[] :: [Equatable] {
    fn equals(o: T[]): bool {
        return sameElements(this, o);
    }
}

extend<T :: [Equatable]> Slice<T> :: [Equatable] {
    fn equals(o: Slice<T>): bool {
        return sameElements(this, o);
    }
}

extend<T :: [Debug]> T[] :: [Debug, Display] {
    fn debug(): string {
        return debugText(this);
    }

    fn debugTo(out: StringBuilder): void {
        debugElements(this, out);
    }

    fn show(): string {
        return debugText(this);
    }

    fn showTo(out: StringBuilder): void {
        debugElements(this, out);
    }
}

extend<T :: [Debug]> Slice<T> :: [Debug, Display] {
    fn debug(): string {
        return debugText(this);
    }

    fn debugTo(out: StringBuilder): void {
        debugElements(this, out);
    }

    fn show(): string {
        return debugText(this);
    }

    fn showTo(out: StringBuilder): void {
        debugElements(this, out);
    }
}

/// Returns whether two views hold equal elements in the same order.
fn sameElements<T :: [Equatable]>(a: Slice<T>, b: Slice<T>): bool {
    if (a.length() != b.length()) {
        return false;
    }
    for (i in 0..a.length()) {
        if (!(a[i] == b[i])) {
            return false;
        }
    }
    return true;
}

/// Writes the elements' debug texts into `out`, in brackets, `, ` between each two.
fn debugElements<T :: [Debug]>(xs: Slice<T>, out: StringBuilder): void {
    out.appendChar('[');
    for (i in 0..xs.length()) {
        if (i > 0) {
            out.appendStr(", ");
        }
        xs[i].debugTo(out);
    }
    out.appendChar(']');
}

/// Returns the elements' debug texts as `debugElements` writes them, as a string of its own.
fn debugText<T :: [Debug]>(xs: Slice<T>): string {
    let out = StringBuilder.new();
    debugElements(xs, out);
    return out.toString();
}

// --- optionals and arrays ---------------------------------------------------------------------

/// Makes an optional [Equatable] where its value's type is: `null` equals `null` only.
///
/// A constraint finds the conformance, so a `Set<?int>` works.
extend<T :: [Equatable]> ?T :: [Equatable] {
    fn equals(o: ?T): bool {
        return equalOptionals(this, o);
    }
}

/// Makes an optional [Hashable] where its value's type is: `null` and a value hash apart.
extend<T :: [Hashable]> ?T :: [Hashable] {
    fn hash<H :: [Hasher]>(&h: H): void {
        hashOptionalInto(this, &h);
    }
}

/// Makes an optional [Debug] where its value's type is: `null`, or the value's own debug text.
///
/// There is no wrapper, so `assertEq('7'.toDigit(10), 7)` names both sides alike. It is the
/// text a synthesized `debug()` gives an optional field.
extend<T :: [Debug]> ?T :: [Debug] {
    fn debug(): string {
        return debugOptional(this);
    }
}

/// Makes an array [Clone] where its element is: a new array of the elements' clones.
extend<T :: [Clone]> T[] :: [Clone] {
    fn clone(): T[] {
        return cloneArray(this);
    }
}

/// Makes an optional [Clone] where its value's type is: it clones its value.
extend<T :: [Clone]> ?T :: [Clone] {
    fn clone(): ?T {
        return cloneOptional(this);
    }
}

/// Makes a tuple [Clone] where its elements are: it clones its elements.
extend<T0 :: [Clone], T1 :: [Clone]> (T0, T1) :: [Clone] {
    fn clone(): (T0, T1) {
        return (this.0.clone(), this.1.clone());
    }
}

extend<T0 :: [Clone], T1 :: [Clone], T2 :: [Clone]> (T0, T1, T2) :: [Clone] {
    fn clone(): (T0, T1, T2) {
        return (this.0.clone(), this.1.clone(), this.2.clone());
    }
}

// --- tuples -----------------------------------------------------------------------------------
//
// A tuple is Equatable, Hashable, Debug and Display where its elements are — the conditional
// synthesis structs get, written here for each arity from 2 to 8 by a generator. Equality and
// hash take the elements in order; Debug writes `(1, "x")`, Display `(1, x)`.

extend<T0 :: [Equatable], T1 :: [Equatable]> (T0, T1) :: [Equatable] {
    fn equals(o: (T0, T1)): bool {
        return this.0 == o.0 && this.1 == o.1;
    }
}

extend<T0 :: [Hashable], T1 :: [Hashable]> (T0, T1) :: [Hashable] {
    fn hash<H :: [Hasher]>(&h: H): void {
        this.0.hash(&h);
        this.1.hash(&h);
    }
}

extend<T0 :: [Debug], T1 :: [Debug]> (T0, T1) :: [Debug] {
    fn debug(): string {
        let out = StringBuilder.new();
        this.debugTo(out);
        return out.toString();
    }

    fn debugTo(out: StringBuilder): void {
        out.appendChar('(');
        this.0.debugTo(out);
        out.appendStr(", ");
        this.1.debugTo(out);
        out.appendChar(')');
    }
}

extend<T0 :: [Display], T1 :: [Display]> (T0, T1) :: [Display] {
    fn show(): string {
        let out = StringBuilder.new();
        this.showTo(out);
        return out.toString();
    }

    fn showTo(out: StringBuilder): void {
        out.appendChar('(');
        this.0.showTo(out);
        out.appendStr(", ");
        this.1.showTo(out);
        out.appendChar(')');
    }
}

extend<T0 :: [Equatable], T1 :: [Equatable], T2 :: [Equatable]> (T0, T1, T2) :: [Equatable] {
    fn equals(o: (T0, T1, T2)): bool {
        return this.0 == o.0 && this.1 == o.1 && this.2 == o.2;
    }
}

extend<T0 :: [Hashable], T1 :: [Hashable], T2 :: [Hashable]> (T0, T1, T2) :: [Hashable] {
    fn hash<H :: [Hasher]>(&h: H): void {
        this.0.hash(&h);
