/// The core of the standard library, bound in every module without an import.
///
/// It holds the preamble ([panic], [assert], [Error], [Result], [Box], the ranges, [arrayOf]),
/// the attributes, the operator interfaces ([Equatable], [Ordered], [Hashable], [Index],
/// [Display], [Debug], [Clone]), the number tower ([Num], [Integer], [Float]) with [Parse], the
/// members of `string`, `char` and the arrays and views, the format language behind f-strings,
/// and the iterator protocol ([Iterator], [Iterable]).

/// Ends the process with a message and a backtrace.
///
/// The report is `LYR-RT0008` and the exit code 101. Its type is `never`, so a call stands
/// wherever a value is wanted and ends the path it is on.
pub fn panic(message: string): never;

/// Ends the process unless `condition` holds.
///
/// The check is inlined at the call. The message is a lambda, `assert(n > 2) { f"n = {n}" }`,
/// built only when the assertion fails.
///
/// # Panics
/// When `condition` is false: `LYR-RT0011`, "assertion failed: " and the condition as it is
/// written, then the message where one is given.
pub inline fn assert(
    condition: bool,
    message: fn() -> string = () => "",
    @callerExpr(condition) written: string = ""
): void {
    if (!condition) {
        assertFailed(written, message());
    }
}

/// Ends the process for a failed assertion: `LYR-RT0011`, the condition as written, the message.
fn assertFailed(written: string, message: string): never;

/// Marks a branch the program never takes.
///
/// # Panics
/// Always, when reached: `LYR-RT0012`, "unreachable" and `message` behind it where one is given.
pub fn unreachable(message: string = ""): never;

/// Marks a place still to be written.
///
/// # Panics
/// Always, when reached: `LYR-RT0013`, "not implemented" and `message` behind it where one is
/// given.
pub fn todo(message: string = ""): never;

/// Returns the bytes of a file of the package, read while the program compiles.
///
/// `path` is relative to the calling module, within the package's directory; a build reads the
/// file again when it changes. Only a `comptime` site, or what one calls, can make the call:
/// `comptime embed("table.bin")`; a call at run time is `LYR-CT0004`.
pub fn embed(path: string): uint8[];

/// The empty interface, which every struct, class and enum value conforms to.
///
/// A value becomes an `Any` where the target type says `Any`, never unasked; `is` or a type
/// pattern takes it out again. `Any[]` is the heterogeneous array.
pub interface Any { }

/// Holds a value behind a reference.
///
/// It is the indirection a value type needs to hold itself: `enum Expr { Num(int),
/// Add(Box<Expr>, Box<Expr>) }` is finite where `Add(Expr, Expr)` is not. The box is shared, not
/// copied; its value is fixed, so sharing is unobservable.
pub class Box<T> {
    pub value: T,
}

/// Compares two boxes by the values they hold.
extend<T :: [Equatable]> Box<T> :: [Equatable] {
    fn equals(o: Box<T>): bool {
        return this.value == o.value;
    }
}

extend<T :: [Debug]> Box<T> :: [Debug] {
    /// Returns the debug text of the held value; the box itself adds nothing.
    fn debug(): string {
        return this.value.debug();
    }
}

/// The range `a..b`: the values from `start` up to but not including `end`.
///
/// A value holding its bounds. In a `for` head a range literal is the counted loop and no value.
pub struct Range<T> {
    pub var start: T,
    pub var end: T,
}

/// The range `a..=b`: the values from `start` to `end`, both included.
pub struct RangeInclusive<T> {
    pub var start: T,
    pub var end: T,
}

/// The range `a..`: from `start` on.
///
/// Written inside `[…]` only, where it takes a view.
pub struct RangeFrom<T> {
    pub start: T,
}

/// The range `..b`: up to but not including `end`.
///
/// Written inside `[…]` only, where it takes a view.
pub struct RangeTo<T> {
    pub end: T,
}

/// The range `..`: everything.
///
/// Written inside `[…]` only, where it takes a view of the whole.
pub struct RangeFull { }

/// Creates an array of `n` elements, the element at `i` the value of `f(i)`.
///
/// Every element is fresh, where `[x] * n` copies one value into every slot; `f` is called in
/// order, once per index.
///
/// # Panics
/// When `n` is negative.
///
/// # Errors
/// What `f` throws, the call throws, and the array is dropped.
pub fn arrayOf<T, E :: [Error]>(n: int, f: fn(int) -> T throws E): T[] throws E {
    if (n < 0) {
        panic("arrayOf: a negative length");
    }
    if (n == 0) {
        return [];
    }
    // One allocation, every slot the first value until its own is written.
    let first = try f(0);
    let whole = filled(n, first);
    var i = 1;
    while (i < n) {
        whole[i] = try f(i);
        i = i + 1;
    }
    return whole;
}

/// Creates an array of `n` slots that all hold the one value `x`, an object shared, not cloned.
///
/// For the standard library's empty tables (`null` in every slot) and [arrayOf], which writes
/// every slot after. A program's `[x] * n` clones an object instead.
///
/// # Panics
/// When `n` is negative.
internal fn filled<T>(n: int, x: T): T[];

/// Repeats `xs` `n` times, every slot a `clone()` of the pattern's element.
///
/// The operator `[x] * n` over an element that is or holds an object becomes this call, so no
/// object is shared into several slots; a value element copies natively.
///
/// # Panics
/// When `n` is negative.
pub fn repeatArray<T :: [Clone]>(xs: T[], n: int): T[] {
    if (n < 0) {
        panic("negative repeat count");
    }
    let m = xs.length();
    return arrayOf(m * n, (i: int) => xs[i % m].clone());
}

/// The root of everything thrown, caught and declared.
///
/// A struct, a class or an enum that conforms is throwable; an enum is the natural form:
/// `enum ParseError :: [Error] { Empty, BadDigit(char, int) }`. `cause` names the error this one
/// wraps, for a report that walks the chain; the wrapped error is held in the type's own field.
pub interface Error {
    fn message(): string;

    fn cause(): ?Error {
        return null;
    }
}

/// A ready-made [Error] that carries a message.
///
/// `throw Exception("…");`, and `Exception("…", cause: e)` for the error it wraps. The fields
/// are `text` and `inner`; the methods `message()` and `cause()` return them.
pub class Exception :: [Error] {
    /// What `message()` returns.
    pub text: string,
    /// The error this one wraps, if any: what `cause()` returns.
    pub inner: ?Error = null,

    /// Creates an exception with `message` and, optionally, the error it wraps.
    pub static fn new(message: string, cause: ?Error = null): Exception {
        return Exception { text = message, inner = cause };
    }

    pub fn message(): string {
        return this.text;
    }

    pub fn cause(): ?Error {
        return this.inner;
    }
}

/// Records where an error was thrown.
///
/// A catch clause's `e.backtrace()` returns one in the debug profile, which keeps the frames of
/// every throw; the release profile keeps none. Shown, it is a panic's trace,
/// `    at <function> (<file>:<line>)`, one line a frame, innermost first; the frames are named
/// only when it is shown.
pub struct Backtrace :: [Display] {
    pcs: int[],

    pub fn show(): string {
        return traceText(this.pcs);
    }
}

/// Returns the frames at `pcs` in a panic's trace form.
fn traceText(pcs: int[]): string;

/// Returns the backtrace for a catch clause's `e.backtrace()`, or `null` where no program
/// counters were kept.
fn backtraceOf(pcs: int[]): ?Backtrace {
    if (pcs.length() == 0) {
        return null;
    }
    return Backtrace { pcs = pcs };
}

/// Holds a failure as a value: `Ok` with the value or `Err` with the error.
///
/// A result is kept, collected or decided on later. Two bridges lead to `throws` and back:
/// `Result.of { try f() }` catches into one, `try r.get()` throws out of one. `E` is an [Error],
/// which `get()` throws.
@MustUse
pub enum Result<T, E :: [Error]> {
    Ok(T),
    Err(E),
}

extend<T, E :: [Error]> Result<T, E> {
    /// Calls `f` and returns what it returns as `Ok`, what it throws as `Err`.
    pub static fn of(f: fn() -> T throws E): Result<T, E> {
        try {
            return .Ok(f());
        } catch (e) {
            return .Err(e);
        }
    }

    /// Returns an `Ok`'s value.
    ///
    /// # Errors
    /// Throws an `Err`'s error.
    pub fn get(): T throws E {
        return match (this) {
            .Ok(v) => v,
            .Err(e) => throw e,
        };
    }
}

// ---------------------------------------------------------------------------------------------
// Attributes. An attribute is a struct that says where it may sit — one of the markers below —,
// and a use writes its fields, each a value computed while the program compiles:
// `@Test { timeout = LIMIT }`. The compiler reads the ones of the closed list by their identity —
// `std.core.Test`, not any `Test`.
//
// A marker names one kind of declaration, or a set of them; an attribute names the narrowest
// that fits. The markers inherit nothing from each other: which declarations each admits is the
// compiler's own table.
// ---------------------------------------------------------------------------------------------

/// Where an attribute may sit: anywhere one stands.
pub interface OnAny { }

/// On a named declaration: a function, a method, a type, an interface, an alias, a field, a
/// variant, a parameter, a module-level binding, a `static let`, an associated type.
pub interface OnDecl { }

/// On a declaration at a module's top level: a function, a type, an interface, an alias, an
/// `extend`, a module-level binding.
pub interface OnTopLevel { }

/// On a struct, a class, an enum, an interface or an alias.
pub interface OnTypeLike { }

/// On a member: a method, a field, a `static let`, a variant, an associated type.
pub interface OnMember { }

/// On a function or a method.
pub interface OnCallable { }

/// At a module's head.
pub interface OnModule { }

/// On a struct, a class or an enum.
pub interface OnType { }

/// On a function at a module's top level.
pub interface OnFunction { }

/// On a method.
pub interface OnMethod { }

/// On a field.
pub interface OnField { }

/// On a parameter.
pub interface OnParameter { }

/// On an enum's variant.
pub interface OnVariant { }

/// On an interface.
pub interface OnInterface { }

/// On a type alias.
pub interface OnAlias { }

/// On an `extend` block.
pub interface OnExtend { }

/// Marks a function as a test, which `lyric test` runs.
///
/// A test takes no parameters, returns `void`, is not private and may throw; each runs in a task
/// of its own. `skip` says why one is not run, `timeout` how many seconds it may take: one that
/// outlives them ends the run. The tests run one after another; `parallel` lets one run beside
/// the others that say so, after the rest. What tests share (the working directory, the
/// environment, a global `var`) parallel tests share as threads do.
pub struct Test :: [OnFunction] {
    pub skip: string = "",
    pub timeout: int = 60,
    pub parallel: bool = false,
}

/// Marks a function as a benchmark, which `lyric bench` runs; also the measure it is handed.
///
/// A benchmark is `fn name(&b: Bench)`, not private; they run one after another.
/// `b.iter { … }` runs the block until the time of one run is known, `b.bytes(n)` says how many
/// bytes a run handles; what was measured is in the bench's fields after the call.
pub struct Bench :: [OnFunction] {
    /// The runs of the round reported, the nanoseconds they took, and the allocations they made
    /// on this thread and their bytes.
    pub var runs: int = 0,
    pub var nanos: int = 0,
    pub var allocations: int = 0,
    pub var allocatedBytes: int = 0,
    /// The bytes a run handles, as `bytes(n)` said; 0 where it said nothing.
    pub var bytesPerRun: int = 0,

    /// Runs `body` repeatedly until the time of one run is known.
    ///
    /// Once to warm up, then rounds of ever more runs until one takes a tenth of a second, then
    /// five rounds of that many; the bench reports the round of the median time. The loop's call
    /// of `body` is in the time; [blackBox] keeps a result the compiler would otherwise drop.
    pub mut fn iter(body: fn() -> void): void {
        body();
        var n = 1;
        var took = timedRound(body, n).0;
        while (took < 100000000) {
            // as many runs as a tenth of a second at this pace, a fifth more, at most a hundred times more
            let pace = if (took > 0) ((n as float) * 120000000.0 / (took as float)) as int
                else n * 100;
            n = if (pace > n * 100) n * 100 else if (pace <= n) n + 1 else pace;
            took = timedRound(body, n).0;
        }
        let rounds = arrayOf(5, (_: int) => timedRound(body, n));
        let times = arrayOf(5, (i: int) => rounds[i].0);
        times.sort();
        for (r in rounds) {
            if (r.0 == times[2]) {
                this.runs = n;
                this.nanos = r.0;
                this.allocations = r.1;
                this.allocatedBytes = r.2;
                return;
            }
        }
    }

    /// Sets the bytes one run handles, so the report gives the bytes a second.
    pub mut fn bytes(n: int): void {
        this.bytesPerRun = n;
    }

    /// Returns the nanoseconds one run took in the round reported; 0 before any run.
    pub fn nanosPerRun(): float {
        return if (this.runs > 0) (this.nanos as float) / (this.runs as float) else 0.0;
    }
}

/// Runs `body` `n` times and returns the nanoseconds taken, the allocations made on this thread
/// and their bytes.
fn timedRound(body: fn() -> void, n: int): (int, int, int) {
    let allocations = threadAllocations();
    let bytes = threadAllocatedBytes();
    let start = benchClock();
    for (_ in 0..n) {
        body();
    }
    let took = benchClock() - start;
    return (took, threadAllocations() - allocations, threadAllocatedBytes() - bytes);
}

/// Returns the monotonic clock, in nanoseconds.
fn benchClock(): int;

/// Returns the allocations this thread has made since it started, and their bytes.
fn threadAllocations(): int;
fn threadAllocatedBytes(): int;

/// Returns `x` through a point the compiler cannot see through.
///
/// What computed `x` is not dropped as unused, and the value that comes out is not known in
/// advance; for a benchmark's body, whose result nothing reads. It costs a store.
pub fn blackBox<T>(x: T): T {
    return x;
}

/// Fills a `string` parameter with the source text the call wrote for parameter `p`.
///
/// `@callerExpr(p)` stands on a parameter with a default; where a call leaves that parameter
/// out, it gets the text written for `p`: `assertEq(xs.length(), 3)` hands `std.test` the words
/// `xs.length()`. Named like a compiler instruction, not like a type.
@Allow("naming")
pub struct callerExpr :: [OnParameter] { }

/// Fills an `int` parameter with the line the call begins on.
///
/// `@callerLine` stands on a parameter with a default; it applies where a call leaves the
/// parameter out.
@Allow("naming")
pub struct callerLine :: [OnParameter] { }

/// Fills a `string` parameter with the file the call stands in.
///
/// `@callerFile` stands on a parameter with a default; it applies where a call leaves the
/// parameter out. The file is named as the binary's backtrace names it: the package's name, then
/// the path within the package (`app/src/main.lyr`), with forward slashes.
@Allow("naming")
pub struct callerFile :: [OnParameter] { }

/// Marks a declaration as deprecated.
///
/// Every use outside a deprecated declaration warns (`LYR-SEM0076`) with `message`. `until`
/// names the release that removes it: a build with that toolchain version or later fails at the
/// attribute (`LYR-SEM0081`). `replacement` is what the use should become, for the tools. It
/// stands on a module, on what stands at a module's top level (an `extend` block for its
/// members) and on a member; not on a parameter.
pub struct Deprecated :: [OnModule, OnTopLevel, OnMember] {
    pub message: string = "",
    pub until: string = "",
    pub replacement: string = "",
}

/// Hints to the C compiler to inline the function wherever it is called.
///
/// A hint, no promise; unlike the keyword `inline`, whose function the language itself splices
/// into its caller.
pub struct AlwaysInline :: [OnCallable] { }

/// Hints to the C compiler to keep the function a call; the compiler's own inliner keeps it one
/// too.
pub struct NoInline :: [OnCallable] { }

/// Hints to the C compiler that the function is rarely called, such as a path of errors.
pub struct Cold :: [OnCallable] { }

/// Marks a value nobody should drop.
///
/// A call of a function marked so, or a call whose value is of a type marked so, warns where it
/// stands as a statement and its value goes nowhere.
pub struct MustUse :: [OnCallable, OnType] { }

/// Marks an enum or a `sealed` interface that may grow.
///
/// A `match` over it outside its package needs a `_` arm, so a new variant or conformer breaks
/// nobody there.
pub struct NonExhaustive :: [OnType, OnInterface] { }

/// Silences a lint where this attribute stands.
///
/// `@Allow("unused-variable")` on a declaration, or on the module's head, silences the lint
/// inside it: a lint by its name or its code, a group (`"unused"`), or `"warnings"` for all. An
/// `@Allow` that silences nothing warns itself (`useless-allow`). The manifest's `[lints] allow`
/// does it for the package.
pub struct Allow :: [OnAny] {
    pub lint: string,
}

/// Reports a lint as a warning where this attribute stands, whatever the package says.
pub struct Warn :: [OnAny] {
    pub lint: string,
}

/// Reports a lint as an error where this attribute stands.
///
/// The build fails, and the error names the `@Deny` that made it one.
pub struct Deny :: [OnAny] {
    pub lint: string,
}

/// A resource that a `using let` binding closes when its scope is left.
///
/// `close()` may throw: on a normal exit the error leaves like any other; while another error is
/// in flight it is appended to that one as suppressed.
pub interface Closeable {
    fn close(): void throws Error;
}

// ---------------------------------------------------------------------------------------------
// The operator interfaces. 'a + b' is exactly 'a.add(b)': the conformance
// is chosen by the static type of 'b', the result is the conformer's 'Out' — 'Self' unless it
// says otherwise. The built-in scalars conform below, through the operators the compiler binds
// itself; a generic 'fn sum<T :: [Add<Out = T>]>' reaches them the same way.
// ---------------------------------------------------------------------------------------------

/// The operator `+`: `a + b` is `a.add(b)`.
pub interface Add<Rhs = Self> {
    type Out = Self;
    fn add(rhs: Rhs): Self.Out;
}

/// The operator `-`: `a - b` is `a.sub(b)`.
pub interface Sub<Rhs = Self> {
    type Out = Self;
    fn sub(rhs: Rhs): Self.Out;
}

/// The operator `*`: `a * b` is `a.mul(b)`.
pub interface Mul<Rhs = Self> {
    type Out = Self;
    fn mul(rhs: Rhs): Self.Out;
}

/// The operator `/`: `a / b` is `a.div(b)`.
pub interface Div<Rhs = Self> {
    type Out = Self;
    fn div(rhs: Rhs): Self.Out;
}

/// The operator `%`: `a % b` is `a.rem(b)`.
pub interface Rem<Rhs = Self> {
    type Out = Self;
    fn rem(rhs: Rhs): Self.Out;
}

/// `-x` is `x.neg()`.
pub interface Neg {
    type Out = Self;
    fn neg(): Self.Out;
}

/// `a & b` is `a.bitAnd(b)`.
pub interface BitAnd<Rhs = Self> {
    type Out = Self;
    fn bitAnd(rhs: Rhs): Self.Out;
}

/// `a | b` is `a.bitOr(b)`.
pub interface BitOr<Rhs = Self> {
    type Out = Self;
    fn bitOr(rhs: Rhs): Self.Out;
}

/// `a ^ b` is `a.bitXor(b)`.
pub interface BitXor<Rhs = Self> {
    type Out = Self;
    fn bitXor(rhs: Rhs): Self.Out;
}

/// `~x` is `x.bitNot()`.
pub interface BitNot {
    type Out = Self;
    fn bitNot(): Self.Out;
}

/// `a << b` is `a.shl(b)`; the count is an `int` unless the conformer says otherwise.
pub interface Shl<Rhs = int> {
    type Out = Self;
    fn shl(rhs: Rhs): Self.Out;
}

/// `a >> b` is `a.shr(b)`; the count is an `int` unless the conformer says otherwise.
pub interface Shr<Rhs = int> {
    type Out = Self;
    fn shr(rhs: Rhs): Self.Out;
}

/// The operators `==` and `!=`: `a == b` is `a.equals(b)`, `!=` its negation.
///
/// Both sides are the conformer's own type: there is no heterogeneous equality.
@SeesConformer
pub interface Equatable {
    /// Returns whether this equals `o`.
    ///
    /// Synthesized for a conformance without the member: field by field in declaration order;
    /// for an enum, the same variant with equal payloads.
    fn equals(o: Self): bool {
        comptime if (isEnum<Self>()) {
            comptime for (v in variants<Self>()) {
                if (this is v) {
                    if (!(o is v)) {
                        return false;
                    }
                    comptime for (p in v.payload) {
                        if (!(this.[v, p] == o.[v, p])) {
                            return false;
                        }
                    }
                    return true;
                }
            }
            return false;
        } else {
            comptime for (f in fields<Self>()) {
                if (!(this.[f] == o.[f])) {
                    return false;
                }
            }
            return true;
        }
    }
}

/// The answer of a comparison; equatable, hashable and printable like any plain enum.
pub enum Ordering :: [Equatable, Hashable, Debug] {
    Less,
    Equal,
    Greater,
}

/// The operators `<`, `<=`, `>` and `>=`, which read `a.compare(b)`.
///
/// `.Less` means `<`; `null` means the two are not ordered (`float` is partial, NaN compares
/// with nothing), in which case every one of the four is false.
@SeesConformer
pub interface Ordered :: [Equatable] {
    /// Compares this with `o`; `null` where the two are not ordered.
    ///
    /// Synthesized lexicographically over the fields: the first that is not `.Equal` decides,
    /// and an unordered field (`null`) is the answer; an enum by the variant's position first,
    /// then its payload.
    fn compare(o: Self): ?Ordering {
        comptime if (isEnum<Self>()) {
            // the two positions first (one test per variant each), the payload only where they meet
            var a = 0;
            var b = 0;
            comptime for (v in variants<Self>()) {
                if (this is v) {
                    a = v.index;
                }
                if (o is v) {
                    b = v.index;
                }
            }
            if (a < b) {
                return Ordering.Less;
            }
            if (a > b) {
                return Ordering.Greater;
            }
            comptime for (v in variants<Self>()) {
                if (this is v) {
                    comptime for (p in v.payload) {
                        let c = this.[v, p].compare(o.[v, p]);
                        if (c == null) {
                            return null;
                        }
                        match (c) {
                            .Equal => { }
                            _ => {
                                return c;
                            }
                        }
                    }
                    return Ordering.Equal;
                }
            }
            return Ordering.Equal;
        } else {
            comptime for (f in fields<Self>()) {
                let c = this.[f].compare(o.[f]);
                if (c == null) {
                    return null;
                }
                match (c) {
                    .Equal => { }
                    _ => {
                        return c;
                    }
                }
            }
            return Ordering.Equal;
        }
    }

    /// Returns this held to `lo`…`hi`: `lo` below it, `hi` above it.
    ///
    /// A value unordered with the bounds, such as a NaN, comes back as it is.
    ///
    /// # Panics
    /// When `lo` is above `hi`.
    fn clamp(lo: Self, hi: Self): Self {
        if (hi < lo) {
            panic("clamp: lo is above hi");
        }
        if (this < lo) {
            return lo;
        }
        if (this > hi) {
            return hi;
        }
        return this;
    }
}

/// A total order, what sorting and keys need; `float` has none of its own.
@SeesConformer
pub interface TotalOrder :: [Ordered] {
    /// Compares this with `o` in the total order.
    ///
    /// Synthesized as `compare` is, every field compared totally.
    fn totalCompare(o: Self): Ordering {
        comptime if (isEnum<Self>()) {
            var a = 0;
            var b = 0;
            comptime for (v in variants<Self>()) {
                if (this is v) {
                    a = v.index;
                }
                if (o is v) {
                    b = v.index;
                }
            }
            if (a < b) {
                return Ordering.Less;
            }
            if (a > b) {
                return Ordering.Greater;
            }
            comptime for (v in variants<Self>()) {
                if (this is v) {
                    comptime for (p in v.payload) {
                        let c = this.[v, p].totalCompare(o.[v, p]);
                        match (c) {
                            .Equal => { }
                            _ => {
                                return c;
                            }
                        }
                    }
                    return Ordering.Equal;
                }
            }
            return Ordering.Equal;
        } else {
            comptime for (f in fields<Self>()) {
                let c = this.[f].totalCompare(o.[f]);
                match (c) {
                    .Equal => { }
                    _ => {
                        return c;
                    }
                }
            }
            return Ordering.Equal;
        }
    }
}

/// Computes a hash: a value's parts are written in, the hash is read out.
///
/// The hashers themselves live in `std.hash`.
pub interface Hasher {
    /// Writes one byte.
    mut fn writeByte(b: uint8): void;

    /// Writes the bytes, in order.
    mut fn write(bytes: Slice<uint8>): void {
        var i = 0;
        while (i < bytes.length()) {
            this.writeByte(bytes[i]);
            i = i + 1;
        }
    }

    /// Writes the eight bytes of `v`, the lowest first.
    mut fn writeUint(v: uint64): void {
        var i = 0;
        while (i < 8) {
            this.writeByte((v >> ((8 * i) as uint64)) as uint8);
            i = i + 1;
        }
    }

    /// Writes the eight bytes of `v` in two's complement, the lowest first.
    mut fn writeInt(v: int): void {
        this.writeUint(v as uint64);
    }

    /// Returns the hash of the bytes written so far; more may be written after.
    fn finish(): uint64;
}

/// A value that can be hashed, as a `Map` key and a `Set` element must be.
///
/// The value's parts are written into a [Hasher], in an order of the type's. Equal values must
/// write the same; nothing checks it.
@SeesConformer
pub interface Hashable :: [Equatable] {
    /// Writes this value's parts into `h`.
    ///
    /// Synthesized as the fields in declaration order; for an enum, its variant's position, then
    /// the payload.
    fn hash<H :: [Hasher]>(&h: H): void {
        comptime if (isEnum<Self>()) {
            comptime for (v in variants<Self>()) {
                if (this is v) {
                    h.writeInt(v.index);
                    comptime for (p in v.payload) {
                        this.[v, p].hash(&h);
                    }
                }
            }
        } else {
            comptime for (f in fields<Self>()) {
                this.[f].hash(&h);
            }
        }
    }
}

/// Compares an object by itself and hashes it by where it lives.
///
/// `class Node :: [Identity]` is given an `equals` that is `same(this, o)` and a `hash` of its
/// address, so a `Map<Node, X>` keys by the object without a member written. Only a class can
/// conform; a value has no identity. Nothing on the heap moves, so an object keeps its address
/// while it lives.
pub interface Identity :: [Hashable] { }

/// Gives an enum value the name of its variant, as written.
///
/// `Color.Red.name()` is `"Red"`. A default over the variants, for any enum.
@SeesConformer
pub interface VariantName {
    /// Returns the variant's name.
    fn name(): string {
        comptime for (v in variants<Self>()) {
            if (this is v) {
                return v.name;
            }
        }
        return unreachable("an enum value holds one of its variants");
    }
}

/// Gives an enum's variants as values: all of them in declaration order, and one by its name.
///
/// Only for an enum whose variants all are units; an enum with a payload variant is refused at
/// its conformance.
@SeesConformer
pub interface Variants :: [VariantName] {
    /// Returns every variant, in declaration order.
    static fn all(): Self[] {
        let all = variants<Self>();
        var out: Self[] = [];
        comptime for (v in variants<Self>()) {
            comptime if (v.index == 0) {
                out = [Self.[v]] * all.length();
            }
            out[v.index] = Self.[v];
        }
        return out;
    }

    /// Returns the variant named `s`, or `null` where there is none.
    static fn fromName(s: string): ?Self {
        comptime for (v in variants<Self>()) {
            if (s == v.name) {
                return Self.[v];
            }
        }
        return null;
    }
}

/// The index operator: `x[k]` is `x.index(k)`, the element a key or a position names.
///
/// The element's type is the conformer's `Output`. An array's and a view's index is built in.
pub interface Index<K> {
    type Output;
    fn index(k: K): Self.Output;
}

/// The index assignment: `x[k] = v` is `x.setIndex(k, v)`.
///
/// `x[k] += 1` reads and writes, `x` and `k` evaluated once.
pub interface IndexSet<K> :: [Index<K>] {
    mut fn setIndex(k: K, v: Self.Output): void;
}

/// Gives a view of the elements, which makes `x[a..b]` the range of that view.
///
/// `list[a..b]` is `list.asSlice()[a..b]`, a `Slice<T>` over the elements, no copy. An array's,
/// a view's and a string's range are built in.
pub interface AsSlice<T> {
    fn asSlice(): Slice<T>;
}

/// The operator `in`: `x in xs` is `xs.contains(x)`.
pub interface Contains<T> {
    fn contains(x: T): bool;
}

/// Renders a value as text: `{x}` in an f-string renders through `show()`.
///
/// The scalars render natively and conform here, so a constraint `T :: [Display]` takes them.
pub interface Display {
    fn show(): string;

    /// Appends the text to `out`.
    ///
    /// F-strings and the containers call it, so a text is built in one buffer. The default
    /// appends `show()`; a type that can write itself directly overrides it.
    fn showTo(out: StringBuilder): void {
        out.appendStr(this.show());
    }
}

// --- the scalars ------------------------------------------------------------------------------
extend int :: [
    Equatable,
    Ordered,
    TotalOrder,
    Hashable,
    Display,
    Add,
    Sub,
    Mul,
    Div,
    Rem,
    Neg,
    BitAnd,
    BitOr,
    BitXor,
    BitNot,
    Shl,
    Shr
] {
    fn equals(o: int): bool {
        return this == o;
    }

    fn compare(o: int): ?Ordering {
        if (this < o) {
            return Ordering.Less;
        }
        if (this > o) {
            return Ordering.Greater;
        }
        return Ordering.Equal;
    }

    fn totalCompare(o: int): Ordering {
        if (this < o) {
            return Ordering.Less;
        }
        if (this > o) {
            return Ordering.Greater;
        }
        return Ordering.Equal;
    }

    fn hash<H :: [Hasher]>(&h: H): void {
        h.writeInt(this as int);
    }

    fn show(): string {
        return f"{this}";
    }

    fn showTo(out: StringBuilder): void {
        out.putInt(this);
    }

    fn add(rhs: int): int {
        return this + rhs;
    }

    fn sub(rhs: int): int {
        return this - rhs;
    }

    fn mul(rhs: int): int {
        return this * rhs;
    }

    fn div(rhs: int): int {
        return this / rhs;
    }

    fn rem(rhs: int): int {
        return this % rhs;
    }

    fn neg(): int {
        return -this;
    }

    fn bitAnd(rhs: int): int {
        return this & rhs;
    }

    fn bitOr(rhs: int): int {
        return this | rhs;
    }

    fn bitXor(rhs: int): int {
        return this ^ rhs;
    }

    fn bitNot(): int {
        return ~this;
    }

    fn shl(rhs: int): int {
        return this << rhs;
    }

    fn shr(rhs: int): int {
        return this >> rhs;
    }
}

