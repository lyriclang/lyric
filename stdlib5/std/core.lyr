/// A coroutine is an object, compared by itself and hashed by its address (06 A7): the same
/// coroutine met twice is found — in a set of those running, at a second `spawn`. What a pull
/// throws asks nothing of it, so the block reaches every coroutine of a yield and a result type.
extend<Y, R> Coroutine<Y, R> :: [Identity] {
    fn equals(o: Coroutine<Y, R>): bool {
        return same(this, o);
    }

    fn hash<H :: [Hasher]>(&h: H): void {
        hashIdentityInto(this, &h);
    }
}

// ---------------------------------------------------------------------------------------------
// The build's target and profile (design/v5/spec/09 A6 B4, Q7; 11 W2 P11; 13 M9a P9): constants
// the compiler writes — a cross-build's target, not the host's —, which `comptime if` and `@When`
// choose by while compiling. `std.os` passes the two kinds on and answers them at run time (10 Q9).
// ---------------------------------------------------------------------------------------------

/// The system a program runs on (10 Q9), as the target triples name it: one of the Tier 1
/// targets', `Other` for another POSIX system the runtime was built for.
pub enum Platform :: [Equatable, Debug] {
    Linux,
    MacOS,
    Windows,
    Other,
}

extend Platform :: [Display] {
    fn show(): string {
        return match (this) {
            .Linux => "linux",
            .MacOS => "macos",
            .Windows => "windows",
            .Other => "other",
        };
    }
}

/// The machine a program runs on (10 Q9), as the target triples name it.
pub enum Arch :: [Equatable, Debug] {
    X86_64,
    Aarch64,
    Other,
}

extend Arch :: [Display] {
    fn show(): string {
        return match (this) {
            .X86_64 => "x86_64",
            .Aarch64 => "aarch64",
            .Other => "other",
        };
    }
}

/// What a program is built for (09 B4): its system, its machine, the width of a pointer in bits.
pub struct Target :: [Equatable, Debug] {
    pub os: Platform,
    pub arch: Arch,
    pub pointerWidth: int,
}

/// What a program is built as (09 B4): `debug` where the profile is the built-in `debug` or one
/// that inherits from it (11 W2 P3).
pub struct Profile :: [Equatable, Debug] {
    pub debug: bool,
}

/// The target of the build: `comptime if (target.os == .Windows)` chooses while compiling (09 B1).
/// A constant; a program that does not read it carries nothing of it.
pub let target: Target = comptime Target {
    os = platformOf(buildOs()),
    arch = archOf(buildArch()),
    pointerWidth = buildPointerWidth(),
};

/// The profile of the build: `comptime if (profile.debug)`.
pub let profile: Profile = comptime Profile { debug = buildDebug() };

/// `@When(cond)` (09 A11 B2, B3): the declaration is built only where `cond` holds — a value
/// computed while compiling, over `target` and `profile`. Where it does not, the declaration is
/// checked as every other, and nothing of it is built; a use the program would run is refused
/// (`LYR-CT0006`), one in the branch a `comptime if` does not take is none. On a module's header
/// it holds for all the module declares: one module per system.
pub struct When :: [OnTopLevel, OnModule] {
    pub cond: bool,
}

fn platformOf(code: int): Platform {
    return match (code) {
        1 => .Linux,
        2 => .MacOS,
        3 => .Windows,
        _ => .Other,
    };
}

fn archOf(code: int): Arch {
    return match (code) {
        1 => .X86_64,
        2 => .Aarch64,
        _ => .Other,
    };
}

// What the build is for and as: compile time answers them, nothing at run time asks.
fn buildOs(): int;
fn buildArch(): int;
fn buildPointerWidth(): int;
fn buildDebug(): bool;

/// `@Shared` on a field (04 Clone; 09 A11): a synthesized `clone()` copies the field as it stands
/// instead of cloning it — a parent, a service, a cycle: what both copies share.
pub struct Shared :: [OnField] { }

// ---------------------------------------------------------------------------------------------
// Type information while compiling (design/v5/spec/09 A7; 10 B13 M1; M9a S9, S10). Declared here,
// not in std.meta: the synthesized members above are written over these questions, and std.core
// imports nothing. std.meta passes them on by name.

/// Who may name a declaration (07 V2).
pub enum Visibility :: [Equatable, Debug] { Pub, Internal, Private }

/// A type as a value while compiling: its name, as `typeName` gives it. What else a type is — set
/// into a `quote` — comes with the macros (13 M9b).
pub struct Type :: [Equatable, Debug] {
    pub name: string,
}

/// A field of a struct or a class, in declaration order; in a round over it, `f.type` names its
/// type and `e.[f]` is the field.
pub struct FieldInfo :: [Equatable, Debug] {
    pub name: string,
    pub type: Type,
    pub index: int,
    pub visibility: Visibility,
    pub isVar: bool,
}

/// A variant of an enum, in declaration order, and the fields of its payload — a positional one
/// named by its position, `0`, `1`, ….
pub struct VariantInfo :: [Equatable, Debug] {
    pub name: string,
    pub index: int,
    pub payload: FieldInfo[],
}

/// A function of a type's own body: its name, its word, whether it is static, whether it is `mut`.
pub struct MemberInfo :: [Equatable, Debug] {
    pub name: string,
    pub visibility: Visibility,
    pub isStatic: bool,
    pub isMut: bool,
}

/// The fields of a struct or a class that the asking code may name, in declaration order; none
/// for any other type.
pub fn fields<T>(): FieldInfo[];

/// The functions of a type's own body that the asking code may name, in declaration order — a
/// block's members are the block's.
pub fn members<T>(): MemberInfo[];

/// The attribute `A` the field `f` carries, its value — none where it carries none (R4). `f` is
/// the variable of a `comptime for` over `fields`, read in its round.
pub fn attribute<A>(f: FieldInfo): ?A;

/// The attribute `A` the declaration of `T` carries, its value; none where it carries none.
pub fn typeAttribute<T, A>(): ?A;

/// The variants of an enum, in declaration order; none for any other type.
pub fn variants<E>(): VariantInfo[];

/// The interfaces `T` conforms to, by its list, its blocks and the parents they bring.
pub fn conformances<T>(): Type[];

/// Does `T` conform to `I`?
pub fn hasConformance<T, I>(): bool;

/// `T`'s name, its arguments with it: `Pair<int, string>`.
pub fn typeName<T>(): string;

pub fn isStruct<T>(): bool;
pub fn isClass<T>(): bool;
pub fn isEnum<T>(): bool;
pub fn isInterface<T>(): bool;
