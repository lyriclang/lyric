    }
}

extend string :: [Equatable, Display, Add] {
    fn equals(o: string): bool {
        return this == o;
    }

    fn show(): string {
        return this;
    }

    fn showTo(out: StringBuilder): void {
        out.appendStr(this);
    }

    fn add(rhs: string): string {
        return this + rhs;
    }
}

// ---------------------------------------------------------------------------------------------
// The synthesized conformances: a conformance written without a body is
// implemented from the fields — 'Debug' for every type that writes none. The scalars conform
// below; the shapes a field may have render through the helpers at the end.
// ---------------------------------------------------------------------------------------------

/// Renders a value for debugging: `P { x = 1, y = "a" }`, `E.B(3)`.
///
/// Every struct, class and enum has one, written or synthesized; a string renders quoted.
pub interface Debug {
    fn debug(): string;

    /// Appends the debug text to `out`, as `showTo` does for `show()`.
    fn debugTo(out: StringBuilder): void {
        out.appendStr(this.debug());
    }
}

/// Copies a value deeply: value fields copied, reference fields cloned.
///
/// Synthesized for a conformance without a body.
@SeesConformer
pub interface Clone {
    /// Returns a copy of this value.
    ///
    /// Synthesized as every field cloned, a `@Shared` field copied as it stands; for an enum,
    /// its variant rebuilt from the payload cloned.
    fn clone(): Self {
        comptime if (isEnum<Self>()) {
            comptime for (v in variants<Self>()) {
                if (this is v) {
                    return Self.[v] { comptime for (p in v.payload) [p] = this.[v, p].clone() };
                }
            }
            return this;
        } else {
            return Self {
                comptime for (f in fields<Self>()) [f] = comptime if (attribute<Shared>(f)
                    != null) this.[f]
                else this.[f].clone(),
            };
        }
    }
}

/// Gives the value a type starts from: `0`, `""`, `[]`, `null`, a field default.
///
/// Synthesized field-wise.
pub interface Default {
    /// Returns the type's default value.
    ///
    /// Synthesized field-wise by the compiler; the interface itself gives no body.
    static fn default(): Self;
}

/// Converts a value into the type: `Centimeters.from(m)`.
///
/// A type writes `From`; [Into] follows from it. `as` converts numbers only.
pub interface From<T> {
    static fn from(v: T): Self;
}

/// Converts a value out of the type: `let cm: Centimeters = m.into();`.
///
/// The expected type chooses the target. The blanket conformance below gives it wherever a
/// [From] is; a type's own `Into<X>` is allowed only where no `X :: [From<…>]` of the type gives
/// the same.
pub interface Into<T> {
    fn into(): T;
}

extend<T, U :: [From<T>]> T :: [Into<U>] {
    fn into(): U {
        return U.from(this);
    }
}

extend int :: [Debug, Clone, Default] {
    fn debug(): string {
        return f"{this}";
    }

    fn clone(): int {
        return this;
    }

    static fn default(): int {
        return 0;
    }
}

