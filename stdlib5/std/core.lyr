extend char :: [Debug, Clone] {
    /// Returns the character between `'`, escaped as a text's characters are: `'\''`, `'\n'`,
    /// `'\u{200b}'`.
    fn debug(): string {
        let out = StringBuilder.new();
        out.appendChar('\'');
        escapeTo(out, this, '\'');
        out.appendChar('\'');
        return out.toString();
    }

    fn clone(): char {
        return this;
    }
}

// The way into a char: it answers `null` where `as char` would panic, since a number from data is
// no programmer's error. The way out is `c as uint32`.
extend char {
    /// Returns the character of a scalar value; `null` for a surrogate, 0xD800…0xDFFF, or beyond
    /// 0x10FFFF.
    pub static fn fromUint32(n: uint32): ?char {
        if (n > 0x10FFFF || (n >= 0xD800 && n <= 0xDFFF)) {
            return null;
        }
        return n as char;
    }
}

/// A character's general category (UAX #44), in the standard's order.
///
/// No `char` is a `Surrogate`, since the halves of a UTF-16 pair are no scalar values; the
/// variant is there because the standard lists it.
pub enum UnicodeCategory :: [Equatable, Hashable, Debug] {
    UppercaseLetter,
    LowercaseLetter,
    TitlecaseLetter,
    ModifierLetter,
    OtherLetter,
    NonspacingMark,
    SpacingMark,
    EnclosingMark,
    DecimalNumber,
    LetterNumber,
    OtherNumber,
    ConnectorPunctuation,
    DashPunctuation,
    OpenPunctuation,
    ClosePunctuation,
    InitialPunctuation,
    FinalPunctuation,
    OtherPunctuation,
    MathSymbol,
    CurrencySymbol,
    ModifierSymbol,
    OtherSymbol,
    SpaceSeparator,
    LineSeparator,
    ParagraphSeparator,
    Control,
    Format,
    Surrogate,
    PrivateUse,
    Unassigned,
}

// The Unicode Character Database's answers (lyr/unicode.h): the category as its index in
// UnicodeCategory's order, the simple case mappings, White_Space.
fn unicodeCategory(c: char): int;
fn unicodeUpper(c: char): char;
fn unicodeLower(c: char): char;
fn unicodeWhiteSpace(c: char): bool;

fn categoryOf(k: int): UnicodeCategory {
    return match (k) {
        0 => .UppercaseLetter,
        1 => .LowercaseLetter,
        2 => .TitlecaseLetter,
        3 => .ModifierLetter,
        4 => .OtherLetter,
        5 => .NonspacingMark,
        6 => .SpacingMark,
        7 => .EnclosingMark,
        8 => .DecimalNumber,
        9 => .LetterNumber,
        10 => .OtherNumber,
        11 => .ConnectorPunctuation,
        12 => .DashPunctuation,
        13 => .OpenPunctuation,
        14 => .ClosePunctuation,
        15 => .InitialPunctuation,
        16 => .FinalPunctuation,
        17 => .OtherPunctuation,
        18 => .MathSymbol,
        19 => .CurrencySymbol,
        20 => .ModifierSymbol,
        21 => .OtherSymbol,
        22 => .SpaceSeparator,
        23 => .LineSeparator,
        24 => .ParagraphSeparator,
        25 => .Control,
        26 => .Format,
        27 => .Surrogate,
        28 => .PrivateUse,
        _ => .Unassigned,
    };
}

// What a character is: `isX` asks Unicode — the general category, or for whitespace the property
// White_Space, from the Unicode Character Database std.string's `unicodeVersion` names —,
// `isAsciiX` asks ASCII alone. Case maps one character to one (the simple case mapping) and knows
// no locale: `ß` stays `ß`.
extend char {
    /// Returns the character's general category.
    pub fn category(): UnicodeCategory {
        return categoryOf(unicodeCategory(this));
    }

    /// Returns whether this is a letter of any script: the categories Lu, Ll, Lt, Lm and Lo.
    pub fn isAlpha(): bool {
        return unicodeCategory(this) <= 4;
    }

    /// Returns whether this is a decimal digit of any script: the category Nd.
    ///
    /// `'٣'` is one. `isAsciiDigit` asks for `0`–`9` alone, and `parse` reads those alone.
    pub fn isDigit(): bool {
        return unicodeCategory(this) == 8;
    }

    /// Returns whether this is a letter or a decimal digit: `isAlpha` or `isDigit`.
    pub fn isAlphanumeric(): bool {
        let k = unicodeCategory(this);
        return k <= 4 || k == 8;
    }

    /// Returns whether this has the property White_Space.
    ///
    /// The space, the tab, the line ends, the no-break spaces, the ideographic space and their
    /// kin.
    pub fn isWhitespace(): bool {
        return unicodeWhiteSpace(this);
    }

    /// Returns whether this is an uppercase letter: the category Lu.
    pub fn isUpper(): bool {
        return unicodeCategory(this) == 0;
    }

    /// Returns whether this is a lowercase letter: the category Ll.
    pub fn isLower(): bool {
        return unicodeCategory(this) == 1;
    }

    /// Returns whether this is a control character: the category Cc.
    pub fn isControl(): bool {
        return unicodeCategory(this) == 25;
    }

    /// Returns the uppercase character by the simple mapping; the character itself where it has
    /// none.
    pub fn toUpper(): char {
        return unicodeUpper(this);
    }

    /// Returns the lowercase character by the simple mapping; the character itself where it has
    /// none.
    pub fn toLower(): char {
        return unicodeLower(this);
    }

    /// Returns whether this is `0`–`9`.
    pub fn isAsciiDigit(): bool {
        return this >= '0' && this <= '9';
    }

    /// Returns whether this is one of `a`–`z` and `A`–`Z`.
    pub fn isAsciiAlpha(): bool {
        return (this >= 'a' && this <= 'z') || (this >= 'A' && this <= 'Z');
    }

    /// Returns whether this is one of `0`–`9`, `a`–`f` and `A`–`F`.
    pub fn isAsciiHexDigit(): bool {
        return this.isAsciiDigit() || (this >= 'a' && this <= 'f') || (this >= 'A' && this <= 'F');
    }

    /// Returns whether this is ASCII whitespace as WHATWG counts it.
    ///
    /// The space, tab, line feed, form feed and carriage return; not the vertical tab.
    pub fn isAsciiWhitespace(): bool {
        let n = this as uint32;
        return n == 32 || n == 9 || n == 10 || n == 12 || n == 13;
    }

    /// Returns the character's value as a digit in base `radix`, or `null` where it is no digit
    /// of the base.
    ///
    /// The digits are `0`–`9`, then `a`–`z` or `A`–`Z` for 10–35; ASCII alone, as `parse` reads.
    ///
    /// # Panics
    /// When `radix` is outside 2–36.
    pub fn toDigit(radix: int): ?int {
        if (radix < 2 || radix > 36) {
            panic(f"radix {radix} is outside 2…36");
        }
        let n = this as uint32;
        var d = 36;
        if (n >= 48 && n <= 57) {
            d = (n - 48) as int;
        } else if (n >= 97 && n <= 122) {
            d = (n - 87) as int;
        } else if (n >= 65 && n <= 90) {
            d = (n - 55) as int;
        }
        if (d < radix) {
            return d;
        }
        return null;
    }

    /// Returns the character of the digit `n` in base `radix`, or `null` where `n` is no digit
    /// of the base.
    ///
    /// Letters are lowercase: `fromDigit(11, 16)` is `b`.
    ///
    /// # Panics
    /// When `radix` is outside 2–36.
    pub static fn fromDigit(n: int, radix: int): ?char {
        if (radix < 2 || radix > 36) {
            panic(f"radix {radix} is outside 2…36");
        }
        if (n < 0 || n >= radix) {
            return null;
        }
        let code = if (n < 10) 48 + n else 87 + n;
        return (code as uint32) as char;
    }
}

/// Hashes a string as its bytes and then 255, which no UTF-8 text holds.
///
/// So ("ab", "c") and ("a", "bc") write differently.
extend string :: [Hashable] {
    fn hash<H :: [Hasher]>(&h: H): void {
        hashText(this, &h);
    }
}

/// Writes a text into a hasher: its bytes, then 255, which no UTF-8 byte is.
///
/// "ab" + "c" and "a" + "bc" differ. The bytes go eight at a time as a word, the lowest first,
/// the rest one at a time: the same bytes in the same order as one at a time, so every hasher
/// answers as it would byte by byte.
fn hashText<H :: [Hasher]>(s: StringView, &h: H): void {
    let n = byteCount(s);
    var i = 0;
    while (i + 8 <= n) {
        h.writeUint(viewWordAt(s, i));
        i = i + 8;
    }
    while (i < n) {
        h.writeByte(byteAt(s, i) as uint8);
        i = i + 1;
    }
    h.writeByte(255);
}

extend string :: [Debug, Clone, Default] {
    /// Returns the text between `"`, escaped as it would be written.
    ///
    /// `["a\"b", "c"]` prints as it is written, and the quotes keep the boundaries between the
    /// elements visible.
    fn debug(): string {
        let out = StringBuilder.new();
        debugText(out, this);
        return out.toString();
    }

    fn debugTo(out: StringBuilder): void {
        debugText(out, this);
    }

    fn clone(): string {
        return this;
    }

    static fn default(): string {
        return "";
    }
}

fn debugText(out: StringBuilder, s: StringView): void {
    out.appendChar('"');
    for (c in s.chars()) {
        escapeTo(out, c, '"');
    }
    out.appendChar('"');
}

/// Appends one character to `out` as `Debug` writes it between `mark`s.
///
/// `\\`, the mark, `\n`, `\r`, `\t` and `\0` are escaped; a character that does not print as
/// itself is written as `\u{…}`, its scalar value in hex.
fn escapeTo(out: StringBuilder, c: char, mark: char): void {
    let n = c as uint32;
    if (c == mark || c == '\\') {
        out.appendChar('\\');
        out.appendChar(c);
    } else if (c == '\n') {
        out.appendStr("\\n");
    } else if (c == '\r') {
        out.appendStr("\\r");
    } else if (c == '\t') {
        out.appendStr("\\t");
    } else if (n == 0) {
        out.appendStr("\\0");
    } else if (printsAsItself(c)) {
        out.appendChar(c);
    } else {
        // The hex digits by hand: a format spec here would pull the whole format language into
        // every program that shows a text.
        let digits = "0123456789abcdef";
        out.appendStr("\\u{");
        var k = 5;
        var started = false;
        while (k >= 0) {
            let d = ((n >> ((k * 4) as uint32)) & 15) as int;
            if (d != 0 || started || k == 0) {
                out.appendChar(digits[d]);
                started = true;
            }
            k -= 1;
        }
        out.appendChar('}');
    }
}

/// Returns whether a character prints as itself in a `Debug` text.
///
/// Every category but Cc, Cf, Cs, Co, Cn, Zl and Zp, and of the space separators the space
/// alone.
fn printsAsItself(c: char): bool {
    let n = c as uint32;
    if (n < 128) {
        return n >= 32 && n != 127;
    }
    return unicodeCategory(c) < 22;
}

extend string {
    /// Creates the text of the characters, in order.
    ///
    /// # Errors
    /// What the iterator throws.
    pub static fn fromChars<I :: [Iterator<Item = char>]>(chars: I): string throws I.Error {
        var walk = chars;
        let out = StringBuilder.new();
        loop {
            if (let c = try walk.next()) {
                out.appendChar(c);
            } else {
                break;
            }
        }
        return out.toString();
    }
}

// ---------------------------------------------------------------------------------------------
// The numbers: ten types, one tower of interfaces with static members. Arithmetic stays in the
// type — the parent lists fix 'Out' — and the defaults are each type's own: 'int8.min.abs()' is a
// direct call, no value of an interface made.
// ---------------------------------------------------------------------------------------------

/// Every number type: its zero and its one, arithmetic that stays in the type.
pub interface Num :: [
    Equatable,
    Ordered,
    Add<Out = Self>,
    Sub<Out = Self>,
    Mul<Out = Self>,
    Div<Out = Self>,
    Rem<Out = Self>,
    Display,
    Debug,
    Parse,
    Default
] {
    static let zero: Self;
    static let one: Self;

    /// Returns whether this is the type's zero.
    fn isZero(): bool {
        return this == Self.zero;
    }
}

/// A number with a sign: the signed integers and the floats — what `std.math`'s `abs` and
/// `signum` take; `uint` has neither.
pub interface Signed :: [Num, Neg<Out = Self>] { }

/// The eight integer types: their range, a total order, a hash, the bit operators.
pub interface Integer :: [
    Num,
    TotalOrder,
    Hashable,
    BitAnd<Out = Self>,
    BitOr<Out = Self>,
    BitXor<Out = Self>,
    BitNot<Out = Self>,
    Shl<Out = Self>,
    Shr<Out = Self>
] {
    static let min: Self;
    static let max: Self;
    static let bitWidth: int;
    static let isSigned: bool;

    /// Returns `v` as this type where it fits, `null` where it does not.
    static fn exact<T :: [Integer]>(v: T): ?Self;

    /// Returns `v` as this type, held at `min` or `max` where it does not fit.
    static fn clamping<T :: [Integer]>(v: T): Self;

    /// Returns the sum, or `null` where it does not fit the type.
    fn checkedAdd(o: Self): ?Self {
        return if (addOverflows(this, o)) null else addWrapping(this, o);
    }

    /// Returns the difference, or `null` where it does not fit.
    fn checkedSub(o: Self): ?Self {
        return if (subOverflows(this, o)) null else subWrapping(this, o);
    }

    /// Returns the product, or `null` where it does not fit.
    fn checkedMul(o: Self): ?Self {
        return if (mulOverflows(this, o)) null else mulWrapping(this, o);
    }

    /// Returns the quotient, or `null` for a zero divisor and for `min / -1`, which does not fit.
    fn checkedDiv(o: Self): ?Self {
        if (o == Self.zero || (Self.isSigned && this == Self.min && o == Self.zero - Self.one)) {
            return null;
        }
        return this / o;
    }

    /// Returns the remainder, or `null` for a zero divisor; a remainder by `-1` is `0`.
    fn checkedRem(o: Self): ?Self {
        if (o == Self.zero) {
            return null;
        }
        if (Self.isSigned && o == Self.zero - Self.one) {
            return Self.zero;
        }
        return this % o;
    }

    /// Returns the sum, held at `min` or `max` where it does not fit.
    fn saturatingAdd(o: Self): Self {
        return this.checkedAdd(o) ?? (if (o < Self.zero) Self.min else Self.max);
    }

    /// Returns the difference, held at `min` or `max` where it does not fit.
    fn saturatingSub(o: Self): Self {
        return this.checkedSub(o) ?? (if (o < Self.zero) Self.max else Self.min);
    }

    /// Returns the product, held at `min` or `max` by the sign it would have.
    fn saturatingMul(o: Self): Self {
        return this.checkedMul(o)
            ?? (if ((this < Self.zero) != (o < Self.zero)) Self.min else Self.max);
    }

    /// Returns the sum modulo 2^bitWidth, as `+%` on the type.
    fn wrappingAdd(o: Self): Self {
        return addWrapping(this, o);
    }

    /// Returns the difference modulo 2^bitWidth, as `-%`.
    fn wrappingSub(o: Self): Self {
        return subWrapping(this, o);
    }

    /// Returns the product modulo 2^bitWidth, as `*%`.
    fn wrappingMul(o: Self): Self {
        return mulWrapping(this, o);
    }

    /// Returns the quotient, where `min / -1` wraps to `min`.
    ///
    /// # Panics
    /// When `o` is zero, as `/` does.
    fn wrappingDiv(o: Self): Self {
        if (Self.isSigned && this == Self.min && o == Self.zero - Self.one) {
            return Self.min;
        }
        return this / o;
    }

    /// Returns the remainder, where a remainder by `-1` is `0`.
    ///
    /// # Panics
    /// When `o` is zero, as `%` does.
    fn wrappingRem(o: Self): Self {
        if (Self.isSigned && o == Self.zero - Self.one) {
            return Self.zero;
        }
        return this % o;
    }

    /// Returns `this` to the `n`th power, computed by squaring.
    ///
    /// # Panics
    ///
    /// When the power does not fit the type, as `*` panics on an overflow.
    fn pow(n: uint): Self {
        var result = Self.one;
        var base = this;
        var k = n;
        while (k > 0) {
            if (k % 2 == 1) {
                result = result * base;
            }
            k = k / 2;
            if (k > 0) {
                base = base * base;
            }
        }
        return result;
    }

    /// Returns the number of zero bits above the highest one bit; `bitWidth` for zero.
    fn leadingZeros(): int {
        return countLeadingZeros(this);
    }

    /// Returns the number of zero bits below the lowest one bit; `bitWidth` for zero.
    fn trailingZeros(): int {
        return countTrailingZeros(this);
    }

    /// Returns the number of one bits.
    fn popCount(): int {
        return countOnes(this);
    }

    /// Returns the bits rotated left by `n`, modulo `bitWidth`; a negative `n` rotates right.
    fn rotateLeft(n: int): Self {
        return rotateBitsLeft(this, n);
    }

    /// Returns the bits rotated right by `n`, modulo `bitWidth`; a negative `n` rotates left.
    fn rotateRight(n: int): Self {
        return rotateBitsLeft(this, -(n % Self.bitWidth));
    }
}

// The natives the defaults stand on: one each, generic, a C builtin serving every integer width —
// whether + - * leave the type and the result wrapped to it (what `+%` gives a builtin), the bit
// counts, the rotation.
fn addOverflows<T>(a: T, b: T): bool;
fn subOverflows<T>(a: T, b: T): bool;
fn mulOverflows<T>(a: T, b: T): bool;
fn addWrapping<T>(a: T, b: T): T;
fn subWrapping<T>(a: T, b: T): T;
fn mulWrapping<T>(a: T, b: T): T;
fn countLeadingZeros<T>(x: T): int;
fn countTrailingZeros<T>(x: T): int;
fn countOnes<T>(x: T): int;
fn rotateBitsLeft<T>(x: T, n: int): T;

/// The two float types, with what describes the type as members.
///
/// Its constants, its bits, its order, NaN and the infinities are members; what one computes
/// with a number lives in `std.math`.
pub interface Float :: [Signed] {
    /// The distance from `1.0` to the next value above it.
    static let epsilon: Self;
    static let infinity: Self;
    /// The quiet NaN with its sign clear — what `0.0 / 0.0` gives has the sign the hardware sets.
    static let nan: Self;
    /// The most negative finite value.
    static let min: Self;
    /// The greatest finite value.
    static let max: Self;
    /// The least positive value, a subnormal.
    static let leastPositive: Self;

    /// Returns the value a bit pattern names: a `float` its 64 bits, a `float32` the low 32.
    static fn fromBits(b: uint64): Self;

    /// Returns whether this is NaN, the one value unequal to itself.
    fn isNan(): bool {
        return this != this;
    }

    /// Returns whether this is an infinity, of either sign.
    fn isInfinite(): bool {
        return this == Self.infinity || this == -Self.infinity;
    }

    /// Returns whether this is neither NaN nor an infinity.
    fn isFinite(): bool {
        return !this.isNan() && !this.isInfinite();
    }

    /// Compares in IEEE 754's total order, for sorting.
    ///
    /// The order is -NaN, -infinity, the negatives, -0.0, 0.0, the positives, infinity, NaN;
    /// every value has its one place.
    fn totalCompare(o: Self): Ordering {
        let a = totalOrderKey(this);
        let b = totalOrderKey(o);
        if (a < b) {
            return Ordering.Less;
        }
        if (a > b) {
            return Ordering.Greater;
        }
        return Ordering.Equal;
    }

    /// The bit pattern: a `float` its 64 bits, a `float32` its 32 in the low ones.
    fn toBits(): uint64 {
        return floatBits(this);
    }
}

// The bits as macros; libm's functions are std.math's.
fn floatBits<T>(x: T): uint64;
fn floatFromBits<T>(b: uint64, like: T): T;
fn totalOrderKey<T>(x: T): uint64;

extend int :: [Num, Signed, Integer] {
    static let zero: int = 0;
    static let one: int = 1;
    static let min: int = -9223372036854775808;
    static let max: int = 9223372036854775807;
    static let bitWidth: int = 64;
    static let isSigned: bool = true;

    /// Parses the decimal integer a text names.
    ///
    /// # Errors
    /// A [ParseError] when the text is empty, not of the form, or beyond the type's range.
    static fn parse(s: StringView): int throws ParseError {
        return try parseInteger(s, 10);
    }

    /// Parses the integer a text names in base `radix`.
    ///
    /// # Panics
    /// When `radix` is outside 2…36.
    ///
    /// # Errors
    /// A [ParseError] when the text is empty, not of the form, or beyond the type's range.
    static fn parse(s: StringView, radix: int): int throws ParseError {
        return try parseInteger(s, radix);
    }

    /// Returns `v` as an `int` where it fits, `null` where it does not.
    static fn exact<T :: [Integer]>(v: T): ?int {
        return exactly(v);
    }

    /// Returns `v` as an `int`, held at `min` or `max` where it does not fit.
    static fn clamping<T :: [Integer]>(v: T): int {
        return clamped(v);
    }
}

