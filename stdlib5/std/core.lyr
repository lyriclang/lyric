/// Compares a coroutine by itself and hashes it by its address.
///
/// The same coroutine met twice is found, in a set of those running or at a second `spawn`.
/// The conformance holds for every coroutine of a yield and a result type, whatever a pull
/// throws.
extend<Y, R> Coroutine<Y, R> :: [Identity] {
    fn equals(o: Coroutine<Y, R>): bool {
        return same(this, o);
    }

    fn hash<H :: [Hasher]>(&h: H): void {
        hashIdentityInto(this, &h);
    }
}

// ---------------------------------------------------------------------------------------------
// The build's target and profile: constants the compiler writes — a cross-build's target, not
// the host's —, which `comptime if` and `@When` choose by while compiling. `std.os` passes the two
// kinds on and answers them at run time.
// ---------------------------------------------------------------------------------------------

/// The system a program runs on, as the target triples name it.
///
/// One of the Tier 1 targets' systems, or `Other` for another POSIX system the runtime was
/// built for.
pub enum Platform :: [Equatable, Debug] {
    Linux,
    MacOS,
    Windows,
    Other,
}

extend Platform :: [Display] {
    fn show(): string {
        return match (this) {
            .Linux => "linux",
            .MacOS => "macos",
            .Windows => "windows",
            .Other => "other",
        };
    }
}

/// The machine a program runs on, as the target triples name it.
pub enum Arch :: [Equatable, Debug] {
    X86_64,
    Aarch64,
    Other,
}

extend Arch :: [Display] {
    fn show(): string {
        return match (this) {
            .X86_64 => "x86_64",
            .Aarch64 => "aarch64",
            .Other => "other",
        };
    }
}

/// Describes what a program is built for: its system, its machine, the width of a pointer in
/// bits.
pub struct Target :: [Equatable, Debug] {
    pub os: Platform,
    pub arch: Arch,
    pub pointerWidth: int,
}

/// Describes what a program is built as.
///
/// `debug` is true where the profile is the built-in `debug` or one that inherits from it.
pub struct Profile :: [Equatable, Debug] {
    pub debug: bool,
}

/// The target of the build: `comptime if (target.os == .Windows)` chooses while compiling.
///
/// A constant; a program that does not read it carries nothing of it.
pub let target: Target = comptime Target {
    os = platformOf(buildOs()),
    arch = archOf(buildArch()),
    pointerWidth = buildPointerWidth(),
};

/// The profile of the build: `comptime if (profile.debug)`.
pub let profile: Profile = comptime Profile { debug = buildDebug() };

/// Builds the declaration only where `cond` holds: `@When(cond)`.
///
/// `cond` is computed while compiling, over [target] and [profile]. Where it does not hold, the
/// declaration is checked as every other and nothing of it is built; a use the program would
/// run is refused (`LYR-CT0006`), while a use in the branch a `comptime if` does not take is
/// allowed. On a module's header it holds for all the module declares: one module per system.
pub struct When :: [OnTopLevel, OnModule] {
    pub cond: bool,
}

fn platformOf(code: int): Platform {
    return match (code) {
        1 => .Linux,
        2 => .MacOS,
        3 => .Windows,
        _ => .Other,
    };
}

fn archOf(code: int): Arch {
    return match (code) {
        1 => .X86_64,
        2 => .Aarch64,
        _ => .Other,
    };
}

// What the build is for and as: compile time answers them, nothing at run time asks.
fn buildOs(): int;
fn buildArch(): int;
fn buildPointerWidth(): int;
fn buildDebug(): bool;

/// Marks a field that a synthesized `clone()` copies as it stands instead of cloning it.
///
/// For what both copies share: a parent, a service, a cycle.
pub struct Shared :: [OnField] { }

/// Lets an interface's defaults see every field of the conformer, whatever its visibility.
///
/// The defaults over `fields<Self>()`, `variants<Self>()` and `members<Self>()` ask with the
/// module of the conformer they are instantiated for. [Equatable], [Ordered], [TotalOrder],
/// [Hashable], [VariantName], [Variants], [Clone] and std.codec's `Encode` and `Decode` carry
/// it. Without it a default sees what the interface's
/// module may name: another package's `pub` fields alone.
pub struct SeesConformer :: [OnInterface] { }

// ---------------------------------------------------------------------------------------------
// Type information while compiling. Declared here, not in std.meta: the synthesized members
// above are written over these questions, and std.core imports nothing. std.meta passes them on
// by name.

/// Who may name a declaration.
pub enum Visibility :: [Equatable, Debug] {
    Pub,
    Internal,
    Private,
}

/// The kind of a type, for decisions while compiling: `comptime if (f.type.kind == .Optional)`.
///
/// A struct, a class, an enum, an interface; `Primitive` for the built-in scalars and `string`;
/// `Opaque` for an opaque alias; the shapes `?T`, `T[]`, `T[N]`, a view, a tuple, a function; a
/// type parameter in a generic body; `Other` for what none of these names.
pub enum TypeKind :: [Equatable, Debug] {
    Primitive,
    Struct,
    Class,
    Enum,
    Interface,
    Opaque,
    Optional,
    Array,
    InlineArray,
    Slice,
    Tuple,
    Function,
    Parameter,
    Other,
}

/// A type as a value while compiling: its name, as [typeName] gives it, and its kind.
pub struct Type :: [Equatable, Debug] {
    pub name: string,
    pub kind: TypeKind,
}

/// Describes a field of a struct or a class, in declaration order.
///
/// In a `comptime for` over it, `f.type` names its type and `e.[f]` is the field. `hasDefault`
/// is whether the declaration writes an initializer (the type's own default does not count,
/// and a payload's field has none), so a loop tells an optional argument from a required one.
pub struct FieldInfo :: [Equatable, Debug] {
    pub name: string,
    pub type: Type,
    pub index: int,
    pub visibility: Visibility,
    pub isVar: bool,
    pub hasDefault: bool,
}

/// Describes a variant of an enum, in declaration order, and the fields of its payload.
///
/// A positional field is named by its position, `0`, `1`, ….
pub struct VariantInfo :: [Equatable, Debug] {
    pub name: string,
    pub index: int,
    pub payload: FieldInfo[],
}

/// The kind of a member of a type's own body: a function, a constant (a `static let`), an
/// associated type.
pub enum MemberKind :: [Equatable, Debug] {
    Function,
    Constant,
    AssociatedType,
}

/// Describes a parameter of a function, in declaration order.
///
/// Its name, its type, its place, and whether its declaration writes a default; in a
/// `comptime for` over it, `parameterAttribute<A>(p)` reads what it carries.
pub struct ParameterInfo :: [Equatable, Debug] {
    pub name: string,
    pub type: Type,
    pub index: int,
    pub hasDefault: bool,
}

/// Describes a member of a type's own body.
///
/// Its name, its visibility, whether it is static, whether it is `mut`, its kind, and a
/// function's parameters; none for a constant or an associated type, both of which are static.
pub struct MemberInfo :: [Equatable, Debug] {
    pub name: string,
    pub visibility: Visibility,
    pub isStatic: bool,
    pub isMut: bool,
    pub kind: MemberKind,
    pub parameters: ParameterInfo[],
}

/// Returns the fields of a struct or a class that the asking code may name, in declaration
/// order; none for any other type.
pub fn fields<T>(): FieldInfo[];

/// Returns the functions, constants and associated types of a type's own body that the asking
/// code may name, in declaration order; members written in an `extend` block belong to that
/// block, not to the body.
pub fn members<T>(): MemberInfo[];

/// Returns the value of the attribute `A` the field `f` carries, or `null` where it carries none.
///
/// `f` is the variable of a `comptime for` over [fields] or over a variant's `payload`, read in
/// its iteration.
pub fn attribute<A>(f: FieldInfo): ?A;

/// Returns the value of the attribute `A` the variant `v` carries, or `null` where it carries
/// none.
///
/// `v` is the variable of a `comptime for` over [variants], read in its iteration.
pub fn variantAttribute<A>(v: VariantInfo): ?A;

/// Returns the value of the attribute `A` the member `m` carries, or `null` where it carries
/// none.
///
/// `m` is the variable of a `comptime for` over [members], read in its iteration.
pub fn memberAttribute<A>(m: MemberInfo): ?A;

/// Returns the value of the attribute `A` the parameter `p` carries, or `null` where it carries
/// none.
///
/// `p` is the variable of a `comptime for` over a member's `parameters`, read in its iteration.
pub fn parameterAttribute<A>(p: ParameterInfo): ?A;

/// Returns the value of the attribute `A` the declaration of `T` carries, or `null` where it
/// carries none.
///
/// A `T` written as an alias answers with the alias's own attributes, not its target's.
pub fn typeAttribute<T, A>(): ?A;

/// Returns the variants of an enum, in declaration order; none for any other type.
pub fn variants<E>(): VariantInfo[];

/// Returns the interfaces `T` conforms to, by its list, its blocks and the parents they bring.
pub fn conformances<T>(): Type[];

/// Returns whether `T` conforms to `I`.
pub fn hasConformance<T, I>(): bool;

/// Returns `T`'s name with its type arguments: `Pair<int, string>`.
pub fn typeName<T>(): string;

pub fn isStruct<T>(): bool;
pub fn isClass<T>(): bool;
pub fn isEnum<T>(): bool;
pub fn isInterface<T>(): bool;
