/// What the language itself binds without an import (std.core, design/v5/spec/10 U-series; spec
/// chapter 12): the core interfaces, the number tower, the iterator protocol and the members of the
/// built-in types.
//
// In this order (M9a S11c): 0 the preamble - panic, assert, Error, Result, Box, the ranges, arrayOf;
// 1 the attributes and the compiler's instructions; 2 the operator interfaces and the language's
// own - Equatable, Ordered, Hashable, Identity, Variants, Index, Display; 3 the scalars' conformances;
// 4 Debug, Clone, Default, From/Into, char and Unicode; 5 the numbers; 6 parsing; 7 strings, views,
// bytes to text, f-strings; 8 the format language; 9 iteration - the protocol, the ranges,
// collecting, membership (the adapters are std.iter's); 10 arrays, views and slices - their members,
// sorting, equality and display; 11 optionals and tuples; 12 the build's target and profile;
// 13 type information while compiling.


/// Ends the process with a message and a backtrace, exit 101 (05 E8): `LYR-RT0008`. Its type is
/// `never`, so a call stands wherever a value is wanted and ends the path it is on.
pub fn panic(message: string): never;

/// Ends the process unless `condition` holds (05 E8): `LYR-RT0011`, "assertion failed: " and
/// the condition as it is written, then the message where one is given. The check stands at the
/// call, set in place; the message is a lambda, `assert(n > 2) { f"n = {n}" }`, built only when
/// the assertion fails (10 "Review 2026-10-12" D1; M9a S12b) - Kotlin's form.
pub inline fn assert(condition: bool, message: fn() -> string = () => "", @callerExpr(condition) written: string = ""): void {
    if (!condition) {
        assertFailed(written, message());
    }
}

/// The panic of a failed assertion (05 E8): `LYR-RT0011`, the word, the condition, the message.
fn assertFailed(written: string, message: string): never;

/// A branch the program never takes (05 E8, E12): taking it ends the process, `LYR-RT0012`,
/// "unreachable" and `message` behind it where one is given.
pub fn unreachable(message: string = ""): never;

/// A place still to be written (10 prelude): reaching it ends the process, `LYR-RT0013`,
/// "not implemented" and `message` behind it where one is given.
pub fn todo(message: string = ""): never;

/// The bytes of a file of the package, read while the program compiles (design/v5/spec/09 Q4):
/// `path` relative to the module that calls, within the package's directory — the one thing code
/// run at compile time reads from outside the program, and a build reads it again when it
/// changes. A `comptime` site, or what one calls, makes the call: `comptime embed("table.bin")`;
/// the program itself never does (`LYR-CT0004`).
pub fn embed(path: string): uint8[];

/// The empty interface (design/v5/spec/03 T10): every struct, class and enum value is an `Any`
/// at the transition, and `is` or a type pattern takes it out again (T11). `Any[]` is the
/// heterogeneous array. Nothing converts here unasked — the target has to say `Any`.
pub interface Any { }

/// A value behind a reference (design/v5/spec/02 M13): the indirection a value type needs to
/// hold itself. `enum Expr { Num(int), Add(Box<Expr>, Box<Expr>) }` is finite where `Add(Expr,
/// Expr)` is not. The box is shared, not copied; its value is fixed, so sharing is unobservable.
pub class Box<T> {
    pub value: T,
}

/// A box compares by its value (M10 S1): what it holds is what it is, as its `Debug` text says.
extend<T :: [Equatable]> Box<T> :: [Equatable] {
    fn equals(o: Box<T>): bool {
        return this.value == o.value;
    }
}

extend<T :: [Debug]> Box<T> :: [Debug] {
    /// The value, as it shows itself: the box is an indirection and no part of what is said.
    fn debug(): string {
        return this.value.debug();
    }
}

/// `a..b` (design/v5/spec/03 T13 A3): the values from `start` up to but not including `end`, a
/// value holding its bounds. In a `for` head a range literal is the counted loop and no value.
pub struct Range<T> {
    pub var start: T,
    pub var end: T,
}

/// `a..=b`: the values from `start` to `end`, both included.
pub struct RangeInclusive<T> {
    pub var start: T,
    pub var end: T,
}

/// `a..`: from `start` on. Written inside `[…]` only, where it takes a view (03 T13 A2).
pub struct RangeFrom<T> {
    pub start: T,
}

/// `..b`: up to but not including `end`. Written inside `[…]` only, where it takes a view.
pub struct RangeTo<T> {
    pub end: T,
}

/// `..`: everything. Written inside `[…]` only, where it takes a view of the whole.
pub struct RangeFull { }

/// `arrayOf(n, f)` (design/v5/spec/10 C7): an array of `n` elements, the element at `i` the value
/// of `f(i)` — fresh elements each, where `[x] * n` copies one value into every slot; `f` is
/// called in order, once per index. A negative `n` panics; what `f` throws, the call throws, the
/// array dropped.
pub fn arrayOf<T, E :: [Error]>(n: int, f: fn(int) -> T throws E): T[] throws E {
    if (n < 0) {
        panic("arrayOf: a negative length");
    }
    if (n == 0) {
        return [];
    }
    // One allocation, every slot the first value until its own is written. (Joined from the
    // blocks of the length's binary digits, as before, it allocated once per digit and copied
    // every element several times — the most of maps' cache misses, R9c.)
    let first = try f(0);
    let whole = filled(n, first);
    var i = 1;
    while (i < n) {
        whole[i] = try f(i);
        i = i + 1;
    }
    return whole;
}

/// `n` slots of the one value `x`, an object SHARED — the repetition's instruction without its
/// clone (M8a S16): the standard library's empty tables (`null` in every slot) and `arrayOf`, which
/// writes every slot after. Internal: a program's `[x] * n` clones an object (03 §5.1). A negative
/// `n` panics, as the repetition does.
internal fn filled<T>(n: int, x: T): T[];

/// `[x] * n` over an element that is or holds an object (03 §5.1, 10 C7): every slot a `clone()`
/// of the pattern's element, so no object is shared into several slots. The compiler desugars
/// the operator to this call; a value element copies natively. A negative `n` panics.
pub fn repeatArray<T :: [Clone]>(xs: T[], n: int): T[] {
    if (n < 0) { panic("negative repeat count"); }
    let m = xs.length();
    return arrayOf(m * n, (i: int) => xs[i % m].clone());
}

/// The root of everything thrown, caught and declared (design/v5/spec/05 E6 O1): a struct, a class
/// or an enum that conforms is throwable (E3), an enum the natural form —
/// `enum ParseError :: [Error] { Empty, BadDigit(char, int) }`. `cause` names the error this one
/// wraps, for a report that walks the chain; the wrapping is the type's own field (O2).
pub interface Error {
    fn message(): string;

    fn cause(): ?Error {
        return null;
    }
}

/// The ready-made `Error` for throwing a message (design/v5/spec/12 E06):
/// `throw Exception("…");`, and `Exception("…", cause: e)` for the error it wraps. The fields are
/// `text` and `inner`, not `message` and `cause`: `Error` requires the METHODS `message()` and
/// `cause()`, and one type's members cannot share a name.
pub class Exception :: [Error] {
    /// What `message()` returns.
    pub text: string,
    /// The error this one wraps, if any: what `cause()` returns.
    pub inner: ?Error = null,

    /// `Exception("…")`, `Exception("…", cause: e)` (08 Y9).
    pub static fn new(message: string, cause: ?Error = null): Exception {
        return Exception { text = message, inner = cause };
    }

    pub fn message(): string {
        return this.text;
    }

    pub fn cause(): ?Error {
        return this.inner;
    }
}

/// Where an error was thrown (design/v5/spec/05 E6 O3, the review's M5-3): what a clause's
/// `e.backtrace()` answers in the debug profile, which keeps the frames of every throw; the
/// release profile keeps none. Shown, it is a panic's trace — `    at <function> (<file>:<line>)`,
/// a line a frame, innermost first —, named only when it is shown.
pub struct Backtrace :: [Display] {
    pcs: int[],

    pub fn show(): string {
        return traceText(this.pcs);
    }
}

/// The frames at `pcs` in a panic's trace form.
fn traceText(pcs: int[]): string;

/// `e.backtrace()` at a clause's binding (06 §4): the lowering reads the program counters the
/// record kept, none where it kept none, and asks here.
fn backtraceOf(pcs: int[]): ?Backtrace {
    if (pcs.length() == 0) {
        return null;
    }
    return Backtrace { pcs = pcs };
}

/// A failure as a value (05 E1; 10 B3): `Ok` with the value or `Err` with the error, to keep,
/// collect or decide on later. `throws` stays the mechanism, and the two bridges lead to it and
/// back — `Result.of { try f() }` catches into one, `try r.get()` throws out of one —, with no
/// operator of its own. `E` is an `Error`, as Swift's `Result` has it: `get()` throws it.
@MustUse
pub enum Result<T, E :: [Error]> {
    Ok(T),
    Err(E),
}

extend<T, E :: [Error]> Result<T, E> {
    /// What `f` returns, as `Ok`; what it throws, as `Err`.
    pub static fn of(f: fn() -> T throws E): Result<T, E> {
        try {
            return .Ok(f());
        } catch (e) {
            return .Err(e);
        }
    }

    /// An `Ok`'s value; an `Err`'s error, thrown.
    pub fn get(): T throws E {
        return match (this) {
            .Ok(v) => v,
            .Err(e) => throw e,
        };
    }
}

// ---------------------------------------------------------------------------------------------
// Attributes (design/v5/spec/09 A1–A3, A11; spec chapter 11 §1). An attribute is a struct that
// says where it may sit — one of the markers below —, and a use writes its fields, each a value
// computed while the program compiles: `@Test { timeout = LIMIT }`. The compiler reads the ones
// of the closed list by their identity — `std.core.Test`, not any `Test` (A3).
//
// A marker names one kind of declaration, or a set of them (F1); an attribute names the
// narrowest that fits. The markers inherit nothing from each other: which declarations each
// admits is the compiler's table, in spec chapter 11 §1.
// ---------------------------------------------------------------------------------------------

/// Where an attribute may sit: anywhere one stands.
pub interface OnAny { }

/// On a named declaration: a function, a method, a type, an interface, an alias, a field, a
/// variant, a parameter, a module-level binding, a `static let`, an associated type.
pub interface OnDecl { }

/// On a declaration at a module's top level: a function, a type, an interface, an alias, an
/// `extend`, a module-level binding.
pub interface OnTopLevel { }

/// On a struct, a class, an enum, an interface or an alias.
pub interface OnTypeLike { }

/// On a member: a method, a field, a `static let`, a variant, an associated type.
pub interface OnMember { }

/// On a function or a method.
pub interface OnCallable { }

/// At a module's head.
pub interface OnModule { }

/// On a struct, a class or an enum.
pub interface OnType { }

/// On a function at a module's top level.
pub interface OnFunction { }

/// On a method.
pub interface OnMethod { }

/// On a field.
pub interface OnField { }

/// On a parameter.
pub interface OnParameter { }

/// On an enum's variant.
pub interface OnVariant { }

/// On an interface.
pub interface OnInterface { }

/// On a type alias.
pub interface OnAlias { }

/// On an `extend` block.
pub interface OnExtend { }

/// A test (10 B12 X2, 07 V4): `lyric test` runs every function marked so — no parameters, `void`,
/// not private, throwing if it likes —, each in a task of its own. `skip` says why one is not run,
/// `timeout` how many seconds it may take: one that outlives them ends the run (X3). The tests run
/// one after another; `parallel` lets one run beside the others that say so, after the rest (X3:
/// an opt-in, since what a test shares — the working directory, the environment, a global `var` —
/// it shares as threads do).
pub struct Test :: [OnFunction] {
    pub skip: string = "",
    pub timeout: int = 60,
    pub parallel: bool = false,
}

/// A benchmark (10 B12 X4): `lyric bench` runs every function marked so — `fn name(&b: Bench)`,
/// not private —, one after another. The bench it is handed is its measure: `b.iter { … }` runs the
/// block until its time a run is known, `b.bytes(n)` says how many bytes a run handles; what it
/// measured is the bench's after the call.
pub struct Bench :: [OnFunction] {
    /// The runs of the round reported, the nanoseconds they took, and the allocations they made
    /// on this thread and their bytes.
    pub var runs: int = 0,
    pub var nanos: int = 0,
    pub var allocations: int = 0,
    pub var allocatedBytes: int = 0,
    /// The bytes a run handles, as `bytes(n)` said; 0 where it said nothing.
    pub var bytesPerRun: int = 0,

    /// Runs `body` until its time a run is known (X4): once to warm up, then rounds of ever more
    /// runs until one takes a tenth of a second, then five rounds of that many — the bench reports
    /// the round of the median time. The loop's call of `body` is in the time; `blackBox` keeps a
    /// result the compiler would otherwise drop.
    pub mut fn iter(body: fn() -> void): void {
        body();
        var n = 1;
        var took = timedRound(body, n).0;
        while (took < 100000000) {
            // as many runs as a tenth of a second at this pace, a fifth more, at most a hundred times more
            let pace = if (took > 0) ((n as float) * 120000000.0 / (took as float)) as int else n * 100;
            n = if (pace > n * 100) n * 100 else if (pace <= n) n + 1 else pace;
            took = timedRound(body, n).0;
        }
        let rounds = arrayOf(5, (_: int) => timedRound(body, n));
        let times = arrayOf(5, (i: int) => rounds[i].0);
        times.sort();
        for (r in rounds) {
            if (r.0 == times[2]) {
                this.runs = n;
                this.nanos = r.0;
                this.allocations = r.1;
                this.allocatedBytes = r.2;
                return;
            }
        }
    }

    /// A run handles `n` bytes: the report gives the bytes a second.
    pub mut fn bytes(n: int): void {
        this.bytesPerRun = n;
    }

    /// The nanoseconds a run took, in the round reported.
    pub fn nanosPerRun(): float {
        return if (this.runs > 0) (this.nanos as float) / (this.runs as float) else 0.0;
    }
}

/// `n` runs of `body`: the nanoseconds they took, the allocations they made on this thread, and
/// their bytes.
fn timedRound(body: fn() -> void, n: int): (int, int, int) {
    let allocations = threadAllocations();
    let bytes = threadAllocatedBytes();
    let start = benchClock();
    for (_ in 0..n) {
        body();
    }
    let took = benchClock() - start;
    return (took, threadAllocations() - allocations, threadAllocatedBytes() - bytes);
}

/// The monotonic clock, in nanoseconds (lyr/time.h).
fn benchClock(): int;

/// The allocations this thread has made since it started, and their bytes (lyr/gc.h).
fn threadAllocations(): int;
fn threadAllocatedBytes(): int;

/// `x`, handed back through a point the compiler cannot see through (10 X4): what computed it is
/// not dropped as unused, and the value that comes out is not known in advance — for a benchmark's
/// body, whose result nothing reads. It costs a store.
pub fn blackBox<T>(x: T): T {
    return x;
}

/// `@callerExpr(p)` on a `string` parameter with a default (09 A11): where a call leaves the
/// parameter out, it gets the text the call wrote for `p` — `assertEq(xs.length(), 3)` hands
/// `std.test` the words `xs.length()`. Named like the compiler instruction it is, not like a type.
pub struct callerExpr :: [OnParameter] { }

/// `@callerLine` on an `int` parameter with a default (09 A11): where a call leaves the parameter
/// out, it gets the line the call begins on.
pub struct callerLine :: [OnParameter] { }

/// `@callerFile` on a `string` parameter with a default (09 A11): where a call leaves the
/// parameter out, it gets the file the call stands in, as the binary's backtrace names it — the
/// package's name, then the path within the package (`app/src/main.lyr`), with forward slashes.
pub struct callerFile :: [OnParameter] { }

/// A declaration on its way out (09 A11): every use outside a deprecated declaration warns
/// (`LYR-SEM0076`) with `message`; `until` names the release that removes it — a build of that
/// toolchain version or later fails at the attribute (`LYR-SEM0081`) —; `replacement` is what the
/// use should become, for the tools. On whatever a use names: a module, what stands at its top
/// level — an `extend` block for its members —, a member; not a parameter.
pub struct Deprecated :: [OnModule, OnTopLevel, OnMember] {
    pub message: string = "",
    pub until: string = "",
    pub replacement: string = "",
}

/// A hint to the C compiler (09 A11): inline the function wherever it is called. A hint, no
/// promise — and not the word `inline`, whose function is spliced into its caller by the language.
pub struct AlwaysInline :: [OnCallable] { }

/// A hint to the C compiler (09 A11): keep the function a call; the compiler's own inliner keeps
/// it one too.
pub struct NoInline :: [OnCallable] { }

/// A hint to the C compiler (09 A11): the function is rarely called — a path of errors, say.
pub struct Cold :: [OnCallable] { }

/// A value nobody should drop (09 A11): a call of a function marked so, or a call whose value is
/// of a type marked so, warns where it stands as a statement and its value goes nowhere.
pub struct MustUse :: [OnCallable, OnType] { }

/// An enum or a `sealed` interface that may grow (09 A11): a `match` over it outside its package
/// needs a `_` arm, so a new variant or conformer breaks nobody there.
pub struct NonExhaustive :: [OnType, OnInterface] { }

/// A warning not reported (09 A10): `@Allow("LYR-SEM0071")` on a declaration, or the module's
/// head, silences that code inside it; an `@Allow` that silences nothing warns itself. The
/// manifest's `[lints] allow` silences codes for the whole package.
pub struct Allow :: [OnAny] {
    pub code: string,
}

/// What a `using let` binding closes when its scope is left (design/v5/spec/05 E7 R1, 10 K1).
/// `close()` may throw: on a normal exit the error leaves like any other, while one is in flight
/// it is appended to it as suppressed.
pub interface Closeable {
    fn close(): void throws Error;
}

// ---------------------------------------------------------------------------------------------
// The operator interfaces (design/v5/spec/04 D6). 'a + b' is exactly 'a.add(b)': the conformance
// is chosen by the static type of 'b', the result is the conformer's 'Out' — 'Self' unless it
// says otherwise. The built-in scalars conform below, through the operators the compiler binds
// itself; a generic 'fn sum<T :: [Add<Out = T>]>' reaches them the same way.
// ---------------------------------------------------------------------------------------------

/// `a + b` is `a.add(b)` (04 D6).
pub interface Add<Rhs = Self> {
    type Out = Self;
    fn add(rhs: Rhs): Self.Out;
}

/// `a - b` is `a.sub(b)` (04 D6).
pub interface Sub<Rhs = Self> {
    type Out = Self;
    fn sub(rhs: Rhs): Self.Out;
}

/// `a * b` is `a.mul(b)` (04 D6).
pub interface Mul<Rhs = Self> {
    type Out = Self;
    fn mul(rhs: Rhs): Self.Out;
}

/// `a / b` is `a.div(b)` (04 D6).
pub interface Div<Rhs = Self> {
    type Out = Self;
    fn div(rhs: Rhs): Self.Out;
}

/// `a % b` is `a.rem(b)` (04 D6).
pub interface Rem<Rhs = Self> {
    type Out = Self;
    fn rem(rhs: Rhs): Self.Out;
}

/// `-x` is `x.neg()`.
pub interface Neg {
    type Out = Self;
    fn neg(): Self.Out;
}

/// `a & b` is `a.bitAnd(b)`.
pub interface BitAnd<Rhs = Self> {
    type Out = Self;
    fn bitAnd(rhs: Rhs): Self.Out;
}

/// `a | b` is `a.bitOr(b)`.
pub interface BitOr<Rhs = Self> {
    type Out = Self;
    fn bitOr(rhs: Rhs): Self.Out;
}

/// `a ^ b` is `a.bitXor(b)`.
pub interface BitXor<Rhs = Self> {
    type Out = Self;
    fn bitXor(rhs: Rhs): Self.Out;
}

/// `~x` is `x.bitNot()`.
pub interface BitNot {
    type Out = Self;
    fn bitNot(): Self.Out;
}

/// `a << b` is `a.shl(b)`; the count is an `int` unless the conformer says otherwise.
pub interface Shl<Rhs = int> {
    type Out = Self;
    fn shl(rhs: Rhs): Self.Out;
}

/// `a >> b` is `a.shr(b)`; the count is an `int` unless the conformer says otherwise.
pub interface Shr<Rhs = int> {
    type Out = Self;
    fn shr(rhs: Rhs): Self.Out;
}

/// `a == b` is `a.equals(b)`, `!=` its negation (04 D6). Both sides are the conformer's own
/// type: there is no heterogeneous equality.
pub interface Equatable {
    /// Synthesized for a conformance without the member (05 §14; 09 A5): field by field in
    /// declaration order; an enum the same variant with equal payloads.
    fn equals(o: Self): bool {
        comptime if (isEnum<Self>()) {
            comptime for (v in variants<Self>()) {
                if (this is v) {
                    if (!(o is v)) {
                        return false;
                    }
                    comptime for (p in v.payload) {
                        if (!(this.[v, p] == o.[v, p])) {
                            return false;
                        }
                    }
                    return true;
                }
            }
            return false;
        } else {
            comptime for (f in fields<Self>()) {
                if (!(this.[f] == o.[f])) {
                    return false;
                }
            }
            return true;
        }
    }
}

/// The answer of a comparison; equatable, hashable and printable like any plain enum (the
/// review's M8a-10).
pub enum Ordering :: [Equatable, Hashable, Debug] { Less, Equal, Greater }

/// `a < b`, `<=`, `>`, `>=` read `a.compare(b)` (04 D6): `.Less` for `<`, and `null` where the
/// two are not ordered — `float` is partial, NaN compares with nothing — in which case every one
/// of the four is false.
pub interface Ordered :: [Equatable] {
    /// Synthesized (05 §14): lexicographic over the fields, the first that is not `.Equal`
    /// decides, and a field unordered — `null` — is the answer; an enum by the variant's position
    /// first, then its payload.
    fn compare(o: Self): ?Ordering {
        comptime if (isEnum<Self>()) {
            // the two positions first (one test per variant each), the payload only where they meet
            var a = 0;
            var b = 0;
            comptime for (v in variants<Self>()) {
                if (this is v) {
                    a = v.index;
                }
                if (o is v) {
                    b = v.index;
                }
            }
            if (a < b) {
                return Ordering.Less;
            }
            if (a > b) {
                return Ordering.Greater;
            }
            comptime for (v in variants<Self>()) {
                if (this is v) {
                    comptime for (p in v.payload) {
                        let c = this.[v, p].compare(o.[v, p]);
                        if (c == null) {
                            return null;
                        }
                        match (c) { .Equal => { }, _ => { return c; } }
                    }
                    return Ordering.Equal;
                }
            }
            return Ordering.Equal;
        } else {
            comptime for (f in fields<Self>()) {
                let c = this.[f].compare(o.[f]);
                if (c == null) {
                    return null;
                }
                match (c) { .Equal => { }, _ => { return c; } }
            }
            return Ordering.Equal;
        }
    }

    /// This held to `lo`…`hi` (10 B5 Z2): `lo` below it, `hi` above it. `lo` above `hi` is the
    /// program's error and panics; a value unordered with the bounds — a NaN — comes back as it is.
    fn clamp(lo: Self, hi: Self): Self {
        if (hi < lo) {
            panic("clamp: lo is above hi");
        }
        if (this < lo) {
            return lo;
        }
        if (this > hi) {
            return hi;
        }
        return this;
    }
}

/// A total order, what sorting and keys need; `float` has none of its own (D6).
pub interface TotalOrder :: [Ordered] {
    /// Synthesized as `compare` is, every field total.
    fn totalCompare(o: Self): Ordering {
        comptime if (isEnum<Self>()) {
            var a = 0;
            var b = 0;
            comptime for (v in variants<Self>()) {
                if (this is v) {
                    a = v.index;
                }
                if (o is v) {
                    b = v.index;
                }
            }
            if (a < b) {
                return Ordering.Less;
            }
            if (a > b) {
                return Ordering.Greater;
            }
            comptime for (v in variants<Self>()) {
                if (this is v) {
                    comptime for (p in v.payload) {
                        let c = this.[v, p].totalCompare(o.[v, p]);
                        match (c) { .Equal => { }, _ => { return c; } }
                    }
                    return Ordering.Equal;
                }
            }
            return Ordering.Equal;
        } else {
            comptime for (f in fields<Self>()) {
                let c = this.[f].totalCompare(o.[f]);
                match (c) { .Equal => { }, _ => { return c; } }
            }
            return Ordering.Equal;
        }
    }
}

/// What a hash is computed with (design 10 Q3, K2): a value's parts are written in, the hash is
/// read out. The hashers are `std.hash`'s.
pub interface Hasher {
    /// One byte.
    mut fn writeByte(b: uint8): void;

    /// The bytes, in order.
    mut fn write(bytes: Slice<uint8>): void {
        var i = 0;
        while (i < bytes.length()) {
            this.writeByte(bytes[i]);
            i = i + 1;
        }
    }

    /// The eight bytes of `v`, the lowest first.
    mut fn writeUint(v: uint64): void {
        var i = 0;
        while (i < 8) {
            this.writeByte((v >> ((8 * i) as uint64)) as uint8);
            i = i + 1;
        }
    }

    /// The eight bytes of `v` in two's complement, the lowest first.
    mut fn writeInt(v: int): void {
        this.writeUint(v as uint64);
    }

    /// What the bytes written so far hash to; more may be written after.
    fn finish(): uint64;
}

/// What a `Map` key and a `Set` element need (10 K2): the value's parts written into a hasher, in an
/// order of the type's. Equal values write the same; nothing checks it.
pub interface Hashable :: [Equatable] {
    /// Synthesized (05 §14; 10 K2): the fields into the hasher in declaration order; an enum its
    /// variant's position, then the payload.
    fn hash<H :: [Hasher]>(&h: H): void {
        comptime if (isEnum<Self>()) {
            comptime for (v in variants<Self>()) {
                if (this is v) {
                    h.writeInt(v.index);
                    comptime for (p in v.payload) {
                        this.[v, p].hash(&h);
                    }
                }
            }
        } else {
            comptime for (f in fields<Self>()) {
                this.[f].hash(&h);
            }
        }
    }
}

/// An object compared by itself and hashed by where it lives (02 M10, 04 D7): `class Node ::
/// [Identity]` is given an `equals` that is `same(this, o)` and a `hash` of its address, so a
/// `Map<Node, X>` keys by the object without a member written. A class's alone — a value has no
/// identity. Nothing on the heap moves (01 L1), so an object keeps its address while it lives.
pub interface Identity :: [Hashable] {
}

/// The name of the variant an enum value holds, as written (09 A7 R5; M9a S11):
/// `Color.Red.name()` is `"Red"`. A default over the variants, for any enum.
pub interface VariantName {
    /// The variant's name.
    fn name(): string {
        comptime for (v in variants<Self>()) {
            if (this is v) {
                return v.name;
            }
        }
        return unreachable("an enum value holds one of its variants");
    }
}

/// An enum's variants as values (09 A7 R5; M9a S11; Swift's `CaseIterable`): all of them in
/// declaration order, and one by its name. For an enum whose variants all are units — a variant
/// with a payload has no value without it, and such an enum is refused at its entry.
pub interface Variants :: [VariantName] {
    /// Every variant, in declaration order. (Named `all`, not `variants`: inside the default the
    /// latter is the question `variants<Self>()` itself.)
    static fn all(): Self[] {
        let all = variants<Self>();
        var out: Self[] = [];
        comptime for (v in variants<Self>()) {
            comptime if (v.index == 0) {
                out = [Self.[v]] * all.length();
            }
            out[v.index] = Self.[v];
        }
        return out;
    }

    /// The variant of that name, or `null`.
    static fn fromName(s: string): ?Self {
        comptime for (v in variants<Self>()) {
            if (s == v.name) {
                return Self.[v];
            }
        }
        return null;
    }
}

/// `x[k]` is `x.index(k)` (04 D6, 03 T14): the element a key or a position names, of the type the
/// conformer answers. An array's and a view's index is built in.
pub interface Index<K> {
    type Output;
    fn index(k: K): Self.Output;
}

/// `x[k] = v` is `x.setIndex(k, v)`; `x[k] += 1` reads and writes, `x` and `k` evaluated once.
pub interface IndexSet<K> :: [Index<K>] {
    mut fn setIndex(k: K, v: Self.Output): void;
}

/// `x[a..b]` on a type that gives a view of its elements is the range of the view —
/// `list[a..b]` is `list.asSlice()[a..b]`, a `Slice<T>` over them, no copy (03 §5.2, design 03
/// "Review 2026-10-09" S6; M8c S18). A second `Index` for ranges beside `Index<int>` would be two
/// `index` of one arity (04 D4); an array's, a view's and a string's range are built in.
pub interface AsSlice<T> {
    fn asSlice(): Slice<T>;
}

/// `x in xs` is `xs.contains(x)` (04 D6; the operator comes with the collections).
pub interface Contains<T> {
    fn contains(x: T): bool;
}

/// `{x}` in an f-string renders through `show()` (04 D6); the scalars render natively and conform
/// here so a constraint `T :: [Display]` takes them.
pub interface Display {
    fn show(): string;

    /// The text written into `out` (10 S6): what f-strings and the containers call, so a text is
    /// built in one buffer. The default appends `show()`; a type that can write itself does.
    fn showTo(out: StringBuilder): void {
        out.appendStr(this.show());
    }
}

// --- the scalars ------------------------------------------------------------------------------
extend int :: [Equatable, Ordered, TotalOrder, Hashable, Display, Add, Sub, Mul, Div, Rem, Neg, BitAnd, BitOr, BitXor, BitNot, Shl, Shr] {
    fn equals(o: int): bool { return this == o; }
    fn compare(o: int): ?Ordering {
        if (this < o) { return Ordering.Less; }
        if (this > o) { return Ordering.Greater; }
        return Ordering.Equal;
    }
    fn totalCompare(o: int): Ordering {
        if (this < o) { return Ordering.Less; }
        if (this > o) { return Ordering.Greater; }
        return Ordering.Equal;
    }
    fn hash<H :: [Hasher]>(&h: H): void { h.writeInt(this as int); }
    fn show(): string { return f"{this}"; }
    fn showTo(out: StringBuilder): void { out.putInt(this); }
    fn add(rhs: int): int { return this + rhs; }
    fn sub(rhs: int): int { return this - rhs; }
    fn mul(rhs: int): int { return this * rhs; }
    fn div(rhs: int): int { return this / rhs; }
    fn rem(rhs: int): int { return this % rhs; }
    fn neg(): int { return -this; }
    fn bitAnd(rhs: int): int { return this & rhs; }
    fn bitOr(rhs: int): int { return this | rhs; }
    fn bitXor(rhs: int): int { return this ^ rhs; }
    fn bitNot(): int { return ~this; }
    fn shl(rhs: int): int { return this << rhs; }
    fn shr(rhs: int): int { return this >> rhs; }
}

