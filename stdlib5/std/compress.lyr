//! Compresses and decompresses DEFLATE (RFC 1951), zlib (RFC 1950) and gzip (RFC 1952), written
//! entirely in Lyric.
//!
//! Decoding reads stored, fixed and dynamic blocks through a 32 KiB window; encoding writes them
//! at the levels 0 to 9 — 0 stored, 1 the fixed tables over a greedy LZ77, 2 and up dynamic
//! tables, 4 and up with lazy matching, the chains longer with the level. The streams are
//! `DeflateReader<R>`/`DeflateWriter<W>` raw, `ZlibReader`/`ZlibWriter` with the zlib header and
//! Adler-32, `GzipReader`/`GzipWriter` with the gzip header and CRC-32 (members in a row read as
//! one). `Gzip`, `Zlib` and `Deflate` compress and decompress bytes held in memory. Corrupt input
//! is reported as `IoError { kind = .InvalidData }` carrying a `CompressError`.
//!
//! # Examples
//!
//! ```lyric
//! import std.io { println, IoError };
//! import std.compress { Gzip, CompressError };
//!
//! fn main(): void throws [CompressError, IoError] {
//!     let line = "to be or not to be, that is the question; ";
//!     let text = [line, line, line, line, line, line, line, line].iter().join("");
//!     let packed = try Gzip.compress(text.toBytes());
//!     println(packed.length() < text.length());
//!     let back = try Gzip.decompress(packed);
//!     println(back.length() == text.length());
//! }
//! ```
//!
//! ```output
//! true
//! true
//! ```
import std.collections { List };
import std.core { Closeable };
import std.hash { adler32, crc32 };
import std.io { Reader, Writer, IoError, ByteBuffer };
import std.task { Cancelled };

/// The error for bytes that are not the format, a checksum or a length that does not hold, or a
/// compression level outside 0 to 9. Decoders throw it inside an `IoError`; the constructors and
/// `compress` functions throw it directly.
pub struct CompressError :: [Error] {
    pub detail: string,

    pub fn message(): string {
        return this.detail;
    }
}

fn corrupt(detail: string): IoError {
    return IoError {
        kind = .InvalidData,
        path = null,
        detail = detail,
        inner = CompressError { detail = detail },
    };
}

