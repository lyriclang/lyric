//! Provides the elementary functions and the mathematical constants.
//!
//! The functions are free and generic over the numeric types: [min], [max], [gcd], [lcm],
//! [abs], [signum], and for floating-point types rounding, roots, powers, logarithms and the
//! trigonometric and hyperbolic functions. The constants [pi], [e] and [tau] are typed `float`;
//! `math.pi as float32` gives the narrow width. What describes a number type itself stands at
//! that type: `float.epsilon`, `int.max`, `x.isNan()`.
//!
//! The floating-point functions compute in `float` and round a `float32` result once, at the
//! end; they give the same bits on every tier-1 target.
//!
//! # Examples
//!
//! ```lyric
//! import std.io { println };
//! import std.math;
//!
//! println(math.sqrt(2.0));
//! println(math.hypot(3.0, 4.0));
//! println(math.gcd(84, 36));
//! println(math.max(7, 3));
//! ```
//!
//! ```output
//! 1.4142135623730951
//! 5.0
//! 12
//! 7
//! ```
import std.core { Signed, asTypeOf };

/// π, a half turn in radians.
pub let pi: float = 3.141592653589793;

/// *e*, the base of the natural logarithm.
pub let e: float = 2.718281828459045;

/// τ = 2π, a full turn in radians.
pub let tau: float = 6.283185307179586;

/// Returns the lesser of `a` and `b`.
///
/// Returns `a` when the two are equal, and when they are unordered (a NaN).
pub fn min<T :: [Ordered]>(a: T, b: T): T {
    return if (b < a) b else a;
}

/// Returns the greater of `a` and `b`.
///
/// Returns `a` when the two are equal, and when they are unordered (a NaN).
pub fn max<T :: [Ordered]>(a: T, b: T): T {
    return if (b > a) b else a;
}

/// Returns the greatest common divisor of `a` and `b`, never negative.
///
/// `gcd(0, 0)` is `0`.
///
/// # Panics
///
/// When the divisor's magnitude does not fit the type: a signed type's `min` has none, so
/// `gcd(int.min, 0)` overflows, as [abs] does.
pub fn gcd<T :: [Integer]>(a: T, b: T): T {
    var x = a;
    var y = b;
    while (y != T.zero) {
        let r = x.wrappingRem(y);
        x = y;
        y = r;
    }
    return if (x < T.zero) T.zero - x else x;
}

/// Returns the least common multiple of `a` and `b`, never negative.
///
/// Returns `0` when either is `0`.
///
/// # Panics
///
/// When the multiple, or its magnitude, does not fit the type.
pub fn lcm<T :: [Integer]>(a: T, b: T): T {
    if (a == T.zero || b == T.zero) {
        return T.zero;
    }
    let m = (a / gcd(a, b)) * b;
    return if (m < T.zero) T.zero - m else m;
}

/// Returns the value the fraction `t` of the way from `a` to `b`.
///
/// The result is exactly `a` at `t = 0` and exactly `b` at `t = 1`; a `t` outside 0…1
/// extrapolates beyond the two.
pub fn lerp<T :: [Float]>(a: T, b: T, t: T): T {
    if (t + t < T.one) {
        return a + (b - a) * t;
    }
    return b - (b - a) * (T.one - t);
}

// The elementary functions: computed in `float` by C's libm, a `float32` rounded once, at the
// end.
/// Returns the greatest integral value not above `x`.
pub fn floor<T :: [Float]>(x: T): T {
    return asTypeOf(libmFloor(asTypeOf(x, 0.0)), x);
}

/// Returns the least integral value not below `x`.
pub fn ceil<T :: [Float]>(x: T): T {
    return asTypeOf(libmCeil(asTypeOf(x, 0.0)), x);
}

/// Returns the integral value nearest to `x`, rounding halves away from zero.
pub fn round<T :: [Float]>(x: T): T {
    return asTypeOf(libmRound(asTypeOf(x, 0.0)), x);
}

/// Returns the integral part of `x`, rounding toward zero.
pub fn trunc<T :: [Float]>(x: T): T {
    return asTypeOf(libmTrunc(asTypeOf(x, 0.0)), x);
}

/// Returns the square root of `x`; NaN below zero.
pub fn sqrt<T :: [Float]>(x: T): T {
    return asTypeOf(libmSqrt(asTypeOf(x, 0.0)), x);
}

/// Returns the cube root of `x`.
pub fn cbrt<T :: [Float]>(x: T): T {
    return asTypeOf(libmCbrt(asTypeOf(x, 0.0)), x);
}

/// Returns *e* to the power `x`.
pub fn exp<T :: [Float]>(x: T): T {
    return asTypeOf(libmExp(asTypeOf(x, 0.0)), x);
}

/// Returns the natural logarithm of `x`; NaN below zero, negative infinity at zero.
pub fn ln<T :: [Float]>(x: T): T {
    return asTypeOf(libmLn(asTypeOf(x, 0.0)), x);
}

/// Returns the logarithm of `x` to base 2.
pub fn log2<T :: [Float]>(x: T): T {
    return asTypeOf(libmLog2(asTypeOf(x, 0.0)), x);
}

/// Returns the logarithm of `x` to base 10.
pub fn log10<T :: [Float]>(x: T): T {
    return asTypeOf(libmLog10(asTypeOf(x, 0.0)), x);
}

/// Returns the sine of `x`, in radians.
pub fn sin<T :: [Float]>(x: T): T {
    return asTypeOf(libmSin(asTypeOf(x, 0.0)), x);
}

/// Returns the cosine of `x`, in radians.
pub fn cos<T :: [Float]>(x: T): T {
    return asTypeOf(libmCos(asTypeOf(x, 0.0)), x);
}

/// Returns the tangent of `x`, in radians.
pub fn tan<T :: [Float]>(x: T): T {
    return asTypeOf(libmTan(asTypeOf(x, 0.0)), x);
}

/// Returns the arcsine of `x`, in radians.
pub fn asin<T :: [Float]>(x: T): T {
    return asTypeOf(libmAsin(asTypeOf(x, 0.0)), x);
}

/// Returns the arccosine of `x`, in radians.
pub fn acos<T :: [Float]>(x: T): T {
    return asTypeOf(libmAcos(asTypeOf(x, 0.0)), x);
}

/// Returns the arctangent of `x`, in radians.
pub fn atan<T :: [Float]>(x: T): T {
    return asTypeOf(libmAtan(asTypeOf(x, 0.0)), x);
}

/// Returns the hyperbolic sine of `x`.
pub fn sinh<T :: [Float]>(x: T): T {
    return asTypeOf(libmSinh(asTypeOf(x, 0.0)), x);
}

/// Returns the hyperbolic cosine of `x`.
pub fn cosh<T :: [Float]>(x: T): T {
    return asTypeOf(libmCosh(asTypeOf(x, 0.0)), x);
}

/// Returns the hyperbolic tangent of `x`.
pub fn tanh<T :: [Float]>(x: T): T {
    return asTypeOf(libmTanh(asTypeOf(x, 0.0)), x);
}

/// Returns the angle of the point (x, y) from the positive x axis, in radians from -π to π.
pub fn atan2<T :: [Float]>(y: T, x: T): T {
    return asTypeOf(libmAtan2(asTypeOf(y, 0.0), asTypeOf(x, 0.0)), x);
}

/// Returns the length of the hypotenuse of a right triangle with legs `x` and `y`.
///
/// Unlike `sqrt(x * x + y * y)`, it does not overflow in the intermediate squares.
pub fn hypot<T :: [Float]>(x: T, y: T): T {
    return asTypeOf(libmHypot(asTypeOf(x, 0.0), asTypeOf(y, 0.0)), x);
}

/// Returns `x` to the power `e`.
///
/// For an integer power of an integer, use the integer's own `x.pow(n)`.
pub fn pow<T :: [Float]>(x: T, e: T): T {
    return asTypeOf(libmPow(asTypeOf(x, 0.0), asTypeOf(e, 0.0)), x);
}

/// Returns the magnitude of `x`, the value without its sign.
///
/// A float's `-0.0` gives `0.0`.
///
/// # Panics
///
/// For a signed integer type's `min`, whose magnitude the type cannot hold.
pub fn abs<T :: [Signed]>(x: T): T {
    if (x < T.zero) {
        return -x;
    }
    return if (x == T.zero) T.zero else x;
}

/// Returns the sign of `x`: `-1`, `0` or `1` as a value of its type.
///
/// A float's NaN gives NaN.
pub fn signum<T :: [Signed]>(x: T): T {
    if (!(x == x)) {
        return x;
    }
    if (x < T.zero) {
        return -T.one;
    }
    if (x > T.zero) {
        return T.one;
    }
    return T.zero;
}

// libm's functions, in double.
// The ones every libm computes exactly stay the system's; the rest are musl's, carried by the
// runtime under its prefix (runtime/third_party/musl-math), so a program
// computes the same bits on every tier-1 target and `comptime` the same bits as the program.
extern "C" fn libmFloor(x: float): float = "floor";
extern "C" fn libmCeil(x: float): float = "ceil";
extern "C" fn libmRound(x: float): float = "round";
extern "C" fn libmTrunc(x: float): float = "trunc";
extern "C" fn libmSqrt(x: float): float = "sqrt";
extern "C" fn libmCbrt(x: float): float = "lyr_cbrt";
extern "C" fn libmExp(x: float): float = "lyr_exp";
extern "C" fn libmLn(x: float): float = "lyr_log";
extern "C" fn libmLog2(x: float): float = "lyr_log2";
extern "C" fn libmLog10(x: float): float = "lyr_log10";
extern "C" fn libmSin(x: float): float = "lyr_sin";
extern "C" fn libmCos(x: float): float = "lyr_cos";
extern "C" fn libmTan(x: float): float = "lyr_tan";
extern "C" fn libmAsin(x: float): float = "lyr_asin";
extern "C" fn libmAcos(x: float): float = "lyr_acos";
extern "C" fn libmAtan(x: float): float = "lyr_atan";
extern "C" fn libmSinh(x: float): float = "lyr_sinh";
extern "C" fn libmCosh(x: float): float = "lyr_cosh";
extern "C" fn libmTanh(x: float): float = "lyr_tanh";
extern "C" fn libmAtan2(y: float, x: float): float = "lyr_atan2";
extern "C" fn libmHypot(x: float, y: float): float = "lyr_hypot";
extern "C" fn libmPow(x: float, e: float): float = "lyr_pow";
