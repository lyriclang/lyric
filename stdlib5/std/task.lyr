/// Tasks and their scheduler (design/v5/spec/06 N4, N6, N8, N9; 10 Q10). M6 S3-S6: a scheduler for
/// each thread that runs tasks, written here over the runtime's park and poller (06 N6 S1); `main`
/// as a task (T6); `spawn` and its `Task` with its states, `TaskScope`, `spawnDetached`, `sleep`,
/// `yieldNow`; cancellation and `withTimeout` (N9); a panic that ends a task, not the process (T4);
/// channels, `Select` and `Timer` (N5 K1-K3), within a thread and across threads; threads (G1,
/// G2); `Mutex`, `RwLock` and `Once` (G4, K6) — `std.sync`'s by the module cut (10 Q10), here until
/// M7 lets another module reach the scheduler.
module std.task;

import std.sync { Atomic };
import std.time { Duration };

/// What a suspended `yield` throws when `close()` unwinds its coroutine (06 A5), and what a wait
/// throws in a cancelled task (06 N9 X1): an `Error`, so cleanup can catch it — though a coroutine
/// that catches it may not yield again, and a task that waits again gets it again (X5).
pub class Cancelled :: [Error] {
    fn message(): string { return "cancelled"; }
}

/// Parks the running task until `d` has passed, at least (06 K3), while the other tasks of its
/// thread run. A sleep of zero or less lets the tasks that are ready run first. A wait: in a
/// cancelled task it throws `Cancelled` (06 N9 X1), and a cancel ends it early.
pub fn sleep(d: Duration): void throws Cancelled {
    try here().sleep(d.nanos());
}

/// Lets the other ready tasks of the thread run first (06 N8): the running task goes behind them.
/// A wait, so a point where a cancelled task throws `Cancelled` (06 N9 X2).
pub fn yieldNow(): void throws Cancelled {
    try here().yieldNow();
}

/// What a panic in a task left (06 T3-T4, 05 E8): its code, its message, and the frames where it
/// happened, as the report writes them.
pub class PanicInfo {
    code: string,
    message: string,
    trace: string,
}

/// Where a task stands (06 T3): still running; ended with its value, with an error, with
/// `Cancelled`; or ended by a panic.
pub enum TaskStatus<T> {
    Running,
    Done(T),
    Failed(Error),
    Cancelled,
    Panicked(PanicInfo),
}

/// A task's handle (06 T1-T3), which `spawn` gives: the body's result once it ended, or the error
/// it ended with. Its type carries that error — `Task<T> throws E`, as a coroutine's carries what
/// its pulls throw (05 E10) — and `await()` throws it.
pub class Task<T> {
    var done: bool = false,
    var value: ?T = null,
    var failure: ?Error = null,
    /// What a panic of the body left (06 T4).
    var crash: ?PanicInfo = null,
    /// The context the body runs in, until it ends.
    var context: ?Context = null,
    /// The tasks parked in `await()` until the body ends, in the order they came.
    waiters: Waiters = Waiters { },
    /// Guards `done`, `context` and the waiters: a task is awaited and cancelled from any thread,
    /// not only its own (06 G1). Its end publishes what the body left (N7 P1).
    guard: SpinLock = SpinLock { },

    /// Whether the body has ended, with its value, with an error, or by a panic (06 T3).
    pub fn isDone(): bool {
        this.guard.acquire();
        let done = this.done;
        this.guard.release();
        return done;
    }

    /// Where the task stands (06 T3) — asked without waiting, and without panicking where the task
    /// did (T4: the supervisor's look).
    pub fn status(): TaskStatus<T> {
        if (!this.isDone()) {
            return TaskStatus.Running;
        }
        if (let p = this.crash) {
            return TaskStatus.Panicked(p);
        }
        if (let e = this.failure) {
            if (e is Cancelled) {
                return TaskStatus.Cancelled;
            }
            return TaskStatus.Failed(e);
        }
        return TaskStatus.Done(this.value!);
    }

    /// The body's value once it has ended, or its error, thrown here (06 T2): the running task
    /// waits until then. A wait, so it throws `Cancelled` in a cancelled task (06 N9 X1); what it
    /// throws is read off the handle's type at the call (10 §2), the declared `Error` stands for it.
    pub mut fn await(): T throws Error {
        let me = here().running ?? panic("an await where no task runs");
        if (me.cancelled.load()) { throw Cancelled { }; }
        this.guard.acquire();
        while (!this.done) {
            me.beginWait();
            this.waiters.add(me);
            this.guard.release();
            here().wakeIfCancelled(me);
            park();
            me.endWait();
            this.guard.acquire();
            this.waiters.remove(me);
            if (me.cancelled.load()) {
                this.guard.release();
                throw Cancelled { };
            }
        }
        this.guard.release();
        if (let p = this.crash) {
            repanic(p.code, p.message, p.trace);
        }
        if (let e = this.failure) {
            throw e;
        }
        return this.value!;
    }

    /// Cancels the task (06 N9 X1): its next wait throws `Cancelled` — at once, where it waits now
    /// — and so does every wait after it (X5). A task that has ended stays as it ended.
    pub fn cancel(): void {
        this.guard.acquire();
        let context = this.context;
        this.guard.release();
        if (let c = context) {
            here().cancel(c);
        }
    }

    /// Cancels the task and waits until it has ended, whatever the running task's mark says: what a
    /// task does before it lets go of one it started (06 T5).
    mut fn settle(): void {
        this.cancel();
        let me = here().running ?? panic("a wait where no task runs");
        this.guard.acquire();
        while (!this.done) {
            me.beginWait();
            this.waiters.add(me);
            this.guard.release();
            park();
            me.endWait();
            this.guard.acquire();
            this.waiters.remove(me);
        }
        this.guard.release();
    }

    /// The body ended by a panic (06 T4): the task is Panicked, and what it left waits for `await`.
    mut fn panicked(info: PanicInfo): void {
        this.crash = info;
        this.finish();
    }

    /// The body has ended: its scope learns of it, and the tasks waiting for it are ready, in the
    /// order they came.
    mut fn finish(): void {
        if (let c = this.context) {
            if (let scope = c.scope) {
                scope.ended(c, this.failure, this.crash);
            }
        }
        let s = here();
        this.guard.acquire();
        this.done = true;
        this.context = null;
        this.waiters.wakeAll(s);
        this.guard.release();
    }
}

/// Starts `body` as a task of the running thread and gives its handle (06 T1): the task runs once
/// the tasks ready before it had their turn, and `await()` on the handle gives its value or throws
/// its error — `E`, what the body throws, the handle's type carries.
pub fn spawn<T, E :: [Error]>(body: fn() -> T throws E): (Task<T> throws E) {
    return launch(body);
}

/// What `withTimeout` throws when its time ran out before the body ended (06 N9 X4).
pub class TimedOut :: [Error] {
    fn message(): string { return "timed out"; }
}

/// Runs `body` as a task of its own and gives what it gives — unless `d` passes first: then the
/// body is cancelled, and `TimedOut` is thrown once it has ended (06 N9 X4: a scope, a timer and a
/// cancel). The body's own errors come out as they are. A cancel of the caller cancels the body
/// too; whenever this returns, the body has ended.
pub fn withTimeout<T, E :: [Error]>(d: Duration, body: fn() -> T throws E): T throws [E, TimedOut, Cancelled] {
    var late = false;
    let work = spawn(body);
    let timer = spawn(() => {
        try sleep(d);
        late = true;
        work.cancel();
    });
    defer timer.cancel();
    defer work.settle();
    try {
        return try work.await();
    } catch (e: Cancelled) {
        if (late) {
            throw TimedOut { };
        }
        throw e;
    }
}

/// What `send` throws on a closed channel (06 K1).
pub class ChannelClosed :: [Error] {
    fn message(): string { return "channel closed"; }
}

/// A channel (06 N5 K1): values go in with `send` and come out with `recv`, in the order they went
/// in. Unbuffered — a capacity of 0 — a send waits until a receiver takes the value; buffered, it
/// waits only while the buffer is full. `close()` ends it: what is buffered can still be received,
/// then `recv` answers null; a send throws `ChannelClosed`. Within a thread and across threads: a
/// send happens before the receive that gets its value (N7 P1).
///
/// The guard holds while the channel's state changes, and never while anything waits or a body runs.
/// The locks of this module are taken in one order — channels by their ids, then a task's guard or
/// a scheduler's inbox — so no two threads wait on each other's.
pub class Channel<T> {
    capacity: int,
    /// Its place in the order of channel locks (a select takes several).
    id: int,
    guard: SpinLock,
    var buffered: int = 0,
    var first: ?Item<T> = null,
    var last: ?Item<T> = null,
    var closed: bool = false,
    /// The tasks waiting to send, each with its value, and those waiting to receive.
    senders: WaitQueue<T>,
    receivers: WaitQueue<T>,

    /// A channel that holds up to `capacity` values no task has received yet; 0 — the default —
    /// holds none: a send meets a receive.
    pub static fn new(capacity: int = 0): Channel<T> {
        return Channel<T> {
            capacity = if (capacity > 0) capacity else 0,
            id = channelIds.addAndFetch(1),
            guard = SpinLock { },
            senders = WaitQueue<T> { },
            receivers = WaitQueue<T> { },
        };
    }

    /// Puts `value` into the channel (06 K1): to a task waiting to receive, into the buffer while
    /// there is room — else the running task waits until a receiver takes it. On a closed channel,
    /// and when the channel closes while it waits, it throws `ChannelClosed`. A wait: a cancelled
    /// task throws `Cancelled` (N9 X1).
    pub mut fn send(value: T): void throws [ChannelClosed, Cancelled] {
        let s = here();
        let me = s.running ?? panic("a send where no task runs");
        if (me.cancelled.load()) { throw Cancelled { }; }
        this.guard.acquire();
        if (this.closed) {
            this.guard.release();
            throw ChannelClosed { };
        }
        while (let r = this.receivers.take()) {
            if (r.context.claim()) {
                r.value = value;
                r.settled = true;
                this.guard.release();
                s.post(r.context);
                return;
            }
        }
        if (this.buffered < this.capacity) {
            this.push(value);
            this.guard.release();
            return;
        }
        let w = Waiting<T> { context = me, value = value };
        me.beginWait();
        this.senders.add(w);
        this.guard.release();
        s.wakeIfCancelled(me);
        park();
        me.endWait();
        this.guard.acquire();
        this.senders.remove(w);
        let settled = w.settled;
        this.guard.release();
        if (settled) { return; }
        if (me.cancelled.load()) { throw Cancelled { }; }
        throw ChannelClosed { };
    }

    /// The next value of the channel (06 K1): from the buffer, or from a task waiting to send —
    /// else the running task waits for one. Null once the channel is closed and empty. A wait: a
    /// cancelled task throws `Cancelled` (N9 X1).
    pub mut fn recv(): ?T throws Cancelled {
        let s = here();
        let me = s.running ?? panic("a receive where no task runs");
        if (me.cancelled.load()) { throw Cancelled { }; }
        this.guard.acquire();
        if (let item = this.takeNow(s)) {
            this.guard.release();
            return item.value;
        }
        if (this.closed) {
            this.guard.release();
            return null;
        }
        let w = Waiting<T> { context = me };
        me.beginWait();
        this.receivers.add(w);
        this.guard.release();
        s.wakeIfCancelled(me);
        park();
        me.endWait();
        this.guard.acquire();
        this.receivers.remove(w);
        let settled = w.settled;
        let value = w.value;
        this.guard.release();
        if (settled) { return value; }
        if (me.cancelled.load()) { throw Cancelled { }; }
        return null;
    }

    /// Closes the channel (06 K1): the tasks waiting to receive get null, those waiting to send throw
    /// `ChannelClosed`; what is buffered can still be received. Closing a closed channel does nothing.
    pub mut fn close(): void {
        let s = here();
        this.guard.acquire();
        if (this.closed) {
            this.guard.release();
            return;
        }
        this.closed = true;
        while (let r = this.receivers.take()) {
            s.wakeUp(r.context);
        }
        while (let w = this.senders.take()) {
            s.wakeUp(w.context);
        }
        this.guard.release();
    }

    /// A value at once, taken out — from the buffer, which a task waiting to send then refills, or
    /// from such a task itself; null where a receive would wait, or find the channel closed and
    /// empty. It never waits. A waiting sender that another waker ended meanwhile is passed over.
    /// Under the guard.
    mut fn takeNow(s: Scheduler): ?Item<T> {
        if (let item = this.first) {
            this.first = item.next;
            if (item.next == null) { this.last = null; }
            this.buffered -= 1;
            while (let w = this.senders.take()) {
                if (w.context.claim()) {
                    this.push(w.value!);
                    w.settled = true;
                    s.post(w.context);
                    break;
                }
            }
            return item;
        }
        while (let w = this.senders.take()) {
            if (w.context.claim()) {
                w.settled = true;
                s.post(w.context);
                return Item<T> { value = w.value! };
            }
        }
        return null;
    }

    mut fn push(value: T): void {
        let item = Item<T> { value = value };
        if (let tail = this.last) {
            tail.next = item;
        } else {
            this.first = item;
        }
        this.last = item;
        this.buffered += 1;
    }
}

/// A buffered value of a channel.
class Item<T> {
    value: T,
    var next: ?Item<T> = null,
}

/// A task waiting on a channel: to send `value`, or to receive one into it. `settled` once the value
/// went over; `queued` while it is in the channel's queue.
class Waiting<T> {
    context: Context,
    var value: ?T = null,
    var settled: bool = false,
    var queued: bool = false,
    var next: ?Waiting<T> = null,
    var prev: ?Waiting<T> = null,
}

/// The tasks waiting on one side of a channel, in the order they came. A waker takes the first out;
/// a task whose wait something else ended takes itself out once it runs again.
class WaitQueue<T> {
    var first: ?Waiting<T> = null,
    var last: ?Waiting<T> = null,

    mut fn add(w: Waiting<T>): void {
        w.prev = this.last;
        w.next = null;
        if (let tail = this.last) {
            tail.next = w;
        } else {
            this.first = w;
        }
        this.last = w;
        w.queued = true;
    }

    /// Takes `w` out of the queue — nothing where it is not in it.
    mut fn remove(w: Waiting<T>): void {
        if (!w.queued) { return; }
        w.queued = false;
        if (let p = w.prev) {
            p.next = w.next;
        } else {
            this.first = w.next;
        }
        if (let n = w.next) {
            n.prev = w.prev;
        } else {
            this.last = w.prev;
        }
        w.prev = null;
        w.next = null;
    }

    /// The first task waiting, taken out — or null.
    mut fn take(): ?Waiting<T> {
        let w = this.first;
        if (w == null) { return null; }
        this.remove(w);
        return w;
    }
}

/// The way into a select (06 N5 K2): `Select.on(a) { … }.on(b) { … }.timeout(d) { … }.run()` waits
/// on the channels `a` and `b` at once and runs the case of the first to have a value — or the
/// timeout's, when `d` passed first.
pub class Select {
    /// A select with its first case: a receive from `c` (see `Selection.on`).
    pub static fn on<T>(c: Channel<T>, body: fn(?T) -> void throws Error): Selection {
        let s = Selection { };
        return s.on(c, body);
    }
}

/// A select as it is built (06 K2): its cases, in the order they were added, and a timeout (K3).
pub class Selection {
    var first: ?CaseNode = null,
    var last: ?CaseNode = null,
    /// The guards of its channels, each once, in the order of the channels' ids: a select looks at
    /// all of them in one step. Made at the first run after a case was added.
    var guards: ?GuardNode = null,
    /// The timeout's nanoseconds — 0 for at once, -1 for none.
    var timeoutNanos: int = -1,
    var onTimeout: ?fn() -> void throws Error = null,

    /// A case: a receive from `c`. Its body gets what `recv()` would give — the value, or null once
    /// `c` is closed and empty.
    pub mut fn on<T>(c: Channel<T>, body: fn(?T) -> void throws Error): Selection {
        let node = CaseNode { entry = Case<T> { channel = c, body = body } };
        if (let tail = this.last) {
            tail.next = node;
        } else {
            this.first = node;
        }
        this.last = node;
        this.guards = null;
        return this;
    }

    /// The timeout (06 K3): `body` runs when no case could go on before `d` passed — with `d` of
    /// zero or less, when none can at once.
    pub mut fn timeout(d: Duration, body: fn() -> void throws Error): Selection {
        this.timeoutNanos = if (d.nanos() > 0) d.nanos() else 0;
        this.onTimeout = body;
        return this;
    }

    /// Runs the select (06 K2): the first case, in the order they were added, whose channel has a
    /// value or is closed runs at once. Else the running task waits on all of them, and the first
    /// channel to get a value or to close runs its case — or the timeout's body runs, once its time
    /// came first. One body runs, and only its case receives. A wait: in a cancelled task it throws
    /// `Cancelled` (06 N9 X1), and a cancel ends it. What the body throws comes out here.
    pub mut fn run(): void throws Error {
        let s = here();
        let me = s.running ?? panic("a select where no task runs");
        if (me.cancelled.load()) { throw Cancelled { }; }
        if (this.guards == null) {
            this.guards = this.orderGuards();
        }
        this.lockAll();
        if (let ready = this.takeReady(s)) {
            this.unlockAll();
            try ready.entry.finish();
            return;
        }
        if (this.timeoutNanos == 0) {
            this.unlockAll();
            try this.timedOut();
            return;
        }
        me.beginWait();
        var at = this.first;
        while (let n = at) {
            n.entry.enlist(me);
            at = n.next;
        }
        this.unlockAll();
        if (this.timeoutNanos > 0) {
            s.fallAsleep(me, this.timeoutNanos);
        }
        s.wakeIfCancelled(me);
        park();
        me.endWait();
        s.unsleep(me);
        // What woke it: a value for one case; else a cancel; else a channel that closed or now has
        // a value — or the timer.
        this.lockAll();
        var chosen: ?CaseNode = null;
        at = this.first;
        while (let n = at) {
            n.entry.withdraw();
            if (chosen == null && n.entry.settled()) {
                chosen = n;
            }
            at = n.next;
        }
        if (chosen == null && !me.cancelled.load()) {
            chosen = this.takeReady(s);
        }
        this.unlockAll();
        if (let n = chosen) {
            try n.entry.finish();
            return;
        }
        if (me.cancelled.load()) { throw Cancelled { }; }
        try this.timedOut();
    }

    /// The first case, in the order they were added, that can go on at once — what it receives
    /// taken already; null where none can. Under the guards.
    mut fn takeReady(s: Scheduler): ?CaseNode {
        var at = this.first;
        while (let n = at) {
            if (n.entry.takeReady(s)) {
                return n;
            }
            at = n.next;
        }
        return null;
    }

    /// The guards of the channels, each once, sorted by the channels' ids.
    fn orderGuards(): ?GuardNode {
        var sorted: ?GuardNode = null;
        var at = this.first;
        while (let n = at) {
            let id = n.entry.channelId();
            var before: ?GuardNode = null;
            var after = sorted;
            while (let g = after) {
                if (g.id >= id) { break; }
                before = g;
                after = g.next;
            }
            var known = false;
            if (let g = after) {
                known = g.id == id;
            }
            if (!known) {
                let node = GuardNode { id = id, guard = n.entry.channelGuard(), next = after };
                if (let b = before) {
                    b.next = node;
                } else {
                    sorted = node;
                }
            }
            at = n.next;
        }
        return sorted;
    }

    fn lockAll(): void {
        var at = this.guards;
        while (let g = at) {
            g.guard.acquire();
            at = g.next;
        }
    }

    fn unlockAll(): void {
        var at = this.guards;
        while (let g = at) {
            g.guard.release();
            at = g.next;
        }
    }

    fn timedOut(): void throws Error {
        if (let t = this.onTimeout) {
            try t();
        }
    }
}

/// A case of a select, in the select's list.
class CaseNode {
    entry: SelectCase,
    var next: ?CaseNode = null,
}

/// A channel's guard in a select's list of them, sorted by the channel's id.
class GuardNode {
    id: int,
    guard: SpinLock,
    var next: ?GuardNode = null,
}

/// One case of a select, whatever the element type of its channel: a receive from that channel.
interface SelectCase {
    /// The channel's place in the order of locks, and its guard.
    fn channelId(): int;
    fn channelGuard(): SpinLock;
    /// Where a receive would not wait — a value is there, or the channel is closed — receives at
    /// once and keeps what came for `finish()`: true then; false where it would wait. Under the
    /// channel's guard.
    mut fn takeReady(s: Scheduler): bool;
    /// `c` waits on the channel for a value, as one of the select's waits. Under the guard.
    mut fn enlist(c: Context): void;
    /// It waits there no more. Under the guard.
    mut fn withdraw(): void;
    /// A value came to it while it waited, which it keeps for `finish()`. Under the guard.
    mut fn settled(): bool;
    /// Runs the body with what the case received — the value, or null for a closed channel.
    fn finish(): void throws Error;
}

class Case<T> :: [SelectCase] {
    channel: Channel<T>,
    body: fn(?T) -> void throws Error,
    var waiting: ?Waiting<T> = null,
    /// What the case received, for its body.
    var received: ?T = null,

    fn channelId(): int {
        return this.channel.id;
    }

    fn channelGuard(): SpinLock {
        return this.channel.guard;
    }

    mut fn takeReady(s: Scheduler): bool {
        if (let item = this.channel.takeNow(s)) {
            this.received = item.value;
            return true;
        }
        if (this.channel.closed) {
            this.received = null;
            return true;
        }
        return false;
    }

    mut fn enlist(c: Context): void {
        let w = Waiting<T> { context = c };
        this.waiting = w;
        this.channel.receivers.add(w);
    }

    mut fn withdraw(): void {
        if (let w = this.waiting) {
            this.channel.receivers.remove(w);
        }
    }

    mut fn settled(): bool {
        if (let w = this.waiting) {
            if (w.settled) {
                this.received = w.value;
                return true;
            }
        }
        return false;
    }

    fn finish(): void throws Error {
        let f = this.body;
        try f(this.received);
    }
}

/// Timers (06 K3).
pub class Timer {
    /// A channel that fires once, when `d` has passed (06 K3): then it closes, so a receive from it
    /// answers null and a select's case on it runs. A task of its own sleeps until then, which the
    /// program does not wait for (T6).
    pub static fn after(d: Duration): Channel<void> {
        let ch = Channel<void>.new();
        spawnDetached(() => {
            try sleep(d);
            ch.close();
        });
        return ch;
    }
}

/// A value that one task at a time holds (06 G4, K6): `lock` gives it to its body only, through a
/// guard — Rust's discipline, without its compiler. A task that finds it held waits, parked, while
/// the other tasks of its thread run; across threads, and on one thread wherever a body waits.
pub class Mutex<T> {
    slot: Slot<T>,
    state: LockState,

    /// A mutex that holds `value`.
    pub static fn new(value: T): Mutex<T> {
        return Mutex<T> { slot = Slot<T> { value = value }, state = LockState { } };
    }

    /// Runs `body` while the running task holds the mutex, and gives what it gives: the task waits
    /// until no other holds it. The body reaches the value through its guard, which works only
    /// until the body ends. A wait: in a cancelled task it throws `Cancelled` (N9 X1).
    pub fn lock<R, E :: [Error]>(body: fn(LockGuard<T>) -> R throws E): R throws [E, Cancelled] {
        try this.state.acquireAlone(false);
        let guard = LockGuard<T> { slot = this.slot };
        defer {
            guard.valid = false;
            this.state.releaseAlone();
        }
        return try body(guard);
    }
}

/// A value that readers share and a writer holds alone (06 K6). A writer that waits goes first:
/// readers that come after it wait for it.
pub class RwLock<T> {
    slot: Slot<T>,
    state: LockState,

    /// A lock that holds `value`.
    pub static fn new(value: T): RwLock<T> {
        return RwLock<T> { slot = Slot<T> { value = value }, state = LockState { } };
    }

    /// Runs `body` with the value while no writer holds the lock — other readers may — and gives
    /// what it gives. A wait: in a cancelled task it throws `Cancelled`.
    pub fn read<R, E :: [Error]>(body: fn(T) -> R throws E): R throws [E, Cancelled] {
        try this.state.acquireShared();
        defer this.state.releaseShared();
        return try body(this.slot.value);
    }

    /// Runs `body` while the running task alone holds the lock — no reader, no other writer — and
    /// gives what it gives; the body reaches the value through its guard. A wait, as `read` is.
    pub fn write<R, E :: [Error]>(body: fn(LockGuard<T>) -> R throws E): R throws [E, Cancelled] {
        try this.state.acquireAlone(true);
        let guard = LockGuard<T> { slot = this.slot };
        defer {
            guard.valid = false;
            this.state.releaseAlone();
        }
        return try body(guard);
    }
}

/// Work done once (06 N10): the first `run` does it, every later one returns at once, and one that
/// comes while it runs waits until it has ended.
pub class Once {
    state: LockState,

    /// Work not done yet.
    pub static fn new(): Once {
        return Once { state = LockState { } };
    }

    /// Runs `body` where it has not run to its end yet — and not where another task runs it now:
    /// then it waits for that one. Where `body` throws, the error comes out here, and the next `run`
    /// runs it again. A wait: in a cancelled task it throws `Cancelled`.
    pub fn run<E :: [Error]>(body: fn() -> void throws E): void throws [E, Cancelled] {
        let first = try this.state.beginOnce();
        if (!first) { return; }
        var done = false;
        defer {
            this.state.endOnce(done);
        }
        try body();
        done = true;
    }
}

/// The value a lock gives its body (06 G4): `get()` reads it, `set(v)` replaces it — while the body
/// runs; after, both panic.
pub class LockGuard<T> {
    slot: Slot<T>,
    var valid: bool = true,

    /// The value.
    pub fn get(): T {
        if (!this.valid) { panic("a lock's guard used after its body ended"); }
        return this.slot.value;
    }

    /// Replaces the value.
    pub fn set(value: T): void {
        if (!this.valid) { panic("a lock's guard used after its body ended"); }
        this.slot.value = value;
    }
}

/// A lock's value, where its guard reaches it.
class Slot<T> {
    var value: T,
}

/// What a lock knows of its holders — a mutex's, a reader-writer lock's, a once's — behind a spin
/// lock: whether one holds it alone, how many share it, how many writers wait, whether the work of
/// a once is done; and the tasks that wait, each of which every change wakes to look again.
class LockState {
    guard: SpinLock = SpinLock { },
    var alone: bool = false,
    var readers: int = 0,
    var writersWaiting: int = 0,
    var done: bool = false,
    waiters: Waiters = Waiters { },

    /// The running task holds the lock alone, once no other holds it at all; a writer (`counting`)
    /// counts itself as waiting the while, which holds back readers that come after it.
    mut fn acquireAlone(counting: bool): void throws Cancelled {
        let s = here();
        let me = s.running ?? panic("a lock where no task runs");
        if (me.cancelled.load()) { throw Cancelled { }; }
        this.guard.acquire();
        if (counting) { this.writersWaiting += 1; }
        while (this.alone || this.readers > 0) {
            if (!this.awaitChange(s, me)) {
                if (counting) {
                    this.writersWaiting -= 1;
                    this.waiters.wakeAll(s);
                }
                this.guard.release();
                throw Cancelled { };
            }
        }
        if (counting) { this.writersWaiting -= 1; }
        this.alone = true;
        this.guard.release();
    }

    /// The running task shares the lock, once nobody holds it alone and no writer waits.
    mut fn acquireShared(): void throws Cancelled {
        let s = here();
        let me = s.running ?? panic("a lock where no task runs");
        if (me.cancelled.load()) { throw Cancelled { }; }
        this.guard.acquire();
        while (this.alone || this.writersWaiting > 0) {
            if (!this.awaitChange(s, me)) {
                this.guard.release();
                throw Cancelled { };
            }
        }
        this.readers += 1;
        this.guard.release();
    }

    mut fn releaseAlone(): void {
        let s = here();
        this.guard.acquire();
        this.alone = false;
        this.waiters.wakeAll(s);
        this.guard.release();
    }

    mut fn releaseShared(): void {
        let s = here();
        this.guard.acquire();
        this.readers -= 1;
        if (this.readers == 0) {
            this.waiters.wakeAll(s);
        }
        this.guard.release();
    }

    /// A once's start: true for the task that does the work now, false where it is done — one that
    /// comes while another does it waits.
    mut fn beginOnce(): bool throws Cancelled {
        let s = here();
        let me = s.running ?? panic("a once where no task runs");
        if (me.cancelled.load()) { throw Cancelled { }; }
        this.guard.acquire();
        while (this.alone) {
            if (!this.awaitChange(s, me)) {
                this.guard.release();
                throw Cancelled { };
            }
        }
        let first = !this.done;
        if (first) { this.alone = true; }
        this.guard.release();
        return first;
    }

    mut fn endOnce(done: bool): void {
        let s = here();
        this.guard.acquire();
        this.alone = false;
        this.done = done;
        this.waiters.wakeAll(s);
        this.guard.release();
    }

    /// One wait for a change, the guard held before and after: false where the task was cancelled.
    mut fn awaitChange(s: Scheduler, me: Context): bool {
        me.beginWait();
        this.waiters.add(me);
        this.guard.release();
        s.wakeIfCancelled(me);
        park();
        me.endWait();
        this.guard.acquire();
        this.waiters.remove(me);
        return !me.cancelled.load();
    }
}

/// The tasks a scope starts end before it does (06 T5): structured concurrency. A scope is
/// `Closeable` — `using let scope = TaskScope.new();` — and its `close()` waits until every task it
/// started has ended. The first of them that fails cancels the others (N9 X3), and `close()`
/// throws that error once they have all ended; a task that ends with `Cancelled` is no failure of
/// the scope. A task that panics does the same, and `close()` panics again with it (T4). A task
/// waiting in `close()` that is cancelled cancels the scope's tasks and still waits for them.
pub class TaskScope :: [Closeable] {
    var firstChild: ?Context = null,
    var lastChild: ?Context = null,
    var open: int = 0,
    var failure: ?Error = null,
    var crash: ?PanicInfo = null,
    /// The task waiting in `close()`.
    closing: Waiters = Waiters { },

    /// A scope with no tasks yet.
    pub static fn new(): TaskScope {
        return TaskScope { };
    }

    /// `spawn` (06 T1), the task belonging to this scope: `close()` waits for it, and a failure of
    /// it cancels the other tasks of the scope.
    pub mut fn spawn<T, E :: [Error]>(body: fn() -> T throws E): (Task<T> throws E) {
        let task = launch(body);
        if (let c = task.context) {
            c.scope = this;
            c.prevChild = this.lastChild;
            c.nextChild = null;
            if (let tail = this.lastChild) {
                tail.nextChild = c;
            } else {
                this.firstChild = c;
            }
            this.lastChild = c;
            this.open += 1;
        }
        return task;
    }

    /// Cancels every task of the scope that has not ended (06 N9 X3).
    pub fn cancel(): void {
        let s = here();
        var at = this.firstChild;
        while (let c = at) {
            at = c.nextChild;
            s.cancel(c);
        }
    }

    /// Waits until every task of the scope has ended, then throws the first failure, if any (06 T5).
    pub fn close(): void throws Error {
        let s = here();
        let me = s.running ?? panic("a scope closed where no task runs");
        while (this.open > 0) {
            if (me.cancelled.load()) {
                this.cancel();
            }
            s.parkIn(this.closing);
        }
        if (let p = this.crash) {
            repanic(p.code, p.message, p.trace);
        }
        if (let e = this.failure) {
            throw e;
        }
    }

    /// A task of the scope ended, with `failure` or a panic or neither: the first failure —
    /// `Cancelled` is none — or panic cancels the others, and the last task to end wakes `close()`.
    mut fn ended(c: Context, failure: ?Error, crash: ?PanicInfo): void {
        if (let p = c.prevChild) {
            p.nextChild = c.nextChild;
        } else {
            this.firstChild = c.nextChild;
        }
        if (let n = c.nextChild) {
            n.prevChild = c.prevChild;
        } else {
            this.lastChild = c.prevChild;
        }
        c.prevChild = null;
        c.nextChild = null;
        c.scope = null;
        this.open -= 1;
        if (let p = crash) {
            if (this.crash == null && this.failure == null) {
                this.crash = p;
                this.cancel();
            }
        } else if (let e = failure) {
            if (this.crash == null && this.failure == null && !(e is Cancelled)) {
                this.failure = e;
                this.cancel();
            }
        }
        if (this.open == 0) {
            this.closing.wakeAll(here());
        }
    }
}

/// A task around `body`, ready to run, and its handle: what `spawn` and `TaskScope.spawn` share.
fn launch<T, E :: [Error]>(body: fn() -> T throws E): Task<T> {
    return launchOn(here(), body);
}

/// The same on the scheduler `s` — another thread's, for `Thread.spawn` (06 T1).
fn launchOn<T, E :: [Error]>(s: Scheduler, body: fn() -> T throws E): Task<T> {
    let task = Task<T> { };
    let run = () => {
        try {
            task.value = body();
        } catch (e) {
            task.failure = e;
        }
        task.finish();
    };
    let c = Context { body = startContext(run, 0), home = s };
    c.onPanic = (info: PanicInfo) => {
        task.panicked(info);
    };
    task.context = c;
    s.ready(c);
    return task;
}

/// Threads (06 G1, G2). Each runs a scheduler of its own, and a task never moves to another thread.
/// Threads run at the same time: what they share, they share through a channel, an atomic or a
/// lock (N7 P1) — anything else is a data race (G3).
pub class Thread {
    /// Starts a thread with a scheduler of its own (06 G2): `body` runs there as its first task,
    /// whose handle this gives — `await()` waits for its end from any thread, and what it did
    /// happens before (N7 P1). The thread ends with that task, as the program does with main (T6):
    /// the tasks still ready or asleep there then never run again.
    pub static fn spawn<T, E :: [Error]>(body: fn() -> T throws E): (Task<T> throws E) {
        let s = Scheduler { };
        let task = launchOn(s, body);
        startThread(() => {
            setCurrentScheduler(s);
            s.started();
            while (!task.isDone()) {
                s.step();
            }
            s.stopped();
            setCurrentScheduler(null);
        });
        return task;
    }
}

/// Starts `body` as a task of the running thread, with no handle (06 T5): it runs once the tasks
/// ready before it had their turn, and nobody waits for it — the program ends with `main`, done
/// or not (T6). Only a cancellation may end it early: it handles every other error itself.
pub fn spawnDetached(body: fn() -> void throws Cancelled): void {
    let run = () => {
        try {
            body();
        } catch (_: Cancelled) {
        }
    };
    let s = here();
    s.ready(Context { body = startContext(run, 0), home = s });
}

// ---------------------------------------------------------------------------------------------
// The scheduler (06 N6 S1, S6): one for each thread that runs tasks. It runs one task at a time
// until that task waits (N8) — the ready ones in the order they became ready, the sleepers once
// their deadline came, earliest first — and, with nothing ready, waits on the thread's poller
// until the earliest deadline.
// ---------------------------------------------------------------------------------------------

/// A task's context as the scheduler holds it: the coroutine its body runs in (13 §1.6), the
/// scheduler of its thread, which it never leaves (06 G1), and the links of the places it waits in
/// — the waiting list of a task or a scope, the sleepers' heap; a channel's queue holds a `Waiting`
/// of its own.
///
/// A wait (06 N8) begins before the context goes into any of its places and parks it. Whatever ends
/// the wait — a value, a close, its deadline, a cancel — first claims the context: of all that would,
/// one does, and readies it; the others leave it be. Running again, the context leaves the places it
/// still is in itself.
class Context {
    body: Coroutine<void>,
    home: Scheduler,
    /// The links of the ready queue.
    var next: ?Context = null,
    var prev: ?Context = null,
    /// 0 running or ready; 1 waiting — any waker may claim it —; 2 claimed. Atomic, for wakers on
    /// other threads.
    state: Atomic<int> = Atomic<int>.new(0),
    /// The links of the waiting list it is in, a task's or a scope's.
    var listed: bool = false,
    var listNext: ?Context = null,
    var listPrev: ?Context = null,
    /// In the sleepers' heap: its deadline on the monotonic clock, and when it fell asleep — the
    /// tie-break.
    var asleep: bool = false,
    var deadline: int = 0,
    var order: int = 0,
    /// The heap is leftist: the children, the parent — a sleeper leaves from where it is — and the
    /// length of the right spine.
    var left: ?Context = null,
    var right: ?Context = null,
    var up: ?Context = null,
    var rank: int = 0,
    /// Cancelled (06 N9 X1): every wait from here on throws `Cancelled`. Atomic: a cancel may come
    /// from another thread.
    cancelled: Atomic<bool> = Atomic<bool>.new(false),
    /// What becomes of a panic of it (06 T4): its handle's — a context without one, main's or a
    /// detached task's, ends the process with the panic.
    var onPanic: ?fn(PanicInfo) -> void = null,
    /// The scope its task belongs to (06 T5), and the links of that scope's list of tasks.
    var scope: ?TaskScope = null,
    var nextChild: ?Context = null,
    var prevChild: ?Context = null,

    /// A wait begins: from here a waker may claim it — before it goes into any place a waker looks.
    fn beginWait(): void {
        this.state.store(1);
    }

    /// A waker ends its wait: true for the first, which readies it; false for every other, and
    /// where it does not wait.
    fn claim(): bool {
        return this.state.compareAndSet(1, 2);
    }

    /// It runs again after a wait; the places it waited in it leaves next.
    fn endWait(): void {
        this.state.store(0);
    }
}

/// The tasks waiting for one task to end, or for a scope's tasks, in the order they came. A task
/// takes itself out once its wait ended.
class Waiters {
    var first: ?Context = null,
    var last: ?Context = null,

    mut fn add(c: Context): void {
        c.listPrev = this.last;
        c.listNext = null;
        if (let tail = this.last) {
            tail.listNext = c;
        } else {
            this.first = c;
        }
        this.last = c;
        c.listed = true;
    }

    /// Takes `c` out — nothing where it is not in.
    mut fn remove(c: Context): void {
        if (!c.listed) { return; }
        c.listed = false;
        if (let p = c.listPrev) {
            p.listNext = c.listNext;
        } else {
            this.first = c.listNext;
        }
        if (let n = c.listNext) {
            n.listPrev = c.listPrev;
        } else {
            this.last = c.listPrev;
        }
        c.listPrev = null;
        c.listNext = null;
    }

    /// Ends the wait of each, in the order they came.
    mut fn wakeAll(s: Scheduler): void {
        while (let c = this.first) {
            this.remove(c);
            s.wakeUp(c);
        }
    }
}

/// A lock for the short sections where threads meet — an inbox, a task's end: it spins while
/// another thread holds it, and guards nothing that waits.
class SpinLock {
    held: Atomic<bool> = Atomic<bool>.new(false),

    fn acquire(): void {
        while (!this.held.compareAndSet(false, true)) {
            spin();
        }
    }

    fn release(): void {
        this.held.store(false);
    }
}

class Scheduler {
    var first: ?Context = null,
    var last: ?Context = null,
    var sleepers: ?Context = null,
    var fallenAsleep: int = 0,
    var running: ?Context = null,
    /// The contexts of this thread that wakers on other threads readied (06 G1), which it moves to
    /// its ready queue at its next turn. The lock guards them and the poller a waker wakes: the
    /// thread's, as the runtime numbers it, from the thread's start to its end — 0 outside.
    inboxLock: SpinLock = SpinLock { },
    var inboxFirst: ?Context = null,
    var inboxLast: ?Context = null,
    var poller: int = 0,

    /// The thread begins to run this scheduler: from here a waker on another thread wakes it.
    mut fn started(): void {
        this.inboxLock.acquire();
        this.poller = currentPoller();
        this.inboxLock.release();
    }

    /// The thread ends: no waker wakes its poller from here on — it goes with the thread.
    mut fn stopped(): void {
        this.inboxLock.acquire();
        this.poller = 0;
        this.inboxLock.release();
    }

    /// `c` goes to the end of the ready queue.
    mut fn ready(c: Context): void {
        c.next = null;
        c.prev = null;
        if (let tail = this.last) {
            tail.next = c;
        } else {
            this.first = c;
        }
        this.last = c;
    }

    mut fn takeReady(): ?Context {
        let head = this.first;
        if (head == null) { return null; }
        this.first = head.next;
        if (head.next == null) { this.last = null; }
        head.next = null;
        return head;
    }

    mut fn sleep(nanos: int): void throws Cancelled {
        let c = this.running ?? panic("a sleep where no task runs");
        if (c.cancelled.load()) { throw Cancelled { }; }
        c.beginWait();
        this.fallAsleep(c, nanos);
        this.wakeIfCancelled(c);
        park();
        c.endWait();
        this.unsleep(c);
        if (c.cancelled.load()) { throw Cancelled { }; }
    }

    /// `c` goes into the sleepers' heap, to wake once `nanos` have passed.
    mut fn fallAsleep(c: Context, nanos: int): void {
        let now = monotonicNanos();
        c.deadline = if (nanos > 9223372036854775807 - now) 9223372036854775807 else now + nanos;
        c.order = this.fallenAsleep;
        this.fallenAsleep += 1;
        c.asleep = true;
        this.sleepers = merge(this.sleepers, c);
        if (let root = this.sleepers) { root.up = null; }
    }

    /// A wait that began in a cancelled task ends at once (06 N9 X1): the cancel may have come from
    /// another thread before the wait began, and found nothing to claim. Between a wait's beginning
    /// and its park — the mark and the claim are atomic, so of the cancel and the wait one sees the
    /// other.
    mut fn wakeIfCancelled(c: Context): void {
        if (c.cancelled.load()) {
            this.wakeUp(c);
        }
    }

    /// Ends `c`'s wait, where it still waits and nothing ended it first — the claim — and readies
    /// it: true then.
    mut fn wakeUp(c: Context): bool {
        if (!c.claim()) { return false; }
        this.post(c);
        return true;
    }

    /// `c`, whose wait a waker ended, goes to the ready queue of its own scheduler (06 G1) — through
    /// that scheduler's inbox where the waker runs on another thread.
    mut fn post(c: Context): void {
        let home = c.home;
        if (same(home, this)) {
            home.ready(c);
        } else {
            home.handOver(c);
        }
    }

    /// From a waker on another thread: `c` goes into the inbox, and the thread wakes for it.
    mut fn handOver(c: Context): void {
        this.inboxLock.acquire();
        c.next = null;
        if (let tail = this.inboxLast) {
            tail.next = c;
        } else {
            this.inboxFirst = c;
        }
        this.inboxLast = c;
        if (this.poller != 0) {
            wakePoller(this.poller);
        }
        this.inboxLock.release();
    }

    /// The contexts that wakers on other threads readied go to the ready queue, in the order they
    /// came.
    mut fn takeInbox(): void {
        this.inboxLock.acquire();
        var at = this.inboxFirst;
        this.inboxFirst = null;
        this.inboxLast = null;
        this.inboxLock.release();
        while (let c = at) {
            at = c.next;
            this.ready(c);
        }
    }

    mut fn yieldNow(): void throws Cancelled {
        let c = this.running ?? panic("a yield where no task runs");
        if (c.cancelled.load()) { throw Cancelled { }; }
        this.ready(c);
        park();
        if (c.cancelled.load()) { throw Cancelled { }; }
    }

    /// The running context waits in `list` until it is woken — a wait that ignores the mark: its
    /// caller decides what a cancel means to it.
    mut fn parkIn(list: Waiters): void {
        let me = this.running ?? panic("a wait where no task runs");
        me.beginWait();
        list.add(me);
        park();
        me.endWait();
        list.remove(me);
    }

    /// Cancels a context (06 N9 X1): the mark, and the end of the wait it is in now, if any.
    mut fn cancel(c: Context): void {
        c.cancelled.store(true);
        this.wakeUp(c);
    }

    /// The sleepers whose deadline came are woken, earliest first; one that another waker claimed
    /// meanwhile only leaves the heap.
    mut fn wakeSleepers(now: int): void {
        while (let top = this.sleepers) {
            if (top.deadline > now) { return; }
            this.unsleep(top);
            this.wakeUp(top);
        }
    }

    /// Takes a sleeper out of the heap, wherever it is: its children merged in its place, and the
    /// ranks above it set right again. Nothing where `c` does not sleep.
    mut fn unsleep(c: Context): void {
        if (!c.asleep) { return; }
        let merged = merge(c.left, c.right);
        let parent = c.up;
        if (let m = merged) { m.up = parent; }
        if (let p = parent) {
            if (let l = p.left) {
                if (same(l, c)) {
                    p.left = merged;
                } else {
                    p.right = merged;
                }
            } else {
                p.right = merged;
            }
            fixRanks(p);
        } else {
            this.sleepers = merged;
        }
        c.left = null;
        c.right = null;
        c.up = null;
        c.rank = 0;
        c.asleep = false;
    }

    /// A context ended by a panic (05 E8, 06 T4): its task becomes Panicked, and one without a
    /// handle — main's, a detached task's — ends the process with the panic.
    mut fn panicked(c: Context): void {
        let info = PanicInfo {
            code = panicCode(c.body) ?? "",
            message = panicMessage(c.body) ?? "",
            trace = panicTrace(c.body) ?? "",
        };
        if (let handler = c.onPanic) {
            handler(info);
        } else {
            repanic(info.code, info.message, info.trace);
        }
    }

    /// One turn: the next ready context runs until it waits; with none ready, the thread waits for
    /// the earliest sleeper — without end where there is none, until another thread wakes it.
    mut fn step(): void {
        this.takeInbox();
        if (this.sleepers != null) { this.wakeSleepers(monotonicNanos()); }
        if (let c = this.takeReady()) {
            this.running = c;
            let state = resumeContext(c.body);
            this.running = null;
            if (state == 2) {
                this.panicked(c);
            }
            return;
        }
        let top = this.sleepers;
        if (top == null) {
            waitOnPoller(-1);
            return;
        }
        let left = top.deadline - monotonicNanos();
        waitOnPoller(if (left > 0) left else 0);
    }
}

/// The ids of the channels, in the order they were made: the order of their locks.
let channelIds = Atomic<int>.new(0);

/// The running thread's scheduler: there is one wherever a task runs.
fn here(): Scheduler {
    return currentScheduler() ?? panic("a wait where no task runs");
}

/// The two heaps of sleepers as one: the earlier root on top, the other merged down its right
/// spine, whose length stays logarithmic. The caller sets the result's parent.
fn merge(a: ?Context, b: ?Context): ?Context {
    if (a == null) { return b; }
    if (b == null) { return a; }
    if (b.deadline < a.deadline || (b.deadline == a.deadline && b.order < a.order)) {
        return meld(b, a);
    }
    return meld(a, b);
}

fn meld(top: Context, other: Context): Context {
    let below = merge(top.right, other);
    if (let b = below) { b.up = top; }
    top.right = below;
    let l = rankOf(top.left);
    let r = rankOf(top.right);
    if (l < r) {
        let swap = top.left;
        top.left = top.right;
        top.right = swap;
        top.rank = l + 1;
    } else {
        top.rank = r + 1;
    }
    return top;
}

/// After a heap changed below `from`: each node up the path keeps its children leftist and its
/// rank right, until a rank stays as it was.
fn fixRanks(from: Context): void {
    var at: ?Context = from;
    while (let n = at) {
        let l = rankOf(n.left);
        let r = rankOf(n.right);
        if (l < r) {
            let swap = n.left;
            n.left = n.right;
            n.right = swap;
        }
        let rank = (if (l < r) l else r) + 1;
        if (rank == n.rank) { return; }
        n.rank = rank;
        at = n.up;
    }
}

fn rankOf(c: ?Context): int {
    if (c == null) { return 0; }
    return c.rank;
}

/// The program's scheduler loop where `main` is a task (06 T6), which the runtime calls with main's
/// context: it runs until that context is done — the program ends with main, and what is still
/// ready or asleep then never runs again.
fn runMain(main: Coroutine<void>): void {
    let s = Scheduler { };
    setCurrentScheduler(s);
    s.started();
    s.ready(Context { body = main, home = s });
    while (!main.isDone()) {
        s.step();
    }
    s.stopped();
    setCurrentScheduler(null);
}

// The runtime's side (13 §1.6, §1.7), the module's own.

/// A task's context around `body` on a stack of its own — `stack` bytes, 0 for the default: a
/// coroutine that yields nothing, whose body only ever parks.
fn startContext(body: fn() -> void, stack: int): Coroutine<void>;

/// Parks the running chain at the scheduler (13 §1.6 rule 7).
fn park(): void;

/// Resumes a task's context until it parks (0), its body returns (1) or it panics (2): a panic
/// stays the context's, for the scheduler to settle (13 §1.6 rule 10).
fn resumeContext(c: Coroutine<void>): int;

/// The report a panicked context left; null where it did not panic.
fn panicCode(c: Coroutine<void>): ?string;
fn panicMessage(c: Coroutine<void>): ?string;
fn panicTrace(c: Coroutine<void>): ?string;

/// A panic again, with a report an earlier one left: its code, its message, its frames.
fn repanic(code: string, message: string, trace: string): never;

/// The running thread's scheduler, as `runMain` set it.
fn currentScheduler(): ?Scheduler;
fn setCurrentScheduler(s: ?Scheduler): void;

/// Waits on the thread's poller (13 §1.7) for `nanos` at most, a negative one without end: true
/// when woken.
fn waitOnPoller(nanos: int): bool;

/// The monotonic clock (13 §1.6 rule 8): nanoseconds.
fn monotonicNanos(): int;

/// Starts a thread of the program that runs `body` on its own stack (06 G2).
fn startThread(body: fn() -> void): void;

/// The running thread's poller as the runtime numbers it, and the wake of a poller so numbered —
/// from any thread, while its thread runs.
fn currentPoller(): int;
fn wakePoller(poller: int): void;

/// A thread that spins on a lock lets another run.
fn spin(): void;
