//! Tasks, channels and the scheduler that runs them.
//!
//! Each thread has a scheduler, written here over the runtime's park and poller, and `main` runs
//! as a task of it. The module holds [spawn] and its [Task] with its [TaskStatus], [TaskScope],
//! [spawnDetached], [sleep] and [yieldNow]; cancellation through [Cancelled] and [withTimeout]; a
//! panic that ends a task, not the process, described by [PanicInfo]; and [Channel], [Select] and
//! [Timer], which work within a thread and across threads.
//!
//! The threads and their pool are std.thread's, the locks std.sync's and the signals std.os's;
//! they stand on parts kept here, internal to std: the locks' state, the scheduler, `launchOn`,
//! the registry of the living schedulers and the natives.

import std.core { filled };
import std.time { Duration };

/// The error a wait throws in a cancelled task, and a suspended `yield` when `close()` unwinds its
/// coroutine.
///
/// It is an [Error], so cleanup can catch it — though a coroutine that catches it may not yield
/// again, and a task that waits again gets it again.
pub class Cancelled :: [Error] {
    pub fn message(): string {
        return "cancelled";
    }
}

/// Parks the running task until at least `d` has passed, while the other tasks of its thread run.
///
/// A sleep of zero or less lets the tasks that are ready run first.
///
/// # Errors
/// Throws [Cancelled] in a cancelled task; a cancel during the sleep ends it early.
pub fn sleep(d: Duration): void throws Cancelled {
    try here().sleep(d.nanos());
}

/// Lets the other ready tasks of the thread run first: the running task goes behind them.
///
/// # Errors
/// Throws [Cancelled] in a cancelled task, as every wait does.
pub fn yieldNow(): void throws Cancelled {
    try here().yieldNow();
}

/// Describes a panic that ended a task: its code, its message, and the frames where it happened,
/// as the panic report writes them.
pub class PanicInfo {
    pub code: string,
    pub message: string,
    pub trace: string,
}

/// Where a task stands: still running; ended with its value, with an error, with [Cancelled]; or
/// ended by a panic.
pub enum TaskStatus<T> {
    Running,
    Done(T),
    Failed(Error),
    Cancelled,
    Panicked(PanicInfo),
}

/// The handle of a task, which [spawn] gives: the body's result once it ended, or the error it
/// ended with.
///
/// Its type carries that error — `Task<T> throws E` — and [Task.await] throws it.
pub class Task<T> {
    var done: bool = false,
    var value: ?T = null,
    var failure: ?Error = null,
    /// What a panic of the body left.
    var crash: ?PanicInfo = null,
    /// The context the body runs in, until it ends.
    var context: ?Context = null,
    /// The tasks parked in `await()` until the body ends, in the order they came.
    waiters: Waiters = Waiters { },
    /// Guards `done`, `context` and the waiters: a task is awaited and cancelled from any thread,
    /// not only its own. Its release publishes what the body left to the thread that acquires it
    /// next.
    guard: SpinLock = SpinLock { },

    /// Returns whether the body has ended, with its value, with an error, or by a panic.
    pub fn isDone(): bool {
        this.guard.acquire();
        let done = this.done;
        this.guard.release();
        return done;
    }

    /// Returns where the task stands, without waiting, and without panicking where the task did.
    pub fn status(): TaskStatus<T> {
        if (!this.isDone()) {
            return TaskStatus.Running;
        }
        if (let p = this.crash) {
            return TaskStatus.Panicked(p);
        }
        if (let e = this.failure) {
            if (e is Cancelled) {
                return TaskStatus.Cancelled;
            }
            return TaskStatus.Failed(e);
        }
        return TaskStatus.Done(this.value!);
    }

    /// Returns the body's value once it has ended; the running task waits until then.
    ///
    /// Where the body panicked, the panic is raised again here, with its code, message and trace.
    ///
    /// # Errors
    /// Throws the error the body ended with, and [Cancelled] in a cancelled task. What it throws
    /// is read off the handle's type at the call; the declared `Error` stands for it.
    pub mut fn await(): T throws Error {
        let me = here().running ?? panic("an await where no task runs");
        if (atomicLoad(&me.cancelled)) {
            throw Cancelled { };
        }
        this.guard.acquire();
        while (!this.done) {
            me.beginWait();
            me.awaits = true;
            this.waiters.add(me);
            this.guard.release();
            here().wakeIfCancelled(me);
            park();
            me.endWait();
            this.guard.acquire();
            this.waiters.remove(me);
            if (atomicLoad(&me.cancelled)) {
                this.guard.release();
                throw Cancelled { };
            }
        }
        this.guard.release();
        if (let p = this.crash) {
            repanic(p.code, p.message, p.trace);
        }
        if (let e = this.failure) {
            throw e;
        }
        return this.value!;
    }

    /// Returns the body's value once it has ended, waiting through a cancellation.
    ///
    /// std.fs's calls on a regular file run on the I/O pool, in the caller's buffer, and end in a
    /// bounded time — a caller that left before the end would take the buffer back while the pool
    /// still wrote into it. A cancellation does not end this wait; it stays the task's, for its next
    /// wait to throw.
    ///
    /// # Errors
    /// Throws the error the body ended with.
    mut fn awaitThrough(): T throws Error {
        let me = here().running ?? panic("an await where no task runs");
        this.guard.acquire();
        while (!this.done) {
            me.beginWait();
            me.awaits = true;
            this.waiters.add(me);
            this.guard.release();
            park();
            me.endWait();
            this.guard.acquire();
            this.waiters.remove(me);
        }
        this.guard.release();
        if (let p = this.crash) {
            repanic(p.code, p.message, p.trace);
        }
        if (let e = this.failure) {
            throw e;
        }
        return this.value!;
    }

    /// Cancels the task: its next wait throws [Cancelled] — at once, where it waits now — and so
    /// does every wait after it. A task that has ended stays as it ended.
    pub fn cancel(): void {
        this.guard.acquire();
        let context = this.context;
        this.guard.release();
        if (let c = context) {
            here().cancel(c);
        }
    }

    /// Cancels the task and waits until it has ended, whatever the running task's mark says: what a
    /// task does before it lets go of one it started.
    mut fn settle(): void {
        this.cancel();
        this.join();
    }

    /// Waits until the body has ended, however it ended and whatever the running task's mark says,
    /// without taking on its error or its panic: the supervisor's wait — `std.test`'s —, after which
    /// `status()` tells.
    mut fn join(): void {
        let me = here().running ?? panic("a wait where no task runs");
        this.guard.acquire();
        while (!this.done) {
            me.beginWait();
            me.awaits = true;
            this.waiters.add(me);
            this.guard.release();
            park();
            me.endWait();
            this.guard.acquire();
            this.waiters.remove(me);
        }
        this.guard.release();
    }

    /// Records that the body ended by a panic: the task is Panicked, and what it left waits for
    /// `await`.
    mut fn panicked(info: PanicInfo): void {
        this.crash = info;
        this.finish();
    }

    /// Marks the body as ended: its scope learns of it, and the tasks waiting for it are ready, in
    /// the order they came.
    mut fn finish(): void {
        if (let c = this.context) {
            if (let scope = c.scope) {
                scope.ended(c, this.failure, this.crash);
            }
        }
        let s = here();
        this.guard.acquire();
        this.done = true;
        this.context = null;
        this.waiters.wakeAll(s);
        this.guard.release();
    }
}

/// Starts `body` as a task of the running thread and returns its handle.
///
/// The task runs once the tasks ready before it had their turn, and [Task.await] on the handle
/// gives its value or throws its error — `E`, what the body throws, the handle's type carries. The
/// handle is the only way to that error, so a call that drops it warns; [spawnDetached] is the
/// task nobody awaits, and [TaskScope.spawn] one the scope's `close()` waits for.
@MustUse
pub fn spawn<T, E :: [Error]>(body: fn() -> T throws E): (Task<T> throws E) {
    return launch(body);
}

/// The error [withTimeout] throws when its time ran out before the body ended.
pub class TimedOut :: [Error] {
    pub fn message(): string {
        return "timed out";
    }
}

/// Runs `body` as a task of its own and returns what it returns, unless `d` passes first.
///
/// When `d` passes first, the body is cancelled, and [TimedOut] is thrown once it has ended. A
/// cancel of the caller cancels the body too; whenever this returns, the body has ended.
///
/// # Errors
/// Throws the body's own errors as they are; [TimedOut] when `d` passed before the body ended;
/// [Cancelled] when the caller was cancelled.
pub fn withTimeout<T, E :: [Error]>(
    d: Duration,
    body: fn() -> T throws E
): T throws [E, TimedOut, Cancelled] {
    var late = false;
    let work = spawn(body);
    let timer = spawn(
        () => {
            try sleep(d);
            late = true;
            work.cancel();
        }
    );
    defer timer.cancel();
    defer work.settle();
    try {
        return work.await();
    } catch (e: Cancelled) {
        if (late) {
            throw TimedOut { };
        }
        throw e;
    }
}

/// The error [Channel.send] throws on a closed channel.
pub class ChannelClosed :: [Error] {
    pub fn message(): string {
        return "channel closed";
    }
}

/// A queue of values between tasks: values go in with [Channel.send] and come out with
/// [Channel.recv], in the order they went in.
///
/// Unbuffered — a capacity of 0 — a send waits until a receiver takes the value; buffered, it
/// waits only while the buffer is full. [Channel.close] ends it: what is buffered can still be
/// received, then `recv` answers null; a send throws [ChannelClosed]. It works within a thread and
/// across threads: a send happens before the receive that gets its value.
///
/// The guard holds while the channel's state changes, and never while anything waits or a body runs.
/// The locks of this module are taken in one order — channels by their ids, then a task's guard or
/// a scheduler's inbox — so no two threads wait on each other's.
pub class Channel<T> {
    capacity: int,
    /// Its place in the order of channel locks (a select takes several).
    id: int,
    guard: SpinLock,
    var buffered: int = 0,
    var first: ?Item<T> = null,
    var last: ?Item<T> = null,
    var closed: bool = false,
    /// The tasks waiting to send, each with its value, and those waiting to receive.
    senders: WaitQueue<T>,
    receivers: WaitQueue<T>,
    /// What else ends with the channel: the signal hub's subscription. Run once, after the close,
    /// outside the guard.
    var closer: ?fn() -> void = null,

    /// Creates a channel that holds up to `capacity` values no task has received yet.
    ///
    /// A capacity of 0 — the default — holds none: a send meets a receive. A negative capacity
    /// counts as 0.
    pub static fn new(capacity: int = 0): Channel<T> {
        return Channel<T> {
            capacity = if (capacity > 0) capacity else 0,
            id = atomicFetchAndAdd(&channelIds, 1) +% 1,
            guard = SpinLock { },
            senders = WaitQueue<T> { },
            receivers = WaitQueue<T> { },
        };
    }

    /// Puts `value` into the channel: to a task waiting to receive, or into the buffer while there
    /// is room — else the running task waits until a receiver takes it.
    ///
    /// # Errors
    /// Throws [ChannelClosed] on a closed channel, and when the channel closes while it waits;
    /// [Cancelled] in a cancelled task.
    pub mut fn send(value: T): void throws [ChannelClosed, Cancelled] {
        let s = here();
        let me = s.running ?? panic("a send where no task runs");
        if (atomicLoad(&me.cancelled)) {
            throw Cancelled { };
        }
        this.guard.acquire();
        if (this.closed) {
            this.guard.release();
            throw ChannelClosed { };
        }
        while (let r = this.receivers.take()) {
            if (r.context.claim()) {
                r.value = value;
                r.settled = true;
                this.guard.release();
                s.post(r.context);
                return;
            }
        }
        if (this.buffered < this.capacity) {
            this.push(value);
            this.guard.release();
            return;
        }
        let w = Waiting<T> { context = me, value = value };
        me.beginWait();
        this.senders.add(w);
        this.guard.release();
        s.wakeIfCancelled(me);
        park();
        me.endWait();
        this.guard.acquire();
        this.senders.remove(w);
        let settled = w.settled;
        this.guard.release();
        if (settled) {
            return;
        }
        if (atomicLoad(&me.cancelled)) {
            throw Cancelled { };
        }
        throw ChannelClosed { };
    }

    /// Returns the next value of the channel: from the buffer, or from a task waiting to send —
    /// else the running task waits for one. Returns null once the channel is closed and empty.
    ///
    /// # Errors
    /// Throws [Cancelled] in a cancelled task.
    pub mut fn recv(): ?T throws Cancelled {
        let s = here();
        let me = s.running ?? panic("a receive where no task runs");
        if (atomicLoad(&me.cancelled)) {
            throw Cancelled { };
        }
        this.guard.acquire();
        if (let item = this.takeNow(s)) {
            this.guard.release();
            return item.value;
        }
        if (this.closed) {
            this.guard.release();
            return null;
        }
        let w = Waiting<T> { context = me };
        me.beginWait();
        this.receivers.add(w);
        this.guard.release();
        s.wakeIfCancelled(me);
        park();
        me.endWait();
        this.guard.acquire();
        this.receivers.remove(w);
        let settled = w.settled;
        let value = w.value;
        this.guard.release();
        if (settled) {
            return value;
        }
        if (atomicLoad(&me.cancelled)) {
            throw Cancelled { };
        }
        return null;
    }

    /// Closes the channel: the tasks waiting to receive get null, those waiting to send throw
    /// `ChannelClosed`; what is buffered can still be received. Closing a closed channel does nothing.
    pub mut fn close(): void {
        let s = here();
        this.guard.acquire();
        if (this.closed) {
            this.guard.release();
            return;
        }
        this.closed = true;
        while (let r = this.receivers.take()) {
            s.wakeUp(r.context);
        }
        while (let w = this.senders.take()) {
            s.wakeUp(w.context);
        }
        let closer = this.closer;
        this.closer = null;
        this.guard.release();
        if (let f = closer) {
            f();
        }
    }

    /// Puts `value` into the channel where that needs no wait — to a task waiting to receive, or
    /// into the buffer while it has room — and returns 1 then; 0 where it would have to wait, and
    /// the value is dropped; -1 for a closed channel.
    mut fn offer(s: Scheduler, value: T): int {
        this.guard.acquire();
        if (this.closed) {
            this.guard.release();
            return -1;
        }
        while (let r = this.receivers.take()) {
            if (r.context.claim()) {
                r.value = value;
                r.settled = true;
                this.guard.release();
                s.post(r.context);
                return 1;
            }
        }
        if (this.buffered < this.capacity) {
            this.push(value);
            this.guard.release();
            return 1;
        }
        this.guard.release();
        return 0;
    }

    /// Takes a value out at once — from the buffer, which a task waiting to send then refills, or
    /// from such a task itself; null where a receive would wait, or find the channel closed and
    /// empty. It never waits. A waiting sender that another waker ended meanwhile is passed over.
    /// Under the guard.
    mut fn takeNow(s: Scheduler): ?Item<T> {
        if (let item = this.first) {
            this.first = item.next;
            if (item.next == null) {
                this.last = null;
            }
            this.buffered -= 1;
            while (let w = this.senders.take()) {
                if (w.context.claim()) {
                    this.push(w.value!);
                    w.settled = true;
                    s.post(w.context);
                    break;
                }
            }
            return item;
        }
        while (let w = this.senders.take()) {
            if (w.context.claim()) {
                w.settled = true;
                s.post(w.context);
                return Item<T> { value = w.value! };
            }
        }
        return null;
    }

    mut fn push(value: T): void {
        let item = Item<T> { value = value };
        if (let tail = this.last) {
            tail.next = item;
        } else {
            this.first = item;
        }
        this.last = item;
        this.buffered += 1;
    }
}

/// A buffered value of a channel.
class Item<T> {
    value: T,
    var next: ?Item<T> = null,
}

/// A task waiting on a channel: to send `value`, or to receive one into it. `settled` once the value
/// went over; `queued` while it is in the channel's queue.
class Waiting<T> {
    context: Context,
    var value: ?T = null,
    var settled: bool = false,
    var queued: bool = false,
    var next: ?Waiting<T> = null,
    var prev: ?Waiting<T> = null,
}

/// The tasks waiting on one side of a channel, in the order they came. A waker takes the first out;
/// a task whose wait something else ended takes itself out once it runs again.
class WaitQueue<T> {
    var first: ?Waiting<T> = null,
    var last: ?Waiting<T> = null,

    mut fn add(w: Waiting<T>): void {
        w.prev = this.last;
        w.next = null;
        if (let tail = this.last) {
            tail.next = w;
        } else {
            this.first = w;
        }
        this.last = w;
        w.queued = true;
    }

    /// Takes `w` out of the queue — nothing where it is not in it.
    mut fn remove(w: Waiting<T>): void {
        if (!w.queued) {
            return;
        }
        w.queued = false;
        if (let p = w.prev) {
            p.next = w.next;
        } else {
            this.first = w.next;
        }
        if (let n = w.next) {
            n.prev = w.prev;
        } else {
            this.last = w.prev;
        }
        w.prev = null;
        w.next = null;
    }

    /// Takes the first waiting task out and returns it, or null where none waits.
    mut fn take(): ?Waiting<T> {
        let w = this.first;
        if (w == null) {
            return null;
        }
        this.remove(w);
        return w;
    }
}

/// The way into a select, a wait on several channels at once.
///
/// `Select.on(a) { … }.on(b) { … }.timeout(d) { … }.run()` waits on the channels `a` and `b` at
/// once and runs the case of the first to have a value — or the timeout's, when `d` passed first.
pub class Select {
    /// Creates a select with its first case: a receive from `c` (see [Selection.on]).
    pub static fn on<T>(c: Channel<T>, body: fn(?T) -> void throws Error): Selection {
        let s = Selection { };
        return s.on(c, body);
    }
}

/// A select as it is built: its cases, in the order they were added, and a timeout.
pub class Selection {
    var first: ?CaseNode = null,
    var last: ?CaseNode = null,
    /// The guards of its channels, each once, in the order of the channels' ids: a select looks at
    /// all of them in one step. Made at the first run after a case was added.
    var guards: ?GuardNode = null,
    /// The timeout's nanoseconds — 0 for at once, -1 for none.
    var timeoutNanos: int = -1,
    var onTimeout: ?fn() -> void throws Error = null,

    /// Adds a case, a receive from `c`, and returns the select. Its body gets what `recv()` would
    /// give — the value, or null once `c` is closed and empty.
    pub mut fn on<T>(c: Channel<T>, body: fn(?T) -> void throws Error): Selection {
        let node = CaseNode { entry = Case<T> { channel = c, body = body } };
        if (let tail = this.last) {
            tail.next = node;
        } else {
            this.first = node;
        }
        this.last = node;
        this.guards = null;
        return this;
    }

    /// Sets the timeout and returns the select: `body` runs when no case could go on before `d`
    /// passed — with `d` of zero or less, when none can at once.
    pub mut fn timeout(d: Duration, body: fn() -> void throws Error): Selection {
        this.timeoutNanos = if (d.nanos() > 0) d.nanos() else 0;
        this.onTimeout = body;
        return this;
    }

    /// Runs the select: the first case, in the order they were added, whose channel has a value or
    /// is closed runs at once. Else the running task waits on all of them, and the first channel to
    /// get a value or to close runs its case — or the timeout's body runs, once its time came
    /// first. One body runs, and only its case receives.
    ///
    /// # Errors
    /// Throws what the chosen body throws; [Cancelled] in a cancelled task, where a cancel also
    /// ends the wait.
    pub mut fn run(): void throws Error {
        let s = here();
        let me = s.running ?? panic("a select where no task runs");
        if (atomicLoad(&me.cancelled)) {
            throw Cancelled { };
        }
        if (this.guards == null) {
            this.guards = this.orderGuards();
        }
        this.lockAll();
        if (let ready = this.takeReady(s)) {
            this.unlockAll();
            try ready.entry.finish();
            return;
        }
        if (this.timeoutNanos == 0) {
            this.unlockAll();
            try this.timedOut();
            return;
        }
        me.beginWait();
        var at = this.first;
        while (let n = at) {
            n.entry.enlist(me);
            at = n.next;
        }
        this.unlockAll();
        if (this.timeoutNanos > 0) {
            s.fallAsleep(me, this.timeoutNanos);
        }
        s.wakeIfCancelled(me);
        park();
        me.endWait();
        s.unsleep(me);
        // What woke it: a value for one case; else a cancel; else a channel that closed or now has
        // a value — or the timer.
        this.lockAll();
        var chosen: ?CaseNode = null;
        at = this.first;
        while (let n = at) {
            n.entry.withdraw();
            if (chosen == null && n.entry.settled()) {
                chosen = n;
            }
            at = n.next;
        }
        if (chosen == null && !atomicLoad(&me.cancelled)) {
            chosen = this.takeReady(s);
        }
        this.unlockAll();
        if (let n = chosen) {
            try n.entry.finish();
            return;
        }
        if (atomicLoad(&me.cancelled)) {
            throw Cancelled { };
        }
        try this.timedOut();
    }

    /// Returns the first case, in the order they were added, that can go on at once — what it
    /// receives taken already; null where none can. Under the guards.
    mut fn takeReady(s: Scheduler): ?CaseNode {
        var at = this.first;
        while (let n = at) {
            if (n.entry.takeReady(s)) {
                return n;
            }
            at = n.next;
        }
        return null;
    }

    /// Returns the guards of the channels, each once, sorted by the channels' ids.
    fn orderGuards(): ?GuardNode {
        var sorted: ?GuardNode = null;
        var at = this.first;
        while (let n = at) {
            let id = n.entry.channelId();
            var before: ?GuardNode = null;
            var after = sorted;
            while (let g = after) {
                if (g.id >= id) {
                    break;
                }
                before = g;
                after = g.next;
            }
            var known = false;
            if (let g = after) {
                known = g.id == id;
            }
            if (!known) {
                let node = GuardNode { id = id, guard = n.entry.channelGuard(), next = after };
                if (let b = before) {
                    b.next = node;
                } else {
                    sorted = node;
                }
            }
            at = n.next;
        }
        return sorted;
    }

    fn lockAll(): void {
        var at = this.guards;
        while (let g = at) {
            g.guard.acquire();
            at = g.next;
        }
    }

    fn unlockAll(): void {
        var at = this.guards;
        while (let g = at) {
            g.guard.release();
            at = g.next;
        }
    }

    fn timedOut(): void throws Error {
        if (let t = this.onTimeout) {
            try t();
        }
    }
}

/// A case of a select, in the select's list.
class CaseNode {
    entry: SelectCase,
    var next: ?CaseNode = null,
}

/// A channel's guard in a select's list of them, sorted by the channel's id.
class GuardNode {
    id: int,
    guard: SpinLock,
    var next: ?GuardNode = null,
}

/// One case of a select, whatever the element type of its channel: a receive from that channel.
interface SelectCase {
    /// The channel's place in the order of locks, and its guard.
    fn channelId(): int;
    fn channelGuard(): SpinLock;
    /// Receives at once where a receive would not wait — a value is there, or the channel is
    /// closed — and keeps what came for `finish()`: true then; false where it would wait. Under the
    /// channel's guard.
    mut fn takeReady(s: Scheduler): bool;
    /// Puts `c` on the channel's wait for a value, as one of the select's waits. Under the guard.
    mut fn enlist(c: Context): void;
    /// Takes the case's wait off the channel. Under the guard.
    mut fn withdraw(): void;
    /// Returns whether a value came to it while it waited, which it keeps for `finish()`. Under
    /// the guard.
    mut fn settled(): bool;
    /// Runs the body with what the case received — the value, or null for a closed channel.
    fn finish(): void throws Error;
}

class Case<T> :: [SelectCase] {
    channel: Channel<T>,
    body: fn(?T) -> void throws Error,
    var waiting: ?Waiting<T> = null,
    /// What the case received, for its body.
    var received: ?T = null,

    fn channelId(): int {
        return this.channel.id;
    }

    fn channelGuard(): SpinLock {
        return this.channel.guard;
    }

    mut fn takeReady(s: Scheduler): bool {
        if (let item = this.channel.takeNow(s)) {
            this.received = item.value;
            return true;
        }
        if (this.channel.closed) {
            this.received = null;
            return true;
        }
        return false;
    }

    mut fn enlist(c: Context): void {
        let w = Waiting<T> { context = c };
        this.waiting = w;
        this.channel.receivers.add(w);
    }

    mut fn withdraw(): void {
        if (let w = this.waiting) {
            this.channel.receivers.remove(w);
        }
    }

    mut fn settled(): bool {
        if (let w = this.waiting) {
            if (w.settled) {
                this.received = w.value;
                return true;
            }
        }
        return false;
    }

    fn finish(): void throws Error {
        let f = this.body;
        try f(this.received);
    }
}

/// Timers, as channels a select can wait on.
pub class Timer {
    /// Returns a channel that fires once, when `d` has passed: then it closes, so a receive from it
    /// answers null and a select's case on it runs. A detached task sleeps until then, which the
    /// program does not wait for.
    pub static fn after(d: Duration): Channel<void> {
        let ch = Channel<void>.new();
        spawnDetached(
            () => {
                try sleep(d);
                ch.close();
            }
        );
        return ch;
    }
}

/// A lock a context holds: the lock's state, how — alone, or as one of its
/// readers —, and the next one down.
class Hold {
    var state: ?LockState = null,
    var alone: bool = false,
    var next: ?Hold = null,
}

/// A lock's value, where the place its body takes lies.
class Slot<T> {
    var value: T,
}

/// What a lock knows of its holders — a mutex's, a reader-writer lock's, a once's — behind a spin
/// lock: whether one holds it alone, how many share it, how many writers wait, whether the work of
/// a once is done; and the tasks that wait, each of which every change wakes to look again.
class LockState {
    guard: SpinLock = SpinLock { },
    var alone: bool = false,
    var readers: int = 0,
    var writersWaiting: int = 0,
    var done: bool = false,
    waiters: Waiters = Waiters { },
    /// The panic of a task that held the lock when it panicked: from then on every acquire panics,
    /// naming it. The scheduler releases the lock itself.
    var poisoned: ?PanicInfo = null,

    /// Refuses the running task where the lock is poisoned — with its guard released and a panic
    /// that names the first one. Called with the guard held.
    ///
    /// # Panics
    /// When the lock is poisoned.
    mut fn refuseIfPoisoned(): void {
        if (let p = this.poisoned) {
            this.guard.release();
            poisonedBy(p.code, p.message);
        }
    }

    /// Takes the lock alone for the running task, once no other holds it at all; a writer
    /// (`counting`) counts itself as waiting the while, which holds back readers that come after it.
    ///
    /// # Errors
    /// Throws [Cancelled] in a cancelled task.
    ///
    /// # Panics
    /// When the lock is poisoned.
    mut fn acquireAlone(counting: bool): void throws Cancelled {
        let s = here();
        let me = s.running ?? panic("a lock where no task runs");
        if (atomicLoad(&me.cancelled)) {
            throw Cancelled { };
        }
        this.guard.acquire();
        this.refuseIfPoisoned();
        if (counting) {
            this.writersWaiting += 1;
        }
        while (this.alone || this.readers > 0) {
            if (!this.awaitChange(s, me)) {
                if (counting) {
                    this.writersWaiting -= 1;
                    this.waiters.wakeAll(s);
                }
                this.guard.release();
                throw Cancelled { };
            }
            this.refuseIfPoisoned();
        }
        if (counting) {
            this.writersWaiting -= 1;
        }
        this.alone = true;
        me.took(this, true);
        this.guard.release();
    }

    /// Takes a share of the lock for the running task, once nobody holds it alone and no writer
    /// waits.
    ///
    /// # Errors
    /// Throws [Cancelled] in a cancelled task.
    ///
    /// # Panics
    /// When the lock is poisoned.
    mut fn acquireShared(): void throws Cancelled {
        let s = here();
        let me = s.running ?? panic("a lock where no task runs");
        if (atomicLoad(&me.cancelled)) {
            throw Cancelled { };
        }
        this.guard.acquire();
        this.refuseIfPoisoned();
        while (this.alone || this.writersWaiting > 0) {
            if (!this.awaitChange(s, me)) {
                this.guard.release();
                throw Cancelled { };
            }
            this.refuseIfPoisoned();
        }
        this.readers += 1;
        me.took(this, false);
        this.guard.release();
    }

    /// Lets go of the lock the running task holds alone: the body's `defer`.
    mut fn releaseAlone(): void {
        let s = here();
        let me = s.running ?? panic("a lock where no task runs");
        me.released();
        this.freeAlone(s, null);
    }

    /// Lets go of the running task's share.
    mut fn releaseShared(): void {
        let s = here();
        let me = s.running ?? panic("a lock where no task runs");
        me.released();
        this.freeShared(s, null);
    }

    /// Frees the lock held alone — and poisons it where `panic` is the panic of the task that held
    /// it: the waiters wake, look, and see it.
    mut fn freeAlone(s: Scheduler, panic: ?PanicInfo): void {
        this.guard.acquire();
        this.alone = false;
        this.poison(panic);
        this.waiters.wakeAll(s);
        this.guard.release();
    }

    mut fn freeShared(s: Scheduler, panic: ?PanicInfo): void {
        this.guard.acquire();
        this.readers -= 1;
        this.poison(panic);
        if (this.readers == 0 || panic != null) {
            this.waiters.wakeAll(s);
        }
        this.guard.release();
    }

    /// Poisons the lock with `panic` unless an earlier panic did: the first one stays. Called with
    /// the guard held.
    mut fn poison(panic: ?PanicInfo): void {
        if (this.poisoned == null) {
            this.poisoned = panic;
        }
    }

    /// Starts a once: returns true for the task that does the work now, false where it is done —
    /// one that comes while another does it waits.
    ///
    /// # Errors
    /// Throws [Cancelled] in a cancelled task.
    ///
    /// # Panics
    /// When the once is poisoned.
    mut fn beginOnce(): bool throws Cancelled {
        let s = here();
        let me = s.running ?? panic("a once where no task runs");
        if (atomicLoad(&me.cancelled)) {
            throw Cancelled { };
        }
        this.guard.acquire();
        this.refuseIfPoisoned();
        while (this.alone) {
            if (!this.awaitChange(s, me)) {
                this.guard.release();
                throw Cancelled { };
            }
            this.refuseIfPoisoned();
        }
        let first = !this.done;
        if (first) {
            this.alone = true;
            me.took(this, true);
        }
        this.guard.release();
        return first;
    }

    /// Ends the work of the task that does it: done, or not — the body threw — for the next.
    mut fn endOnce(done: bool): void {
        let s = here();
        let me = s.running ?? panic("a once where no task runs");
        me.released();
        this.freeOnce(s, done, null);
    }

    /// Ends the work — undone and poisoned where `panic` is the panic of the task doing it.
    mut fn freeOnce(s: Scheduler, done: bool, panic: ?PanicInfo): void {
        this.guard.acquire();
        this.alone = false;
        this.done = done;
        this.poison(panic);
        this.waiters.wakeAll(s);
        this.guard.release();
    }

    /// Waits once for a change, the guard held before and after; returns false where the task was
    /// cancelled.
    mut fn awaitChange(s: Scheduler, me: Context): bool {
        me.beginWait();
        this.waiters.add(me);
        this.guard.release();
        s.wakeIfCancelled(me);
        park();
        me.endWait();
        this.guard.acquire();
        this.waiters.remove(me);
        return !atomicLoad(&me.cancelled);
    }
}

/// A scope whose tasks end before it does: structured concurrency.
///
/// A scope is `Closeable` — `using let scope = TaskScope.new();` — and its [TaskScope.close] waits
/// until every task it started has ended. The first of them that fails cancels the others, and
/// `close()` throws that error once they have all ended; a task that ends with [Cancelled] is no
/// failure of the scope. A task that panics does the same, and `close()` panics again with it. A
/// task waiting in `close()` that is cancelled cancels the scope's tasks and still waits for them.
pub class TaskScope :: [Closeable] {
    var firstChild: ?Context = null,
    var lastChild: ?Context = null,
    var open: int = 0,
    var failure: ?Error = null,
    var crash: ?PanicInfo = null,
    /// Set once `close()` has waited for the scope's tasks.
    var closed: bool = false,
    /// The task waiting in `close()`.
    closing: Waiters = Waiters { },

    /// Creates a scope with no tasks yet.
    pub static fn new(): TaskScope {
        return TaskScope { };
    }

    /// Starts `body` as a task of this scope and returns its handle, as [spawn] does: `close()`
    /// waits for it, and a failure of it cancels the other tasks of the scope.
    ///
    /// A task given while `close()` waits is a child like any, and the wait takes it in.
    ///
    /// # Panics
    /// When the scope is closed, since nothing would wait for the task.
    pub mut fn spawn<T, E :: [Error]>(body: fn() -> T throws E): (Task<T> throws E) {
        if (this.closed) {
            panic("a task given to a closed scope");
        }
        let task = launch(body);
        if (let c = task.context) {
            c.scope = this;
            c.prevChild = this.lastChild;
            c.nextChild = null;
            if (let tail = this.lastChild) {
                tail.nextChild = c;
            } else {
                this.firstChild = c;
            }
            this.lastChild = c;
            this.open += 1;
        }
        return task;
    }

    /// Cancels every task of the scope that has not ended.
    pub fn cancel(): void {
        let s = here();
        var at = this.firstChild;
        while (let c = at) {
            at = c.nextChild;
            s.cancel(c);
        }
    }

    /// Waits until every task of the scope has ended, then throws the first failure, if any.
    ///
    /// A task of the scope that panicked makes this panic again, with that panic's code, message
    /// and trace.
    ///
    /// # Errors
    /// Throws the error the first failed task of the scope ended with.
    pub fn close(): void throws Error {
        let s = here();
        let me = s.running ?? panic("a scope closed where no task runs");
        while (this.open > 0) {
            if (atomicLoad(&me.cancelled)) {
                this.cancel();
            }
            s.parkIn(this.closing);
        }
        // through the reference: 'Closeable.close' is no 'mut fn' (as Pool's close)
        let scope = this;
        scope.closed = true;
        if (let p = this.crash) {
            repanic(p.code, p.message, p.trace);
        }
        if (let e = this.failure) {
            throw e;
        }
    }

    /// Records that a task of the scope ended, with `failure` or a panic or neither: the first failure —
    /// `Cancelled` is none — or panic cancels the others, and the last task to end wakes `close()`.
    mut fn ended(c: Context, failure: ?Error, crash: ?PanicInfo): void {
        if (let p = c.prevChild) {
            p.nextChild = c.nextChild;
        } else {
            this.firstChild = c.nextChild;
        }
        if (let n = c.nextChild) {
            n.prevChild = c.prevChild;
        } else {
            this.lastChild = c.prevChild;
        }
        c.prevChild = null;
        c.nextChild = null;
        c.scope = null;
        this.open -= 1;
        if (let p = crash) {
            if (this.crash == null && this.failure == null) {
                this.crash = p;
                this.cancel();
            }
        } else if (let e = failure) {
            if (this.crash == null && this.failure == null && !(e is Cancelled)) {
                this.failure = e;
                this.cancel();
            }
        }
        if (this.open == 0) {
            this.closing.wakeAll(here());
        }
    }
}

/// Creates a task around `body`, ready to run, and returns its handle: what `spawn` and
/// `TaskScope.spawn` share.
fn launch<T, E :: [Error]>(body: fn() -> T throws E): Task<T> {
    return launchOn(here(), body, null);
}

/// Creates a task around `body` on the scheduler `s` — another thread's, for `Thread.spawn` and
/// `Pool.spawn` — and returns its handle; it is readied through that scheduler's inbox then. `ended` runs once the body has ended, however it ended.
fn launchOn<T, E :: [Error]>(
    s: Scheduler,
    body: fn() -> T throws E,
    ended: ?fn() -> void
): Task<T> {
    let task = Task<T> { };
    let run = () => {
        try {
            task.value = body();
        } catch (e) {
            task.failure = e;
        }
        task.finish();
        if (let f = ended) {
            f();
        }
    };
    let c = Context { body = startContext(run, 0), home = s };
    c.onPanic = (info: PanicInfo) => {
        task.panicked(info);
        if (let f = ended) {
            f();
        }
    };
    task.context = c;
    here().post(c);
    return task;
}

/// Starts `body` as a task of the running thread, with no handle.
///
/// It runs once the tasks ready before it had their turn, and nobody waits for it — the program
/// ends with `main`, done or not. Only a cancellation may end it early: it handles every other
/// error itself.
pub fn spawnDetached(body: fn() -> void throws Cancelled): void {
    let run = () => {
        try {
            body();
        } catch (_: Cancelled) { }
    };
    let s = here();
    s.ready(Context { body = startContext(run, 0), home = s });
}

// ---------------------------------------------------------------------------------------------
// The scheduler: one for each thread that runs tasks. It runs one task at a time
// until that task waits — the ready ones in the order they became ready, the sleepers once
// their deadline came, earliest first — and, with nothing ready, waits on the thread's poller
// until the earliest deadline.
// ---------------------------------------------------------------------------------------------

/// A task's context as the scheduler holds it: the coroutine its body runs in, the scheduler of
/// its thread, which it never leaves, and the links of the places it waits in — the waiting list
/// of a task or a scope, the sleepers' heap; a channel's queue holds a `Waiting` of its own.
///
/// A wait begins before the context goes into any of its places and parks it. Whatever ends
/// the wait — a value, a close, its deadline, a cancel — first claims the context: of all that would,
/// one does, and readies it; the others leave it be. Running again, the context leaves the places it
/// still is in itself.
class Context {
    body: Coroutine<void>,
    home: Scheduler,
    /// The links of the ready queue.
    var next: ?Context = null,
    var prev: ?Context = null,
    /// 0 running or ready; 1 waiting — any waker may claim it —; 2 claimed. Atomic, for wakers on
    /// other threads: read and written through the atomic operations alone.
    var state: int = 0,
    /// The links of the waiting list it is in, a task's or a scope's.
    var listed: bool = false,
    var listNext: ?Context = null,
    var listPrev: ?Context = null,
    /// In the sleepers' heap: its deadline on the monotonic clock, and when it fell asleep — the
    /// tie-break.
    var asleep: bool = false,
    var deadline: int = 0,
    var order: int = 0,
    /// The heap is leftist: the children, the parent — a sleeper leaves from where it is — and the
    /// length of the right spine.
    var left: ?Context = null,
    var right: ?Context = null,
    var up: ?Context = null,
    var rank: int = 0,
    /// Cancelled: every wait from here on throws `Cancelled`. Atomic: a cancel may come
    /// from another thread.
    var cancelled: bool = false,
    /// What becomes of a panic of it: its handle's — a context without one, main's or a
    /// detached task's, ends the process with the panic.
    var onPanic: ?fn(PanicInfo) -> void = null,
    /// The scope its task belongs to, and the links of that scope's list of tasks.
    var scope: ?TaskScope = null,
    var nextChild: ?Context = null,
    var prevChild: ?Context = null,
    /// The links of its scheduler's register of the contexts that live: from its first turn to its
    /// end.
    var live: bool = false,
    var liveNext: ?Context = null,
    var livePrev: ?Context = null,
    /// Its scheduler found that nothing can end the wait it is in, and woke it to say so.
    var stuck: bool = false,
    /// The wait it is in is for a task's end — an `await`, a scope's close: where every task of
    /// a thread waits, such a one waits for the reason and is not it.
    var awaits: bool = false,
    /// The locks it holds, newest first: released and poisoned where it
    /// panics, since a panic unwinds nothing. One node is kept for the next lock, so a lock that
    /// nests in no other costs no allocation after the first.
    var holds: ?Hold = null,
    var spareHold: ?Hold = null,

    /// Begins a wait: from here a waker may claim the context — before it goes into any place a
    /// waker looks.
    mut fn beginWait(): void {
        atomicStore(&this.state, 1);
    }

    /// Records that it holds `state` from here on — alone, or as one of its readers; a once's work counts as
    /// alone — until it lets go of it, or panics.
    mut fn took(state: LockState, alone: bool): void {
        let hold = this.spareHold ?? Hold { };
        this.spareHold = null;
        hold.state = state;
        hold.alone = alone;
        hold.next = this.holds;
        this.holds = hold;
    }

    /// Records that it let go of the lock it took last.
    mut fn released(): void {
        if (let hold = this.holds) {
            this.holds = hold.next;
            hold.state = null;
            hold.next = null;
            this.spareHold = hold;
        }
    }

    /// Frees the locks it held when it panicked, as the body's `defer` would have — newest first —,
    /// each poisoned with the panic where no earlier one poisoned it.
    mut fn dropHeld(s: Scheduler, panic: PanicInfo): void {
        while (let hold = this.holds) {
            this.holds = hold.next;
            if (let state = hold.state) {
                // a once's work the same as a lock held alone: undone, and poisoned
                if (hold.alone) {
                    state.freeAlone(s, panic);
                } else {
                    state.freeShared(s, panic);
                }
            }
        }
    }

    /// Claims the context for a waker that ends its wait: true for the first, which readies it;
    /// false for every other, and where it does not wait.
    mut fn claim(): bool {
        return atomicCompareAndSet(&this.state, 1, 2);
    }

    /// Ends a wait as the context runs again; the places it waited in it leaves next. Every wait
    /// passes here once it woke — so this is where a wait that nothing could have ended ends: by a
    /// panic in the waiting task's own stack, whose trace names the wait. The context stays in the
    /// places it waited in; no waker can claim it there any more.
    ///
    /// # Panics
    /// When the scheduler found that nothing could end the wait.
    mut fn endWait(): void {
        atomicStore(&this.state, 0);
        this.awaits = false;
        if (this.stuck) {
            deadlocked();
        }
    }
}

/// The tasks waiting for one task to end, or for a scope's tasks, in the order they came. A task
/// takes itself out once its wait ended.
class Waiters {
    var first: ?Context = null,
    var last: ?Context = null,

    mut fn add(c: Context): void {
        c.listPrev = this.last;
        c.listNext = null;
        if (let tail = this.last) {
            tail.listNext = c;
        } else {
            this.first = c;
        }
        this.last = c;
        c.listed = true;
    }

    /// Takes `c` out — nothing where it is not in.
    mut fn remove(c: Context): void {
        if (!c.listed) {
            return;
        }
        c.listed = false;
        if (let p = c.listPrev) {
            p.listNext = c.listNext;
        } else {
            this.first = c.listNext;
        }
        if (let n = c.listNext) {
            n.listPrev = c.listPrev;
        } else {
            this.last = c.listPrev;
        }
        c.listPrev = null;
        c.listNext = null;
    }

    /// Ends the wait of each, in the order they came.
    mut fn wakeAll(s: Scheduler): void {
        while (let c = this.first) {
            this.remove(c);
            s.wakeUp(c);
        }
    }
}

/// A lock for the short sections where threads meet — an inbox, a task's end: it spins while
/// another thread holds it, and guards nothing that waits.
class SpinLock {
    var held: bool = false, // atomic

    mut fn acquire(): void {
        while (!atomicCompareAndSet(&this.held, false, true)) {
            spin();
        }
    }

    mut fn release(): void {
        atomicStore(&this.held, false);
    }
}

/// The tasks that wait on one socket: a reader and a writer at most, so that its close ends their
/// waits on whichever thread they wait. The guard holds while a
/// task comes or goes and while the close takes them, so a task that comes after the close turns
/// back, and one that came before is woken: no wake falls between the two.
class Waits {
    guard: SpinLock = SpinLock { },
    var reading: ?Context = null,
    var writing: ?Context = null,
    var closed: bool = false,

    /// Enters `c` as waiting here, to read (1) or to write (2); returns false where the socket was
    /// closed first.
    mut fn enter(c: Context, interest: int): bool {
        this.guard.acquire();
        let open = !this.closed;
        if (open) {
            if (interest == 1) {
                this.reading = c;
            } else {
                this.writing = c;
            }
        }
        this.guard.release();
        return open;
    }

    /// Takes `c` out of the waits here.
    mut fn leave(c: Context, interest: int): void {
        this.guard.acquire();
        if (interest == 1) {
            if (let r = this.reading) {
                if (same(r, c)) {
                    this.reading = null;
                }
            }
        } else {
            if (let w = this.writing) {
                if (same(w, c)) {
                    this.writing = null;
                }
            }
        }
        this.guard.release();
    }

    /// Closes the waits as the socket closes: no task waits here from now on, and those that do run
    /// again.
    mut fn close(): void {
        this.guard.acquire();
        this.closed = true;
        let r = this.reading;
        let w = this.writing;
        this.reading = null;
        this.writing = null;
        this.guard.release();
        if (r == null && w == null) {
            return;
        }
        let s = here();
        if (let c = r) {
            s.wakeUp(c);
        }
        if (let c = w) {
            s.wakeUp(c);
        }
    }
}

class Scheduler {
    var first: ?Context = null,
    var last: ?Context = null,
    var sleepers: ?Context = null,
    var fallenAsleep: int = 0,
    var running: ?Context = null,
    /// The contexts of this thread that wakers on other threads readied, which it moves to
    /// its ready queue at its next turn. The lock guards them and the poller a waker wakes: the
    /// thread's, as the runtime numbers it, from the thread's start to its end — 0 outside.
    inboxLock: SpinLock = SpinLock { },
    var inboxFirst: ?Context = null,
    var inboxLast: ?Context = null,
    var poller: int = 0,
    /// The signals' watcher where it waits for the poller to wake (lyr/signal.h).
    var pollerWaiter: ?Context = null,
    /// The register: the contexts that live on this thread, oldest
    /// first — each from its first turn to its end. The thread's own: no other touches it.
    var liveFirst: ?Context = null,
    var liveLast: ?Context = null,
    /// The thread is in its last turns: what lives on it is cancelled, and what begins now is.
    var ending: bool = false,
    /// Whether it is in the list of the schedulers that live (`living`), and its links there —
    /// under that list's guard.
    var joined: bool = false,
    var nextLiving: ?Scheduler = null,
    var prevLiving: ?Scheduler = null,
    /// The thread's random generator's state, `std.random`'s to lay out and to fill: made
    /// at its first use on the thread, as an array, so this module names no type of that one.
    var randomState: ?uint32[] = null,
    /// The tasks that wait on the poller for a descriptor, each in a slot: the
    /// token it armed with is its slot's number with a count above it, so a readiness that comes
    /// after its wait ended finds another token there and wakes nobody. The free slots are a
    /// stack; the turns count to the poll a busy thread makes now and then (`step`).
    var ioWaiting: (?Context)[] = [],
    var ioTokens: int[] = [],
    var ioFree: int[] = [],
    var ioFreeTop: int = 0,
    var ioMade: int = 0,
    var ioCount: int = 0,
    var ioNext: int = 0,
    var turns: int = 0,
    ioFired: int[] = [0] * 64,

    /// Records that the thread begins to run this scheduler: from here a waker on another thread
    /// wakes it.
    mut fn started(): void {
        this.inboxLock.acquire();
        this.poller = currentPoller();
        this.inboxLock.release();
    }

    /// Makes the running task — the signals' watcher — wait until the thread's poller wakes: a
    /// caught signal wakes it.
    mut fn awaitPoller(): void {
        let me = this.running ?? panic("a wait where no task runs");
        me.beginWait();
        this.pollerWaiter = me;
        park();
        me.endWait();
    }

    /// Wakes the task waiting for the poller, once the poller woke the thread.
    mut fn pollerWoke(): void {
        if (let w = this.pollerWaiter) {
            this.pollerWaiter = null;
            this.wakeUp(w);
        }
    }

    /// Wakes the thread from its wait on the poller, to look at what another thread changed.
    mut fn nudge(): void {
        this.inboxLock.acquire();
        if (this.poller != 0) {
            wakePoller(this.poller);
        }
        this.inboxLock.release();
    }

    /// Records that the thread ends: no waker wakes its poller from here on — it goes with the
    /// thread.
    mut fn stopped(): void {
        this.inboxLock.acquire();
        this.poller = 0;
        this.inboxLock.release();
    }

    /// Puts `c` at the end of the ready queue.
    mut fn ready(c: Context): void {
        c.next = null;
        c.prev = null;
        if (let tail = this.last) {
            tail.next = c;
        } else {
            this.first = c;
        }
        this.last = c;
    }

    mut fn takeReady(): ?Context {
        let head = this.first;
        if (head == null) {
            return null;
        }
        this.first = head.next;
        if (head.next == null) {
            this.last = null;
        }
        head.next = null;
        return head;
    }

    mut fn sleep(nanos: int): void throws Cancelled {
        let c = this.running ?? panic("a sleep where no task runs");
        if (atomicLoad(&c.cancelled)) {
            throw Cancelled { };
        }
        c.beginWait();
        this.fallAsleep(c, nanos);
        this.wakeIfCancelled(c);
        park();
        c.endWait();
        this.unsleep(c);
        if (atomicLoad(&c.cancelled)) {
            throw Cancelled { };
        }
    }

    /// Makes the running task wait until `fd` is ready as `interest` says — 1 to read, 2 to write
    /// (lyr/poll.h): a socket's call that would block. Returns 0, or the poller's failure as
    /// lyr/fs.h writes one.
    ///
    /// The descriptor is armed before the wait begins: its readiness is seen only after the task
    /// has parked, by this thread's next turn, and a failed arm leaves no wait behind. The task is
    /// in the socket's `waits` while it waits, so a close on any thread ends the wait; where the
    /// close came first, there is none.
    ///
    /// # Errors
    /// Throws [Cancelled] in a cancelled task; a cancel also ends the wait.
    mut fn awaitReady(fd: int, interest: int, waits: Waits): int throws Cancelled {
        let c = this.running ?? panic("a wait where no task runs");
        if (atomicLoad(&c.cancelled)) {
            throw Cancelled { };
        }
        let token = this.ioEnter(c);
        let armed = armOnPoller(fd, interest, token);
        if (armed < 0) {
            this.ioLeave(token);
            return armed;
        }
        c.beginWait();
        if (!waits.enter(c, interest)) {
            // closed before the wait: it ends at once, as a cancel's does
            this.wakeUp(c);
        }
        this.wakeIfCancelled(c);
        park();
        c.endWait();
        waits.leave(c, interest);
        this.ioLeave(token);
        if (atomicLoad(&c.cancelled)) {
            throw Cancelled { };
        }
        return 0;
    }

    /// Gives `c` a slot among the descriptors' waiters and returns its token.
    mut fn ioEnter(c: Context): int {
        var slot = this.ioMade;
        if (this.ioFreeTop > 0) {
            this.ioFreeTop -= 1;
            slot = this.ioFree[this.ioFreeTop];
        } else {
            if (slot == this.ioTokens.length()) {
                let room = if (slot == 0) 16 else slot * 2;
                let none: ?Context = null;
                let waiting = filled(room, none);
                let tokens: int[] = [0] * room;
                let free: int[] = [0] * room;
                this.ioWaiting[..].copyInto(waiting[..]);
                this.ioTokens[..].copyInto(tokens[..]);
                this.ioWaiting = waiting;
                this.ioTokens = tokens;
                this.ioFree = free;
            }
            this.ioMade += 1;
        }
        // a count above the slot's 24 bits, from 1: no token is 0, and none outlives its wait
        this.ioNext = this.ioNext % 549755813887 + 1;
        let token = (this.ioNext << 24) | slot;
        this.ioWaiting[slot] = c;
        this.ioTokens[slot] = token;
        this.ioCount += 1;
        return token;
    }

    /// Frees the slot of `token`.
    mut fn ioLeave(token: int): void {
        let slot = token & 16777215;
        this.ioWaiting[slot] = null;
        this.ioTokens[slot] = 0;
        this.ioFree[this.ioFreeTop] = slot;
        this.ioFreeTop += 1;
        this.ioCount -= 1;
    }

    /// Takes the readinesses the poller saw: their waiters run again, where they still wait.
    mut fn takeFired(): void {
        loop {
            let n = takeFromPoller(this.ioFired[..]);
            var i = 0;
            while (i < n) {
                let token = this.ioFired[i];
                let slot = token & 16777215;
                if (slot < this.ioTokens.length() && this.ioTokens[slot] == token) {
                    if (let c = this.ioWaiting[slot]) {
                        this.wakeUp(c);
                    }
                }
                i += 1;
            }
            if (n < this.ioFired.length()) {
                return;
            }
        }
    }

    /// Puts `c` into the sleepers' heap, to wake once `nanos` have passed.
    mut fn fallAsleep(c: Context, nanos: int): void {
        let now = monotonicNanos();
        c.deadline = if (nanos > 9223372036854775807 - now) 9223372036854775807 else now + nanos;
        c.order = this.fallenAsleep;
        this.fallenAsleep += 1;
        c.asleep = true;
        this.sleepers = merge(this.sleepers, c);
        if (let root = this.sleepers) {
            root.up = null;
        }
    }

    /// Ends at once a wait that began in a cancelled task: the cancel may have come from
    /// another thread before the wait began, and found nothing to claim. Between a wait's beginning
    /// and its park — the mark and the claim are atomic, so of the cancel and the wait one sees the
    /// other.
    mut fn wakeIfCancelled(c: Context): void {
        if (atomicLoad(&c.cancelled)) {
            this.wakeUp(c);
        }
    }

    /// Ends `c`'s wait, where it still waits and nothing ended it first — the claim — and readies
    /// it: true then.
    mut fn wakeUp(c: Context): bool {
        if (!c.claim()) {
            return false;
        }
        this.post(c);
        return true;
    }

    /// Puts `c`, whose wait a waker ended, into the ready queue of its own scheduler — through
    /// that scheduler's inbox where the waker runs on another thread.
    mut fn post(c: Context): void {
        let home = c.home;
        if (same(home, this)) {
            home.ready(c);
        } else {
            home.handOver(c);
        }
    }

    /// Puts `c` into the inbox for a waker on another thread, and wakes the thread for it.
    mut fn handOver(c: Context): void {
        this.inboxLock.acquire();
        c.next = null;
        if (let tail = this.inboxLast) {
            tail.next = c;
        } else {
            this.inboxFirst = c;
        }
        this.inboxLast = c;
        if (this.poller != 0) {
            wakePoller(this.poller);
        }
        this.inboxLock.release();
    }

    /// Moves the contexts that wakers on other threads readied to the ready queue, in the order
    /// they came.
    mut fn takeInbox(): void {
        this.inboxLock.acquire();
        var at = this.inboxFirst;
        this.inboxFirst = null;
        this.inboxLast = null;
        this.inboxLock.release();
        while (let c = at) {
            at = c.next;
            this.ready(c);
        }
    }

    mut fn yieldNow(): void throws Cancelled {
        let c = this.running ?? panic("a yield where no task runs");
        if (atomicLoad(&c.cancelled)) {
            throw Cancelled { };
        }
        this.ready(c);
        park();
        if (atomicLoad(&c.cancelled)) {
            throw Cancelled { };
        }
    }

    /// Makes the running context wait in `list` until it is woken — a wait that ignores the mark: its
    /// caller decides what a cancel means to it.
    mut fn parkIn(list: Waiters): void {
        let me = this.running ?? panic("a wait where no task runs");
        me.beginWait();
        me.awaits = true;
        list.add(me);
        park();
        me.endWait();
        list.remove(me);
    }

    /// Cancels a context: the mark, and the end of the wait it is in now, if any.
    mut fn cancel(c: Context): void {
        atomicStore(&c.cancelled, true);
        this.wakeUp(c);
    }

    /// Wakes the sleepers whose deadline came, earliest first; one that another waker claimed
    /// meanwhile only leaves the heap.
    mut fn wakeSleepers(now: int): void {
        while (let top = this.sleepers) {
            if (top.deadline > now) {
                return;
            }
            this.unsleep(top);
            this.wakeUp(top);
        }
    }

    /// Takes a sleeper out of the heap, wherever it is: its children merged in its place, and the
    /// ranks above it set right again. Nothing where `c` does not sleep.
    mut fn unsleep(c: Context): void {
        if (!c.asleep) {
            return;
        }
        let merged = merge(c.left, c.right);
        let parent = c.up;
        if (let m = merged) {
            m.up = parent;
        }
        if (let p = parent) {
            if (let l = p.left) {
                if (same(l, c)) {
                    p.left = merged;
                } else {
                    p.right = merged;
                }
            } else {
                p.right = merged;
            }
            fixRanks(p);
        } else {
            this.sleepers = merged;
        }
        c.left = null;
        c.right = null;
        c.up = null;
        c.rank = 0;
        c.asleep = false;
    }

    /// Settles a context that ended by a panic: its held locks come free, its task becomes
    /// Panicked, and one without a handle — main's, a detached task's — ends the process with the
    /// panic.
    mut fn panicked(c: Context): void {
        let info = PanicInfo {
            code = panicCode(c.body) ?? "",
            message = panicMessage(c.body) ?? "",
            trace = panicTrace(c.body) ?? "",
        };
        c.dropHeld(this, info);
        if (let handler = c.onPanic) {
            handler(info);
        } else {
            repanic(info.code, info.message, info.trace);
        }
    }

    /// Runs one turn: the next ready context runs until it waits; with none ready, the thread waits for
    /// the earliest sleeper — without end where there is none, until another thread wakes it.
    mut fn step(): void {
        this.takeInbox();
        if (this.sleepers != null) {
            this.wakeSleepers(monotonicNanos());
        }
        if (this.ioCount > 0) {
            // a thread that is never idle asks the poller every 61 turns, so a socket's readiness
            // does not wait for the busy tasks to end
            this.turns += 1;
            if (this.turns % 61 == 0) {
                if (waitOnPoller(0)) {
                    this.pollerWoke();
                }
                this.takeFired();
                // the wake this poll consumed may have carried a hand-over from another thread:
                // the inbox once more, or the wait below sleeps on a context already posted and
                // nobody wakes it again
                this.takeInbox();
            }
        }
        if (let c = this.takeReady()) {
            if (!c.live) {
                this.admit(c);
            }
            this.running = c;
            let state = resumeContext(c.body);
            this.running = null;
            if (state != 0) {
                this.dismiss(c);
            }
            if (state == 2) {
                this.panicked(c);
            }
            return;
        }
        let top = this.sleepers;
        if (top == null) {
            if (this.deadlock()) {
                return;
            }
            waitOnPoller(-1);
            this.pollerWoke();
            this.takeFired();
            return;
        }
        let left = top.deadline - monotonicNanos();
        waitOnPoller(if (left > 0) left else 0);
        this.pollerWoke();
        this.takeFired();
    }

    /// Admits `c` at its first turn: from here it lives on this thread. On a thread in its last turns
    /// it is cancelled as it begins.
    mut fn admit(c: Context): void {
        c.live = true;
        c.livePrev = this.liveLast;
        c.liveNext = null;
        if (let tail = this.liveLast) {
            tail.liveNext = c;
        } else {
            this.liveFirst = c;
        }
        this.liveLast = c;
        if (this.ending) {
            atomicStore(&c.cancelled, true);
        }
    }

    /// Takes `c` out of the register once it has ended — its body returned, or it panicked.
    mut fn dismiss(c: Context): void {
        c.live = false;
        if (let p = c.livePrev) {
            p.liveNext = c.liveNext;
        } else {
            this.liveFirst = c.liveNext;
        }
        if (let n = c.liveNext) {
            n.livePrev = c.livePrev;
        } else {
            this.liveLast = c.livePrev;
        }
        c.livePrev = null;
        c.liveNext = null;
    }

    /// Returns whether another thread has handed a context over that this one has not taken yet.
    fn pending(): bool {
        this.inboxLock.acquire();
        let some = this.inboxFirst != null;
        this.inboxLock.release();
        return some;
    }

    /// Detects a deadlock where nothing is ready and nothing sleeps. Where no other thread lives
    /// either, and none has handed anything over, nothing can end a wait of this thread any more:
    /// one of its waiting tasks is marked and woken, and panics in its wait — true then. The
    /// oldest that waits for something other than a task's end: its panic passes to whoever
    /// awaits it, with the frames of the wait that is the reason. Where each waits for another,
    /// the oldest.
    ///
    /// The count is read BEFORE the inbox: a thread that ends hands its last wake-ups over before
    /// it leaves the count, so with the count at one they are all there to be seen. A task that
    /// waits on a descriptor waits on the system, which may end it: no deadlock while one does. A file's call waits on the pool, a thread that lives.
    mut fn deadlock(): bool {
        if (this.liveFirst == null || this.ioCount > 0 || living.others(this) || this.pending()) {
            return false;
        }
        var at = this.liveFirst;
        while (let c = at) {
            if (!c.awaits && this.wakeStuck(c)) {
                return true;
            }
            at = c.liveNext;
        }
        at = this.liveFirst;
        while (let c = at) {
            if (this.wakeStuck(c)) {
                return true;
            }
            at = c.liveNext;
        }
        return false;
    }

    /// Marks `c` and ends its wait: true where it waited and nothing else ended the wait first.
    mut fn wakeStuck(c: Context): bool {
        c.stuck = true;
        if (this.wakeUp(c)) {
            return true;
        }
        c.stuck = false;
        return false;
    }

    /// Runs the thread's last turns, once its first task has ended: what still
    /// lives on it is cancelled — and what begins now, as it begins —, and the thread runs until
    /// all of it has ended.
    mut fn wind(): void {
        this.ending = true;
        var at = this.liveFirst;
        while (let c = at) {
            at = c.liveNext;
            this.cancel(c);
        }
        while (this.liveFirst != null || this.first != null || this.pending()) {
            this.step();
        }
    }
}

/// The schedulers that live beside another — the threads that run tasks, once there is more than
/// one — and how many: a thread that finds itself the only one, with nothing
/// ready and nothing asleep, knows that no wait of its tasks can end. One is added by whoever
/// STARTS its thread, before the thread runs — a thread that waits for one it just started is not
/// alone —, and takes itself out at its end; it then nudges the others, which may be asleep on
/// their pollers, to look again.
class Living {
    guard: SpinLock = SpinLock { },
    var first: ?Scheduler = null,
    var count: int = 0, // atomic: written under the guard, read without it

    mut fn join(s: Scheduler): void {
        if (s.joined) {
            return;
        }
        this.guard.acquire();
        s.joined = true;
        s.prevLiving = null;
        s.nextLiving = this.first;
        if (let head = this.first) {
            head.prevLiving = s;
        }
        this.first = s;
        atomicFetchAndAdd(&this.count, 1);
        this.guard.release();
    }

    mut fn leave(s: Scheduler): void {
        this.guard.acquire();
        if (let p = s.prevLiving) {
            p.nextLiving = s.nextLiving;
        } else {
            this.first = s.nextLiving;
        }
        if (let n = s.nextLiving) {
            n.prevLiving = s.prevLiving;
        }
        s.prevLiving = null;
        s.nextLiving = null;
        s.joined = false;
        atomicFetchAndAdd(&this.count, -1);
        var at = this.first;
        while (let other = at) {
            other.nudge();
            at = other.nextLiving;
        }
        this.guard.release();
    }

    /// Returns whether a scheduler lives beside `s`, which asks: one that never joined — the program's
    /// only thread so far — is not in the count. (Through the reference: a load writes nothing,
    /// and a place of 'this' is a 'mut fn''s to hand on.)
    fn others(s: Scheduler): bool {
        let me = this;
        return atomicLoad(&me.count) > (if (s.joined) 1 else 0);
    }
}

let living = Living { };

/// Registers `s`, whose thread is about to start, as living from here on, and so the scheduler of
/// the task that starts it. The main thread's joins this way, with the first thread the program
/// starts — `runMain` cannot do it: it runs before the module's bindings are filled, and `living`
/// is one of them.
fn enlist(s: Scheduler): void {
    if (let mine = currentScheduler()) {
        living.join(mine);
    }
    living.join(s);
}

/// The ids of the channels, in the order they were made: the order of their locks. Atomic.
@Allow("global-var-without-sync")
var channelIds: int = 0;

/// Returns the running thread's scheduler: there is one wherever a task runs.
///
/// # Panics
/// Where no scheduler runs on the thread.
fn here(): Scheduler {
    return currentScheduler() ?? panic("a wait where no task runs");
}

/// Makes the running task wait until `fd` is ready to read (1) or to write (2), for std.net's
/// sockets, `waits` being the socket's. Returns 0, or the poller's failure as lyr/fs.h writes
/// one; a close ends the wait as a readiness does.
///
/// # Errors
/// Throws [Cancelled] in a cancelled task.
fn awaitDescriptor(fd: int, interest: int, waits: Waits): int throws Cancelled {
    return try here().awaitReady(fd, interest, waits);
}

/// Takes `fd` out of the running thread's poller, before it is closed: a task of the thread that waits
/// on it runs again, and finds it closed.
fn forgetDescriptor(fd: int): void {
    forgetOnPoller(fd);
}

/// Returns the running thread's random generator's state, if it has one yet (std.random's free
/// forms).
fn threadRandomState(): ?uint32[] {
    return here().randomState;
}

/// Keeps `state` as the running thread's random generator's.
fn keepThreadRandomState(state: uint32[]): void {
    here().randomState = state;
}

/// Merges two heaps of sleepers into one: the earlier root on top, the other merged down its right
/// spine, whose length stays logarithmic. The caller sets the result's parent.
fn merge(a: ?Context, b: ?Context): ?Context {
    if (a == null) {
        return b;
    }
    if (b == null) {
        return a;
    }
    if (b.deadline < a.deadline || (b.deadline == a.deadline && b.order < a.order)) {
        return meld(b, a);
    }
    return meld(a, b);
}

fn meld(top: Context, other: Context): Context {
    let below = merge(top.right, other);
    if (let b = below) {
        b.up = top;
    }
    top.right = below;
    let l = rankOf(top.left);
    let r = rankOf(top.right);
    if (l < r) {
        let swap = top.left;
        top.left = top.right;
        top.right = swap;
        top.rank = l + 1;
    } else {
        top.rank = r + 1;
    }
    return top;
}

/// Restores the heap after it changed below `from`: each node up the path keeps its children
/// leftist and its rank right, until a rank stays as it was.
fn fixRanks(from: Context): void {
    var at: ?Context = from;
    while (let n = at) {
        let l = rankOf(n.left);
        let r = rankOf(n.right);
        if (l < r) {
            let swap = n.left;
            n.left = n.right;
            n.right = swap;
        }
        let rank = (if (l < r) l else r) + 1;
        if (rank == n.rank) {
            return;
        }
        n.rank = rank;
        at = n.up;
    }
}

fn rankOf(c: ?Context): int {
    if (c == null) {
        return 0;
    }
    return c.rank;
}

/// Runs the program's scheduler loop where `main` is a task; the runtime calls it with main's
/// context. It runs until that context is done — the program ends with main, and what is still
/// ready or asleep then never runs again.
///
/// It runs BEFORE the module-level bindings are filled: those are filled at the start of main's
/// first turn, inside the first `step`. Nothing above that turn reads one.
fn runMain(main: Coroutine<void>): void {
    let s = Scheduler { };
    setCurrentScheduler(s);
    s.started();
    s.ready(Context { body = main, home = s });
    while (!main.isDone()) {
        s.step();
    }
    s.stopped();
    setCurrentScheduler(null);
}

// The runtime's side, the module's own.

/// Creates a task's context around `body` on a stack of its own — `stack` bytes, 0 for the
/// default: a coroutine that yields nothing, whose body only ever parks.
fn startContext(body: fn() -> void, stack: int): Coroutine<void>;

/// Parks the running chain at the scheduler.
fn park(): void;

/// Panics for a wait nothing can end: `LYR-RT0018`.
fn deadlocked(): never;

/// Panics for an acquire on a poisoned lock: `LYR-RT0019`, naming the first panic.
fn poisonedBy(code: string, message: string): never;

/// Resumes a task's context until it parks (0), its body returns (1) or it panics (2): a panic
/// stays the context's, for the scheduler to settle.
fn resumeContext(c: Coroutine<void>): int;

/// The report a panicked context left; null where it did not panic.
fn panicCode(c: Coroutine<void>): ?string;
fn panicMessage(c: Coroutine<void>): ?string;
fn panicTrace(c: Coroutine<void>): ?string;

/// Panics again, with the report an earlier panic left: its code, its message, its frames.
fn repanic(code: string, message: string, trace: string): never;

/// The running thread's scheduler, as `runMain` set it.
fn currentScheduler(): ?Scheduler;
fn setCurrentScheduler(s: ?Scheduler): void;

/// Returns whether a scheduler runs on this thread — the question the I/O pool's callers ask:
/// where one runs, a blocking call goes to the pool and the task parks; where none runs, nothing
/// else waits on the thread and the call runs on it. **Asking makes no task of `main`**: the
/// compiler's walk for that decision does not follow the branch this answers yes,
/// so a program that only reads a file keeps main off the scheduler.
fn schedulerRuns(): bool;

/// Waits on the thread's poller for `nanos` at most, a negative one without end; returns true
/// when woken.
fn waitOnPoller(nanos: int): bool;

/// Returns the monotonic clock's reading, in nanoseconds.
fn monotonicNanos(): int;

/// Starts a thread of the program that runs `body` on its own stack.
fn startThread(body: fn() -> void): void;

/// The running thread's poller as the runtime numbers it, and the wake of a poller so numbered —
/// from any thread, while its thread runs.
fn currentPoller(): int;
fn wakePoller(poller: int): void;

/// A descriptor's readiness on the running thread's poller (lyr/task.h): armed with a
/// waiter's token, out of the poller before its close, and the tokens fired since the last take.
fn armOnPoller(fd: int, interest: int, token: int): int;
fn forgetOnPoller(fd: int): void;
fn takeFromPoller(into: Slice<int>): int;

/// A thread that spins on a lock lets another run.
fn spin(): void;

/// The atomic operations (lyr/atomic.h), each on a PLACE: a field of the
/// scheduler's own, or the value of std.sync's `Atomic<T>`, which is built on
/// these. Sequentially consistent, and one for every type the machine reads and writes in one
/// step. A place one of them writes is read and written through them alone.
fn atomicLoad<T>(&at: T): T;
fn atomicStore<T>(&at: T, value: T): void;
fn atomicExchange<T>(&at: T, value: T): T;

/// Writes `desired` where the place held `expected` and returns true then, in one step.
fn atomicCompareAndSet<T>(&at: T, expected: T, desired: T): bool;

/// Adds `n` and returns the value before. It wraps around, as `+%` does.
fn atomicFetchAndAdd(&at: int, n: int): int;
