// ---------------------------------------------------------------------------------------------
// The digests. Each holds its state in arrays and hands its whole blocks to its compression;
// `finish` pads a copy, so the digest goes on as it was.
// ---------------------------------------------------------------------------------------------

/// SHA-256 (FIPS 180-4 §6.2): 32 bytes of hash over blocks of 64.
pub class Sha256 :: [Digest] {
    state: uint32[],
    scratch: uint32[],
    blocks: Blocks,

    pub static let size: int = 32;
    pub static let blockSize: int = 64;

    pub static fn new(): Sha256 {
        return Sha256 { state = sha256H.clone(), scratch = [0u32] * 64, blocks = Blocks.new(64) };
    }

    pub mut fn update(bytes: Slice<uint8>): void {
        let h = this.state;
        let w = this.scratch;
        this.blocks.feed(bytes, (b) => sha256Block(h, b, w));
    }

    pub fn finish(): uint8[] {
        let h = this.state.clone();
        let w: uint32[] = [0u32] * 64;
        let tail = this.blocks.tail(8, true);
        var at = 0;
        while (at < tail.length()) {
            sha256Block(h, tail[at..at + 64], w);
            at = at + 64;
        }
        return wordsBE32(h);
    }
}

fn sha256Block(h: uint32[], block: Slice<uint8>, w: uint32[]): void {
    var t = 0;
    while (t < 16) {
        w[t] = word32BE(block, 4 * t);
        t = t + 1;
    }
    while (t < 64) {
        let s0 = rotr32(w[t - 15], 7) ^ rotr32(w[t - 15], 18) ^ (w[t - 15] >> 3);
        let s1 = rotr32(w[t - 2], 17) ^ rotr32(w[t - 2], 19) ^ (w[t - 2] >> 10);
        w[t] = w[t - 16] +% s0 +% w[t - 7] +% s1;
        t = t + 1;
    }
    var a = h[0];
    var b = h[1];
    var c = h[2];
    var d = h[3];
    var e = h[4];
    var f = h[5];
    var g = h[6];
    var k = h[7];
    t = 0;
    while (t < 64) {
        let t1 = k +% (rotr32(e, 6) ^ rotr32(e, 11) ^ rotr32(e, 25)) +% ((e & f) ^ (~e & g)) +% sha256K[t] +% w[t];
        let t2 = (rotr32(a, 2) ^ rotr32(a, 13) ^ rotr32(a, 22)) +% ((a & b) ^ (a & c) ^ (b & c));
        k = g;
        g = f;
        f = e;
        e = d +% t1;
        d = c;
        c = b;
        b = a;
        a = t1 +% t2;
        t = t + 1;
    }
    h[0] = h[0] +% a;
    h[1] = h[1] +% b;
    h[2] = h[2] +% c;
    h[3] = h[3] +% d;
    h[4] = h[4] +% e;
    h[5] = h[5] +% f;
    h[6] = h[6] +% g;
    h[7] = h[7] +% k;
}

/// SHA-512 (FIPS 180-4 §6.4): 64 bytes of hash over blocks of 128.
pub class Sha512 :: [Digest] {
    state: uint64[],
    scratch: uint64[],
    blocks: Blocks,

    pub static let size: int = 64;
    pub static let blockSize: int = 128;

    pub static fn new(): Sha512 {
        return Sha512 { state = sha512H.clone(), scratch = [0u64] * 80, blocks = Blocks.new(128) };
    }

    pub mut fn update(bytes: Slice<uint8>): void {
        let h = this.state;
        let w = this.scratch;
        this.blocks.feed(bytes, (b) => sha512Block(h, b, w));
    }

    pub fn finish(): uint8[] {
        let h = this.state.clone();
        let w: uint64[] = [0u64] * 80;
        let tail = this.blocks.tail(16, true);
        var at = 0;
        while (at < tail.length()) {
            sha512Block(h, tail[at..at + 128], w);
            at = at + 128;
        }
        return wordsBE64(h);
    }
}

fn sha512Block(h: uint64[], block: Slice<uint8>, w: uint64[]): void {
    var t = 0;
    while (t < 16) {
        w[t] = ((word32BE(block, 8 * t) as uint64) << 32) | (word32BE(block, 8 * t + 4) as uint64);
        t = t + 1;
    }
    while (t < 80) {
        let s0 = rotr64(w[t - 15], 1) ^ rotr64(w[t - 15], 8) ^ (w[t - 15] >> 7);
        let s1 = rotr64(w[t - 2], 19) ^ rotr64(w[t - 2], 61) ^ (w[t - 2] >> 6);
        w[t] = w[t - 16] +% s0 +% w[t - 7] +% s1;
        t = t + 1;
    }
    var a = h[0];
    var b = h[1];
    var c = h[2];
    var d = h[3];
    var e = h[4];
    var f = h[5];
    var g = h[6];
    var k = h[7];
    t = 0;
    while (t < 80) {
        let t1 = k +% (rotr64(e, 14) ^ rotr64(e, 18) ^ rotr64(e, 41)) +% ((e & f) ^ (~e & g)) +% sha512K[t] +% w[t];
        let t2 = (rotr64(a, 28) ^ rotr64(a, 34) ^ rotr64(a, 39)) +% ((a & b) ^ (a & c) ^ (b & c));
        k = g;
        g = f;
        f = e;
        e = d +% t1;
        d = c;
        c = b;
        b = a;
        a = t1 +% t2;
        t = t + 1;
    }
    h[0] = h[0] +% a;
    h[1] = h[1] +% b;
    h[2] = h[2] +% c;
    h[3] = h[3] +% d;
    h[4] = h[4] +% e;
    h[5] = h[5] +% f;
    h[6] = h[6] +% g;
    h[7] = h[7] +% k;
}

/// SHA-1 (FIPS 180-4 §6.1): 20 bytes over blocks of 64. Broken for collisions (SHAttered, 2017):
/// for what an old format asks — git's object names, a checksum —, never for a signature.
pub class Sha1 :: [Digest] {
    state: uint32[],
    scratch: uint32[],
    blocks: Blocks,

    pub static let size: int = 20;
    pub static let blockSize: int = 64;

    pub static fn new(): Sha1 {
        let h: uint32[] = [0x67452301u32, 0xefcdab89u32, 0x98badcfeu32, 0x10325476u32, 0xc3d2e1f0u32];
        return Sha1 { state = h, scratch = [0u32] * 80, blocks = Blocks.new(64) };
    }

    pub mut fn update(bytes: Slice<uint8>): void {
        let h = this.state;
        let w = this.scratch;
        this.blocks.feed(bytes, (b) => sha1Block(h, b, w));
    }

    pub fn finish(): uint8[] {
        let h = this.state.clone();
        let w: uint32[] = [0u32] * 80;
        let tail = this.blocks.tail(8, true);
        var at = 0;
        while (at < tail.length()) {
            sha1Block(h, tail[at..at + 64], w);
            at = at + 64;
        }
        return wordsBE32(h);
    }
}

fn sha1Block(h: uint32[], block: Slice<uint8>, w: uint32[]): void {
    var t = 0;
    while (t < 16) {
        w[t] = word32BE(block, 4 * t);
        t = t + 1;
    }
    while (t < 80) {
        w[t] = rotl32(w[t - 3] ^ w[t - 8] ^ w[t - 14] ^ w[t - 16], 1);
        t = t + 1;
    }
    var a = h[0];
    var b = h[1];
    var c = h[2];
    var d = h[3];
    var e = h[4];
    t = 0;
    while (t < 80) {
        let f = if (t < 20) (b & c) | (~b & d) else if (t < 40) b ^ c ^ d else if (t < 60) (b & c) | (b & d) | (c & d) else b ^ c ^ d;
        let temp = rotl32(a, 5) +% f +% e +% sha1K[t / 20] +% w[t];
        e = d;
        d = c;
        c = rotl32(b, 30);
        b = a;
        a = temp;
        t = t + 1;
    }
    h[0] = h[0] +% a;
    h[1] = h[1] +% b;
    h[2] = h[2] +% c;
    h[3] = h[3] +% d;
    h[4] = h[4] +% e;
}

let md5Shifts: int[] = [7, 12, 17, 22, 5, 9, 14, 20, 4, 11, 16, 23, 6, 10, 15, 21];

/// MD5 (RFC 1321): 16 bytes over blocks of 64. Broken for collisions since 2004: for what an old
/// format asks, never where an attacker chooses the input.
pub class Md5 :: [Digest] {
    state: uint32[],
    blocks: Blocks,

    pub static let size: int = 16;
    pub static let blockSize: int = 64;

    pub static fn new(): Md5 {
        let h: uint32[] = [0x67452301u32, 0xefcdab89u32, 0x98badcfeu32, 0x10325476u32];
        return Md5 { state = h, blocks = Blocks.new(64) };
    }

    pub mut fn update(bytes: Slice<uint8>): void {
        let h = this.state;
        this.blocks.feed(bytes, (b) => md5Block(h, b));
    }

    pub fn finish(): uint8[] {
        let h = this.state.clone();
        let tail = this.blocks.tail(8, false);
        var at = 0;
        while (at < tail.length()) {
            md5Block(h, tail[at..at + 64]);
            at = at + 64;
        }
        return wordsLE32(h);
    }
}

fn md5Block(h: uint32[], block: Slice<uint8>): void {
    var a = h[0];
    var b = h[1];
    var c = h[2];
    var d = h[3];
    var i = 0;
    while (i < 64) {
        var f: uint32 = 0;
        var g = 0;
        if (i < 16) {
            f = (b & c) | (~b & d);
            g = i;
        } else if (i < 32) {
            f = (d & b) | (~d & c);
            g = (5 * i + 1) % 16;
        } else if (i < 48) {
            f = b ^ c ^ d;
            g = (3 * i + 5) % 16;
        } else {
            f = c ^ (b | ~d);
            g = (7 * i) % 16;
        }
        let sum = f +% a +% md5K[i] +% word32LE(block, 4 * g);
        a = d;
        d = c;
        c = b;
        b = b +% rotl32(sum, md5Shifts[(i / 16) * 4 + i % 4]);
        i = i + 1;
    }
    h[0] = h[0] +% a;
    h[1] = h[1] +% b;
    h[2] = h[2] +% c;
    h[3] = h[3] +% d;
}

/// SHA-256 of `bytes`, at once (10 Q4).
pub fn sha256(bytes: Slice<uint8>): uint8[32] {
    let d = Sha256.new();
    d.update(bytes);
    let all = d.finish();
    var out: uint8[32] = [0u8] * 32;
    var i = 0;
    while (i < 32) {
        out[i] = all[i];
        i = i + 1;
    }
    return out;
}

// ---------------------------------------------------------------------------------------------
// HMAC (RFC 2104).
// ---------------------------------------------------------------------------------------------

/// A message authentication code over a digest (RFC 2104): `Hmac<Sha256>.new(key)`, then `update`
/// and `finish` as a digest's. Compare what it gives with `constantTimeEq`, not `==`.
pub class Hmac<D :: [Digest]> {
    var inner: D,
    outer: uint8[],

    pub static fn new(key: Slice<uint8>): Hmac<D> {
        // a key longer than a block is hashed first; a shorter one is padded with zeros
        let k: uint8[] = [0u8] * D.blockSize;
        if (key.length() > D.blockSize) {
            var hashed = D.new();
            hashed.update(key);
            hashed.finish().copyInto(k[..]);
        } else {
            key.copyInto(k[..]);
        }
        let ipad: uint8[] = [0u8] * D.blockSize;
        let opad: uint8[] = [0u8] * D.blockSize;
        var i = 0;
        while (i < D.blockSize) {
            ipad[i] = k[i] ^ 0x36u8;
            opad[i] = k[i] ^ 0x5cu8;
            i = i + 1;
        }
        var inner = D.new();
        inner.update(ipad[..]);
        return Hmac<D> { inner = inner, outer = opad };
    }

    pub mut fn update(bytes: Slice<uint8>): void {
        this.inner.update(bytes);
    }

    pub fn finish(): uint8[] {
        let first = this.inner.finish();
        var outer = D.new();
        outer.update(this.outer[..]);
        outer.update(first[..]);
        return outer.finish();
    }
}

// ---------------------------------------------------------------------------------------------
// The system's randomness, and comparing secrets.
// ---------------------------------------------------------------------------------------------

/// `n` random bytes from the system (getrandom, getentropy, RtlGenRandom). A system that gives
/// none panics (`LYR-RT0015`): there is no way on without them.
pub fn randomBytes(n: int): uint8[] {
    let out: uint8[] = [0u8] * n;
    var i = 0;
    while (i < n) {
        let r = lyr_random_u64();
        var k = 0;
        while (k < 8 && i < n) {
            out[i] = ((r >> (8 * k)) & 0xFFu64) as uint8;
            i = i + 1;
            k = k + 1;
        }
    }
    return out;
}

/// 64 random bits from the system.
pub fn randomUint64(): uint64 {
    return lyr_random_u64();
}

/// Whether `a` and `b` hold the same bytes, in a time that depends on their length alone — not on
/// where they first differ, which a comparison that stops there tells whoever measures it. The
/// lengths are no secret: a MAC's is known.
pub fn constantTimeEq(a: Slice<uint8>, b: Slice<uint8>): bool {
    if (a.length() != b.length()) {
        return false;
    }
    var diff = 0u8;
    var i = 0;
    while (i < a.length()) {
        diff = diff | (a[i] ^ b[i]);
        i = i + 1;
    }
    return diff == 0u8;
}

// ---------------------------------------------------------------------------------------------
// What every digest here shares: blocks taken from what is fed, the padding at the end (FIPS
// 180-4 §5.1, RFC 1321 §3.1–3.2), words read and written either end first.
// ---------------------------------------------------------------------------------------------

/// What a digest was fed and has not hashed yet — less than a block —, and the count of all.
class Blocks {
    held: uint8[],
    var used: int = 0,
    var total: uint = 0,

    static fn new(size: int): Blocks {
        return Blocks { held = [0u8] * size };
    }

    /// `bytes` through the held block to `hash`, a whole block at a time; the rest waits.
    mut fn feed(bytes: Slice<uint8>, hash: fn(Slice<uint8>) -> void): void {
        let size = this.held.length();
        this.total = this.total +% (bytes.length() as uint);
        var at = 0;
        if (this.used > 0) {
            let n = if (size - this.used < bytes.length()) size - this.used else bytes.length();
            bytes[..n].copyInto(this.held[this.used..]);
            this.used = this.used + n;
            at = n;
            if (this.used < size) {
                return;
            }
            hash(this.held[..]);
            this.used = 0;
        }
        while (at + size <= bytes.length()) {
            hash(bytes[at..at + size]);
            at = at + size;
        }
        bytes[at..].copyInto(this.held[..]);
        this.used = bytes.length() - at;
    }

    /// The last block or two: what is held, a 1 bit, zeros, and the length in bits in `width`
    /// bytes at the end, the highest byte first or the lowest.
    fn tail(width: int, bigEndian: bool): uint8[] {
        let size = this.held.length();
        let out: uint8[] = [0u8] * (if (this.used < size - width) size else 2 * size);
        this.held[..this.used].copyInto(out[..]);
        out[this.used] = 0x80u8;
        // the count of bits: 64 of them from the bytes, and what overflows them for a 128-bit field
        let low = this.total << 3;
        let high = this.total >> 61;
        var k = 0;
        while (k < width) {
            let byte = if (k < 8) ((low >> (8 * k)) & 0xFF) as uint8 else ((high >> (8 * (k - 8))) & 0xFF) as uint8;
            out[if (bigEndian) out.length() - 1 - k else out.length() - width + k] = byte;
            k = k + 1;
        }
        return out;
    }
}

fn rotr32(x: uint32, n: int): uint32 {
    return (x >> n) | (x << (32 - n));
}

fn rotl32(x: uint32, n: int): uint32 {
    return (x << n) | (x >> (32 - n));
}

fn rotr64(x: uint64, n: int): uint64 {
    return (x >> n) | (x << (64 - n));
}

fn word32BE(s: Slice<uint8>, at: int): uint32 {
    return ((s[at] as uint32) << 24) | ((s[at + 1] as uint32) << 16) | ((s[at + 2] as uint32) << 8) | (s[at + 3] as uint32);
}

fn word32LE(s: Slice<uint8>, at: int): uint32 {
    return ((s[at + 3] as uint32) << 24) | ((s[at + 2] as uint32) << 16) | ((s[at + 1] as uint32) << 8) | (s[at] as uint32);
}

fn wordsBE32(h: uint32[]): uint8[] {
    let out: uint8[] = [0u8] * (4 * h.length());
    var i = 0;
    while (i < out.length()) {
        out[i] = ((h[i / 4] >> (24 - 8 * (i % 4))) & 0xFFu32) as uint8;
        i = i + 1;
    }
    return out;
}

fn wordsLE32(h: uint32[]): uint8[] {
    let out: uint8[] = [0u8] * (4 * h.length());
    var i = 0;
    while (i < out.length()) {
        out[i] = ((h[i / 4] >> (8 * (i % 4))) & 0xFFu32) as uint8;
        i = i + 1;
    }
    return out;
}

fn wordsBE64(h: uint64[]): uint8[] {
    let out: uint8[] = [0u8] * (8 * h.length());
    var i = 0;
    while (i < out.length()) {
        out[i] = ((h[i / 8] >> (56 - 8 * (i % 8))) & 0xFFu64) as uint8;
        i = i + 1;
    }
    return out;
}
