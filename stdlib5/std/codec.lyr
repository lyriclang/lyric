//! Serializes values in any format: `Encode` writes a value into an `Encoder`, `Decode` reads one
//! out of a `Decoder`, and `Codable` is both. A format — `std.json`, `std.toml` — is an encoder and
//! a decoder of its own; this module holds the pair, the container model the formats implement,
//! the errors (`DecodeError`, `EncodeError`), the conformances of the core types, the `@Codec`
//! attribute that steers the synthesized conformances, and `Value`, a tree of the ten forms that
//! any format could write — the format of no format, for tests and for data that is passed on
//! unread.
//!
//! `std.encoding` is a different module: it turns bytes into text and back (Base64,
//! hexadecimal); this one writes the form of a value, in whatever format.
//!
//! The model has ten forms: null, bool, int, uint, float, string, bytes, a sequence, a map, a
//! struct of named fields, and a variant of an enum with or without a payload. A format implements
//! the primitives of `Encoder` and `Decoder` — the scalars, and begin/end around the containers —;
//! over them lies the layer a conformance writes with: `e.field("id", this.id)` encodes a field,
//! `d.field<int>("id")` decodes one, `e.element(x)` and `d.next<T>()` an element. An encoder or a
//! decoder is passed by reference, `&e`, as a hasher is: a conformance is generic over the
//! format's type, and the format keeps its state.
//!
//! # Examples
//!
//! ```lyric
//! import std.io { println };
//! import std.codec { Codable, Codec, EncodeError };
//! import std.json;
//!
//! @Codec { rename = .SnakeCase }
//! struct Account :: [Codable] {
//!     userName: string,
//!     @Codec { skip = true }
//!     token: ?string,
//! }
//!
//! fn main(): void throws EncodeError {
//!     println(try json.encode(Account { userName = "ada", token = "secret" }));
//! }
//! ```
//!
//! ```output
//! {"user_name":"ada"}
//! ```
import std.collections { List, Map, Set, Deque };
import std.core {
    Hasher,
    ParseError,
    StringBuilder,
    OnField,
    OnType,
    fields,
    variants,
    attribute,
    typeAttribute,
    typeName,
    isEnum,
    FieldInfo,
};
import std.hash { DefaultHasher };
import std.time { Instant, Duration, Date, Time, DateTime };

// ------------------------------------------------------------------ the attribute

/// Selects how a field name is rewritten on the wire: as written, `camelCase`, or `snake_case`.
pub enum Case :: [Equatable, Debug] {
    Same,
    CamelCase,
    SnakeCase,
}

/// Steers the synthesized `encode` and `decode`. On a field, `@Codec { name = "user_id" }` writes
/// the field under that name, `@Codec { skip = true }` leaves it out (it reads as `null`, so it
/// is an optional); on an enum, `@Codec { tag = "kind" }` writes a variant as a struct holding
/// the tag beside the payload's fields (internally tagged); on a struct or a class,
/// `@Codec { rename = .SnakeCase }` rewrites every field's name and `@Codec { denyUnknown = true }`
/// refuses a field the data has and the type has not.
pub struct Codec :: [OnField, OnType] {
    pub name: string = "",
    pub skip: bool = false,
    pub tag: string = "",
    pub rename: Case = .Same,
    pub denyUnknown: bool = false,
}

/// Returns the name a field is written under: its own `@Codec { name }` where set, else its name
/// under the type's `rename`.
pub fn wireName(f: FieldInfo, own: ?Codec, type: ?Codec): string {
    if (let a = own) {
        if (a.name != "") {
            return a.name;
        }
    }
    if (let t = type) {
        if (t.rename == Case.SnakeCase) {
            return snakeCase(f.name);
        }
        if (t.rename == Case.CamelCase) {
            return camelCase(f.name);
        }
    }
    return f.name;
}

/// Returns `name` in snake case: `userId` as `user_id`. Every uppercase character becomes `_`
/// and its lowercase form.
pub fn snakeCase(name: string): string {
    let out = StringBuilder.new();
    for (c in name.chars()) {
        if (c.isUpper()) {
            out.appendChar('_');
            out.appendChar(c.toLower());
        } else {
            out.appendChar(c);
        }
    }
    return out.toString();
}

/// Returns `name` in camel case: `user_id` as `userId`. Every `_` is dropped and the character
/// after it is uppercased.
pub fn camelCase(name: string): string {
    let out = StringBuilder.new();
    var up = false;
    for (c in name.chars()) {
        if (c == '_') {
            up = true;
        } else if (up) {
            out.appendChar(c.toUpper());
            up = false;
        } else {
            out.appendChar(c);
        }
    }
    return out.toString();
}

/// Returns the names of `E`'s variants, in declaration order.
pub fn variantNames<E>(): string[] {
    let out = List<string>.new();
    comptime for (v in variants<E>()) {
        out.push(v.name);
    }
    return out.toArray();
}

// ------------------------------------------------------------------ the pair

/// A value that writes itself into any encoder.
@SeesConformer
pub interface Encode {
    /// Writes this value into `e`. Synthesized for a conformance without the member: a struct's
    /// fields in declaration order under their wire names, a `@Codec { skip }` field left out; an
    /// enum's variant — a unit one as its name, one payload field as the value, several as a
    /// sequence — or, under the enum's `@Codec { tag }`, as a struct of the tag and the payload's
    /// fields.
    ///
    /// # Errors
    ///
    /// Throws `EncodeError` where the encoder cannot hold a form or its writer fails.
    fn encode<E :: [Encoder]>(&e: E): void throws EncodeError {
        comptime if (isEnum<Self>()) {
            let tag = typeAttribute<Self, Codec>()?.tag ?? "";
            comptime for (v in variants<Self>()) {
                if (this is v) {
                    if (tag != "") {
                        try e.beginStruct(typeName<Self>(), 1 + v.payload.length());
                        try e.field(tag, v.name);
                        comptime for (p in v.payload) {
                            try e.field(p.name, this.[v, p]);
                        }
                        try e.endStruct();
                        return;
                    }
                    comptime if (v.payload.length() == 0) {
                        try e.encodeUnitVariant(typeName<Self>(), v.name, v.index);
                    } else {
                        comptime if (v.payload.length() == 1) {
                            comptime for (p in v.payload) {
                                try e.encodeVariant(typeName<Self>(), v.name, v.index, this.[v, p]);
                            }
                        } else {
                            try e.beginVariant(typeName<Self>(), v.name, v.index, true);
                            try e.beginSeq(v.payload.length());
                            comptime for (p in v.payload) {
                                try e.element(this.[v, p]);
                            }
                            try e.endSeq();
                            try e.endVariant();
                        }
                    }
                }
            }
        } else {
            var count = 0;
            comptime for (f in fields<Self>()) {
                if (!(attribute<Codec>(f)?.skip ?? false)) {
                    count = count + 1;
                }
            }
            try e.beginStruct(typeName<Self>(), count);
            comptime for (f in fields<Self>()) {
                if (!(attribute<Codec>(f)?.skip ?? false)) {
                    try e.field(
                        wireName(f, attribute<Codec>(f), typeAttribute<Self, Codec>()),
                        this.[f]
                    );
                }
            }
            try e.endStruct();
        }
    }
}

/// A value that reads itself out of any decoder.
@SeesConformer
pub interface Decode {
    /// Reads a value of this type out of `d`. Synthesized for a conformance without the member,
    /// as the mirror of `encode`: a struct's fields by their wire names, a field the data lacks
    /// as `decodeAbsent` gives it (`null` for an optional, `Missing` else), unknown fields passed
    /// unless `@Codec { denyUnknown }`; an enum's variant by its name, or by the tag.
    ///
    /// # Errors
    ///
    /// Throws `DecodeError`: `Missing` for an absent required field, `UnknownVariant` for a
    /// variant name or index the enum has not, `UnknownField` under `denyUnknown`, and whatever
    /// the decoder throws for a mismatched or invalid value.
    static fn decode<D :: [Decoder]>(&d: D): Self throws DecodeError {
        comptime if (isEnum<Self>()) {
            let tag = typeAttribute<Self, Codec>()?.tag ?? "";
            if (tag != "") {
                try d.beginStruct(typeName<Self>(), [tag]);
                let which = try d.field<string>(tag);
                comptime for (v in variants<Self>()) {
                    if (which == v.name) {
                        let r = Self.[v] {
                            comptime for (p in v.payload) [p] = try d.field(p.name),
                        };
                        try d.endStruct(typeAttribute<Self, Codec>()?.denyUnknown ?? false);
                        return r;
                    }
                }
                throw DecodeError {
                    kind = .UnknownVariant,
                    path = d.path(),
                    detail = f"'{which}' of {typeName<Self>()}",
                };
            }
            let i = try d.beginVariant(typeName<Self>(), variantNames<Self>());
            comptime for (v in variants<Self>()) {
                if (i == v.index) {
                    comptime if (v.payload.length() == 0) {
                        try d.endVariant();
                        return Self.[v];
                    } else {
                        comptime if (v.payload.length() == 1) {
                            let r = Self.[v] {
                                comptime for (p in v.payload) [p] = try d.payload(),
                            };
                            try d.endVariant();
                            return r;
                        } else {
                            let _ = try d.beginSeq();
                            let r = Self.[v] {
                                comptime for (p in v.payload) [p] = try d.element(),
                            };
                            try d.endSeq();
                            try d.endVariant();
                            return r;
                        }
                    }
                }
            }
            throw DecodeError {
                kind = .UnknownVariant,
                path = d.path(),
                detail = f"variant {i} of {typeName<Self>()}",
            };
        } else {
            let names = List<string>.new();
            comptime for (f in fields<Self>()) {
                if (!(attribute<Codec>(f)?.skip ?? false)) {
                    names.push(wireName(f, attribute<Codec>(f), typeAttribute<Self, Codec>()));
                }
            }
            try d.beginStruct(typeName<Self>(), names.toArray());
            let r = Self {
                comptime for (f in fields<Self>()) [f] = try d.fieldOrAbsent(
                    wireName(f, attribute<Codec>(f), typeAttribute<Self, Codec>()),
                    attribute<Codec>(f)?.skip ?? false
                ),
            };
            try d.endStruct(typeAttribute<Self, Codec>()?.denyUnknown ?? false);
            return r;
        }
    }

    /// Returns what a field the data lacks reads as: `null` for an optional (whose conformance
    /// overrides this member).
    ///
    /// # Errors
    ///
    /// Throws `DecodeError` of kind `Missing` for any type that does not override it.
    static fn decodeAbsent<D :: [Decoder]>(&d: D, name: string): Self throws DecodeError {
        throw DecodeError { kind = .Missing, path = d.path(), detail = f"field '{name}'" };
    }
}

/// A value that is both `Encode` and `Decode`: what `std.json.encode` takes and
/// `std.json.decode<T>` gives.
pub interface Codable :: [Encode, Decode] { }

// ------------------------------------------------------------------ the errors

/// Classifies why a value could not be read: what was missing, mismatched, invalid or unknown.
pub enum DecodeErrorKind :: [Equatable, Hashable, Debug] {
    /// A field the type needs is not in the data.
    Missing,
    /// The data holds another form than the type reads: a string where an int stands.
    TypeMismatch,
    /// The form is right, the value is not: an integer that overflows, a string that is no
    /// `Instant`.
    Invalid,
    /// A field the type has not, where the type denies unknown fields.
    UnknownField,
    /// A variant the enum has not.
    UnknownVariant,
}

/// The error a decoder throws: what was wrong, where in the data — `users[0].mail`, `""` at the
/// root — and the detail. `message()` joins the three.
pub struct DecodeError :: [Error] {
    pub kind: DecodeErrorKind,
    pub path: string,
    pub detail: string = "",

    pub fn message(): string {
        var text = match (this.kind) {
            .Missing => "missing",
            .TypeMismatch => "type mismatch",
            .Invalid => "invalid",
            .UnknownField => "unknown field",
            .UnknownVariant => "unknown variant",
        };
        if (!this.detail.isEmpty()) {
            text = f"{text}: {this.detail}";
        }
        if (!this.path.isEmpty()) {
            text = f"{text} (at {this.path})";
        }
        return text;
    }
}

/// The error an encoder throws: a format that cannot hold the form — a map keyed by a struct in
/// JSON — or a writer that failed (then `cause()` is its error), at a path in the value.
pub struct EncodeError :: [Error] {
    pub path: string,
    pub detail: string = "",
    pub inner: ?Error,

    pub fn message(): string {
        if (this.path.isEmpty()) {
            return this.detail;
        }
        return f"{this.detail} (at {this.path})";
    }

    pub fn cause(): ?Error {
        return this.inner;
    }
}

// ------------------------------------------------------------------ the container model

/// The writing side of a format: the scalars, and the containers as begin/end around their parts.
/// The sequence of calls a conformance makes is the contract: `beginSeq(n)`, then `n` values,
/// then `endSeq()`; `beginMap(n)`, then `n` times `beginKey()`, a key and a value, then
/// `endMap()`; `beginStruct(name, n)`, then `n` times `beginField(name)` and a value, then
/// `endStruct()`; `beginVariant(…, hasPayload)`, then the payload where there is one, then
/// `endVariant()`. A format that cannot hold a form throws `EncodeError`, with `path()` as its
/// place.
pub interface Encoder {
    mut fn encodeNull(): void throws EncodeError;
    mut fn encodeBool(v: bool): void throws EncodeError;
    mut fn encodeInt(v: int): void throws EncodeError;
    mut fn encodeUint(v: uint): void throws EncodeError;
    mut fn encodeFloat(v: float): void throws EncodeError;
    mut fn encodeString(v: string): void throws EncodeError;
    mut fn encodeBytes(v: Slice<uint8>): void throws EncodeError;

    mut fn beginSeq(count: int): void throws EncodeError;
    mut fn endSeq(): void throws EncodeError;

    mut fn beginMap(count: int): void throws EncodeError;
    mut fn beginKey(): void throws EncodeError;
    mut fn endMap(): void throws EncodeError;

    mut fn beginStruct(name: string, count: int): void throws EncodeError;
    mut fn beginField(name: string): void throws EncodeError;
    mut fn endStruct(): void throws EncodeError;

    mut fn beginVariant(
        enumName: string,
        variant: string,
        index: int,
        hasPayload: bool
    ): void throws EncodeError;
    mut fn endVariant(): void throws EncodeError;

    /// Returns where the encoder stands, for an error: `""` at the root.
    fn path(): string;
}

/// The reading side of a format, pull-based: a conformance asks for the form it expects, and the
/// format answers it or throws `TypeMismatch`. The containers: `beginSeq()` answers the count
/// where the format knows it, `seqHasNext()` whether an element follows — which is how a format
/// that does not know the count ends a sequence —; `beginMap()`/`mapHasNext()` the same, a key
/// and a value read in turn; `beginStruct(name, fields)` positions on a struct, `structField(name)`
/// on one of its fields — `false` where the data has none —, `endStruct(denyUnknown)` leaves it
/// and, where asked, refuses a field the data has and the type has not; `beginVariant(enum,
/// variants)` answers the index of the variant the data holds (or throws `UnknownVariant`),
/// `variantHasPayload()` whether one follows. A format without names in its data (one that reads
/// structs in field order) answers `structField` by position. A read that mismatches leaves the
/// value where it was: the next ask sees it again, which is how `Value` reads whatever comes.
pub interface Decoder {
    /// Returns whether the next value is null, without taking it.
    mut fn isNull(): bool throws DecodeError;
    mut fn decodeNull(): void throws DecodeError;
    mut fn decodeBool(): bool throws DecodeError;
    mut fn decodeInt(): int throws DecodeError;
    mut fn decodeUint(): uint throws DecodeError;
    mut fn decodeFloat(): float throws DecodeError;
    mut fn decodeString(): string throws DecodeError;
    mut fn decodeBytes(): uint8[] throws DecodeError;

    mut fn beginSeq(): ?int throws DecodeError;
    fn seqHasNext(): bool throws DecodeError;
    mut fn endSeq(): void throws DecodeError;

    mut fn beginMap(): ?int throws DecodeError;
    fn mapHasNext(): bool throws DecodeError;
    mut fn endMap(): void throws DecodeError;

    mut fn beginStruct(name: string, fields: string[]): void throws DecodeError;
    mut fn structField(name: string): bool throws DecodeError;
    mut fn endStruct(denyUnknown: bool): void throws DecodeError;

    mut fn beginVariant(enumName: string, variants: string[]): int throws DecodeError;
    fn variantHasPayload(): bool throws DecodeError;
    mut fn endVariant(): void throws DecodeError;

    /// Returns where the decoder stands, for an error: `""` at the root, `users[0].mail` below.
    fn path(): string;
}

// ------------------------------------------------------------------ the layer over the model

extend<E :: [Encoder]> E {
    /// Encodes `v` as the next element of the sequence begun.
    ///
    /// # Errors
    ///
    /// Throws what encoding `v` throws.
    pub mut fn element<T :: [Encode]>(v: T): void throws EncodeError {
        try v.encode(&this);
    }

    /// Encodes the key `k` and the value `v` as the next entry of the map begun.
    ///
    /// # Errors
    ///
    /// Throws `EncodeError` where the format cannot hold the key, or what encoding either throws.
    pub mut fn entry<K :: [Encode], V :: [Encode]>(k: K, v: V): void throws EncodeError {
        try this.beginKey();
        try k.encode(&this);
        try v.encode(&this);
    }

    /// Encodes `v` as the field `name` of the struct begun.
    ///
    /// # Errors
    ///
    /// Throws what encoding `v` throws.
    pub mut fn field<T :: [Encode]>(name: string, v: T): void throws EncodeError {
        try this.beginField(name);
        try v.encode(&this);
    }

    /// Encodes a unit variant whole: `beginVariant` without a payload, then `endVariant`.
    ///
    /// # Errors
    ///
    /// Throws what the encoder throws.
    pub mut fn encodeUnitVariant(
        enumName: string,
        variant: string,
        index: int
    ): void throws EncodeError {
        try this.beginVariant(enumName, variant, index, false);
        try this.endVariant();
    }

    /// Encodes a variant whole, with `payload` between `beginVariant` and `endVariant`.
    ///
    /// # Errors
    ///
    /// Throws what the encoder or encoding `payload` throws.
    pub mut fn encodeVariant<T :: [Encode]>(
        enumName: string,
        variant: string,
        index: int,
        payload: T
    ): void throws EncodeError {
        try this.beginVariant(enumName, variant, index, true);
        try payload.encode(&this);
        try this.endVariant();
    }
}

extend<D :: [Decoder]> D {
    /// Decodes the next element of the sequence begun; returns `null` at its end.
    ///
    /// # Errors
    ///
    /// Throws what decoding the element throws.
    pub mut fn next<T :: [Decode]>(): ?T throws DecodeError {
        if (!(try this.seqHasNext())) {
            return null;
        }
        return try T.decode(&this);
    }

    /// Decodes the next key of the map begun; returns `null` at its end. `value<V>()` reads its
    /// value.
    ///
    /// # Errors
    ///
    /// Throws what decoding the key throws.
    pub mut fn nextKey<K :: [Decode]>(): ?K throws DecodeError {
        if (!(try this.mapHasNext())) {
            return null;
        }
        return try K.decode(&this);
    }

    /// Decodes the value of the key read last.
    ///
    /// # Errors
    ///
    /// Throws what decoding the value throws.
    pub mut fn value<V :: [Decode]>(): V throws DecodeError {
        return try V.decode(&this);
    }

    /// Decodes the field `name` of the struct begun, which the data must have.
    ///
    /// # Errors
    ///
    /// Throws `DecodeError` of kind `Missing` where the data lacks the field, or what decoding
    /// its value throws.
    pub mut fn field<T :: [Decode]>(name: string): T throws DecodeError {
        if (!(try this.structField(name))) {
            throw DecodeError { kind = .Missing, path = this.path(), detail = f"field '{name}'" };
        }
        return try T.decode(&this);
    }

    /// Decodes the field `name` of the struct begun, which the data may lack; returns `null` for
    /// a missing field, as for a `null` in the data.
    ///
    /// # Errors
    ///
    /// Throws what decoding the value throws.
    pub mut fn optional<T :: [Decode]>(name: string): ?T throws DecodeError {
        if (!(try this.structField(name))) {
            return null;
        }
        return try this.decodeNullable<T>();
    }

    /// Decodes a value that may be null: returns `null` for a null, the decoded value else.
    ///
    /// # Errors
    ///
    /// Throws what decoding the value throws.
    pub mut fn decodeNullable<T :: [Decode]>(): ?T throws DecodeError {
        if (try this.isNull()) {
            try this.decodeNull();
            return null;
        }
        return try T.decode(&this);
    }

    /// Decodes the next element of the sequence begun, which must be there.
    ///
    /// # Errors
    ///
    /// Throws `DecodeError` of kind `Missing` at the end of the sequence, or what decoding the
    /// element throws.
    pub mut fn element<T :: [Decode]>(): T throws DecodeError {
        if (let x = try this.next<T>()) {
            return x;
        }
        throw DecodeError { kind = .Missing, path = this.path(), detail = "an element" };
    }

    /// Decodes the payload of the variant begun.
    ///
    /// # Errors
    ///
    /// Throws what decoding the payload throws.
    pub mut fn payload<T :: [Decode]>(): T throws DecodeError {
        return try T.decode(&this);
    }

    /// Decodes a field as the synthesized `decode` reads it: the value where the data has it,
    /// else what `decodeAbsent` gives — `null` for an optional. A skipped field is never read.
    ///
    /// # Errors
    ///
    /// Throws `DecodeError` of kind `Missing` for an absent non-optional field, or what decoding
    /// the value throws.
    pub mut fn fieldOrAbsent<T :: [Decode]>(
        name: string,
        skipped: bool = false
    ): T throws DecodeError {
        if (skipped || !(try this.structField(name))) {
            return try T.decodeAbsent(&this, name);
        }
        return try T.decode(&this);
    }
}

// ------------------------------------------------------------------ the scalars

extend bool :: [Codable] {
    fn encode<E :: [Encoder]>(&e: E): void throws EncodeError {
        try e.encodeBool(this);
    }

    static fn decode<D :: [Decoder]>(&d: D): bool throws DecodeError {
        return try d.decodeBool();
    }
}

extend int :: [Codable] {
    fn encode<E :: [Encoder]>(&e: E): void throws EncodeError {
        try e.encodeInt(this);
    }

    static fn decode<D :: [Decoder]>(&d: D): int throws DecodeError {
        return try d.decodeInt();
    }
}

/// Decodes an integer narrower than `int` through `int`, refusing what lies outside
/// `low..=high`.
///
/// # Errors
///
/// Throws `DecodeError` of kind `Invalid` for a value that does not fit, or what `decodeInt`
/// throws.
fn narrowed<D :: [Decoder]>(&d: D, low: int, high: int, name: string): int throws DecodeError {
    let v = try d.decodeInt();
    if (v < low || v > high) {
        throw DecodeError { kind = .Invalid, path = d.path(), detail = f"{v} does not fit {name}" };
    }
    return v;
}

extend int8 :: [Codable] {
    fn encode<E :: [Encoder]>(&e: E): void throws EncodeError {
        try e.encodeInt(this as int);
    }

    static fn decode<D :: [Decoder]>(&d: D): int8 throws DecodeError {
        return (try narrowed(&d, int8.min as int, int8.max as int, "int8")) as int8;
    }
}

extend int16 :: [Codable] {
    fn encode<E :: [Encoder]>(&e: E): void throws EncodeError {
        try e.encodeInt(this as int);
    }

    static fn decode<D :: [Decoder]>(&d: D): int16 throws DecodeError {
        return (try narrowed(&d, int16.min as int, int16.max as int, "int16")) as int16;
    }
}

extend int32 :: [Codable] {
    fn encode<E :: [Encoder]>(&e: E): void throws EncodeError {
        try e.encodeInt(this as int);
    }

    static fn decode<D :: [Decoder]>(&d: D): int32 throws DecodeError {
        return (try narrowed(&d, int32.min as int, int32.max as int, "int32")) as int32;
    }
}

extend uint8 :: [Codable] {
    fn encode<E :: [Encoder]>(&e: E): void throws EncodeError {
        try e.encodeUint(this as uint);
    }

    static fn decode<D :: [Decoder]>(&d: D): uint8 throws DecodeError {
        return (try narrowed(&d, 0, uint8.max as int, "uint8")) as uint8;
    }
}

extend uint16 :: [Codable] {
    fn encode<E :: [Encoder]>(&e: E): void throws EncodeError {
        try e.encodeUint(this as uint);
    }

    static fn decode<D :: [Decoder]>(&d: D): uint16 throws DecodeError {
        return (try narrowed(&d, 0, uint16.max as int, "uint16")) as uint16;
    }
}

extend uint32 :: [Codable] {
    fn encode<E :: [Encoder]>(&e: E): void throws EncodeError {
        try e.encodeUint(this as uint);
    }

    static fn decode<D :: [Decoder]>(&d: D): uint32 throws DecodeError {
        return (try narrowed(&d, 0, uint32.max as int, "uint32")) as uint32;
    }
}

extend uint :: [Codable] {
    fn encode<E :: [Encoder]>(&e: E): void throws EncodeError {
        try e.encodeUint(this);
    }

    static fn decode<D :: [Decoder]>(&d: D): uint throws DecodeError {
        return try d.decodeUint();
    }
}

extend float :: [Codable] {
    fn encode<E :: [Encoder]>(&e: E): void throws EncodeError {
        try e.encodeFloat(this);
    }

    static fn decode<D :: [Decoder]>(&d: D): float throws DecodeError {
        return try d.decodeFloat();
    }
}

extend float32 :: [Codable] {
    fn encode<E :: [Encoder]>(&e: E): void throws EncodeError {
        try e.encodeFloat(this as float);
    }

    static fn decode<D :: [Decoder]>(&d: D): float32 throws DecodeError {
        return (try d.decodeFloat()) as float32;
    }
}

extend string :: [Codable] {
    fn encode<E :: [Encoder]>(&e: E): void throws EncodeError {
        try e.encodeString(this);
    }

    static fn decode<D :: [Decoder]>(&d: D): string throws DecodeError {
        return try d.decodeString();
    }
}

/// Encodes a character as a string of one character; decoding refuses any other length as
/// `Invalid`.
extend char :: [Codable] {
    fn encode<E :: [Encoder]>(&e: E): void throws EncodeError {
        try e.encodeString(f"{this}");
    }

    static fn decode<D :: [Decoder]>(&d: D): char throws DecodeError {
        let s = try d.decodeString();
        if (s.charCount() != 1) {
            throw DecodeError {
                kind = .Invalid,
                path = d.path(),
                detail = f"'{s}' is no single character",
            };
        }
        var it = s.chars();
        return it.next()!;
    }
}

/// Encodes an `Instant` as its RFC 3339 text; decoding refuses text that does not parse as
/// `Invalid`.
extend Instant :: [Codable] {
    fn encode<E :: [Encoder]>(&e: E): void throws EncodeError {
        try e.encodeString(this.show());
    }

    static fn decode<D :: [Decoder]>(&d: D): Instant throws DecodeError {
        let s = try d.decodeString();
        try {
            return Instant.parse(s);
        } catch (p: ParseError) {
            throw DecodeError {
                kind = .Invalid,
                path = d.path(),
                detail = f"'{s}' is no instant: {p.message()}",
            };
        }
    }
}

/// Encodes the other time types as their texts too: a `Duration` as `1h30m`, a `Date` as RFC 3339's full-date, a `Time` as `HH:MM:SS` with its fraction, a
/// `DateTime` as RFC 3339's date-time with its offset. Decoding refuses text that does not parse
/// as `Invalid`.
extend Duration :: [Codable] {
    fn encode<E :: [Encoder]>(&e: E): void throws EncodeError {
        try e.encodeString(this.show());
    }

    static fn decode<D :: [Decoder]>(&d: D): Duration throws DecodeError {
        let s = try d.decodeString();
        try {
            return Duration.parse(s);
        } catch (p: ParseError) {
            throw DecodeError {
                kind = .Invalid,
                path = d.path(),
                detail = f"'{s}' is no duration: {p.message()}",
            };
        }
    }
}

extend Date :: [Codable] {
    fn encode<E :: [Encoder]>(&e: E): void throws EncodeError {
        try e.encodeString(this.show());
    }

    static fn decode<D :: [Decoder]>(&d: D): Date throws DecodeError {
        let s = try d.decodeString();
        try {
            return Date.parse(s);
        } catch (p: ParseError) {
            throw DecodeError {
                kind = .Invalid,
                path = d.path(),
                detail = f"'{s}' is no date: {p.message()}",
            };
        }
    }
}

extend Time :: [Codable] {
    fn encode<E :: [Encoder]>(&e: E): void throws EncodeError {
        try e.encodeString(this.show());
    }

    static fn decode<D :: [Decoder]>(&d: D): Time throws DecodeError {
        let s = try d.decodeString();
        try {
            return Time.parse(s);
        } catch (p: ParseError) {
            throw DecodeError {
                kind = .Invalid,
                path = d.path(),
                detail = f"'{s}' is no time of day: {p.message()}",
            };
        }
    }
}

extend DateTime :: [Codable] {
    fn encode<E :: [Encoder]>(&e: E): void throws EncodeError {
        try e.encodeString(this.show());
    }

    static fn decode<D :: [Decoder]>(&d: D): DateTime throws DecodeError {
        let s = try d.decodeString();
        try {
            return DateTime.parse(s);
        } catch (p: ParseError) {
            throw DecodeError {
                kind = .Invalid,
                path = d.path(),
                detail = f"'{s}' is no date-time: {p.message()}",
            };
        }
    }
}

// ------------------------------------------------------------------ the containers

/// Encodes an optional as `null` or its value. A `null` and a missing field decode alike into
/// `?T`.
extend<T :: [Encode]> ?T :: [Encode] {
    fn encode<E :: [Encoder]>(&e: E): void throws EncodeError {
        if (let v = this) {
            try v.encode(&e);
        } else {
            try e.encodeNull();
        }
    }
}

extend<T :: [Decode]> ?T :: [Decode] {
    static fn decode<D :: [Decoder]>(&d: D): ?T throws DecodeError {
        return try d.decodeNullable<T>();
    }

    static fn decodeAbsent<D :: [Decoder]>(&d: D, name: string): ?T throws DecodeError {
        return null;
    }
}

/// Encodes an array as a sequence of its elements — a `uint8[]` as one of numbers. Bytes as the
/// format holds them (Base64 in JSON) are `Bytes { value }`: a conformance over `T[]` cannot ask
/// what `T` is, so the byte form has a type of its own.
extend<T :: [Encode]> T[] :: [Encode] {
    fn encode<E :: [Encoder]>(&e: E): void throws EncodeError {
        try e.beginSeq(this.length());
        for (x in this) {
            try e.element(x);
        }
        try e.endSeq();
    }
}

extend<T :: [Decode]> T[] :: [Decode] {
    static fn decode<D :: [Decoder]>(&d: D): T[] throws DecodeError {
        let count = try d.beginSeq();
        let out = List<T>.withCapacity(count ?? 0);
        loop {
            if (let x = try d.next<T>()) {
                out.push(x);
            } else {
                break;
            }
        }
        try d.endSeq();
        return out.toArray();
    }
}

/// Encodes a slice as its array would be; a slice is a view, so it has no `Decode`.
extend<T :: [Encode]> Slice<T> :: [Encode] {
    fn encode<E :: [Encoder]>(&e: E): void throws EncodeError {
        try e.beginSeq(this.length());
        for (x in this) {
            try e.element(x);
        }
        try e.endSeq();
    }
}

/// Bytes in the format's own byte form: what `encodeBytes`/`decodeBytes` carry — Base64 in JSON,
/// an array of numbers in TOML, the bytes themselves in a binary format.
pub struct Bytes :: [Codable, Equatable, Debug] {
    pub value: uint8[],

    pub fn encode<E :: [Encoder]>(&e: E): void throws EncodeError {
        try e.encodeBytes(this.value[..]);
    }

    pub static fn decode<D :: [Decoder]>(&d: D): Bytes throws DecodeError {
        return Bytes { value = try d.decodeBytes() };
    }
}

extend<T :: [Encode]> List<T> :: [Encode] {
    fn encode<E :: [Encoder]>(&e: E): void throws EncodeError {
        try e.beginSeq(this.length());
        for (x in this) {
            try e.element(x);
        }
        try e.endSeq();
    }
}

extend<T :: [Decode]> List<T> :: [Decode] {
    static fn decode<D :: [Decoder]>(&d: D): List<T> throws DecodeError {
        let count = try d.beginSeq();
        let out = List<T>.withCapacity(count ?? 0);
        loop {
            if (let x = try d.next<T>()) {
                out.push(x);
            } else {
                break;
            }
        }
        try d.endSeq();
        return out;
    }
}

extend<T :: [Encode]> Deque<T> :: [Encode] {
    fn encode<E :: [Encoder]>(&e: E): void throws EncodeError {
        try e.beginSeq(this.length());
        for (x in this) {
            try e.element(x);
        }
        try e.endSeq();
    }
}

extend<T :: [Decode]> Deque<T> :: [Decode] {
    static fn decode<D :: [Decoder]>(&d: D): Deque<T> throws DecodeError {
        let _ = try d.beginSeq();
        let out = Deque<T>.new();
        loop {
            if (let x = try d.next<T>()) {
                out.pushBack(x);
            } else {
                break;
            }
        }
        try d.endSeq();
        return out;
    }
}

/// Encodes a set as a sequence, in the set's own (unspecified) order.
extend<T :: [Hashable, Encode], H :: [Hasher]> Set<T, H> :: [Encode] {
    fn encode<E :: [Encoder]>(&e: E): void throws EncodeError {
        try e.beginSeq(this.length());
        for (x in this) {
            try e.element(x);
        }
        try e.endSeq();
    }
}

extend<T :: [Hashable, Decode]> Set<T, DefaultHasher> :: [Decode] {
    static fn decode<D :: [Decoder]>(&d: D): Set<T, DefaultHasher> throws DecodeError {
        let _ = try d.beginSeq();
        let out = Set<T>.new();
        loop {
            if (let x = try d.next<T>()) {
                out.insert(x);
            } else {
                break;
            }
        }
        try d.endSeq();
        return out;
    }
}

/// Encodes a map as a map; its keys go to the format as values, and a format that holds only text
/// keys (JSON) writes a number as its digits and refuses the rest.
extend<K :: [Hashable, Encode], V :: [Encode], H :: [Hasher]> Map<K, V, H> :: [Encode] {
    fn encode<E :: [Encoder]>(&e: E): void throws EncodeError {
        try e.beginMap(this.length());
        for ((k, v) in this) {
            try e.entry(k, v);
        }
        try e.endMap();
    }
}

extend<K :: [Hashable, Decode], V :: [Decode]> Map<K, V, DefaultHasher> :: [Decode] {
    static fn decode<D :: [Decoder]>(&d: D): Map<K, V, DefaultHasher> throws DecodeError {
        let _ = try d.beginMap();
        let out = Map<K, V>.new();
        loop {
            if (let k = try d.nextKey<K>()) {
                out[k] = try d.value<V>();
            } else {
                break;
            }
        }
        try d.endMap();
        return out;
    }
}

/// Encodes a tuple as a sequence of its length.
extend<T0 :: [Encode], T1 :: [Encode]> (T0, T1) :: [Encode] {
    fn encode<E :: [Encoder]>(&e: E): void throws EncodeError {
        try e.beginSeq(2);
        try e.element(this.0);
        try e.element(this.1);
        try e.endSeq();
    }
}

extend<T0 :: [Decode], T1 :: [Decode]> (T0, T1) :: [Decode] {
    static fn decode<D :: [Decoder]>(&d: D): (T0, T1) throws DecodeError {
        let _ = try d.beginSeq();
        let a = try tupleElement<T0, D>(&d, 0);
        let b = try tupleElement<T1, D>(&d, 1);
        try d.endSeq();
        return (a, b);
    }
}

extend<T0 :: [Encode], T1 :: [Encode], T2 :: [Encode]> (T0, T1, T2) :: [Encode] {
    fn encode<E :: [Encoder]>(&e: E): void throws EncodeError {
        try e.beginSeq(3);
        try e.element(this.0);
        try e.element(this.1);
        try e.element(this.2);
        try e.endSeq();
    }
}

extend<T0 :: [Decode], T1 :: [Decode], T2 :: [Decode]> (T0, T1, T2) :: [Decode] {
    static fn decode<D :: [Decoder]>(&d: D): (T0, T1, T2) throws DecodeError {
        let _ = try d.beginSeq();
        let a = try tupleElement<T0, D>(&d, 0);
        let b = try tupleElement<T1, D>(&d, 1);
        let c = try tupleElement<T2, D>(&d, 2);
        try d.endSeq();
        return (a, b, c);
    }
}

fn tupleElement<T :: [Decode], D :: [Decoder]>(&d: D, index: int): T throws DecodeError {
    if (let x = try d.next<T>()) {
        return x;
    }
    throw DecodeError {
        kind = .Missing,
        path = d.path(),
        detail = f"element {index} of the tuple",
    };
}

// ------------------------------------------------------------------ Value, the format of no format

/// A tree of the ten forms: what any encoder is given and any decoder answers, as a value.
/// `Value.of(v)` is the tree a value writes, `tree.read<T>()` the value a tree reads as. A struct
/// is its name and its fields in order, a variant its enum's name, its own, its index and its
/// payload where it has one; a map is its entries in the order written.
pub enum Value :: [Equatable, Debug] {
    Null,
    Bool(bool),
    Int(int),
    Uint(uint),
    Float(float),
    String(string),
    Bytes(uint8[]),
    Seq(List<Value>),
    Map(List<(Value, Value)>),
    Struct(string, List<(string, Value)>),
    Variant(string, string, int, ?Box<Value>),
}

/// What is being built, from the outside in.
enum Building {
    Seq(List<Value>),
    Map(List<(Value, Value)>, ?Box<Value>),
    Struct(string, List<(string, Value)>, ?string),
    Variant(string, string, int, bool, ?Box<Value>),
}

/// An encoder that builds a `Value`: `Value.encoder()`, then `v.encode(&e)`, then `e.value()`.
pub class ValueEncoder :: [Encoder] {
    var stack: List<Building> = List.new(),
    var done: ?Box<Value> = null,
    var segments: List<string> = List.new(),

    /// Returns the value built, once one value was encoded; `Null` before.
    pub fn value(): Value {
        if (let b = this.done) {
            return b.value;
        }
        return Value.Null;
    }

    mut fn put(v: Value): void throws EncodeError {
        if (this.stack.isEmpty()) {
            this.done = Box<Value> { value = v };
            return;
        }
        let top = this.stack.length() - 1;
        let next: Building = match (this.stack[top]) {
            .Seq(items) => {
                items.push(v);
                Building.Seq(items)
            }
            .Map(entries, pendingKey) => {
                var pending: ?Box<Value> = Box<Value> { value = v };
                if (let k = pendingKey) {
                    entries.push((k.value, v));
                    pending = null;
                }
                Building.Map(entries, pending)
            }
            .Struct(name, fieldList, pendingField) => {
                if (pendingField == null) {
                    throw EncodeError {
                        path = this.path(),
                        detail = "a struct's value without its field",
                    };
                }
                fieldList.push((pendingField, v));
                Building.Struct(name, fieldList, null)
            }
            .Variant(enumName, variant, index, hasPayload, _) => Building.Variant(
                enumName,
                variant,
                index,
                hasPayload,
                Box<Value> { value = v }
            ),
        };
        this.stack[top] = next;
    }

    pub mut fn encodeNull(): void throws EncodeError {
        try this.put(Value.Null);
    }

    pub mut fn encodeBool(v: bool): void throws EncodeError {
        try this.put(Value.Bool(v));
    }

    pub mut fn encodeInt(v: int): void throws EncodeError {
        try this.put(Value.Int(v));
    }

    pub mut fn encodeUint(v: uint): void throws EncodeError {
        try this.put(Value.Uint(v));
    }

    pub mut fn encodeFloat(v: float): void throws EncodeError {
        try this.put(Value.Float(v));
    }

    pub mut fn encodeString(v: string): void throws EncodeError {
        try this.put(Value.String(v));
    }

    pub mut fn encodeBytes(v: Slice<uint8>): void throws EncodeError {
        let copy: uint8[] = [0u8] * v.length();
        v.copyInto(copy[..]);
        try this.put(Value.Bytes(copy));
    }

    pub mut fn beginSeq(count: int): void throws EncodeError {
        this.stack.push(Building.Seq(List<Value>.withCapacity(count)));
        this.segments.push("[]");
    }

    pub mut fn endSeq(): void throws EncodeError {
        match (this.stack.pop()) {
            .Seq(items) => {
                this.segments.pop();
                try this.put(Value.Seq(items));
            }
            _ => {
                throw EncodeError { path = this.path(), detail = "endSeq without beginSeq" };
            }
        }
    }

    pub mut fn beginMap(count: int): void throws EncodeError {
        this.stack.push(Building.Map(List<(Value, Value)>.withCapacity(count), null));
        this.segments.push("{}");
    }

    pub mut fn beginKey(): void throws EncodeError { }

    pub mut fn endMap(): void throws EncodeError {
        match (this.stack.pop()) {
            .Map(entries, _) => {
                this.segments.pop();
                try this.put(Value.Map(entries));
            }
            _ => {
                throw EncodeError { path = this.path(), detail = "endMap without beginMap" };
            }
        }
    }

    pub mut fn beginStruct(name: string, count: int): void throws EncodeError {
        this.stack.push(Building.Struct(name, List<(string, Value)>.withCapacity(count), null));
        this.segments.push(name);
    }

    pub mut fn beginField(name: string): void throws EncodeError {
        let top = this.stack.length() - 1;
        match (this.stack[top]) {
            .Struct(structName, fieldList, _) => {
                this.stack[top] = Building.Struct(structName, fieldList, name);
            }
            _ => {
                throw EncodeError { path = this.path(), detail = "beginField outside a struct" };
            }
        }
    }

    pub mut fn endStruct(): void throws EncodeError {
        match (this.stack.pop()) {
            .Struct(name, fieldList, _) => {
                this.segments.pop();
                try this.put(Value.Struct(name, fieldList));
            }
            _ => {
                throw EncodeError { path = this.path(), detail = "endStruct without beginStruct" };
            }
        }
    }

    pub mut fn beginVariant(
        enumName: string,
        variant: string,
        index: int,
        hasPayload: bool
    ): void throws EncodeError {
        this.stack.push(Building.Variant(enumName, variant, index, hasPayload, null));
        this.segments.push(variant);
    }

    pub mut fn endVariant(): void throws EncodeError {
        match (this.stack.pop()) {
            .Variant(enumName, variant, index, _, payload) => {
                this.segments.pop();
                try this.put(Value.Variant(enumName, variant, index, payload));
            }
            _ => {
                throw EncodeError {
                    path = this.path(),
                    detail = "endVariant without beginVariant",
                };
            }
        }
    }

    pub fn path(): string {
        return this.segments.toArray().join(".");
    }
}

/// Where a decoder stands in a `Value`: the container and the position in it.
enum Reading {
    Seq(List<Value>, int),
    Map(List<(Value, Value)>, int, bool),
    Struct(string, List<(string, Value)>, ?int, Set<int>),
    Variant(string, string, int, ?Box<Value>, bool),
}

/// A decoder that reads a `Value`: `tree.read<T>()`, or `tree.decoder()` for one to pass on.
pub class ValueDecoder :: [Decoder] {
    root: Value,
    var stack: List<Reading> = List.new(),
    var taken: bool = false,
    var segments: List<string> = List.new(),

    /// Returns the value the next read takes, without taking it.
    ///
    /// # Errors
    ///
    /// Throws `DecodeError` of kind `Missing` where the container is exhausted or the root was
    /// read already.
    fn peek(): Value throws DecodeError {
        if (this.stack.isEmpty()) {
            if (this.taken) {
                throw DecodeError {
                    kind = .Missing,
                    path = this.path(),
                    detail = "the value was read already",
                };
            }
            return this.root;
        }
        let top = this.stack.length() - 1;
        return match (this.stack[top]) {
            .Seq(items, at) => {
                if (at >= items.length()) {
                    throw DecodeError {
                        kind = .Missing,
                        path = this.path(),
                        detail = "the sequence has no more elements",
                    };
                }
                items[at]
            }
            .Map(entries, at, keyRead) => {
                if (at >= entries.length()) {
                    throw DecodeError {
                        kind = .Missing,
                        path = this.path(),
                        detail = "the map has no more entries",
                    };
                }
                if (keyRead) entries[at].1 else entries[at].0
            }
            .Struct(_, fieldList, current, _) => {
                if (current == null) {
                    throw DecodeError {
                        kind = .Missing,
                        path = this.path(),
                        detail = "a struct's value without its field",
                    };
                }
                fieldList[current].1
            }
            .Variant(_, _, _, payload, _) => {
                if (payload == null) {
                    throw DecodeError {
                        kind = .Missing,
                        path = this.path(),
                        detail = "the variant has no payload",
                    };
                }
                payload.value
            }
        };
    }

    /// Moves the position on, once a read matched its form: a mismatch does not call it, so the
    /// next ask sees the same value again.
    mut fn advance(): void {
        if (this.stack.isEmpty()) {
            this.taken = true;
            return;
        }
        let top = this.stack.length() - 1;
        let next: Reading = match (this.stack[top]) {
            .Seq(items, at) => Reading.Seq(items, at + 1),
            .Map(entries, at, keyRead) => if (keyRead) Reading.Map(entries, at + 1, false)
                else Reading.Map(entries, at, true),
            .Struct(name, fieldList, _, seen) => Reading.Struct(name, fieldList, null, seen),
            .Variant(enumName, variant, index, payload, _) => Reading.Variant(
                enumName,
                variant,
                index,
                payload,
                true
            ),
        };
        this.stack[top] = next;
    }

    fn mismatch(expected: string, got: Value): DecodeError {
        return DecodeError {
            kind = .TypeMismatch,
            path = this.path(),
            detail = f"expected {expected}, got {formOf(got)}",
        };
    }

    pub mut fn isNull(): bool throws DecodeError {
        return match (try this.peek()) {
            .Null => true,
            _ => false,
        };
    }

    pub mut fn decodeNull(): void throws DecodeError {
        let v = try this.peek();
        match (v) {
            .Null => {
                this.advance();
            }
            _ => {
                throw this.mismatch("null", v);
            }
        }
    }

    pub mut fn decodeBool(): bool throws DecodeError {
        let v = try this.peek();
        match (v) {
            .Bool(b) => {
                this.advance();
                return b;
            }
            _ => {
                throw this.mismatch("a bool", v);
            }
        }
    }

    pub mut fn decodeInt(): int throws DecodeError {
        let v = try this.peek();
        match (v) {
            .Int(i) => {
                this.advance();
                return i;
            }
            .Uint(u) => {
                if (u > (int.max as uint)) {
                    throw DecodeError {
                        kind = .Invalid,
                        path = this.path(),
                        detail = f"{u} does not fit int",
                    };
                }
                this.advance();
                return u as int;
            }
            _ => {
                throw this.mismatch("an int", v);
            }
        }
    }

    pub mut fn decodeUint(): uint throws DecodeError {
        let v = try this.peek();
        match (v) {
            .Uint(u) => {
                this.advance();
                return u;
            }
            .Int(i) => {
                if (i < 0) {
                    throw DecodeError {
                        kind = .Invalid,
                        path = this.path(),
                        detail = f"{i} is negative",
                    };
                }
                this.advance();
                return i as uint;
            }
            _ => {
                throw this.mismatch("a uint", v);
            }
        }
    }

    pub mut fn decodeFloat(): float throws DecodeError {
        let v = try this.peek();
        match (v) {
            .Float(f) => {
                this.advance();
                return f;
            }
            .Int(i) => {
                this.advance();
                return i as float;
            }
            .Uint(u) => {
                this.advance();
                return u as float;
            }
            _ => {
                throw this.mismatch("a float", v);
            }
        }
    }

    pub mut fn decodeString(): string throws DecodeError {
        let v = try this.peek();
        match (v) {
            .String(s) => {
                this.advance();
                return s;
            }
            _ => {
                throw this.mismatch("a string", v);
            }
        }
    }

    pub mut fn decodeBytes(): uint8[] throws DecodeError {
        let v = try this.peek();
        match (v) {
            .Bytes(b) => {
                this.advance();
                return b;
            }
            _ => {
                throw this.mismatch("bytes", v);
            }
        }
    }

    pub mut fn beginSeq(): ?int throws DecodeError {
        let v = try this.peek();
        match (v) {
            .Seq(items) => {
                this.advance();
                this.stack.push(Reading.Seq(items, 0));
                this.segments.push("[]");
                return items.length();
            }
            _ => {
                throw this.mismatch("a sequence", v);
            }
        }
    }

    pub fn seqHasNext(): bool throws DecodeError {
        let top = this.stack.length() - 1;
        match (this.stack[top]) {
            .Seq(items, at) => {
                return at < items.length();
            }
            _ => {
                throw DecodeError {
                    kind = .TypeMismatch,
                    path = this.path(),
                    detail = "not in a sequence",
                };
            }
        }
    }

    pub mut fn endSeq(): void throws DecodeError {
        this.stack.pop();
        this.segments.pop();
    }

    pub mut fn beginMap(): ?int throws DecodeError {
        let v = try this.peek();
        match (v) {
            .Map(entries) => {
                this.advance();
                this.stack.push(Reading.Map(entries, 0, false));
                this.segments.push("{}");
                return entries.length();
            }
            _ => {
                throw this.mismatch("a map", v);
            }
        }
    }

    pub fn mapHasNext(): bool throws DecodeError {
        let top = this.stack.length() - 1;
        match (this.stack[top]) {
            .Map(entries, at, _) => {
                return at < entries.length();
            }
            _ => {
                throw DecodeError {
                    kind = .TypeMismatch,
                    path = this.path(),
                    detail = "not in a map",
                };
            }
        }
    }

    pub mut fn endMap(): void throws DecodeError {
        this.stack.pop();
        this.segments.pop();
    }

    pub mut fn beginStruct(name: string, fields: string[]): void throws DecodeError {
        let v = try this.peek();
        match (v) {
            .Struct(found, fieldList) => {
                this.advance();
                this.stack.push(Reading.Struct(found, fieldList, null, Set<int>.new()));
                this.segments.push(name);
            }
            _ => {
                throw this.mismatch(f"the struct {name}", v);
            }
        }
    }

    pub mut fn structField(name: string): bool throws DecodeError {
        let top = this.stack.length() - 1;
        match (this.stack[top]) {
            .Struct(structName, fieldList, _, seen) => {
                var i = 0;
                while (i < fieldList.length()) {
                    if (fieldList[i].0 == name) {
                        seen.insert(i);
                        this.stack[top] = Reading.Struct(structName, fieldList, i, seen);
                        return true;
                    }
                    i = i + 1;
                }
                return false;
            }
            _ => {
                throw DecodeError {
                    kind = .TypeMismatch,
                    path = this.path(),
                    detail = "not in a struct",
                };
            }
        }
    }

    pub mut fn endStruct(denyUnknown: bool): void throws DecodeError {
        match (this.stack.pop()) {
            .Struct(_, fieldList, _, seen) => {
                if (denyUnknown) {
                    var i = 0;
                    while (i < fieldList.length()) {
                        if (!seen.contains(i)) {
                            throw DecodeError {
                                kind = .UnknownField,
                                path = this.path(),
                                detail = f"field '{fieldList[i].0}'",
                            };
                        }
                        i = i + 1;
                    }
                }
                this.segments.pop();
            }
            _ => { }
        }
    }

    pub mut fn beginVariant(enumName: string, variants: string[]): int throws DecodeError {
        let v = try this.peek();
        match (v) {
            .Variant(_, variant, _, payload) => {
                this.advance();
                var i = 0;
                while (i < variants.length()) {
                    if (variants[i] == variant) {
                        this.stack.push(Reading.Variant(enumName, variant, i, payload, false));
                        this.segments.push(variant);
                        return i;
                    }
                    i = i + 1;
                }
                throw DecodeError {
                    kind = .UnknownVariant,
                    path = this.path(),
                    detail = f"'{variant}' of {enumName}",
                };
            }
            _ => {
                throw this.mismatch(f"a variant of {enumName}", v);
            }
        }
    }

    pub fn variantHasPayload(): bool throws DecodeError {
        let top = this.stack.length() - 1;
        match (this.stack[top]) {
            .Variant(_, _, _, payload, _) => {
                return payload != null;
            }
            _ => {
                throw DecodeError {
                    kind = .TypeMismatch,
                    path = this.path(),
                    detail = "not in a variant",
                };
            }
        }
    }

    pub mut fn endVariant(): void throws DecodeError {
        this.stack.pop();
        this.segments.pop();
    }

    pub fn path(): string {
        return this.segments.toArray().join(".");
    }
}

/// Returns the form of a value in words, for an error.
fn formOf(v: Value): string {
    return match (v) {
        .Null => "null",
        .Bool(_) => "a bool",
        .Int(_) => "an int",
        .Uint(_) => "a uint",
        .Float(_) => "a float",
        .String(_) => "a string",
        .Bytes(_) => "bytes",
        .Seq(_) => "a sequence",
        .Map(_) => "a map",
        .Struct(name, _) => f"the struct {name}",
        .Variant(enumName, variant, _, _) => f"the variant {enumName}.{variant}",
    };
}

extend Value {
    /// Returns a new encoder that builds a tree.
    pub static fn encoder(): ValueEncoder {
        return ValueEncoder { };
    }

    /// Returns the tree `v` writes.
    ///
    /// # Errors
    ///
    /// Throws what encoding `v` throws.
    pub static fn of<T :: [Encode]>(v: T): Value throws EncodeError {
        var e = ValueEncoder { };
        try v.encode(&e);
        return e.value();
    }

    /// Decodes a `T` out of this tree.
    ///
    /// # Errors
    ///
    /// Throws `DecodeError` where the tree does not hold a `T`.
    pub fn read<T :: [Decode]>(): T throws DecodeError {
        var d = ValueDecoder { root = this };
        return try T.decode(&d);
    }

    /// Returns a decoder over this tree, to pass on.
    pub fn decoder(): ValueDecoder {
        return ValueDecoder { root = this };
    }
}

/// Encodes a `Value` as the forms it holds, and decodes one from any format. A format's own
/// dynamic tree (`JsonValue`) is the same idea over the format's own forms.
extend Value :: [Codable] {
    fn encode<E :: [Encoder]>(&e: E): void throws EncodeError {
        match (this) {
            .Null => {
                try e.encodeNull();
            }
            .Bool(b) => {
                try e.encodeBool(b);
            }
            .Int(i) => {
                try e.encodeInt(i);
            }
            .Uint(u) => {
                try e.encodeUint(u);
            }
            .Float(f) => {
                try e.encodeFloat(f);
            }
            .String(s) => {
                try e.encodeString(s);
            }
            .Bytes(b) => {
                try e.encodeBytes(b[..]);
            }
            .Seq(items) => {
                try e.beginSeq(items.length());
                for (x in items) {
                    try e.element(x);
                }
                try e.endSeq();
            }
            .Map(entries) => {
                try e.beginMap(entries.length());
                for ((k, v) in entries) {
                    try e.entry(k, v);
                }
                try e.endMap();
            }
            .Struct(name, fieldList) => {
                try e.beginStruct(name, fieldList.length());
                for ((f, v) in fieldList) {
                    try e.field(f, v);
                }
                try e.endStruct();
            }
            .Variant(enumName, variant, index, payload) => {
                if (let p = payload) {
                    try e.encodeVariant(enumName, variant, index, p.value);
                } else {
                    try e.encodeUnitVariant(enumName, variant, index);
                }
            }
        }
    }

    /// Reads whatever form the decoder has next. A decoder answers the form it is asked for, so
    /// the tree asks in turn — null, a bool, an int, a uint, a float, a string, bytes, a sequence,
    /// a map — and takes the first that is no mismatch. A struct or a variant cannot be asked for
    /// without its name: a format's own tree knows its forms; this one reads the scalars and the
    /// two anonymous containers.
    ///
    /// # Errors
    ///
    /// Throws `DecodeError` of kind `TypeMismatch` where the data holds a struct or a variant,
    /// or what reading a nested value throws.
    static fn decode<D :: [Decoder]>(&d: D): Value throws DecodeError {
        if (try d.isNull()) {
            try d.decodeNull();
            return Value.Null;
        }
        if (let b = try? d.decodeBool()) {
            return Value.Bool(b);
        }
        if (let i = try? d.decodeInt()) {
            return Value.Int(i);
        }
        if (let u = try? d.decodeUint()) {
            return Value.Uint(u);
        }
        if (let f = try? d.decodeFloat()) {
            return Value.Float(f);
        }
        if (let s = try? d.decodeString()) {
            return Value.String(s);
        }
        if (let b = try? d.decodeBytes()) {
            return Value.Bytes(b);
        }
        if ((try? d.beginSeq()) != null) {
            let items = List<Value>.new();
            while (try d.seqHasNext()) {
                items.push(try Value.decode(&d));
            }
            try d.endSeq();
            return Value.Seq(items);
        }
        if ((try? d.beginMap()) != null) {
            let entries = List<(Value, Value)>.new();
            while (try d.mapHasNext()) {
                let k = try Value.decode(&d);
                let v = try Value.decode(&d);
                entries.push((k, v));
            }
            try d.endMap();
            return Value.Map(entries);
        }
        throw DecodeError {
            kind = .TypeMismatch,
            path = d.path(),
            detail = "a struct or a variant, which a Value cannot read without its name",
        };
    }
}
