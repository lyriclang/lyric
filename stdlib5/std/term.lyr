//! The terminal, driven by ECMA-48 escape sequences.
//!
//! [isTerminal] asks whether a standard stream is a terminal, [size] how wide and high the
//! terminal on the standard output is. A [Style] is a set of attributes — a foreground and a
//! background [Color] (the 16, one of the 256, or RGB), bold, dim, italic, underline, inverse,
//! strike — whose [Style.apply] wraps a text in the SGR sequence and the reset where styles are
//! on (see [colorsEnabled]). [cursorUp] and the functions after it return the sequences
//! themselves, to print. Under Windows the runtime switches the console to virtual-terminal
//! processing once, so the same bytes mean the same there. The module has no raw mode.
//!
//! # Examples
//!
//! ```lyric,no_run
//! import std.io { println };
//! import std.term { Style };
//!
//! let warn = Style { fg = .Yellow, bold = true };
//! println(warn.apply("careful"));
//! ```
import std.os { env };
import std.core { StringBuilder };

extern "C" fn consoleIsTerminal(stream: int): int = "lyr_console_is_terminal";
extern "C" fn consoleSize(stream: int): int = "lyr_console_size";

/// One of the three standard streams of the process.
pub enum StdStream :: [Equatable, Debug] {
    Stdin,
    Stdout,
    Stderr,
}

fn fdOf(s: StdStream): int {
    return match (s) {
        .Stdin => 0,
        .Stdout => 1,
        .Stderr => 2,
    };
}

/// Returns whether the stream is a terminal.
///
/// A stream redirected to a pipe or a file, or not open at all, is not one.
pub fn isTerminal(stream: StdStream): bool {
    return consoleIsTerminal(fdOf(stream)) != 0;
}

/// Returns the columns and rows of the terminal on the standard output.
///
/// Returns `null` where the standard output is not a terminal.
pub fn size(): ?(int, int) {
    let v = consoleSize(1);
    if (v < 0) {
        return null;
    }
    return (v >> 16, v & 0xFFFF);
}

/// Returns whether styles are written out.
///
/// `NO_COLOR` set and not empty says no, else `FORCE_COLOR` set and not empty says yes, else
/// `TERM=dumb` says no, else the standard output being a terminal decides. An empty value
/// counts as not set, since `std.os` can set a variable but not unset it.
pub fn colorsEnabled(): bool {
    if (let no = env("NO_COLOR")) {
        if (!no.isEmpty()) {
            return false;
        }
    }
    if (let force = env("FORCE_COLOR")) {
        if (!force.isEmpty()) {
            return true;
        }
    }
    if (let term = env("TERM")) {
        if (term == "dumb") {
            return false;
        }
    }
    return isTerminal(StdStream.Stdout);
}

/// A terminal color: one of the 16 of ECMA-48 and aixterm, one of the 256, or RGB.
///
/// Out-of-range components of [Color.Index] and [Color.Rgb] are clamped to 0..255.
pub enum Color :: [Equatable, Debug] {
    Black,
    Red,
    Green,
    Yellow,
    Blue,
    Magenta,
    Cyan,
    White,
    BrightBlack,
    BrightRed,
    BrightGreen,
    BrightYellow,
    BrightBlue,
    BrightMagenta,
    BrightCyan,
    BrightWhite,
    /// One of the 256 colors, by index (0..255).
    Index(int),
    /// A color by its red, green and blue components (each 0..255).
    Rgb(int, int, int),
}

/// Returns the SGR parameter of the color, as foreground or background.
fn colorParam(c: Color, background: bool): string {
    let base = if (background) 40 else 30;
    let bright = if (background) 100 else 90;
    return match (c) {
        .Black => f"{base}",
        .Red => f"{base + 1}",
        .Green => f"{base + 2}",
        .Yellow => f"{base + 3}",
        .Blue => f"{base + 4}",
        .Magenta => f"{base + 5}",
        .Cyan => f"{base + 6}",
        .White => f"{base + 7}",
        .BrightBlack => f"{bright}",
        .BrightRed => f"{bright + 1}",
        .BrightGreen => f"{bright + 2}",
        .BrightYellow => f"{bright + 3}",
        .BrightBlue => f"{bright + 4}",
        .BrightMagenta => f"{bright + 5}",
        .BrightCyan => f"{bright + 6}",
        .BrightWhite => f"{bright + 7}",
        .Index(i) => f"{base + 8};5;{clamp(i, 255)}",
        .Rgb(r, g, b) => f"{base + 8};2;{clamp(r, 255)};{clamp(g, 255)};{clamp(b, 255)}",
    };
}

fn clamp(v: int, most: int): int {
    return if (v < 0) 0 else if (v > most) most else v;
}

/// The escape character (ESC).
let escape = "\u{1b}";

/// Returns the SGR sequence that turns every style off.
pub fn reset(): string {
    return "\u{1b}[0m";
}

/// A set of attributes to put on a text: colors and SGR flags, all off by default.
pub struct Style :: [Equatable, Debug] {
    pub fg: ?Color = null,
    pub bg: ?Color = null,
    pub bold: bool = false,
    pub dim: bool = false,
    pub italic: bool = false,
    pub underline: bool = false,
    pub inverse: bool = false,
    pub strike: bool = false,

    /// Returns whether the style sets no color and no attribute.
    pub fn isPlain(): bool {
        return this.fg == null
            && this.bg == null
            && !this.bold
            && !this.dim
            && !this.italic
            && !this.underline
            && !this.inverse
            && !this.strike;
    }

    /// Returns the SGR sequence that turns the style on.
    ///
    /// Returns an empty string for a plain style.
    pub fn sgr(): string {
        if (this.isPlain()) {
            return "";
        }
        let out = StringBuilder.new();
        out.appendStr("\u{1b}[");
        var first = true;
        let add = (p: string) => {
            if (!first) {
                out.appendChar(';');
            }
            first = false;
            out.appendStr(p);
        };
        if (this.bold) {
            add("1");
        }
        if (this.dim) {
            add("2");
        }
        if (this.italic) {
            add("3");
        }
        if (this.underline) {
            add("4");
        }
        if (this.inverse) {
            add("7");
        }
        if (this.strike) {
            add("9");
        }
        if (let c = this.fg) {
            add(colorParam(c, false));
        }
        if (let c = this.bg) {
            add(colorParam(c, true));
        }
        out.appendChar('m');
        return out.toString();
    }

    /// Returns the text wrapped in the style's sequence and the reset.
    ///
    /// Returns the text unchanged where the style is plain or [colorsEnabled] says no.
    pub fn apply(text: string): string {
        if (this.isPlain() || !colorsEnabled()) {
            return text;
        }
        return this.sgr() + text + reset();
    }

    /// Returns the text wrapped in the style's sequence and the reset, whatever the terminal is.
    ///
    /// Returns the text unchanged only where the style is plain.
    pub fn force(text: string): string {
        if (this.isPlain()) {
            return text;
        }
        return this.sgr() + text + reset();
    }
}

// ---------------------------------------------------------------------------------------------
// The cursor and the screen (ECMA-48 §8.3): the sequences, to print.
// ---------------------------------------------------------------------------------------------

/// Returns the sequence that moves the cursor `n` rows up (`CUU`).
pub fn cursorUp(n: int = 1): string {
    return f"\u{1b}[{n}A";
}

/// Returns the sequence that moves the cursor `n` rows down (`CUD`).
pub fn cursorDown(n: int = 1): string {
    return f"\u{1b}[{n}B";
}

/// Returns the sequence that moves the cursor `n` columns right (`CUF`).
pub fn cursorForward(n: int = 1): string {
    return f"\u{1b}[{n}C";
}

/// Returns the sequence that moves the cursor `n` columns left (`CUB`).
pub fn cursorBack(n: int = 1): string {
    return f"\u{1b}[{n}D";
}

/// Returns the sequence that moves the cursor to the row and column, both counted from 1 (`CUP`).
pub fn cursorTo(row: int, column: int): string {
    return f"\u{1b}[{row};{column}H";
}

/// Returns the sequence that moves the cursor to the start of the line `n` lines down (`CNL`).
pub fn cursorNextLine(n: int = 1): string {
    return f"\u{1b}[{n}E";
}

/// Returns the sequence that hides the cursor.
pub fn cursorHide(): string {
    return "\u{1b}[?25l";
}

/// Returns the sequence that shows the cursor again.
pub fn cursorShow(): string {
    return "\u{1b}[?25h";
}

/// Returns the sequence that saves the cursor's position (`SCOSC`).
///
/// [cursorRestore] moves the cursor back there. Both are the forms xterm and the Windows
/// console accept.
pub fn cursorSave(): string {
    return "\u{1b}[s";
}

/// Returns the sequence that moves the cursor to the position [cursorSave] saved (`SCORC`).
pub fn cursorRestore(): string {
    return "\u{1b}[u";
}

/// Returns the sequence that erases the whole screen and moves the cursor to the top left.
pub fn clearScreen(): string {
    return "\u{1b}[2J\u{1b}[H";
}

/// Returns the sequence that erases from the cursor to the end of the screen.
pub fn clearToEnd(): string {
    return "\u{1b}[0J";
}

/// Returns the sequence that erases the whole line and moves the cursor to its start.
pub fn eraseLine(): string {
    return "\u{1b}[2K\r";
}

/// Returns the sequence that erases from the cursor to the end of the line.
pub fn eraseToEndOfLine(): string {
    return "\u{1b}[0K";
}
