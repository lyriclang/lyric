/// The adapters of every iterator (design/v5/spec/10 B6 I3, I4; M9a S11c): `map`, `filter`, `take`,
/// `zip`, `chain`, `flatMap`, `peekable`, `rev`, `cycle` …, each a struct of its own, monomorphized
/// and allocation-free; the terminators `sum`, `product`, `average`, `min`, `max`, `minBy`, `maxBy`,
/// `join`, `toArray`, `collect`. The prelude names this module, so its blocks reach every iterator
/// without an import; the structs are named here — `iter.MapIter<I, U>` — where a type is written.
/// The protocol itself (`Iterator`, `Iterable`, `DoubleEnded`, `Step`, `FromIterator`), the ranges
/// and the iterators of std.core's own types stay in std.core.
import std.core { DoubleEnded, Join };

/// `it.map(f)` (10 B6 I3, I4): the values of `it`, each through `f` — lazily, a pull at a time.
/// Named for what it gives: `Map` is the collection's (C4). What `f` throws, a pull throws beside
/// what `it` does (05 K4; 13 M8c P2).
pub struct MapIter<I :: [Iterator], U, E :: [Error] = never> :: [Iterator] {
    type Item = U;
    type Error = Join<I.Error, E>;
    var inner: I,
    f: fn(I.Item) -> U throws E,

    pub mut fn next(): ?U throws Join<I.Error, E> {
        let x = try this.inner.next();
        if (x == null) {
            return null;
        }
        return try this.f(x);
    }
}

/// `it.filter(p)`: the values of `it` that `p` holds for.
pub struct FilterIter<I :: [Iterator], E :: [Error] = never> :: [Iterator] {
    type Item = I.Item;
    type Error = Join<I.Error, E>;
    var inner: I,
    p: fn(I.Item) -> bool throws E,

    pub mut fn next(): ?I.Item throws Join<I.Error, E> {
        var x = try this.inner.next();
        while (x != null && !(try this.p(x))) {
            x = try this.inner.next();
        }
        return x;
    }
}

/// `it.take(n)`: the first `n` values of `it`, or all where it has fewer.
pub struct TakeIter<I :: [Iterator]> :: [Iterator] {
    type Item = I.Item;
    type Error = I.Error;
    var inner: I,
    var left: int,

    pub mut fn next(): ?I.Item throws I.Error {
        if (this.left <= 0) {
            return null;
        }
        this.left = this.left - 1;
        return try this.inner.next();
    }
}

/// `it.skip(n)`: the values of `it` after its first `n`.
pub struct SkipIter<I :: [Iterator]> :: [Iterator] {
    type Item = I.Item;
    type Error = I.Error;
    var inner: I,
    var n: int,

    pub mut fn next(): ?I.Item throws I.Error {
        while (this.n > 0) {
            this.n = this.n - 1;
            if (try this.inner.next() == null) {
                return null;
            }
        }
        return try this.inner.next();
    }
}

/// `it.takeWhile(p)`: the values of `it` up to the first `p` does not hold for.
pub struct TakeWhileIter<I :: [Iterator], E :: [Error] = never> :: [Iterator] {
    type Item = I.Item;
    type Error = Join<I.Error, E>;
    var inner: I,
    p: fn(I.Item) -> bool throws E,
    var done: bool,

    pub mut fn next(): ?I.Item throws Join<I.Error, E> {
        if (this.done) {
            return null;
        }
        let x = try this.inner.next();
        if (x == null) {
            this.done = true;
            return null;
        }
        if (!(try this.p(x))) {
            this.done = true;
            return null;
        }
        return x;
    }
}

/// `it.skipWhile(p)`: the values of `it` from the first `p` does not hold for.
pub struct SkipWhileIter<I :: [Iterator], E :: [Error] = never> :: [Iterator] {
    type Item = I.Item;
    type Error = Join<I.Error, E>;
    var inner: I,
    p: fn(I.Item) -> bool throws E,
    var started: bool,

    pub mut fn next(): ?I.Item throws Join<I.Error, E> {
        if (this.started) {
            return try this.inner.next();
        }
        this.started = true;
        var x = try this.inner.next();
        while (x != null && (try this.p(x))) {
            x = try this.inner.next();
        }
        return x;
    }
}

/// `it.stepBy(n)`: the first value of `it`, then every `n`th.
pub struct StepByIter<I :: [Iterator]> :: [Iterator] {
    type Item = I.Item;
    type Error = I.Error;
    var inner: I,
    step: int,
    var first: bool,

    pub mut fn next(): ?I.Item throws I.Error {
        if (this.first) {
            this.first = false;
            return try this.inner.next();
        }
        var gap = this.step - 1;
        while (gap > 0) {
            gap = gap - 1;
            if (try this.inner.next() == null) {
                return null;
            }
        }
        return try this.inner.next();
    }
}

/// `it.enumerate()`: each value of `it` with its position, from 0.
pub struct EnumerateIter<I :: [Iterator]> :: [Iterator] {
    type Item = (int, I.Item);
    type Error = I.Error;
    var inner: I,
    var i: int,

    pub mut fn next(): ?(int, I.Item) throws I.Error {
        let x = try this.inner.next();
        if (x == null) {
            return null;
        }
        this.i = this.i + 1;
        return (this.i - 1, x);
    }
}

/// `it.inspect(f)`: the values of `it`, each shown to `f` on its way through.
pub struct InspectIter<I :: [Iterator], E :: [Error] = never> :: [Iterator] {
    type Item = I.Item;
    type Error = Join<I.Error, E>;
    var inner: I,
    f: fn(I.Item) -> void throws E,

    pub mut fn next(): ?I.Item throws Join<I.Error, E> {
        let x = try this.inner.next();
        if (x != null) {
            try this.f(x);
        }
        return x;
    }
}

pub struct ZipIter<A :: [Iterator], B :: [Iterator]> :: [Iterator] {
    type Item = (A.Item, B.Item);
    type Error = Join<A.Error, B.Error>;
    var a: A,
    var b: B,

    pub mut fn next(): ?(A.Item, B.Item) throws Join<A.Error, B.Error> {
        let x = try this.a.next();
        if (x == null) {
            return null;
        }
        let y = try this.b.next();
        if (y == null) {
            return null;
        }
        return (x, y);
    }
}

/// `it.chain(other)`: the values of `it`, then the other's.
pub struct ChainIter<A :: [Iterator], B :: [Iterator<Item = A.Item>]> :: [Iterator] {
    type Item = A.Item;
    type Error = Join<A.Error, B.Error>;
    var a: A,
    var b: B,
    var second: bool,

    pub mut fn next(): ?A.Item throws Join<A.Error, B.Error> {
        if (!this.second) {
            let x = try this.a.next();
            if (x != null) {
                return x;
            }
            this.second = true;
        }
        return try this.b.next();
    }
}

/// `it.mapNotNull(f)`: the values of `it` through `f`, the `null`s left out.
pub struct MapNotNullIter<I :: [Iterator], U, E :: [Error] = never> :: [Iterator] {
    type Item = U;
    type Error = Join<I.Error, E>;
    var inner: I,
    f: fn(I.Item) -> ?U throws E,

    pub mut fn next(): ?U throws Join<I.Error, E> {
        loop {
            let x = try this.inner.next();
            if (x == null) {
                return null;
            }
            let y = try this.f(x);
            if (y != null) {
                return y;
            }
        }
    }
}

/// `it.flatMap(f)`: the values of what `f` gives for each value of `it`, one after the other — `f`
/// gives an `Iterable`, an array or a list as well as an iterator.
pub struct FlatMapIter<I :: [Iterator], B :: [Iterable<Iter = J>], J :: [Iterator], E :: [Error] = never> :: [Iterator] {
    type Item = J.Item;
    type Error = Join<Join<I.Error, E>, J.Error>;
    var inner: I,
    f: fn(I.Item) -> B throws E,
    var current: ?J,

    pub mut fn next(): ?J.Item throws Join<Join<I.Error, E>, J.Error> {
        loop {
            if (this.current != null) {
                var part = this.current!;
                let x = try part.next();
                this.current = part;
                if (x != null) {
                    return x;
                }
                this.current = null;
            }
            let outer = try this.inner.next();
            if (outer == null) {
                return null;
            }
            this.current = (try this.f(outer)).iter();
        }
    }
}

/// `it.flatten()`: the values of the iterables `it` gives, one after the other.
pub struct FlattenIter<I :: [Iterator<Item = B>], B :: [Iterable<Iter = J>], J :: [Iterator]> :: [Iterator] {
    type Item = J.Item;
    type Error = Join<I.Error, J.Error>;
    var inner: I,
    var current: ?J,

    pub mut fn next(): ?J.Item throws Join<I.Error, J.Error> {
        loop {
            if (this.current != null) {
                var part = this.current!;
                let x = try part.next();
                this.current = part;
                if (x != null) {
                    return x;
                }
                this.current = null;
            }
            let outer = try this.inner.next();
            if (outer == null) {
                return null;
            }
            this.current = outer.iter();
        }
    }
}

/// `it.dedupBy(same)`, `it.dedup()`: the values of `it`, a run of ones `same` holds for given once.
pub struct DedupIter<I :: [Iterator], E :: [Error] = never> :: [Iterator] {
    type Item = I.Item;
    type Error = Join<I.Error, E>;
    var inner: I,
    same: fn(I.Item, I.Item) -> bool throws E,
    var last: ?I.Item,

    pub mut fn next(): ?I.Item throws Join<I.Error, E> {
        loop {
            let x = try this.inner.next();
            if (x == null) {
                return null;
            }
            if (let previous = this.last) {
                if (try this.same(previous, x)) {
                    continue;
                }
            }
            this.last = x;
            return x;
        }
    }
}

/// `it.scan(init, f)`: `init`, then each value `f` makes of the one before and a value of `it` —
/// the running values of `fold` (Kotlin's `scan`).
pub struct ScanIter<I :: [Iterator], A, E :: [Error] = never> :: [Iterator] {
    type Item = A;
    type Error = Join<I.Error, E>;
    var inner: I,
    f: fn(A, I.Item) -> A throws E,
    var acc: A,
    var started: bool,

    pub mut fn next(): ?A throws Join<I.Error, E> {
        if (!this.started) {
            this.started = true;
            return this.acc;
        }
        let x = try this.inner.next();
        if (x == null) {
            return null;
        }
        this.acc = try this.f(this.acc, x);
        return this.acc;
    }
}

/// `it.peekable()`: the values of `it`, and `peek()`, the next one without taking it.
pub struct PeekableIter<I :: [Iterator]> :: [Iterator] {
    type Item = I.Item;
    type Error = I.Error;
    var inner: I,
    var peeked: ?I.Item,
    var hasPeeked: bool,

    /// The value `next()` gives next, or `null` at the end — pulled from the inner iterator once.
    pub mut fn peek(): ?I.Item throws I.Error {
        if (!this.hasPeeked) {
            this.peeked = try this.inner.next();
            this.hasPeeked = true;
        }
        return this.peeked;
    }

    pub mut fn next(): ?I.Item throws I.Error {
        if (this.hasPeeked) {
            this.hasPeeked = false;
            return this.peeked;
        }
        return try this.inner.next();
    }
}

/// `it.rev()`: the values of a `DoubleEnded` iterator from its back. A pull from the back throws
/// nothing (`DoubleEnded`), so neither does this walk; it is no `DoubleEnded` itself, as a pull
/// from its back would be the inner one's front, which may throw.
pub struct RevIter<I :: [DoubleEnded]> :: [Iterator] {
    type Item = I.Item;
    type Error = never;
    var inner: I,

    pub mut fn next(): ?I.Item {
        return this.inner.nextBack();
    }
}

/// `it.cycle()`: the values of `it` over and over, from a clone of it each time — none where it has
/// none.
pub struct CycleIter<I :: [Iterator, Clone]> :: [Iterator] {
    type Item = I.Item;
    type Error = I.Error;
    origin: I,
    var current: I,

    pub mut fn next(): ?I.Item throws I.Error {
        let x = try this.current.next();
        if (x != null) {
            return x;
        }
        this.current = this.origin.clone();
        return try this.current.next();
    }
}

// Closing through an adapter (I6; the review's M8a-4): an adapter over a Closeable iterator is
// Closeable itself and passes `close()` on, so a loop that leaves early closes the generator
// behind `gen().map(f)`. Its `close()` throws what the inner one's may — the inner's Error, which
// is the adapter's own —, as the rule at the declaration asks of every Closeable iterator
// (LYR-SEM0174). The two over two iterators close both; where both throw, the first error wins
// and the second is suppressed into it (05 E7).

extend<I :: [Iterator, Closeable], U, E :: [Error]> MapIter<I, U, E> :: [Closeable] {
    fn close(): void throws I.Error {
        try this.inner.close();
    }
}

extend<I :: [Iterator, Closeable], E :: [Error]> FilterIter<I, E> :: [Closeable] {
    fn close(): void throws I.Error {
        try this.inner.close();
    }
}

extend<I :: [Iterator, Closeable]> TakeIter<I> :: [Closeable] {
    fn close(): void throws I.Error {
        try this.inner.close();
    }
}

extend<I :: [Iterator, Closeable]> SkipIter<I> :: [Closeable] {
    fn close(): void throws I.Error {
        try this.inner.close();
    }
}

extend<I :: [Iterator, Closeable], E :: [Error]> TakeWhileIter<I, E> :: [Closeable] {
    fn close(): void throws I.Error {
        try this.inner.close();
    }
}

extend<I :: [Iterator, Closeable], E :: [Error]> SkipWhileIter<I, E> :: [Closeable] {
    fn close(): void throws I.Error {
        try this.inner.close();
    }
}

extend<I :: [Iterator, Closeable]> StepByIter<I> :: [Closeable] {
    fn close(): void throws I.Error {
        try this.inner.close();
    }
}

extend<I :: [Iterator, Closeable]> EnumerateIter<I> :: [Closeable] {
    fn close(): void throws I.Error {
        try this.inner.close();
    }
}

extend<I :: [Iterator, Closeable], E :: [Error]> InspectIter<I, E> :: [Closeable] {
    fn close(): void throws I.Error {
        try this.inner.close();
    }
}

extend<I :: [Iterator, Closeable], U, E :: [Error]> MapNotNullIter<I, U, E> :: [Closeable] {
    fn close(): void throws I.Error {
        try this.inner.close();
    }
}

extend<I :: [Iterator, Closeable], E :: [Error]> DedupIter<I, E> :: [Closeable] {
    fn close(): void throws I.Error {
        try this.inner.close();
    }
}

extend<I :: [Iterator, Closeable], A, E :: [Error]> ScanIter<I, A, E> :: [Closeable] {
    fn close(): void throws I.Error {
        try this.inner.close();
    }
}

extend<I :: [Iterator, Closeable]> PeekableIter<I> :: [Closeable] {
    fn close(): void throws I.Error {
        try this.inner.close();
    }
}

// The outer iterator closed; a part `f` or the source gave is the walk's own, closed by none.
extend<I :: [Iterator, Closeable], B :: [Iterable<Iter = J>], J :: [Iterator], E :: [Error]> FlatMapIter<I, B, J, E> :: [Closeable] {
    fn close(): void throws I.Error {
        try this.inner.close();
    }
}

extend<I :: [Iterator<Item = B>, Closeable], B :: [Iterable<Iter = J>], J :: [Iterator]> FlattenIter<I, B, J> :: [Closeable] {
    fn close(): void throws I.Error {
        try this.inner.close();
    }
}

extend<A :: [Iterator, Closeable], B :: [Iterator, Closeable]> ZipIter<A, B> :: [Closeable] {
    fn close(): void throws Join<A.Error, B.Error> {
        defer try this.b.close();
        try this.a.close();
    }
}

extend<A :: [Iterator, Closeable], B :: [Iterator<Item = A.Item>, Closeable]> ChainIter<A, B> :: [Closeable] {
    fn close(): void throws Join<A.Error, B.Error> {
        defer try this.b.close();
        try this.a.close();
    }
}

// The adapters (I3): members of every iterator, each a struct of its own — monomorphized, no
// allocation, no interface value.
extend<I :: [Iterator]> I {
    /// The values, each through `f`.
    pub fn map<U, E :: [Error]>(f: fn(I.Item) -> U throws E): MapIter<I, U, E> {
        return MapIter<I, U, E> { inner = this, f = f };
    }

    /// The values `p` holds for.
    pub fn filter<E :: [Error]>(p: fn(I.Item) -> bool throws E): FilterIter<I, E> {
        return FilterIter<I, E> { inner = this, p = p };
    }

    /// The first `n` values, or all where there are fewer.
    pub fn take(n: int): TakeIter<I> {
        return TakeIter<I> { inner = this, left = n };
    }

    /// The values after the first `n`.
    pub fn skip(n: int): SkipIter<I> {
        return SkipIter<I> { inner = this, n = n };
    }

    /// The values up to the first `p` does not hold for.
    pub fn takeWhile<E :: [Error]>(p: fn(I.Item) -> bool throws E): TakeWhileIter<I, E> {
        return TakeWhileIter<I, E> { inner = this, p = p, done = false };
    }

    /// The values from the first `p` does not hold for.
    pub fn skipWhile<E :: [Error]>(p: fn(I.Item) -> bool throws E): SkipWhileIter<I, E> {
        return SkipWhileIter<I, E> { inner = this, p = p, started = false };
    }

    /// The first value, then every `n`th; `n` below 1 panics.
    pub fn stepBy(n: int): StepByIter<I> {
        if (n < 1) {
            panic("stepBy needs a step of at least 1");
        }
        return StepByIter<I> { inner = this, step = n, first = true };
    }

    /// Each value with its position, from 0.
    pub fn enumerate(): EnumerateIter<I> {
        return EnumerateIter<I> { inner = this, i = 0 };
    }

    /// The values, each shown to `f` on its way through.
    pub fn inspect<E :: [Error]>(f: fn(I.Item) -> void throws E): InspectIter<I, E> {
        return InspectIter<I, E> { inner = this, f = f };
    }

    /// Each value beside the other's at its position, as long as both have one.
    pub fn zip<B :: [Iterable]>(other: B): ZipIter<I, B.Iter> {
        return ZipIter<I, B.Iter> { a = this, b = other.iter() };
    }

    /// The values, then the other's — an iterator of the same items.
    pub fn chain<B :: [Iterator<Item = I.Item>]>(other: B): ChainIter<I, B> {
        return ChainIter<I, B> { a = this, b = other, second = false };
    }

    /// The values through `f`, the `null`s left out.
    pub fn mapNotNull<U, E :: [Error]>(f: fn(I.Item) -> ?U throws E): MapNotNullIter<I, U, E> {
        return MapNotNullIter<I, U, E> { inner = this, f = f };
    }

    /// The values of what `f` gives for each value, one after the other.
    pub fn flatMap<B :: [Iterable], E :: [Error]>(f: fn(I.Item) -> B throws E): FlatMapIter<I, B, B.Iter, E> {
        return FlatMapIter<I, B, B.Iter, E> { inner = this, f = f, current = null };
    }

    /// A run of values `same` holds for, given once.
    pub fn dedupBy<E :: [Error]>(same: fn(I.Item, I.Item) -> bool throws E): DedupIter<I, E> {
        return DedupIter<I, E> { inner = this, same = same, last = null };
    }

    /// `init`, then the running values `f` makes.
    pub fn scan<A, E :: [Error]>(init: A, f: fn(A, I.Item) -> A throws E): ScanIter<I, A, E> {
        return ScanIter<I, A, E> { inner = this, f = f, acc = init, started = false };
    }

    /// The values, with `peek()` to look at the next one.
    pub fn peekable(): PeekableIter<I> {
        return PeekableIter<I> { inner = this, peeked = null, hasPeeked = false };
    }

    /// How many values there are, walking them all.
    pub fn count(): int throws I.Error {
        var it = this;
        var n = 0;
        while (try it.next() != null) {
            n = n + 1;
        }
        return n;
    }

    /// `f` over the values from `init`, the last result the answer.
    pub fn fold<A, E :: [Error]>(init: A, f: fn(A, I.Item) -> A throws E): A throws Join<I.Error, E> {
        var it = this;
        var acc = init;
        var x = try it.next();
        while (x != null) {
            acc = try f(acc, x);
            x = try it.next();
        }
        return acc;
    }

    /// `f` over the values from the first; `null` where there is none.
    pub fn reduce<E :: [Error]>(f: fn(I.Item, I.Item) -> I.Item throws E): ?I.Item throws Join<I.Error, E> {
        var it = this;
        let first = try it.next();
        if (first == null) {
            return null;
        }
        var acc = first;
        var x = try it.next();
        while (x != null) {
            acc = try f(acc, x);
            x = try it.next();
        }
        return acc;
    }

    /// The first value, or `null`.
    pub fn first(): ?I.Item throws I.Error {
        var it = this;
        return try it.next();
    }

    /// The last value, or `null` — walking them all.
    pub fn last(): ?I.Item throws I.Error {
        var it = this;
        var last = try it.next();
        if (last == null) {
            return null;
        }
        var x = try it.next();
        while (x != null) {
            last = x;
            x = try it.next();
        }
        return last;
    }

    /// The value at position `n` from 0, or `null` — a negative `n` included.
    pub fn nth(n: int): ?I.Item throws I.Error {
        if (n < 0) {
            return null;
        }
        var it = this;
        var left = n;
        while (left > 0) {
            if (try it.next() == null) {
                return null;
            }
            left = left - 1;
        }
        return try it.next();
    }

    /// Whether `p` holds for some value; stops at the first.
    pub fn any<E :: [Error]>(p: fn(I.Item) -> bool throws E): bool throws Join<I.Error, E> {
        return try this.find(p) != null;
    }

    /// Whether `p` holds for every value; stops at the first it does not — `true` for none.
    pub fn all<E :: [Error]>(p: fn(I.Item) -> bool throws E): bool throws Join<I.Error, E> {
        return try this.find((v) => !(try p(v))) == null;
    }

    /// Whether `p` holds for no value.
    pub fn none<E :: [Error]>(p: fn(I.Item) -> bool throws E): bool throws Join<I.Error, E> {
        return try this.find(p) == null;
    }

    /// The first value `p` holds for, or `null`.
    pub fn find<E :: [Error]>(p: fn(I.Item) -> bool throws E): ?I.Item throws Join<I.Error, E> {
        var it = this;
        var x = try it.next();
        while (x != null && !(try p(x))) {
            x = try it.next();
        }
        return x;
    }

    /// The position of the first value `p` holds for, from 0, or `null`.
    pub fn position<E :: [Error]>(p: fn(I.Item) -> bool throws E): ?int throws Join<I.Error, E> {
        var it = this;
        var i = 0;
        var x = try it.next();
        while (x != null) {
            if (try p(x)) {
                return i;
            }
            i = i + 1;
            x = try it.next();
        }
        return null;
    }


    /// The value whose `key` is least, or `null`; the first of equal ones.
    pub fn minBy<K :: [TotalOrder], E :: [Error]>(key: fn(I.Item) -> K throws E): ?I.Item throws Join<I.Error, E> {
        var it = this;
        let first = try it.next();
        if (first == null) {
            return null;
        }
        var best = first;
        var bestKey = try key(first);
        var x = try it.next();
        while (x != null) {
            let k = try key(x);
            if (k < bestKey) {
                best = x;
                bestKey = k;
            }
            x = try it.next();
        }
        return best;
    }

    /// The value whose `key` is greatest, or `null`; the first of equal ones.
    pub fn maxBy<K :: [TotalOrder], E :: [Error]>(key: fn(I.Item) -> K throws E): ?I.Item throws Join<I.Error, E> {
        var it = this;
        let first = try it.next();
        if (first == null) {
            return null;
        }
        var best = first;
        var bestKey = try key(first);
        var x = try it.next();
        while (x != null) {
            let k = try key(x);
            if (k > bestKey) {
                best = x;
                bestKey = k;
            }
            x = try it.next();
        }
        return best;
    }
    /// `f` for every value, in order. Inline (08 F6): a lambda written at the call is set in place —
    /// a `return` in it leaves the function that wrote it, `break` and `continue` reach its loops.
    pub inline fn forEach<E :: [Error]>(f: fn(I.Item) -> void throws E): void throws Join<I.Error, E> {
        var it = this;
        var x = try it.next();
        while (x != null) {
            try f(x);
            x = try it.next();
        }
    }

    /// The values in an array, in order — the array's own `fromIter`, in one pass.
    pub fn toArray(): I.Item[] throws I.Error {
        let out: I.Item[] = try this.collect();
        return out;
    }
}

// The terminators of an element kind (10 B6 I4): blocks whose `T` the iterator's `Item` binds
// (05 §13 rule 2), reaching the iterators of numbers, of ordered values, of shown ones.
// The terminators and adapters of a kind of iterator (10 B6 I4): a flat walk over iterables, runs
// of equal values, the walk from the back, the walk over and over, the mean.

extend<I :: [Iterator<Item = B>], B :: [Iterable]> I {
    /// The values of the iterables, one after the other.
    pub fn flatten(): FlattenIter<I, B, B.Iter> {
        return FlattenIter<I, B, B.Iter> { inner = this, current = null };
    }
}

extend<I :: [Iterator<Item = T>], T :: [Equatable]> I {
    /// A run of equal values, given once.
    pub fn dedup(): DedupIter<I, never> {
        // the comparison throws nothing: its set is empty (M8c S17 — before it, I.Error stood here)
        return DedupIter<I, never> { inner = this, same = (a: T, b: T) => a == b, last = null };
    }
}

extend<I :: [DoubleEnded]> I {
    /// The values from the back.
    pub fn rev(): RevIter<I> {
        return RevIter<I> { inner = this };
    }
}

extend<I :: [Iterator, Clone]> I {
    /// The values over and over: an iterator a clone of which starts anew.
    pub fn cycle(): CycleIter<I> {
        return CycleIter<I> { origin = this.clone(), current = this };
    }
}

extend<I :: [Iterator<Item = int>]> I {
    /// The mean of the values, or `null` where there is none — summed as `float`, which no
    /// `int` sum overflows.
    pub fn average(): ?float throws I.Error {
        var it = this;
        var total = 0.0;
        var n = 0;
        var x = try it.next();
        while (x != null) {
            total = total + (x as float);
            n = n + 1;
            x = try it.next();
        }
        if (n == 0) {
            return null;
        }
        return total / (n as float);
    }
}

extend<I :: [Iterator<Item = float>]> I {
    /// The mean of the values, or `null` where there is none.
    pub fn average(): ?float throws I.Error {
        var it = this;
        var total = 0.0;
        var n = 0;
        var x = try it.next();
        while (x != null) {
            total = total + x;
            n = n + 1;
            x = try it.next();
        }
        if (n == 0) {
            return null;
        }
        return total / (n as float);
    }
}

// A value iterator is a clone of itself: a copy walks on its own (cycle).
extend<I :: [Iterator<Item = T>], T :: [Num]> I {
    /// The sum of the values; zero where there is none.
    pub fn sum(): T throws I.Error {
        var it = this;
        var s = T.zero;
        var x = try it.next();
        while (x != null) {
            s = s + x;
            x = try it.next();
        }
        return s;
    }

    /// The product of the values; one where there is none.
    pub fn product(): T throws I.Error {
        var it = this;
        var p = T.one;
        var x = try it.next();
        while (x != null) {
            p = p * x;
            x = try it.next();
        }
        return p;
    }
}

extend<I :: [Iterator<Item = T>], T :: [Ordered]> I {
    /// The least value, or `null`; the first of equal ones.
    pub fn min(): ?T throws I.Error {
        var it = this;
        let first = try it.next();
        if (first == null) {
            return null;
        }
        var least = first;
        var x = try it.next();
        while (x != null) {
            if (x < least) {
                least = x;
            }
            x = try it.next();
        }
        return least;
    }

    /// The greatest value, or `null`; the first of equal ones.
    pub fn max(): ?T throws I.Error {
        var it = this;
        let first = try it.next();
        if (first == null) {
            return null;
        }
        var most = first;
        var x = try it.next();
        while (x != null) {
            if (x > most) {
                most = x;
            }
            x = try it.next();
        }
        return most;
    }
}

extend<I :: [Iterator<Item = T>], T :: [Display]> I {
    /// The values' texts, `sep` between each two.
    pub fn join(sep: string): string throws I.Error {
        var it = this;
        var out = "";
        var x = try it.next();
        var first = true;
        while (x != null) {
            if (!first) {
                out = out + sep;
            }
            first = false;
            out = out + f"{x}";
            x = try it.next();
        }
        return out;
    }
}

extend<I :: [Iterator]> I {
    /// The values in a value of the expected type, built through its `FromIterator` (10 I4):
    /// `let names: Set<string> = words.iter().collect();`.
    pub fn collect<C :: [FromIterator<I.Item>]>(): C throws I.Error {
        return try C.fromIter(this);
    }
}

// --- membership (05 §12 rule 10; 10 C12; M8a S15) -----------------------------------------------
// `x in xs` is `xs.contains(x)`: a range holds what lies between its bounds.
