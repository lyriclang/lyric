//! Provides the adapters and terminators of every iterator.
//!
//! The adapters — `map`, `filter`, `take`, `zip`, `chain`, `flatMap`, `peekable`, `rev`, `cycle`
//! and more — are lazy, each a struct of its own ([MapIter], [FilterIter], …), monomorphized and
//! allocation-free. The terminators — `count`, `fold`, `find`, `sum`, `product`, `average`, `min`,
//! `max`, `minBy`, `maxBy`, `join`, `toArray`, `collect` and more — walk the iterator to an answer.
//! The prelude names this module, so its members reach every iterator without an import; where a
//! type is written, the structs are named through it, as `iter.MapIter<I, U>`.
//!
//! The protocol itself (`Iterator`, `Iterable`, `DoubleEnded`, `Step`, `FromIterator`), the ranges
//! and the iterators of std.core's own types live in std.core.
//!
//! # Examples
//!
//! ```lyric
//! import std.io { println };
//!
//! let squares = (1..=10).filter((n) => n % 2 == 0).map((n) => n * n).toArray();
//! println(squares.length());
//! println((1..=4).fold(0, (sum, n) => sum + n));
//! println(["a", "b", "c"].iter().join("-"));
//! ```
//!
//! ```output
//! 5
//! 10
//! a-b-c
//! ```
import std.core { DoubleEnded, Join, StringBuilder };

/// Yields the values of an iterator, each passed through `f`; made by `it.map(f)`.
///
/// Lazy: each pull takes one value from the inner iterator and calls `f` on it. A pull throws
/// what the inner iterator throws and what `f` throws.
pub struct MapIter<I :: [Iterator], U, E :: [Error] = never> :: [Iterator] {
    type Item = U;
    type Error = Join<I.Error, E>;
    var inner: I,
    f: fn(I.Item) -> U throws E,

    pub mut fn next(): ?U throws Join<I.Error, E> {
        let x = try this.inner.next();
        if (x == null) {
            return null;
        }
        return try this.f(x);
    }
}

/// Yields the values of an iterator for which `p` holds; made by `it.filter(p)`.
pub struct FilterIter<I :: [Iterator], E :: [Error] = never> :: [Iterator] {
    type Item = I.Item;
    type Error = Join<I.Error, E>;
    var inner: I,
    p: fn(I.Item) -> bool throws E,

    pub mut fn next(): ?I.Item throws Join<I.Error, E> {
        var x = try this.inner.next();
        while (x != null && !(try this.p(x))) {
            x = try this.inner.next();
        }
        return x;
    }
}

/// Yields the first `n` values of an iterator, or all of them where it has fewer; made by
/// `it.take(n)`.
pub struct TakeIter<I :: [Iterator]> :: [Iterator] {
    type Item = I.Item;
    type Error = I.Error;
    var inner: I,
    var left: int,

    pub mut fn next(): ?I.Item throws I.Error {
        if (this.left <= 0) {
            return null;
        }
        this.left = this.left - 1;
        return try this.inner.next();
    }
}

/// Yields the values of an iterator after its first `n`; made by `it.skip(n)`.
///
/// The skipped values are pulled at the first pull.
pub struct SkipIter<I :: [Iterator]> :: [Iterator] {
    type Item = I.Item;
    type Error = I.Error;
    var inner: I,
    var n: int,

    pub mut fn next(): ?I.Item throws I.Error {
        while (this.n > 0) {
            this.n = this.n - 1;
            if (try this.inner.next() == null) {
                return null;
            }
        }
        return try this.inner.next();
    }
}

/// Yields the values of an iterator up to, not including, the first for which `p` does not hold;
/// made by `it.takeWhile(p)`.
///
/// After that value it yields nothing more.
pub struct TakeWhileIter<I :: [Iterator], E :: [Error] = never> :: [Iterator] {
    type Item = I.Item;
    type Error = Join<I.Error, E>;
    var inner: I,
    p: fn(I.Item) -> bool throws E,
    var done: bool,

    pub mut fn next(): ?I.Item throws Join<I.Error, E> {
        if (this.done) {
            return null;
        }
        let x = try this.inner.next();
        if (x == null) {
            this.done = true;
            return null;
        }
        if (!(try this.p(x))) {
            this.done = true;
            return null;
        }
        return x;
    }
}

/// Yields the values of an iterator from the first for which `p` does not hold on; made by
/// `it.skipWhile(p)`.
///
/// `p` is not called again after that value.
pub struct SkipWhileIter<I :: [Iterator], E :: [Error] = never> :: [Iterator] {
    type Item = I.Item;
    type Error = Join<I.Error, E>;
    var inner: I,
    p: fn(I.Item) -> bool throws E,
    var started: bool,

    pub mut fn next(): ?I.Item throws Join<I.Error, E> {
        if (this.started) {
            return try this.inner.next();
        }
        this.started = true;
        var x = try this.inner.next();
        while (x != null && (try this.p(x))) {
            x = try this.inner.next();
        }
        return x;
    }
}

/// Yields the first value of an iterator, then every `n`th after it; made by `it.stepBy(n)`.
pub struct StepByIter<I :: [Iterator]> :: [Iterator] {
    type Item = I.Item;
    type Error = I.Error;
    var inner: I,
    step: int,
    var first: bool,

    pub mut fn next(): ?I.Item throws I.Error {
        if (this.first) {
            this.first = false;
            return try this.inner.next();
        }
        var gap = this.step - 1;
        while (gap > 0) {
            gap = gap - 1;
            if (try this.inner.next() == null) {
                return null;
            }
        }
        return try this.inner.next();
    }
}

/// Yields each value of an iterator paired with its position, counted from 0; made by
/// `it.enumerate()`.
pub struct EnumerateIter<I :: [Iterator]> :: [Iterator] {
    type Item = (int, I.Item);
    type Error = I.Error;
    var inner: I,
    var i: int,

    pub mut fn next(): ?(int, I.Item) throws I.Error {
        let x = try this.inner.next();
        if (x == null) {
            return null;
        }
        this.i = this.i + 1;
        return (this.i - 1, x);
    }
}

/// Yields the values of an iterator unchanged, calling `f` on each as it passes; made by
/// `it.inspect(f)`.
pub struct InspectIter<I :: [Iterator], E :: [Error] = never> :: [Iterator] {
    type Item = I.Item;
    type Error = Join<I.Error, E>;
    var inner: I,
    f: fn(I.Item) -> void throws E,

    pub mut fn next(): ?I.Item throws Join<I.Error, E> {
        let x = try this.inner.next();
        if (x != null) {
            try this.f(x);
        }
        return x;
    }
}

/// Yields pairs of the values two iterators hold at the same position; made by `it.zip(other)`.
///
/// It ends when either iterator ends; the first is pulled before the second.
pub struct ZipIter<A :: [Iterator], B :: [Iterator]> :: [Iterator] {
    type Item = (A.Item, B.Item);
    type Error = Join<A.Error, B.Error>;
    var a: A,
    var b: B,

    pub mut fn next(): ?(A.Item, B.Item) throws Join<A.Error, B.Error> {
        let x = try this.a.next();
        if (x == null) {
            return null;
        }
        let y = try this.b.next();
        if (y == null) {
            return null;
        }
        return (x, y);
    }
}

/// Yields the values of one iterator, then those of another; made by `it.chain(other)`.
pub struct ChainIter<A :: [Iterator], B :: [Iterator<Item = A.Item>]> :: [Iterator] {
    type Item = A.Item;
    type Error = Join<A.Error, B.Error>;
    var a: A,
    var b: B,
    var second: bool,

    pub mut fn next(): ?A.Item throws Join<A.Error, B.Error> {
        if (!this.second) {
            let x = try this.a.next();
            if (x != null) {
                return x;
            }
            this.second = true;
        }
        return try this.b.next();
    }
}

/// Yields the results of `f` on the values of an iterator, leaving out every `null`; made by
/// `it.mapNotNull(f)`.
pub struct MapNotNullIter<I :: [Iterator], U, E :: [Error] = never> :: [Iterator] {
    type Item = U;
    type Error = Join<I.Error, E>;
    var inner: I,
    f: fn(I.Item) -> ?U throws E,

    pub mut fn next(): ?U throws Join<I.Error, E> {
        loop {
            let x = try this.inner.next();
            if (x == null) {
                return null;
            }
            let y = try this.f(x);
            if (y != null) {
                return y;
            }
        }
    }
}

/// Yields the values of what `f` returns for each value of an iterator, one after the other; made
/// by `it.flatMap(f)`.
///
/// `f` may return any `Iterable` — an array or a list as well as an iterator.
pub struct FlatMapIter<I :: [Iterator], B :: [Iterable<Iter = J>], J :: [Iterator], E :: [Error] = never> :: [
    Iterator
] {
    type Item = J.Item;
    type Error = Join<Join<I.Error, E>, J.Error>;
    var inner: I,
    f: fn(I.Item) -> B throws E,
    var current: ?J,

    pub mut fn next(): ?J.Item throws Join<Join<I.Error, E>, J.Error> {
        loop {
            if (this.current != null) {
                var part = this.current!;
                let x = try part.next();
                this.current = part;
                if (x != null) {
                    return x;
                }
                this.current = null;
            }
            let outer = try this.inner.next();
            if (outer == null) {
                return null;
            }
            this.current = (try this.f(outer)).iter();
        }
    }
}

/// Yields the values of the iterables an iterator gives, one after the other; made by
/// `it.flatten()`.
pub struct FlattenIter<I :: [Iterator<Item = B>], B :: [Iterable<Iter = J>], J :: [Iterator]> :: [
    Iterator
] {
    type Item = J.Item;
    type Error = Join<I.Error, J.Error>;
    var inner: I,
    var current: ?J,

    pub mut fn next(): ?J.Item throws Join<I.Error, J.Error> {
        loop {
            if (this.current != null) {
                var part = this.current!;
                let x = try part.next();
                this.current = part;
                if (x != null) {
                    return x;
                }
                this.current = null;
            }
            let outer = try this.inner.next();
            if (outer == null) {
                return null;
            }
            this.current = outer.iter();
        }
    }
}

/// Yields the values of an iterator with each run of consecutive values for which `same` holds
/// given once; made by `it.dedupBy(same)` and `it.dedup()`.
///
/// Each value is compared with the last one yielded; the first of a run is the one kept.
pub struct DedupIter<I :: [Iterator], E :: [Error] = never> :: [Iterator] {
    type Item = I.Item;
    type Error = Join<I.Error, E>;
    var inner: I,
    same: fn(I.Item, I.Item) -> bool throws E,
    var last: ?I.Item,

    pub mut fn next(): ?I.Item throws Join<I.Error, E> {
        loop {
            let x = try this.inner.next();
            if (x == null) {
                return null;
            }
            if (let previous = this.last) {
                if (try this.same(previous, x)) {
                    continue;
                }
            }
            this.last = x;
            return x;
        }
    }
}

/// Yields `init`, then each value `f` makes of the previous one and the next value of an iterator;
/// made by `it.scan(init, f)`.
///
/// These are the running values of `fold`: for n values it yields n + 1.
pub struct ScanIter<I :: [Iterator], A, E :: [Error] = never> :: [Iterator] {
    type Item = A;
    type Error = Join<I.Error, E>;
    var inner: I,
    f: fn(A, I.Item) -> A throws E,
    var acc: A,
    var started: bool,

    pub mut fn next(): ?A throws Join<I.Error, E> {
        if (!this.started) {
            this.started = true;
            return this.acc;
        }
        let x = try this.inner.next();
        if (x == null) {
            return null;
        }
        this.acc = try this.f(this.acc, x);
        return this.acc;
    }
}

/// Yields the values of an iterator and lets [PeekableIter.peek] look at the next one without
/// taking it; made by `it.peekable()`.
pub struct PeekableIter<I :: [Iterator]> :: [Iterator] {
    type Item = I.Item;
    type Error = I.Error;
    var inner: I,
    var peeked: ?I.Item,
    var hasPeeked: bool,

    /// Returns the value the next `next()` will return, or `null` at the end, without taking it.
    ///
    /// The value is pulled from the inner iterator once; further calls return it again.
    pub mut fn peek(): ?I.Item throws I.Error {
        if (!this.hasPeeked) {
            this.peeked = try this.inner.next();
            this.hasPeeked = true;
        }
        return this.peeked;
    }

    pub mut fn next(): ?I.Item throws I.Error {
        if (this.hasPeeked) {
            this.hasPeeked = false;
            return this.peeked;
        }
        return try this.inner.next();
    }
}

/// Yields the values of a `DoubleEnded` iterator from its back; made by `it.rev()`.
///
/// A pull never throws. The reversed iterator is not `DoubleEnded` itself.
pub struct RevIter<I :: [DoubleEnded]> :: [Iterator] {
    type Item = I.Item;
    type Error = never;
    var inner: I,

    pub mut fn next(): ?I.Item {
        return this.inner.nextBack();
    }
}

/// Yields the values of an iterator over and over; made by `it.cycle()`.
///
/// Each round walks a fresh clone of the original iterator. An empty iterator yields nothing.
pub struct CycleIter<I :: [Iterator, Clone]> :: [Iterator] {
    type Item = I.Item;
    type Error = I.Error;
    origin: I,
    var current: I,

    pub mut fn next(): ?I.Item throws I.Error {
        let x = try this.current.next();
        if (x != null) {
            return x;
        }
        this.current = this.origin.clone();
        return try this.current.next();
    }
}

// Closing through an adapter: an adapter over a Closeable iterator is
// Closeable itself and passes `close()` on, so a loop that leaves early closes the generator
// behind `gen().map(f)`. Its `close()` throws what the inner one's may — the inner's Error, which
// is the adapter's own —, as the rule at the declaration asks of every Closeable iterator
// (LYR-SEM0174). The two over two iterators close both; where both throw, the first error wins
// and the second is suppressed into it.

extend<I :: [Iterator, Closeable], U, E :: [Error]> MapIter<I, U, E> :: [Closeable] {
    fn close(): void throws I.Error {
        try this.inner.close();
    }
}

extend<I :: [Iterator, Closeable], E :: [Error]> FilterIter<I, E> :: [Closeable] {
    fn close(): void throws I.Error {
        try this.inner.close();
    }
}

extend<I :: [Iterator, Closeable]> TakeIter<I> :: [Closeable] {
    fn close(): void throws I.Error {
        try this.inner.close();
    }
}

extend<I :: [Iterator, Closeable]> SkipIter<I> :: [Closeable] {
    fn close(): void throws I.Error {
        try this.inner.close();
    }
}

extend<I :: [Iterator, Closeable], E :: [Error]> TakeWhileIter<I, E> :: [Closeable] {
    fn close(): void throws I.Error {
        try this.inner.close();
    }
}

extend<I :: [Iterator, Closeable], E :: [Error]> SkipWhileIter<I, E> :: [Closeable] {
    fn close(): void throws I.Error {
        try this.inner.close();
    }
}

extend<I :: [Iterator, Closeable]> StepByIter<I> :: [Closeable] {
    fn close(): void throws I.Error {
        try this.inner.close();
    }
}

extend<I :: [Iterator, Closeable]> EnumerateIter<I> :: [Closeable] {
    fn close(): void throws I.Error {
        try this.inner.close();
    }
}

extend<I :: [Iterator, Closeable], E :: [Error]> InspectIter<I, E> :: [Closeable] {
    fn close(): void throws I.Error {
        try this.inner.close();
    }
}

extend<I :: [Iterator, Closeable], U, E :: [Error]> MapNotNullIter<I, U, E> :: [Closeable] {
    fn close(): void throws I.Error {
        try this.inner.close();
    }
}

extend<I :: [Iterator, Closeable], E :: [Error]> DedupIter<I, E> :: [Closeable] {
    fn close(): void throws I.Error {
        try this.inner.close();
    }
}

extend<I :: [Iterator, Closeable], A, E :: [Error]> ScanIter<I, A, E> :: [Closeable] {
    fn close(): void throws I.Error {
        try this.inner.close();
    }
}

extend<I :: [Iterator, Closeable]> PeekableIter<I> :: [Closeable] {
    fn close(): void throws I.Error {
        try this.inner.close();
    }
}

// The outer iterator closed; a part `f` or the source gave is the walk's own, closed by none.
extend<I :: [Iterator, Closeable], B :: [Iterable<Iter = J>], J :: [Iterator], E :: [Error]> FlatMapIter<I, B, J, E> :: [
    Closeable
] {
    fn close(): void throws I.Error {
        try this.inner.close();
    }
}

extend<I :: [Iterator<Item = B>, Closeable], B :: [Iterable<Iter = J>], J :: [Iterator]> FlattenIter<I, B, J> :: [
    Closeable
] {
    fn close(): void throws I.Error {
        try this.inner.close();
    }
}

extend<A :: [Iterator, Closeable], B :: [Iterator, Closeable]> ZipIter<A, B> :: [Closeable] {
    fn close(): void throws Join<A.Error, B.Error> {
        defer try this.b.close();
        try this.a.close();
    }
}

extend<A :: [Iterator, Closeable], B :: [Iterator<Item = A.Item>, Closeable]> ChainIter<A, B> :: [
    Closeable
] {
    fn close(): void throws Join<A.Error, B.Error> {
        defer try this.b.close();
        try this.a.close();
    }
}

// The adapters: members of every iterator, each a struct of its own — monomorphized, no
// allocation, no interface value.
extend<I :: [Iterator]> I {
    /// Returns an iterator over the values, each passed through `f`.
    ///
    /// Lazy: `f` runs as values are pulled. See [MapIter].
    pub fn map<U, E :: [Error]>(f: fn(I.Item) -> U throws E): MapIter<I, U, E> {
        return MapIter<I, U, E> { inner = this, f = f };
    }

    /// Returns an iterator over the values for which `p` holds.
    pub fn filter<E :: [Error]>(p: fn(I.Item) -> bool throws E): FilterIter<I, E> {
        return FilterIter<I, E> { inner = this, p = p };
    }

    /// Returns an iterator over the first `n` values, or all of them where there are fewer.
    ///
    /// A zero or negative `n` gives an empty iterator.
    pub fn take(n: int): TakeIter<I> {
        return TakeIter<I> { inner = this, left = n };
    }

    /// Returns an iterator over the values after the first `n`.
    ///
    /// A zero or negative `n` skips nothing.
    pub fn skip(n: int): SkipIter<I> {
        return SkipIter<I> { inner = this, n = n };
    }

    /// Returns an iterator over the values up to, not including, the first for which `p` does not
    /// hold.
    pub fn takeWhile<E :: [Error]>(p: fn(I.Item) -> bool throws E): TakeWhileIter<I, E> {
        return TakeWhileIter<I, E> { inner = this, p = p, done = false };
    }

    /// Returns an iterator over the values from the first for which `p` does not hold on.
    pub fn skipWhile<E :: [Error]>(p: fn(I.Item) -> bool throws E): SkipWhileIter<I, E> {
        return SkipWhileIter<I, E> { inner = this, p = p, started = false };
    }

    /// Returns an iterator over the first value, then every `n`th after it.
    ///
    /// # Panics
    ///
    /// When `n` is less than 1.
    pub fn stepBy(n: int): StepByIter<I> {
        if (n < 1) {
            panic("stepBy needs a step of at least 1");
        }
        return StepByIter<I> { inner = this, step = n, first = true };
    }

    /// Returns an iterator over `(position, value)` pairs, positions counted from 0.
    pub fn enumerate(): EnumerateIter<I> {
        return EnumerateIter<I> { inner = this, i = 0 };
    }

    /// Returns an iterator over the values unchanged, calling `f` on each as it is pulled.
    pub fn inspect<E :: [Error]>(f: fn(I.Item) -> void throws E): InspectIter<I, E> {
        return InspectIter<I, E> { inner = this, f = f };
    }

    /// Returns an iterator over pairs of this iterator's values and `other`'s at the same position.
    ///
    /// `other` is any `Iterable`. The pairs end where either side ends.
    pub fn zip<B :: [Iterable]>(other: B): ZipIter<I, B.Iter> {
        return ZipIter<I, B.Iter> { a = this, b = other.iter() };
    }

    /// Returns an iterator over the values, then those of `other`, an iterator of the same item type.
    pub fn chain<B :: [Iterator<Item = I.Item>]>(other: B): ChainIter<I, B> {
        return ChainIter<I, B> { a = this, b = other, second = false };
    }

    /// Returns an iterator over the results of `f` on the values, leaving out every `null`.
    pub fn mapNotNull<U, E :: [Error]>(f: fn(I.Item) -> ?U throws E): MapNotNullIter<I, U, E> {
        return MapNotNullIter<I, U, E> { inner = this, f = f };
    }

    /// Returns an iterator over the values of the iterables `f` returns for each value, one after
    /// the other.
    pub fn flatMap<B :: [Iterable], E :: [Error]>(
        f: fn(I.Item) -> B throws E
    ): FlatMapIter<I, B, B.Iter, E> {
        return FlatMapIter<I, B, B.Iter, E> { inner = this, f = f, current = null };
    }

    /// Returns an iterator that gives each run of consecutive values for which `same` holds once.
    ///
    /// The first value of a run is kept.
    pub fn dedupBy<E :: [Error]>(same: fn(I.Item, I.Item) -> bool throws E): DedupIter<I, E> {
        return DedupIter<I, E> { inner = this, same = same, last = null };
    }

    /// Returns an iterator over `init`, then each running value `f` makes of the previous one and
    /// the next value.
    pub fn scan<A, E :: [Error]>(init: A, f: fn(A, I.Item) -> A throws E): ScanIter<I, A, E> {
        return ScanIter<I, A, E> { inner = this, f = f, acc = init, started = false };
    }

    /// Returns an iterator over the values that can [PeekableIter.peek] at the next one.
    pub fn peekable(): PeekableIter<I> {
        return PeekableIter<I> { inner = this, peeked = null, hasPeeked = false };
    }

    /// Returns how many values there are, walking them all.
    ///
    /// # Errors
    ///
    /// Throws what a pull of the iterator throws.
    pub fn count(): int throws I.Error {
        var it = this;
        var n = 0;
        while (try it.next() != null) {
            n = n + 1;
        }
        return n;
    }

    /// Combines the values from `init` with `f` and returns the last result.
    ///
    /// Returns `init` where there are no values.
    ///
    /// # Errors
    ///
    /// Throws what a pull of the iterator or `f` throws.
    pub fn fold<A, E :: [Error]>(
        init: A,
        f: fn(A, I.Item) -> A throws E
    ): A throws Join<I.Error, E> {
        var it = this;
        var acc = init;
        var x = try it.next();
        while (x != null) {
            acc = try f(acc, x);
            x = try it.next();
        }
        return acc;
    }

    /// Combines the values with `f`, starting from the first, and returns the last result.
    ///
    /// Returns `null` where there are no values, and the only value where there is one.
    ///
    /// # Errors
    ///
    /// Throws what a pull of the iterator or `f` throws.
    pub fn reduce<E :: [Error]>(
        f: fn(I.Item, I.Item) -> I.Item throws E
    ): ?I.Item throws Join<I.Error, E> {
        var it = this;
        let first = try it.next();
        if (first == null) {
            return null;
        }
        var acc = first;
        var x = try it.next();
        while (x != null) {
            acc = try f(acc, x);
            x = try it.next();
        }
        return acc;
    }

    /// Returns the first value, or `null` where there is none.
    ///
    /// # Errors
    ///
    /// Throws what a pull of the iterator throws.
    pub fn first(): ?I.Item throws I.Error {
        var it = this;
        return try it.next();
    }

    /// Returns the last value, or `null` where there is none, walking them all.
    ///
    /// # Errors
    ///
    /// Throws what a pull of the iterator throws.
    pub fn last(): ?I.Item throws I.Error {
        var it = this;
        var last = try it.next();
        if (last == null) {
            return null;
        }
        var x = try it.next();
        while (x != null) {
            last = x;
            x = try it.next();
        }
        return last;
    }

    /// Returns the value at position `n`, counted from 0, or `null` where there is none.
    ///
    /// A negative `n` returns `null` without pulling.
    ///
    /// # Errors
    ///
    /// Throws what a pull of the iterator throws.
    pub fn nth(n: int): ?I.Item throws I.Error {
        if (n < 0) {
            return null;
        }
        var it = this;
        var left = n;
        while (left > 0) {
            if (try it.next() == null) {
                return null;
            }
            left = left - 1;
        }
        return try it.next();
    }

    /// Returns whether `p` holds for some value.
    ///
    /// Stops at the first value it holds for; `false` where there are none.
    ///
    /// # Errors
    ///
    /// Throws what a pull of the iterator or `p` throws.
    pub fn any<E :: [Error]>(p: fn(I.Item) -> bool throws E): bool throws Join<I.Error, E> {
        return try this.find(p) != null;
    }

    /// Returns whether `p` holds for every value.
    ///
    /// Stops at the first value it does not hold for; `true` where there are none.
    ///
    /// # Errors
    ///
    /// Throws what a pull of the iterator or `p` throws.
    pub fn all<E :: [Error]>(p: fn(I.Item) -> bool throws E): bool throws Join<I.Error, E> {
        return try this.find((v) => !(try p(v))) == null;
    }

    /// Returns whether `p` holds for no value.
    ///
    /// Stops at the first value it holds for; `true` where there are none.
    ///
    /// # Errors
    ///
    /// Throws what a pull of the iterator or `p` throws.
    pub fn none<E :: [Error]>(p: fn(I.Item) -> bool throws E): bool throws Join<I.Error, E> {
        return try this.find(p) == null;
    }

    /// Returns the first value for which `p` holds, or `null` where there is none.
    ///
    /// # Errors
    ///
    /// Throws what a pull of the iterator or `p` throws.
    pub fn find<E :: [Error]>(p: fn(I.Item) -> bool throws E): ?I.Item throws Join<I.Error, E> {
        var it = this;
        var x = try it.next();
        while (x != null && !(try p(x))) {
            x = try it.next();
        }
        return x;
    }

    /// Returns the position, counted from 0, of the first value for which `p` holds, or `null`
    /// where there is none.
    ///
    /// # Errors
    ///
    /// Throws what a pull of the iterator or `p` throws.
    pub fn position<E :: [Error]>(p: fn(I.Item) -> bool throws E): ?int throws Join<I.Error, E> {
        var it = this;
        var i = 0;
        var x = try it.next();
        while (x != null) {
            if (try p(x)) {
                return i;
            }
            i = i + 1;
            x = try it.next();
        }
        return null;
    }

    /// Returns the value whose `key` is least, or `null` where there is none.
    ///
    /// Of values with equal keys, the first wins. `key` is called once per value.
    ///
    /// # Errors
    ///
    /// Throws what a pull of the iterator or `key` throws.
    pub fn minBy<K :: [TotalOrder], E :: [Error]>(
        key: fn(I.Item) -> K throws E
    ): ?I.Item throws Join<I.Error, E> {
        var it = this;
        let first = try it.next();
        if (first == null) {
            return null;
        }
        var best = first;
        var bestKey = try key(first);
        var x = try it.next();
        while (x != null) {
            let k = try key(x);
            if (k < bestKey) {
                best = x;
                bestKey = k;
            }
            x = try it.next();
        }
        return best;
    }

    /// Returns the value whose `key` is greatest, or `null` where there is none.
    ///
    /// Of values with equal keys, the first wins. `key` is called once per value.
    ///
    /// # Errors
    ///
    /// Throws what a pull of the iterator or `key` throws.
    pub fn maxBy<K :: [TotalOrder], E :: [Error]>(
        key: fn(I.Item) -> K throws E
    ): ?I.Item throws Join<I.Error, E> {
        var it = this;
        let first = try it.next();
        if (first == null) {
            return null;
        }
        var best = first;
        var bestKey = try key(first);
        var x = try it.next();
        while (x != null) {
            let k = try key(x);
            if (k > bestKey) {
                best = x;
                bestKey = k;
            }
            x = try it.next();
        }
        return best;
    }

    /// Calls `f` on every value, in order.
    ///
    /// The function is inline: a lambda written at the call is set in place, so a `return` in it
    /// leaves the enclosing function, and `break` and `continue` reach the enclosing loops.
    ///
    /// # Errors
    ///
    /// Throws what a pull of the iterator or `f` throws.
    pub inline fn forEach<E :: [Error]>(
        f: fn(I.Item) -> void throws E
    ): void throws Join<I.Error, E> {
        var it = this;
        var x = try it.next();
        while (x != null) {
            try f(x);
            x = try it.next();
        }
    }

    /// Returns the values in a new array, in order.
    ///
    /// Collects in one pass through the array's `FromIterator`.
    ///
    /// # Errors
    ///
    /// Throws what a pull of the iterator throws.
    pub fn toArray(): I.Item[] throws I.Error {
        let out: I.Item[] = try this.collect();
        return out;
    }
}

// The terminators of an element kind: blocks whose `T` the iterator's `Item` binds, reaching the
// iterators of numbers, of ordered values, of shown ones.
// The terminators and adapters of a kind of iterator: a flat walk over iterables, runs
// of equal values, the walk from the back, the walk over and over, the mean.

extend<I :: [Iterator<Item = B>], B :: [Iterable]> I {
    /// Returns an iterator over the values of the iterables this iterator gives, one after the
    /// other.
    pub fn flatten(): FlattenIter<I, B, B.Iter> {
        return FlattenIter<I, B, B.Iter> { inner = this, current = null };
    }
}

extend<I :: [Iterator<Item = T>], T :: [Equatable]> I {
    /// Returns an iterator that gives each run of consecutive equal values once.
    pub fn dedup(): DedupIter<I, never> {
        // the comparison throws nothing: its error set is empty
        return DedupIter<I, never> { inner = this, same = (a: T, b: T) => a == b, last = null };
    }
}

extend<I :: [DoubleEnded]> I {
    /// Returns an iterator over the values from the back.
    pub fn rev(): RevIter<I> {
        return RevIter<I> { inner = this };
    }
}

extend<I :: [Iterator, Clone]> I {
    /// Returns an iterator over the values, repeated without end.
    ///
    /// Each round starts from a clone of this iterator as it was; an empty iterator yields nothing.
    pub fn cycle(): CycleIter<I> {
        return CycleIter<I> { origin = this.clone(), current = this };
    }
}

extend<I :: [Iterator<Item = int>]> I {
    /// Returns the arithmetic mean of the values, or `null` where there are none.
    ///
    /// The values are summed as `float`, so the sum does not overflow.
    ///
    /// # Errors
    ///
    /// Throws what a pull of the iterator throws.
    pub fn average(): ?float throws I.Error {
        var it = this;
        var total = 0.0;
        var n = 0;
        var x = try it.next();
        while (x != null) {
            total = total + (x as float);
            n = n + 1;
            x = try it.next();
        }
        if (n == 0) {
            return null;
        }
        return total / (n as float);
    }
}

extend<I :: [Iterator<Item = float>]> I {
    /// Returns the arithmetic mean of the values, or `null` where there are none.
    ///
    /// # Errors
    ///
    /// Throws what a pull of the iterator throws.
    pub fn average(): ?float throws I.Error {
        var it = this;
        var total = 0.0;
        var n = 0;
        var x = try it.next();
        while (x != null) {
            total = total + x;
            n = n + 1;
            x = try it.next();
        }
        if (n == 0) {
            return null;
        }
        return total / (n as float);
    }
}

// A value iterator is a clone of itself: a copy walks on its own (cycle).
extend<I :: [Iterator<Item = T>], T :: [Num]> I {
    /// Returns the sum of the values; zero where there are none.
    ///
    /// # Errors
    ///
    /// Throws what a pull of the iterator throws.
    pub fn sum(): T throws I.Error {
        var it = this;
        var s = T.zero;
        var x = try it.next();
        while (x != null) {
            s = s + x;
            x = try it.next();
        }
        return s;
    }

    /// Returns the product of the values; one where there are none.
    ///
    /// # Errors
    ///
    /// Throws what a pull of the iterator throws.
    pub fn product(): T throws I.Error {
        var it = this;
        var p = T.one;
        var x = try it.next();
        while (x != null) {
            p = p * x;
            x = try it.next();
        }
        return p;
    }
}

extend<I :: [Iterator<Item = T>], T :: [Ordered]> I {
    /// Returns the least value, or `null` where there is none.
    ///
    /// Of equal values, the first wins.
    ///
    /// # Errors
    ///
    /// Throws what a pull of the iterator throws.
    pub fn min(): ?T throws I.Error {
        var it = this;
        let first = try it.next();
        if (first == null) {
            return null;
        }
        var least = first;
        var x = try it.next();
        while (x != null) {
            if (x < least) {
                least = x;
            }
            x = try it.next();
        }
        return least;
    }

    /// Returns the greatest value, or `null` where there is none.
    ///
    /// Of equal values, the first wins.
    ///
    /// # Errors
    ///
    /// Throws what a pull of the iterator throws.
    pub fn max(): ?T throws I.Error {
        var it = this;
        let first = try it.next();
        if (first == null) {
            return null;
        }
        var most = first;
        var x = try it.next();
        while (x != null) {
            if (x > most) {
                most = x;
            }
            x = try it.next();
        }
        return most;
    }
}

extend<I :: [Iterator<Item = T>], T :: [Display]> I {
    /// Returns the display texts of the values joined into one string, with `sep` between each two.
    ///
    /// Returns the empty string where there are no values.
    ///
    /// # Errors
    ///
    /// Throws what a pull of the iterator throws.
    pub fn join(sep: string): string throws I.Error {
        var it = this;
        let out = StringBuilder.new();
        var x = try it.next();
        var first = true;
        while (x != null) {
            if (!first) {
                out.append(sep);
            }
            first = false;
            out.append(x);
            x = try it.next();
        }
        return out.toString();
    }
}

extend<I :: [Iterator]> I {
    /// Collects the values into a new value of the expected type, built through its `FromIterator`.
    ///
    /// The target type comes from the context: `let names: Set<string> = words.iter().collect();`.
    ///
    /// # Errors
    ///
    /// Throws what a pull of the iterator throws.
    pub fn collect<C :: [FromIterator<I.Item>]>(): C throws I.Error {
        return try C.fromIter(this);
    }
}

// --- membership ---------------------------------------------------------------------------------
// `x in xs` is `xs.contains(x)`: a range holds what lies between its bounds.
