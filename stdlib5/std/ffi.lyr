//! Provides the types that cross into a C function and back.
//!
//! A C function is declared with `extern "C"` and called as any other: its integers, floats and
//! `bool` cross as they are, a `@Layout(C)` struct crosses by value, and the types here stand for
//! what C holds by address. [Ptr] is a pointer to memory C manages, `?Ptr` one that may be null;
//! [CStr] is C's text, `const char *`. A `string` handed to a `CStr` parameter crosses without a
//! copy, its bytes as they lie, for the time of the call.
//!
//! Reading and writing through a pointer, moving it and changing what it points at, and C's own
//! memory — [alloc] and [free] — stand in an `unsafe { … }` block: there the program says it
//! holds to what the compiler cannot see, that the memory is there and of the type. Calling a C
//! function is not unsafe, and neither is [Ptr] of an array or a slice's elements.
//!
//! # Examples
//!
//! ```lyric
//! import std.ffi { CStr };
//! import std.io { println };
//!
//! extern "C" fn strlen(s: CStr): uint;
//!
//! fn main(): void {
//!     println(strlen("hello"));
//! }
//! ```
//!
//! ```output
//! 5
//! ```
import std.core { Utf8Error };
import std.task { stashForeign, takeForeign };

/// A pointer to a `T` in memory C manages, never null: `T *` where a C function takes or returns
/// one.
///
/// A value of it comes from C, from [alloc] or from an array's `asPtr()`, and goes back to C. A
/// pointer C may return as null is a `?Ptr<T>`, `none` for null. What it points at is read and
/// written in an `unsafe` block, and only where `T` is what C holds — integers, floats, `bool`,
/// `char`, a pointer, a `@Layout(C)` struct.
pub struct Ptr<T> {
    address: uint,

    /// Returns the `T` it points at. Unsafe: the memory is the program's word.
    pub fn read(): T {
        return load<T>(this.address);
    }

    /// Writes `value` where it points. Unsafe: the memory is the program's word.
    pub fn write(value: T): void {
        store<T>(this.address, value);
    }

    /// Returns the pointer `n` values of `T` further on, or back for a negative `n`. Unsafe:
    /// nothing says the memory goes on.
    pub fn offset(n: int): Ptr<T> {
        return Ptr<T> { address = ((this.address as int) + n * (sizeOf<T>() as int)) as uint };
    }

    /// Returns the same address as a pointer to a `U`. Unsafe: nothing says a `U` lies there.
    pub fn cast<U>(): Ptr<U> {
        return Ptr<U> { address = this.address };
    }
}

/// A Lyric closure C calls, with its state: C's `void *userdata` beside a function pointer.
///
/// `C` is the C function's type as C calls it, `extern "C" fn(…) -> T`; its first or its last
/// parameter is the `Ptr<void>` that C hands back, and the closure takes the others —
/// `Callback<extern "C" fn(Ptr<void>, int) -> void>.new((event) => { seen += event; })`, handed
/// to C as `on_event(cb.function, cb.userdata)`.
///
/// The closure stays alive until [Callback.release] — C may call it as long — and C calls it on
/// the thread Lyric runs on, as any function C calls.
pub class Callback<C> {
    /// The pointer C calls: it finds the closure through [Callback.userdata].
    pub function: C,
    /// What C hands back to [Callback.function]: the closure's handle.
    pub userdata: Ptr<void>,
    root: uint,
    var released: bool = false,

    /// Returns the callback for the closure it is given, a function of the parameters of `C` but
    /// its userdata. The compiler writes the function C calls; this body never runs.
    pub static fn new(_closure: C): Callback<C> {
        unreachable("std.ffi's Callback.new is the compiler's");
    }

    /// Lets the closure go: after it C must not call [Callback.function] again.
    ///
    /// # Panics
    /// Where the callback was released already.
    pub mut fn release(): void {
        if (this.released) {
            panic("a Callback released twice: C may still hold it, and the closure is gone");
        }
        this.released = true;
        lyr_ffi_closure_release(this.root);
    }
}

/// Keeps `e` for the code around the C call that called this function: a function C calls
/// throws nothing, since C would not know what to do with it, and this is how its error crosses.
/// The code that called C takes it with [takeStashed] when C returns.
///
/// One error waits at a time, the running task's: a second, before the first is taken, is
/// dropped — the first went wrong first.
pub fn stash(e: Error): void {
    stashForeign(e);
}

/// Returns the error a function C called kept with [stash], and forgets it; `null` where none
/// waits.
pub fn takeStashed(): ?Error {
    return takeForeign();
}

/// Returns `count` values of `T` from C's heap, each set to zero — what C's `calloc` gives, to
/// be given back with [free]. Unsafe: nothing frees it but the program.
///
/// # Panics
/// Where `count` is negative, and where C's heap has no memory left.
pub fn alloc<T>(count: int): Ptr<T> {
    return Ptr<T> { address = lyr_ffi_alloc(count, sizeOf<T>()) };
}

/// Gives the memory [alloc] gave back to C's heap. Unsafe: nothing reads it afterwards but the
/// program's word says so.
pub fn free<T>(p: Ptr<T>): void {
    lyr_ffi_free(p.address);
}

extend<T> T[] {
    /// Returns a pointer to the first element: the elements lie one after the other, as C's
    /// array does. It holds the array no longer than the array is otherwise held, and it is no
    /// pointer to anything where the array is empty.
    pub fn asPtr(): Ptr<T> {
        return Ptr<T> { address = dataAddress(this) };
    }
}

extend<T> Slice<T> {
    /// Returns a pointer to the slice's first element, in the memory of its array. It holds the
    /// array no longer than the array is otherwise held, and it is no pointer to anything where
    /// the slice is empty.
    pub fn asPtr(): Ptr<T> {
        return Ptr<T> { address = sliceAddress(this) };
    }
}

// The compiler's own, beneath Ptr: their bodies never run, and say nothing of what they take.
@Allow("unused")
fn load<T>(address: uint): T {
    unreachable("std.ffi's load is the compiler's");
}

@Allow("unused")
fn store<T>(address: uint, value: T): void {
    unreachable("std.ffi's store is the compiler's");
}

@Allow("unused")
fn sizeOf<T>(): uint {
    unreachable("std.ffi's sizeOf is the compiler's");
}

@Allow("unused")
fn dataAddress<T>(xs: T[]): uint {
    unreachable("std.ffi's dataAddress is the compiler's");
}

@Allow("unused")
fn sliceAddress<T>(xs: Slice<T>): uint {
    unreachable("std.ffi's sliceAddress is the compiler's");
}

/// A C string: the address of bytes a NUL ends, `const char *` at a C function's boundary.
///
/// It is borrowed: the bytes are C's, and they are valid as long as C says. [CStr.toString]
/// copies them into a `string`. A C function that may return null returns a `?CStr`.
pub struct CStr {
    address: uint,

    /// Returns the number of bytes before the NUL.
    pub fn length(): int {
        return lyr_ffi_cstr_length(this.address);
    }

    /// Returns a copy of the bytes as a `string`.
    ///
    /// # Errors
    /// A [Utf8Error] where the bytes are no well-formed UTF-8, with the offset of the first that
    /// is none.
    pub fn toString(): string throws Utf8Error {
        let bad = lyr_ffi_cstr_invalid(this.address);
        if (bad >= 0) {
            throw Utf8Error { offset = bad };
        }
        return lyr_ffi_cstr_string(this.address);
    }
}

/// The `CStr` a `string` stands for at a C function's boundary: its bytes, which a NUL ends.
/// Nothing but such a call holds one: the string's bytes are the string's, and the call is the
/// time they are known to be alive.
@Allow("unused")
fn stringAsCStr(s: string): CStr {
    return CStr { address = lyr_ffi_string_address(s) };
}

extern "C" fn lyr_ffi_cstr_length(address: uint): int;
extern "C" fn lyr_ffi_cstr_invalid(address: uint): int;
extern "C" fn lyr_ffi_cstr_string(address: uint): string;
extern "C" fn lyr_ffi_string_address(s: string): uint;
extern "C" fn lyr_ffi_alloc(count: int, size: uint): uint;
extern "C" fn lyr_ffi_free(address: uint): void;
extern "C" fn lyr_ffi_closure_release(root: uint): void;
