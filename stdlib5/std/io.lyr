//! Input and output: `import std.io { println }`. The module holds one error type (`IoError` with
//! its `IoErrorKind`); the interfaces `Reader`, `Writer` and `Seek` with their defaults; `copy`;
//! two streams over memory (`ByteReader`, `ByteBuffer`); the buffers `BufReader` and `BufWriter`
//! and the text streams `TextReader` and `TextWriter`; the console's output — `print`, `println`,
//! `eprint`, `eprintln`, `flush` — and its streams `stdin()`, `stdout()`, `stderr()`; and the I/O
//! pool that std.fs's calls run on. A reader's and a writer's call may throw `Cancelled` where it
//! waits without bound.
import std.core { Join, Utf8Error, viewBytes };
import std.task { Cancelled, SpinLock, schedulerRuns };
import std.thread { Pool };

// ---------------------------------------------------------------------------------------------
// The console's output: the standard output and the standard error, each buffered in the runtime
// (lyr/console.h) — the output a line at a time where it is a terminal, a block otherwise; the
// error always a line — and flushed at every end of the
// program: its last line, a panic's report, an error that leaves main. One argument each: an
// f-string formats more, `println(f"{n} left")`.
// ---------------------------------------------------------------------------------------------

fn consolePut(stream: int, from: Slice<uint8>): int;
fn consoleFlush(stream: int): int;
fn consoleGone(): void;

/// Writes `v`'s text on the standard output.
pub fn print<T :: [Display]>(v: T): void {
    put(1, v.show());
}

/// Writes `v`'s text and a newline on the standard output.
pub fn println<T :: [Display]>(v: T): void {
    put(1, v.show());
    put(1, "\n");
}

/// Writes `v`'s text on the standard error.
pub fn eprint<T :: [Display]>(v: T): void {
    put(2, v.show());
}

/// Writes `v`'s text and a newline on the standard error.
pub fn eprintln<T :: [Display]>(v: T): void {
    put(2, v.show());
    put(2, "\n");
}

/// Writes out what the console holds now: the standard output's, then the standard error's — for
/// before a prompt waits for its answer, or where the program's next lines take long.
pub fn flush(): void {
    drop(1);
    drop(2);
}

/// Puts `text` into the stream's buffer, with a flush wherever one is due. A failed write is
/// dropped — but a standard output nobody reads ends the program (`drop`).
fn put(stream: int, text: StringView): void {
    var rest = viewBytes(text);
    while (!rest.isEmpty()) {
        let answer = consolePut(stream, rest);
        if ((answer >> 32) != 0) {
            drop(stream);
        }
        rest = rest[(answer & 0xFFFFFFFF)..];
    }
}

/// Writes out the stream's buffer, a failure dropped. A `BrokenPipe` on the standard output ends
/// the program quietly, as SIGPIPE would have ended it: `prog | head -1` stops when `head` does.
/// Not on Windows, which has no such signal; the program goes on there.
fn drop(stream: int): void {
    let answer = flushed(stream);
    if (stream == 1 && answer < 0 && ((-answer) >> 32) == 13) {
        consoleGone();
    }
}

/// Writes out the stream's buffer: on the I/O pool where a scheduler runs, so a blocked write
/// parks one task and not the thread's others; on the thread where none runs. Returns 0, or a
/// failure as lyr/fs.h writes one.
fn flushed(stream: int): int {
    return onPool(() => consoleFlush(stream));
}

// ---------------------------------------------------------------------------------------------
// The console's streams: the standard input as a `Reader` read a line at a
// time; the standard output and error as `Writer`s over the buffers print writes into.
// ---------------------------------------------------------------------------------------------

fn consoleRead(into: Slice<uint8>): int;

@Allow("global-var-without-sync")
var theStdin: ?Stdin = null;

let stdinGuard = SpinLock { };

/// Returns the program's standard input: one for the program, made at the first call. Its reads
/// go through a buffer of its own, so `readLine`, `lines` and `read` take turns on it without a
/// byte lost — on the I/O pool where a scheduler runs.
pub fn stdin(): Stdin {
    stdinGuard.acquire();
    if (theStdin == null) {
        theStdin = Stdin { text = TextReader.new(ConsoleReader { }) };
    }
    let s = theStdin!;
    stdinGuard.release();
    return s;
}

/// Returns the standard output as a `Writer`: the buffer print writes into, so the two keep their
/// order.
pub fn stdout(): ConsoleWriter {
    return ConsoleWriter { stream = 1 };
}

/// Returns the standard error as a `Writer`: the buffer eprint writes into.
pub fn stderr(): ConsoleWriter {
    return ConsoleWriter { stream = 2 };
}

/// The standard input (`stdin()`): a `Reader`, and its text a line at a time.
pub class Stdin :: [Reader] {
    text: TextReader<ConsoleReader>,

    /// Reads the next line without its end — a `\n` or a `\r\n` —; returns `null` at the end of
    /// the input.
    ///
    /// # Errors
    ///
    /// Throws `IoError` where the read fails, or `InvalidData` for bytes that are no UTF-8.
    pub mut fn readLine(): ?string throws IoError {
        let text = this.text;
        return try uncancelled(() => try text.readLine());
    }

    /// Returns the lines to the end of the input, as `readLine` gives them.
    pub fn lines(): StdinLinesIter {
        return StdinLinesIter { input = this };
    }

    /// Reads bytes into `into` — what a line's read left in the buffer first — and returns how
    /// many; 0 only at the end.
    ///
    /// # Errors
    ///
    /// Throws `IoError` where the read fails.
    pub mut fn read(into: Slice<uint8>): int throws IoError {
        let source = this.text.source;
        return try uncancelled(() => try source.read(into));
    }
}

/// The standard input's lines (`stdin().lines()`). Its `Error` is `IoError` alone: the console's
/// read is never cancelled (`uncancelled`), where a `TextReader`'s lines over any reader are told
/// `Error`.
pub struct StdinLinesIter :: [Iterator] {
    type Item = string;
    type Error = IoError;
    input: Stdin,

    pub mut fn next(): ?string throws IoError {
        return try this.input.readLine();
    }
}

/// The console's input as bytes, unbuffered (lyr/console.h): what `stdin()` reads through its
/// buffer. A second one beside it would take bytes the buffer is owed: read through `stdin()`.
pub class ConsoleReader :: [Reader] {
    pub mut fn read(into: Slice<uint8>): int throws IoError {
        if (into.isEmpty()) {
            return 0;
        }
        let n = onPool(() => consoleRead(into));
        if (n < 0) {
            throw failure(n, null, "read from the standard input");
        }
        return n;
    }
}

/// One of the console's output streams as a `Writer` (`stdout()`, `stderr()`). What it takes goes
/// into the same buffer as print's; a flush that fails throws — a pipe nobody reads is
/// `BrokenPipe`. Not `Closeable`: the console is not the program's to close.
pub class ConsoleWriter :: [Writer] {
    stream: int,

    /// Writes all of `from` into the buffer, flushed wherever a flush is due, and returns its
    /// length.
    ///
    /// # Errors
    ///
    /// Throws `IoError` where a due flush fails.
    pub mut fn write(from: Slice<uint8>): int throws IoError {
        var rest = from;
        while (!rest.isEmpty()) {
            let answer = consolePut(this.stream, rest);
            if ((answer >> 32) != 0) {
                try this.flush();
            }
            rest = rest[(answer & 0xFFFFFFFF)..];
        }
        return from.length();
    }

    /// Writes out what the stream holds now.
    ///
    /// # Errors
    ///
    /// Throws `IoError` where the write fails — `BrokenPipe` for a pipe nobody reads.
    pub mut fn flush(): void throws IoError {
        let answer = flushed(this.stream);
        if (answer < 0) {
            throw failure(
                answer,
                null,
                if (this.stream == 2) "written to the standard error"
                    else "written to the standard output"
            );
        }
    }
}

/// Returns the `IoError` a runtime call's negative answer says (lyr/fs.h): -(kind << 32 | raw), the kinds counted
/// as `IoErrorKind`'s from 1 — `Other` with the system's code for one it has no name for.
fn failure(answer: int, path: ?string, doing: string): IoError {
    let code = -answer;
    let raw = code & 0xFFFFFFFF;
    let kind: IoErrorKind = match (code >> 32) {
        1 => .NotFound,
        2 => .PermissionDenied,
        3 => .AlreadyExists,
        4 => .IsDirectory,
        5 => .NotDirectory,
        6 => .InvalidInput,
        7 => .InvalidData,
        8 => .UnexpectedEof,
        9 => .TimedOut,
        10 => .ConnectionRefused,
        11 => .ConnectionReset,
        12 => .AddrInUse,
        13 => .BrokenPipe,
        14 => .Closed,
        15 => .Unsupported,
        _ => .Other { code = raw },
    };
    return IoError { kind = kind, path = path, detail = doing };
}

// ---------------------------------------------------------------------------------------------
// The I/O pool: four threads, made at the first call and there until the program ends, as the
// program's pool for parallelMap is. std.fs's calls and the
// console's flushes run on it.
// ---------------------------------------------------------------------------------------------

@Allow("global-var-without-sync")
var ioPool: ?Pool = null;

let ioPoolGuard = SpinLock { };

fn pool(): Pool {
    ioPoolGuard.acquire();
    if (ioPool == null) {
        ioPool = Pool.new(4);
    }
    let p = ioPool!;
    ioPoolGuard.release();
    return p;
}

/// Runs `call` on the I/O pool, the running task parked until it has run, and returns its answer.
/// Where no scheduler runs — a program that never waits, whose main is no task, or a module's
/// binding filled before `main` — no other task waits on this thread, and the call runs here.
fn onPool(call: fn() -> int): int {
    // the question as the branch's own condition: the compiler leaves the yes branch out of a
    // program that sets no scheduler, which then keeps nothing of the pool (SchedulerFree)
    if (schedulerRuns()) {
        let task = pool().spawn(call);
        return try! task.awaitThrough();
    }
    return call();
}

/// Runs a call on a stream that is never cancelled and passes on only its `IoError`s. A file's
/// calls and the console's run on the pool above and end in bounded time — no point of
/// cancellation —, so the `Cancelled` that a default or a buffer over them declares,
/// for any reader it might wrap, cannot come from them. std.fs and `Stdin` keep `throws IoError`
/// through this.
///
/// # Panics
///
/// Panics where the call throws `Cancelled` after all.
fn uncancelled<T>(call: fn() -> T throws [IoError, Cancelled]): T throws IoError {
    try {
        return call();
    } catch (_: Cancelled) {
        unreachable("a file's or the console's call is no point of cancellation");
    }
}

// ---------------------------------------------------------------------------------------------
// The error.
// ---------------------------------------------------------------------------------------------

/// Classifies what went wrong in an input or an output — a file's, a socket's, a process's,
/// memory's alike. `@NonExhaustive`: a `match` over it outside `std` writes a `_`, which a
/// later kind needs.
@NonExhaustive
pub enum IoErrorKind :: [Equatable] {
    NotFound,
    PermissionDenied,
    AlreadyExists,
    IsDirectory,
    NotDirectory,
    InvalidInput,
    InvalidData,
    UnexpectedEof,
    TimedOut,
    ConnectionRefused,
    ConnectionReset,
    AddrInUse,
    BrokenPipe,
    Closed,
    Unsupported,
    /// A code of the system that no kind above names.
    Other { code: int },
}

/// The error every input and output throws: its kind, the path it concerns, what more is known,
/// and what caused it. The cause is the field `inner`: `Error` asks for a method `cause()`, and a
/// field and a method of one type cannot share a name.
pub struct IoError :: [Error] {
    pub kind: IoErrorKind,
    pub path: ?string,
    pub detail: string = "",
    pub inner: ?Error,

    /// Returns the kind in words, then the path and the detail where there are any:
    /// `not found: data.txt`.
    pub fn message(): string {
        var text = kindText(this.kind);
        if (let p = this.path) {
            text = f"{text}: {p}";
        }
        if (!this.detail.isEmpty()) {
            text = f"{text} ({this.detail})";
        }
        return text;
    }

    pub fn cause(): ?Error {
        return this.inner;
    }
}

fn kindText(kind: IoErrorKind): string {
    return match (kind) {
        .NotFound => "not found",
        .PermissionDenied => "permission denied",
        .AlreadyExists => "already exists",
        .IsDirectory => "is a directory",
        .NotDirectory => "not a directory",
        .InvalidInput => "invalid input",
        .InvalidData => "invalid data",
        .UnexpectedEof => "unexpected end of input",
        .TimedOut => "timed out",
        .ConnectionRefused => "connection refused",
        .ConnectionReset => "connection reset",
        .AddrInUse => "address in use",
        .BrokenPipe => "broken pipe",
        .Closed => "closed",
        .Unsupported => "unsupported",
        .Other { code } => f"system error {code}",
    };
}

// ---------------------------------------------------------------------------------------------
// The interfaces: the caller hands the buffer.
// ---------------------------------------------------------------------------------------------

/// A source of bytes. `read` fills the slice it is handed from the front and returns how many
/// bytes it put there: **0 only at the end**, and at once for an empty slice — fewer than the
/// slice holds is no end.
///
/// **Why a read throws `Cancelled`**: a read from a socket or a pipe waits for as long as nothing
/// comes — without bound. `withTimeout` and the end of a task's scope stop a task that waits
/// there, and the read ends with `Cancelled`, as every other wait does. It is not an
/// `IoErrorKind`: a `catch (e: IoError)` would take the cancel for a failure of the stream, and a
/// loop that reads again after one would never stop. A reader that never waits without bound —
/// memory, a file, the console, whose calls end in bounded time — declares `throws IoError`
/// alone: an implementation throws at most what the member allows. Code over any reader
/// (`R :: [Reader]`) is told both.
pub interface Reader {
    mut fn read(into: Slice<uint8>): int throws [IoError, Cancelled];
}

/// A sink of bytes. `write` takes from the front of the slice and returns how many bytes it took — **maybe fewer** than it was handed; `writeAll` takes the rest. `flush` hands on what a
/// writer holds back; one that holds nothing back keeps the default, which does nothing.
///
/// **Why a write throws `Cancelled`**, as a read does (`Reader`): a write into a socket or a pipe
/// waits for as long as its reader takes nothing — without bound —, and a cancel ends that wait
/// with `Cancelled`, not with an `IoError` a handler would take for the stream's. A writer that never waits without bound declares `throws IoError` alone.
pub interface Writer {
    mut fn write(from: Slice<uint8>): int throws [IoError, Cancelled];

    mut fn flush(): void throws [IoError, Cancelled] { }
}

/// Selects where a position moves to: from the start, from the end, from where it stands.
pub enum SeekFrom :: [Equatable] {
    Start(int),
    End(int),
    Current(int),
}

/// A stream with a position: `seek` moves it and returns where it then stands, counted from the
/// start.
pub interface Seek {
    mut fn seek(to: SeekFrom): int throws IoError;
}

/// Adds to every reader what it can do with its `read`. It throws what any reader's `read` may —
/// `Cancelled` too, over a reader that never throws it (`Reader`).
extend<R :: [Reader]> R {
    /// Fills `into` whole, reading as often as it takes.
    ///
    /// # Errors
    ///
    /// Throws `UnexpectedEof` where the source ends before, the bytes that came in the detail,
    /// and what the reader's `read` throws.
    pub mut fn readExact(into: Slice<uint8>): void throws [IoError, Cancelled] {
        var at = 0;
        while (at < into.length()) {
            let n = try this.read(into[at..]);
            if (n == 0) {
                throw IoError { kind = .UnexpectedEof, detail = f"{at} of {into.length()} bytes" };
            }
            at = at + n;
        }
    }

    /// Reads everything to the end and returns it in one new array.
    ///
    /// # Errors
    ///
    /// Throws what the reader's `read` throws.
    pub mut fn readToEnd(): uint8[] throws [IoError, Cancelled] {
        let held = ByteBuffer.new();
        let chunk: uint8[] = [0u8] * 8192;
        loop {
            let n = try this.read(chunk[..]);
            if (n == 0) {
                return held.toArray();
            }
            held.append(chunk[..n]);
        }
    }

    /// Reads everything to the end and returns it as UTF-8 text.
    ///
    /// # Errors
    ///
    /// Throws `InvalidData` for bytes that are no UTF-8, with the decoder's error as the cause,
    /// and what the reader's `read` throws.
    pub mut fn readToString(): string throws [IoError, Cancelled] {
        let bytes = try this.readToEnd();
        return try string.fromUtf8(bytes[..]) catch (e: Utf8Error) throw IoError {
            kind = .InvalidData,
            detail = "the bytes are no UTF-8",
            inner = e,
        };
    }
}

/// Adds to every writer what it can do with its `write`, throwing what any writer's `write` may.
extend<W :: [Writer]> W {
    /// Writes all of `from`, writing as often as it takes.
    ///
    /// # Errors
    ///
    /// Throws `Other { code = 0 }` where the writer takes no byte of a slice that has some (it
    /// would be asked forever), and what the writer's `write` throws.
    pub mut fn writeAll(from: Slice<uint8>): void throws [IoError, Cancelled] {
        var at = 0;
        while (at < from.length()) {
            let n = try this.write(from[at..]);
            if (n == 0) {
                throw IoError {
                    kind = .Other { code = 0 },
                    detail = f"the writer took none of {from.length() - at} bytes",
                };
            }
            at = at + n;
        }
    }

    /// Writes all the bytes of `s` (its UTF-8).
    ///
    /// # Errors
    ///
    /// Throws what `writeAll` throws.
    pub mut fn writeString(s: StringView): void throws [IoError, Cancelled] {
        try this.writeAll(viewBytes(s));
    }
}

/// Copies everything `r` holds into `w`, through a buffer of its own, and returns how many bytes
/// it copied. The two are read and written as the values handed in — the handles and the
/// streams here are classes, so that is the object itself; a reader that is a struct is read
/// through a copy, and its position does not move for the caller.
///
/// # Errors
///
/// Throws what `r`'s `read` and `w`'s `write` throw.
pub fn copy<R :: [Reader], W :: [Writer]>(r: R, w: W): int throws [IoError, Cancelled] {
    var from = r;
    var into = w;
    let chunk: uint8[] = [0u8] * 8192;
    var total = 0;
    loop {
        let n = try from.read(chunk[..]);
        if (n == 0) {
            return total;
        }
        try into.writeAll(chunk[..n]);
        total = total + n;
    }
}

// ---------------------------------------------------------------------------------------------
// The streams over memory. They say `throws IoError` and throw nothing; never waiting, they
// leave `Cancelled` out.
// ---------------------------------------------------------------------------------------------

/// A `Reader` over bytes in memory: it reads them from the front, and `seek` moves it. A position
/// past the end reads nothing.
///
/// # Panics
///
/// `seek` panics on a position before the start.
pub class ByteReader :: [Reader, Seek] {
    bytes: Slice<uint8>,
    var at: int = 0,

    pub static fn new(bytes: Slice<uint8>): ByteReader {
        return ByteReader { bytes = bytes };
    }

    pub mut fn read(into: Slice<uint8>): int throws IoError {
        let rest = if (this.at < this.bytes.length()) this.bytes.length() - this.at else 0;
        let n = if (into.length() < rest) into.length() else rest;
        if (n == 0) {
            return 0;
        }
        this.bytes[this.at..this.at + n].copyInto(into);
        this.at = this.at + n;
        return n;
    }

    pub mut fn seek(to: SeekFrom): int throws IoError {
        let target = match (to) {
            .Start(n) => n,
            .End(n) => this.bytes.length() + n,
            .Current(n) => this.at + n,
        };
        if (target < 0) {
            panic(f"a seek to {target}, before the start");
        }
        this.at = target;
        return target;
    }

    /// Returns the position, counted from the start.
    pub fn position(): int {
        return this.at;
    }
}

/// A growing buffer of bytes in memory: a `Writer` that appends, a `Reader` that takes from
/// the front what was written and not yet read.
pub class ByteBuffer :: [Reader, Writer] {
    var data: uint8[] = [],
    var start: int = 0,
    var end: int = 0,

    pub static fn new(): ByteBuffer {
        return ByteBuffer { };
    }

    /// Appends all of `from` and returns its length; never throws.
    pub mut fn write(from: Slice<uint8>): int throws IoError {
        this.append(from);
        return from.length();
    }

    pub mut fn read(into: Slice<uint8>): int throws IoError {
        let held = this.end - this.start;
        let n = if (into.length() < held) into.length() else held;
        this.data[this.start..this.start + n].copyInto(into);
        this.start = this.start + n;
        return n;
    }

    /// Returns the bytes it holds, not yet read, in a new array.
    pub fn toArray(): uint8[] {
        let out: uint8[] = [0u8] * (this.end - this.start);
        this.data[this.start..this.end].copyInto(out[..]);
        return out;
    }

    /// Returns how many bytes it holds, not yet read.
    pub fn length(): int {
        return this.end - this.start;
    }

    /// Appends all of `from` — `write` that cannot throw, for the readers' own use.
    mut fn append(from: Slice<uint8>): void {
        let need = this.end - this.start + from.length();
        if (this.end + from.length() > this.data.length()) {
            var size = if (this.data.length() == 0) 64 else this.data.length() * 2;
            while (size < need) {
                size = size * 2;
            }
            let grown: uint8[] = [0u8] * size;
            this.data[this.start..this.end].copyInto(grown[..]);
            this.end = this.end - this.start;
            this.start = 0;
            this.data = grown;
        }
        from.copyInto(this.data[this.end..]);
        this.end = this.end + from.length();
    }
}

// ---------------------------------------------------------------------------------------------
// The buffers and the text. The buffers are classes over 8 KiB on the heap: every read hands the
// inner reader a view of the buffer, and a frame's inline array has no view; a struct over a heap
// array would share it between copies, each with a position of its own.
// ---------------------------------------------------------------------------------------------

/// The size in bytes of a `BufReader`'s or a `BufWriter`'s own buffer.
let bufferSize = 8192;

/// A `Reader` with a buffer of its own: it reads its inner reader 8 KiB at a time, so that
/// small reads do not each reach it. A read at least as large as the buffer, while the buffer is
/// empty, goes to the inner reader directly. It throws what its inner reader may (`Reader`).
pub class BufReader<R :: [Reader]> :: [Reader] {
    var inner: R,
    held: uint8[],
    var start: int = 0,
    var end: int = 0,

    pub static fn new(inner: R): BufReader<R> {
        return BufReader { inner = inner, held = [0u8] * bufferSize };
    }

    pub mut fn read(into: Slice<uint8>): int throws [IoError, Cancelled] {
        if (into.isEmpty()) {
            return 0;
        }
        if (this.start == this.end) {
            if (into.length() >= this.held.length()) {
                return try this.inner.read(into);
            }
            if (try this.more() == 0) {
                return 0;
            }
        }
        let held = this.end - this.start;
        let n = if (into.length() < held) into.length() else held;
        this.held[this.start..this.start + n].copyInto(into);
        this.start = this.start + n;
        return n;
    }

    /// Reads the inner reader once into the room after what is held, which moves to the front
    /// first; returns how many bytes came — 0 at the end.
    mut fn more(): int throws [IoError, Cancelled] {
        if (this.start > 0) {
            this.held[this.start..this.end].copyInto(this.held[..]);
            this.end = this.end - this.start;
            this.start = 0;
        }
        let n = try this.inner.read(this.held[this.end..]);
        this.end = this.end + n;
        return n;
    }

    /// Returns whether `n` bytes are held — a few, for a codepoint or a BOM —, reading for them
    /// while the inner reader has some.
    mut fn hold(n: int): bool throws [IoError, Cancelled] {
        while (this.end - this.start < n) {
            if (try this.more() == 0) {
                return false;
            }
        }
        return true;
    }
}

/// A `Writer` with a buffer of its own: what it is handed waits there until 8 KiB are together, a
/// `flush()` or a `close()`. A write at least as large as the buffer goes to the inner writer
/// directly. It is `Closeable`, and one nothing closes is warned about: its last bytes would stay
/// in the buffer. Closing flushes and leaves the inner writer open — it is the caller's
/// (`using let f = …; using let w = BufWriter.new(f);` closes `w` first). It throws what its inner
/// writer may (`Writer`).
pub class BufWriter<W :: [Writer]> :: [Writer, Closeable] {
    var inner: W,
    held: uint8[],
    var used: int = 0,
    var sent: int = 0,

    pub static fn new(inner: W): BufWriter<W> {
        return BufWriter { inner = inner, held = [0u8] * bufferSize };
    }

    pub mut fn write(from: Slice<uint8>): int throws [IoError, Cancelled] {
        if (this.used + from.length() > this.held.length()) {
            try this.handOn();
        }
        if (from.length() >= this.held.length()) {
            return try this.inner.write(from);
        }
        from.copyInto(this.held[this.used..]);
        this.used = this.used + from.length();
        return from.length();
    }

    /// Writes what is held, then flushes the inner writer.
    ///
    /// # Errors
    ///
    /// Throws what the inner writer's `write` or `flush` throws, and `Other { code = 0 }` where
    /// it takes no byte.
    pub mut fn flush(): void throws [IoError, Cancelled] {
        try this.handOn();
        try this.inner.flush();
    }

    /// Flushes as `flush()` does; the inner writer stays open.
    ///
    /// # Errors
    ///
    /// Throws what `flush()` throws.
    pub fn close(): void throws [IoError, Cancelled] {
        // through the reference: 'Closeable.close' is no 'mut fn' (as Pool's close)
        let me = this;
        try me.flush();
    }

    /// Writes what is held. A write that throws leaves what it did not take held, for the next.
    mut fn handOn(): void throws [IoError, Cancelled] {
        while (this.sent < this.used) {
            let n = try this.inner.write(this.held[this.sent..this.used]);
            if (n == 0) {
                throw IoError {
                    kind = .Other { code = 0 },
                    detail = f"the writer took none of {this.used - this.sent} bytes",
                };
            }
            this.sent = this.sent + n;
        }
        this.sent = 0;
        this.used = 0;
    }
}

/// A reader of UTF-8 text: a `BufReader` and a decoder. A codepoint split between two reads
/// of the inner reader waits in the buffer for its rest; bytes that are no UTF-8 throw
/// `InvalidData`, a `Utf8Error` as the cause with the offset counted from the reader's start. A
/// byte order mark is text like any other, unless `skipBom` drops it from the front. It throws what
/// its inner reader may (`Reader`).
pub class TextReader<R :: [Reader]> {
    source: BufReader<R>,
    var bom: bool,
    var taken: int = 0,

    pub static fn new(inner: R, skipBom: bool = false): TextReader<R> {
        return TextReader { source = BufReader.new(inner), bom = skipBom };
    }

    /// Reads the next line without its end — a `\n` or a `\r\n` —; returns `null` at the end. A
    /// last line without an end is a line; the end of the last one starts none.
    ///
    /// # Errors
    ///
    /// Throws `InvalidData` for bytes that are no UTF-8, and what the inner reader throws.
    pub mut fn readLine(): ?string throws [IoError, Cancelled] {
        try this.dropBom();
        let s = this.source;
        var line: ?ByteBuffer = null;
        loop {
            if (s.start == s.end && try s.more() == 0) {
                if (let l = line) {
                    return try this.text(l.toArray()[..], 0);
                }
                return null;
            }
            let held = s.held[s.start..s.end];
            if (let i = held.indexOf(10u8)) {
                s.start = s.start + i + 1;
                if (let l = line) {
                    l.append(held[..i]);
                    return try this.text(l.toArray()[..], 1);
                }
                return try this.text(held[..i], 1);
            }
            let l = line ?? ByteBuffer.new();
            l.append(held);
            line = l;
            s.start = s.end;
        }
    }

    /// Returns the lines to the end, as `readLine` gives them.
    pub fn lines(): TextLinesIter<R> {
        return TextLinesIter { reader = this };
    }

    /// Returns the characters to the end, one codepoint at a time.
    pub fn chars(): TextCharsIter<R> {
        return TextCharsIter { reader = this };
    }

    /// Reads everything to the end and returns it as text.
    ///
    /// # Errors
    ///
    /// Throws `InvalidData` for bytes that are no UTF-8, and what the inner reader throws.
    pub mut fn readToEnd(): string throws [IoError, Cancelled] {
        try this.dropBom();
        let bytes = try this.source.readToEnd();
        return try this.text(bytes[..], 0);
    }

    /// Reads the next codepoint; returns `null` at the end. A malformed or overlong sequence
    /// throws `InvalidData`.
    mut fn readChar(): ?char throws [IoError, Cancelled] {
        try this.dropBom();
        let s = this.source;
        if (!(try s.hold(1))) {
            return null;
        }
        let lead = s.held[s.start] as int;
        let size = if (lead < 0x80) 1
            else if (lead < 0xC0) 0
                else if (lead < 0xE0) 2 else if (lead < 0xF0) 3 else if (lead < 0xF8) 4 else 0;
        if (size == 0 || !(try s.hold(size))) {
            throw invalidAt(this.taken);
        }
        var code = if (size == 1) lead else lead & (0x7F >> size);
        var k = 1;
        while (k < size) {
            let b = s.held[s.start + k] as int;
            if ((b & 0xC0) != 0x80) {
                throw invalidAt(this.taken);
            }
            code = (code << 6) | (b & 0x3F);
            k = k + 1;
        }
        // the shortest form only: two bytes from 0x80, three from 0x800, four from 0x10000
        let least = if (size == 2) 0x80
            else if (size == 3) 0x800 else if (size == 4) 0x10000 else 0;
        let c = if (code < least) null else char.fromUint32(code as uint32);
        if (c == null) {
            throw invalidAt(this.taken);
        }
        s.start = s.start + size;
        this.taken = this.taken + size;
        return c;
    }

    /// Decodes the bytes of a line as text, a `\r` before its end dropped; `ends` bytes of the end follow
    /// them in the stream.
    mut fn text(bytes: Slice<uint8>, ends: int): string throws IoError {
        let at = this.taken;
        this.taken = at + bytes.length() + ends;
        var n = bytes.length();
        if (ends > 0 && n > 0 && bytes[n - 1] == 13u8) {
            n = n - 1;
        }
        return try string.fromUtf8(bytes[..n]) catch (e: Utf8Error) throw invalidAt(at + e.offset);
    }

    /// Drops a byte order mark from the front, once, where `skipBom` asked for it.
    mut fn dropBom(): void throws [IoError, Cancelled] {
        if (!this.bom) {
            return;
        }
        this.bom = false;
        let s = this.source;
        if (try s.hold(3)) {
            if (s.held[s.start] == 0xEFu8
                && s.held[s.start + 1] == 0xBBu8
                && s.held[s.start + 2] == 0xBFu8) {
                s.start = s.start + 3;
                this.taken = 3;
            }
        }
    }
}

/// Returns the `InvalidData` error for bytes that are no UTF-8 from `offset` on.
fn invalidAt(offset: int): IoError {
    return IoError {
        kind = .InvalidData,
        detail = "the bytes are no UTF-8",
        inner = Utf8Error { offset = offset },
    };
}

/// A `TextReader`'s lines. An iterator's `Error` is one type, so the two a reader may throw are
/// joined, which an instance reads as `Error`: a loop over them is told `Error`.
pub struct TextLinesIter<R :: [Reader]> :: [Iterator] {
    type Item = string;
    type Error = Join<IoError, Cancelled>;
    reader: TextReader<R>,

    pub mut fn next(): ?string throws Join<IoError, Cancelled> {
        return try this.reader.readLine();
    }
}

/// A `TextReader`'s characters, their `Error` joined as the lines' is.
pub struct TextCharsIter<R :: [Reader]> :: [Iterator] {
    type Item = char;
    type Error = Join<IoError, Cancelled>;
    reader: TextReader<R>,

    pub mut fn next(): ?char throws Join<IoError, Cancelled> {
        return try this.reader.readChar();
    }
}

/// A writer of text: its UTF-8, to the inner writer as it comes. It holds nothing back; a
/// `BufWriter` beneath it does, and is closed by its own name: `using let b = BufWriter.new(f);
/// let t = TextWriter.new(b);`.
pub class TextWriter<W :: [Writer]> {
    var inner: W,

    pub static fn new(inner: W): TextWriter<W> {
        return TextWriter { inner = inner };
    }

    pub mut fn write(s: StringView): void throws [IoError, Cancelled] {
        try this.inner.writeString(s);
    }

    /// Writes `s`, then a `\n` — on every system.
    ///
    /// # Errors
    ///
    /// Throws what the inner writer throws.
    pub mut fn writeLine(s: StringView): void throws [IoError, Cancelled] {
        try this.inner.writeString(s);
        try this.inner.writeString("\n");
    }
}
