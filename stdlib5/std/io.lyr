/// Input and output (design/v5/spec/10 O1–O4, U5, O9): `import std.io { println }`. M8b S2: the
/// core — one error type, the three interfaces and their defaults, `copy`, and two streams over
/// memory. S3: the buffers and the text. S6: the I/O pool, which std.fs's calls run on. S8a: the
/// console's output — `print`, `println`, `eprint`, `eprintln`, `flush`; S8b: `stdin()` and the
/// console's streams as a `Reader` and `Writer`s.
import std.core { Utf8Error, viewBytes };
import std.task { SpinLock, schedulerRuns };
import std.thread { Pool };

// ---------------------------------------------------------------------------------------------
// The console's output (10 O9; 13 M8b P3, S8a): the standard output and the standard error, each
// buffered in the runtime (lyr/console.h) — a line at a time where it is a terminal, a block
// otherwise — and flushed at every end of the program: its last line, a panic's report, an error
// that leaves main. One argument each: an f-string formats more, `println(f"{n} left")`.
// ---------------------------------------------------------------------------------------------

fn consolePut(stream: int, from: Slice<uint8>): int;
fn consoleFlush(stream: int): int;

/// `v`'s text on the standard output.
pub fn print<T :: [Display]>(v: T): void {
    put(1, v.show());
}

/// `v`'s text and a newline on the standard output.
pub fn println<T :: [Display]>(v: T): void {
    put(1, v.show());
    put(1, "\n");
}

/// `v`'s text on the standard error.
pub fn eprint<T :: [Display]>(v: T): void {
    put(2, v.show());
}

/// `v`'s text and a newline on the standard error.
pub fn eprintln<T :: [Display]>(v: T): void {
    put(2, v.show());
    put(2, "\n");
}

/// What the console holds, written now: the standard output's, then the standard error's — before
/// a prompt waits for its answer, or where the program's next lines take long.
pub fn flush(): void {
    drop(1);
    drop(2);
}

/// `text` into the stream's buffer, and a flush wherever one is due. A failed write is dropped, as
/// Go's `fmt.Print` drops it.
fn put(stream: int, text: StringView): void {
    var rest = viewBytes(text);
    while (!rest.isEmpty()) {
        let answer = consolePut(stream, rest);
        if ((answer >> 32) != 0) {
            drop(stream);
        }
        rest = rest[(answer & 0xFFFFFFFF)..];
    }
}

/// The stream's buffer written, a failure dropped.
fn drop(stream: int): void {
    let _ = flushed(stream);
}

/// The stream's buffer written: on the I/O pool where a scheduler runs, so a blocked write parks
/// one task and not the thread's others; on the thread where none runs (P3). 0, or a failure as
/// lyr/fs.h writes one.
fn flushed(stream: int): int {
    return onPool(() => consoleFlush(stream));
}

// ---------------------------------------------------------------------------------------------
// The I/O pool (13 M8b P2): four threads — libuv's count —, made at the first call and there
// until the program ends, as the program's pool for parallelMap is. std.fs's calls and the
// console's flushes run on it.
// ---------------------------------------------------------------------------------------------

var ioPool: ?Pool = null;
let ioPoolGuard = SpinLock { };

fn pool(): Pool {
    ioPoolGuard.acquire();
    if (ioPool == null) {
        ioPool = Pool.new(4);
    }
    let p = ioPool!;
    ioPoolGuard.release();
    return p;
}

/// `call` on the I/O pool, the running task parked until it has run: its answer. Where no
/// scheduler runs — a program that never waits, whose main is no task (06 M6-26), or a module's
/// binding filled before `main` — no other task waits on this thread, and the call runs here.
fn onPool(call: fn() -> int): int {
    // the question as the branch's own condition: the compiler's walk for M6-26 leaves its yes out,
    // and a program that sets no scheduler keeps nothing of it (SchedulerFree)
    if (schedulerRuns()) {
        let task = pool().spawn(call);
        return try! task.awaitThrough();
    }
    return call();
}

// ---------------------------------------------------------------------------------------------
// The error (10 O3).
// ---------------------------------------------------------------------------------------------

/// What went wrong in an input or an output (10 O3) — a file's, a socket's, a process's, memory's
/// alike. *(The decision marks it `@NonExhaustive`, which comes with the rest of the compiler's
/// attributes, M9a: a `match` over it should write a `_`, as a later kind would need one.)*
pub enum IoErrorKind :: [Equatable] {
    NotFound,
    PermissionDenied,
    AlreadyExists,
    IsDirectory,
    NotDirectory,
    InvalidInput,
    InvalidData,
    UnexpectedEof,
    TimedOut,
    ConnectionRefused,
    ConnectionReset,
    AddrInUse,
    BrokenPipe,
    Closed,
    Unsupported,
    /// A code of the system that no kind above names.
    Other { code: int },
}

/// The error every input and output throws (10 O3): its kind, the path it concerns, what more is
/// known, and what caused it. The decision names the last field `cause`; `Error` asks for a method
/// of that name, and a type's members do not share one, so it is `inner`, as `Exception`'s is.
pub struct IoError :: [Error] {
    pub kind: IoErrorKind,
    pub path: ?string,
    pub detail: string = "",
    pub inner: ?Error,

    /// The kind in words, then the path and the detail where there are any: `not found: data.txt`.
    pub fn message(): string {
        var text = kindText(this.kind);
        if (let p = this.path) {
            text = f"{text}: {p}";
        }
        if (!this.detail.isEmpty()) {
            text = f"{text} ({this.detail})";
        }
        return text;
    }

    pub fn cause(): ?Error {
        return this.inner;
    }
}

fn kindText(kind: IoErrorKind): string {
    return match (kind) {
        .NotFound => "not found",
        .PermissionDenied => "permission denied",
        .AlreadyExists => "already exists",
        .IsDirectory => "is a directory",
        .NotDirectory => "not a directory",
        .InvalidInput => "invalid input",
        .InvalidData => "invalid data",
        .UnexpectedEof => "unexpected end of input",
        .TimedOut => "timed out",
        .ConnectionRefused => "connection refused",
        .ConnectionReset => "connection reset",
        .AddrInUse => "address in use",
        .BrokenPipe => "broken pipe",
        .Closed => "closed",
        .Unsupported => "unsupported",
        .Other { code } => f"system error {code}",
    };
}

// ---------------------------------------------------------------------------------------------
// The interfaces (10 O1, Go's form: the caller hands the buffer).
// ---------------------------------------------------------------------------------------------

/// A source of bytes (10 O1). `read` fills the slice it is handed from the front and answers how
/// many bytes it put there: **0 only at the end**, and at once for an empty slice — fewer than the
/// slice holds is no end.
pub interface Reader {
    mut fn read(into: Slice<uint8>): int throws IoError;
}

/// A sink of bytes (10 O1). `write` takes from the front of the slice and answers how many bytes
/// it took — **maybe fewer** than it was handed; `writeAll` takes the rest. `flush` hands on what a
/// writer holds back; one that holds nothing back keeps the default, which does nothing.
pub interface Writer {
    mut fn write(from: Slice<uint8>): int throws IoError;

    mut fn flush(): void throws IoError {
    }
}

/// Where a position moves to (10 O1): from the start, from the end, from where it stands.
pub enum SeekFrom :: [Equatable] {
    Start(int),
    End(int),
    Current(int),
}

/// A stream with a position (10 O1): `seek` moves it and answers where it then stands, counted
/// from the start.
pub interface Seek {
    mut fn seek(to: SeekFrom): int throws IoError;
}

/// What every reader can do with its `read` (10 O1).
extend<R :: [Reader]> R {
    /// Fills `into` whole, reading as often as it takes. A source that ends before throws
    /// `UnexpectedEof`, the bytes that came in the detail.
    pub mut fn readExact(into: Slice<uint8>): void throws IoError {
        var at = 0;
        while (at < into.length()) {
            let n = try this.read(into[at..]);
            if (n == 0) {
                throw IoError { kind = .UnexpectedEof, detail = f"{at} of {into.length()} bytes" };
            }
            at = at + n;
        }
    }

    /// Everything to the end, in one new array.
    pub mut fn readToEnd(): uint8[] throws IoError {
        let held = ByteBuffer.new();
        let chunk: uint8[] = [0u8] * 8192;
        loop {
            let n = try this.read(chunk[..]);
            if (n == 0) {
                return held.toArray();
            }
            held.append(chunk[..n]);
        }
    }

    /// Everything to the end, as UTF-8 text. Bytes that are no UTF-8 throw `InvalidData`, with the
    /// decoder's error as the cause.
    pub mut fn readToString(): string throws IoError {
        let bytes = try this.readToEnd();
        return try string.fromUtf8(bytes[..]) catch (e: Utf8Error)
            throw IoError { kind = .InvalidData, detail = "the bytes are no UTF-8", inner = e };
    }
}

/// What every writer can do with its `write` (10 O1).
extend<W :: [Writer]> W {
    /// All of `from`, writing as often as it takes. A writer that takes no byte of a slice that has
    /// some would be asked forever; it throws `Other { code = 0 }` instead.
    pub mut fn writeAll(from: Slice<uint8>): void throws IoError {
        var at = 0;
        while (at < from.length()) {
            let n = try this.write(from[at..]);
            if (n == 0) {
                throw IoError { kind = .Other { code = 0 }, detail = f"the writer took none of {from.length() - at} bytes" };
            }
            at = at + n;
        }
    }

    /// The bytes of `s`, all of them (its UTF-8).
    pub mut fn writeString(s: StringView): void throws IoError {
        try this.writeAll(viewBytes(s));
    }
}

/// Everything `r` holds, into `w`, through a buffer of its own; answers how many bytes it copied
/// (10 O1, B2). The two are read and written as the values handed in — the handles and the
/// streams here are classes, so that is the object itself; a reader that is a struct is read
/// through a copy, and its position does not move for the caller.
pub fn copy<R :: [Reader], W :: [Writer]>(r: R, w: W): int throws IoError {
    var from = r;
    var into = w;
    let chunk: uint8[] = [0u8] * 8192;
    var total = 0;
    loop {
        let n = try from.read(chunk[..]);
        if (n == 0) {
            return total;
        }
        try into.writeAll(chunk[..n]);
        total = total + n;
    }
}

// ---------------------------------------------------------------------------------------------
// The streams over memory (10 O2). They say `throws IoError` as every reader and writer does, and
// throw nothing.
// ---------------------------------------------------------------------------------------------

/// A `Reader` over bytes in memory (10 O2): it reads them from the front, and `seek` moves it. A
/// position past the end reads nothing; one before the start is the program's error and panics.
pub class ByteReader :: [Reader, Seek] {
    bytes: Slice<uint8>,
    var at: int = 0,

    pub static fn new(bytes: Slice<uint8>): ByteReader {
        return ByteReader { bytes = bytes };
    }

    pub mut fn read(into: Slice<uint8>): int throws IoError {
        let rest = if (this.at < this.bytes.length()) this.bytes.length() - this.at else 0;
        let n = if (into.length() < rest) into.length() else rest;
        if (n == 0) {
            return 0;
        }
        this.bytes[this.at..this.at + n].copyInto(into);
        this.at = this.at + n;
        return n;
    }

    pub mut fn seek(to: SeekFrom): int throws IoError {
        let target = match (to) {
            .Start(n) => n,
            .End(n) => this.bytes.length() + n,
            .Current(n) => this.at + n,
        };
        if (target < 0) {
            panic(f"a seek to {target}, before the start");
        }
        this.at = target;
        return target;
    }

    /// The position, counted from the start.
    pub fn position(): int {
        return this.at;
    }
}

/// A growing buffer of bytes in memory (10 O2): a `Writer` that appends, a `Reader` that takes from
/// the front what was written and not yet read.
pub class ByteBuffer :: [Reader, Writer] {
    var data: uint8[] = [],
    var start: int = 0,
    var end: int = 0,

    pub static fn new(): ByteBuffer {
        return ByteBuffer { };
    }

    /// Appends all of `from`; answers how many bytes, which is all of them.
    pub mut fn write(from: Slice<uint8>): int throws IoError {
        this.append(from);
        return from.length();
    }

    pub mut fn read(into: Slice<uint8>): int throws IoError {
        let held = this.end - this.start;
        let n = if (into.length() < held) into.length() else held;
        this.data[this.start..this.start + n].copyInto(into);
        this.start = this.start + n;
        return n;
    }

    /// The bytes it holds, not yet read, in a new array.
    pub fn toArray(): uint8[] {
        let out: uint8[] = [0u8] * (this.end - this.start);
        this.data[this.start..this.end].copyInto(out[..]);
        return out;
    }

    /// How many bytes it holds, not yet read.
    pub fn length(): int {
        return this.end - this.start;
    }

    /// Appends all of `from` — `write` that cannot throw, for the readers' own use.
    mut fn append(from: Slice<uint8>): void {
        let need = this.end - this.start + from.length();
        if (this.end + from.length() > this.data.length()) {
            var size = if (this.data.length() == 0) 64 else this.data.length() * 2;
            while (size < need) {
                size = size * 2;
            }
            let grown: uint8[] = [0u8] * size;
            this.data[this.start..this.end].copyInto(grown[..]);
            this.end = this.end - this.start;
            this.start = 0;
            this.data = grown;
        }
        from.copyInto(this.data[this.end..]);
        this.end = this.end + from.length();
    }
}

// ---------------------------------------------------------------------------------------------
// The buffers and the text (10 O2). The decision has the buffers as structs with the bytes inline;
// a frame's inline array has no view (03 §5.3), and every read hands the inner reader a view of
// the buffer, so they are classes over 8 KiB on the heap — a struct over the same array would
// share it between copies, each with a position of its own.
// ---------------------------------------------------------------------------------------------

/// The size of a buffer's own buffer (10 O2).
let bufferSize = 8192;

/// A `Reader` with a buffer of its own (10 O2): it reads its inner reader 8 KiB at a time, so that
/// small reads do not each reach it. A read at least as large as the buffer, while the buffer is
/// empty, goes to the inner reader directly.
pub class BufReader<R :: [Reader]> :: [Reader] {
    var inner: R,
    held: uint8[],
    var start: int = 0,
    var end: int = 0,

    pub static fn new(inner: R): BufReader<R> {
        return BufReader { inner = inner, held = [0u8] * bufferSize };
    }

    pub mut fn read(into: Slice<uint8>): int throws IoError {
        if (into.isEmpty()) {
            return 0;
        }
        if (this.start == this.end) {
            if (into.length() >= this.held.length()) {
                return try this.inner.read(into);
            }
            if (try this.more() == 0) {
                return 0;
            }
        }
        let held = this.end - this.start;
        let n = if (into.length() < held) into.length() else held;
        this.held[this.start..this.start + n].copyInto(into);
        this.start = this.start + n;
        return n;
    }

    /// One read of the inner reader into the room after what is held, which moves to the front
    /// first; answers how many bytes came — 0 at the end.
    mut fn more(): int throws IoError {
        if (this.start > 0) {
            this.held[this.start..this.end].copyInto(this.held[..]);
            this.end = this.end - this.start;
            this.start = 0;
        }
        let n = try this.inner.read(this.held[this.end..]);
        this.end = this.end + n;
        return n;
    }

    /// Whether `n` bytes are held — a few, for a codepoint or a BOM —, reading for them while the
    /// inner reader has some.
    mut fn hold(n: int): bool throws IoError {
        while (this.end - this.start < n) {
            if (try this.more() == 0) {
                return false;
            }
        }
        return true;
    }
}

/// A `Writer` with a buffer of its own (10 O2): what it is handed waits there until 8 KiB are
/// together, a `flush()` or a `close()`. A write at least as large as the buffer goes to the inner
/// writer directly. It is `Closeable`, and one nothing closes is warned about (R3): its last bytes
/// would stay in the buffer. Closing flushes and leaves the inner writer open — it is the caller's
/// (`using let f = …; using let w = BufWriter.new(f);` closes `w` first).
pub class BufWriter<W :: [Writer]> :: [Writer, Closeable] {
    var inner: W,
    held: uint8[],
    var used: int = 0,
    var sent: int = 0,

    pub static fn new(inner: W): BufWriter<W> {
        return BufWriter { inner = inner, held = [0u8] * bufferSize };
    }

    pub mut fn write(from: Slice<uint8>): int throws IoError {
        if (this.used + from.length() > this.held.length()) {
            try this.handOn();
        }
        if (from.length() >= this.held.length()) {
            return try this.inner.write(from);
        }
        from.copyInto(this.held[this.used..]);
        this.used = this.used + from.length();
        return from.length();
    }

    /// Writes what is held, then flushes the inner writer.
    pub mut fn flush(): void throws IoError {
        try this.handOn();
        try this.inner.flush();
    }

    /// `flush()`.
    pub fn close(): void throws IoError {
        // through the reference: 'Closeable.close' is no 'mut fn' (as Pool's close)
        let me = this;
        try me.flush();
    }

    /// Writes what is held. A write that throws leaves what it did not take held, for the next.
    mut fn handOn(): void throws IoError {
        while (this.sent < this.used) {
            let n = try this.inner.write(this.held[this.sent..this.used]);
            if (n == 0) {
                throw IoError { kind = .Other { code = 0 }, detail = f"the writer took none of {this.used - this.sent} bytes" };
            }
            this.sent = this.sent + n;
        }
        this.sent = 0;
        this.used = 0;
    }
}

/// A reader of UTF-8 text (10 O2): a `BufReader` and a decoder. A codepoint split between two reads
/// of the inner reader waits in the buffer for its rest; bytes that are no UTF-8 throw
/// `InvalidData`, a `Utf8Error` as the cause with the offset counted from the reader's start. A
/// byte order mark is text like any other, unless `skipBom` drops it from the front.
pub class TextReader<R :: [Reader]> {
    source: BufReader<R>,
    var bom: bool,
    var taken: int = 0,

    pub static fn new(inner: R, skipBom: bool = false): TextReader<R> {
        return TextReader { source = BufReader.new(inner), bom = skipBom };
    }

    /// The next line without its end — a `\n` or a `\r\n` —, or `null` at the end. A last line
    /// without an end is a line; the end of the last one starts none.
    pub mut fn readLine(): ?string throws IoError {
        try this.dropBom();
        let s = this.source;
        var line: ?ByteBuffer = null;
        loop {
            if (s.start == s.end && try s.more() == 0) {
                if (let l = line) {
                    return try this.text(l.toArray()[..], 0);
                }
                return null;
            }
            let held = s.held[s.start..s.end];
            if (let i = held.indexOf(10u8)) {
                s.start = s.start + i + 1;
                if (let l = line) {
                    l.append(held[..i]);
                    return try this.text(l.toArray()[..], 1);
                }
                return try this.text(held[..i], 1);
            }
            let l = line ?? ByteBuffer.new();
            l.append(held);
            line = l;
            s.start = s.end;
        }
    }

    /// The lines to the end, as `readLine` gives them.
    pub fn lines(): TextLinesIter<R> {
        return TextLinesIter { reader = this };
    }

    /// The characters to the end, one codepoint at a time.
    pub fn chars(): TextCharsIter<R> {
        return TextCharsIter { reader = this };
    }

    /// Everything to the end, as text.
    pub mut fn readToEnd(): string throws IoError {
        try this.dropBom();
        let bytes = try this.source.readToEnd();
        return try this.text(bytes[..], 0);
    }

    /// The next codepoint, or `null` at the end.
    mut fn readChar(): ?char throws IoError {
        try this.dropBom();
        let s = this.source;
        if (!(try s.hold(1))) {
            return null;
        }
        let lead = s.held[s.start] as int;
        let size = if (lead < 0x80) 1 else if (lead < 0xC0) 0 else if (lead < 0xE0) 2 else if (lead < 0xF0) 3 else if (lead < 0xF8) 4 else 0;
        if (size == 0 || !(try s.hold(size))) {
            throw invalidAt(this.taken);
        }
        var code = if (size == 1) lead else lead & (0x7F >> size);
        var k = 1;
        while (k < size) {
            let b = s.held[s.start + k] as int;
            if ((b & 0xC0) != 0x80) {
                throw invalidAt(this.taken);
            }
            code = (code << 6) | (b & 0x3F);
            k = k + 1;
        }
        // the shortest form only: two bytes from 0x80, three from 0x800, four from 0x10000
        let least = if (size == 2) 0x80 else if (size == 3) 0x800 else if (size == 4) 0x10000 else 0;
        let c = if (code < least) null else char.fromUint32(code as uint32);
        if (c == null) {
            throw invalidAt(this.taken);
        }
        s.start = s.start + size;
        this.taken = this.taken + size;
        return c;
    }

    /// The bytes of a line as text, a `\r` before its end dropped; `ends` bytes of the end follow
    /// them in the stream.
    mut fn text(bytes: Slice<uint8>, ends: int): string throws IoError {
        let at = this.taken;
        this.taken = at + bytes.length() + ends;
        var n = bytes.length();
        if (ends > 0 && n > 0 && bytes[n - 1] == 13u8) {
            n = n - 1;
        }
        return try string.fromUtf8(bytes[..n]) catch (e: Utf8Error) throw invalidAt(at + e.offset);
    }

    /// Drops a byte order mark from the front, once, where `skipBom` asked for it.
    mut fn dropBom(): void throws IoError {
        if (!this.bom) {
            return;
        }
        this.bom = false;
        let s = this.source;
        if (try s.hold(3)) {
            if (s.held[s.start] == 0xEFu8 && s.held[s.start + 1] == 0xBBu8 && s.held[s.start + 2] == 0xBFu8) {
                s.start = s.start + 3;
                this.taken = 3;
            }
        }
    }
}

/// `InvalidData` for bytes that are no UTF-8 from `offset` on.
fn invalidAt(offset: int): IoError {
    return IoError { kind = .InvalidData, detail = "the bytes are no UTF-8", inner = Utf8Error { offset = offset } };
}

/// A `TextReader`'s lines (10 O2).
pub struct TextLinesIter<R :: [Reader]> :: [Iterator] {
    type Item = string;
    type Error = IoError;
    reader: TextReader<R>,

    pub mut fn next(): ?string throws IoError {
        return try this.reader.readLine();
    }
}

/// A `TextReader`'s characters (10 O2).
pub struct TextCharsIter<R :: [Reader]> :: [Iterator] {
    type Item = char;
    type Error = IoError;
    reader: TextReader<R>,

    pub mut fn next(): ?char throws IoError {
        return try this.reader.readChar();
    }
}

/// A writer of text (10 O2): its UTF-8, to the inner writer as it comes. It holds nothing back; a
/// `BufWriter` beneath it does, and is closed by its own name: `using let b = BufWriter.new(f);
/// let t = TextWriter.new(b);`.
pub class TextWriter<W :: [Writer]> {
    var inner: W,

    pub static fn new(inner: W): TextWriter<W> {
        return TextWriter { inner = inner };
    }

    pub mut fn write(s: StringView): void throws IoError {
        try this.inner.writeString(s);
    }

    /// `s`, then a `\n` — on every system.
    pub mut fn writeLine(s: StringView): void throws IoError {
        try this.inner.writeString(s);
        try this.inner.writeString("\n");
    }
}
