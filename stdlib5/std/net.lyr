//! The network: IP addresses ([IpAddr]) and socket addresses ([SocketAddr]), TCP — a
//! [TcpListener] that accepts, a [TcpStream] that is a `Reader` and a `Writer` —, UDP
//! ([UdpSocket]), and name resolution ([resolve]).
//!
//! A call that would block parks the task until the thread's poller says the socket is ready, then
//! tries again; a cancel ends that wait with `Cancelled`, and a close — on any thread — with
//! `Closed`. There are no socket timeouts: `withTimeout` bounds a call instead. On POSIX the sockets
//! are polled with epoll or kqueue; on Windows they use Winsock, with an AFD poll request per
//! socket on the thread's completion port.
//!
//! # Examples
//!
//! ```lyric,no_run
//! import std.net { TcpListener, SocketAddr };
//!
//! fn main(): void throws Error {
//!     let listener = try TcpListener.bind(SocketAddr.parse("127.0.0.1:8080"));
//!     let stream = try listener.accept();
//!     try stream.write("hello\n".toBytes());
//!     try stream.close();
//! }
//! ```
import std.collections { List };
import std.core { Parse, ParseError, StringBuilder, viewBytes, sliceAddress };
import std.io { IoError, Reader, Writer, failure, onPool };
import std.task { Cancelled, Waits, awaitDescriptor, forgetDescriptor };

extern "C" fn netSocket(family: int, kind: int): int = "lyr_net_socket";

inline fn netBind(fd: int, family: int, address: Slice<uint8>, port: int, reuse: int): int {
    return netBindRaw(fd, family, sliceAddress(address), port, reuse);
}

extern "C" fn netBindRaw(
    fd: int,
    family: int,
    addressAt: uint,
    port: int,
    reuse: int
): int = "lyr_net_bind";
extern "C" fn netListen(fd: int, backlog: int): int = "lyr_net_listen";
extern "C" fn netAccept(fd: int): int = "lyr_net_accept";

inline fn netConnect(fd: int, family: int, address: Slice<uint8>, port: int): int {
    return netConnectRaw(fd, family, sliceAddress(address), port);
}

extern "C" fn netConnectRaw(
    fd: int,
    family: int,
    addressAt: uint,
    port: int
): int = "lyr_net_connect";
extern "C" fn netConnected(fd: int): int = "lyr_net_connected";

inline fn netRecv(fd: int, into: Slice<uint8>): int {
    return netRecvRaw(fd, sliceAddress(into), into.length());
}

extern "C" fn netRecvRaw(fd: int, intoAt: uint, intoLength: int): int = "lyr_net_recv";

inline fn netSend(fd: int, from: Slice<uint8>): int {
    return netSendRaw(fd, sliceAddress(from), from.length());
}

extern "C" fn netSendRaw(fd: int, fromAt: uint, fromLength: int): int = "lyr_net_send";
extern "C" fn netShutdown(fd: int, how: int): int = "lyr_net_shutdown";
extern "C" fn netSetNoDelay(fd: int, on: int): int = "lyr_net_set_nodelay";

inline fn netName(fd: int, peer: int, into: Slice<uint8>): int {
    return netNameRaw(fd, peer, sliceAddress(into), into.length());
}

extern "C" fn netNameRaw(fd: int, peer: int, intoAt: uint, intoLength: int): int = "lyr_net_name";
extern "C" fn netClose(fd: int): int = "lyr_net_close";

inline fn netSendTo(
    fd: int,
    from: Slice<uint8>,
    family: int,
    address: Slice<uint8>,
    port: int
): int {
    return netSendToRaw(fd, sliceAddress(from), from.length(), family, sliceAddress(address), port);
}

extern "C" fn netSendToRaw(
    fd: int,
    fromAt: uint,
    fromLength: int,
    family: int,
    addressAt: uint,
    port: int
): int = "lyr_net_sendto";

inline fn netRecvFrom(fd: int, into: Slice<uint8>, sender: Slice<uint8>): int {
    return netRecvFromRaw(
        fd,
        sliceAddress(into),
        into.length(),
        sliceAddress(sender),
        sender.length()
    );
}

extern "C" fn netRecvFromRaw(
    fd: int,
    intoAt: uint,
    intoLength: int,
    senderAt: uint,
    senderLength: int
): int = "lyr_net_recvfrom";

inline fn netResolve(host: string, into: Slice<uint8>): int {
    return netResolveRaw(host, sliceAddress(into), into.length());
}

extern "C" fn netResolveRaw(host: string, intoAt: uint, intoLength: int): int = "lyr_net_resolve";

/// The answer of a call that would block (lyr/net.h).
let wouldBlock = -(64 << 32);

/// How many connections a listener keeps waiting for `accept`.
let backlog = 128;

// ---------------------------------------------------------------------------------------------
// The addresses.
// ---------------------------------------------------------------------------------------------

/// An IP address: version 4's four bytes, or version 6's eight groups of 16 bits.
pub enum IpAddr :: [Equatable, Debug] {
    V4(uint8, uint8, uint8, uint8),
    V6(uint16, uint16, uint16, uint16, uint16, uint16, uint16, uint16),
}

extend IpAddr :: [Display] {
    /// Returns version 4 dotted, `192.0.2.1`; version 6 as RFC 5952 writes it — lower case, no
    /// leading zero in a group, the longest run of two or more zero groups (the first of equals)
    /// as `::`, and an IPv4-mapped address with its dotted tail, `::ffff:192.0.2.1`.
    fn show(): string {
        return match (this) {
            .V4(a, b, c, d) => f"{a}.{b}.{c}.{d}",
            .V6(g0, g1, g2, g3, g4, g5, g6, g7) => v6Text([g0, g1, g2, g3, g4, g5, g6, g7]),
        };
    }
}

extend IpAddr :: [Parse] {
    /// Parses version 4 dotted — four decimal bytes, none with a leading zero, so nothing is read
    /// as octal (RFC 6943 §3.1.1) —, or version 6 in the forms of RFC 4291 §2.2: groups of one to
    /// four hex digits, `::` once for one or more zero groups, an IPv4 tail in the last 32 bits.
    /// A zone (`%eth0`) is not accepted.
    ///
    /// # Errors
    /// Throws [ParseError]: `Empty` for empty text, `Invalid` for anything that is neither form.
    static fn parse(s: StringView): IpAddr throws ParseError {
        let text = viewBytes(s);
        if (text.isEmpty()) {
            throw ParseError { kind = .Empty };
        }
        if (let v4 = v4Of(text)) {
            return IpAddr.V4(v4[0], v4[1], v4[2], v4[3]);
        }
        if (let g = v6Of(text)) {
            return IpAddr.V6(g[0], g[1], g[2], g[3], g[4], g[5], g[6], g[7]);
        }
        throw ParseError {
            kind = .Invalid,
            detail = "neither an IPv4 address (four decimal octets) nor an IPv6 one (RFC 4291 section 2.2)",
            offset = 0,
        };
    }
}

/// An IP address and a port.
pub struct SocketAddr :: [Equatable, Debug] {
    pub ip: IpAddr,
    pub port: uint16,
}

extend SocketAddr :: [Display] {
    /// Returns `192.0.2.1:8080`; a version 6 address in brackets, `[::1]:8080` (RFC 3986).
    fn show(): string {
        return match (this.ip) {
            .V4(_, _, _, _) => f"{this.ip}:{this.port}",
            .V6(_, _, _, _, _, _, _, _) => f"[{this.ip}]:{this.port}",
        };
    }
}

extend SocketAddr :: [Parse] {
    /// Parses `192.0.2.1:8080` or `[2001:db8::1]:8080`: the address as [IpAddr.parse] takes it —
    /// a version 6 address in brackets, a version 4 one without —, then a decimal port up to
    /// 65535.
    ///
    /// # Errors
    /// Throws [ParseError]: `Empty` for empty text, `Invalid` for a missing or bad port, an
    /// unclosed bracket, or an address that is not of the right form.
    static fn parse(s: StringView): SocketAddr throws ParseError {
        let text = viewBytes(s);
        if (text.isEmpty()) {
            throw ParseError { kind = .Empty };
        }
        var colon = text.length() - 1;
        while (colon >= 0 && text[colon] != 58u8) {
            colon -= 1;
        }
        if (colon <= 0) {
            throw ParseError {
                kind = .Invalid,
                detail = "an address and a port, separated by ':'",
                offset = 0,
            };
        }
        let port = portOf(text[colon + 1..]);
        if (port == null) {
            throw ParseError {
                kind = .Invalid,
                detail = "the port is digits up to 65535",
                offset = colon + 1,
            };
        }
        var host = text[..colon];
        let bracketed = host[0] == 91u8;
        if (bracketed) {
            if (host.length() < 2 || host[host.length() - 1] != 93u8) {
                throw ParseError { kind = .Invalid, detail = "an '[' without its ']'", offset = 0 };
            }
            host = host[1..host.length() - 1];
        }
        if (let v4 = v4Of(host)) {
            if (bracketed) {
                throw ParseError {
                    kind = .Invalid,
                    detail = "brackets hold an IPv6 address, not an IPv4 one",
                    offset = 0,
                };
            }
            return SocketAddr { ip = IpAddr.V4(v4[0], v4[1], v4[2], v4[3]), port = port };
        }
        if (bracketed) {
            if (let g = v6Of(host)) {
                return SocketAddr {
                    ip = IpAddr.V6(g[0], g[1], g[2], g[3], g[4], g[5], g[6], g[7]),
                    port = port,
                };
            }
        }
        throw ParseError { kind = .Invalid };
    }
}

/// Returns the four bytes of a dotted version 4 address, or null where `text` is none.
fn v4Of(text: Slice<uint8>): ?uint8[] {
    let bytes: uint8[] = [0u8] * 4;
    var part = 0;
    var value = 0;
    var digits = 0;
    var leadingZero = false;
    for (b in text) {
        if (b == 46u8) {
            if (digits == 0 || part == 3) {
                return null;
            }
            bytes[part] = value as uint8;
            part += 1;
            value = 0;
            digits = 0;
            leadingZero = false;
        } else if (b >= 48u8 && b <= 57u8) {
            if (leadingZero || digits == 3) {
                return null;
            }
            if (digits == 0 && b == 48u8) {
                leadingZero = true;
            }
            value = value * 10 + (b as int - 48);
            digits += 1;
            if (value > 255) {
                return null;
            }
        } else {
            return null;
        }
    }
    if (part != 3 || digits == 0) {
        return null;
    }
    bytes[3] = value as uint8;
    return bytes;
}

/// Returns the eight groups of a version 6 address, or null where `text` is none.
fn v6Of(text: Slice<uint8>): ?uint16[] {
    let groups: uint16[] = [0u16] * 8;
    let n = text.length();
    var count = 0;
    var gap = -1;
    var i = 0;
    if (n >= 2 && text[0] == 58u8 && text[1] == 58u8) {
        gap = 0;
        i = 2;
    } else if (n >= 1 && text[0] == 58u8) {
        return null;
    }
    while (i < n) {
        if (count == 8) {
            return null;
        }
        var end = i;
        var dotted = false;
        while (end < n && text[end] != 58u8) {
            if (text[end] == 46u8) {
                dotted = true;
            }
            end += 1;
        }
        if (dotted) {
            // an IPv4 tail: the last 32 bits, nothing after it
            if (end != n || count > 6) {
                return null;
            }
            let tail = v4Of(text[i..end]);
            if (tail == null) {
                return null;
            }
            let v4 = tail;
            groups[count] = ((v4[0] as int) * 256 + (v4[1] as int)) as uint16;
            groups[count + 1] = ((v4[2] as int) * 256 + (v4[3] as int)) as uint16;
            count += 2;
            i = n;
        } else {
            let g = hexGroup(text[i..end]);
            if (g == null) {
                return null;
            }
            groups[count] = g;
            count += 1;
            i = end;
            if (i < n) {
                i += 1;
                if (i == n) {
                    return null;
                }
                if (text[i] == 58u8) {
                    if (gap >= 0) {
                        return null;
                    }
                    gap = count;
                    i += 1;
                }
            }
        }
    }
    if (gap < 0) {
        return if (count == 8) groups else null;
    }
    // `::` stands for one zero group at least: the groups after it move to the end
    if (count == 8) {
        return null;
    }
    let after = count - gap;
    var k = 0;
    while (k < after) {
        groups[7 - k] = groups[count - 1 - k];
        k += 1;
    }
    var z = gap;
    while (z < 8 - after) {
        groups[z] = 0u16;
        z += 1;
    }
    return groups;
}

/// Returns one to four hex digits as a group, or null.
fn hexGroup(text: Slice<uint8>): ?uint16 {
    if (text.isEmpty() || text.length() > 4) {
        return null;
    }
    var value = 0;
    for (b in text) {
        let digit = if (b >= 48u8 && b <= 57u8) b as int - 48
            else if (b >= 97u8 && b <= 102u8) b as int - 87
                else if (b >= 65u8 && b <= 70u8) b as int - 55 else -1;
        if (digit < 0) {
            return null;
        }
        value = value * 16 + digit;
    }
    return value as uint16;
}

/// Returns a decimal port, 0 to 65535, with no sign and no leading zero; or null.
fn portOf(text: Slice<uint8>): ?uint16 {
    if (text.isEmpty() || text.length() > 5 || (text.length() > 1 && text[0] == 48u8)) {
        return null;
    }
    var value = 0;
    for (b in text) {
        if (b < 48u8 || b > 57u8) {
            return null;
        }
        value = value * 10 + (b as int - 48);
    }
    return if (value > 65535) null else value as uint16;
}

/// Returns the text of a version 6 address (RFC 5952).
fn v6Text(g: uint16[]): string {
    if (g[0] == 0u16
        && g[1] == 0u16
        && g[2] == 0u16
        && g[3] == 0u16
        && g[4] == 0u16
        && g[5] == 65535u16) {
        let high = g[6] as int;
        let low = g[7] as int;
        let tail = IpAddr.V4(
            (high / 256) as uint8,
            (high % 256) as uint8,
            (low / 256) as uint8,
            (low % 256) as uint8
        );
        return f"::ffff:{tail}";
    }
    // the longest run of zero groups, two at least, the first of equals
    var best = -1;
    var bestLength = 1;
    var at = 0;
    while (at < 8) {
        if (g[at] == 0u16) {
            var end = at;
            while (end < 8 && g[end] == 0u16) {
                end += 1;
            }
            if (end - at > bestLength) {
                best = at;
                bestLength = end - at;
            }
            at = end;
        } else {
            at += 1;
        }
    }
    let out = StringBuilder.new();
    var i = 0;
    while (i < 8) {
        if (i == best) {
            out.appendStr("::");
            i += bestLength;
        } else {
            if (i > 0 && i != best + bestLength) {
                out.appendStr(":");
            }
            out.appendStr(hexText(g[i]));
            i += 1;
        }
    }
    return out.toString();
}

/// Returns a group in lower-case hex, with no leading zero.
fn hexText(v: uint16): string {
    let digits = "0123456789abcdef";
    let bytes = viewBytes(digits);
    let out = StringBuilder.new();
    var started = false;
    var shift = 12;
    while (shift >= 0) {
        let d = ((v as int) >> shift) & 15;
        if (d != 0 || started || shift == 0) {
            out.appendChar(char.fromUint32(bytes[d] as uint32)!);
            started = true;
        }
        shift -= 4;
    }
    return out.toString();
}

/// Returns the family of an address as it crosses to the runtime (lyr/net.h): 4 or 6.
fn familyOf(ip: IpAddr): int {
    return match (ip) {
        .V4(_, _, _, _) => 4,
        .V6(_, _, _, _, _, _, _, _) => 6,
    };
}

/// Returns the 16 bytes of an address as it crosses to the runtime; version 4 in the first four.
fn bytesOf(ip: IpAddr): uint8[] {
    let bytes: uint8[] = [0u8] * 16;
    match (ip) {
        .V4(a, b, c, d) => {
            bytes[0] = a;
            bytes[1] = b;
            bytes[2] = c;
            bytes[3] = d;
        }
        .V6(g0, g1, g2, g3, g4, g5, g6, g7) => {
            let groups = [g0, g1, g2, g3, g4, g5, g6, g7];
            var k = 0;
            while (k < 8) {
                let group = groups[k] as int;
                bytes[2 * k] = (group / 256) as uint8;
                bytes[2 * k + 1] = (group % 256) as uint8;
                k += 1;
            }
        }
    }
    return bytes;
}

/// Returns the address the runtime wrote (lyr/net.h: family, port high and low, 16 bytes).
fn addressFrom(b: Slice<uint8>): SocketAddr {
    let port = ((b[1] as int) * 256 + (b[2] as int)) as uint16;
    if (b[0] == 4u8) {
        return SocketAddr { ip = IpAddr.V4(b[3], b[4], b[5], b[6]), port = port };
    }
    let groups: uint16[] = [0u16] * 8;
    var k = 0;
    while (k < 8) {
        groups[k] = ((b[3 + 2 * k] as int) * 256 + (b[4 + 2 * k] as int)) as uint16;
        k += 1;
    }
    return SocketAddr {
        ip = IpAddr.V6(
            groups[0],
            groups[1],
            groups[2],
            groups[3],
            groups[4],
            groups[5],
            groups[6],
            groups[7]
        ),
        port = port,
    };
}

// ---------------------------------------------------------------------------------------------
// TCP: handles are classes with a closed state; every call after `close()` throws `Closed`, and a
// second `close()` does nothing.
// ---------------------------------------------------------------------------------------------

/// Returns the [IoError] for a failed runtime call, about `addr` where there is one: its path is
/// the address's text.
fn netFailure(answer: int, addr: ?SocketAddr, doing: string): IoError {
    var path: ?string = null;
    if (let a = addr) {
        path = a.show();
    }
    return failure(answer, path, doing);
}

/// Makes the running task wait until `fd` is ready as `interest` says (1 to read, 2 to write), in
/// the socket's `waits` — so a close on any thread ends the wait.
fn waitFor(fd: int, interest: int, waits: Waits, doing: string): void throws [IoError, Cancelled] {
    let armed = try awaitDescriptor(fd, interest, waits);
    if (armed < 0) {
        throw failure(armed, null, doing);
    }
}

/// Returns a new socket for `addr`'s family.
fn socketFor(addr: SocketAddr, kind: int, doing: string): int throws IoError {
    let fd = netSocket(familyOf(addr.ip), kind);
    if (fd < 0) {
        throw netFailure(fd, addr, doing);
    }
    return fd;
}

/// A listening TCP socket: `bind` creates it, `accept` returns each incoming connection as a
/// [TcpStream].
pub class TcpListener :: [Closeable] {
    fd: int,
    var closed: bool = false,
    waits: Waits = Waits { },

    /// Returns a listener on `addr`; port 0 asks the system for a free one, which `localAddr`
    /// reports. A port that a closed listener's connections still hold (TIME_WAIT) is taken all the
    /// same.
    ///
    /// # Errors
    /// Throws [IoError] with the address when the socket cannot be created, bound or set
    /// listening, such as `AddrInUse`.
    pub static fn bind(addr: SocketAddr): TcpListener throws IoError {
        let fd = try socketFor(addr, 1, "bound");
        let bytes = bytesOf(addr.ip);
        var answer = netBind(fd, familyOf(addr.ip), bytes[..], addr.port as int, 1);
        if (answer == 0) {
            answer = netListen(fd, backlog);
        }
        if (answer < 0) {
            let _ = netClose(fd);
            throw netFailure(answer, addr, "bound");
        }
        return TcpListener { fd = fd };
    }

    /// Returns the next connection, waiting until one comes.
    ///
    /// # Errors
    /// Throws [IoError] — `Closed` once the listener is closed —, and [Cancelled] when the waiting
    /// task is cancelled.
    pub mut fn accept(): TcpStream throws [IoError, Cancelled] {
        loop {
            try this.stillOpen("accepted");
            let fd = netAccept(this.fd);
            if (fd >= 0) {
                return TcpStream { fd = fd };
            }
            if (fd != wouldBlock) {
                throw failure(fd, null, "accepted");
            }
            try waitFor(this.fd, 1, this.waits, "accepted");
        }
    }

    /// Returns the address it listens on — with the port the system chose, where `bind` asked
    /// for 0.
    ///
    /// # Errors
    /// Throws [IoError]: `Closed` after `close()`, else the system's failure.
    pub fn localAddr(): SocketAddr throws IoError {
        try this.stillOpen("asked its address");
        return try nameOf(this.fd, 0);
    }

    /// Closes the socket; a task that waits in `accept` throws `Closed`. A second close does
    /// nothing.
    ///
    /// # Errors
    /// Throws [IoError] when the system fails to close it.
    pub fn close(): void throws IoError {
        let me = this;
        if (me.closed) {
            return;
        }
        me.closed = true;
        try closeSocket(me.fd, me.waits);
    }

    fn stillOpen(doing: string): void throws IoError {
        if (this.closed) {
            throw IoError { kind = .Closed, detail = doing };
        }
    }
}

/// How much of a stream [TcpStream.shutdown] ends: its reading, its writing, or both.
pub enum Shutdown :: [Equatable, Debug] {
    Read,
    Write,
    Both,
}

/// A TCP connection: a `Reader` and a `Writer` whose calls wait for the socket — a read until
/// bytes come, a write until the system takes some.
pub class TcpStream :: [Reader, Writer, Closeable] {
    fd: int,
    var closed: bool = false,
    waits: Waits = Waits { },

    /// Opens a connection to `addr`, waiting until it is made or refused.
    ///
    /// # Errors
    /// Throws [IoError] with the address when the connection fails, such as `ConnectionRefused`,
    /// and [Cancelled] when the waiting task is cancelled.
    pub static fn connect(addr: SocketAddr): TcpStream throws [IoError, Cancelled] {
        let fd = try socketFor(addr, 1, "connected");
        let bytes = bytesOf(addr.ip);
        let started = netConnect(fd, familyOf(addr.ip), bytes[..], addr.port as int);
        let waits = Waits { };
        var answer = started;
        if (started == wouldBlock) {
            try {
                waitFor(fd, 2, waits, "connected");
            } catch (e: IoError) {
                let _ = netClose(fd);
                throw e;
            } catch (e: Cancelled) {
                forgetDescriptor(fd);
                let _ = netClose(fd);
                throw e;
            }
            answer = netConnected(fd);
        }
        if (answer < 0) {
            forgetDescriptor(fd);
            let _ = netClose(fd);
            throw netFailure(answer, addr, "connected");
        }
        return TcpStream { fd = fd, waits = waits };
    }

    /// Reads bytes from the connection into `into`, waiting until some come, and returns how many;
    /// 0 once the peer has ended its writing.
    ///
    /// # Errors
    /// Throws [IoError] — `Closed` after `close()` —, and [Cancelled] when the waiting task is
    /// cancelled.
    pub mut fn read(into: Slice<uint8>): int throws [IoError, Cancelled] {
        loop {
            try this.stillOpen("read");
            if (into.isEmpty()) {
                return 0;
            }
            let n = netRecv(this.fd, into);
            if (n >= 0) {
                return n;
            }
            if (n != wouldBlock) {
                throw failure(n, null, "read");
            }
            try waitFor(this.fd, 1, this.waits, "read");
        }
    }

    /// Writes bytes from `from` into the connection, waiting until the system takes some, and
    /// returns how many — possibly fewer than `from` holds (`writeAll` writes the rest).
    ///
    /// # Errors
    /// Throws [IoError] — `Closed` after `close()`, `BrokenPipe` for a peer that is gone —, and
    /// [Cancelled] when the waiting task is cancelled.
    pub mut fn write(from: Slice<uint8>): int throws [IoError, Cancelled] {
        loop {
            try this.stillOpen("written");
            if (from.isEmpty()) {
                return 0;
            }
            let n = netSend(this.fd, from);
            if (n >= 0) {
                return n;
            }
            if (n != wouldBlock) {
                throw failure(n, null, "written");
            }
            try waitFor(this.fd, 2, this.waits, "written");
        }
    }

    /// Ends the reading, the writing or both: a peer reading sees the end once the writing is shut.
    ///
    /// # Errors
    /// Throws [IoError]: `Closed` after `close()`, else the system's failure.
    pub fn shutdown(how: Shutdown): void throws IoError {
        try this.stillOpen("shut down");
        let which = match (how) {
            .Read => 0,
            .Write => 1,
            .Both => 2,
        };
        let answer = netShutdown(this.fd, which);
        if (answer < 0) {
            throw failure(answer, null, "shut down");
        }
    }

    /// Turns Nagle's algorithm off when `on` — each small write goes out at once — or on again.
    ///
    /// # Errors
    /// Throws [IoError]: `Closed` after `close()`, else the system's failure.
    pub fn setNoDelay(on: bool): void throws IoError {
        try this.stillOpen("set");
        let answer = netSetNoDelay(this.fd, if (on) 1 else 0);
        if (answer < 0) {
            throw failure(answer, null, "set");
        }
    }

    /// Returns the address of the connection's other end.
    ///
    /// # Errors
    /// Throws [IoError]: `Closed` after `close()`, else the system's failure.
    pub fn peerAddr(): SocketAddr throws IoError {
        try this.stillOpen("asked its address");
        return try nameOf(this.fd, 1);
    }

    /// Returns the address of this end.
    ///
    /// # Errors
    /// Throws [IoError]: `Closed` after `close()`, else the system's failure.
    pub fn localAddr(): SocketAddr throws IoError {
        try this.stillOpen("asked its address");
        return try nameOf(this.fd, 0);
    }

    /// Closes the connection; a task that waits in a read or a write throws `Closed`. A second
    /// close does nothing.
    ///
    /// # Errors
    /// Throws [IoError] when the system fails to close it.
    pub fn close(): void throws IoError {
        let me = this;
        if (me.closed) {
            return;
        }
        me.closed = true;
        try closeSocket(me.fd, me.waits);
    }

    fn stillOpen(doing: string): void throws IoError {
        if (this.closed) {
            throw IoError { kind = .Closed, detail = doing };
        }
    }
}

/// Returns the socket's own address, or its peer's where `peer` is 1.
fn nameOf(fd: int, peer: int): SocketAddr throws IoError {
    let into: uint8[] = [0u8] * 19;
    let n = netName(fd, peer, into[..]);
    if (n < 0) {
        throw failure(n, null, "asked its address");
    }
    return addressFrom(into[..]);
}

/// Wakes the socket's waiters on whatever thread they wait — they find it closed —, removes the
/// socket from this thread's poller, and closes it.
fn closeSocket(fd: int, waits: Waits): void throws IoError {
    let w = waits;
    w.close();
    forgetDescriptor(fd);
    let answer = netClose(fd);
    if (answer < 0) {
        throw failure(answer, null, "closed");
    }
}

// ---------------------------------------------------------------------------------------------
// UDP and the resolver.
// ---------------------------------------------------------------------------------------------

/// A UDP socket: datagrams sent to an address, and received with their sender's.
pub class UdpSocket :: [Closeable] {
    fd: int,
    var closed: bool = false,
    waits: Waits = Waits { },

    /// Returns a socket bound to `addr`; port 0 asks the system for a free one, which `localAddr`
    /// reports.
    ///
    /// # Errors
    /// Throws [IoError] with the address when the socket cannot be created or bound.
    pub static fn bind(addr: SocketAddr): UdpSocket throws IoError {
        let fd = try socketFor(addr, 2, "bound");
        let bytes = bytesOf(addr.ip);
        let answer = netBind(fd, familyOf(addr.ip), bytes[..], addr.port as int, 0);
        if (answer < 0) {
            let _ = netClose(fd);
            throw netFailure(answer, addr, "bound");
        }
        return UdpSocket { fd = fd };
    }

    /// Sends `from` as one datagram to `addr`, waiting until the system takes it, and returns how
    /// many bytes went — all of them, since a datagram goes whole or not at all.
    ///
    /// # Errors
    /// Throws [IoError] — `Closed` after `close()`, else the system's failure with the address —,
    /// and [Cancelled] when the waiting task is cancelled.
    pub mut fn sendTo(from: Slice<uint8>, addr: SocketAddr): int throws [IoError, Cancelled] {
        let bytes = bytesOf(addr.ip);
        loop {
            try this.stillOpen("sent");
            let n = netSendTo(this.fd, from, familyOf(addr.ip), bytes[..], addr.port as int);
            if (n >= 0) {
                return n;
            }
            if (n != wouldBlock) {
                throw netFailure(n, addr, "sent");
            }
            try waitFor(this.fd, 2, this.waits, "sent");
        }
    }

    /// Receives the next datagram, waiting until one comes, and returns how many of its bytes went
    /// into `into` — the rest of a longer one is lost — and who sent it.
    ///
    /// # Errors
    /// Throws [IoError] — `Closed` after `close()` —, and [Cancelled] when the waiting task is
    /// cancelled.
    pub mut fn recvFrom(into: Slice<uint8>): (int, SocketAddr) throws [IoError, Cancelled] {
        let sender: uint8[] = [0u8] * 19;
        loop {
            try this.stillOpen("received");
            let n = netRecvFrom(this.fd, into, sender[..]);
            if (n >= 0) {
                return (n, addressFrom(sender[..]));
            }
            if (n != wouldBlock) {
                throw failure(n, null, "received");
            }
            try waitFor(this.fd, 1, this.waits, "received");
        }
    }

    /// Returns the address it is bound to — with the port the system chose, where `bind` asked
    /// for 0.
    ///
    /// # Errors
    /// Throws [IoError]: `Closed` after `close()`, else the system's failure.
    pub fn localAddr(): SocketAddr throws IoError {
        try this.stillOpen("asked its address");
        return try nameOf(this.fd, 0);
    }

    /// Closes the socket; a task that waits in one of its calls throws `Closed`. A second close
    /// does nothing.
    ///
    /// # Errors
    /// Throws [IoError] when the system fails to close it.
    pub fn close(): void throws IoError {
        let me = this;
        if (me.closed) {
            return;
        }
        me.closed = true;
        try closeSocket(me.fd, me.waits);
    }

    fn stillOpen(doing: string): void throws IoError {
        if (this.closed) {
            throw IoError { kind = .Closed, detail = doing };
        }
    }
}

/// Returns the addresses `host` names: a name the system's resolver knows — `localhost`,
/// `example.org` — or an address's own text; each address once, in the resolver's order. It runs
/// on the I/O pool, as a file's call does, so it is not a point of cancellation: a cancel shows at
/// the task's next wait.
///
/// # Errors
/// Throws [IoError] with the name as the path: `NotFound` for a name nobody knows, else the
/// resolver's failure.
pub fn resolve(host: StringView): List<IpAddr> throws IoError {
    let name = host.toString();
    var room = 8;
    loop {
        let into: uint8[] = [0u8] * (room * 17);
        let n = onPool(() => netResolve(name, into[..]));
        if (n < 0) {
            throw failure(n, name, "resolved");
        }
        if (n <= room) {
            let found = List<IpAddr>.new();
            var k = 0;
            while (k < n) {
                let e = into[k * 17..k * 17 + 17];
                if (e[0] == 4u8) {
                    found.push(IpAddr.V4(e[1], e[2], e[3], e[4]));
                } else {
                    let groups: uint16[] = [0u16] * 8;
                    var g = 0;
                    while (g < 8) {
                        groups[g] = ((e[1 + 2 * g] as int) * 256 + (e[2 + 2 * g] as int)) as uint16;
                        g += 1;
                    }
                    found.push(
                        IpAddr.V6(
                            groups[0],
                            groups[1],
                            groups[2],
                            groups[3],
                            groups[4],
                            groups[5],
                            groups[6],
                            groups[7]
                        )
                    );
                }
                k += 1;
            }
            return found;
        }
        // more than fit: again, with room for them all
        room = n;
    }
}
