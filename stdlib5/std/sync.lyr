//! Synchronization between tasks and threads: [Atomic], [Mutex], [RwLock], [Once] and
//! [Semaphore].
//!
//! The lock state lives in `std.task`, whose scheduler releases the locks of a task that
//! panicked. A task that waits for a lock or a permit is parked while the other tasks of its
//! thread run.
import std.task {
    atomicLoad,
    atomicStore,
    atomicExchange,
    atomicCompareAndSet,
    atomicFetchAndAdd,
    Cancelled,
    here,
    LockState,
    park,
    Slot,
    SpinLock,
    Waiters,
};

/// The types an [Atomic] holds: those the machine reads and writes in one step.
///
/// These are `int` and `bool` and, by the compiler, every class and every optional of one (a
/// reference is one word). The interface is sealed: no other type implements it.
pub sealed interface AtomicValue { }

extend int :: [AtomicValue] { }

extend bool :: [AtomicValue] { }

/// A value that every thread reads and writes in one step.
///
/// Each operation is sequentially consistent and orders the reads and writes around it: what a
/// thread did before a store, a thread that loads what it stored sees.
///
/// Its operations are `std.task`'s atomic operations on the place of `value`: an atomic is the
/// object around one word for a program that shares it — what holds such a word in a field of
/// its own needs no object.
pub class Atomic<T :: [AtomicValue]> {
    var value: T,

    /// Creates an atomic that holds `value`.
    pub static fn new(value: T): Atomic<T> {
        return Atomic<T> { value = value };
    }

    /// Returns the value.
    pub fn load(): T {
        // Through the reference, not through 'this': the operation takes a place, and only a
        // 'mut fn' may hand on a place of 'this' — a load writes nothing.
        let me = this;
        return atomicLoad(&me.value);
    }

    /// Sets the value.
    pub mut fn store(value: T): void {
        atomicStore(&this.value, value);
    }

    /// Sets the value and returns the one it replaced.
    pub mut fn exchange(value: T): T {
        return atomicExchange(&this.value, value);
    }

    /// Sets the value to `desired` where it is `expected`, in one step, and returns whether it did.
    ///
    /// Returns `false`, and changes nothing, where the value was another. A class is compared by
    /// identity: the same object, whatever `==` says.
    pub mut fn compareAndSet(expected: T, desired: T): bool {
        return atomicCompareAndSet(&this.value, expected, desired);
    }
}

extend Atomic<int> {
    /// Adds `n` and returns the value before. It wraps around, as `+%` does.
    pub mut fn fetchAndAdd(n: int): int {
        return atomicFetchAndAdd(&this.value, n);
    }

    /// Adds `n` and returns the value after. It wraps around, as `+%` does.
    pub mut fn addAndFetch(n: int): int {
        return atomicFetchAndAdd(&this.value, n) +% n;
    }
}

/// A value that one task at a time holds.
///
/// [Mutex.lock] gives the value to its body only, as a place — `m.lock { &n => n += 1; }` —
/// which ends with the body, so nothing reaches the value outside the lock. A task that finds
/// the mutex held waits, parked, while the other tasks of its thread run. This holds across
/// threads, and on one thread wherever a body waits.
pub class Mutex<T> {
    slot: Slot<T>,
    state: LockState,

    /// Creates a mutex that holds `value`.
    pub static fn new(value: T): Mutex<T> {
        return Mutex<T> { slot = Slot<T> { value = value }, state = LockState { } };
    }

    /// Runs `body` while the running task holds the mutex and returns what `body` returns.
    ///
    /// The task waits until no other holds the mutex. The body takes the value's place,
    /// `{ &v => … }`: it reads and writes the value itself, and the place is the call's — it ends
    /// with the body, and no closure in it holds it. The mutex is released when the body ends,
    /// also by a throw.
    ///
    /// # Errors
    ///
    /// Throws what `body` throws, and `Cancelled` when the task is cancelled during the wait.
    pub fn lock<R, E :: [Error]>(body: fn(&T) -> R throws E): R throws [E, Cancelled] {
        try this.state.acquireAlone(false);
        defer this.state.releaseAlone();
        return try body(&this.slot.value);
    }
}

/// A value that readers share and a writer holds alone.
///
/// A writer that waits goes first: readers that come after it wait for it.
pub class RwLock<T> {
    slot: Slot<T>,
    state: LockState,

    /// Creates a lock that holds `value`.
    pub static fn new(value: T): RwLock<T> {
        return RwLock<T> { slot = Slot<T> { value = value }, state = LockState { } };
    }

    /// Runs `body` with the value while no writer holds the lock — other readers may — and
    /// returns what `body` returns.
    ///
    /// # Errors
    ///
    /// Throws what `body` throws, and `Cancelled` when the task is cancelled during the wait.
    pub fn read<R, E :: [Error]>(body: fn(T) -> R throws E): R throws [E, Cancelled] {
        try this.state.acquireShared();
        defer this.state.releaseShared();
        return try body(this.slot.value);
    }

    /// Runs `body` while the running task alone holds the lock — no reader, no other writer — and
    /// returns what `body` returns.
    ///
    /// The body takes the value's place, as [Mutex.lock]'s does.
    ///
    /// # Errors
    ///
    /// Throws what `body` throws, and `Cancelled` when the task is cancelled during the wait.
    pub fn write<R, E :: [Error]>(body: fn(&T) -> R throws E): R throws [E, Cancelled] {
        try this.state.acquireAlone(true);
        defer this.state.releaseAlone();
        return try body(&this.slot.value);
    }
}

/// Work done once.
///
/// The first [Once.run] does it, every later one returns at once, and one that comes while it
/// runs waits until it has ended.
pub class Once {
    state: LockState,

    /// Creates a `Once` whose work is not done yet.
    pub static fn new(): Once {
        return Once { state = LockState { } };
    }

    /// Runs `body` if no earlier call has run its work to the end.
    ///
    /// Where another task runs the work now, this waits for that one instead.
    ///
    /// # Errors
    ///
    /// Throws what `body` throws; the work then counts as not done, and the next `run` runs it
    /// again. Throws `Cancelled` when the task is cancelled during the wait.
    pub fn run<E :: [Error]>(body: fn() -> void throws E): void throws [E, Cancelled] {
        let first = try this.state.beginOnce();
        if (!first) {
            return;
        }
        var done = false;
        defer {
            this.state.endOnce(done);
        }
        try body();
        done = true;
    }
}

/// A count of permits that tasks take and give back.
///
/// [Semaphore.release], from any task on any thread, ends the wait of those in
/// [Semaphore.acquire], and nobody needs to hold a permit to give one back. A permit is no hold,
/// so a panic poisons no semaphore.
pub class Semaphore {
    state: PermitState,

    /// Creates a semaphore of `permits` permits.
    ///
    /// # Panics
    ///
    /// Panics if `permits` is negative.
    pub static fn new(permits: int): Semaphore {
        if (permits < 0) {
            panic(f"Semaphore.new: a negative count {permits}");
        }
        return Semaphore { state = PermitState { permits = permits } };
    }

    /// Takes a permit, waiting while none is left.
    ///
    /// # Errors
    ///
    /// Throws `Cancelled`, and takes no permit, when the task is cancelled before or during the
    /// wait.
    ///
    /// # Panics
    ///
    /// Panics if no task is running.
    pub fn acquire(): void throws Cancelled {
        try this.state.acquire();
    }

    /// Takes a permit where one is left, without waiting, and returns whether it took one.
    pub fn tryAcquire(): bool {
        return this.state.tryAcquire();
    }

    /// Gives a permit back, and wakes the tasks that wait for one.
    pub fn release(): void {
        this.state.release();
    }

    /// Returns the permits left now; another thread may take or give one the next moment.
    pub fn available(): int {
        return this.state.available();
    }
}

/// A semaphore's count behind a spin lock, and the tasks that wait for a permit, each of which a
/// release wakes to look again.
class PermitState {
    guard: SpinLock = SpinLock { },
    var permits: int,
    waiters: Waiters = Waiters { },

    mut fn acquire(): void throws Cancelled {
        let s = here();
        let me = s.running ?? panic("a semaphore where no task runs");
        if (atomicLoad(&me.cancelled)) {
            throw Cancelled { };
        }
        this.guard.acquire();
        while (this.permits == 0) {
            me.beginWait();
            this.waiters.add(me);
            this.guard.release();
            s.wakeIfCancelled(me);
            park();
            me.endWait();
            this.guard.acquire();
            this.waiters.remove(me);
            if (atomicLoad(&me.cancelled)) {
                this.guard.release();
                throw Cancelled { };
            }
        }
        this.permits -= 1;
        this.guard.release();
    }

    mut fn tryAcquire(): bool {
        this.guard.acquire();
        let took = this.permits > 0;
        if (took) {
            this.permits -= 1;
        }
        this.guard.release();
        return took;
    }

    mut fn release(): void {
        let s = here();
        this.guard.acquire();
        this.permits += 1;
        this.waiters.wakeAll(s);
        this.guard.release();
    }

    mut fn available(): int {
        this.guard.acquire();
        let n = this.permits;
        this.guard.release();
        return n;
    }
}
