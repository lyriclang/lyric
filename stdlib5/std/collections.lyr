/// The containers (design/v5/spec/10 B7). Not safe across threads (C11): a `Mutex` holds one
/// that is shared.
import std.core { arrayOf, Hasher };
import std.hash { DefaultHasher };

// --- List (10 C3) --------------------------------------------------------------------------------
// The elements lie at the front of a buffer that doubles when full. The slots past the length hold
// copies of a value already there — never read, overwritten on the way back — so the buffer is a
// `T[]` and `asSlice()` a view of it (C3: growth leaves an older view on the older buffer).

/// A growing array (10 C3): its elements in order; `[i]` and `[i] = v` as an array's, panicking
/// outside `0 ≤ i < length()`. Not safe across threads (C11).
pub class List<T> :: [IndexSet<int>, Iterable] {
    type Output = T;
    type Iter = ListIter<T>;
    var buffer: T[],
    var count: int,
    var changes: int,

    /// An empty list.
    pub static fn new(): List<T> {
        return List<T> { buffer = [], count = 0, changes = 0 };
    }

    /// A list of the array's elements, copied.
    pub static fn of(xs: T[]): List<T> {
        return List<T> { buffer = arrayOf(xs.length(), (i: int) => xs[i]), count = xs.length(), changes = 0 };
    }

    /// How many elements it holds.
    pub fn length(): int {
        return this.count;
    }

    /// Whether it holds none.
    pub fn isEmpty(): bool {
        return this.count == 0;
    }

    /// The element at `i`; outside `0 ≤ i < length()` a panic (`LYR-RT0003`).
    pub fn index(i: int): T {
        return this.buffer[..this.count][i];
    }

    /// `v` at `i`, in place of the element there.
    pub mut fn setIndex(i: int, v: T): void {
        this.buffer[..this.count][i] = v;
    }

    /// The element at `i`, or `null` outside `0 ≤ i < length()`.
    pub fn get(i: int): ?T {
        if (i < 0 || i >= this.count) {
            return null;
        }
        return this.buffer[i];
    }

    /// The elements as a view of the buffer: the members of arrays and views (C2) reach them — a
    /// sort writes the list. A push past the room moves the list to a new buffer, the view not.
    pub fn asSlice(): Slice<T> {
        return this.buffer[..this.count];
    }

    /// The elements, copied into an array of their own — one copy (B16).
    pub fn toArray(): T[] {
        let n = this.count;
        if (n == 0) {
            return [];
        }
        let first = this.buffer[0];
        let out = arrayOf(n, (i: int) => first);
        this.buffer[..n].copyInto(out[..]);
        return out;
    }

    /// `v` at the end.
    pub mut fn push(v: T): void {
        if (this.count == this.buffer.length()) {
            this.grow(v);
        }
        this.buffer[this.count] = v;
        this.count = this.count + 1;
        this.changes = this.changes + 1;
    }

    /// Every value `xs` gives, at the end, in order.
    pub mut fn pushAll(xs: T[]): void {
        for (x in xs) {
            this.push(x);
        }
    }

    /// The last element taken off, or `null` where there is none.
    pub mut fn pop(): ?T {
        if (this.count == 0) {
            return null;
        }
        this.count = this.count - 1;
        this.changes = this.changes + 1;
        return this.buffer[this.count];
    }

    /// `v` at `i`, the elements from `i` on one place further; `i` outside `0 ≤ i ≤ length()` panics.
    pub mut fn insert(i: int, v: T): void {
        if (i < 0 || i > this.count) {
            panic(f"List.insert: index {i} outside 0..={this.count}");
        }
        this.push(v);
        // the elements from `i` one place on: overlapping, backwards — memmove's business (B16)
        this.buffer[i..this.count - 1].copyInto(this.buffer[i + 1..this.count]);
        this.buffer[i] = v;
    }

    /// The element at `i` taken out, those after it one place nearer; outside `0 ≤ i < length()`
    /// a panic.
    pub mut fn removeAt(i: int): T {
        let taken = this.index(i);
        this.buffer[i + 1..this.count].copyInto(this.buffer[i..this.count - 1]);
        this.count = this.count - 1;
        this.changes = this.changes + 1;
        return taken;
    }

    /// The elements for which `p` holds taken out, the others kept in order; how many went.
    pub mut fn removeWhere(p: fn(T) -> bool): int {
        var kept = 0;
        var i = 0;
        while (i < this.count) {
            let x = this.buffer[i];
            if (!p(x)) {
                this.buffer[kept] = x;
                kept = kept + 1;
            }
            i = i + 1;
        }
        let gone = this.count - kept;
        this.count = kept;
        if (gone > 0) {
            this.changes = this.changes + 1;
        }
        return gone;
    }

    /// Every element taken out; the room stays.
    pub mut fn clear(): void {
        this.count = 0;
        this.changes = this.changes + 1;
    }

    /// The first `n` elements kept, the rest taken out; `n` at or past the length keeps all.
    pub mut fn truncate(n: int): void {
        if (n < 0) {
            panic(f"List.truncate: a negative length {n}");
        }
        if (n < this.count) {
            this.count = n;
            this.changes = this.changes + 1;
        }
    }

    /// The elements at `i` and `j` exchanged.
    pub mut fn swap(i: int, j: int): void {
        this.asSlice().swap(i, j);
    }

    /// The iterator over the elements, front to back (10 I9): a push, a pop or another change of the
    /// length while it walks is the program's error, and the next pull panics.
    pub fn iter(): ListIter<T> {
        return ListIter<T> { list = this, at = 0, changes = this.changes };
    }

    /// Room for twice the elements, the slots past the length holding `filler`: the new buffer
    /// made of the filler, the elements over in one copy (B16).
    mut fn grow(filler: T): void {
        let room = if (this.buffer.length() == 0) 8 else this.buffer.length() * 2;
        let grown = arrayOf(room, (i: int) => filler);
        this.buffer[..this.count].copyInto(grown[..]);
        this.buffer = grown;
    }
}

extend<T :: [Equatable]> List<T> {
    /// Whether an element equals `x`.
    pub fn contains(x: T): bool {
        return this.asSlice().contains(x);
    }

    /// The first element equal to `x` taken out; whether there was one.
    pub mut fn remove(x: T): bool {
        let at = this.asSlice().indexOf(x);
        if (at == null) {
            return false;
        }
        this.removeAt(at);
        return true;
    }

    /// Runs of equal elements kept once each.
    pub mut fn dedup(): void {
        if (this.count < 2) {
            return;
        }
        var kept = 1;
        var i = 1;
        while (i < this.count) {
            if (!(this.buffer[i] == this.buffer[kept - 1])) {
                this.buffer[kept] = this.buffer[i];
                kept = kept + 1;
            }
            i = i + 1;
        }
        if (kept < this.count) {
            this.count = kept;
            this.changes = this.changes + 1;
        }
    }
}

/// The iterator of a list (10 I9): it walks the list where it stands, and a change of the list's
/// length since it began panics at the next pull.
pub struct ListIter<T> :: [Iterator] {
    type Item = T;
    list: List<T>,
    var at: int,
    changes: int,

    pub mut fn next(): ?T {
        if (this.list.changes != this.changes) {
            changedWhileWalked("List");
        }
        if (this.at >= this.list.count) {
            return null;
        }
        this.at = this.at + 1;
        return this.list.buffer[this.at - 1];
    }
}

// --- Map (10 C4): a Swiss table ----------------------------------------------------------------
// Groups of eight slots, each group with a control word of eight bytes, one a slot: 0x80 for an
// empty slot, 0xFE for a deleted one, the low seven bits of the key's hash for a full one. A
// lookup matches those seven bits against a whole group at once, and compares keys only where
// they match; a group with an empty slot ends the probe. At most seven of every eight slots are
// filled; the deleted ones are swept when the table is built anew.

/// Eight empty slots.
let emptyGroup: uint64 = 0x8080808080808080;
let lowBits: uint64 = 0x0101010101010101;
let highBits: uint64 = 0x8080808080808080;

/// The slots of a control word that are empty: 0x80, the high bit set and bit 1 clear.
fn emptiesOf(word: uint64): uint64 {
    return word & ~(word << 6) & highBits;
}

/// A map from keys to values, by the keys' hashes (10 C4): what it holds in no order of its own,
/// the same key once. `H` hashes the keys — `DefaultHasher` under the process's key unless the map
/// is given another; a hasher is a value, copied fresh for every key.
pub class Map<K :: [Hashable], V, H :: [Hasher] = DefaultHasher> :: [Iterable] {
    type Iter = MapEntriesIter<K, V, H>;
    var controls: uint64[],
    var slotKeys: (?K)[],
    var slotValues: (?V)[],
    var count: int,
    var free: int,
    var changes: int,
    seed: H,

    /// An empty map hashing with `seed`: `Map<string, int, FixedHasher>.withHasher(FixedHasher.new())`
    /// is the same in every run.
    pub static fn withHasher(seed: H): Map<K, V, H> {
        return Map<K, V, H> { controls = [], slotKeys = [], slotValues = [], count = 0, free = 0, changes = 0, seed = seed };
    }

    /// How many keys it holds.
    pub fn length(): int {
        return this.count;
    }

    /// Whether it holds none.
    pub fn isEmpty(): bool {
        return this.count == 0;
    }

    /// The value under `k`, or `null`.
    pub fn get(k: K): ?V {
        let at = this.find(k, this.hashOf(k));
        if (at < 0) {
            return null;
        }
        return this.slotValues[at];
    }

    /// Whether it holds `k`.
    pub fn containsKey(k: K): bool {
        return this.find(k, this.hashOf(k)) >= 0;
    }

    /// `v` under `k`; the value it replaces, or `null` where `k` was not there.
    pub mut fn insert(k: K, v: V): ?V {
        let hash = this.hashOf(k);
        let at = this.find(k, hash);
        if (at >= 0) {
            let old = this.slotValues[at];
            this.slotValues[at] = v;
            return old;
        }
        if (this.free == 0) {
            this.rebuild();
        }
        this.place(k, v, hash);
        this.count = this.count + 1;
        this.changes = this.changes + 1;
        return null;
    }

    /// `k` and its value taken out; the value, or `null` where `k` was not there.
    pub mut fn remove(k: K): ?V {
        let at = this.find(k, this.hashOf(k));
        if (at < 0) {
            return null;
        }
        let g = at / 8;
        let shift = ((at % 8) * 8) as uint64;
        let word = this.controls[g];
        // A group with an empty slot ends every probe through it, so no key lies beyond it on a
        // probe that passed it: the slot can be empty again. Otherwise it marks a deletion.
        var mark: uint64 = 254;
        if (emptiesOf(word) != 0) {
            mark = 128;
            this.free = this.free + 1;
        }
        this.controls[g] = (word & ~((255 as uint64) << shift)) | (mark << shift);
        let old = this.slotValues[at];
        this.slotKeys[at] = null;
        this.slotValues[at] = null;
        this.count = this.count - 1;
        this.changes = this.changes + 1;
        return old;
    }

    /// The value under `k`, or `otherwise` where there is none.
    pub fn getOr(k: K, otherwise: V): V {
        let at = this.find(k, this.hashOf(k));
        if (at < 0) {
            return otherwise;
        }
        return this.slotValues[at]!;
    }

    /// The value under `k`; where there is none, `make()`'s, inserted first.
    pub mut fn getOrInsert(k: K, make: fn() -> V): V {
        let hash = this.hashOf(k);
        let at = this.find(k, hash);
        if (at >= 0) {
            return this.slotValues[at]!;
        }
        let made = make();
        if (this.free == 0) {
            this.rebuild();
        }
        this.place(k, made, hash);
        this.count = this.count + 1;
        this.changes = this.changes + 1;
        return made;
    }

    /// The value under `k` replaced by `f` of it; whether there was one.
    pub mut fn update(k: K, f: fn(V) -> V): bool {
        let at = this.find(k, this.hashOf(k));
        if (at < 0) {
            return false;
        }
        this.slotValues[at] = f(this.slotValues[at]!);
        return true;
    }

    /// The entries for which `p` fails taken out; how many went.
    pub mut fn retain(p: fn(K, V) -> bool): int {
        var gone = 0;
        var at = 0;
        while (at < this.slotKeys.length()) {
            let k = this.slotKeys[at];
            if (k != null && !p(k, this.slotValues[at]!)) {
                this.remove(k);
                gone = gone + 1;
            }
            at = at + 1;
        }
        return gone;
    }

    /// The entries, in no order of the map's own (10 I8): a change of the map while they are walked
    /// panics at the next pull (I9).
    pub fn iter(): MapEntriesIter<K, V, H> {
        return MapEntriesIter<K, V, H> { map = this, at = 0, changes = this.changes };
    }

    /// The keys, in the entries' order.
    pub fn keys(): MapKeysIter<K, V, H> {
        return MapKeysIter<K, V, H> { entries = this.iter() };
    }

    /// The values, in the entries' order.
    pub fn values(): MapValuesIter<K, V, H> {
        return MapValuesIter<K, V, H> { entries = this.iter() };
    }

    /// Every key taken out.
    pub mut fn clear(): void {
        this.controls = [];
        this.slotKeys = [];
        this.slotValues = [];
        this.count = 0;
        this.free = 0;
        this.changes = this.changes + 1;
    }

    fn hashOf(k: K): uint64 {
        var h = this.seed;
        k.hash(&h);
        return h.finish();
    }

    /// The slot holding `k`, or -1: the groups along the hash's probe, triangular — every group once
    /// where their number is a power of two.
    fn find(k: K, hash: uint64): int {
        if (this.count == 0) {
            return -1;
        }
        let mask = this.controls.length() - 1;
        let pattern = (hash & 127) *% lowBits;
        var g = ((hash >> 7) as int) & mask;
        var step = 0;
        while (step <= mask) {
            let word = this.controls[g];
            let x = word ^ pattern;
            var hits = (x -% lowBits) & ~x & highBits;
            while (hits != 0) {
                let slot = g * 8 + hits.trailingZeros() / 8;
                // unwrapped: the key's own equality, not the optionals' (measurement point 3)
                if (let key = this.slotKeys[slot]) {
                    if (key == k) {
                        return slot;
                    }
                }
                hits = hits & (hits -% 1);
            }
            if (emptiesOf(word) != 0) {
                return -1;
            }
            step = step + 1;
            g = (g + step) & mask;
        }
        return -1;
    }

    /// `k` and `v` into the first slot along the probe that is not full; `k` is not there.
    mut fn place(k: K, v: ?V, hash: uint64): void {
        let mask = this.controls.length() - 1;
        let tag = hash & 127;
        var g = ((hash >> 7) as int) & mask;
        var step = 0;
        while (step <= mask) {
            let word = this.controls[g];
            let open = word & highBits;
            if (open != 0) {
                let j = open.trailingZeros() / 8;
                let shift = (8 * j) as uint64;
                if (((word >> shift) & 255) == 128) {
                    this.free = this.free - 1;
                }
                this.controls[g] = (word & ~((255 as uint64) << shift)) | (tag << shift);
                this.slotKeys[g * 8 + j] = k;
                this.slotValues[g * 8 + j] = v;
                return;
            }
            step = step + 1;
            g = (g + step) & mask;
        }
        panic("Map: a full table");
    }

    /// The table built anew, every key placed again: twice the groups — one where there was none —
    /// or as many where fewer than half the slots the load allows hold keys, the rest deletions.
    mut fn rebuild(): void {
        let groups = this.controls.length();
        var next = 1;
        if (groups > 0) {
            next = if (this.count * 16 < groups * 56) groups else groups * 2;
        }
        let oldKeys = this.slotKeys;
        let oldValues = this.slotValues;
        this.controls = [emptyGroup] * next;
        this.slotKeys = arrayOf(next * 8, (i: int): ?K => null);
        this.slotValues = arrayOf(next * 8, (i: int): ?V => null);
        this.free = next * 7;
        var i = 0;
        while (i < oldKeys.length()) {
            let k = oldKeys[i];
            if (k != null) {
                this.place(k, oldValues[i], this.hashOf(k));
            }
            i = i + 1;
        }
    }
}

/// A map's entries, `(K, V)`, slot by slot.
pub struct MapEntriesIter<K :: [Hashable], V, H :: [Hasher]> :: [Iterator] {
    type Item = (K, V);
    map: Map<K, V, H>,
    var at: int,
    changes: int,
    /// What the walk is called where it panics: a `Set` walks its table's entries.
    label: string = "Map",

    pub mut fn next(): ?(K, V) {
        if (this.map.changes != this.changes) {
            changedWhileWalked(this.label);
        }
        while (this.at < this.map.slotKeys.length()) {
            let k = this.map.slotKeys[this.at];
            this.at = this.at + 1;
            if (k != null) {
                let entry: (K, V) = (k, this.map.slotValues[this.at - 1]!);
                return entry;
            }
        }
        return null;
    }
}

/// A map's keys.
pub struct MapKeysIter<K :: [Hashable], V, H :: [Hasher]> :: [Iterator] {
    type Item = K;
    var entries: MapEntriesIter<K, V, H>,

    pub mut fn next(): ?K {
        let e = this.entries.next();
        if (e == null) {
            return null;
        }
        let (k, _) = e;
        return k;
    }
}

/// A map's values.
pub struct MapValuesIter<K :: [Hashable], V, H :: [Hasher]> :: [Iterator] {
    type Item = V;
    var entries: MapEntriesIter<K, V, H>,

    pub mut fn next(): ?V {
        let e = this.entries.next();
        if (e == null) {
            return null;
        }
        let (_, v) = e;
        return v;
    }
}

/// A collection changed while it was walked (10 I9): a panic of its own code, `LYR-RT0016`,
/// "List: changed while it was walked". Native: the runtime's.
fn changedWhileWalked(what: string): never;

// --- Set (10 C5): a Map's keys -----------------------------------------------------------------

/// The values it holds, each once, in no order of its own — a map's keys, by the same table.
pub class Set<T :: [Hashable], H :: [Hasher] = DefaultHasher> :: [Iterable] {
    type Iter = MapKeysIter<T, bool, H>;
    var table: Map<T, bool, H>,

    /// An empty set hashing with `seed`.
    pub static fn withHasher(seed: H): Set<T, H> {
        return Set<T, H> { table = Map<T, bool, H>.withHasher(seed) };
    }

    /// How many values it holds.
    pub fn length(): int {
        return this.table.length();
    }

    /// Whether it holds none.
    pub fn isEmpty(): bool {
        return this.table.isEmpty();
    }

    /// Whether it holds `v`.
    pub fn contains(v: T): bool {
        return this.table.containsKey(v);
    }

    /// `v` added; whether it was not there.
    pub mut fn insert(v: T): bool {
        return this.table.insert(v, true) == null;
    }

    /// `v` taken out; whether it was there.
    pub mut fn remove(v: T): bool {
        return this.table.remove(v) != null;
    }

    /// Every value taken out.
    pub mut fn clear(): void {
        this.table.clear();
    }

    /// The values, in no order of the set's own.
    pub fn iter(): MapKeysIter<T, bool, H> {
        return MapKeysIter<T, bool, H> {
            entries = MapEntriesIter<T, bool, H> { map = this.table, at = 0, changes = this.table.changes, label = "Set" },
        };
    }
}

extend<T :: [Hashable]> Set<T, DefaultHasher> {
    /// An empty set hashing with the process's key.
    pub static fn new(): Set<T, DefaultHasher> {
        return Set<T, DefaultHasher>.withHasher(DefaultHasher.new());
    }
}

// --- from iterators (10 I4) ----------------------------------------------------------------------

extend<I :: [Iterator]> I {
    /// The values, in a list of their own.
    pub fn toList(): List<I.Item> throws I.Error {
        var it = this;
        let out = List<I.Item>.new();
        var x = try it.next();
        while (x != null) {
            out.push(x);
            x = try it.next();
        }
        return out;
    }
}

extend<K :: [Hashable], V> Map<K, V, DefaultHasher> {
    /// An empty map hashing with the process's key (10 K2): its order differs from run to run.
    pub static fn new(): Map<K, V, DefaultHasher> {
        return Map<K, V, DefaultHasher>.withHasher(DefaultHasher.new());
    }
}

// --- Deque (10 C6) -------------------------------------------------------------------------------
// The values lie in a ring: `count` of them from `head` on, wrapping at the buffer's end; a full
// ring is copied, in order, into one twice its size. A slot no value holds is `null`, so the buffer
// keeps nothing alive.

/// A double-ended queue (10 C6): values pushed and popped at either end; `[i]` counts from the
/// front, panicking outside `0 ≤ i < length()`; walked front to back. Not safe across threads (C11).
pub class Deque<T> :: [Index<int>, Iterable] {
    type Output = T;
    type Iter = DequeIter<T>;
    var slots: (?T)[],
    var head: int,
    var count: int,
    var changes: int,

    /// An empty deque.
    pub static fn new(): Deque<T> {
        return Deque<T> { slots = [], head = 0, count = 0, changes = 0 };
    }

    /// How many values it holds.
    pub fn length(): int {
        return this.count;
    }

    /// Whether it holds none.
    pub fn isEmpty(): bool {
        return this.count == 0;
    }

    /// `v` at the back.
    pub mut fn pushBack(v: T): void {
        this.grow();
        this.slots[this.slotOf(this.count)] = v;
        this.count = this.count + 1;
        this.changes = this.changes + 1;
    }

    /// `v` at the front.
    pub mut fn pushFront(v: T): void {
        this.grow();
        this.head = this.slotOf(this.slots.length() - 1);
        this.slots[this.head] = v;
        this.count = this.count + 1;
        this.changes = this.changes + 1;
    }

    /// The front value taken off, or `null` where there is none.
    pub mut fn popFront(): ?T {
        if (this.count == 0) {
            return null;
        }
        let v = this.slots[this.head];
        this.slots[this.head] = null;
        this.head = this.slotOf(1);
        this.count = this.count - 1;
        this.changes = this.changes + 1;
        return v;
    }

    /// The back value taken off, or `null` where there is none.
    pub mut fn popBack(): ?T {
        if (this.count == 0) {
            return null;
        }
        let at = this.slotOf(this.count - 1);
        let v = this.slots[at];
        this.slots[at] = null;
        this.count = this.count - 1;
        this.changes = this.changes + 1;
        return v;
    }

    /// The front value, or `null` where there is none.
    pub fn peekFront(): ?T {
        if (this.count == 0) {
            return null;
        }
        return this.slots[this.head];
    }

    /// The back value, or `null` where there is none.
    pub fn peekBack(): ?T {
        if (this.count == 0) {
            return null;
        }
        return this.slots[this.slotOf(this.count - 1)];
    }

    /// The value `i` from the front; outside `0 ≤ i < length()` a panic (`LYR-RT0003`).
    pub fn index(i: int): T {
        if (i < 0 || i >= this.count) {
            // the bounds checked as an array's are, on a view of `count` slots: it panics
            return this.slots[..this.count][i] ?? unreachable();
        }
        return this.slots[this.slotOf(i)] ?? unreachable();
    }

    /// The iterator over the values, front to back (10 C6, I9): a change while it walks is the
    /// program's error, and the next pull panics.
    pub fn iter(): DequeIter<T> {
        return DequeIter<T> { deque = this, at = 0, changes = this.changes };
    }

    /// The slot `offset` past the head, around the ring.
    fn slotOf(offset: int): int {
        return (this.head + offset) % this.slots.length();
    }

    /// Room for one more: a full ring copied, from its head on, into one twice its size.
    mut fn grow(): void {
        if (this.count < this.slots.length()) {
            return;
        }
        let room = if (this.slots.length() == 0) 8 else this.slots.length() * 2;
        let old = this.slots;
        let grown = arrayOf(room, (i: int): ?T => null);
        if (old.length() > 0) {
            // the ring from its head to its end, then what wrapped to the front: two copies (B16)
            let tail = old.length() - this.head;
            old[this.head..old.length()].copyInto(grown[..tail]);
            old[..this.head].copyInto(grown[tail..old.length()]);
        }
        this.slots = grown;
        this.head = 0;
    }
}

/// A deque's values, front to back.
pub struct DequeIter<T> :: [Iterator] {
    type Item = T;
    deque: Deque<T>,
    var at: int,
    changes: int,

    pub mut fn next(): ?T {
        if (this.deque.changes != this.changes) {
            changedWhileWalked("Deque");
        }
        if (this.at >= this.deque.count) {
            return null;
        }
        this.at = this.at + 1;
        return this.deque.slots[this.deque.slotOf(this.at - 1)];
    }
}

// --- Heap (10 C1) --------------------------------------------------------------------------------
// A binary tree laid out in a list: the children of `i` at `2i + 1` and `2i + 2`, no value less
// than its parent.

/// A binary heap (10 C1): the least value first (the review's A1) — `push`, `pop` and `peek` —
/// each in `log n` steps, over a list. Not safe across threads (C11). The greatest first: a heap
/// of a type whose order is reversed.
pub class Heap<T :: [TotalOrder]> {
    var items: List<T>,

    /// An empty heap.
    pub static fn new(): Heap<T> {
        return Heap<T> { items = List<T>.new() };
    }

    /// How many values it holds.
    pub fn length(): int {
        return this.items.length();
    }

    /// Whether it holds none.
    pub fn isEmpty(): bool {
        return this.items.isEmpty();
    }

    /// The least value, or `null` where there is none.
    pub fn peek(): ?T {
        return this.items.get(0);
    }

    /// `v`, risen to its place.
    pub mut fn push(v: T): void {
        this.items.push(v);
        var at = this.items.length() - 1;
        while (at > 0) {
            let parent = (at - 1) / 2;
            if (!less(this.items[at], this.items[parent])) {
                break;
            }
            this.items.swap(at, parent);
            at = parent;
        }
    }

    /// The least value taken off, or `null` where there is none: the last one put at the top and
    /// sunk to its place.
    pub mut fn pop(): ?T {
        let n = this.items.length();
        if (n == 0) {
            return null;
        }
        this.items.swap(0, n - 1);
        let top = this.items.pop();
        let m = n - 1;
        var at = 0;
        while (true) {
            let left = 2 * at + 1;
            if (left >= m) {
                break;
            }
            var child = left;
            if (left + 1 < m && less(this.items[left + 1], this.items[left])) {
                child = left + 1;
            }
            if (!less(this.items[child], this.items[at])) {
                break;
            }
            this.items.swap(at, child);
            at = child;
        }
        return top;
    }
}

/// Whether `a` comes before `b` in their order.
fn less<T :: [TotalOrder]>(a: T, b: T): bool {
    return match (a.totalCompare(b)) {
        .Less => true,
        _ => false,
    };
}
