/// Provides the growable containers of the standard library.
///
/// - [List]: a growing array, indexed from 0.
/// - [Map]: keys to values by hash, each key once, in no order of its own.
/// - [Set]: values by hash, each once, in no order of its own.
/// - [Deque]: a double-ended queue, pushed and popped at either end.
/// - [Heap]: a binary min-heap.
///
/// Each can be built from an array literal and through `collect()`, and is `Clone` where its
/// elements are. All but the heap are `Iterable`, and `Equatable`, `Debug` and `Display` where their
/// elements are; the heap is `Debug`. The iterator methods that build containers — `toList`,
/// `toSet`, `toMap`, `chunks`, `windows`, `sorted`, `sortedBy`, `partition`, `groupBy` — live here
/// too.
///
/// The containers are not safe across threads: share one through a `Mutex`.
import std.core { arrayOf, AsSlice, Contains, filled, FromArrayLiteral, FromIterator, Hasher, Join, StringBuilder };
import std.hash { DefaultHasher };

// --- List (10 C3) --------------------------------------------------------------------------------
// The elements lie at the front of a buffer that doubles when full. The slots past the length hold
// copies of a value already there — never read, overwritten on the way back — so the buffer is a
// `T[]` and `asSlice()` a view of it (C3: growth leaves an older view on the older buffer).

/// A growing array: its elements in order, indexed from 0.
///
/// `list[i]` and `list[i] = v` work as on an array; `list[a..b]` is a view of the elements, as
/// `asSlice()[a..b]`. When full, the buffer doubles, so `push` is amortized constant time. Not safe
/// across threads.
///
/// # Panics
///
/// `list[i]` and `list[i] = v` panic outside `0 ≤ i < length()`.
pub class List<T> :: [IndexSet<int>, Iterable, AsSlice<T>] {
    type Output = T;
    type Iter = ListIter<T>;
    var buffer: T[],
    var count: int,
    var changes: int,
    reserved: int,

    /// Creates an empty list.
    pub static fn new(): List<T> {
        return List<T> { buffer = [], count = 0, changes = 0, reserved = 0 };
    }

    /// Creates an empty list with room for `n` elements before it grows.
    ///
    /// The room is allocated at the first push.
    ///
    /// # Panics
    ///
    /// When `n` is negative.
    pub static fn withCapacity(n: int): List<T> {
        if (n < 0) {
            panic(f"List.withCapacity: a negative capacity {n}");
        }
        return List<T> { buffer = [], count = 0, changes = 0, reserved = n };
    }

    /// Creates a list of the array's elements, copied.
    pub static fn of(xs: T[]): List<T> {
        return List<T> { buffer = arrayOf(xs.length(), (i: int) => xs[i]), count = xs.length(), changes = 0, reserved = 0 };
    }

    /// Returns how many elements it holds.
    pub fn length(): int {
        return this.count;
    }

    /// Returns whether it holds no elements.
    pub fn isEmpty(): bool {
        return this.count == 0;
    }

    /// Returns the element at `i`; this is `list[i]`.
    ///
    /// # Panics
    ///
    /// Outside `0 ≤ i < length()`, with `LYR-RT0003`.
    pub fn index(i: int): T {
        return this.buffer[..this.count][i];
    }

    /// Replaces the element at `i` with `v`; this is `list[i] = v`.
    ///
    /// # Panics
    ///
    /// Outside `0 ≤ i < length()`, with `LYR-RT0003`.
    pub mut fn setIndex(i: int, v: T): void {
        this.buffer[..this.count][i] = v;
    }

    /// Returns the element at `i`, or `null` outside `0 ≤ i < length()`.
    pub fn get(i: int): ?T {
        if (i < 0 || i >= this.count) {
            return null;
        }
        return this.buffer[i];
    }

    /// Returns a view of the elements in the list's buffer.
    ///
    /// The members of views reach the elements in place: sorting the view sorts the list. A push
    /// past the room moves the list to a new buffer; a view taken before stays on the old one.
    pub fn asSlice(): Slice<T> {
        return this.buffer[..this.count];
    }

    /// Returns the elements copied into a new array, in order.
    pub fn toArray(): T[] {
        let n = this.count;
        if (n == 0) {
            return [];
        }
        let out = filled(n, this.buffer[0]);
        this.buffer[..n].copyInto(out[..]);
        return out;
    }

    /// Appends `v` at the end.
    ///
    /// Amortized constant time: a full buffer is replaced by one twice its size.
    pub mut fn push(v: T): void {
        if (this.count == this.buffer.length()) {
            this.grow(v);
        }
        this.buffer[this.count] = v;
        this.count = this.count + 1;
        this.changes = this.changes + 1;
    }

    /// Appends every element of `xs` at the end, in order.
    pub mut fn pushAll(xs: T[]): void {
        for (x in xs) {
            this.push(x);
        }
    }

    /// Removes and returns the last element, or `null` where there is none.
    pub mut fn pop(): ?T {
        if (this.count == 0) {
            return null;
        }
        this.count = this.count - 1;
        this.changes = this.changes + 1;
        return this.buffer[this.count];
    }

    /// Inserts `v` at `i`, moving the elements from `i` on one place towards the end.
    ///
    /// Takes time linear in the number of elements moved.
    ///
    /// # Panics
    ///
    /// When `i` is outside `0 ≤ i ≤ length()`.
    pub mut fn insert(i: int, v: T): void {
        if (i < 0 || i > this.count) {
            panic(f"List.insert: index {i} outside 0..={this.count}");
        }
        this.push(v);
        // the elements from `i` one place on: overlapping, backwards — memmove's business (B16)
        this.buffer[i..this.count - 1].copyInto(this.buffer[i + 1..this.count]);
        this.buffer[i] = v;
    }

    /// Removes and returns the element at `i`, moving those after it one place towards the front.
    ///
    /// Takes time linear in the number of elements moved.
    ///
    /// # Panics
    ///
    /// When `i` is outside `0 ≤ i < length()`, with `LYR-RT0003`.
    pub mut fn removeAt(i: int): T {
        let taken = this.index(i);
        this.buffer[i + 1..this.count].copyInto(this.buffer[i..this.count - 1]);
        this.count = this.count - 1;
        this.changes = this.changes + 1;
        return taken;
    }

    /// Removes the elements for which `p` holds, keeping the others in order, and returns how many
    /// were removed.
    ///
    /// One pass, linear time.
    ///
    /// # Errors
    ///
    /// Throws what `p` throws. The removal stops there: the elements already decided are removed or
    /// kept, and the rest stay in the list in their order.
    pub mut fn removeWhere<E :: [Error]>(p: fn(T) -> bool throws E): int throws E {
        var kept = 0;
        var i = 0;
        defer {
            if (i < this.count) {
                // the way out a throw takes: the undecided rest moves down behind the kept
                let rest = this.count - i;
                var k = 0;
                while (k < rest) {
                    this.buffer[kept + k] = this.buffer[i + k];
                    k = k + 1;
                }
                if (i > kept) {
                    this.changes = this.changes + 1;
                }
                this.count = kept + rest;
            }
        }
        while (i < this.count) {
            let x = this.buffer[i];
            if (!(try p(x))) {
                this.buffer[kept] = x;
                kept = kept + 1;
            }
            i = i + 1;
        }
        let gone = this.count - kept;
        this.count = kept;
        if (gone > 0) {
            this.changes = this.changes + 1;
        }
        return gone;
    }

    /// Removes every element; the allocated room stays.
    pub mut fn clear(): void {
        this.count = 0;
        this.changes = this.changes + 1;
    }

    /// Keeps the first `n` elements and removes the rest.
    ///
    /// An `n` at or past the length keeps all.
    ///
    /// # Panics
    ///
    /// When `n` is negative.
    pub mut fn truncate(n: int): void {
        if (n < 0) {
            panic(f"List.truncate: a negative length {n}");
        }
        if (n < this.count) {
            this.count = n;
            this.changes = this.changes + 1;
        }
    }

    /// Exchanges the elements at `i` and `j`.
    ///
    /// # Panics
    ///
    /// When `i` or `j` is outside `0 ≤ i < length()`.
    pub mut fn swap(i: int, j: int): void {
        this.asSlice().swap(i, j);
    }

    /// Returns an iterator over the elements, front to back.
    ///
    /// # Panics
    ///
    /// The next pull panics (`LYR-RT0016`) after a push, a pop or another change of the length while
    /// the iterator walks.
    pub fn iter(): ListIter<T> {
        return ListIter<T> { list = this, at = 0, changes = this.changes };
    }

    /// Replaces the buffer by one twice its size (at least 8, at least the reserved room), the slots
    /// past the length holding `filler`.
    mut fn grow(filler: T): void {
        var room = if (this.buffer.length() == 0) 8 else this.buffer.length() * 2;
        if (room < this.reserved) {
            room = this.reserved;
        }
        let grown = filled(room, filler);
        this.buffer[..this.count].copyInto(grown[..]);
        this.buffer = grown;
    }
}

extend<T> List<T> {
    /// Creates a list of the values of an iterator, in order: `List.from(words.iter())`.
    ///
    /// # Errors
    ///
    /// Throws what a pull of `items` throws.
    pub static fn from<I :: [Iterator<Item = T>]>(items: I): List<T> throws I.Error {
        return try items.toList();
    }

    /// Shrinks the allocated room to the elements: a buffer of `length()` slots.
    ///
    /// A view taken before keeps the buffer it was taken of.
    pub mut fn shrinkToFit(): void {
        if (this.buffer.length() == this.count) {
            return;
        }
        if (this.count == 0) {
            this.buffer = [];
            return;
        }
        let fitted = filled(this.count, this.buffer[0]);
        this.buffer[..this.count].copyInto(fitted[..]);
        this.buffer = fitted;
    }
}

extend<T :: [Equatable]> List<T> {
    /// Removes the first element equal to `x` and returns whether there was one.
    pub mut fn remove(x: T): bool {
        let at = this.asSlice().indexOf(x);
        if (at == null) {
            return false;
        }
        this.removeAt(at);
        return true;
    }

    /// Removes consecutive repeated elements, keeping the first of each run of equal ones.
    pub mut fn dedup(): void {
        if (this.count < 2) {
            return;
        }
        var kept = 1;
        var i = 1;
        while (i < this.count) {
            if (!(this.buffer[i] == this.buffer[kept - 1])) {
                this.buffer[kept] = this.buffer[i];
                kept = kept + 1;
            }
            i = i + 1;
        }
        if (kept < this.count) {
            this.count = kept;
            this.changes = this.changes + 1;
        }
    }
}

/// Iterates over a list's elements, front to back; made by [List.iter].
///
/// It walks the list itself, not a copy.
///
/// # Panics
///
/// A pull panics (`LYR-RT0016`) when the list's length changed since the iterator was made.
pub struct ListIter<T> :: [Iterator] {
    type Item = T;
    list: List<T>,
    var at: int,
    changes: int,

    pub mut fn next(): ?T {
        if (this.list.changes != this.changes) {
            changedWhileWalked("List");
        }
        if (this.at >= this.list.count) {
            return null;
        }
        this.at = this.at + 1;
        return this.list.buffer[this.at - 1];
    }
}

// --- Map (10 C4): a Swiss table ----------------------------------------------------------------
// Groups of eight slots, each group with a control word of eight bytes, one a slot: 0x80 for an
// empty slot, 0xFE for a deleted one, the low seven bits of the key's hash for a full one. A
// lookup matches those seven bits against a whole group at once, and compares keys only where
// they match; a group with an empty slot ends the probe. At most seven of every eight slots are
// filled; the deleted ones are swept when the table is built anew.

/// A control word with all eight slots empty.
let emptyGroup: uint64 = 0x8080808080808080;
let lowBits: uint64 = 0x0101010101010101;
let highBits: uint64 = 0x8080808080808080;

/// Returns the high bits of the slots of a control word that are empty (0x80: the high bit set,
/// bit 1 clear).
fn emptiesOf(word: uint64): uint64 {
    return word & ~(word << 6) & highBits;
}

/// A hash map from keys to values: each key once, in no order of its own.
///
/// `H` hashes the keys: [DefaultHasher] under the process's key unless the map is given another
/// with [Map.withHasher]; the hasher is a value, copied fresh for every key. `map[k]` gives the
/// value under `k` or `null`; `map[k] = v` puts `v` there and `map[k] = null` removes `k`.
///
/// The table is a Swiss table: lookup, insertion and removal take expected constant time. The
/// control words lie in an array of their own, so a lookup that misses reads no slot; a slot holds
/// its key and value side by side, so a hit reads one. Not safe across threads.
pub class Map<K :: [Hashable], V, H :: [Hasher] = DefaultHasher> :: [Iterable] {
    type Iter = MapEntriesIter<K, V, H>;
    var controls: uint64[],
    var slots: (?MapSlot<K, V>)[],
    var count: int,
    var free: int,
    var changes: int,
    seed: H,

    /// Creates an empty map whose keys are hashed with `seed`.
    ///
    /// With a fixed hasher the order is the same in every run:
    /// `Map<string, int, FixedHasher>.withHasher(FixedHasher.new())`.
    pub static fn withHasher(seed: H): Map<K, V, H> {
        return Map<K, V, H> { controls = [], slots = [], count = 0, free = 0, changes = 0, seed = seed };
    }

    /// Returns how many keys it holds.
    pub fn length(): int {
        return this.count;
    }

    /// Returns whether it holds no keys.
    pub fn isEmpty(): bool {
        return this.count == 0;
    }

    /// Returns the value under `k`, or `null` where `k` is not there.
    pub fn get(k: K): ?V {
        let at = this.find(k, this.hashOf(k));
        if (at < 0) {
            return null;
        }
        return this.slots[at]!.value;
    }

    /// Returns whether it holds `k`.
    pub fn containsKey(k: K): bool {
        return this.find(k, this.hashOf(k)) >= 0;
    }

    /// Puts `v` under `k` and returns the value it replaces, or `null` where `k` was not there.
    pub mut fn insert(k: K, v: V): ?V {
        let hash = this.hashOf(k);
        let at = this.find(k, hash);
        if (at >= 0) {
            let old = this.slots[at]!.value;
            this.slots[at] = MapSlot<K, V> { key = k, value = v };
            return old;
        }
        if (this.free == 0) {
            this.rebuild();
        }
        this.place(k, v, hash);
        this.count = this.count + 1;
        this.changes = this.changes + 1;
        return null;
    }

    /// Removes `k` and returns its value, or `null` where `k` was not there.
    pub mut fn remove(k: K): ?V {
        let at = this.find(k, this.hashOf(k));
        if (at < 0) {
            return null;
        }
        let g = at / 8;
        let shift = ((at % 8) * 8) as uint64;
        let word = this.controls[g];
        // A group with an empty slot ends every probe through it, so no key lies beyond it on a
        // probe that passed it: the slot can be empty again. Otherwise it marks a deletion.
        var mark: uint64 = 254;
        if (emptiesOf(word) != 0) {
            mark = 128;
            this.free = this.free + 1;
        }
        this.controls[g] = (word & ~((255 as uint64) << shift)) | (mark << shift);
        let old = this.slots[at]!.value;
        this.slots[at] = null;
        this.count = this.count - 1;
        this.changes = this.changes + 1;
        return old;
    }

    /// Returns the value under `k`, or `otherwise` where `k` is not there.
    pub fn getOr(k: K, otherwise: V): V {
        let at = this.find(k, this.hashOf(k));
        if (at < 0) {
            return otherwise;
        }
        return this.slots[at]!.value;
    }

    /// Returns the value under `k`; where `k` is not there, inserts and returns what `make()` gives.
    ///
    /// `make` is called only when `k` is missing.
    ///
    /// # Errors
    ///
    /// Throws what `make` throws; the map is then unchanged.
    pub mut fn getOrInsert<E :: [Error]>(k: K, make: fn() -> V throws E): V throws E {
        let hash = this.hashOf(k);
        let at = this.find(k, hash);
        if (at >= 0) {
            return this.slots[at]!.value;
        }
        let made = try make();
        if (this.free == 0) {
            this.rebuild();
        }
        this.place(k, made, hash);
        this.count = this.count + 1;
        this.changes = this.changes + 1;
        return made;
    }

    /// Replaces the value under `k` with `f` of it and returns whether `k` was there.
    ///
    /// # Errors
    ///
    /// Throws what `f` throws; the value is then unchanged.
    pub mut fn update<E :: [Error]>(k: K, f: fn(V) -> V throws E): bool throws E {
        let at = this.find(k, this.hashOf(k));
        if (at < 0) {
            return false;
        }
        let slot = this.slots[at]!;
        this.slots[at] = MapSlot<K, V> { key = slot.key, value = try f(slot.value) };
        return true;
    }

    /// Removes the entries for which `p` does not hold and returns how many were removed.
    ///
    /// # Errors
    ///
    /// Throws what `p` throws; the entries already removed stay removed.
    pub mut fn retain<E :: [Error]>(p: fn(K, V) -> bool throws E): int throws E {
        var gone = 0;
        var at = 0;
        while (at < this.slots.length()) {
            if (let slot = this.slots[at]) {
                if (!(try p(slot.key, slot.value))) {
                    this.remove(slot.key);
                    gone = gone + 1;
                }
            }
            at = at + 1;
        }
        return gone;
    }

    /// Returns an iterator over the entries, `(K, V)`, in no order of the map's own.
    ///
    /// # Panics
    ///
    /// The next pull panics (`LYR-RT0016`) after a key is inserted or removed, or the map cleared,
    /// while the iterator walks.
    pub fn iter(): MapEntriesIter<K, V, H> {
        return MapEntriesIter<K, V, H> { map = this, at = 0, changes = this.changes };
    }

    /// Returns an iterator over the keys, in the order of [Map.iter].
    pub fn keys(): MapKeysIter<K, V, H> {
        return MapKeysIter<K, V, H> { entries = this.iter() };
    }

    /// Returns an iterator over the values, in the order of [Map.iter].
    pub fn values(): MapValuesIter<K, V, H> {
        return MapValuesIter<K, V, H> { entries = this.iter() };
    }

    /// Removes every key and frees the table.
    pub mut fn clear(): void {
        this.controls = [];
        this.slots = [];
        this.count = 0;
        this.free = 0;
        this.changes = this.changes + 1;
    }

    fn hashOf(k: K): uint64 {
        var h = this.seed;
        k.hash(&h);
        return h.finish();
    }

    /// Returns the slot holding `k`, or -1 where `k` is not there.
    ///
    /// Probes the groups triangularly from the hash's group, which visits every group once when
    /// their number is a power of two.
    fn find(k: K, hash: uint64): int {
        if (this.count == 0) {
            return -1;
        }
        let mask = this.controls.length() - 1;
        let pattern = (hash & 127) *% lowBits;
        var g = ((hash >> 7) as int) & mask;
        var step = 0;
        while (step <= mask) {
            let word = this.controls[g];
            let x = word ^ pattern;
            var hits = (x -% lowBits) & ~x & highBits;
            while (hits != 0) {
                let slot = g * 8 + hits.trailingZeros() / 8;
                // unwrapped: the key's own equality, not the optionals' (measurement point 3)
                if (let full = this.slots[slot]) {
                    if (full.key == k) {
                        return slot;
                    }
                }
                hits = hits & (hits -% 1);
            }
            if (emptiesOf(word) != 0) {
                return -1;
            }
            step = step + 1;
            g = (g + step) & mask;
        }
        return -1;
    }

    /// Puts `k` and `v` into the first slot along the probe that is not full; `k` must not be there.
    ///
    /// # Panics
    ///
    /// When no slot along the probe is free.
    mut fn place(k: K, v: V, hash: uint64): void {
        let mask = this.controls.length() - 1;
        let tag = hash & 127;
        var g = ((hash >> 7) as int) & mask;
        var step = 0;
        while (step <= mask) {
            let word = this.controls[g];
            let open = word & highBits;
            if (open != 0) {
                let j = open.trailingZeros() / 8;
                let shift = (8 * j) as uint64;
                if (((word >> shift) & 255) == 128) {
                    this.free = this.free - 1;
                }
                this.controls[g] = (word & ~((255 as uint64) << shift)) | (tag << shift);
                this.slots[g * 8 + j] = MapSlot<K, V> { key = k, value = v };
                return;
            }
            step = step + 1;
            g = (g + step) & mask;
        }
        panic("Map: a full table");
    }

    /// Allocates an empty table with room for `n` keys: the fewest groups, a power of two, whose
    /// seven usable slots in eight hold them.
    ///
    /// # Panics
    ///
    /// When `n` is negative.
    mut fn makeRoom(n: int): void {
        if (n < 0) {
            panic(f"Map.withCapacity: a negative capacity {n}");
        }
        if (n == 0) {
            return;
        }
        var groups = 1;
        while (groups * 7 < n) {
            groups = groups * 2;
        }
        this.controls = [emptyGroup] * groups;
        let empty: ?MapSlot<K, V> = null;
        this.slots = filled(groups * 8, empty);
        this.free = groups * 7;
    }

    /// Rebuilds the table, placing every key again and dropping the deletion marks.
    ///
    /// The new table has twice the groups (one where there were none), or as many where the keys
    /// fill less than half of the usable slots.
    mut fn rebuild(): void {
        let groups = this.controls.length();
        var next = 1;
        if (groups > 0) {
            next = if (this.count * 16 < groups * 56) groups else groups * 2;
        }
        let old = this.slots;
        this.controls = [emptyGroup] * next;
        // one allocation and a copy a slot, shared: 'null' in every slot (arrayOf called a function
        // a slot — the most of maps' cache misses before, B14). Not '[empty] * n', which asks a
        // generic element for Clone (03 §5.1; M8a S16 — every map over objects was refused).
        let empty: ?MapSlot<K, V> = null;
        this.slots = filled(next * 8, empty);
        this.free = next * 7;
        var i = 0;
        while (i < old.length()) {
            if (let slot = old[i]) {
                this.place(slot.key, slot.value, this.hashOf(slot.key));
            }
            i = i + 1;
        }
    }
}

/// Holds a key and its value side by side in a full slot of a map's table.
struct MapSlot<K, V> {
    key: K,
    value: V,
}

/// Iterates over a map's entries, `(K, V)`, slot by slot; made by [Map.iter].
///
/// # Panics
///
/// A pull panics (`LYR-RT0016`) when the map changed since the iterator was made.
pub struct MapEntriesIter<K :: [Hashable], V, H :: [Hasher]> :: [Iterator] {
    type Item = (K, V);
    map: Map<K, V, H>,
    var at: int,
    changes: int,
    /// The collection name the panic message shows: `"Set"` when a set walks its table.
    label: string = "Map",

    pub mut fn next(): ?(K, V) {
        if (this.map.changes != this.changes) {
            changedWhileWalked(this.label);
        }
        while (this.at < this.map.slots.length()) {
            let slot = this.map.slots[this.at];
            this.at = this.at + 1;
            if (let full = slot) {
                let entry: (K, V) = (full.key, full.value);
                return entry;
            }
        }
        return null;
    }
}

/// Iterates over a map's keys or a set's values; made by [Map.keys] and [Set.iter].
pub struct MapKeysIter<K :: [Hashable], V, H :: [Hasher]> :: [Iterator] {
    type Item = K;
    var entries: MapEntriesIter<K, V, H>,

    pub mut fn next(): ?K {
        let e = this.entries.next();
        if (e == null) {
            return null;
        }
        let (k, _) = e;
        return k;
    }
}

/// Iterates over a map's values; made by [Map.values].
pub struct MapValuesIter<K :: [Hashable], V, H :: [Hasher]> :: [Iterator] {
    type Item = V;
    var entries: MapEntriesIter<K, V, H>,

    pub mut fn next(): ?V {
        let e = this.entries.next();
        if (e == null) {
            return null;
        }
        let (_, v) = e;
        return v;
    }
}

/// Panics because the collection `what` changed while it was walked.
///
/// The panic has the code `LYR-RT0016` and a message such as "List: changed while it was walked".
/// Implemented by the runtime.
fn changedWhileWalked(what: string): never;

// --- Set (10 C5): a Map's keys -----------------------------------------------------------------

/// A hash set: values, each once, in no order of its own.
///
/// It is a [Map]'s keys over the same table, so membership, insertion and removal take expected
/// constant time. `x in set` is `set.contains(x)`. The set operations — [Set.union],
/// [Set.intersect], [Set.difference], [Set.symmetricDifference] — are methods that return a new
/// set. Not safe across threads.
pub class Set<T :: [Hashable], H :: [Hasher] = DefaultHasher> :: [Iterable, Contains<T>] {
    type Iter = MapKeysIter<T, bool, H>;
    var table: Map<T, bool, H>,

    /// Creates an empty set whose values are hashed with `seed`.
    pub static fn withHasher(seed: H): Set<T, H> {
        return Set<T, H> { table = Map<T, bool, H>.withHasher(seed) };
    }

    /// Returns how many values it holds.
    pub fn length(): int {
        return this.table.length();
    }

    /// Returns whether it holds no values.
    pub fn isEmpty(): bool {
        return this.table.isEmpty();
    }

    /// Returns whether it holds `v`.
    pub fn contains(v: T): bool {
        return this.table.containsKey(v);
    }

    /// Adds `v` and returns whether it was not there before.
    pub mut fn insert(v: T): bool {
        return this.table.insert(v, true) == null;
    }

    /// Removes `v` and returns whether it was there.
    pub mut fn remove(v: T): bool {
        return this.table.remove(v) != null;
    }

    /// Removes every value.
    pub mut fn clear(): void {
        this.table.clear();
    }

    /// Returns an iterator over the values, in no order of the set's own.
    ///
    /// # Panics
    ///
    /// The next pull panics (`LYR-RT0016`) after a value is inserted or removed, or the set
    /// cleared, while the iterator walks.
    pub fn iter(): MapKeysIter<T, bool, H> {
        return MapKeysIter<T, bool, H> {
            entries = MapEntriesIter<T, bool, H> { map = this.table, at = 0, changes = this.table.changes, label = "Set" },
        };
    }
}

extend<T :: [Hashable]> Set<T, DefaultHasher> {
    /// Creates an empty set hashing with the process's key; its order differs from run to run.
    pub static fn new(): Set<T, DefaultHasher> {
        return Set<T, DefaultHasher>.withHasher(DefaultHasher.new());
    }

    /// Creates a set of the array's elements, each once.
    pub static fn of(xs: T[]): Set<T, DefaultHasher> {
        let out = Set<T, DefaultHasher>.new();
        for (x in xs) {
            let _ = out.insert(x);
        }
        return out;
    }

    /// Creates an empty set with room for `n` values before it grows.
    ///
    /// # Panics
    ///
    /// When `n` is negative.
    pub static fn withCapacity(n: int): Set<T, DefaultHasher> {
        return Set<T, DefaultHasher> { table = Map<T, bool, DefaultHasher>.withCapacity(n) };
    }
}

// --- the map's index, the entries, a set's operations (10 C4, C5) --------------------------------

// `map[k]` is the value under `k` or `null`; `map[k] = v` puts `v` there, and `map[k] = null` takes `k`
// out, as Swift's dictionary does — the index gives an optional, so the place takes one.
extend<K :: [Hashable], V, H :: [Hasher]> Map<K, V, H> :: [IndexSet<K>] {
    type Output = ?V;

    fn index(k: K): ?V {
        return this.get(k);
    }

    mut fn setIndex(k: K, v: ?V): void {
        if (let value = v) {
            let _ = this.insert(k, value);
        } else {
            let _ = this.remove(k);
        }
    }
}

extend<K :: [Hashable], V, H :: [Hasher]> Map<K, V, H> {
    /// Returns an iterator over the entries, `(K, V)`, in no order of the map's own; the same as
    /// [Map.iter].
    pub fn entries(): MapEntriesIter<K, V, H> {
        return this.iter();
    }
}

// A set's operations are methods (10 C5): each makes a new set hashing as this one does, or answers
// a question; no operators.
extend<T :: [Hashable], H :: [Hasher]> Set<T, H> {
    /// Returns a new set of the values in either set, hashing as this one does.
    pub fn union(other: Set<T, H>): Set<T, H> {
        let out = Set<T, H>.withHasher(this.table.seed);
        for (x in this) {
            let _ = out.insert(x);
        }
        for (x in other) {
            let _ = out.insert(x);
        }
        return out;
    }

    /// Returns a new set of the values in both sets, hashing as this one does.
    pub fn intersect(other: Set<T, H>): Set<T, H> {
        let out = Set<T, H>.withHasher(this.table.seed);
        for (x in this) {
            if (other.contains(x)) {
                let _ = out.insert(x);
            }
        }
        return out;
    }

    /// Returns a new set of the values in this set but not in `other`, hashing as this one does.
    pub fn difference(other: Set<T, H>): Set<T, H> {
        let out = Set<T, H>.withHasher(this.table.seed);
        for (x in this) {
            if (!other.contains(x)) {
                let _ = out.insert(x);
            }
        }
        return out;
    }

    /// Returns a new set of the values in exactly one of the two sets, hashing as this one does.
    pub fn symmetricDifference(other: Set<T, H>): Set<T, H> {
        let out = this.difference(other);
        for (x in other) {
            if (!this.contains(x)) {
                let _ = out.insert(x);
            }
        }
        return out;
    }

    /// Returns whether every value of this set is in `other`.
    ///
    /// The empty set is a subset of every set.
    pub fn isSubset(other: Set<T, H>): bool {
        for (x in this) {
            if (!other.contains(x)) {
                return false;
            }
        }
        return true;
    }

    /// Returns whether every value of `other` is in this set.
    pub fn isSuperset(other: Set<T, H>): bool {
        return other.isSubset(this);
    }

    /// Returns whether the two sets have no value in common.
    pub fn isDisjoint(other: Set<T, H>): bool {
        for (x in this) {
            if (other.contains(x)) {
                return false;
            }
        }
        return true;
    }
}

// --- from array literals (10 K4) ----------------------------------------------------------------

extend<T> List<T> :: [FromArrayLiteral<T>] {
    static fn fromLiteral(items: T[]): List<T> {
        return List<T>.of(items);
    }
}

extend<T :: [Hashable]> Set<T, DefaultHasher> :: [FromArrayLiteral<T>] {
    static fn fromLiteral(items: T[]): Set<T, DefaultHasher> {
        return Set<T, DefaultHasher>.of(items);
    }
}

extend<K :: [Hashable], V> Map<K, V, DefaultHasher> :: [FromArrayLiteral<(K, V)>] {
    static fn fromLiteral(items: (K, V)[]): Map<K, V, DefaultHasher> {
        return Map<K, V, DefaultHasher>.from(items[..]);
    }
}

extend<T> Deque<T> :: [FromArrayLiteral<T>] {
    static fn fromLiteral(items: T[]): Deque<T> {
        let out = Deque<T>.new();
        for (x in items) {
            out.pushBack(x);
        }
        return out;
    }
}

extend<T :: [TotalOrder]> Heap<T> :: [FromArrayLiteral<T>] {
    static fn fromLiteral(items: T[]): Heap<T> {
        return Heap<T>.of(items);
    }
}

// --- from iterators (10 I4) ----------------------------------------------------------------------

extend<I :: [Iterator]> I {
    /// Collects the values into a new list, in order.
    ///
    /// The list starts with room for the iterator's lower `sizeHint`.
    ///
    /// # Errors
    ///
    /// Throws what a pull of the iterator throws.
    pub fn toList(): List<I.Item> throws I.Error {
        var it = this;
        let out = List<I.Item>.withCapacity(it.sizeHint().0);
        var x = try it.next();
        while (x != null) {
            out.push(x);
            x = try it.next();
        }
        return out;
    }
}


/// Yields the values of an iterator in lists of `n`; made by `it.chunks(n)`.
///
/// The last list is shorter where the values do not divide evenly.
pub struct ChunksIter<I :: [Iterator]> :: [Iterator] {
    type Item = List<I.Item>;
    type Error = I.Error;
    var inner: I,
    n: int,

    pub mut fn next(): ?List<I.Item> throws I.Error {
        let chunk = List<I.Item>.withCapacity(this.n);
        while (chunk.length() < this.n) {
            let x = try this.inner.next();
            if (x == null) {
                break;
            }
            chunk.push(x);
        }
        if (chunk.isEmpty()) {
            return null;
        }
        return chunk;
    }
}

/// Yields every run of `n` consecutive values of an iterator in turn, each in a new list; made by
/// `it.windows(n)`.
///
/// Yields nothing where there are fewer than `n` values.
pub struct WindowsIter<I :: [Iterator]> :: [Iterator] {
    type Item = List<I.Item>;
    type Error = I.Error;
    var inner: I,
    n: int,
    window: List<I.Item>,

    pub mut fn next(): ?List<I.Item> throws I.Error {
        if (this.window.isEmpty()) {
            while (this.window.length() < this.n) {
                let x = try this.inner.next();
                if (x == null) {
                    return null;
                }
                this.window.push(x);
            }
        } else {
            let x = try this.inner.next();
            if (x == null) {
                return null;
            }
            let _ = this.window.removeAt(0);
            this.window.push(x);
        }
        return List.of(this.window.toArray());
    }
}

extend<I :: [Iterator, Closeable]> ChunksIter<I> :: [Closeable] {
    fn close(): void throws I.Error {
        try this.inner.close();
    }
}

extend<I :: [Iterator, Closeable]> WindowsIter<I> :: [Closeable] {
    fn close(): void throws I.Error {
        try this.inner.close();
    }
}

extend<I :: [Iterator]> I {
    /// Returns an iterator over the values in lists of `n`, the last one possibly shorter.
    ///
    /// # Panics
    ///
    /// When `n` is less than 1.
    pub fn chunks(n: int): ChunksIter<I> {
        if (n < 1) {
            panic(f"chunks: {n} values a chunk");
        }
        return ChunksIter<I> { inner = this, n = n };
    }

    /// Returns an iterator over every run of `n` consecutive values, each in a new list.
    ///
    /// # Panics
    ///
    /// When `n` is less than 1.
    pub fn windows(n: int): WindowsIter<I> {
        if (n < 1) {
            panic(f"windows: {n} values a window");
        }
        return WindowsIter<I> { inner = this, n = n, window = List<I.Item>.withCapacity(n) };
    }

    /// Returns the values in a new list, sorted by `cmp`.
    ///
    /// The sort is stable: equal values keep their order.
    ///
    /// # Errors
    ///
    /// Throws what a pull of the iterator or `cmp` throws, as the view's `sortBy` does.
    pub fn sortedBy<E :: [Error]>(cmp: fn(I.Item, I.Item) -> Ordering throws E): List<I.Item> throws Join<I.Error, E> {
        let out = try this.toList();
        try out.asSlice().sortBy(cmp);
        return out;
    }

    /// Splits the values into two new lists: those for which `p` holds and the others, each in order.
    ///
    /// # Errors
    ///
    /// Throws what a pull of the iterator or `p` throws.
    pub fn partition<E :: [Error]>(p: fn(I.Item) -> bool throws E): (List<I.Item>, List<I.Item>) throws Join<I.Error, E> {
        var it = this;
        let yes = List<I.Item>.new();
        let no = List<I.Item>.new();
        var x = try it.next();
        while (x != null) {
            if (try p(x)) {
                yes.push(x);
            } else {
                no.push(x);
            }
            x = try it.next();
        }
        let both: (List<I.Item>, List<I.Item>) = (yes, no);
        return both;
    }

    /// Groups the values into a new map from each `key` to the list of values with that key.
    ///
    /// Eager: walks the whole iterator. Each list keeps the values' order.
    ///
    /// # Errors
    ///
    /// Throws what a pull of the iterator or `key` throws.
    pub fn groupBy<K :: [Hashable], E :: [Error]>(key: fn(I.Item) -> K throws E): Map<K, List<I.Item>, DefaultHasher> throws Join<I.Error, E> {
        var it = this;
        let out = Map<K, List<I.Item>, DefaultHasher>.new();
        var x = try it.next();
        while (x != null) {
            let k = try key(x);
            let group = out.getOrInsert(k, () => List<I.Item>.new());
            group.push(x);
            x = try it.next();
        }
        return out;
    }
}

extend<I :: [Iterator<Item = T>], T :: [TotalOrder]> I {
    /// Returns the values in a new list, in ascending order.
    ///
    /// The sort is stable: equal values keep their order.
    ///
    /// # Errors
    ///
    /// Throws what a pull of the iterator throws.
    pub fn sorted(): List<T> throws I.Error {
        let out: List<T> = try this.toList();
        out.asSlice().sort();
        return out;
    }
}

extend<I :: [Iterator<Item = (K, V)>], K :: [Hashable], V> I {
    /// Collects the pairs into a new map; a later value of a key replaces the earlier one.
    ///
    /// # Errors
    ///
    /// Throws what a pull of the iterator throws.
    pub fn toMap(): Map<K, V, DefaultHasher> throws I.Error {
        let out: Map<K, V, DefaultHasher> = try this.collect();
        return out;
    }
}
extend<K :: [Hashable], V> Map<K, V, DefaultHasher> {
    /// Creates an empty map hashing with the process's key; its order differs from run to run.
    pub static fn new(): Map<K, V, DefaultHasher> {
        return Map<K, V, DefaultHasher>.withHasher(DefaultHasher.new());
    }

    /// Creates a map of the pairs: `Map.from([("a", 1), ("b", 2)])`.
    ///
    /// A later value of a key replaces the earlier one.
    pub static fn from(pairs: Slice<(K, V)>): Map<K, V, DefaultHasher> {
        let out = Map<K, V, DefaultHasher>.withCapacity(pairs.length());
        for (p in pairs) {
            let _ = out.insert(p.0, p.1);
        }
        return out;
    }

    /// Creates an empty map with room for `n` keys before it grows.
    ///
    /// # Panics
    ///
    /// When `n` is negative.
    pub static fn withCapacity(n: int): Map<K, V, DefaultHasher> {
        let map = Map<K, V, DefaultHasher>.withHasher(DefaultHasher.new());
        map.makeRoom(n);
        return map;
    }
}

// --- Deque (10 C6) -------------------------------------------------------------------------------
// The values lie in a ring: `count` of them from `head` on, wrapping at the buffer's end; a full
// ring is copied, in order, into one twice its size. A slot no value holds is `null`, so the buffer
// keeps nothing alive.

/// A double-ended queue: values pushed and popped at either end in amortized constant time.
///
/// The values lie in a ring buffer that doubles when full. `deque[i]` counts from the front; an
/// iterator walks front to back. Not safe across threads.
///
/// # Panics
///
/// `deque[i]` panics outside `0 ≤ i < length()`.
pub class Deque<T> :: [Index<int>, Iterable] {
    type Output = T;
    type Iter = DequeIter<T>;
    var slots: (?T)[],
    var head: int,
    var count: int,
    var changes: int,

    /// Creates an empty deque.
    pub static fn new(): Deque<T> {
        return Deque<T> { slots = [], head = 0, count = 0, changes = 0 };
    }

    /// Creates an empty deque with room for `n` values before it grows.
    ///
    /// # Panics
    ///
    /// When `n` is negative.
    pub static fn withCapacity(n: int): Deque<T> {
        if (n < 0) {
            panic(f"Deque.withCapacity: a negative capacity {n}");
        }
        let none: ?T = null;
        return Deque<T> { slots = filled(n, none), head = 0, count = 0, changes = 0 };
    }

    /// Returns how many values it holds.
    pub fn length(): int {
        return this.count;
    }

    /// Returns whether it holds no values.
    pub fn isEmpty(): bool {
        return this.count == 0;
    }

    /// Appends `v` at the back.
    pub mut fn pushBack(v: T): void {
        this.grow();
        this.slots[this.slotOf(this.count)] = v;
        this.count = this.count + 1;
        this.changes = this.changes + 1;
    }

    /// Prepends `v` at the front.
    pub mut fn pushFront(v: T): void {
        this.grow();
        this.head = this.slotOf(this.slots.length() - 1);
        this.slots[this.head] = v;
        this.count = this.count + 1;
        this.changes = this.changes + 1;
    }

    /// Removes and returns the front value, or `null` where there is none.
    pub mut fn popFront(): ?T {
        if (this.count == 0) {
            return null;
        }
        let v = this.slots[this.head];
        this.slots[this.head] = null;
        this.head = this.slotOf(1);
        this.count = this.count - 1;
        this.changes = this.changes + 1;
        return v;
    }

    /// Removes and returns the back value, or `null` where there is none.
    pub mut fn popBack(): ?T {
        if (this.count == 0) {
            return null;
        }
        let at = this.slotOf(this.count - 1);
        let v = this.slots[at];
        this.slots[at] = null;
        this.count = this.count - 1;
        this.changes = this.changes + 1;
        return v;
    }

    /// Returns the front value without removing it, or `null` where there is none.
    pub fn peekFront(): ?T {
        if (this.count == 0) {
            return null;
        }
        return this.slots[this.head];
    }

    /// Returns the back value without removing it, or `null` where there is none.
    pub fn peekBack(): ?T {
        if (this.count == 0) {
            return null;
        }
        return this.slots[this.slotOf(this.count - 1)];
    }

    /// Returns the value `i` places from the front; this is `deque[i]`.
    ///
    /// # Panics
    ///
    /// Outside `0 ≤ i < length()`, with `LYR-RT0003`.
    pub fn index(i: int): T {
        if (i < 0 || i >= this.count) {
            // the bounds checked as an array's are, on a view of `count` slots: it panics
            return this.slots[..this.count][i] ?? unreachable();
        }
        return this.slots[this.slotOf(i)] ?? unreachable();
    }

    /// Returns an iterator over the values, front to back.
    ///
    /// # Panics
    ///
    /// The next pull panics (`LYR-RT0016`) after a push or a pop while the iterator walks.
    pub fn iter(): DequeIter<T> {
        return DequeIter<T> { deque = this, at = 0, changes = this.changes };
    }

    /// Returns the slot `offset` places past the head, around the ring.
    fn slotOf(offset: int): int {
        return (this.head + offset) % this.slots.length();
    }

    /// Makes room for one more value: a full ring is copied, from its head on, into one twice its
    /// size (at least 8).
    mut fn grow(): void {
        if (this.count < this.slots.length()) {
            return;
        }
        let room = if (this.slots.length() == 0) 8 else this.slots.length() * 2;
        let old = this.slots;
        let none: ?T = null;
        let grown = filled(room, none);
        if (old.length() > 0) {
            // the ring from its head to its end, then what wrapped to the front: two copies (B16)
            let tail = old.length() - this.head;
            old[this.head..old.length()].copyInto(grown[..tail]);
            old[..this.head].copyInto(grown[tail..old.length()]);
        }
        this.slots = grown;
        this.head = 0;
    }
}

/// Iterates over a deque's values, front to back; made by [Deque.iter].
///
/// # Panics
///
/// A pull panics (`LYR-RT0016`) when the deque changed since the iterator was made.
pub struct DequeIter<T> :: [Iterator] {
    type Item = T;
    deque: Deque<T>,
    var at: int,
    changes: int,

    pub mut fn next(): ?T {
        if (this.deque.changes != this.changes) {
            changedWhileWalked("Deque");
        }
        if (this.at >= this.deque.count) {
            return null;
        }
        this.at = this.at + 1;
        return this.deque.slots[this.deque.slotOf(this.at - 1)];
    }
}

// --- Heap (10 C1) --------------------------------------------------------------------------------
// A binary tree laid out in a list: the children of `i` at `2i + 1` and `2i + 2`, no value less
// than its parent.

/// A binary min-heap: [Heap.peek] and [Heap.pop] give the least value.
///
/// `push` and `pop` take `log n` steps, `peek` constant time; the values lie in a list. For the
/// greatest value first, use a type whose order is reversed. Not safe across threads.
pub class Heap<T :: [TotalOrder]> {
    var items: List<T>,

    /// Creates an empty heap.
    pub static fn new(): Heap<T> {
        return Heap<T> { items = List<T>.new() };
    }

    /// Creates an empty heap with room for `n` values before it grows.
    ///
    /// # Panics
    ///
    /// When `n` is negative.
    pub static fn withCapacity(n: int): Heap<T> {
        return Heap<T> { items = List<T>.withCapacity(n) };
    }

    /// Creates a heap of the array's values, copied.
    ///
    /// Builds the heap in linear time by sinking each parent to its place, from the last one up
    /// (Floyd's method); pushing the values one by one would take `n log n`.
    pub static fn of(xs: T[]): Heap<T> {
        let heap = Heap<T> { items = List<T>.of(xs) };
        var at = xs.length() / 2 - 1;
        while (at >= 0) {
            heap.sink(at, xs.length());
            at = at - 1;
        }
        return heap;
    }

    /// Returns how many values it holds.
    pub fn length(): int {
        return this.items.length();
    }

    /// Returns whether it holds no values.
    pub fn isEmpty(): bool {
        return this.items.isEmpty();
    }

    /// Returns the least value without removing it, or `null` where there is none.
    pub fn peek(): ?T {
        return this.items.get(0);
    }

    /// Adds `v`, letting it rise to its place, in `log n` steps.
    pub mut fn push(v: T): void {
        this.items.push(v);
        var at = this.items.length() - 1;
        while (at > 0) {
            let parent = (at - 1) / 2;
            if (!less(this.items[at], this.items[parent])) {
                break;
            }
            this.items.swap(at, parent);
            at = parent;
        }
    }

    /// Removes and returns the least value, or `null` where there is none.
    ///
    /// The last value is put at the top and sunk to its place, in `log n` steps.
    pub mut fn pop(): ?T {
        let n = this.items.length();
        if (n == 0) {
            return null;
        }
        this.items.swap(0, n - 1);
        let top = this.items.pop();
        this.sink(0, n - 1);
        return top;
    }

    /// Sinks the value at `from` below every child less than it, among the first `m` values.
    mut fn sink(from: int, m: int): void {
        var at = from;
        while (true) {
            let left = 2 * at + 1;
            if (left >= m) {
                break;
            }
            var child = left;
            if (left + 1 < m && less(this.items[left + 1], this.items[left])) {
                child = left + 1;
            }
            if (!less(this.items[child], this.items[at])) {
                break;
            }
            this.items.swap(at, child);
            at = child;
        }
    }
}

/// Returns whether `a` comes before `b` in their total order.
fn less<T :: [TotalOrder]>(a: T, b: T): bool {
    return match (a.totalCompare(b)) {
        .Less => true,
        _ => false,
    };
}

// --- equality and display (10 C9; M8a S14) -------------------------------------------------------
// A list and a deque compare element by element in order, a set by its values and a map by its
// entries, in any order; each writes its debug text — `[1, 2]`, `{1, 2}`, `{"a": 1}` — and shows
// the same (C9). A heap writes its values in its own order, which no program may rely on.

extend<T :: [Equatable]> List<T> :: [Equatable] {
    fn equals(o: List<T>): bool {
        return this.asSlice() == o.asSlice();
    }
}

extend<T :: [Debug]> List<T> :: [Debug, Display] {
    fn debug(): string {
        return this.asSlice().debug();
    }

    fn debugTo(out: StringBuilder): void {
        this.asSlice().debugTo(out);
    }

    fn show(): string {
        return this.asSlice().debug();
    }

    fn showTo(out: StringBuilder): void {
        this.asSlice().debugTo(out);
    }
}

extend<T :: [Equatable]> Deque<T> :: [Equatable] {
    fn equals(o: Deque<T>): bool {
        if (this.count != o.count) {
            return false;
        }
        for (i in 0..this.count) {
            if (!(this[i] == o[i])) {
                return false;
            }
        }
        return true;
    }
}

extend<T :: [Debug]> Deque<T> :: [Debug, Display] {
    fn debug(): string {
        let out = StringBuilder.new();
        this.debugTo(out);
        return out.toString();
    }

    fn debugTo(out: StringBuilder): void {
        out.appendChar('[');
        for (i in 0..this.count) {
            if (i > 0) {
                out.appendStr(", ");
            }
            this[i].debugTo(out);
        }
        out.appendChar(']');
    }

    fn show(): string {
        return this.debug();
    }

    fn showTo(out: StringBuilder): void {
        this.debugTo(out);
    }
}

extend<T :: [Hashable], H :: [Hasher]> Set<T, H> :: [Equatable] {
    fn equals(o: Set<T, H>): bool {
        if (this.length() != o.length()) {
            return false;
        }
        for (v in this) {
            if (!o.contains(v)) {
                return false;
            }
        }
        return true;
    }
}

extend<T :: [Hashable, Debug], H :: [Hasher]> Set<T, H> :: [Debug, Display] {
    fn debug(): string {
        let out = StringBuilder.new();
        this.debugTo(out);
        return out.toString();
    }

    fn debugTo(out: StringBuilder): void {
        out.appendChar('{');
        var first = true;
        for (v in this) {
            if (!first) {
                out.appendStr(", ");
            }
            first = false;
            v.debugTo(out);
        }
        out.appendChar('}');
    }

    fn show(): string {
        return this.debug();
    }

    fn showTo(out: StringBuilder): void {
        this.debugTo(out);
    }
}

extend<K :: [Hashable], V :: [Equatable], H :: [Hasher]> Map<K, V, H> :: [Equatable] {
    fn equals(o: Map<K, V, H>): bool {
        if (this.length() != o.length()) {
            return false;
        }
        for (entry in this) {
            let (k, v) = entry;
            let theirs = o.get(k);
            if (theirs == null) {
                return false;
            }
            if (!(theirs == v)) {
                return false;
            }
        }
        return true;
    }
}

extend<K :: [Hashable, Debug], V :: [Debug], H :: [Hasher]> Map<K, V, H> :: [Debug, Display] {
    fn debug(): string {
        let out = StringBuilder.new();
        this.debugTo(out);
        return out.toString();
    }

    fn debugTo(out: StringBuilder): void {
        out.appendChar('{');
        var first = true;
        for (entry in this) {
            let (k, v) = entry;
            if (!first) {
                out.appendStr(", ");
            }
            first = false;
            k.debugTo(out);
            out.appendStr(": ");
            v.debugTo(out);
        }
        out.appendChar('}');
    }

    fn show(): string {
        return this.debug();
    }

    fn showTo(out: StringBuilder): void {
        this.debugTo(out);
    }
}

extend<T :: [TotalOrder, Debug]> Heap<T> :: [Debug] {
    fn debug(): string {
        return this.items.debug();
    }

    fn debugTo(out: StringBuilder): void {
        this.items.debugTo(out);
    }
}

// --- built from an iterator (10 B6, I4; M8a S15) ------------------------------------------------
// Each container is a `FromIterator`: `collect()` into it, the values in the iterator's order — a
// set's and a map's keys once each, a later value of a key replacing the earlier one.

extend<T> List<T> :: [FromIterator<T>] {
    static fn fromIter<I :: [Iterator<Item = T>]>(it: I): List<T> throws I.Error {
        return try it.toList();
    }
}

extend<T> Deque<T> :: [FromIterator<T>] {
    static fn fromIter<I :: [Iterator<Item = T>]>(it: I): Deque<T> throws I.Error {
        let out = Deque<T>.new();
        var walk = it;
        var x = try walk.next();
        while (x != null) {
            out.pushBack(x);
            x = try walk.next();
        }
        return out;
    }
}

extend<T :: [Hashable]> Set<T, DefaultHasher> :: [FromIterator<T>] {
    static fn fromIter<I :: [Iterator<Item = T>]>(it: I): Set<T, DefaultHasher> throws I.Error {
        let out = Set<T, DefaultHasher>.new();
        var walk = it;
        var x = try walk.next();
        while (x != null) {
            out.insert(x);
            x = try walk.next();
        }
        return out;
    }
}

extend<K :: [Hashable], V> Map<K, V, DefaultHasher> :: [FromIterator<(K, V)>] {
    static fn fromIter<I :: [Iterator<Item = (K, V)>]>(it: I): Map<K, V, DefaultHasher> throws I.Error {
        let out = Map<K, V, DefaultHasher>.new();
        var walk = it;
        var x = try walk.next();
        while (x != null) {
            let (k, v) = x;
            out.insert(k, v);
            x = try walk.next();
        }
        return out;
    }
}

extend<T :: [TotalOrder]> Heap<T> :: [FromIterator<T>] {
    /// Creates a heap of the iterator's values, built at once as [Heap.of] does.
    ///
    /// # Errors
    ///
    /// Throws what a pull of `it` throws.
    static fn fromIter<I :: [Iterator<Item = T>]>(it: I): Heap<T> throws I.Error {
        return Heap<T>.of(try it.toArray());
    }
}

extend<I :: [Iterator<Item = T>], T :: [Hashable]> I {
    /// Collects the values into a new set, each once.
    ///
    /// # Errors
    ///
    /// Throws what a pull of the iterator throws.
    pub fn toSet(): Set<T> throws I.Error {
        let out: Set<T> = try this.collect();
        return out;
    }
}

// --- membership (05 §12 rule 10; 10 C12; M8a S15) -----------------------------------------------
// A list and a set hold their values, a map its keys: `k in map` is `map.containsKey(k)`.

extend<T :: [Equatable]> List<T> :: [Contains<T>] {
    /// Returns whether an element equals `x`; this is `x in list`.
    fn contains(x: T): bool {
        return this.asSlice().contains(x);
    }
}

extend<K :: [Hashable], V, H :: [Hasher]> Map<K, V, H> :: [Contains<K>] {
    /// Returns whether `k` is one of the keys; this is `k in map`.
    fn contains(k: K): bool {
        return this.containsKey(k);
    }
}

// --- Clone (10 K5; N2a) ------------------------------------------------------------------------
//
// A container is Clone where its elements are: a new container of their clones, as deep as the
// element type owns (K5) — a map keeps its hasher, a heap its order, a deque its order from the
// front.

extend<T :: [Clone]> List<T> :: [Clone] {
    fn clone(): List<T> {
        let out = List<T>.withCapacity(this.length());
        for (x in this) {
            out.push(x.clone());
        }
        return out;
    }
}

extend<K :: [Hashable, Clone], V :: [Clone], H :: [Hasher]> Map<K, V, H> :: [Clone] {
    fn clone(): Map<K, V, H> {
        let out = Map<K, V, H>.withHasher(this.seed);
        for (entry in this) {
            out.insert(entry.0.clone(), entry.1.clone());
        }
        return out;
    }
}

extend<T :: [Hashable, Clone], H :: [Hasher]> Set<T, H> :: [Clone] {
    fn clone(): Set<T, H> {
        return Set<T, H> { table = this.table.clone() };
    }
}

extend<T :: [Clone]> Deque<T> :: [Clone] {
    fn clone(): Deque<T> {
        let out = Deque<T>.withCapacity(this.length());
        for (x in this) {
            out.pushBack(x.clone());
        }
        return out;
    }
}

extend<T :: [TotalOrder, Clone]> Heap<T> :: [Clone] {
    fn clone(): Heap<T> {
        return Heap<T> { items = this.items.clone() };
    }
}
