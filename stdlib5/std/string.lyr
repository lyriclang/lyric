/// The string helpers the compiler itself calls (design/v5/spec/10 S-series): f-strings and `+`
/// on strings lower to these by name. M2 seed, natively backed; M8a brings the module in Lyric.


pub import std.core { StringBuilder };

pub fn concat(a: string, b: string): string;
pub fn fromInt(value: int): string;
pub fn fromUint(value: uint): string;
/// The shortest decimal text that reads back as the same value; `inf`, `-inf` and `NaN` for
/// the values that are no number.
pub fn fromFloat(value: float): string;
/// A `float32`'s own shortest text (03 §1.7): `0.1`, not the `0.10000000149011612` of the `float`
/// it widens to.
pub fn fromFloat32(value: float32): string;
/// The character as a one-character string.
pub fn fromChar(value: char): string;
pub fn fromBool(value: bool): string;
