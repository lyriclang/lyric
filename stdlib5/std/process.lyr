//! Starts child processes and talks to them. A [Command] says what to start, [Command.spawn]
//! starts it as a [Child] — its standard streams pipes ([PipeReader], [PipeWriter]) where the
//! command asked for them —, and [Child.wait] waits for its end as an [ExitStatus];
//! [Command.output] and [Command.status] do it all at once.
//!
//! A child's end comes as SIGCHLD, which the runtime keeps for itself: a reaper on a thread of its
//! own asks each child that has not been seen to end (lyr/process.h), and an end wakes every task
//! that waits for it, on any thread. Waiting is a point of cancellation: a cancel ends it. On
//! Windows a child is its process handle, its end wakes the reaper from a registered wait, and a
//! kill is the only signal there is.
//!
//! # Examples
//!
//! ```lyric,no_run
//! import std.io { println };
//! import std.process { Command };
//!
//! fn main(): void throws Error {
//!     let run = Command { program = "git", args = ["--version"], stdout = .Piped };
//!     let out = try run.output();
//!     println(out.status.success());
//! }
//! ```
import std.collections { List };
import std.core { StringBuilder, viewBytes };
import std.io { IoError, Reader, Writer, failure };
import std.os { Signal, numberOf, signalOf };
import std.task;
import std.task { Cancelled, Channel, SpinLock, Waits, awaitDescriptor, forgetDescriptor, here };
import std.thread { Thread };

fn processSpawn(
    program: string,
    args: Slice<uint8>,
    argc: int,
    env: Slice<uint8>,
    envc: int,
    cwd: string,
    modes: int,
    ends: Slice<int>
): int;
fn processAttach(): void;
fn processNudge(): void;
fn processReap(pid: int): int;
fn processSignal(pid: int, number: int): int;
fn processRead(fd: int, into: Slice<uint8>): int;
fn processWrite(fd: int, from: Slice<uint8>): int;
fn processClose(fd: int): int;

/// The answer of a call that would block (lyr/net.h).
let wouldBlock = -(64 << 32);

/// lyr/process.h's mark of an end by a signal: bit 40, above any exit code.
let signalled = 1 << 40;

/// What a child's standard stream is connected to: the parent's, a pipe to the parent, or nothing.
pub enum Stdio :: [Equatable, Debug] {
    Inherit,
    Piped,
    Null,
}

/// Describes a process to start: the program — a path, or a name looked up on PATH —, its
/// arguments, its working directory (the parent's where `null`), variables set over the parent's
/// environment, and its three standard streams.
pub struct Command {
    pub program: string,
    pub args: string[] = [],
    pub cwd: ?string = null,
    pub env: (string, string)[] = [],
    pub stdin: Stdio = Stdio.Inherit,
    pub stdout: Stdio = Stdio.Inherit,
    pub stderr: Stdio = Stdio.Inherit,

    /// Starts the process and returns it as a [Child].
    ///
    /// # Errors
    /// Throws [IoError]: `NotFound` for a program that is not there, `PermissionDenied` for one
    /// that may not run — each with the program as the path —, and `InvalidInput` for a variable
    /// name that is empty or holds `=`, or a NUL in an argument or a variable.
    pub fn spawn(): Child throws IoError {
        let nul = char.fromUint32(0u32)!;
        let args = StringBuilder.new();
        try appendPart(args, this.program, nul);
        for (a in this.args) {
            try appendPart(args, a, nul);
        }
        let env = StringBuilder.new();
        for (pair in this.env) {
            let (name, value) = pair;
            if (name.isEmpty() || name.contains("=")) {
                throw IoError {
                    kind = .InvalidInput,
                    path = this.program,
                    detail = f"a variable named '{name}'",
                };
            }
            try appendPart(env, f"{name}={value}", nul);
        }
        let modes = modeOf(this.stdin) | (modeOf(this.stdout) << 2) | (modeOf(this.stderr) << 4);
        let ends: int[] = [-1, -1, -1];
        let argBytes = args.toString();
        let envBytes = env.toString();
        let pid = processSpawn(
            this.program,
            viewBytes(argBytes),
            this.args.length() + 1,
            viewBytes(envBytes),
            this.env.length(),
            this.cwd ?? "",
            modes,
            ends[..]
        );
        if (pid < 0) {
            throw failure(pid, this.program, "started");
        }
        let state = ChildState { pid = pid };
        reaper.register(state);
        return Child {
            state = state,
            stdin = if (ends[0] >= 0) PipeWriter { fd = ends[0] } else null,
            stdout = if (ends[1] >= 0) PipeReader { fd = ends[1] } else null,
            stderr = if (ends[2] >= 0) PipeReader { fd = ends[2] } else null,
        };
    }

    /// Starts the child with its output and errors piped and nothing to read, reads both to their
    /// ends — concurrently, so a child that fills one pipe while the other is drained does not
    /// stall —, waits for its end, and returns all of it as [Output].
    ///
    /// # Errors
    /// Throws [IoError] when the child cannot be started or a pipe fails, and [Cancelled] when the
    /// waiting task is cancelled.
    pub fn output(): Output throws [IoError, Cancelled] {
        var child = try (this with {
            stdin = Stdio.Null,
            stdout = Stdio.Piped,
            stderr = Stdio.Piped,
        }).spawn();
        var errors = child.stderr!;
        let taken = task.spawn(
            () => {
                let bytes = try errors.readToEnd();
                try errors.close();
                return bytes;
            }
        );
        var out = child.stdout!;
        let bytes = try out.readToEnd();
        try out.close();
        // the task's two error types join to `Error` in its handle: sorted out again here
        var errorBytes: uint8[] = [];
        try {
            errorBytes = taken.await();
        } catch (e: IoError) {
            throw e;
        } catch (e: Cancelled) {
            throw e;
        } catch (_) {
            unreachable("the reading task throws an IoError or Cancelled, nothing else");
        }
        return Output { status = try child.wait(), stdout = bytes, stderr = errorBytes };
    }

    /// Starts the child with the parent's streams, waits for its end and returns how it ended.
    ///
    /// # Errors
    /// Throws [IoError] when the child cannot be started, and [Cancelled] when the waiting task is
    /// cancelled.
    pub fn status(): ExitStatus throws [IoError, Cancelled] {
        var child = try this.spawn();
        return try child.wait();
    }
}

/// Appends `part` and a NUL to `into`; a NUL within `part` throws `InvalidInput`.
fn appendPart(into: StringBuilder, part: string, nul: char): void throws IoError {
    if (part.contains(nul)) {
        throw IoError { kind = .InvalidInput, detail = "a NUL in an argument or a variable" };
    }
    let b = into;
    b.appendStr(part);
    b.appendChar(nul);
}

fn modeOf(s: Stdio): int {
    return match (s) {
        .Inherit => 0,
        .Piped => 1,
        .Null => 2,
    };
}

/// A started child process: its standard streams where the command piped them, waiting for its
/// end, and signalling it.
pub class Child {
    state: ChildState,
    /// The child's standard input, where the command piped it: close it to end the child's input.
    pub var stdin: ?PipeWriter,
    /// The child's standard output, where the command piped it.
    pub stdout: ?PipeReader,
    /// The child's standard error, where the command piped it.
    pub stderr: ?PipeReader,

    /// Waits until the child has ended and returns how. A piped standard input is closed first:
    /// otherwise a child reading it would wait for the parent while the parent waits for the child.
    ///
    /// # Errors
    /// Throws [IoError] when closing the input or waiting fails, and [Cancelled] when the waiting
    /// task is cancelled.
    pub mut fn wait(): ExitStatus throws [IoError, Cancelled] {
        if (let w = this.stdin) {
            this.stdin = null;
            try w.close();
        }
        let _ = try this.state.ended.recv();
        let end = this.state.end;
        if (end < -1) {
            throw failure(end, null, "waited for");
        }
        return ExitStatus { raw = end };
    }

    /// Ends the child now — SIGKILL on POSIX, TerminateProcess on Windows (code 1). A child that has
    /// ended already is not touched: its process id may belong to another process by then.
    ///
    /// # Errors
    /// Throws [IoError] when the system refuses the signal.
    pub fn kill(): void throws IoError {
        try this.signal(Signal.Other(9));
    }

    /// Sends the signal `s` to the child, where it has not ended.
    ///
    /// # Errors
    /// Throws [IoError]: `Unsupported` for a signal the system does not have — on Windows every
    /// signal but a kill —, and the system's failure when it refuses the signal.
    pub fn signal(s: Signal): void throws IoError {
        let number = numberOf(s);
        if (number < 0) {
            throw IoError { kind = .Unsupported, detail = "a signal this system has not" };
        }
        let answer = reaper.signal(this.state, number);
        if (answer < 0) {
            throw failure(answer, null, "signalled");
        }
    }
}

/// How a child ended: with an exit code — 0 to 255 on POSIX, any 32 bits on Windows —, or, on
/// POSIX, by a signal.
pub struct ExitStatus :: [Equatable, Debug] {
    /// The runtime's answer (lyr/process.h): the code, or bit 40 and the signal's number.
    raw: int,

    /// Returns whether the child ended with code 0.
    pub fn success(): bool {
        return this.raw == 0;
    }

    /// Returns the exit code, or `null` where the child was ended by a signal.
    pub fn code(): ?int {
        return if (this.raw < signalled) this.raw else null;
    }

    /// Returns the signal that ended the child, or `null` where it exited with a code.
    pub fn signal(): ?Signal {
        return if (this.raw >= signalled) signalOf(this.raw - signalled) else null;
    }
}

extend ExitStatus :: [Display] {
    /// Returns `exit code 3` or `signal 9`.
    fn show(): string {
        return if (this.raw < signalled) f"exit code {this.raw}"
            else f"signal {this.raw - signalled}";
    }
}

/// The result of [Command.output]: how the child ended, and all it wrote on its two streams.
pub struct Output {
    pub status: ExitStatus,
    pub stdout: uint8[],
    pub stderr: uint8[],
}

// ---------------------------------------------------------------------------------------------
// The pipes: non-blocking — on Windows overlapped named pipes, each request's completion on the
// poller — and waited for on the thread's poller as a socket is.
// ---------------------------------------------------------------------------------------------

/// Makes the running task wait in `waits` until `fd` is ready as `interest` says.
fn waitFor(fd: int, interest: int, waits: Waits, doing: string): void throws [IoError, Cancelled] {
    let armed = try awaitDescriptor(fd, interest, waits);
    if (armed < 0) {
        throw failure(armed, null, doing);
    }
}

/// Removes the pipe's end from the poller — its waiters run again and find it closed — and closes
/// it.
fn closePipe(fd: int, waits: Waits): void throws IoError {
    let w = waits;
    w.close();
    forgetDescriptor(fd);
    let answer = processClose(fd);
    if (answer < 0) {
        throw failure(answer, null, "closed");
    }
}

/// The parent's end of a child's output or error pipe: a `Reader` that waits until bytes come, and
/// returns 0 once the child has closed its end.
pub class PipeReader :: [Reader, Closeable] {
    fd: int,
    var closed: bool = false,
    waits: Waits = Waits { },

    /// Reads into `into`, waiting until bytes come, and returns how many; 0 at the end.
    ///
    /// # Errors
    /// Throws [IoError] — `Closed` for a closed pipe —, and [Cancelled] when the waiting task is
    /// cancelled.
    pub mut fn read(into: Slice<uint8>): int throws [IoError, Cancelled] {
        loop {
            try this.stillOpen("read");
            if (into.isEmpty()) {
                return 0;
            }
            let fd = this.fd;
            let n = processRead(fd, into);
            if (n >= 0) {
                return n;
            }
            if (n != wouldBlock) {
                throw failure(n, null, "read");
            }
            try waitFor(this.fd, 1, this.waits, "read");
        }
    }

    /// Closes the pipe; a task that waits in a read throws `Closed`. A second close does nothing.
    ///
    /// # Errors
    /// Throws [IoError] when the system fails to close it.
    pub fn close(): void throws IoError {
        let me = this;
        if (me.closed) {
            return;
        }
        me.closed = true;
        try closePipe(me.fd, me.waits);
    }

    fn stillOpen(doing: string): void throws IoError {
        if (this.closed) {
            throw IoError { kind = .Closed, detail = doing };
        }
    }
}

/// The parent's end of a child's input pipe: a `Writer` that waits until the pipe takes some;
/// writing after the child has closed its end throws `BrokenPipe`. Closing it ends the child's
/// input.
pub class PipeWriter :: [Writer, Closeable] {
    fd: int,
    var closed: bool = false,
    waits: Waits = Waits { },

    /// Writes from `from`, waiting until the pipe takes some, and returns how many bytes it took.
    ///
    /// # Errors
    /// Throws [IoError] — `Closed` for a closed pipe, `BrokenPipe` when the child closed its end —,
    /// and [Cancelled] when the waiting task is cancelled.
    pub mut fn write(from: Slice<uint8>): int throws [IoError, Cancelled] {
        loop {
            try this.stillOpen("written");
            if (from.isEmpty()) {
                return 0;
            }
            let fd = this.fd;
            let n = processWrite(fd, from);
            if (n >= 0) {
                return n;
            }
            if (n != wouldBlock) {
                throw failure(n, null, "written");
            }
            try waitFor(this.fd, 2, this.waits, "written");
        }
    }

    /// Closes the pipe — the child reads the end of its input; a task that waits in a write throws
    /// `Closed`. A second close does nothing.
    ///
    /// # Errors
    /// Throws [IoError] when the system fails to close it.
    pub fn close(): void throws IoError {
        let me = this;
        if (me.closed) {
            return;
        }
        me.closed = true;
        try closePipe(me.fd, me.waits);
    }

    fn stillOpen(doing: string): void throws IoError {
        if (this.closed) {
            throw IoError { kind = .Closed, detail = doing };
        }
    }
}

// ---------------------------------------------------------------------------------------------
// The reaper: SIGCHLD belongs to the runtime.
// ---------------------------------------------------------------------------------------------

/// A child the reaper waits for: its end once seen (lyr/process.h's answer, -1 before), and a
/// channel closed then — every task waiting in `wait` receives the close, on any thread.
class ChildState {
    pid: int,
    var end: int = -1,
    ended: Channel<int> = Channel.new(),
}

/// The children not seen to end, and the thread that watches for their ends: started with the
/// first child, it asks each of them at every SIGCHLD — never waitpid(-1), which would take a
/// host's children too.
class Reaper {
    guard: SpinLock = SpinLock { },
    children: List<ChildState>,
    var started: bool = false,

    /// Adds `c` to the children waited for; the first child starts the reaper's thread. A later
    /// one wakes the reaper: it was forked before it was registered, and if it ended in between,
    /// its SIGCHLD may have woken a pass over a list without it — then nothing would wake the
    /// reaper for it again.
    mut fn register(c: ChildState): void {
        this.guard.acquire();
        this.children.push(c);
        let start = !this.started;
        this.started = true;
        this.guard.release();
        if (start) {
            let _ = Thread.spawn(
                () => {
                    reaper.watch();
                }
            );
        } else {
            processNudge();
        }
    }

    /// Runs the reaper's loop: asks every child, then waits for the next SIGCHLD.
    mut fn watch(): void {
        processAttach();
        let s = here();
        while (true) {
            this.reapAll();
            s.awaitPoller();
        }
    }

    /// Asks each child whether it has ended; those that have are removed and their channels closed.
    mut fn reapAll(): void {
        this.guard.acquire();
        let ended = List<ChildState>.new();
        var i = 0;
        while (i < this.children.length()) {
            let c = this.children[i];
            let answer = processReap(c.pid);
            if (answer == -1) {
                i += 1;
            } else {
                c.end = answer;
                ended.push(this.children.removeAt(i));
            }
        }
        this.guard.release();
        for (c in ended) {
            c.ended.close();
        }
    }

    /// Sends the signal numbered `number` to `c`, where it has not ended — under the guard, so the
    /// reaper cannot reap it, freeing its process id, between the check and the signal.
    mut fn signal(c: ChildState, number: int): int {
        this.guard.acquire();
        let answer = if (c.end == -1) processSignal(c.pid, number) else 0;
        this.guard.release();
        return answer;
    }
}

let reaper = Reaper { children = List.new() };
