//! The build script's view of its build.
//!
//! A package's `build.lyr` is an ordinary program that `lyric5` runs before it compiles the
//! package: it does things — writes modules into `gen/`, names C to compile, libraries to link
//! and where to find them, and files to put beside the program — and defines nothing. What it asks of the toolchain goes back as directives, a line
//! each, into the file the toolchain names; what the build is comes from the environment the
//! toolchain sets.
//!
//! # Panics
//!
//! Every function of this module panics outside a build script, where the toolchain's
//! environment is not set, and where a directive cannot be written.
//!
//! # Examples
//!
//! ```lyric,no_run
//! import std.build;
//!
//! build.compileC("native/fast.c");
//! build.linkLib("m");
//! build.rerunIfChanged("native/fast.c");
//! ```
import std.fs;
import std.io { IoError };
import std.os;

/// Returns the target triple the package is built for, such as `x86_64-linux-gnu`.
///
/// The script itself runs on the host.
pub fn target(): string {
    return given("LYRIC_BUILD_TARGET");
}

/// Returns the profile the package is built in: `debug`, `release`, or one of the manifest's.
pub fn profile(): string {
    return given("LYRIC_BUILD_PROFILE");
}

/// Returns the path of the package's `out/`, for what the script keeps between its runs.
pub fn outDir(): string {
    return given("LYRIC_BUILD_OUT_DIR");
}

/// Returns the path of the package's `gen/`.
///
/// A module the script writes there, `gen/schema.lyr`, is the package's module
/// `<package>.gen.schema`. The toolchain makes the directory before the script runs.
pub fn genDir(): string {
    return given("LYRIC_BUILD_GEN_DIR");
}

/// Asks the toolchain to run the script again when one of these files has changed.
///
/// The paths are relative to the package's root. While none of them changes, the toolchain keeps
/// what the last run left. A script that names no file runs again where it changed itself.
pub fn rerunIfChanged(paths: string...): void {
    for (i in 0..paths.length()) {
        direct("rerun-if-changed", paths[i]);
    }
}

/// Asks the toolchain to run the script again when one of these environment variables has another
/// value than in the script's last run, or is set where it was not, or not where it was.
///
/// A script that reads where a library lies from the environment names the variable here: else
/// a changed value keeps what the last run asked.
pub fn rerunIfEnvChanged(names: string...): void {
    for (i in 0..names.length()) {
        direct("rerun-if-env-changed", names[i]);
    }
}

/// Links the C library `name` into the program: `linkLib("m")` is `-lm`.
pub fn linkLib(name: string): void {
    direct("link-lib", name);
}

/// Adds a directory the link searches for the libraries of [linkLib] and of `[native]`, before the
/// linker's own: `linkSearch("C:/Libs/SDL3/x86_64-w64-mingw32/lib")` is `-L` with it.
///
/// The path is relative to the package's root, or absolute.
pub fn linkSearch(dir: string): void {
    direct("link-search", dir);
}

/// Puts files beside every binary the build makes of the program — of `build`, `run`, `test` and
/// `bench` — when it has linked it: a shared library the program loads when it starts, most of
/// all. Such a binary searches its own directory for shared libraries first.
///
/// The paths are relative to the package's root, or absolute. A file that is not there when the
/// script has ended, and two files of one name, stop the build.
pub fn besideBinary(paths: string...): void {
    for (i in 0..paths.length()) {
        direct("beside-binary", paths[i]);
    }
}

/// Adds flags for the C sources this script names with [compileC]:
/// `cFlags("-DLEVEL=2", "-Iinclude")`.
pub fn cFlags(flags: string...): void {
    for (i in 0..flags.length()) {
        direct("c-flag", flags[i]);
    }
}

/// Compiles C sources with the program and links them into it.
///
/// The paths are relative to the package's root.
pub fn compileC(sources: string...): void {
    for (i in 0..sources.length()) {
        direct("compile-c", sources[i]);
    }
}

/// Emits a warning the toolchain shows with the build's diagnostics.
pub fn warn(message: string): void {
    direct("warn", message);
}

/// Returns the value of the environment variable the toolchain set for the script.
///
/// # Panics
///
/// Panics where the variable is not set: no build script runs.
fn given(name: string): string {
    if (let value = os.env(name)) {
        return value;
    }
    panic(f"std.build is a build script's: {name} is not set — this program runs outside a build");
}

/// Appends one directive as a line: its word, a tab, and its text with each line end turned into a
/// space.
///
/// # Panics
///
/// Panics where the directive cannot be written.
fn direct(word: string, text: string): void {
    let line = f"{word}\t{text.replace("\r", " ").replace("\n", " ")}\n";
    try {
        fs.appendText(given("LYRIC_BUILD_DIRECTIVES"), line);
    } catch (e: IoError) {
        panic(f"std.build: the directive could not be written: {e.message()}");
    }
}
