//! The file system: [File], a handle on an open file that reads, writes and seeks through
//! `std.io`'s interfaces, opened as [OpenOptions] say; conveniences that read or write a file whole
//! ([readText], [readBytes], [writeText], [writeBytes], [appendText]) or its lines one by one
//! ([lines]); what a path names ([Metadata], [metadata], [exists]); directories and their entries
//! ([createDir], [removeDir], [readDir], [DirEntry]); and operations built from those —
//! [createDirAll], [removeAll], [copy], [walk], [tempDir], [tempFile].
//!
//! Where a scheduler runs, every call on a file runs on the program's I/O pool (std.io's): a few
//! threads, started at the first use, do the system's call while the running task is parked, and
//! the thread it runs on goes on with the other tasks; where no scheduler runs, the call runs on the
//! thread itself. A call on a regular file ends in a bounded time and is not a point of
//! cancellation: a cancellation is seen at the task's next wait. Reads and writes go through the
//! caller's slice, never a copy.
//!
//! # Examples
//!
//! ```lyric
//! import std.io { print, println, IoError };
//! import std.fs;
//! import std.path;
//!
//! fn main(): void throws IoError {
//!     let dir = try fs.tempDir();
//!     let file = path.join(dir, "notes.txt");
//!     try fs.writeText(file, "first\nsecond\n");
//!     try fs.appendText(file, "third\n");
//!     print(try fs.readText(file));
//!     try fs.removeAll(dir);
//!     println(fs.exists(dir));
//! }
//! ```
//!
//! ```output
//! first
//! second
//! third
//! false
//! ```
import std.collections { List };
import std.core { Utf8Error, sliceAddress };
import std.crypto { randomUint64 };
import std.io;
import std.io {
    IoError,
    IoErrorKind,
    Reader,
    Seek,
    SeekFrom,
    TextReader,
    Writer,
    failure,
    onPool,
    uncancelled,
};
import std.os;
import std.path { join, normalize, parent };
import std.time { Instant, instantOfEpochNanos };

extern "C" fn fsOpen(path: string, how: int): int = "lyr_fs_open";

inline fn fsRead(file: int, into: Slice<uint8>): int {
    return fsReadRaw(file, sliceAddress(into), into.length());
}

extern "C" fn fsReadRaw(file: int, intoAt: uint, intoLength: int): int = "lyr_fs_read";

inline fn fsWrite(file: int, from: Slice<uint8>): int {
    return fsWriteRaw(file, sliceAddress(from), from.length());
}

extern "C" fn fsWriteRaw(file: int, fromAt: uint, fromLength: int): int = "lyr_fs_write";
extern "C" fn fsSeek(file: int, offset: int, whence: int): int = "lyr_fs_seek";
extern "C" fn fsClose(file: int): int = "lyr_fs_close";

inline fn fsStat(path: string, follow: int, into: Slice<int>): int {
    return fsStatRaw(path, follow, sliceAddress(into), into.length());
}

extern "C" fn fsStatRaw(
    path: string,
    follow: int,
    intoAt: uint,
    intoLength: int
): int = "lyr_fs_stat";
extern "C" fn fsMakeDir(path: string): int = "lyr_fs_mkdir";
extern "C" fn fsRemoveDir(path: string): int = "lyr_fs_rmdir";
extern "C" fn fsRemove(path: string): int = "lyr_fs_unlink";
extern "C" fn fsRename(from: string, to: string): int = "lyr_fs_rename";
extern "C" fn fsDirOpen(path: string): int = "lyr_fs_dir_open";

inline fn fsDirNext(dir: int, into: Slice<uint8>): int {
    return fsDirNextRaw(dir, sliceAddress(into), into.length());
}

extern "C" fn fsDirNextRaw(dir: int, intoAt: uint, intoLength: int): int = "lyr_fs_dir_next";
extern "C" fn fsDirClose(dir: int): int = "lyr_fs_dir_close";

inline fn fsCanonical(path: string, into: Slice<uint8>): int {
    return fsCanonicalRaw(path, sliceAddress(into), into.length());
}

extern "C" fn fsCanonicalRaw(path: string, intoAt: uint, intoLength: int): int = "lyr_fs_canonical";

inline fn fsAbsolute(path: string, into: Slice<uint8>): int {
    return fsAbsoluteRaw(path, sliceAddress(into), into.length());
}

extern "C" fn fsAbsoluteRaw(path: string, intoAt: uint, intoLength: int): int = "lyr_fs_absolute";

/// How a file is opened: to read, to write, to append at its end, created where it is not there,
/// truncated to nothing where it is. [File.openWith] refuses with `InvalidInput` a file opened
/// neither to read nor to write, one truncated without being written from the start, and one
/// created without being written.
pub struct OpenOptions {
    pub read: bool = false,
    pub write: bool = false,
    pub append: bool = false,
    pub create: bool = false,
    pub truncate: bool = false,
}

/// An open file: read from its position, written there — at the end, where it was opened to
/// append —, its position moved. `close()` releases it; a call after it throws `Closed`, and a
/// second `close()` does nothing.
pub class File :: [Reader, Writer, Seek, Closeable] {
    var handle: int,
    name: string,
    var closed: bool = false,

    /// Opens `path` to read.
    ///
    /// # Errors
    /// Throws [IoError] with the path when the system cannot open it, such as `NotFound`.
    pub static fn open(path: StringView): File throws IoError {
        return try File.openWith(path, OpenOptions { read = true });
    }

    /// Opens `path` to write: created where it is not there, truncated to nothing where it is.
    ///
    /// # Errors
    /// Throws [IoError] with the path when the system cannot open or create it.
    pub static fn create(path: StringView): File throws IoError {
        return try File.openWith(
            path,
            OpenOptions { write = true, create = true, truncate = true }
        );
    }

    /// Opens `path` as `options` say.
    ///
    /// # Errors
    /// Throws [IoError]: `InvalidInput` for options [OpenOptions] refuses, and the system's
    /// failure with the path when it cannot open the file.
    pub static fn openWith(path: StringView, options: OpenOptions): File throws IoError {
        let name = path.toString();
        if (!options.read && !options.write && !options.append) {
            throw IoError {
                kind = .InvalidInput,
                path = name,
                detail = "opened neither to read nor to write",
            };
        }
        if (options.truncate && (!options.write || options.append)) {
            throw IoError {
                kind = .InvalidInput,
                path = name,
                detail = "cut to nothing without being written from the start",
            };
        }
        if (options.create && !options.write && !options.append) {
            throw IoError {
                kind = .InvalidInput,
                path = name,
                detail = "created without being written",
            };
        }
        var how = 0;
        if (options.read) {
            how = how | 1;
        }
        if (options.write) {
            how = how | 2;
        }
        if (options.append) {
            how = how | 4;
        }
        if (options.create) {
            how = how | 8;
        }
        if (options.truncate) {
            how = how | 16;
        }
        let flags = how;
        let handle = onPool(() => fsOpen(name, flags));
        if (handle < 0) {
            throw failure(
                handle,
                name,
                if (options.write || options.append) "opened to write" else "opened to read"
            );
        }
        return File { handle = handle, name = name };
    }

    /// Reads into `into` from the file's position and returns how many bytes it read; 0 at the end.
    ///
    /// # Errors
    /// Throws [IoError]: `Closed` after `close()`, else the system's failure with the path.
    pub mut fn read(into: Slice<uint8>): int throws IoError {
        try this.stillOpen("read");
        if (into.isEmpty()) {
            return 0;
        }
        let h = this.handle;
        let n = onPool(() => fsRead(h, into));
        if (n < 0) {
            throw failure(n, this.name, "read");
        }
        return n;
    }

    /// Writes from `from` at the file's position and returns how many bytes it wrote.
    ///
    /// # Errors
    /// Throws [IoError]: `Closed` after `close()`, else the system's failure with the path.
    pub mut fn write(from: Slice<uint8>): int throws IoError {
        try this.stillOpen("written");
        if (from.isEmpty()) {
            return 0;
        }
        let h = this.handle;
        let n = onPool(() => fsWrite(h, from));
        if (n < 0) {
            throw failure(n, this.name, "written");
        }
        return n;
    }

    /// Moves the file's position as `to` says and returns the new position from the start.
    ///
    /// # Errors
    /// Throws [IoError]: `Closed` after `close()`, else the system's failure with the path.
    pub mut fn seek(to: SeekFrom): int throws IoError {
        try this.stillOpen("sought");
        let (offset, whence) = match (to) {
            .Start(n) => (n, 0),
            .Current(n) => (n, 1),
            .End(n) => (n, 2),
        };
        let h = this.handle;
        let at = onPool(() => fsSeek(h, offset, whence));
        if (at < 0) {
            throw failure(at, this.name, "sought");
        }
        return at;
    }

    /// Closes the file. A second close does nothing.
    ///
    /// # Errors
    /// Throws [IoError] with the path when the system fails to close it.
    pub fn close(): void throws IoError {
        // through the reference: 'Closeable.close' is not a 'mut fn'
        let me = this;
        if (me.closed) {
            return;
        }
        me.closed = true;
        let h = me.handle;
        let result = onPool(() => fsClose(h));
        if (result < 0) {
            throw failure(result, me.name, "closed");
        }
    }

    fn stillOpen(doing: string): void throws IoError {
        if (this.closed) {
            throw IoError { kind = .Closed, path = this.name, detail = doing };
        }
    }
}

/// Returns `e` with the file's path where it names none — the decoder's `InvalidData` names none.
fn withPath(e: IoError, path: string): IoError {
    return if (e.path == null) e with { path = path } else e;
}

// ---------------------------------------------------------------------------------------------
// The conveniences: a file read or written whole, or its lines one by one. Each opens the file,
// does its work and closes it on every way out; what the close throws counts where nothing went
// wrong before. A file's call is never cancelled, so the `Cancelled` that io's defaults declare for
// any reader is kept out with `uncancelled`.
// ---------------------------------------------------------------------------------------------

/// Returns the whole file at `path` as UTF-8 text. A byte order mark is kept as text like any
/// other.
///
/// # Errors
/// Throws [IoError] with the path: `InvalidData` for bytes that are not UTF-8, else the system's
/// failure to open, read or close the file.
pub fn readText(path: StringView): string throws IoError {
    using let f = try File.open(path);
    return try uncancelled(() => try f.readToString()) catch (e: IoError) throw withPath(e, f.name);
}

/// Returns the whole file at `path` as bytes.
///
/// # Errors
/// Throws [IoError] with the path when the file cannot be opened, read or closed.
pub fn readBytes(path: StringView): uint8[] throws IoError {
    using let f = try File.open(path);
    return try uncancelled(() => try f.readToEnd());
}

/// Returns an iterator over the lines of the file at `path`, as `TextReader.readLine` gives them:
/// without their line ends, and a last line without an end still a line. The iterator closes the
/// file at its end and at an error; a `for` that leaves it early closes it, and so does `close()`.
///
/// # Errors
/// Throws [IoError] with the path when the file cannot be opened.
pub fn lines(path: StringView): FileLinesIter throws IoError {
    let f = try File.open(path);
    return FileLinesIter { file = f, reader = TextReader.new(f) };
}

/// Writes `text` as the file at `path`, created where it is not there, truncated where it is.
///
/// # Errors
/// Throws [IoError] with the path when the file cannot be created, written or closed.
pub fn writeText(path: StringView, text: StringView): void throws IoError {
    using let f = try File.create(path);
    try uncancelled(() => try f.writeString(text));
}

/// Writes `bytes` as the file at `path`, created where it is not there, truncated where it is.
///
/// # Errors
/// Throws [IoError] with the path when the file cannot be created, written or closed.
pub fn writeBytes(path: StringView, bytes: Slice<uint8>): void throws IoError {
    using let f = try File.create(path);
    try uncancelled(() => try f.writeAll(bytes));
}

/// Appends `text` to the end of the file at `path`, created where it is not there.
///
/// # Errors
/// Throws [IoError] with the path when the file cannot be opened, written or closed.
pub fn appendText(path: StringView, text: StringView): void throws IoError {
    using let f = try File.openWith(path, OpenOptions { append = true, create = true });
    try uncancelled(() => try f.writeString(text));
}

/// The lines of a file, from [lines]. After its end or an error it gives no more; after `close()`
/// a call throws `Closed`, as the file's would.
pub class FileLinesIter :: [Iterator, Closeable] {
    type Item = string;
    type Error = IoError;
    file: File,
    reader: TextReader<File>,
    var done: bool = false,

    /// Returns the next line, or `null` at the end.
    ///
    /// # Errors
    /// Throws [IoError] with the path: `Closed` after `close()`, `InvalidData` for bytes that are
    /// not UTF-8, else the system's failure to read.
    pub mut fn next(): ?string throws IoError {
        if (this.done) {
            return null;
        }
        // the reader holds what it read ahead: a closed file is seen here, not at its next read
        try this.file.stillOpen("read");
        var line: ?string = null;
        let reader = this.reader;
        try {
            line = uncancelled(() => try reader.readLine());
        } catch (e: IoError) {
            this.done = true;
            // the first error wins, the close's is attached to it
            defer {
                try this.file.close();
            }
            throw withPath(e, this.file.name);
        }
        if (line == null) {
            this.done = true;
            try this.file.close();
        }
        return line;
    }

    /// Closes the file before the end. A second close does nothing.
    ///
    /// # Errors
    /// Throws [IoError] with the path when the system fails to close it.
    pub fn close(): void throws IoError {
        try this.file.close();
    }
}

// ---------------------------------------------------------------------------------------------
// What a path names, the directories and their entries: one system call each, on the I/O pool;
// a failure is an IoError with the path, as a file's is.
// ---------------------------------------------------------------------------------------------

/// What a path names, through links: its size in bytes, when it was last written, whether it is a
/// file or a directory — neither, for a device or a socket —, whether it cannot be written; and
/// whether the path itself is a link. A link that leads nowhere is not found.
pub struct Metadata {
    pub size: int,
    pub modified: Instant,
    pub isFile: bool,
    pub isDir: bool,
    pub isSymlink: bool,
    pub readonly: bool,
}

/// Returns the [Metadata] of what `path` names, following links.
///
/// # Errors
/// Throws [IoError] with the path: `NotFound` where nothing is there or a link leads nowhere,
/// else the system's failure.
pub fn metadata(path: StringView): Metadata throws IoError {
    return try statOf(path.toString());
}

/// Returns whether `path` names anything — `false` where it cannot be told, and for a link that
/// leads nowhere.
pub fn exists(path: StringView): bool {
    try {
        let _ = statOf(path.toString());
        return true;
    } catch (_: IoError) {
        return false;
    }
}

/// Creates the directory `path`; its parent must exist.
///
/// # Errors
/// Throws [IoError] with the path: `AlreadyExists` where something is there, `NotFound` where the
/// parent is missing, else the system's failure.
pub fn createDir(path: StringView): void throws IoError {
    let name = path.toString();
    let answer = onPool(() => fsMakeDir(name));
    if (answer < 0) {
        throw failure(answer, name, "made");
    }
}

/// Removes the file `path`; a directory is removed with [removeDir].
///
/// # Errors
/// Throws [IoError] with the path when the system cannot remove it.
pub fn remove(path: StringView): void throws IoError {
    let name = path.toString();
    let answer = onPool(() => fsRemove(name));
    if (answer < 0) {
        throw failure(answer, name, "removed");
    }
}

/// Removes the directory `path`, which must be empty.
///
/// # Errors
/// Throws [IoError] with the path when the system cannot remove it; a directory that is not empty
/// is `Other` with the system's code, since no kind names it.
pub fn removeDir(path: StringView): void throws IoError {
    let name = path.toString();
    let answer = onPool(() => fsRemoveDir(name));
    if (answer < 0) {
        throw failure(answer, name, "removed");
    }
}

/// Renames `from` to `to`, replacing a file there. Both must be on the same file system.
///
/// # Errors
/// Throws [IoError] with the source path when the system cannot rename it, including across file
/// systems.
pub fn rename(from: StringView, to: StringView): void throws IoError {
    let source = from.toString();
    let target = to.toString();
    let answer = onPool(() => fsRename(source, target));
    if (answer < 0) {
        throw failure(answer, source, f"renamed to {target}");
    }
}

/// Returns an iterator over the entries of the directory `path`, in the order the system keeps
/// them; `.` and `..` are not among them. The iterator holds the directory open: it releases it at
/// its end and at its first error, a loop that leaves it early releases it, and so does `close()`.
///
/// # Errors
/// Throws [IoError] with the path when the directory cannot be opened.
pub fn readDir(path: StringView): ReadDirIter throws IoError {
    let name = path.toString();
    let handle = onPool(() => fsDirOpen(name));
    if (handle < 0) {
        throw failure(handle, name, "opened to read");
    }
    return ReadDirIter { handle = handle, dir = name, room = [0u8] * 1024 };
}

/// Returns `path` absolute, its links resolved and its `.` and `..` removed: where the system says
/// the file is.
///
/// # Errors
/// Throws [IoError] with the path: `NotFound` where nothing is there, `InvalidData` for a result
/// that is not UTF-8, else the system's failure.
pub fn canonicalize(path: StringView): string throws IoError {
    let name = path.toString();
    return try pathFrom(name, "resolved", (into) => fsCanonical(name, into));
}

/// Returns `path` made absolute against the working directory, then normalized: nothing else is
/// asked of the file system, and links in it stay.
///
/// # Errors
/// Throws [IoError] with the path when the working directory cannot be read, or `InvalidData`
/// for a result that is not UTF-8.
pub fn absolute(path: StringView): string throws IoError {
    let name = path.toString();
    return normalize(try pathFrom(name, "made absolute", (into) => fsAbsolute(name, into)));
}

/// An entry of a directory, from [readDir]: its name, its path — the directory's joined with the
/// name —, and what the entry is itself: a link is reported as a link, not as what it leads to.
pub struct DirEntry {
    pub name: string,
    pub path: string,
    pub isFile: bool,
    pub isDir: bool,
    pub isSymlink: bool,

    /// Returns the [Metadata] of what the entry names, following a link, as [metadata] does.
    ///
    /// # Errors
    /// Throws [IoError] as [metadata] does.
    pub fn metadata(): Metadata throws IoError {
        return try statOf(this.path);
    }
}

/// A directory's entries, from [readDir]. After its end or an error it gives no more; after
/// `close()` a call throws `Closed`.
pub class ReadDirIter :: [Iterator, Closeable] {
    type Item = DirEntry;
    type Error = IoError;
    handle: int,
    dir: string,
    var room: uint8[],
    var done: bool = false,
    var closed: bool = false,

    /// Returns the next entry, or `null` at the end.
    ///
    /// # Errors
    /// Throws [IoError] with the directory's path: `Closed` after `close()`, `InvalidData` for a
    /// name that is not UTF-8, else the system's failure to read.
    pub mut fn next(): ?DirEntry throws IoError {
        if (this.done) {
            return null;
        }
        if (this.closed) {
            throw IoError { kind = .Closed, path = this.dir, detail = "read" };
        }
        let h = this.handle;
        let first = this.room;
        var answer = onPool(() => fsDirNext(h, first[..]));
        if (answer > 0 && (answer & 0xFFFFFFFF) > first.length()) {
            // a name longer than the room: room for it, and the same entry again
            let more: uint8[] = [0u8] * (answer & 0xFFFFFFFF);
            this.room = more;
            answer = onPool(() => fsDirNext(h, more[..]));
        }
        if (answer == 0) {
            this.done = true;
            try this.letGo();
            return null;
        }
        var entry: ?DirEntry = null;
        var error: ?IoError = null;
        if (answer < 0) {
            error = failure(answer, this.dir, "read");
        } else {
            let length = answer & 0xFFFFFFFF;
            let kind = answer >> 32;
            try {
                let name = string.fromUtf8(this.room[..length]);
                entry = DirEntry {
                    name = name,
                    path = join(this.dir, name),
                    isFile = kind == 1,
                    isDir = kind == 2,
                    isSymlink = kind == 3,
                };
            } catch (e: Utf8Error) {
                error = IoError {
                    kind = .InvalidData,
                    path = this.dir,
                    detail = "a name in it is no UTF-8",
                    inner = e,
                };
            }
        }
        if (let e = error) {
            this.done = true;
            // the first error wins, the close's is attached to it
            defer {
                try this.letGo();
            }
            throw e;
        }
        return entry;
    }

    /// Closes the directory before the end. A second close does nothing.
    ///
    /// # Errors
    /// Throws [IoError] with the path when the system fails to close it.
    pub fn close(): void throws IoError {
        try this.letGo();
    }

    /// Closes the directory handle once; later calls do nothing.
    fn letGo(): void throws IoError {
        // through the reference: 'Closeable.close' is not a 'mut fn'
        let me = this;
        if (me.closed) {
            return;
        }
        me.closed = true;
        let h = me.handle;
        let answer = onPool(() => fsDirClose(h));
        if (answer < 0) {
            throw failure(answer, me.dir, "closed");
        }
    }
}

// ---------------------------------------------------------------------------------------------
// Built from those: trees created, walked, copied and removed, and temporary files and
// directories.
// ---------------------------------------------------------------------------------------------

/// Creates the directory `path` and every missing directory above it. Where `path` is already a
/// directory there is nothing to do.
///
/// # Errors
/// Throws [IoError] with the path: `NotDirectory` where `path` or a directory above it is
/// something else, else the system's failure.
pub fn createDirAll(path: StringView): void throws IoError {
    try makeAll(path.toString());
}

/// Removes `path` and everything in it: a link is removed, never followed into, and where nothing
/// is there there is nothing to do. It removes all it can.
///
/// # Errors
/// Throws the first [IoError] it met.
pub fn removeAll(path: StringView): void throws IoError {
    let name = path.toString();
    if (let own = try statOrNothing(name, false)) {
        if (let e = takeAway(name, own.isDir, own.isSymlink)) {
            throw e;
        }
    }
}

/// Copies the bytes of the file `from` to the file `to` — created, or truncated where it is
/// there — and returns how many. Permissions and times are not copied.
///
/// # Errors
/// Throws [IoError] with the source path: `IsDirectory` for a directory, `InvalidInput` for
/// anything else that is not a file and for a copy onto itself — truncating would lose what it
/// copies —, else the failure of opening, reading or writing.
pub fn copy(from: StringView, to: StringView): int throws IoError {
    let source = from.toString();
    let target = to.toString();
    let what = try statOf(source);
    if (!what.isFile) {
        throw IoError {
            kind = if (what.isDir) .IsDirectory else .InvalidInput,
            path = source,
            detail = "copied: no file",
        };
    }
    if (exists(target) && (try canonicalize(source)) == (try canonicalize(target))) {
        throw IoError {
            kind = .InvalidInput,
            path = source,
            detail = f"copied onto itself, {target}",
        };
    }
    using let r = try File.open(source);
    using let w = try File.create(target);
    return try uncancelled(() => try io.copy(r, w));
}

/// Returns an iterator over the entries under `path`, depth first — a directory before what is in
/// it —, each directory's entries in the byte order of their names; `path` itself is not among
/// them, and links are not followed. Each directory is read whole and closed before its first
/// entry is given, so the walk holds nothing open. An error ends the walk.
///
/// # Errors
/// Throws [IoError] with the path when `path` cannot be read as a directory.
pub fn walk(path: StringView): WalkIter throws IoError {
    let it = WalkIter { frames = List.new() };
    try it.enter(path.toString());
    return it;
}

/// Creates a new directory under the system's directory for temporary files and returns its path.
/// Nothing removes it but [removeAll]. The system's directory itself is `os.tempDir`.
///
/// # Errors
/// Throws [IoError] when the directory cannot be created, or after 100 random names that all
/// existed already.
pub fn tempDir(): string throws IoError {
    let root = try tempRoot();
    var tries = 0;
    loop {
        let name = join(root, f"lyric-{randomUint64()}");
        let answer = onPool(() => fsMakeDir(name));
        if (answer >= 0) {
            return name;
        }
        let e = failure(answer, name, "made");
        tries = tries + 1;
        if (e.kind != IoErrorKind.AlreadyExists || tries == 100) {
            throw e;
        }
    }
}

/// Creates a new empty file under the system's directory for temporary files and returns its
/// path, for [File.openWith] and the conveniences to take from there. Nothing removes it but
/// [remove].
///
/// # Errors
/// Throws [IoError] when the file cannot be created or closed, or after 100 random names that all
/// existed already.
pub fn tempFile(): string throws IoError {
    let root = try tempRoot();
    var tries = 0;
    loop {
        let name = join(root, f"lyric-{randomUint64()}");
        // to write, made, and only where nothing is there (lyr/fs.h's bits)
        let handle = onPool(() => fsOpen(name, 2 | 8 | 32));
        if (handle >= 0) {
            let closed = onPool(() => fsClose(handle));
            if (closed < 0) {
                throw failure(closed, name, "closed");
            }
            return name;
        }
        let e = failure(handle, name, "made");
        tries = tries + 1;
        if (e.kind != IoErrorKind.AlreadyExists || tries == 100) {
            throw e;
        }
    }
}

/// The entries under a directory, from [walk]. After its end or an error it gives no more.
pub class WalkIter :: [Iterator] {
    type Item = DirEntry;
    type Error = IoError;
    frames: List<WalkFrame>,
    var below: ?string = null,
    var done: bool = false,

    /// Returns the next entry, or `null` at the end.
    ///
    /// # Errors
    /// Throws [IoError] when a directory under the walk cannot be read.
    pub mut fn next(): ?DirEntry throws IoError {
        if (this.done) {
            return null;
        }
        // the directory given last is entered now: what reading it throws comes after its entry
        if (let dir = this.below) {
            this.below = null;
            try {
                this.enter(dir);
            } catch (e: IoError) {
                this.done = true;
                throw e;
            }
        }
        loop {
            if (this.frames.isEmpty()) {
                this.done = true;
                return null;
            }
            let frame = this.frames[this.frames.length() - 1];
            if (frame.at == frame.entries.length()) {
                let _ = this.frames.pop();
                continue;
            }
            let e = frame.entries[frame.at];
            frame.at = frame.at + 1;
            if (e.isDir) {
                this.below = e.path;
            }
            return e;
        }
    }

    /// Reads the entries of `dir`, sorted by name, as the walk's next to give.
    mut fn enter(dir: string): void throws IoError {
        let entries: List<DirEntry> = List.new();
        for (e in try readDir(dir)) {
            entries.push(e);
        }
        let sorted = entries.toArray();
        sorted.sortByKey((e) => e.name);
        this.frames.push(WalkFrame { entries = sorted });
    }
}

/// A directory of a walk: its entries, and how many were given.
class WalkFrame {
    entries: DirEntry[],
    var at: int = 0,
}

/// Creates `name`, after the missing directories above it.
fn makeAll(name: string): void throws IoError {
    if (let m = try statOrNothing(name)) {
        if (m.isDir) {
            return;
        }
        throw IoError { kind = .NotDirectory, path = name, detail = "made" };
    }
    let up = parent(name);
    if (up != name && up != ".") {
        try makeAll(up);
    }
    let answer = onPool(() => fsMakeDir(name));
    if (answer < 0) {
        let e = failure(answer, name, "made");
        // made meanwhile by another: done, where it is a directory
        if (e.kind == IoErrorKind.AlreadyExists) {
            if (let m = try statOrNothing(name)) {
                if (m.isDir) {
                    return;
                }
            }
        }
        throw e;
    }
}

/// Removes `name` — a directory with everything in it — and returns the first error met, or
/// `null`.
fn takeAway(name: string, isDir: bool, isLink: bool): ?IoError {
    if (!isDir) {
        try {
            remove(name);
        } catch (e: IoError) {
            // a link to a directory is a directory to Windows' DeleteFileW
            if (isLink) {
                try {
                    removeDir(name);
                    return null;
                } catch (_: IoError) { }
            }
            return e;
        }
        return null;
    }
    var first: ?IoError = null;
    let entries: List<DirEntry> = List.new();
    try {
        for (e in readDir(name)) {
            entries.push(e);
        }
    } catch (e: IoError) {
        first = e;
    }
    for (e in entries) {
        if (let error = takeAway(e.path, e.isDir, e.isSymlink)) {
            if (first == null) {
                first = error;
            }
        }
    }
    try {
        removeDir(name);
    } catch (e: IoError) {
        if (first == null) {
            first = e;
        }
    }
    return first;
}

/// Returns what `name` names, or `null` where nothing is there; any other error is thrown.
fn statOrNothing(name: string, follow: bool = true): ?Metadata throws IoError {
    try {
        return statOf(name, follow);
    } catch (e: IoError) {
        if (e.kind == IoErrorKind.NotFound) {
            return null;
        }
        throw e;
    }
}

/// Returns the system's directory for temporary files, as `os.tempDir` reports it.
fn tempRoot(): string throws IoError {
    return os.tempDir();
}

/// Returns what `name` names (lyr/fs.h's five slots): through links, or the path itself where
/// `follow` is false — a link then neither file nor directory.
fn statOf(name: string, follow: bool = true): Metadata throws IoError {
    let slots: int[] = [0] * 5;
    let through = if (follow) 1 else 0;
    let answer = onPool(() => fsStat(name, through, slots[..]));
    if (answer < 0) {
        throw failure(answer, name, "looked at");
    }
    return Metadata {
        size = slots[1],
        modified = instantOfEpochNanos(slots[2]),
        isFile = slots[0] == 1,
        isDir = slots[0] == 2,
        isSymlink = slots[4] == 1,
        readonly = slots[3] == 1,
    };
}

/// Returns the path the system writes into a buffer through `call`. Where the buffer is too small
/// the system answers the room it needs, and the call is repeated with that much.
fn pathFrom(name: string, doing: string, call: fn(Slice<uint8>) -> int): string throws IoError {
    var room = 1024;
    loop {
        let buffer: uint8[] = [0u8] * room;
        let answer = onPool(() => call(buffer[..]));
        if (answer < 0) {
            throw failure(answer, name, doing);
        }
        if (answer <= room) {
            return try string.fromUtf8(buffer[..answer]) catch (e: Utf8Error) throw IoError {
                kind = .InvalidData,
                path = name,
                detail = doing,
                inner = e,
            };
        }
        room = answer;
    }
}
