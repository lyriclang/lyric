/// Speaks HTTP/1.1 (RFC 9110, RFC 9112) over `Reader` and `Writer`: the message types, a client
/// and a server.
///
/// The message types are `Method`, `Status`, `Headers`, `Request`, `Response` and `Body`; the
/// errors are `HttpError` beside the I/O errors. The client: `Client.send` writes a request over a connection it keeps alive for the next one to the same authority,
/// reads the status line and the headers, and hands the body back as a `Reader` that knows its
/// length (`Content-Length`), its chunks (`Transfer-Encoding: chunked`) or its end (the
/// connection's close). Redirects are followed where asked, a timeout spans the whole exchange,
/// and the `transport` hook of the options makes the connection — TCP here, TLS where a package
/// puts its own `Stream` into it. The server: `Server.bind(addr).serve(handler)` takes a task per
/// connection, reads each request as the client writes one (its body a `Reader` the handler may
/// read or leave), answers `Expect: 100-continue`, writes the handler's `Response` with its
/// length or in chunks, keeps the connection for the next request, and ends with `shutdown()`.
/// The module has no TLS of its own, no HTTP/2 and no cookies.
import std.collections { List, Map };
import std.core { StringBuilder, viewBytes, Closeable, ParseError };
import std.io { Reader, Writer, IoError, ByteBuffer };
import std.net { TcpStream, TcpListener, SocketAddr, IpAddr, resolve };
import std.task { Cancelled, TimedOut, withTimeout, spawn };
import std.time { Duration };
import std.uri { Uri };
import std.json;
import std.json { JsonError };
import std.codec { Encode, Decode, DecodeError, EncodeError };
import std.compress { GzipReader, ZlibReader };

// ---------------------------------------------------------------------------------------------
// Errors.
// ---------------------------------------------------------------------------------------------

pub enum HttpErrorKind :: [Equatable, Debug] {
    /// The peer did not speak HTTP/1.1 as RFC 9112 writes it.
    Protocol,
    /// More redirects than allowed, or one that cannot be followed.
    Redirects,
    /// A scheme that is not `http` (or `https` without a transport), a method that is none.
    Unsupported,
}

/// The error the client throws beyond the I/O errors of the connection.
pub struct HttpError :: [Error] {
    pub kind: HttpErrorKind,
    pub detail: string,

    pub fn message(): string {
        return match (this.kind) {
            .Protocol => f"not HTTP: {this.detail}",
            .Redirects => f"redirect: {this.detail}",
            .Unsupported => f"unsupported: {this.detail}",
        };
    }
}

// ---------------------------------------------------------------------------------------------
// The message types.
// ---------------------------------------------------------------------------------------------

/// A request's method; `Other` for a token beyond the common ones.
pub enum Method :: [Equatable, Debug] {
    Get,
    Head,
    Post,
    Put,
    Delete,
    Patch,
    Options,
    Other(string);

    /// Returns the method of a token as it stands on the wire (`GET`), `Other` for one beyond the
    /// known ones.
    pub static fn of(token: string): Method {
        return match (token) {
            "GET" => Method.Get,
            "HEAD" => Method.Head,
            "POST" => Method.Post,
            "PUT" => Method.Put,
            "DELETE" => Method.Delete,
            "PATCH" => Method.Patch,
            "OPTIONS" => Method.Options,
            _ => Method.Other(token),
        };
    }
}

extend Method :: [Display] {
    fn show(): string {
        return match (this) {
            .Get => "GET",
            .Head => "HEAD",
            .Post => "POST",
            .Put => "PUT",
            .Delete => "DELETE",
            .Patch => "PATCH",
            .Options => "OPTIONS",
            .Other(t) => t,
        };
    }
}

/// A status: the code and its reason phrase.
pub struct Status :: [Equatable, Debug] {
    pub code: int,
    pub reason: string = "",

    /// Returns the status of a code with the reason phrase RFC 9110 gives it.
    pub static fn of(code: int): Status {
        return Status { code = code, reason = reasonOf(code) };
    }

    pub fn isInformational(): bool {
        return this.code >= 100 && this.code < 200;
    }

    pub fn isSuccess(): bool {
        return this.code >= 200 && this.code < 300;
    }

    pub fn isRedirect(): bool {
        return this.code >= 300 && this.code < 400;
    }

    pub fn isClientError(): bool {
        return this.code >= 400 && this.code < 500;
    }

    pub fn isServerError(): bool {
        return this.code >= 500 && this.code < 600;
    }
}

extend Status :: [Display] {
    fn show(): string {
        return if (this.reason.isEmpty()) f"{this.code}" else f"{this.code} {this.reason}";
    }
}

/// Returns the reason phrase RFC 9110 §15 gives a status code, or an empty string for a code
/// without one here.
pub fn reasonOf(code: int): string {
    return match (code) {
        100 => "Continue",
        101 => "Switching Protocols",
        200 => "OK",
        201 => "Created",
        202 => "Accepted",
        204 => "No Content",
        206 => "Partial Content",
        301 => "Moved Permanently",
        302 => "Found",
        303 => "See Other",
        304 => "Not Modified",
        307 => "Temporary Redirect",
        308 => "Permanent Redirect",
        400 => "Bad Request",
        401 => "Unauthorized",
        403 => "Forbidden",
        404 => "Not Found",
        405 => "Method Not Allowed",
        408 => "Request Timeout",
        409 => "Conflict",
        410 => "Gone",
        411 => "Length Required",
        413 => "Content Too Large",
        414 => "URI Too Long",
        415 => "Unsupported Media Type",
        417 => "Expectation Failed",
        422 => "Unprocessable Content",
        429 => "Too Many Requests",
        500 => "Internal Server Error",
        501 => "Not Implemented",
        502 => "Bad Gateway",
        503 => "Service Unavailable",
        504 => "Gateway Timeout",
        505 => "HTTP Version Not Supported",
        _ => "",
    };
}

/// The header fields of a message, in the order written; names compare without case.
pub class Headers {
    var items: List<(string, string)>,

    pub static fn new(): Headers {
        return Headers { items = List.new() };
    }

    /// Returns the first value of the field, `null` where there is none.
    pub fn get(name: string): ?string {
        for ((k, v) in this.items) {
            if (sameName(k, name)) {
                return v;
            }
        }
        return null;
    }

    /// Returns every value of the field, in order.
    pub fn all(name: string): string[] {
        let out: List<string> = List.new();
        for ((k, v) in this.items) {
            if (sameName(k, name)) {
                out.push(v);
            }
        }
        return out.toArray();
    }

    pub fn has(name: string): bool {
        return this.get(name) != null;
    }

    /// Sets the field to this value alone, removing its other values.
    pub mut fn set(name: string, value: string): void {
        this.remove(name);
        this.items.push((name, value));
    }

    /// Adds one more value of the field.
    pub mut fn add(name: string, value: string): void {
        this.items.push((name, value));
    }

    pub mut fn remove(name: string): void {
        let kept: List<(string, string)> = List.new();
        for ((k, v) in this.items) {
            if (!sameName(k, name)) {
                kept.push((k, v));
            }
        }
        this.items = kept;
    }

    pub fn length(): int {
        return this.items.length();
    }

    pub fn pairs(): List<(string, string)> {
        return this.items;
    }

    /// Returns whether `Connection` names the token (`close`, `keep-alive`), without case.
    fn connectionHas(token: string): bool {
        for (v in this.all("Connection")) {
            for (part in v.split(',')) {
                if (sameName(part.trim().toString(), token)) {
                    return true;
                }
            }
        }
        return false;
    }
}

fn sameName(a: StringView, b: StringView): bool {
    let x = viewBytes(a);
    let y = viewBytes(b);
    if (x.length() != y.length()) {
        return false;
    }
    var i = 0;
    while (i < x.length()) {
        if (lowerByte(x[i]) != lowerByte(y[i])) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

fn lowerByte(b: uint8): uint8 {
    return if (b >= 65u8 && b <= 90u8) b + 32u8 else b;
}

/// A request: the method, the URI, the headers, and a body — a `Reader` with its length where
/// known (`Content-Length`), sent in chunks otherwise.
pub struct Request {
    pub var method: Method = Method.Get,
    pub var uri: Uri,
    pub var headers: Headers = Headers.new(),
    pub var body: ?Reader = null,
    pub var contentLength: ?int = null,

    pub static fn get(uri: Uri): Request {
        return Request { uri = uri };
    }

    /// Returns a POST of the bytes, their length known.
    pub static fn post(
        uri: Uri,
        body: Slice<uint8>,
        contentType: string = "application/octet-stream"
    ): Request {
        var r = Request { method = Method.Post, uri = uri };
        r.headers.set("Content-Type", contentType);
        r.setBody(body);
        return r;
    }

    /// Sets the bytes as the body, `Content-Length` their count.
    pub mut fn setBody(bytes: Slice<uint8>): void {
        let buf = ByteBuffer.new();
        try! buf.write(bytes);
        this.body = buf;
        this.contentLength = bytes.length();
    }

    /// Sets the text as the body, UTF-8, and the `Content-Type`.
    pub mut fn setText(text: string, contentType: string = "text/plain; charset=utf-8"): void {
        this.headers.set("Content-Type", contentType);
        this.setBody(viewBytes(text));
    }

    /// Reads the body whole (a server's handler reads the request it was given this way); empty
    /// where there is none.
    ///
    /// # Errors
    ///
    /// Throws `IoError` where reading the body fails, and `Cancelled` where the task is cancelled
    /// while reading.
    pub fn bytes(): uint8[] throws [IoError, Cancelled] {
        if (let b = this.body) {
            return try readWhole(b);
        }
        return [];
    }

    /// Reads the body whole as text (UTF-8, a wrong byte U+FFFD).
    ///
    /// # Errors
    ///
    /// Throws as `bytes` does.
    pub fn text(): string throws [IoError, Cancelled] {
        return string.fromUtf8Lossy((try this.bytes())[..]);
    }

    /// Reads the body whole and decodes it as JSON into `T`.
    ///
    /// # Errors
    ///
    /// Throws `JsonError` for a body that is no JSON, `DecodeError` where it does not fit `T`,
    /// and `IoError` or `Cancelled` as `bytes` does.
    pub fn json<T :: [Decode]>(): T throws [JsonError, DecodeError, IoError, Cancelled] {
        return try jsonOf<T>(this.text());
    }
}

/// Reads every byte of a reader.
fn readWhole(r: Reader): uint8[] throws [IoError, Cancelled] {
    var reader = r;
    let out = ByteBuffer.new();
    let chunk: uint8[] = [0u8] * 8192;
    while (true) {
        let n = try reader.read(chunk[..]);
        if (n == 0) {
            break;
        }
        try! out.write(chunk[0..n]);
    }
    return out.toArray();
}

/// A response: the status, the headers, the body as a `Reader` that ends where the message does.
/// A handler makes one with `Response.of`, `Response.withText`, `Response.withJson`, `Response.stream`
/// or `Response.empty`.
pub class Response {
    pub var status: Status,
    pub var headers: Headers,
    pub var body: Body,

    /// Returns a response of the bytes, their length known; `Content-Type` is set where there are
    /// any.
    pub static fn of(
        status: int,
        body: Slice<uint8> = [],
        contentType: string = "application/octet-stream"
    ): Response {
        let headers = Headers.new();
        if (body.length() > 0) {
            headers.set("Content-Type", contentType);
        }
        return Response { status = Status.of(status), headers = headers, body = Body.of(body) };
    }

    /// Returns a response of the text, UTF-8.
    pub static fn withText(
        text: string,
        status: int = 200,
        contentType: string = "text/plain; charset=utf-8"
    ): Response {
        return Response.of(status, viewBytes(text), contentType);
    }

    /// Returns a response of the value as JSON, `Content-Type: application/json`.
    ///
    /// # Errors
    ///
    /// Throws `EncodeError` where the value cannot be encoded as JSON.
    pub static fn withJson<T :: [Encode]>(
        value: T,
        status: int = 200
    ): Response throws EncodeError {
        return Response.of(status, viewBytes(try jsonText(value)), "application/json");
    }

    /// Returns a response whose body is read from `source` as it is written — in chunks where
    /// `length` is `null`, with `Content-Length` otherwise.
    pub static fn stream(
        status: int,
        source: Reader,
        length: ?int = null,
        contentType: string = "application/octet-stream"
    ): Response {
        let headers = Headers.new();
        headers.set("Content-Type", contentType);
        return Response {
            status = Status.of(status),
            headers = headers,
            body = Body.from(source, length),
        };
    }

    /// Returns a response without a body.
    pub static fn empty(status: int): Response {
        return Response {
            status = Status.of(status),
            headers = Headers.new(),
            body = Body.empty(),
        };
    }

    /// Reads the body whole.
    ///
    /// # Errors
    ///
    /// Throws `IoError` where the connection fails or the body is framed wrongly, and `Cancelled`
    /// where the task is cancelled while reading.
    pub fn bytes(): uint8[] throws [IoError, Cancelled] {
        return try this.body.readAll();
    }

    /// Reads the body whole as text (UTF-8, a wrong byte U+FFFD).
    ///
    /// # Errors
    ///
    /// Throws as `bytes` does.
    pub fn text(): string throws [IoError, Cancelled] {
        return string.fromUtf8Lossy((try this.body.readAll())[..]);
    }

    /// Reads the body whole and decodes it as JSON into `T`.
    ///
    /// # Errors
    ///
    /// Throws `JsonError` for a body that is no JSON, `DecodeError` where it does not fit `T`,
    /// and `IoError` or `Cancelled` as `bytes` does.
    pub fn json<T :: [Decode]>(): T throws [JsonError, DecodeError, IoError, Cancelled] {
        return try jsonOf<T>(this.text());
    }
}

/// Decodes JSON text into `T`; it stands outside the classes because inside them `json` names the
/// method, not the module.
fn jsonOf<T :: [Decode]>(text: string): T throws [JsonError, DecodeError] {
    return try json.decode<T>(text);
}

fn jsonText<T :: [Encode]>(value: T): string throws EncodeError {
    return try json.encode(value);
}

// ---------------------------------------------------------------------------------------------
// The connection: a Stream with a read buffer, lines and bytes out of it.
// ---------------------------------------------------------------------------------------------

/// A connection a transport gives: read, written and closed.
pub interface Stream :: [Reader, Writer, Closeable] { }

extend TcpStream :: [Stream] { }

/// The most a line of the head may hold.
let maxLineBytes = 65536;

/// The most lines a head may hold.
let maxHeaderLines = 256;

class Conn {
    var stream: Stream,
    var buf: uint8[],
    var start: int,
    var end: int,
    /// Whether the connection may carry another exchange.
    var reusable: bool,

    static fn new(stream: Stream): Conn {
        return Conn { stream = stream, buf = [0u8] * 8192, start = 0, end = 0, reusable = true };
    }

    /// Reads more bytes into the buffer where it is empty; returns `false` at the end of the
    /// stream.
    mut fn fill(): bool throws [IoError, Cancelled] {
        if (this.start < this.end) {
            return true;
        }
        this.start = 0;
        this.end = try this.stream.read(this.buf[..]);
        return this.end > 0;
    }

    /// Reads a line without its `\r\n` (a lone `\n` ends it too); `null` at the end of the
    /// stream.
    mut fn readLine(): ?string throws [IoError, Cancelled] {
        let out = ByteBuffer.new();
        var total = 0;
        while (true) {
            if (!(try this.fill())) {
                if (total == 0) {
                    return null;
                }
                throw IoError {
                    kind = .UnexpectedEof,
                    path = null,
                    detail = "the line is not ended",
                    inner = null,
                };
            }
            var i = this.start;
            while (i < this.end && this.buf[i] != 10u8) {
                i = i + 1;
            }
            let found = i < this.end;
            let take = if (found) i else this.end;
            try! out.write(this.buf[this.start..take]);
            total = total + (take - this.start);
            this.start = if (found) take + 1 else take;
            if (total > maxLineBytes) {
                throw IoError {
                    kind = .InvalidData,
                    path = null,
                    detail = "a line of the head beyond 64 KiB",
                    inner = null,
                };
            }
            if (found) {
                break;
            }
        }
        let bytes = out.toArray();
        var n = bytes.length();
        if (n > 0 && bytes[n - 1] == 13u8) {
            n = n - 1;
        }
        return string.fromUtf8Lossy(bytes[0..n]);
    }

    /// Reads bytes into `into`, from the buffer first; 0 at the end of the stream.
    mut fn read(into: Slice<uint8>): int throws [IoError, Cancelled] {
        if (this.start < this.end) {
            let n = if (this.end - this.start < into.length()) this.end - this.start
                else into.length();
            this.buf[this.start..this.start + n].copyInto(into[0..n]);
            this.start = this.start + n;
            return n;
        }
        if (into.length() == 0) {
            return 0;
        }
        return try this.stream.read(into);
    }

    mut fn writeAll(bytes: Slice<uint8>): void throws [IoError, Cancelled] {
        var at = 0;
        while (at < bytes.length()) {
            let n = try this.stream.write(bytes[at..bytes.length()]);
            if (n <= 0) {
                throw IoError {
                    kind = .BrokenPipe,
                    path = null,
                    detail = "the connection took nothing",
                    inner = null,
                };
            }
            at = at + n;
        }
    }

    fn close(): void {
        try {
            this.stream.close();
        } catch (_: Error) { }
    }

    /// Reads away what the peer still sends — up to 64 KiB or its end — then closes: a close with
    /// unread bytes resets the connection, and the peer would lose the answer it was given.
    mut fn drainAndClose(): void {
        let scratch: uint8[] = [0u8] * 4096;
        var total = this.end - this.start;
        this.start = 0;
        this.end = 0;
        try {
            while (total < 65536) {
                let n = this.stream.read(scratch[..]);
                if (n == 0) {
                    break;
                }
                total = total + n;
            }
        } catch (_: Error) { }
        this.close();
    }
}

// ---------------------------------------------------------------------------------------------
// The body.
// ---------------------------------------------------------------------------------------------

enum Framing {
    /// No body: HEAD, 204, 304.
    Empty,
    /// `Content-Length` bytes.
    Fixed,
    /// `Transfer-Encoding: chunked`.
    Chunked,
    /// Up to the connection's end.
    UntilClose,
}

/// A message's body as a `Reader`: the bytes up to the message's end, however it is framed. Once
/// read to the end, the connection goes back to the client for the next request, or is closed.
///
/// Its `read` throws `IoError` with kind `UnexpectedEof` where the connection ends inside the
/// body, and `InvalidData` for a chunk that is framed wrongly.
pub class Body :: [Reader] {
    var conn: ?Conn,
    var framing: Framing,
    /// `Fixed`: the bytes left; `Chunked`: the bytes left in the chunk.
    var left: int,
    var done: bool,
    var client: ?Client,
    var authority: string,
    /// A body that is no connection's: a reader of its own, with its length where known.
    var source: ?Reader,
    var sourceLength: ?int,
    /// Whether the body owns its connection (a client's response): at its end the connection goes
    /// back to the client or is closed. A server's request body leaves the connection to the
    /// server.
    var owns: bool,
    /// Set where the body ended wrongly: the connection's bytes are out of step.
    var failed: bool,

    static fn empty(): Body {
        return Body {
            conn = null,
            framing = Framing.Empty,
            left = 0,
            done = true,
            client = null,
            authority = "",
            source = null,
            sourceLength = null,
            owns = false,
            failed = false,
        };
    }

    /// Returns a body of the bytes.
    pub static fn of(bytes: Slice<uint8>): Body {
        let buf = ByteBuffer.new();
        try! buf.write(bytes);
        return Body {
            conn = null,
            framing = Framing.Fixed,
            left = bytes.length(),
            done = bytes.length() == 0,
            client = null,
            authority = "",
            source = buf,
            sourceLength = bytes.length(),
            owns = false,
            failed = false,
        };
    }

    /// Returns a body read from `source`, with its length where known.
    pub static fn from(source: Reader, length: ?int): Body {
        return Body {
            conn = null,
            framing = Framing.UntilClose,
            left = 0,
            done = false,
            client = null,
            authority = "",
            source = source,
            sourceLength = length,
            owns = false,
            failed = false,
        };
    }

    /// Returns the body's length where it is known before it is read, `null` otherwise.
    pub fn length(): ?int {
        if (this.source != null) {
            return this.sourceLength;
        }
        return match (this.framing) {
            .Empty => 0,
            .Fixed => this.left,
            _ => null,
        };
    }

    pub mut fn read(into: Slice<uint8>): int throws [IoError, Cancelled] {
        if (this.done || into.length() == 0) {
            return 0;
        }
        if (let src = this.source) {
            var reader = src;
            let n = try reader.read(into);
            if (n == 0) {
                this.done = true;
            }
            return n;
        }
        let conn = this.conn!;
        match (this.framing) {
            .Empty => {
                this.finish();
                return 0;
            }
            .Fixed => {
                let want = if (this.left < into.length()) this.left else into.length();
                let n = try conn.read(into[0..want]);
                if (n == 0) {
                    this.drop();
                    throw IoError {
                        kind = .UnexpectedEof,
                        path = null,
                        detail = f"the body ended {this.left} bytes early",
                        inner = null,
                    };
                }
                this.left = this.left - n;
                if (this.left == 0) {
                    this.finish();
                }
                return n;
            }
            .Chunked => {
                if (this.left == 0) {
                    let size = try this.chunkSize(conn);
                    if (size == 0) {
                        // the trailers, up to the empty line
                        while (true) {
                            let line = try conn.readLine();
                            if (line == null) {
                                this.drop();
                                throw IoError {
                                    kind = .UnexpectedEof,
                                    path = null,
                                    detail = "the chunked body is not ended",
                                    inner = null,
                                };
                            }
                            if (line.isEmpty()) {
                                break;
                            }
                        }
                        this.finish();
                        return 0;
                    }
                    this.left = size;
                }
                let want = if (this.left < into.length()) this.left else into.length();
                let n = try conn.read(into[0..want]);
                if (n == 0) {
                    this.drop();
                    throw IoError {
                        kind = .UnexpectedEof,
                        path = null,
                        detail = "a chunk ended early",
                        inner = null,
                    };
                }
                this.left = this.left - n;
                if (this.left == 0) {
                    // the CRLF after the chunk's data
                    let crlf = try conn.readLine();
                    if (crlf == null || !crlf.isEmpty()) {
                        this.drop();
                        throw IoError {
                            kind = .InvalidData,
                            path = null,
                            detail = "a chunk is not ended by CRLF",
                            inner = null,
                        };
                    }
                }
                return n;
            }
            .UntilClose => {
                let n = try conn.read(into);
                if (n == 0) {
                    this.drop();
                }
                return n;
            }
        }
    }

    /// Reads the size line of a chunk: hex digits, an extension after `;` ignored.
    mut fn chunkSize(conn: Conn): int throws [IoError, Cancelled] {
        let line = try conn.readLine();
        if (line == null) {
            this.drop();
            throw IoError {
                kind = .UnexpectedEof,
                path = null,
                detail = "the chunked body is not ended",
                inner = null,
            };
        }
        var size = 0;
        var digits = 0;
        for (c in line.chars()) {
            if (c == ';' || c == ' ' || c == '\t') {
                break;
            }
            if (let d = c.toDigit(16)) {
                size = size * 16 + d;
                digits = digits + 1;
                if (size > 1073741824) {
                    this.drop();
                    throw IoError {
                        kind = .InvalidData,
                        path = null,
                        detail = "a chunk beyond 1 GiB",
                        inner = null,
                    };
                }
            } else {
                this.drop();
                throw IoError {
                    kind = .InvalidData,
                    path = null,
                    detail = f"'{line}' is no chunk size",
                    inner = null,
                };
            }
        }
        if (digits == 0) {
            this.drop();
            throw IoError {
                kind = .InvalidData,
                path = null,
                detail = f"'{line}' is no chunk size",
                inner = null,
            };
        }
        return size;
    }

    /// Marks the body complete: where the body owns the connection, it goes back for the next
    /// request or is closed.
    mut fn finish(): void {
        this.done = true;
        if (let conn = this.conn) {
            this.conn = null;
            if (!this.owns) {
                return;
            }
            if (conn.reusable) {
                if (let c = this.client) {
                    c.putIdle(this.authority, conn);
                    return;
                }
            }
            conn.close();
        }
    }

    /// Marks the body as ended wrongly or with the connection: nothing is kept (a server's
    /// connection is the server's to close).
    mut fn drop(): void {
        this.done = true;
        this.failed = true;
        if (let conn = this.conn) {
            this.conn = null;
            if (this.owns) {
                conn.close();
            }
        }
    }

    /// Returns whether the body has been read to its end.
    pub fn isDone(): bool {
        return this.done;
    }

    /// Reads the rest of the body, whole.
    ///
    /// # Errors
    ///
    /// Throws `IoError` where the connection fails or the body is framed wrongly, and `Cancelled`
    /// where the task is cancelled while reading.
    pub mut fn readAll(): uint8[] throws [IoError, Cancelled] {
        let out = ByteBuffer.new();
        let chunk: uint8[] = [0u8] * 8192;
        while (true) {
            let n = try this.read(chunk[..]);
            if (n == 0) {
                break;
            }
            try! out.write(chunk[0..n]);
        }
        return out.toArray();
    }
}

// ---------------------------------------------------------------------------------------------
// The client.
// ---------------------------------------------------------------------------------------------

/// The options of a `Client`. `transport` makes the connection to a host and port — TCP where `null`;
/// a package's TLS puts its own `Stream` here.
pub struct ClientOptions {
    pub followRedirects: bool = false,
    pub maxRedirects: int = 10,
    /// The time one `send` may take: the connection, the request, the head and the body's first
    /// bytes.
    pub timeout: ?Duration = null,
    /// Whether a connection is kept for the next request to the same authority.
    pub keepAlive: bool = true,
    pub userAgent: string = "lyric5",
    pub transport: ?fn(string, int) -> Stream throws [IoError, Cancelled] = null,
    /// Whether a response `Content-Encoding: gzip` (or `deflate`) is decoded as the body is read:
    /// the request then says `Accept-Encoding: gzip, deflate`, and the headers of the response
    /// lose `Content-Encoding` and `Content-Length`.
    pub decompress: bool = true,
}

pub class Client {
    var options: ClientOptions,
    var idle: Map<string, Conn>,
    /// The connection of the exchange under way, closed where the exchange is cut short.
    var inFlight: ?Conn,

    pub static fn new(options: ClientOptions = ClientOptions { }): Client {
        return Client { options = options, idle = Map<string, Conn>.new(), inFlight = null };
    }

    /// Sends a GET of the URI; see `send`.
    ///
    /// # Errors
    ///
    /// Throws as `send` does.
    pub mut fn get(uri: Uri): Response throws [HttpError, IoError, TimedOut, Cancelled] {
        return try this.send(Request.get(uri));
    }

    /// Sends the request and reads its response's head; the body is read from the response.
    /// Redirects are followed where the options say so (303 and, for a POST, 301 and 302 as a
    /// GET; 307 and 308 with the method kept — a body cannot be sent again); `timeout` spans the
    /// whole.
    ///
    /// # Errors
    ///
    /// Throws `HttpError` with kind `Unsupported` for a scheme other than `http` (or `https`
    /// without a transport) or a URI without a host, `Redirects` for too many redirects or one
    /// that cannot be followed, and `Protocol` for a peer that does not speak HTTP/1.1; `IoError`
    /// where the connection fails; `TimedOut` where `timeout` passes; `Cancelled` where the task
    /// is cancelled. On `TimedOut` and `Cancelled` the connection is closed.
    pub mut fn send(request: Request): Response throws [HttpError, IoError, TimedOut, Cancelled] {
        if (let d = this.options.timeout) {
            // withTimeout's body throws one type; the four are told apart again here
            try {
                return withTimeout(d, () => try this.sendFollowing(request));
            } catch (e: HttpError) {
                throw e;
            } catch (e: IoError) {
                throw e;
            } catch (e: TimedOut) {
                this.dropInFlight();
                throw e;
            } catch (e: Cancelled) {
                this.dropInFlight();
                throw e;
            } catch (e: Error) {
                throw HttpError { kind = .Protocol, detail = e.message() };
            }
        }
        return try this.sendFollowing(request);
    }

    mut fn sendFollowing(request: Request): Response throws [HttpError, IoError, Cancelled] {
        var req = request;
        var hops = 0;
        while (true) {
            let response = try this.sendOnce(req);
            if (!this.options.followRedirects || !response.status.isRedirect()) {
                return response;
            }
            let code = response.status.code;
            if (!(code == 301 || code == 302 || code == 303 || code == 307 || code == 308)) {
                return response;
            }
            let location = response.headers.get("Location");
            if (location == null) {
                return response;
            }
            hops = hops + 1;
            if (hops > this.options.maxRedirects) {
                response.body.drop();
                throw HttpError {
                    kind = .Redirects,
                    detail = f"more than {this.options.maxRedirects} redirects",
                };
            }
            // the body of the redirect is read away: the connection stays usable
            let _ = try response.body.readAll();
            var target: Uri = Uri { };
            try {
                target = req.uri.resolve(Uri.parse(location));
            } catch (_: ParseError) {
                throw HttpError {
                    kind = .Redirects,
                    detail = f"the Location '{location}' is no URI",
                };
            }
            var next = Request {
                method = req.method,
                uri = target,
                headers = Headers.new(),
                body = null,
                contentLength = null,
            };
            for ((k, v) in req.headers.pairs()) {
                if (!sameName(k, "Host")
                    && !sameName(k, "Content-Length")
                    && !sameName(k, "Content-Type")) {
                    next.headers.add(k, v);
                }
            }
            if (code == 303 || ((code == 301 || code == 302) && req.method == Method.Post)) {
                next.method = Method.Get;
            } else if (req.body != null) {
                throw HttpError {
                    kind = .Redirects,
                    detail = f"a {code} asks the body to be sent again",
                };
            }
            req = next;
        }
    }

    /// Runs one exchange: takes a connection (idle or new), writes the request, reads the head
    /// and frames the body. An idle connection the peer closed meanwhile is tried again on a new
    /// one.
    mut fn sendOnce(req: Request): Response throws [HttpError, IoError, Cancelled] {
        let (host, port, authority) = try this.target(req.uri);
        if (let idle = this.takeIdle(authority)) {
            try {
                return this.exchange(idle, req, authority);
            } catch (e: IoError) {
                idle.close();
                if (req.body != null) {
                    throw e;
                }
                // the peer closed the idle connection: once more on a fresh one
            }
        }
        let conn = Conn.new(try this.connect(host, port));
        return try this.exchange(conn, req, authority);
    }

    /// Returns the host, the port and the authority key of the request's URI.
    fn target(uri: Uri): (string, int, string) throws HttpError {
        let scheme = uri.scheme ?? "";
        if (scheme != "http" && !(scheme == "https" && this.options.transport != null)) {
            throw HttpError {
                kind = .Unsupported,
                detail = if (scheme == "https") "https needs a transport"
                    else f"the scheme '{scheme}'",
            };
        }
        let host = uri.host ?? "";
        if (host.isEmpty()) {
            throw HttpError { kind = .Unsupported, detail = "the URI names no host" };
        }
        let port = uri.port ?? (if (scheme == "https") 443 else 80);
        return (host, port, f"{scheme}://{host}:{port}");
    }

    fn connect(host: string, port: int): Stream throws [IoError, Cancelled] {
        if (let make = this.options.transport) {
            return try make(host, port);
        }
        var ip: ?IpAddr = null;
        try {
            ip = IpAddr.parse(host);
        } catch (_: ParseError) {
            let found = try resolve(host);
            if (found.isEmpty()) {
                throw IoError {
                    kind = .NotFound,
                    path = null,
                    detail = f"'{host}' resolves to no address",
                    inner = null,
                };
            }
            ip = found[0];
        }
        let stream = try TcpStream.connect(SocketAddr { ip = ip!, port = port as uint16 });
        // a request is a small write, and its answer comes back before the next: Nagle's waiting
        // would hold each one for the peer's delayed ACK, some 40 ms a request
        try stream.setNoDelay(true);
        return stream;
    }

    mut fn takeIdle(authority: string): ?Conn {
        if (let c = this.idle.get(authority)) {
            this.idle.remove(authority);
            return c;
        }
        return null;
    }

    mut fn putIdle(authority: string, conn: Conn): void {
        if (!this.options.keepAlive) {
            conn.close();
            return;
        }
        if (let old = this.idle.get(authority)) {
            old.close();
        }
        this.idle[authority] = conn;
    }

    /// Closes every idle connection.
    pub mut fn close(): void {
        for ((_, c) in this.idle) {
            c.close();
        }
        this.idle = Map<string, Conn>.new();
    }

    mut fn exchange(
        conn: Conn,
        req: Request,
        authority: string
    ): Response throws [HttpError, IoError, Cancelled] {
        this.inFlight = conn;
        try {
            this.writeRequest(conn, req);
            let response = this.readResponse(conn, req, authority);
            this.inFlight = null;
            return response;
        } catch (e: Cancelled) {
            // the connection stays in flight: `send` drops it, and the drop closes it. Clearing it
            // here would leave a timed-out request's socket open and the peer's task waiting for
            // the next request for ever
            throw e;
        } catch (e: HttpError) {
            this.inFlight = null;
            throw e;
        } catch (e: IoError) {
            this.inFlight = null;
            throw e;
        }
    }

    /// Closes the connection of an exchange that was cut short, so the peer sees the end.
    mut fn dropInFlight(): void {
        if (let c = this.inFlight) {
            this.inFlight = null;
            c.close();
        }
    }

    fn writeRequest(conn: Conn, req: Request): void throws [IoError, Cancelled] {
        let head = StringBuilder.new();
        head.appendStr(req.method.show());
        head.appendChar(' ');
        head.appendStr(if (req.uri.path.isEmpty()) "/" else req.uri.path);
        if (let q = req.uri.query) {
            head.appendChar('?');
            head.appendStr(q);
        }
        head.appendStr(" HTTP/1.1\r\n");
        if (!req.headers.has("Host")) {
            head.appendStr("Host: ");
            let host = req.uri.host ?? "";
            if (host.contains(':')) {
                head.appendStr(f"[{host}]");
            } else {
                head.appendStr(host);
            }
            if (let p = req.uri.port) {
                let scheme = req.uri.scheme ?? "http";
                if (!((scheme == "http" && p == 80) || (scheme == "https" && p == 443))) {
                    head.appendStr(f":{p}");
                }
            }
            head.appendStr("\r\n");
        }
        if (!req.headers.has("User-Agent") && !this.options.userAgent.isEmpty()) {
            head.appendStr(f"User-Agent: {this.options.userAgent}\r\n");
        }
        if (this.options.decompress && !req.headers.has("Accept-Encoding")) {
            head.appendStr("Accept-Encoding: gzip, deflate\r\n");
        }
        if (!this.options.keepAlive && !req.headers.has("Connection")) {
            head.appendStr("Connection: close\r\n");
        }
        var chunked = false;
        if (req.body != null) {
            if (let n = req.contentLength) {
                head.appendStr(f"Content-Length: {n}\r\n");
            } else {
                head.appendStr("Transfer-Encoding: chunked\r\n");
                chunked = true;
            }
        } else if (req.method == Method.Post
            || req.method == Method.Put
            || req.method == Method.Patch) {
            head.appendStr("Content-Length: 0\r\n");
        }
        for ((k, v) in req.headers.pairs()) {
            if (sameName(k, "Content-Length") || sameName(k, "Transfer-Encoding")) {
                continue;
            }
            head.appendStr(f"{k}: {v}\r\n");
        }
        head.appendStr("\r\n");
        try conn.writeAll(viewBytes(head.toString()));
        if (let body = req.body) {
            var source = body;
            let chunk: uint8[] = [0u8] * 8192;
            var sent = 0;
            while (true) {
                let n = try source.read(chunk[..]);
                if (n == 0) {
                    break;
                }
                if (chunked) {
                    try conn.writeAll(viewBytes(f"{n:x}\r\n"));
                    try conn.writeAll(chunk[0..n]);
                    try conn.writeAll(viewBytes("\r\n"));
                } else {
                    try conn.writeAll(chunk[0..n]);
                }
                sent = sent + n;
            }
            if (chunked) {
                try conn.writeAll(viewBytes("0\r\n\r\n"));
            } else if (let n = req.contentLength) {
                if (sent != n) {
                    throw IoError {
                        kind = .InvalidInput,
                        path = null,
                        detail = f"the body gave {sent} bytes, Content-Length said {n}",
                        inner = null,
                    };
                }
            }
        }
        try conn.stream.flush();
    }

    fn readResponse(
        conn: Conn,
        req: Request,
        authority: string
    ): Response throws [HttpError, IoError, Cancelled] {
        try {
            return this.readResponseHead(conn, req, authority);
        } catch (e: HttpError) {
            conn.close();
            throw e;
        } catch (e: IoError) {
            conn.close();
            throw e;
        }
    }

    fn readResponseHead(
        conn: Conn,
        req: Request,
        authority: string
    ): Response throws [HttpError, IoError, Cancelled] {
        var status = Status { code = 0 };
        var headers = Headers.new();
        var version11 = true;
        // interim responses (100 Continue, 103 Early Hints) are read away
        while (true) {
            let line = try conn.readLine();
            if (line == null) {
                throw IoError {
                    kind = .UnexpectedEof,
                    path = null,
                    detail = "the connection closed before a response",
                    inner = null,
                };
            }
            if (line.isEmpty()) {
                continue;
            }
            let (s, v11) = try parseStatusLine(line);
            status = s;
            version11 = v11;
            headers = try readHeaders(conn);
            if (!status.isInformational()) {
                break;
            }
        }
        // the framing
        var framing = Framing.UntilClose;
        var length = 0;
        if (req.method == Method.Head || status.code == 204 || status.code == 304) {
            framing = Framing.Empty;
        } else if (let te = headers.get("Transfer-Encoding")) {
            if (!sameName(lastToken(te), "chunked")) {
                throw HttpError {
                    kind = .Protocol,
                    detail = f"the transfer encoding '{te}' is not understood",
                };
            }
            framing = Framing.Chunked;
        } else if (let cl = headers.get("Content-Length")) {
            if (let n = lengthOf(cl)) {
                framing = Framing.Fixed;
                length = n;
            } else {
                throw HttpError { kind = .Protocol, detail = f"'{cl}' is no Content-Length" };
            }
        }
        // keep-alive: HTTP/1.1, a framed body, neither side closing
        var reusable = version11
            && this.options.keepAlive
            && !headers.connectionHas("close")
            && !req.headers.connectionHas("close");
        match (framing) {
            .UntilClose => {
                reusable = false;
            }
            _ => { }
        }
        conn.reusable = reusable;
        var body = Body {
            conn = conn,
            framing = framing,
            left = length,
            done = false,
            client = this,
            authority = authority,
            source = null,
            sourceLength = null,
            owns = true,
            failed = false,
        };
        match (framing) {
            .Empty => {
                body.finish();
            }
            .Fixed => {
                if (length == 0) {
                    body.finish();
                }
            }
            _ => { }
        }
        // a compressed body is decoded as it is read: the raw body underneath still returns
        // the connection at its end
        if (this.options.decompress && !body.isDone()) {
            if (let encoding = headers.get("Content-Encoding")) {
                let token = lastToken(encoding);
                if (sameName(token, "gzip") || sameName(token, "x-gzip")) {
                    body = Body.from(GzipReader<Body>.new(body), null);
                    headers.remove("Content-Encoding");
                    headers.remove("Content-Length");
                } else if (sameName(token, "deflate")) {
                    body = Body.from(ZlibReader<Body>.new(body), null);
                    headers.remove("Content-Encoding");
                    headers.remove("Content-Length");
                }
            }
        }
        return Response { status = status, headers = headers, body = body };
    }
}

/// Parses a status line such as `HTTP/1.1 200 OK`: the status and whether the version is 1.1.
fn parseStatusLine(line: string): (Status, bool) throws HttpError {
    let parts = line.splitN(' ', 3);
    var version = "";
    var codeText = "";
    var reason = "";
    var i = 0;
    for (p in parts) {
        if (i == 0) {
            version = p.toString();
        } else if (i == 1) {
            codeText = p.toString();
        } else {
            reason = p.toString();
        }
        i = i + 1;
    }
    if (!(version == "HTTP/1.1" || version == "HTTP/1.0")) {
        throw HttpError { kind = .Protocol, detail = f"the status line is '{line}'" };
    }
    if (codeText.length() != 3) {
        throw HttpError { kind = .Protocol, detail = f"the status line is '{line}'" };
    }
    var code = 0;
    for (c in codeText.chars()) {
        if (!c.isAsciiDigit()) {
            throw HttpError { kind = .Protocol, detail = f"the status line is '{line}'" };
        }
        code = code * 10 + ((c as uint32) - 48u32) as int;
    }
    return (Status { code = code, reason = reason }, version == "HTTP/1.1");
}

/// Reads the header lines up to the empty one. The connection is the caller's to close on an
/// error.
fn readHeaders(conn: Conn): Headers throws [HttpError, IoError, Cancelled] {
    let headers = Headers.new();
    var count = 0;
    while (true) {
        let line = try conn.readLine();
        if (line == null) {
            throw IoError {
                kind = .UnexpectedEof,
                path = null,
                detail = "the head is not ended",
                inner = null,
            };
        }
        if (line.isEmpty()) {
            return headers;
        }
        count = count + 1;
        if (count > maxHeaderLines) {
            throw HttpError {
                kind = .Protocol,
                detail = f"more than {maxHeaderLines} header lines",
            };
        }
        if (line.startsWith(" ") || line.startsWith("\t")) {
            throw HttpError { kind = .Protocol, detail = "a folded header line (obs-fold)" };
        }
        if (let (name, value) = line.splitOnce(':')) {
            let n = name.toString();
            if (n.isEmpty() || n.contains(' ')) {
                throw HttpError { kind = .Protocol, detail = f"the header line '{line}'" };
            }
            headers.add(n, value.trim().toString());
        } else {
            throw HttpError { kind = .Protocol, detail = f"the header line '{line}'" };
        }
    }
}

/// Returns the last comma-separated token of a header value, trimmed.
fn lastToken(value: string): string {
    var last = "";
    for (part in value.split(',')) {
        last = part.trim().toString();
    }
    return last;
}

/// Parses a Content-Length of digits alone; `null` for anything else or a length beyond 1 TiB.
fn lengthOf(value: string): ?int {
    let text = value.trim();
    if (text.isEmpty()) {
        return null;
    }
    var n = 0;
    for (c in text.chars()) {
        if (!c.isAsciiDigit()) {
            return null;
        }
        n = n * 10 + ((c as uint32) - 48u32) as int;
        if (n > 1099511627776) {
            return null;
        }
    }
    return n;
}

/// Sends a GET of the URI's text with a client of the default options, redirects followed.
///
/// # Errors
///
/// Throws `ParseError` for a text that is no URI, and otherwise as `Client.send` does.
pub fn get(uri: string): Response throws [HttpError, IoError, TimedOut, Cancelled, ParseError] {
    var client = Client.new(ClientOptions { followRedirects = true });
    return try client.get(Uri.parse(uri));
}

// ---------------------------------------------------------------------------------------------
// The server.
// ---------------------------------------------------------------------------------------------

/// The options of a `Server`.
pub struct ServerOptions {
    /// Whether a connection is kept for the next request.
    pub keepAlive: bool = true,
    /// The `Server` header; none where empty.
    pub serverName: string = "lyric5",
}

/// An HTTP/1.1 server over a `TcpListener`: `serve` runs until `shutdown`.
pub class Server {
    var listener: TcpListener,
    var options: ServerOptions,
    /// The connections waiting for their next request, by number: closed at `shutdown`.
    var idle: Map<int, Conn>,
    var nextConn: int,
    var closing: bool,

    /// Returns a server bound to the address — port 0 for any; `localAddr()` says which.
    ///
    /// # Errors
    ///
    /// Throws `IoError` where the address cannot be bound.
    pub static fn bind(
        addr: SocketAddr,
        options: ServerOptions = ServerOptions { }
    ): Server throws IoError {
        let listener = try TcpListener.bind(addr);
        return Server {
            listener = listener,
            options = options,
            idle = Map<int, Conn>.new(),
            nextConn = 0,
            closing = false,
        };
    }

    pub fn localAddr(): SocketAddr throws IoError {
        return try this.listener.localAddr();
    }

    /// Accepts and serves connections, each on a task of its own, until `shutdown()` closes the
    /// listener. The handler's response is written as it is; a handler that throws answers 500
    /// with the error's message. A request the server cannot read is answered 400 and the
    /// connection closed.
    ///
    /// # Errors
    ///
    /// Throws `Cancelled` where the task is cancelled while waiting for a connection.
    pub mut fn serve(handler: fn(Request) -> Response throws Error): void throws Cancelled {
        while (true) {
            var accepted: ?TcpStream = null;
            try {
                accepted = this.listener.accept();
            } catch (_: IoError) {
                // the listener is closed: shutdown
                return;
            }
            let stream = accepted!;
            try {
                // the head and the body may go out as two writes: without this the second waits
                // for the peer's delayed ACK of the first
                stream.setNoDelay(true);
            } catch (_: IoError) { }
            this.nextConn = this.nextConn + 1;
            let id = this.nextConn;
            let _ = spawn(
                () => {
                    this.connection(id, Conn.new(stream), handler);
                }
            );
        }
    }

    /// Stops the server: closes the listener — `serve` returns — and the connections waiting for
    /// a request; a request under way is answered first, then its connection closes.
    pub mut fn shutdown(): void {
        this.closing = true;
        try {
            this.listener.close();
        } catch (_: Error) { }
        for ((_, c) in this.idle) {
            c.close();
        }
        this.idle = Map<int, Conn>.new();
    }

    /// Serves one connection: reads and answers requests until a side closes.
    mut fn connection(id: int, conn: Conn, handler: fn(Request) -> Response throws Error): void {
        while (!this.closing) {
            this.idle[id] = conn;
            var head: ?RequestHead = null;
            try {
                head = this.readRequestHead(conn);
            } catch (e: HttpError) {
                this.idle.remove(id);
                this.answerBad(conn, e.detail);
                conn.drainAndClose();
                return;
            } catch (_: Error) {
                this.idle.remove(id);
                conn.close();
                return;
            }
            this.idle.remove(id);
            if (head == null || this.closing) {
                conn.close();
                return;
            }
            let h = head;
            // Expect: 100-continue — the client waits for the go before it sends the body
            if (let expect = h.request.headers.get("Expect")) {
                if (sameName(expect.trim().toString(), "100-continue")) {
                    try {
                        conn.writeAll(viewBytes("HTTP/1.1 100 Continue\r\n\r\n"));
                    } catch (_: Error) {
                        conn.close();
                        return;
                    }
                }
            }
            var response: Response = Response.empty(500);
            try {
                response = handler(h.request);
            } catch (e: Error) {
                response = Response.withText(e.message(), 500);
            }
            var keep = this.options.keepAlive
                && h.keepAlive
                && !response.headers.connectionHas("close")
                && !this.closing;
            if (h.body.isDone() && h.body.conn == null && h.body.failed) {
                keep = false;
            }
            // the request's body read away, so the next request starts clean
            if (keep && !h.body.isDone()) {
                try {
                    let _ = h.body.readAll();
                } catch (_: Error) {
                    conn.close();
                    return;
                }
            }
            try {
                this.writeResponse(conn, h, response, keep);
            } catch (_: Error) {
                conn.close();
                return;
            }
            if (!keep) {
                conn.drainAndClose();
                return;
            }
        }
        conn.close();
    }

    /// Answers `400 Bad Request` with the reason as text; the connection is closed by the caller.
    fn answerBad(conn: Conn, detail: string): void {
        let text = f"bad request: {detail}";
        let head = f"HTTP/1.1 400 Bad Request\r\nContent-Type: text/plain; charset=utf-8\r\nContent-Length: {viewBytes(text).length()}\r\nConnection: close\r\n\r\n{text}";
        try {
            conn.writeAll(viewBytes(head));
        } catch (_: Error) { }
    }

    /// Reads the request line and the headers; `null` where the connection ended before a
    /// request.
    fn readRequestHead(conn: Conn): ?RequestHead throws [HttpError, IoError, Cancelled] {
        var line = try conn.readLine();
        // a stray CRLF before the request line is allowed (RFC 9112 §2.2)
        while (line != null && line.isEmpty()) {
            line = try conn.readLine();
        }
        if (line == null) {
            return null;
        }
        let parts = line.splitN(' ', 3).toArray();
        if (parts.length() != 3) {
            throw HttpError { kind = .Protocol, detail = f"the request line is '{line}'" };
        }
        let methodText = parts[0].toString();
        let target = parts[1].toString();
        let version = parts[2].toString();
        if (!(version == "HTTP/1.1" || version == "HTTP/1.0")) {
            throw HttpError { kind = .Protocol, detail = f"the version is '{version}'" };
        }
        if (methodText.isEmpty() || !isToken(methodText)) {
            throw HttpError { kind = .Protocol, detail = f"the method is '{methodText}'" };
        }
        var uri = Uri { };
        try {
            uri = Uri.parse(target);
        } catch (_: ParseError) {
            throw HttpError { kind = .Protocol, detail = f"the target is '{target}'" };
        }
        if (!(target.startsWith("/") || uri.scheme != null || target == "*")) {
            throw HttpError { kind = .Protocol, detail = f"the target is '{target}'" };
        }
        let headers = try readHeaders(conn);
        let version11 = version == "HTTP/1.1";
        if (version11 && !headers.has("Host")) {
            throw HttpError { kind = .Protocol, detail = "no Host" };
        }
        // the body's framing
        var framing = Framing.Empty;
        var length = 0;
        if (let te = headers.get("Transfer-Encoding")) {
            if (!sameName(lastToken(te), "chunked")) {
                throw HttpError {
                    kind = .Protocol,
                    detail = f"the transfer encoding '{te}' is not understood",
                };
            }
            framing = Framing.Chunked;
        } else if (let cl = headers.get("Content-Length")) {
            if (let n = lengthOf(cl)) {
                framing = if (n == 0) Framing.Empty else Framing.Fixed;
                length = n;
            } else {
                throw HttpError { kind = .Protocol, detail = f"'{cl}' is no Content-Length" };
            }
        }
        conn.reusable = false;
        let body = Body {
            conn = conn,
            framing = framing,
            left = length,
            done = false,
            client = null,
            authority = "",
            source = null,
            sourceLength = null,
            owns = false,
            failed = false,
        };
        match (framing) {
            .Empty => {
                body.finish();
            }
            _ => { }
        }
        let keepAlive = if (version11) !headers.connectionHas("close")
            else headers.connectionHas("keep-alive");
        var contentLength: ?int = null;
        match (framing) {
            .Fixed => {
                contentLength = length;
            }
            .Empty => {
                contentLength = 0;
            }
            _ => { }
        }
        let request = Request {
            method = Method.of(methodText),
            uri = uri,
            headers = headers,
            body = body,
            contentLength = contentLength,
        };
        return RequestHead {
            request = request,
            body = body,
            keepAlive = keepAlive,
            version11 = version11,
        };
    }

    fn writeResponse(
        conn: Conn,
        h: RequestHead,
        response: Response,
        keep: bool
    ): void throws [IoError, Cancelled] {
        let head = StringBuilder.new();
        let status = response.status;
        let reason = if (status.reason.isEmpty()) reasonOf(status.code) else status.reason;
        head.appendStr(f"HTTP/1.1 {status.code} {reason}\r\n");
        if (!this.options.serverName.isEmpty() && !response.headers.has("Server")) {
            head.appendStr(f"Server: {this.options.serverName}\r\n");
        }
        let isHead = h.request.method == Method.Head;
        let bodiless = status.code == 204 || status.code == 304 || status.isInformational();
        var chunked = false;
        var length: ?int = response.body.length();
        if (bodiless) {
            length = null;
        } else if (let n = length) {
            head.appendStr(f"Content-Length: {n}\r\n");
        } else {
            head.appendStr("Transfer-Encoding: chunked\r\n");
            chunked = true;
        }
        if (!keep && !response.headers.connectionHas("close")) {
            head.appendStr("Connection: close\r\n");
        }
        for ((k, v) in response.headers.pairs()) {
            if (sameName(k, "Content-Length") || sameName(k, "Transfer-Encoding")) {
                continue;
            }
            head.appendStr(f"{k}: {v}\r\n");
        }
        head.appendStr("\r\n");
        var body = response.body;
        if (!isHead && !bodiless && !chunked && (length ?? 0) <= 65536) {
            // a body of known, modest length goes out with its head in one write: one system
            // call, one wake of the peer
            let whole = ByteBuffer.new();
            try whole.write(viewBytes(head.toString()));
            let piece: uint8[] = [0u8] * 8192;
            while (true) {
                let n = try body.read(piece[..]);
                if (n == 0) {
                    break;
                }
                try whole.write(piece[0..n]);
            }
            try conn.writeAll(whole.toArray()[..]);
            try conn.stream.flush();
            return;
        }
        try conn.writeAll(viewBytes(head.toString()));
        if (isHead || bodiless) {
            try conn.stream.flush();
            return;
        }
        let chunk: uint8[] = [0u8] * 8192;
        while (true) {
            let n = try body.read(chunk[..]);
            if (n == 0) {
                break;
            }
            if (chunked) {
                try conn.writeAll(viewBytes(f"{n:x}\r\n"));
                try conn.writeAll(chunk[0..n]);
                try conn.writeAll(viewBytes("\r\n"));
            } else {
                try conn.writeAll(chunk[0..n]);
            }
        }
        if (chunked) {
            try conn.writeAll(viewBytes("0\r\n\r\n"));
        }
        try conn.stream.flush();
    }
}

/// A request as read: with whether the connection may go on after it.
struct RequestHead {
    request: Request,
    body: Body,
    keepAlive: bool,
    version11: bool,
}

/// RFC 9110's token characters.
fn isToken(s: string): bool {
    for (b in viewBytes(s)) {
        let ok = isWordByte(b)
            || b == 33u8
            || b == 35u8
            || b == 36u8
            || b == 37u8
            || b == 38u8
            || b == 39u8
            || b == 42u8
            || b == 43u8
            || b == 45u8
            || b == 46u8
            || b == 94u8
            || b == 96u8
            || b == 124u8
            || b == 126u8;
        if (!ok) {
            return false;
        }
    }
    return true;
}

fn isWordByte(b: uint8): bool {
    return (b >= 48u8 && b <= 57u8)
        || (b >= 65u8 && b <= 90u8)
        || (b >= 97u8 && b <= 122u8)
        || b == 95u8;
}
