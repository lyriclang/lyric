//! The prelude: the names every module can use without an import.
//!
//! It holds what signatures and the language itself need, not effects: `println` is `std.io`'s.
//! It passes on with `pub import` what other modules declare — the core interfaces, panics and
//! attributes from `std.core`, and `List`, `Map` and `Set` from `std.collections`.
//!
//! # Examples
//!
//! ```lyric
//! import std.io { println };
//!
//! let primes = List.of([2, 3, 5, 7]);
//! let ages = Map<string, int>.new();
//! ages.insert("ada", 36);
//! println(primes.length() + (ages.get("ada") ?? 0));
//! ```
//!
//! ```output
//! 40
//! ```
pub import std.core {
    panic,
    assert,
    unreachable,
    todo,
    Error,
    Exception,
    Result,
    Box,
    Ordering,
    Range,
    RangeInclusive,
    RangeFrom,
    RangeTo,
    RangeFull,
    Equatable,
    Hashable,
    Identity,
    Ordered,
    TotalOrder,
    Display,
    Debug,
    Default,
    Clone,
    VariantName,
    Variants,
    Closeable,
    Num,
    Integer,
    Float,
    Iterator,
    Iterable,
    FromIterator,
    Into,
    From,
    Index,
    IndexSet,
    Length,
    Test,
    Bench,
    callerExpr,
    callerLine,
    callerFile,
    Deprecated,
    AlwaysInline,
    NoInline,
    Cold,
    MustUse,
    NonExhaustive,
    Layout,
    Export,
    Allow,
    Warn,
    Deny,
    When,
    Shared,
    SeesConformer,
    sequence,
    target,
    profile,
};
pub import std.collections { List, Map, Set };
// The iterator adapters' module, named here so its blocks reach every iterator in every module; the structs are imported where a type is written, `import std.iter { MapIter }`.
import std.iter;
