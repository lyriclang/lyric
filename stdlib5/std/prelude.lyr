/// The prelude (design/v5/spec/10 B2, 07 V3 I8): what every module names without an import —
/// what signatures and the language itself need, not effects (U5: `println` is `std.io`'s).
/// It passes on with `pub import` what other modules declare, and grows with the library:
/// `List`, `Map` and `Set` are std.collections' (10 B2: "the language's collection vocabulary");
/// `Result` and `FromIterator` come with theirs.
/// `Exception` is here as 12 K05 has it; `Closeable` stands for what B2 calls `Resource`.
pub import std.core {
    panic,
    assert,
    unreachable,
    todo,
    Error,
    Exception,
    Box,
    Ordering,
    Range,
    RangeInclusive,
    RangeFrom,
    RangeTo,
    RangeFull,
    Equatable,
    Hashable,
    Identity,
    Ordered,
    TotalOrder,
    Display,
    Debug,
    Default,
    Clone,
    Closeable,
    Num,
    Integer,
    Float,
    Iterator,
    Iterable,
    FromIterator,
    Index,
    IndexSet,
    Test,
    callerExpr,
    sequence
};
pub import std.collections { List, Map, Set };
