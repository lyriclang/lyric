/// Threads and pools of them: [Thread], [Pool] and [parallelMap].
///
/// Each thread runs a scheduler of its own from `std.task`; a task never moves to another
/// thread. Threads run at the same time: what they share, they share through a channel, an
/// atomic or a lock — anything else is a data race.
import std.core { filled };
import std.task { atomicFetchAndAdd, atomicLoad, atomicStore, Cancelled, Channel, enlist, launchOn, living,
    Scheduler, setCurrentScheduler, SpinLock, startThread, Task };

/// An operating-system thread with a scheduler of its own.
///
/// A task never moves to another thread. What threads share, they share through a channel, an
/// atomic or a lock — anything else is a data race.
pub class Thread {
    /// Starts a thread with a scheduler of its own and returns the handle of its first task,
    /// `body`.
    ///
    /// `await()` on the handle waits for the task's end from any thread, and what the task did
    /// happens before the wait returns. The handle is done when that task ends. The thread then
    /// cancels what still lives on it and runs until all of it has ended: the `defer`s run, the
    /// locks come free, and whoever awaits one of those tasks goes on. Only the program ends with
    /// its first task and leaves the rest where it stands.
    pub static fn spawn<T, E :: [Error]>(body: fn() -> T throws E): (Task<T> throws E) {
        let s = Scheduler { };
        enlist(s);
        let task = launchOn(s, body, null);
        startThread(() => {
            setCurrentScheduler(s);
            s.started();
            while (!task.isDone()) {
                s.step();
            }
            s.wind();
            s.stopped();
            living.leave(s);
            setCurrentScheduler(null);
        });
        return task;
    }
}

/// A fixed set of threads that run the tasks given to the pool.
///
/// [Pool.spawn] runs a task on one of them — each in turn — and returns its handle;
/// [Pool.close] waits until the tasks given to the pool have ended, then ends its threads. A
/// pool is `Closeable`, so `using let pool = Pool.new(4);` closes it at the end of the scope.
pub class Pool :: [Closeable] {
    workers: Worker,
    size: int,
    /// Held from the check of `closed` to the raising of a worker's count, and while the pool
    /// closes: a task given while the pool closes is on a worker that will run it — counted
    /// before the worker may look again — or refused; never on one that has ended. Without it a
    /// close between the check and the count would lose the task.
    guard: SpinLock = SpinLock { },
    var picks: int = 0,
    var closed: bool = false,

    /// Creates a pool of `threads` threads, each with a scheduler of its own.
    ///
    /// A count below one makes a pool of one thread.
    pub static fn new(threads: int): Pool {
        let n = if (threads > 0) threads else 1;
        var head = Worker { scheduler = Scheduler { } };
        head.start();
        for (_ in 1..n) {
            let w = Worker { scheduler = Scheduler { }, next = head };
            w.start();
            head = w;
        }
        return Pool { workers = head, size = n };
    }

    /// Runs `body` as a task on the pool's next thread in turn and returns its handle.
    ///
    /// `await()` on the handle waits for the task from any thread.
    ///
    /// # Panics
    ///
    /// Panics if the pool is closed.
    pub mut fn spawn<T, E :: [Error]>(body: fn() -> T throws E): (Task<T> throws E) {
        this.guard.acquire();
        if (this.closed) {
            this.guard.release();
            panic("a task given to a closed pool");
        }
        let w = this.pick();
        atomicFetchAndAdd(&w.active, 1);
        this.guard.release();
        // counted, the worker stays for it; the hand-over itself needs no guard
        return launchOn(w.scheduler, body, () => {
            atomicFetchAndAdd(&w.active, -1);
        });
    }

    /// Waits until every task given to the pool has ended, then ends its threads.
    ///
    /// Each thread ends as a [Thread] does: what those tasks started and left there is
    /// cancelled, and has ended when this returns. Closing a closed pool waits for nothing.
    ///
    /// # Errors
    ///
    /// Throws `Cancelled` when the calling task is cancelled during the wait.
    pub fn close(): void throws Error {
        // Through the reference, not through 'this': 'Closeable.close' is no 'mut fn', and an
        // implementation's 'mut' is the member's (LYR-SEM0042) — on a class too.
        let me = this;
        me.guard.acquire();
        me.closed = true;
        me.guard.release();
        var at: ?Worker = this.workers;
        while (let w = at) {
            w.close();
            at = w.next;
        }
        at = this.workers;
        while (let w = at) {
            try w.finished.recv();
            at = w.next;
        }
    }

    /// Returns the next thread in turn; called under the guard.
    mut fn pick(): Worker {
        var k = this.picks % this.size;
        this.picks = this.picks +% 1;
        if (k < 0) { k = -k; }
        var at: ?Worker = this.workers;
        while (let w = at) {
            if (k == 0) { return w; }
            k -= 1;
            at = w.next;
        }
        return this.workers;
    }
}

/// A thread of a pool. It runs until the pool is closed and none of the pool's tasks on it is left;
/// then its `finished` closes.
class Worker {
    scheduler: Scheduler,
    var active: int = 0, // atomic
    var closing: bool = false, // atomic
    finished: Channel<void> = Channel<void>.new(),
    var next: ?Worker = null,

    fn start(): void {
        let s = this.scheduler;
        let w = this;
        enlist(s);
        startThread(() => {
            setCurrentScheduler(s);
            s.started();
            while (!(atomicLoad(&w.closing) && atomicLoad(&w.active) == 0)) {
                s.step();
            }
            s.wind();
            w.finished.close();
            s.stopped();
            living.leave(s);
            setCurrentScheduler(null);
        });
    }

    /// Marks the worker as closing and wakes its thread, which ends once its tasks have.
    mut fn close(): void {
        atomicStore(&this.closing, true);
        this.scheduler.nudge();
    }
}

/// Calls `f` on every element of `xs` on several threads and returns the results in the
/// elements' order.
///
/// The program's pool does the work — a thread for each processor, started at the first call
/// and there until the program ends — in pieces, four for each thread; the first element's call
/// runs on the caller's thread. `f` runs on other threads: what it shares, it shares through a
/// channel, an atomic or a lock.
///
/// # Errors
///
/// Where calls throw, the error of the first element, in order, whose call throws comes out
/// once every piece has ended; a piece stops at its first error, so a later element of that
/// piece may go uncalled. An error from the first element's call comes out at once. A cancelled
/// caller cancels the pieces and throws `Cancelled`.
pub fn parallelMap<T, U, E :: [Error]>(xs: Slice<T>, f: fn(T) -> U throws E): U[] throws [E, Cancelled] {
    let n = xs.length();
    if (n == 0) {
        return [];
    }
    let first = try f(xs[0]);
    // every slot the first result until its own is written: an array of U needs a value of U
    let out = filled(n, first);
    if (n == 1) {
        return out;
    }
    let pool = programPool();
    var count = pool.size * 4;
    if (count > n - 1) {
        count = n - 1;
    }
    let pieces = count;
    // piece k computes the elements from bound(k) up to bound(k + 1), in order, and stops at its
    // first error
    let bound = (k: int): int => 1 + k * (n - 1) / pieces;
    let run = (low: int, high: int) => {
        var i = low;
        while (i < high) {
            out[i] = try f(xs[i]);
            i += 1;
        }
    };
    let head = pool.spawn(() => try run(bound(0), bound(1)));
    let tasks = filled(pieces, head);
    for (k in 1..pieces) {
        let low = bound(k);
        let high = bound(k + 1);
        tasks[k] = pool.spawn(() => try run(low, high));
    }
    // every piece to its end, a failed one too; then the first failed one, in order, again — its
    // error is the error of the first element whose call threw
    var failed = -1;
    for (k in 0..pieces) {
        try {
            tasks[k].await();
        } catch (c: Cancelled) {
            for (t in tasks) {
                t.cancel();
            }
            throw c;
        } catch (_) {
            if (failed < 0) {
                failed = k;
            }
        }
    }
    if (failed >= 0) {
        try tasks[failed].await();
    }
    return out;
}

/// The program's pool for [parallelMap], made at its first call: a thread for each processor.
@Allow("global-var-without-sync")
var sharedPool: ?Pool = null;
let sharedPoolGuard = SpinLock { };

fn programPool(): Pool {
    sharedPoolGuard.acquire();
    if (sharedPool == null) {
        sharedPool = Pool.new(processorCount());
    }
    let p = sharedPool!;
    sharedPoolGuard.release();
    return p;
}

/// Returns the number of processors the system runs the process on, one at least (lyr/os.h).
fn processorCount(): int;
