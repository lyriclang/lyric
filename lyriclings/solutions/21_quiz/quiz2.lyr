// quiz2.lyr — solution

import std.io.console { println };
import std.core { Display };
import std.math { sqrt };

enum Shape :: [Display] {
    Circle(float),
    Rectangle(float, float),
    Triangle { a: float, b: float, c: float };

    fn area(): float {
        return match (this) {
            Circle(r)            => 3.14159 * r * r,
            Rectangle(w, h)      => w * h,
            Triangle { a, b, c } => {
                let s = (a + b + c) / 2.0;
                return sqrt(s * (s - a) * (s - b) * (s - c));
            },
        };
    }

    fn show(): string {
        return match (this) {
            Circle(r)            => f"circle r={r}",
            Rectangle(w, h)      => f"rectangle {w}x{h}",
            Triangle { a, b, c } => f"triangle {a}/{b}/{c}",
        };
    }
}

fn main(): int {
    let shapes = [
        Shape.Circle(1.5),
        Shape.Rectangle(2.0, 3.0),
        Shape.Triangle { a = 3.0, b = 4.0, c = 5.0 },
    ];
    var total = 0.0;
    for (s in shapes) {
        println(s);
        total += s.area();
    }
    println(f"total area: {total:N2}");
    return 0;
}
