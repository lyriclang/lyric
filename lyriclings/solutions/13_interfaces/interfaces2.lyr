// interfaces2.lyr — solution

import std.io.console { println };

interface Shape {
    fn area(): float;
}

class Circle :: [Shape] {
    radius: float,
    fn area(): float { return 3.14159 * this.radius * this.radius; }
}

class Square :: [Shape] {
    side: float,
    fn area(): float { return this.side * this.side; }
}

fn main(): int {
    let shapes: Shape[] = [Circle { radius = 2.0 }, Square { side = 2.0 }];
    for (s in shapes) {
        println(f"{s.area():N2}");
    }
    return 0;
}
