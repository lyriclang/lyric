// interfaces4.lyr — solution
//
// `compare` is three comparisons, not a subtraction — a subtraction could overflow.

import std.io.console { println };
import std.core { Ordered };

struct Version :: [Ordered<Version>] {
    major: int,
    minor: int,
    fn compare(other: Version): int {
        if (this.major != other.major) {
            return if (this.major < other.major) -1 else 1;
        }
        if (this.minor != other.minor) {
            return if (this.minor < other.minor) -1 else 1;
        }
        return 0;
    }
}

fn relate(a: Version, b: Version): string {
    let left = f"{a.major}.{a.minor}";
    let right = f"{b.major}.{b.minor}";
    if (a < b) { return left + " < " + right; }
    if (a > b) { return left + " > " + right; }
    return left + " = " + right;
}

fn main(): int {
    let old = Version { major = 1, minor = 4 };
    let mid = Version { major = 1, minor = 5 };
    let new = Version { major = 2, minor = 0 };
    println(relate(old, mid));
    println(relate(new, mid));
    return 0;
}
