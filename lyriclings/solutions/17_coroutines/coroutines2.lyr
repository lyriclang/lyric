// coroutines2.lyr — solution

import std.io.console { println, print };

fn three(): Coroutine<int> {
    yield 10;
    yield 20;
    yield 30;
}

fn main(): int {
    let co = three();
    var sum = 0;
    var i = 0;
    while (true) {
        let v = co.next();
        if (v == null) { break; }
        if (i > 0) { print(" "); }
        print(f"{v}");
        sum += v;
        i += 1;
    }
    println("");
    println(f"sum: {sum}");
    return 0;
}
