// extend2.lyr — solution

import std.io.console { println };

interface Drawable {
    fn draw(): string;
}

class Plain { }

extend Plain :: [Drawable] {
    fn draw(): string { return "plain"; }
}

fn show(d: Drawable): void {
    println(d.draw());
}

fn main(): int {
    show(Plain { });
    return 0;
}
