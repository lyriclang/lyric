// optionals4.lyr — solution
//
// `??=` leaves a present value alone. (`return chosen ?? "anonymous";` says the same thing
// in one line.)

import std.io.console { println };

fn displayName(chosen: ?string): string {
    var nick = chosen;
    nick ??= "anonymous";
    return nick ?? "?";
}

fn main(): int {
    println(displayName("ada42"));
    println(displayName(null));
    return 0;
}
