// strings1.lyr
//
// Strings are immutable sequences of Unicode code points. `+` concatenates two STRINGS and
// nothing else — there is no implicit conversion, so `"age " + 36` is LYR-SEM0003. The idiomatic
// way to mix text and values is an f-string: `f"Hello, {name}"` — the braces hold any scalar
// expression.                                                    (spec §1.6, §6.6, guide chapter 2)
//
// Expected output:
//   Hello, Ada, you are 36

// I AM NOT DONE

import std.io.console { println };

fn main(): int {
    let name = "Ada";
    let age = 36;
    println("Hello, " + name + ", you are " + age);
    return 0;
}
