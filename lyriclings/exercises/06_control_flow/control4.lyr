// control4.lyr
//
// `break` leaves the innermost loop; `continue` jumps to its next iteration. Both refer to
// the innermost loop only — there are no labels.                 (spec §7.2, guide chapter 4)
//
// This program compiles and runs; it just uses the wrong one. It should print the odd
// numbers, and stop as soon as it passes 7.
//
// Expected output:
//   1 3 5 7
//   done

// I AM NOT DONE

import std.io.console { println, print };

fn main(): int {
    var printed = 0;
    for (n in 1..=20) {
        if (n % 2 == 0) {
            break;
        }
        if (n > 7) {
            continue;
        }
        if (printed > 0) { print(" "); }
        print(f"{n}");
        printed += 1;
    }
    println("");
    println("done");
    return 0;
}
