// hello3.lyr
//
// The entry point has exactly two allowed shapes: `fn main(): int` and
// `fn main(args: string[]): int`. Anything else — another return type, a `throws` clause,
// other parameters — is refused with LYR-SEM0021.              (spec §4.3, guide chapter 1)
//
// Expected output:
//   ready

// I AM NOT DONE

import std.io.console { println };

fn main(): void {
    println("ready");
}
