// modules1.lyr
//
// A file is a MODULE. `pub` exports a declaration; everything else is visible only inside
// the file. `import geometry { Rect, area }` looks for `geometry.lyr` beside the entry file
// and binds the listed names — and a name the module does not export is LYR-RES0004,
// whether it is missing or merely not `pub`.
//
// This exercise spans two files: look at geometry.lyr next to this one. The marker below
// stays in THIS file; the fix is where the compiler points.     (spec §4.1, guide chapter 12)
//
// Expected output:
//   area: 12

// I AM NOT DONE

import std.io.console { println };
import geometry { Rect, area };

fn main(): int {
    let r = Rect { w = 3, h = 4 };
    println(f"area: {area(r)}");
    return 0;
}
