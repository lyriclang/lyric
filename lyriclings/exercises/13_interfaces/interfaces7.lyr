// interfaces7.lyr
//
// An interface method WITH a body is a default. A conforming type may use it as is or
// override it — its own member wins. Defaults may call the interface's other members through
// `this`, which is how a small abstract surface grows a rich one.
//                                                                (spec §5.1, guide chapter 7)
//
// Expected output:
//   Good evening, Ada
//   Hello, Grace

// I AM NOT DONE

import std.io.console { println };

interface Greeter {
    fn name(): string;
    fn greet(): string;
}

class Formal :: [Greeter] {
    fn name(): string { return "Ada"; }
    fn greet(): string { return "Good evening, " + this.name(); }
}

class Casual :: [Greeter] {
    fn name(): string { return "Grace"; }
}

fn main(): int {
    println(Formal { }.greet());
    println(Casual { }.greet());
    return 0;
}
