// interfaces2.lyr
//
// An implementation matches the interface's declaration EXACTLY: arity, parameter types,
// return type and `mut`. A method of the right name with another signature does not
// implement the member (LYR-SEM0042) — the method table has one slot per member, and every
// caller through the interface relies on its shape.             (spec §5.1, guide chapter 7)
//
// Expected output:
//   12.57
//   4.00

// I AM NOT DONE

import std.io.console { println };

interface Shape {
    fn area(): float;
}

class Circle :: [Shape] {
    radius: float,
    fn area(): float { return 3.14159 * this.radius * this.radius; }
}

class Square :: [Shape] {
    side: int,
    fn area(): int { return this.side * this.side; }
}

fn main(): int {
    let shapes: Shape[] = [Circle { radius = 2.0 }, Square { side = 2 }];
    for (s in shapes) {
        println(f"{s.area():N2}");
    }
    return 0;
}
